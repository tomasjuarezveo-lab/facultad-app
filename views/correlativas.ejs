<!-- views/correlativas.ejs -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <title>Correlativas</title>
  <style>
    :root{
      --bg:#f7fafc; --text:#111827;
      --card: rgba(255,255,255,.88); --muted:#6b7280;
      --accent:#2dd4bf; --violet:#a78bfa; --green:#34d399; --amber:#f59e0b; --orange:#fb923c;
      --blue:#3b82f6; --sky:#38bdf8;
      --radius:14px; --gap:60px; --lane:180px; --node-w:280px;
      --shadow:0 10px 30px rgba(0,0,0,.25);
      --z:1;

      /* Estética de búsqueda (idéntica a Autoevaluaciones) */
      --glass-2: rgba(255, 255, 255, 0);
      --stroke:  rgba(255, 255, 255, 0);

      /* UI accents de los botones */
      --accent-ui:#F8C160;
      --accent-ui-12:rgb(255, 255, 255);
    }
    *{box-sizing:border-box}
    html,body{margin:0;background:var(--bg);color:var(--text);font:15px/1.45 Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif}
    .wrap{min-height:100vh;display:flex;flex-direction:column}
    /* ✅ Esta vista se renderiza dentro de layout.ejs (body.bg-hatch-ios). Evita 100vh extra que baja el recuadro */
    body.bg-hatch-ios .wrap{min-height:0 !important;}

    /* ===== Layout: SOLO el recuadro del grafo centrado ===== */
    #contentBound{
      flex: 1;
      width: 100%;
      display: flex;
      align-items: flex-start;     /* ✅ arriba */
      justify-content: center;     /* ✅ centrado horizontal */
      padding: 12px 16px 18px;     /* ✅ menos “aire” arriba */
    }

    /* El “recuadro de correlativas” es el único protagonista */
    #correlativasCard{
      width: min(1200px, 96vw);
      position: relative;
    }

    /* El grafo ocupa el recuadro y se ve limpio */
    #correlativasCard .board{
      background: rgba(255,255,255,.72);
      border: 1px solid rgba(226,232,240,.9);
      border-radius: 20px;
      box-shadow: 0 18px 44px rgba(15,23,42,.10);
      padding: 18px;
      padding-top: 148px; /* espacio para la UI superpuesta */
    }

    /* ===== UI superpuesta (encima del recuadro, NO sticky a la pantalla) ===== */
    /* ===== CONTENEDOR (sin recuadro propio) ===== */
    #topHeader.correlativas-ui{
        position: absolute;
        top: 14px;
        left: 5px;                 /* ✅ pegado al borde izquierdo del recuadro */
        right: 5px;                /* ✅ pegado al borde derecho del recuadro */
        transform: none;           /* ✅ ya no se centra por translate */
        z-index: 60;

        width: auto;               /* ✅ ahora depende de left/right */
        padding: 0;
        background: transparent;
        border: none;
        box-shadow: none;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;

        /* ✅ FIX MOBILE: el contenedor transparent no bloquea taps en el grafo */
        pointer-events: none;
    }
    /* ✅ FIX MOBILE: re-habilitar eventos en todos los elementos interactivos del header */
    #topHeader.correlativas-ui button,
    #topHeader.correlativas-ui input,
    #topHeader.correlativas-ui .ui-panel,
    #topHeader.correlativas-ui .filters-wrap,
    #topHeader.correlativas-ui .filters-secondary-wrap,
    #topHeader.correlativas-ui .search-wrap,
    #topHeader.correlativas-ui .legend-panel,
    #topHeader.correlativas-ui .legend {
        pointer-events: auto;
    }

      /* ✅ Nuevo layout: izquierda (años+leyenda) | derecha (buscar) y debajo (secundarios) */
      #topHeader .ui-grid{
      display:grid;
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "left secondary"
        "left right";
      gap: 10px 12px;
      align-items: start;
    }
      /* “Recuadros” */
      #topHeader .ui-panel{
        border-radius: 18px;
        background: rgba(255, 255, 255, 0);
        border: 1px solid rgba(226, 232, 240, 0);
        padding: 12px;
      }

      /* Izquierda: años + leyenda */
      #topHeader .ui-leftpanel{ grid-area:left; }

      #topHeader .ui-leftpanel{
        justify-self: start;   /* ✅ pegado a la izquierda */
        margin-left: 0;        /* ✅ sin margen extra */
      }

      /* Derecha: buscar (recuadro “invisible”) */
      #topHeader .ui-rightpanel{ grid-area:right; justify-self:end; }
      #topHeader .ui-panel-invis{
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        padding: 0 !important; /* ✅ que “no se vea” */
      }

      #topHeader .ui-rightpanel,
      #topHeader .ui-secondarypanel{
        justify-self: end;     /* ✅ ya lo tenías */
        margin-right: 0;       /* ✅ sin margen extra */
      }


      /* Debajo a la derecha: secundarios */
      #topHeader .ui-secondarypanel{ grid-area:secondary; justify-self:end; }
      #topHeader .ui-secondarypanel .filters-secondary-wrap{
        width: fit-content !important;   /* ✅ solo hasta el final de botones */
        max-width: 100%;
      }

    #topHeader .ui-left{
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-width: 0;
    }

    #topHeader .ui-right{
      display: flex;
      flex-direction: column;
      gap: 10px;
      align-items: flex-end;
    }

    /* ✅ Leyenda abajo a la izquierda, alineada con “Todos…” */
      #topHeader .legend-left{
        justify-content: flex-start !important;
        width: fit-content;
      }

      /* ✅ Derecha: búsqueda arriba + secundarios abajo */
      #topHeader .ui-right-stack{
        align-items: flex-end;
      }
      #topHeader .ui-right-stack .search-wrap{
        width: 18rem;
      }
      #topHeader .ui-right-stack .filters-secondary-wrap{
        margin-top: 2px;
      }


    /* Los chips quedan más minimalistas */
    .filters, .filters-secondary{
      box-shadow: none;
    }

    .filters-wrap{
      background: rgb(255, 255, 255);
      border: 1px solid rgba(226,232,240,.9);
      padding: 6px;
    }

    .filters-secondary-wrap{
      background: rgba(255, 255, 255, 0.856);
      border: 1px dashed rgba(203,213,225,.95);
      border-radius: 14px;
      padding: 8px;
      box-shadow: none;
    }

    /* Búsqueda más limpia */
    .search-ios{
      width: 18rem;
      background: rgba(255,255,255,.65);
      border: 1px solid rgba(226,232,240,.95);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.9), 0 10px 20px rgba(15,23,42,.06);
    }

    /* Leyenda alineada bajo la búsqueda */
    .legend{
      justify-content: flex-end;
      gap: 14px;
      width: 100%;
    }

    /* Overlay controls (fullscreen/zoom) abajo de la UI para que no se choque */
        .overlay-controls{
      position:absolute !important;
      top:auto !important;
      bottom:14px !important;
      right:14px !important;
      left:auto !important;

      z-index:2147483640 !important;
      display:flex !important;
      gap:8px !important;
      align-items:center !important;
    }


    #topHeader .ui-leftpanel .filters-wrap{
      white-space: nowrap;
    }

    /* =========================
   FIX GLOBAL (PC + Mobile):
   Años en pill horizontal scrolleable (nunca vertical)
      ========================= */
    #topHeader .ui-leftpanel .filters-wrap{
      display: inline-flex !important;
      flex-direction: row !important;
      align-items: center !important;
      gap: 8px !important;

      border-radius: 9999px !important;     /* pill perfecto */
      padding: 6px !important;

      width: fit-content !important;        /* desktop: no ocupa todo */
      max-width: 100% !important;

      overflow-x: auto !important;          /* ✅ si no entra, scroll */
      overflow-y: hidden !important;
      -webkit-overflow-scrolling: touch !important;
      scrollbar-width: none !important;
    }
    #topHeader .ui-leftpanel .filters-wrap::-webkit-scrollbar{ display:none !important; }

    #topHeader .ui-leftpanel .filters-wrap .seg-btn{
      flex: 0 0 auto !important;            /* nunca apila */
      min-width: unset !important;
    }



    /* ===== Toolbar ===== */
    .toolbar{display:flex;flex-direction:column;gap:10px}
    .toolbar-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;}
    .toolbar-row.between{justify-content:space-between;}

    /* Secundario: recuadro distinto y separado, alineado a la derecha */
    .filters-secondary-wrap{
      border-radius:12px;padding:6px 8px;display:flex;gap:.35rem;align-items:center;flex-wrap:wrap;
      background:#ffffff;border:1px dashed #d1d5db; box-shadow:0 4px 12px rgba(15,23,42,.06);
    }

    .seg-btn{
      height:28px;padding:0 10px;min-width:76px;border-radius:9999px;font-weight:600;font-size:.78rem;
      color:#475569;transition:.15s,color .15s ease,transform .15s ease,background .15s ease,box-shadow .15s ease;
      white-space:nowrap;letter-spacing:-.01em;border:1px solid transparent;background:transparent;cursor:pointer
    }
    .seg-btn[data-active="true"]{
      color:#fff;background:linear-gradient(145deg,var(--accent-ui),var(--accent-ui));border-color:var(--accent-ui-25);
      box-shadow:0 10px 22px rgba(254,132,25,.18),inset 0 1px 0 rgba(255, 255, 255, 0)
    }
    .seg-btn:active{transform:translateY(1px)}

    /* ===== Leyenda + Búsqueda + Zoom en una misma fila ===== */
    .legend{display:flex;gap:16px;align-items:center;color:#4b5563;font-size:13px;flex-wrap:wrap}
    .dot{width:12px;height:12px;border-radius:999px;display:inline-block}
    .dot.blue{background:var(--accent); margin-top: 10px;} .dot.violet{background:var(--violet); margin-top: 10px; } .dot.green{background:var(--green)}

    .row-legend-search-zoom{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
    .row-legend-search-zoom .spacer{flex:1}

    .zoombar{display:flex;gap:7px}
    .zoombar button{font-size: 11px; padding:10px 10px;border-radius:13px;border:1px solid rgba(255,255,255,.35); background:rgba(255, 255, 255, 0.623);color:#111827;cursor:pointer;min-width:1px}

    /* ===== Búsqueda (idéntica a Autoevaluaciones) ===== */
    .search-wrap{position:relative}
    .search-ios{
      height:42px;width:18rem;padding-left:40px;padding-right:14px;border-radius:9999px;background:var(--glass-2);
      border:1px solid var(--stroke);box-shadow:inset 0 1px 0 rgba(255,255,255,.85),0 6px 16px rgba(15,23,42,.06);
      backdrop-filter:blur(14px) saturate(140%);-webkit-backdrop-filter:blur(14px) saturate(140%);
      color:#334155
    }
    .search-ios::placeholder{color:#8a99ad}
    .search-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#9aa4b2}
    @media (max-width:768px){.search-ios{width:14rem}}

    /* ===== Contenedor del grafo ===== */
    .board{position:relative;overflow:auto;padding:18px;background:#ffffff00;border:1px solid #e2e8f0;border-radius:16px;box-shadow:0 10px 24px rgba(15,23,42,.06);width:100%;margin-bottom:30px}
    /* IMPORTANTE: 'normal' = altura reducida (lupa ACTIVA), 'zoom' = altura grande (lupa INACTIVA) */
    .boardHeight-normal{height:calc(84vh - var(--header-h,64px));}  /* ✅ más alto */
    .boardHeight-zoom{height:calc(165vh - var(--header-h,64px));}   /* ✅ más alto */
    .board::-webkit-scrollbar{width:0;height:0}
    .board{scrollbar-width:none;-ms-overflow-style:none}

    .canvas{position:relative;min-height:80vh;min-width:980px}
    .graph{position:relative; transform:scale(var(--z)); transform-origin: 0 0;}
    svg.wires{position:absolute;inset:0;pointer-events:none;z-index:0}
    /* ===== “Electricidad” / progreso en idle ===== */
      path.wire.spark{
        opacity: 1 !important;
        stroke-width: 3.2 !important;
        filter: drop-shadow(0 0 4px rgba(255,255,255,.75)) drop-shadow(0 0 10px rgba(255,255,255,.35));
      }

      @keyframes sparkDraw{
        0%   { stroke-dashoffset: var(--len, 999); opacity: 0; }
        10%  { opacity: 1; }
        100% { stroke-dashoffset: 0; opacity: .95; }
      }

      @keyframes sparkFlicker{
        0%,100% { filter: drop-shadow(0 0 3px rgba(255,255,255,.55)) drop-shadow(0 0 8px rgba(255,255,255,.25)); }
        50%     { filter: drop-shadow(0 0 6px rgba(255,255,255,.85)) drop-shadow(0 0 14px rgba(255,255,255,.45)); }
      }
          /* Opacidad por defecto al 30% para TODOS los hilos */
    /* ✅ En idle: hilos invisibles (se ilumina solo lo activo/hover/click o el spark) */
      path.wire{
        stroke-width:2.5;
        fill:none;
        opacity:0;                  /* ✅ 100% transparentes por defecto */
        transition:opacity .12s ease;
        stroke-linecap:round;
      }
    path.wire.blue{stroke:var(--accent)} path.wire.violet{stroke:var(--violet)}

    .node{
        position:absolute;
        width:var(--node-w);
        background: var(--card);
        border: 1px solid rgba(226,232,240,.95);
        border-radius: 16px;
        padding: 10px 12px;
        box-shadow: 0 12px 26px rgba(15,23,42,.10);
        z-index:1;
        transition: transform .18s, color .18s, background .18s, outline-color .18s;
      }
    .node .top{display:flex;align-items:center;gap:8px}
    /* ✅ Estructura: nombre arriba, fila inferior con toggle + checkbox a la derecha */
    .node .top{ align-items:flex-start; }
    .node .name{ width:100%; }
    .node .bottom{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      margin-top:10px;
      min-height:30px;
    }
    .node .toggle{
      margin-top:0 !important;   /* ✅ ya no baja solo */
      flex:1;
      min-width:0;
      line-height:1.2;
    }
    .node .check{
      appearance:none;
      -webkit-appearance:none;
      width:24px;
      height:24px;
      min-width:24px;
      min-height:24px;
      margin-left:auto;
      border:2px solid #9ca3af;
      border-radius:6px;
      cursor:pointer;
      background:#ffffff;
      display:inline-grid;
      place-items:center;
      touch-action:manipulation;
      flex:0 0 24px;
    }
    .node .check:checked{background:var(--green);border-color:#065f46}
    .node .check:checked::after{content:"✓";color:#0b3d2c;font-weight:900;font-size:14px;line-height:1}
    .node .name{font-weight:800;color:#000000;flex:1;line-height:1.2}
    .node .toggle{margin-top:6px;font-size:13px;color:rgb(35, 37, 39);cursor:pointer;user-select:none}
    .node .toggle:hover{text-decoration:underline}
    .node .reqs{overflow:hidden;max-height:0;transition:max-height .25s ease}
    .node.open{z-index:4}
    .node.open .reqs{max-height:380px;margin-top:8px}
    .node .reqs h4{margin:0 0 6px;font-size:12px;color:rgb(0, 0, 0);font-weight:700;text-transform:uppercase;letter-spacing:.02em}
    .node .reqs ul{margin:0 0 6px 14px;padding:0}
    .node .reqs li{list-style:disc;color:#372f38;font-size:13px}
    .node.highlight{outline:2px solid var(--amber); transform:translateZ(0) scale(1.02)}
    .node.selected{outline:2px solid var(--amber); transform:translateZ(0) scale(1.02)}
    /* Colores de borde solicitados */
    .node.leaf{outline:3px solid var(--orange)}      /* sin hijos => naranja */
    .node.hub{outline:3px solid var(--blue)}         /* muchos hijos => azul */
    .node.base{outline:3px solid var(--sky)}         /* nivel 0 => celeste */
    .node.done{background:#16a34a;border-color:#065f46}
    .node.done .name{color:#062d17}
    .node.done .toggle{color:#08331b}
        /* ✅ Inscribible: cumple correlativas (todas las prereq checkeadas) */
    .node.eligible{
      outline: 3px solid var(--violet) !important;
      box-shadow:
        0 12px 26px rgba(15,23,42,.10),
        0 0 0 2px rgba(167,139,250,.65),
        0 0 20px rgba(167,139,250,.55) !important;
    }
    /* ✅ Inscribible: cumple correlativas (todas las prereq checkeadas) y aún no está aprobada */
    .node.eligible{
      border-color: var(--violet) !important;
      box-shadow:
        0 0 0 2px rgba(167,139,250,.70),
        0 0 18px rgba(167,139,250,.55),
        0 12px 26px rgba(15,23,42,.10);
    }
    @media (max-width:560px){
      :root{ --node-w:220px; --gap:28px; --lane:150px; }
      .canvas{min-width:720px}
      .board{padding:10px}
    }

  /* === Overlay controls (fullscreen + zoom) === */
  .overlay-controls{
    position:absolute; top:10px; right:10px; z-index:1000;
    display:flex; gap:8px;
  }
  .glass-mini-btn{
    display:inline-flex; align-items:center; justify-content:center;
    width:36px; height:36px; border-radius:10px; cursor:pointer;
    border:1px solid rgba(255, 255, 255, 0.671);
    background:rgba(255, 255, 255, 0.623);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 6px 16px rgba(0,0,0,.15), inset 0 1px 0 rgba(255,255,255,.6);
    color:#111827;
  }
  .glass-mini-btn svg{ width:18px; height:18px; display:block }
        .overlay-floating{
          position: fixed !important;
          top: auto !important;
          bottom: calc(14px + env(safe-area-inset-bottom, 0px)) !important;
          right: 14px !important;
          z-index:2147483647 !important;
        }

  /* === Centrado horizontal fuerte cuando la lupa está ACTIVA (altura reducida) === */
  #correlativasViewport{
    display: flex !important;
    justify-content: center !important;
    align-items: flex-start;
    overflow: auto;
  }
  #board{
    width: max-content;
    display: inline-block;
    transform-origin: top left;
    margin: 0 auto;
  }

  /* === Límites y alineación al borde derecho de la barra de búsqueda === */
  .content-bound{
    width: 100%;
    max-width: var(--content-max, 1200px);
    margin: 0 auto;
    position: relative;
    padding: 0 16px;
  }
  .correlativas-card{ position: relative; }

</style>
<style>
  /* =========================
     ✅ iPhone 15 / Mobile:
     - NO fullscreen por defecto (se ve el dock del layout)
     - Card “cuadrada”
     - Fullscreen sólo al tocar el botón
     ========================= */

  @media (max-width: 430px){
    :root{
      --node-w: 246px;
      --gap: 24px;
      --lane: 200px;
      --z: .72;

      /* fallback (JS lo recalcula midiendo el dock real del layout) */
      --cwDockSpace: 160px;
      --cwCardLift: 22px;

      /* fallback (JS lo recalcula con el top real de <main>) */
      --cwMainH: calc(100svh - 64px);
    }

    /* ✅ En correlativas no uses el padding-bottom global del layout (lo manejamos acá) */
    body.bg-hatch-ios[data-section="correlativas"]{ padding-bottom: 0 !important; overflow: hidden !important; }
    body.bg-hatch-ios[data-section="correlativas"] .container-main{ padding-bottom: 0 !important; }

    /* Contenedor: centrado y SIN quedar debajo del dock */
    /* Contenedor: centrado y con padding simétrico */
    #contentBound{
      height: 100svh !important;
      padding: 10px 12px calc(10px + var(--cwDockSpace)) !important;

      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;

      box-sizing: border-box !important;
      overflow: hidden !important;
    }
    /* ✅ evita que el padding del wrapper te corra el card */
    .content-bound{ padding: 0 !important; }

    /* Card: ocupa el ancho real del contenedor (sin 100vw que desborda) */
    #correlativasCard{
      width: 100% !important;
      max-width: 100% !important;
      height: calc(100svh - var(--cwDockSpace) - 20px - var(--cwCardLift)) !important;
      margin: 0 !important;
      box-sizing: border-box !important;
      overflow: hidden !important;
    }

    /* Card (iOS) */
    #correlativasCard .board{
      border-radius: 18px !important;
      margin-bottom: 0 !important;
      padding: 12px !important;

      /* en mobile la UI es 1 columna, dejamos techo (reducido porque los recuadros son mas chicos) */
      padding-top: 148px !important;
    }

    /* Board siempre dentro de pantalla */
    .boardHeight-normal,
    .boardHeight-zoom{
      height: 100% !important;
      min-height: 0 !important;
    }

    /* UI en 1 columna */
    #topHeader.correlativas-ui{
      left: 10px !important;
      right: 10px !important;
      top: 10px !important;
      position: absolute !important;
    }
    #topHeader .ui-grid{
      grid-template-columns: 1fr !important;
      grid-template-areas:
        "right"
        "secondary"
        "left" !important;
      gap: 1px !important;   /* pegados */
    }

    /* Buscar: ocupa todo el ancho */
    #topHeader .ui-rightpanel{
      justify-self: stretch !important;
      width: 100% !important;
    }
    #topHeader .ui-rightpanel .search-wrap{ width: 100% !important; }
    #topHeader .ui-rightpanel .search-ios{ width: 100% !important; }

    /* Secundarios: NO ocupa todo el ancho, se adapta al contenido */
    #topHeader .ui-secondarypanel{
      justify-self: start !important;
      width: auto !important;
    }

    /* Anos: igual, se adapta a sus botones */
    #topHeader .ui-leftpanel{
      justify-self: start !important;
      width: auto !important;
    }

    /* Botones mas chicos */
    .seg-btn{
      height: 22px !important;
      padding: 0 7px !important;
      min-width: 0 !important;
      font-size: .68rem !important;
    }
    .search-ios{
      height: 36px !important;
      padding-left: 36px !important;
      padding-right: 12px !important;
      font-size: 13px !important;
    }
    .search-icon{
      left: 11px !important;
      width: 16px !important;
      height: 16px !important;
    }

    /* Anos: fit-content, scrolleable si no entra */
    #topHeader .ui-leftpanel .filters-wrap{
      width: fit-content !important;
      max-width: calc(100vw - 24px) !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      -webkit-overflow-scrolling: touch !important;
      scrollbar-width: none !important;
    }
    #topHeader .ui-leftpanel .filters-wrap::-webkit-scrollbar{ display:none !important; }

    /* Secundarios: fit-content, scrolleable si no entra */
    .filters-secondary-wrap{
      width: fit-content !important;
      max-width: calc(100vw - 24px) !important;
