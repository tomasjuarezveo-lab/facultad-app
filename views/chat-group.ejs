              <path d="M8 12.5l6.2-6.2a3 3 0 1 1 4.2 4.2L10 18.9a5 5 0 1 1-7.1-7.1L12 2.7" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
