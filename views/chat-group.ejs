<script>
(function(){
  const IS_ADMIN = !!window.__IS_ADMIN__;
  const chatCard = document.getElementById('chatCard');
  // =========================================================
  // THEME SYNC (solo chat-group)
  // - NO usa prefers-color-scheme
  // - Solo copia el estado que ya tenga layout en html/body
  // =========================================================
  const chatBody = document.getElementById('chatBody');

  // Tipo de chat (cursos/finales)
  const CHAT_TIPO = <%- JSON.stringify(tipo || 'finales') %>;
  const CHAT_QS   = '?tipo=' + encodeURIComponent(CHAT_TIPO);

  // ===== Reset banner show/hide (si hay texto) =====
  const resetBanner = document.getElementById('resetBannerOverlay');
  if(resetBanner){
    resetBanner.classList.add('show');
    // auto hide suave
    setTimeout(()=>{ resetBanner.classList.add('hide'); resetBanner.classList.remove('show'); }, 6500);
  }

  // ===== Back button =====
  const btnBack = document.getElementById('btnBack');
  if(btnBack){
    btnBack.addEventListener('click', ()=> {
      // vuelve atrás si se puede
      if(history.length > 1) history.back();
      else window.location.href = '/app/grupos?tab=' + encodeURIComponent(CHAT_TIPO);
    });
  }

  // ===== Fullscreen =====
  const btnFullscreen = document.getElementById('btnFullscreen');
  if(btnFullscreen){
    btnFullscreen.addEventListener('click', ()=>{
      const isFs = chatCard.classList.toggle('chat-fs');
      btnFullscreen.setAttribute('aria-pressed', isFs ? 'true' : 'false');
      document.documentElement.classList.toggle('chat-no-scroll', isFs);
      document.body.classList.toggle('chat-no-scroll', isFs);
    });
  }

  // ===== Header kebab =====
  const headerKebab = document.getElementById('headerKebab');
  const headerMenu  = document.getElementById('headerMenu');
  function closeHeaderMenu(){
    if(!headerMenu) return;
    headerMenu.classList.remove('open');
    headerMenu.setAttribute('aria-hidden','true');
    if(headerKebab) headerKebab.setAttribute('aria-expanded','false');
  }
  if(headerKebab && headerMenu){
    headerKebab.addEventListener('click', (e)=>{
      e.stopPropagation();
      const open = headerMenu.classList.toggle('open');
      headerMenu.setAttribute('aria-hidden', open ? 'false' : 'true');
      headerKebab.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', closeHeaderMenu);
  }

  // ===== Share / Copy / Leave =====
  const menuShare = document.getElementById('menuShare');
  const menuCopy  = document.getElementById('menuCopy');
  const menuLeave = document.getElementById('menuLeave');

  function getShareUrl(){
    // intenta usar URL actual
    return window.location.href;
  }
  async function copyText(txt){
    try{
      await navigator.clipboard.writeText(txt);
      toast('Copiado ✅');
    }catch(e){
      // fallback
      const ta = document.createElement('textarea');
      ta.value = txt;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
      toast('Copiado ✅');
    }
  }

  if(menuCopy){
    menuCopy.addEventListener('click', async ()=>{
      closeHeaderMenu();
      await copyText(getShareUrl());
    });
  }
  if(menuShare){
    menuShare.addEventListener('click', async ()=>{
      closeHeaderMenu();
      const url = getShareUrl();
      if(navigator.share){
        try{ await navigator.share({ title: document.title, url }); }
        catch(e){ /* cancel */ }
      } else {
        await copyText(url);
      }
    });
  }
  if(menuLeave){
    menuLeave.addEventListener('click', async ()=>{
      closeHeaderMenu();
      // intentos de endpoints (no rompe si tu backend usa otro)
      const candidates = [
        `/app/grupos/<%= subject.id %>/leave${CHAT_QS}`,
        `/app/grupos/<%= subject.id %>/salir${CHAT_QS}`,
        `/app/grupos/<%= subject.id %>/members/leave${CHAT_QS}`
      ];
      let ok = false;
      for(const url of candidates){
        try{
          const r = await fetch(url, { method:'POST', credentials:'same-origin' });
          if(r.ok){ ok = true; break; }
        }catch(e){}
      }
      if(ok) window.location.href = `/app/grupos?tab=${encodeURIComponent(CHAT_TIPO)}`;
      else toast('No se pudo salir (endpoint no encontrado).');
    });
  }

  // ===== Side panel toggle (FIX height + mobile 2/3 width) =====
  const btnTogglePanel = document.getElementById('btnTogglePanel');
  const sidePanel = document.getElementById('sidePanel');
  const panelBackdrop = document.getElementById('panelBackdrop');
  const btnClosePanel = document.getElementById('btnClosePanel');

  function openPanel(){
    if(!sidePanel) return;
    sidePanel.classList.add('open');
    sidePanel.setAttribute('aria-hidden','false');
    if(panelBackdrop){
      panelBackdrop.classList.add('open');
      panelBackdrop.setAttribute('aria-hidden','false');
    }
    if(btnTogglePanel) btnTogglePanel.setAttribute('aria-expanded','true');
  }
  function closePanel(){
    if(!sidePanel) return;
    sidePanel.classList.remove('open');
    sidePanel.setAttribute('aria-hidden','true');
    if(panelBackdrop){
      panelBackdrop.classList.remove('open');
      panelBackdrop.setAttribute('aria-hidden','true');
    }
    if(btnTogglePanel) btnTogglePanel.setAttribute('aria-expanded','false');
  }
  if(btnTogglePanel) btnTogglePanel.addEventListener('click', openPanel);
  if(btnClosePanel) btnClosePanel.addEventListener('click', closePanel);
  if(panelBackdrop) panelBackdrop.addEventListener('click', closePanel);

  // ===== Member menu dropdowns =====
  document.addEventListener('click', (e)=>{
    // cerrar menús de miembros si click afuera
    document.querySelectorAll('.member-menu-content.open').forEach(el=>{
      if(!el.contains(e.target) && !el.previousElementSibling.contains(e.target)){
        el.classList.remove('open');
      }
    });
  });

  document.querySelectorAll('.js-member-menu').forEach(btn=>{
    btn.addEventListener('click', (e)=>{
      e.stopPropagation();
      const menu = btn.parentElement.querySelector('.member-menu-content');
      if(!menu) return;
      menu.classList.toggle('open');
    });
  });

  // ===== Member "Mandar mensaje" =====
  document.querySelectorAll('.js-member-dm').forEach(it=>{
    it.addEventListener('click', ()=>{
      const uname = it.getAttribute('data-username') || 'Usuario';
      it.closest('.member-menu-content')?.classList.remove('open');
      closePanel();
      if(msgText){
        const prefix = `@${uname.replace(/\s+/g,' ').trim()} `;
        if(!(msgText.value || '').includes(prefix)){
          msgText.value = (msgText.value || '') + prefix;
        }
        msgText.focus();
      }
    });
  });

  document.querySelectorAll('.js-member-kick').forEach(it=>{
    it.addEventListener('click', async ()=>{
      const uid = it.getAttribute('data-userid') || '';
      it.closest('.member-menu-content')?.classList.remove('open');
      if(!uid) return;
      if(!confirm('¿Eliminar a este miembro del grupo?')) return;

      // intentos de endpoints
      const candidates = [
        `/app/grupos/<%= subject.id %>/members/${encodeURIComponent(uid)}/kick${CHAT_QS}`,
        `/app/grupos/<%= subject.id %>/kick/${encodeURIComponent(uid)}${CHAT_QS}`,
        `/app/grupos/<%= subject.id %>/members/remove`
      ];

      let ok = false;
      for(const url of candidates){
        try{
          const opts = { method:'POST', credentials:'same-origin', headers: { 'Content-Type':'application/json' } };
          const body = (url.endsWith('/remove')) ? JSON.stringify({ userId: uid }) : undefined;
          if(body) opts.body = body;
          const r = await fetch(url, opts);
          if(r.ok){ ok = true; break; }
        }catch(e){}
      }
      if(ok){
        toast('Miembro eliminado ✅');
        // remove from UI
        document.querySelector(`.member-card[data-userid="${CSS.escape(uid)}"]`)?.remove();
      } else {
        toast('No se pudo eliminar (endpoint no encontrado).');
      }
    });
  });

  // ===== Context menu (mine messages) =====
  document.querySelectorAll('.js-menu').forEach(btn=>{
    btn.addEventListener('click', (e)=>{
      e.stopPropagation();
      const bubble = btn.closest('.bubble');
      const menu = bubble?.querySelector('.ctx-menu');
      if(!menu) return;
      // cerrar otros
      document.querySelectorAll('.ctx-menu.open').forEach(m=>{ if(m!==menu) m.classList.remove('open'); });
      menu.classList.toggle('open');
    });
  });
  document.addEventListener('click', ()=>{
    document.querySelectorAll('.ctx-menu.open').forEach(m=>m.classList.remove('open'));
  });

  document.querySelectorAll('.js-copy').forEach(btn=>{
    btn.addEventListener('click', async ()=>{
      const bubble = btn.closest('.bubble');
            const txt =
        bubble?.querySelector('.text')?.innerText ||
        bubble?.querySelector('.wa-card')?.getAttribute('data-wa-copy') ||
        '';
      await copyText(txt);
      bubble?.querySelector('.ctx-menu')?.classList.remove('open');
    });
  });

  async function deleteOneMessage(msgId){
    const candidates = [
      `/app/grupos/<%= subject.id %>/messages/${encodeURIComponent(msgId)}/delete${CHAT_QS}`,
      `/app/grupos/<%= subject.id %>/message/${encodeURIComponent(msgId)}/delete${CHAT_QS}`,
      `/app/grupos/<%= subject.id %>/delete-message${CHAT_QS}`,
      `/app/grupos/<%= subject.id %>/messages/delete${CHAT_QS}`
    ];
    for(const url of candidates){
      try{
        const opts = { method:'POST', credentials:'same-origin', headers: { 'Content-Type':'application/json' } };
        if(url.endsWith('/delete-message') || url.endsWith('/delete')){
          // some endpoints expect {id}
          opts.body = JSON.stringify({ id: msgId, messageId: msgId });
        }
        const r = await fetch(url, opts);
        if(r.ok) return true;
      }catch(e){}
    }
    return false;
  }

  document.querySelectorAll('.js-delete').forEach(btn=>{
    btn.addEventListener('click', async ()=>{
      const row = btn.closest('.row');
      const msgId = row?.getAttribute('data-msgid');
      btn.closest('.ctx-menu')?.classList.remove('open');
      if(!msgId) return;

      if(!confirm('¿Eliminar este mensaje?')) return;
      const ok = await deleteOneMessage(msgId);
      if(ok){
        toast('Mensaje eliminado ✅');
        row?.remove();
      }else{
        toast('No se pudo eliminar (endpoint no encontrado).');
      }
    });
  });

  // ===== Admin bulk selection (FIX REAL) =====
  const btnSelectAllMsgs   = document.getElementById('btnSelectAllMsgs');
  const btnClearSelection  = document.getElementById('btnClearSelection');
  const btnDeleteSelected  = document.getElementById('btnDeleteSelected');
  const btnBulkDelete      = document.getElementById('btnBulkDelete');
  const selectedCount      = document.getElementById('selectedCount');

  function getAllAdminChecks(){
    return Array.from(document.querySelectorAll('.msg-admin-check'));
  }
  function getSelectedIds(){
    return getAllAdminChecks().filter(c=>c.checked).map(c=>c.getAttribute('data-msg-id')).filter(Boolean);
  }
  function syncSelectedUI(){
    const ids = getSelectedIds();
    const count = ids.length;
    if(selectedCount) selectedCount.textContent = String(count);
    if(btnDeleteSelected) btnDeleteSelected.disabled = (count === 0);

    // resaltar filas
    getAllAdminChecks().forEach(c=>{
      const id = c.getAttribute('data-msg-id');
      const row = c.closest('.row');
      if(!row) return;
      row.classList.toggle('is-selected', !!c.checked);
    });
  }

  async function bulkDelete(ids){
    // intenta endpoints comunes (sin romper si tu backend usa otro)
    const candidates = [
      `/app/grupos/<%= subject.id %>/messages/bulk-delete${CHAT_QS}`,
      `/app/grupos/<%= subject.id %>/bulk-delete${CHAT_QS}`,
      `/app/grupos/<%= subject.id %>/messages/delete-selected${CHAT_QS}`,
      `/app/grupos/<%= subject.id %>/messages/delete${CHAT_QS}`
    ];
    for(const url of candidates){
      try{
        const r = await fetch(url, {
          method:'POST',
          credentials:'same-origin',
          headers: { 'Content-Type':'application/json' },
          body: JSON.stringify({ ids, messageIds: ids })
        });
        if(r.ok) return true;
      }catch(e){}
    }
    // fallback: delete uno por uno
    let okAll = true;
    for(const id of ids){
      const ok = await deleteOneMessage(id);
      if(!ok) okAll = false;
    }
    return okAll;
  }

  if(IS_ADMIN){
    // click checkbox => update
    getAllAdminChecks().forEach(c=>{
      c.addEventListener('change', syncSelectedUI);
    });

    if(btnSelectAllMsgs){
      btnSelectAllMsgs.addEventListener('click', ()=>{
        getAllAdminChecks().forEach(c=>{ c.checked = true; });
        syncSelectedUI();
      });
    }
    if(btnClearSelection){
      btnClearSelection.addEventListener('click', ()=>{
        getAllAdminChecks().forEach(c=>{ c.checked = false; });
        syncSelectedUI();
      });
    }

    async function handleDeleteSelected(){
      const ids = getSelectedIds();
      if(ids.length === 0) return;
      if(!confirm(`¿Borrar ${ids.length} mensaje(s) seleccionados?`)) return;

      if(btnDeleteSelected) btnDeleteSelected.disabled = true;
      if(btnBulkDelete) btnBulkDelete.disabled = true;

      const ok = await bulkDelete(ids);

      if(ok){
        ids.forEach(id=>{
          const row = document.querySelector(`.row[data-msgid="${CSS.escape(id)}"]`);
          row?.remove();
        });
        // limpiar checks (por si quedan)
        getAllAdminChecks().forEach(c=>{ c.checked = false; });
        syncSelectedUI();
        toast('Mensajes eliminados ✅');
      }else{
        toast('No se pudieron borrar todos (revisá endpoint).');
        syncSelectedUI();
      }

      if(btnBulkDelete) btnBulkDelete.disabled = false;
    }

    if(btnDeleteSelected) btnDeleteSelected.addEventListener('click', handleDeleteSelected);
    if(btnBulkDelete) btnBulkDelete.addEventListener('click', handleDeleteSelected);

    // init
    syncSelectedUI();
  }

  // ===== Simple toast =====
  function toast(text){
    let t = document.getElementById('__toast');
    if(!t){
      t = document.createElement('div');
      t.id = '__toast';
      t.style.position = 'fixed';
      t.style.left = '50%';
      t.style.bottom = '26px';
      t.style.transform = 'translateX(-50%)';
      t.style.padding = '10px 14px';
      t.style.borderRadius = '9999px';
      t.style.background = 'rgba(255,255,255,.85)';
      t.style.border = '1px solid rgba(15,23,42,.12)';
      t.style.boxShadow = '0 18px 30px rgba(15,23,42,.16)';
      t.style.backdropFilter = 'blur(12px) saturate(150%)';
      t.style.webkitBackdropFilter = 'blur(12px) saturate(150%)';
      t.style.fontWeight = '900';
      t.style.color = '#0f172a';
      t.style.zIndex = '2147483647';
      t.style.opacity = '0';
      t.style.transition = 'opacity .18s ease, transform .18s ease';
      document.body.appendChild(t);
    }
    t.textContent = text;
    t.style.opacity = '1';
    t.style.transform = 'translateX(-50%) translateY(0)';
    clearTimeout(window.__toastTO);
    window.__toastTO = setTimeout(()=>{
      t.style.opacity = '0';
      t.style.transform = 'translateX(-50%) translateY(6px)';
    }, 1800);
  }

  // ===== Emoji picker =====
  const emojiBtn = document.getElementById('emojiBtn');
  const emojiPicker = document.getElementById('emojiPicker');
  const emojiGrid = document.getElementById('emojiGrid');
  const msgText = document.getElementById('msgText');

  const EMOJIS = {
    // ✅ Caras (ordenadas de “feliz” → “triste/enojo” → “sorpresa” → “otros”)
    faces: [
      "🙂","😀","😁","😄","😃","😊","☺️","😌","😉","😋","😛","😜","🤪","😝","😅","😂","🤣","🥹","😇",
      "😍","🥰","😘","😗","😚","😙","🤩","😎","🥳","😏","😒","🙃","🤔","🫡","🤗",
      "😐","😑","😶","🫥","😬","🫤","😮","😯","😲","😳","🥺","😢","😭","😤","😠","😡","🤬","🤯",
      "😴","😪","🥱","😵","😵‍💫","🤐","🤢","🤮","🤧","😷","🤒","🤕",
      "👻","💀","☠️","🤖","🎃"
    ],

    // ✅ Gestos (ordenados “positivo” → “mano” → “señales” → “rezo/abrazo”)
    gestures: [
      "👍","👍🏻","👍🏼","👍🏽","👍🏾","👍🏿","👎","👏","🙌","🫶","🤝","🙏","💪","✊","👊",
      "👌","🤌","🤏","✌️","🤞","🤟","🤘","🖐️","✋","👋","🫡",
      "👉","👈","☝️","👇","🫵","🖕",
      "🤗","🫂"
    ],

    // ✅ Amor / corazones
    hearts: [
      "❤️","🧡","💛","💚","💙","💜","🩷","🩵","🩶","🤍","🖤","🤎",
      "💖","💘","💝","💗","💓","💕","💞","💟","❤️‍🔥","❤️‍🩹"
    ],

    // ✅ Animales (ordenados: mascotas → selva → granja → mar → bichos)
    animals: [
      "🐶","🐕","🐩","🐺","🦊","🐱","🐈","🐯","🦁","🐻","🐻‍❄️","🐼","🐨",
      "🐭","🐹","🐰","🦝","🦓","🦒","🐘","🦏","🦛",
      "🐮","🐷","🐽","🐸","🐵","🐔","🐧","🐦","🦉",
      "🐟","🐠","🐡","🦈","🐬","🐳","🐋","🦭",
