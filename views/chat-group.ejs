    async function submitWhatsappCard(){
    const raw = (waNumberInput?.value || '').trim();

    const groupLink = normalizeWaGroupLink(raw);
    const digits    = normalizeWaNumber(raw);

    let markerText = '';
    let successMsg = '';

    if(groupLink){
      markerText = WA_GROUP_MARKER_PREFIX + groupLink;
      successMsg = 'Link de grupo compartido ✅';
    } else if(digits && digits.length >= 8){
      markerText = WA_CONTACT_MARKER_PREFIX + digits;
      successMsg = 'Contacto compartido ✅';
    } else {
      toast('Pegá un número válido o un link de grupo válido');
      waNumberInput?.focus();
      return;
    }

    if(waModalSend){
      waModalSend.disabled = true;
      waModalSend.style.opacity = '0.7';
      waModalSend.textContent = 'Enviando...';
    }

    try{
      localStorage.setItem(WA_STORAGE_KEY, raw);
    }catch(e){}

    closeWaModal();

    const ok = await sendChatText(markerText, { clearComposer: false });

    if(ok) toast(successMsg);
    else toast('No se pudo compartir');

    if(waModalSend){
      waModalSend.disabled = false;
      waModalSend.style.opacity = '';
      waModalSend.textContent = 'Enviar';
    }
  }

  if(waModalSend){
    waModalSend.addEventListener('click', submitWhatsappCard);
  }
  if(waNumberInput){
    waNumberInput.addEventListener('keydown', (e)=>{
      if(e.key === 'Enter'){
        e.preventDefault();
        submitWhatsappCard();
      }else if(e.key === 'Escape'){
        closeWaModal();
      }
    });
  }
  
