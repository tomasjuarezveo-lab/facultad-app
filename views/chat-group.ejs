  // ===== WhatsApp card helpers =====
  const WA_CONTACT_MARKER_PREFIX = '__CW_WA__:';       // compatibilidad con lo que ya tenías
  const WA_GROUP_MARKER_PREFIX   = '__CW_WA_GROUP__:'; // nuevo
  const WA_STORAGE_KEY           = 'cw_whatsapp_share_value_v2';
  const WA_DEFAULT_TEXT          = 'Hola! me pasaste tu numero por *Clever Wave*';

  function normalizeWaNumber(raw){
    return String(raw || '').replace(/[^\d]/g, '');
  }

  function normalizeWaGroupLink(raw){
    let s = String(raw || '').trim();
    if(!s) return null;

    // Si pega sin protocolo
    if(/^chat\.whatsapp\.com\//i.test(s)){
      s = 'https://' + s;
    }

    try{
      const u = new URL(s);
      const host = (u.hostname || '').toLowerCase();

      // links válidos de invitación a grupo
      if(host !== 'chat.whatsapp.com' && host !== 'www.chat.whatsapp.com'){
        return null;
      }

      // formato típico: /ABCDefGhIJKlmNopQRstuV
      const code = (u.pathname || '').replace(/^\/+/, '').trim();
      if(!code || code.length < 10) return null;

      return `https://chat.whatsapp.com/${code}`;
    }catch(e){
      return null;
    }
  }

  function parseWaPayload(rawText){
    const s = String(rawText || '').trim();
    if(!s) return null;

    // ✅ compatibilidad con mensajes viejos (contacto)
    if(s.startsWith(WA_CONTACT_MARKER_PREFIX)){
      const n = normalizeWaNumber(s.slice(WA_CONTACT_MARKER_PREFIX.length));
      if(n && n.length >= 8){
        return { kind: 'contact', value: n };
      }
      return null;
    }

    // ✅ nuevo: link de grupo
    if(s.startsWith(WA_GROUP_MARKER_PREFIX)){
      const link = normalizeWaGroupLink(s.slice(WA_GROUP_MARKER_PREFIX.length));
      if(link){
        return { kind: 'group', value: link };
      }
      return null;
    }

    return null;
  }

  function buildWaHref(phoneDigits){
    const n = normalizeWaNumber(phoneDigits);
    const txt = encodeURIComponent(WA_DEFAULT_TEXT);
    return `https://wa.me/${n}?text=${txt}`;
  }

  function buildWhatsAppCardHTML(payload){
    if(!payload) return '';

    if(payload.kind === 'contact'){
      const n = normalizeWaNumber(payload.value);
      if(!n) return '';

      const href = buildWaHref(n);
      const pretty = '+' + n;

      return `
        <div class="wa-card" data-wa-copy="${escHtml(pretty)}">
          <div class="wa-card-title">Contacto de WhatsApp</div>
          <div class="wa-card-number">${escHtml(pretty)}</div>
          <a class="wa-card-btn" href="${escHtml(href)}" target="_blank" rel="noopener">
            Escribime al WhatsApp
          </a>
        </div>
      `;
    }

    if(payload.kind === 'group'){
      const link = normalizeWaGroupLink(payload.value);
      if(!link) return '';

      return `
        <div class="wa-card" data-wa-copy="${escHtml(link)}">
          <div class="wa-card-title">Invitación a grupo de WhatsApp</div>
