    function parseServerTimestamp(ts){
    if(!ts) return null;

    const s = String(ts).trim();
    if(!s) return null;

    // Si ya viene con zona horaria, usar tal cual
    if (/[zZ]|[+-]\d{2}:?\d{2}$/.test(s)) {
      return new Date(s);
    }

    // SQLite/libSQL CURRENT_TIMESTAMP suele venir como "YYYY-MM-DD HH:MM:SS" en UTC
    return new Date(s.replace(' ', 'T') + 'Z');
  }

  function fmtLocal(ts){
    try{
      const d = parseServerTimestamp(ts);
      if(d && !isNaN(d.getTime())){
        return d.toLocaleString('es-AR', {
          timeZone: 'America/Argentina/Buenos_Aires',
          year:'numeric',
          month:'2-digit',
          day:'2-digit',
          hour:'2-digit',
          minute:'2-digit',
          hour12:false
        }).replace(',', ' -');
      }
    }catch(e){}
    return String(ts || '');
  }

