  let matches = [];
  let curIdx = -1;

  function clearMarks(){
    if(!chatBody) return;
    chatBody.querySelectorAll('mark.hl').forEach(m=>{
      const parent = m.parentNode;
      parent.replaceChild(document.createTextNode(m.textContent), m);
      parent.normalize();
    });
    chatBody.querySelectorAll('.current-match').forEach(el=>el.classList.remove('current-match'));
  }

  function markAll(q){
    clearMarks();
    matches = [];
    curIdx = -1;
    if(!q || !chatBody) {
      if(findCount) findCount.textContent = '0/0';
      return;
    }
    const rows = Array.from(chatBody.querySelectorAll('.row'));
    const rx = new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'), 'ig');

    rows.forEach(row=>{
      const textEl = row.querySelector('.text');
      if(!textEl) return;
      const raw = textEl.innerText;
      if(!raw || !rx.test(raw)) return;

      // rebuild with marks
      const parts = raw.split(rx);
      const found = raw.match(rx);
      if(!found) return;

      const frag = document.createDocumentFragment();
      for(let i=0;i<parts.length;i++){
        frag.appendChild(document.createTextNode(parts[i]));
        if(i < found.length){
          const mk = document.createElement('mark');
          mk.className = 'hl';
          mk.textContent = found[i];
          frag.appendChild(mk);
        }
      }
      textEl.innerHTML = '';
      textEl.appendChild(frag);

      row.querySelectorAll('mark.hl').forEach(mk=>matches.push(mk));
    });

    if(findCount) findCount.textContent = matches.length ? `1/${matches.length}` : '0/0';
    if(matches.length){
      curIdx = 0;
      focusMatch(0);
    }
  }

  function focusMatch(i){
    if(!matches.length) return;
    curIdx = (i + matches.length) % matches.length;
    matches.forEach(mk=>mk.closest('.row')?.classList.remove('current-match'));
    const mk = matches[curIdx];
    const row = mk.closest('.row');
    row?.classList.add('current-match');
    row?.scrollIntoView({ behavior:'smooth', block:'center' });
    if(findCount) findCount.textContent = `${curIdx+1}/${matches.length}`;
  }

