  function appendPendingMessage(text){
  if(!chatBody) return null;

  const tempId = 'tmp-' + Date.now() + '-' + Math.random().toString(16).slice(2);

  const row = document.createElement('div');
  row.className = 'row me is-pending';
  row.setAttribute('data-msgid', tempId);

  // (opcional) checkbox admin para mantener consistencia visual
  if(IS_ADMIN){
    const chk = document.createElement('input');
    chk.type = 'checkbox';
    chk.className = 'msg-admin-check';
    chk.setAttribute('data-msg-id', tempId);
    chk.setAttribute('aria-label', 'Seleccionar mensaje');
    chk.disabled = true; // no seleccionable mientras está pendiente
    row.appendChild(chk);
  }

  const rawText = String(text || '');
  const safeText = escHtml(rawText);
  const waPayload = parseWaPayload(rawText);

  const pendingBody = waPayload
    ? buildWhatsAppCardHTML(waPayload)
    : `<div class="text">${safeText.replaceAll('\n','<br>')}</div>`;

  const bubble = document.createElement('div');
  bubble.className = 'bubble';
  bubble.innerHTML = `
    <div class="bubble-head">
      <span class="who">Vos</span>
    </div>
    ${pendingBody}
  `;
  row.appendChild(bubble);

  // avatar derecha (mensaje mío)
  const av = document.createElement('div');
  av.className = 'msg-avatar';
  av.setAttribute('data-userid', String(ME_ID));
  av.innerHTML = `
    <img src="/public/avatars/${escHtml(String(ME_ID))}.png" alt="Avatar" onerror="this.parentElement.setAttribute('data-fallback','1')">
    <span class="initial">V</span>
  `;
  row.appendChild(av);

  const stamp = document.createElement('div');
  stamp.className = 'stamp';
  stamp.textContent = 'Enviando…';
  row.appendChild(stamp);

  chatBody.appendChild(row);
  chatBody.scrollTop = chatBody.scrollHeight;

  pending.set(tempId, row);
  return { tempId, row };
}

  function resolvePending(tempId, serverMsg){
    const row = pending.get(tempId);
    if(row){
      row.remove();
      pending.delete(tempId);
    }
    if(serverMsg) appendMessage(serverMsg);
  }

  function failPending(tempId, label){
    const row = pending.get(tempId);
    if(!row) return;
    row.classList.remove('is-pending');
    row.classList.add('send-failed');
    const st = row.querySelector('.stamp');
    if(st) st.textContent = label || 'No enviado';
  }


  // ✅ SSE realtime
  function startStream(){
    try{
      const es = new EventSource(`/app/grupos/${SUBJECT_ID}/stream${CHAT_QS}`);
      es.addEventListener('history', (e)=>{
        try{
          const arr = JSON.parse(e.data || '[]');
          (arr || []).forEach(appendMessage);
        }catch(_){}
      });
      es.addEventListener('ping', ()=>{});
      es.onmessage = (e)=>{
        try{
          const data = JSON.parse(e.data || '{}');
          if(data && data.type === 'message'){
            const payload = data.payload;
            // bulk delete aviso
            if(payload && payload.kind === 'messages-deleted' && Array.isArray(payload.ids)){
              payload.ids.forEach(mid=>{
                const el = document.querySelector(`.row[data-msgid="${CSS.escape(String(mid))}"]`);
                if(el) el.remove();
                seen.delete(String(mid));
              });
              try{ syncSelectedUI(); }catch(e){}
              return;
            }
            appendMessage(payload);
          }
        }catch(_){}
      };
      es.onerror = ()=>{ /* el browser reintenta solo */ };
    }catch(e){}
  }
  startStream();

  // ✅ Submit FIX (sin refresh)
  // ✅ Submit FIX (sin refresh) + ✅ OPTIMISTIC (aparece instantáneo)
    async function sendChatText(rawText, opts = {}){
    const text = String(rawText || '').trim();
    if(!text) return false;

    const clearComposer = !!opts.clearComposer;
    if(clearComposer && msgText) msgText.value = '';

    const pendingItem = appendPendingMessage(text);

    try{
      const r = await fetch(`/app/grupos/${SUBJECT_ID}/messages${CHAT_QS}`, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
        body: new URLSearchParams({ text })
      });

      const j = await r.json().catch(()=>null);

      if(!r.ok || !j || !j.ok){
        toast((j && j.error) ? j.error : 'No se pudo enviar');
        if(pendingItem) failPending(pendingItem.tempId, 'Error al enviar');
        return false;
      }else{
        if(pendingItem) resolvePending(pendingItem.tempId, j.message);
        else if(j.message) appendMessage(j.message);
        return true;
      }
    }catch(err){
      toast('Error de red al enviar');
      if(pendingItem) failPending(pendingItem.tempId, 'Error de red');
      return false;
    }finally{
      msgText?.focus();
    }
  }

  // ✅ Submit FIX (sin refresh) + ✅ OPTIMISTIC
  if(composer && msgText){
    composer.addEventListener('submit', async (e)=>{
      e.preventDefault();
      await sendChatText(msgText.value, { clearComposer: true });
    });

    // Enter envía (sin shift)
    msgText.addEventListener('keydown', (e)=>{
      if(e.key === 'Enter' && !e.shiftKey){
        e.preventDefault();
        composer.requestSubmit();
      }
    });
  }


  // =========================================================
  // ✅ Adjuntos: subir imagen/archivo a los endpoints reales
  // =========================================================
  const fileImg = document.createElement('input');
  fileImg.type = 'file';
  fileImg.accept = 'image/*';
  fileImg.multiple = true;
  fileImg.style.display = 'none';

  const fileDoc = document.createElement('input');
  fileDoc.type = 'file';
  fileDoc.accept = '.pdf,.doc,.docx,.ppt,.pptx,application/pdf';
  fileDoc.multiple = true;
  fileDoc.style.display = 'none';

  document.body.appendChild(fileImg);
  document.body.appendChild(fileDoc);

  async function uploadFiles(kind, files){
    if(!files || !files.length) return;
    const fd = new FormData();
    const field = (kind === 'image') ? 'photos' : 'docs';
    for(const f of files) fd.append(field, f);

    const url = (kind === 'image')
      ? `/app/grupos/${SUBJECT_ID}/upload/photos${CHAT_QS}`
      : `/app/grupos/${SUBJECT_ID}/upload/docs${CHAT_QS}`;

    try{
      toast('Subiendo...');
      const r = await fetch(url, { method:'POST', credentials:'same-origin', body: fd });
      const j = await r.json().catch(()=>null);
      if(!r.ok || !j || !j.ok){
        toast((j && j.error) ? j.error : 'No se pudo subir');
        return;
      }
      // agrega inmediato (SSE también lo va a replicar, dedupe por id)
      (j.messages || []).forEach(appendMessage);
      toast('Subido ✅');
    }catch(e){
      toast('Error de red al subir');
    }
  }

  // click en menú adjuntos
  if(attachMenu){
    attachMenu.querySelectorAll('.attach-item').forEach(item=>{
      item.addEventListener('click', (e)=>{
        e.preventDefault();
        e.stopPropagation();

        const t = item.getAttribute('data-type');
        closeAttach();

        // ✅ WhatsApp abre el modal (y NO archivos)
        if(t === 'whatsapp'){
          openWaModal();
          return;
        }

        // ✅ Imagen / Archivo: por ahora solo cartel
        if(t === 'image' || t === 'file'){
          toast('Próximamente');
          return;
        }
      });
    });
  }

  fileImg.addEventListener('change', async ()=>{
    const files = Array.from(fileImg.files || []);
    fileImg.value = '';
    await uploadFiles('image', files);
  });

  fileDoc.addEventListener('change', async ()=>{
    const files = Array.from(fileDoc.files || []);
    fileDoc.value = '';
    await uploadFiles('doc', files);
  });
  // hidrata tarjetas de WhatsApp guardadas como texto especial
  hydrateWhatsappCardsInDOM();
  // ===== Scroll to bottom on load =====
  if(chatBody) chatBody.scrollTop = chatBody.scrollHeight;

})();
</script>
