<!-- ===========================
  chat-group.ejs (COMPLETO)
  - Fix admin delete (seleccionar / quitar / borrar seleccionados)
  - Fix checkbox UI (no se superpone / no queda fuera)
  - Panel lateral: mismo ALTO que el chat (desktop y mobile)
  - Mobile panel: ancho ~ 2/3 del chat (no full-screen) + estética mejorada
  - NO cambia IDs (para no romper nada)
=========================== -->

<!-- ===== Overlay Reset Banner (always rendered; does not affect layout) ===== -->
<%
  // === Reset banner: resolve text safely (no runtime errors if vars missing) ===
  var __resetText = "";
  try {
    if (typeof nextResetText !== "undefined" && nextResetText) {
      __resetText = nextResetText;
    } else if (typeof group !== "undefined" && group) {
      __resetText = (group.nextResetText || group.resetText || group.reset_at_text || group.resetAtText || "");
    }
  } catch (e) { __resetText = ""; }
%>

<div class="reset-banner-overlay" id="resetBannerOverlay" role="note" aria-live="polite">
  <div class="reset-banner-pill">
    <p class="text-xs text-slate-500">
      <% if (__resetText) { %>
        Los miembros y mensajes del grupo serán reseteados el <%= __resetText %> a las 23:59.
      <% } else { %>
        Los miembros y mensajes del grupo serán reseteados próximamente.
      <% } %>
    </p>
  </div>
</div>

<style>
  /* ===== Reset Banner (Glass iOS pill overlay) ===== */
  .reset-banner-overlay{
    position: fixed;
    left: 50%;
    top: calc(var(--reset-banner-top, 88px) + env(safe-area-inset-top, 0px));
    transform: translateX(-50%) translateY(-12px);
    z-index: 2147483647;
    pointer-events: none;

    width: auto;
    max-width: min(1000px, 84%);

    opacity: 0;
    transition: opacity 280ms ease, transform 280ms ease;
    will-change: opacity, transform;
  }
  .reset-banner-overlay.show{ opacity: 1; transform: translateX(-50%) translateY(0); }
  .reset-banner-overlay.hide{ opacity: 0; transform: translateX(-50%) translateY(-12px); }

  .reset-banner-pill{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 18px;
    min-height: 30px;
    border-radius: 9999px;
    background: rgba(255,255,255,0.36);
    border: 1px solid rgba(255,255,255,0.55);
    box-shadow: 0 10px 28px rgba(15,23,42,0.18);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    text-align: center;
  }
  .reset-banner-pill p{
    margin: 0;
    font-size: 0.75rem;
    color: #475569;
    line-height: 1.25rem;
    white-space: nowrap;
  }
  @media (max-width: 640px){
    .reset-banner-overlay{ max-width: 92%; }
    .reset-banner-pill{ padding: 6px 14px; }
    .reset-banner-pill p{ white-space: normal; }
  }

  /* ✅ Por las dudas: si quedó algo viejo en el layout, lo apagamos */
  .reset-box{ display: none !important; }
  .reset-banner{ display: none !important; }
</style>

<%
  function cleanName(n){
    return String(n || '').replace(/\s*\([^)]*\)\s*/g, '').trim();
  }
  function parseUTC(ts){
    if(!ts) return null;
    const s0 = String(ts).trim();
    if(!s0) return null;
    if (/[zZ]|[+-]\d{2}:?\d{2}$/.test(s0)) return new Date(s0);
    const iso = s0.replace(' ', 'T');
    return new Date(iso + 'Z');
  }
  function fmt(ts){
    const d = parseUTC(ts);
    if(!d || isNaN(d.getTime())) return String(ts || '');
    const s = d.toLocaleString('es-AR', {
      timeZone: 'America/Argentina/Buenos_Aires',
      year:'numeric', month:'2-digit', day:'2-digit',
      hour:'2-digit', minute:'2-digit',
      hour12:false
    });
    return s.replace(',', ' -');
  }
  const __chatTipo = (typeof tipo !== 'undefined' && String(tipo).toLowerCase() === 'cursos') ? 'cursos' : 'finales';
  const __subjectName = cleanName(subject?.name);
  const groupName    = (__chatTipo === 'cursos' ? 'Cursada de ' : 'Final de ') + __subjectName;
  const groupInitial = (__subjectName && __subjectName[0] ? __subjectName[0] : 'G').toUpperCase();
  const meId = user?.id;

  // si tenés arrays opcionales, no rompe:
  const __members = (typeof members !== "undefined" && members) ? members : (typeof groupMembers !== "undefined" && groupMembers ? groupMembers : []);
%>

<style>
  :root{
    --dock-offset: 233px;

    --chat-bg: #eae6df;
    --chat-paper: #ffffff;

    --msg-me:  #F8C160;
    --msg-oth: #cfe9ff;
    --name-me: #ff9800;
    --name-ot: #2196f3;

    --ink: #0f172a;
    --muted:#64748b;
    --shadow: 0 10px 24px rgba(15,23,42,.10);

    --hl-bg: #fff59d;
    --hl-ring: #f59e0b;

    --panel-glass: rgb(255, 255, 255);
    --panel-stroke: rgb(255, 255, 255);
    --panel-shadow: 0 18px 34px rgba(15,23,42,.18);

    --btn-bg: rgba(255,255,255,.78);
    --btn-stroke: rgba(15,23,42,.10);
    --btn-shadow: 0 10px 22px rgba(15,23,42,.12), inset 0 1px 0 rgba(255,255,255,.9);
  }

  html.chat-no-scroll, body.chat-no-scroll { overflow: hidden !important; }
  html, body{ overflow-x: hidden !important; }

  /* ✅ evita corte horizontal (no puede exceder viewport) */
  .chat-frame{
    width: min(1100px, calc(100vw - 20px));
    max-width: min(1100px, calc(100vw - 20px));
    margin: 10px auto;

    border-radius: 16px;
    overflow: hidden;
    height: calc(100dvh - var(--dock-offset));
  }
  @supports (height: env(safe-area-inset-bottom)){
    .chat-frame{ height: calc(100vh - var(--dock-offset) - env(safe-area-inset-bottom)); }
  }

  .chat-card{
    height: 100%;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
    border-radius: 18px;
    background: var(--chat-paper);
  }

  /* Header */
  .chat-header{
    background: #f7f7f7;
    border-bottom: 1px solid #e5e7eb;
    height: 64px;
    padding: 0 12px 0 16px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    position: relative;
  }

  .header-left{ display:flex; align-items:center; gap:12px; cursor: pointer; min-width: 0; }
  .min-w-0{ min-width: 0; }

  .avatar-wrap{ position: relative; width:44px; height:44px; flex:0 0 auto; }
  .avatar-img{
    width:44px; height:44px; border-radius:9999px; border:1px solid #e5e7eb;
    object-fit:cover; background:#e5e7eb;
    display:block;
  }
  .avatar-initial{ position:absolute; inset:0; display:grid; place-items:center; font-weight:800; color:#0f172a; }

  .chat-header .title{ font-weight: 800; color: var(--ink); line-height: 1.1; }
  .chat-header .subtitle{ font-size: .8rem; color: var(--muted); }

  .truncate{
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .header-kebab{
    justify-self: end; border:none; background: transparent; cursor:pointer;
    width: 36px; height: 36px; border-radius: 9999px; font-size: 20px;
  }
  .header-kebab:hover{ background:#eceff3; }

  .header-menu{
    position: absolute; top: 56px; right: 8px; z-index: 120;
    background:#fff; border:1px solid #e5e7eb; border-radius: 12px; box-shadow: 0 10px 24px rgba(15,23,42,.15);
    display: none; overflow: hidden; min-width: 180px;
  }
  .header-menu.open{ display:block; }
  .header-menu .item{ padding:10px 14px; cursor:pointer; display:flex; align-items:center; gap:10px; }
  .header-menu .item:hover{ background:#f6f7f9; }
  .header-menu .item.danger{ color:#b42318; }
  .header-menu svg{ width:18px; height:18px; }

  /* Attach & Fullscreen */
  .attach-btn{
    width: 44px; height: 44px; border-radius: 9999px; border: 1px solid #e5e7eb;
    background:#fff; display:grid; place-items:center; cursor:pointer;
  }
  .attach-btn:hover{ background:#f7f7f7; }

  .attach-menu{
    position: fixed; z-index: 2147483000;
    display:none; flex-direction:column; gap:8px;
    background:#fff; border:1px solid #e5e7eb; border-radius:14px; padding:10px;
    box-shadow: var(--shadow); transform-origin: bottom right;
    animation: popUp .18s ease-out;
  }
  .attach-menu.open{ display:flex; }

  .attach-item{
    height:38px; border-radius:9999px; padding:0 14px; display:flex; align-items:center; gap:10px;
    border:1px solid #e5e7eb; cursor:pointer; user-select:none;
  }
  .attach-item:hover{ background:#f7f7f7; }

  @keyframes popUp{
    from{ opacity:0; transform: translateY(10px) scale(0.98); }
    to  { opacity:1; transform: translateY(0)    scale(1.00); }
  }

  .chat-fs-btn{
    width:40px; height:40px; border-radius:9999px;
    border:1px solid transparent; background: transparent;
    display:grid; place-items:center; cursor:pointer;
    position:absolute; top:12px; right:54px; z-index: 110;
    transform: translatex(-40px);
  }
  .chat-fs-btn:hover{ background:#f1f5f9; }

  .chat-back-btn{ right: 50px; }
  .chat-card.is-admin .chat-back-btn{ right: 182px; } /* deja lugar a herramientas admin */

  .chat-card.chat-fs{
    position: fixed; inset:0; width:100vw; height:100vh; z-index:2147483000; border-radius:0;
    background: var(--chat-paper, #fff);
  }

  /* ===== Admin bulk tools (FIX) ===== */
  .admin-bulk-tools{
    position: absolute;
    top: 12px;
    right: 140px;
    display:flex;
    gap:8px;
    align-items:center;
    padding: 6px 8px;
    border-radius: 9999px;
    background: rgba(255,255,255,.78);
    border: 1px solid rgba(15,23,42,.10);
    box-shadow: 0 10px 22px rgba(15,23,42,.10), inset 0 1px 0 rgba(255,255,255,.9);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    z-index: 115;
  }
  .admin-bulk-tools button{
    height: 32px;
    padding: 0 10px;
    border-radius: 9999px;
    border: 1px solid rgba(15,23,42,.10);
    background: rgba(255,255,255,.92);
    cursor: pointer;
    font-weight: 800;
    font-size: 12px;
    color: #0f172a;
  }
  .admin-bulk-tools button:hover{ background: #fff; }
  .admin-bulk-tools button:disabled{ opacity:.55; cursor:not-allowed; }
  #btnDeleteSelected{
    background: #ef4444;
    border-color: #ef4444;
    color: #fff;
  }
  #selectedCount{ font-size: 12px; color:#475569; padding: 0 4px; white-space: nowrap; }

  /* Body (único con scroll) */
  .chat-body{
    background: var(--chat-bg) url('/public/img/whatsapp-pattern.png');
    background-size: 400px 400px;
    padding: 16px;
    overflow-y: auto; overflow-x: hidden;
    scroll-behavior: smooth;
    position: relative;
  }

  /* Mensajes */
  .row{
    display: grid;
    gap: 8px;
    margin: 8px 0;
    max-width: 50%;
    position: relative;

    /* ✅ espacio para checkbox admin */
    padding-left: 30px;
    padding-right: 30px;
  }
  .row.other{
    grid-template-columns: 36px minmax(0,1fr);
    justify-items: start; align-items: end;
  }
  .row.me{
    grid-template-columns: minmax(0,1fr) 36px;
    justify-items: end; align-items: end; margin-left: auto;
  }

  /* ✅ checkbox admin (ARREGLADO: ahora el input es el checkbox) */
  .msg-admin-check{
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    cursor: pointer;
    z-index: 3;
    accent-color: #ef4444;
  }
  .row.other .msg-admin-check{ left: 6px; }
  .row.me    .msg-admin-check{ right: 6px; }

  /* ✅ resaltar fila seleccionada */
  .row.is-selected .bubble{
    outline: 2px solid rgba(239,68,68,.55);
    box-shadow: 0 16px 34px rgba(239,68,68,.12);
  }

  .msg-avatar{
    width: 36px; height: 36px; border-radius: 9999px; overflow: hidden;
    border: 1px solid #e5e7eb; background: #e2e8f0; display: grid; place-items: center;
    color:#0f172a; font-weight: 800; font-size: .85rem;
  }
  .msg-avatar img{ width: 100%; height: 100%; object-fit: cover; display: block; }
  .msg-avatar .initial{ display: none; }
  .msg-avatar[data-fallback="1"] .initial{ display: grid; }
  .msg-avatar[data-fallback="1"] img{ display: none; }

  .bubble{
    padding: 10px 12px;
    border-radius: 22px;
    font-size: .98rem; line-height: 1.25;
    word-wrap: break-word; overflow-wrap: anywhere;
    position: relative;
    box-shadow: 0 10px 18px rgba(15,23,42,.06);
  }
  .row.me .bubble{ background: var(--msg-me); border-top-right-radius: 12px; }
  .row.other .bubble{ background: var(--msg-oth); border-top-left-radius: 12px; }

  .bubble-head{
    display: flex; align-items: center; gap: 8px; margin-bottom: 6px;
  }
  .row.other .bubble-head{ justify-content: flex-start; }
  .row.me    .bubble-head{ justify-content: flex-end; }

  .who{ font-weight: 900; }
  .row.me .who{ color: var(--name-me); }
  .row.other .who{ color: var(--name-ot); }

  .menu-btn{
    line-height: 0; background: transparent; border: none; cursor: pointer;
    font-size: 18px; opacity: .85;
  }
  .menu-btn:hover{ opacity: 1; }

  .ctx-menu{
    position: absolute; top: 6px; right: 8px; z-index: 10;
    background: #fff; border: 1px solid #e5e7eb; border-radius: 12px;
    box-shadow: 0 10px 24px rgba(15,23,42,.15); overflow: hidden;
    display: none;
  }
  .ctx-menu.open{ display: block; }
  .ctx-item{
    padding: 10px 14px; font-size: .92rem; white-space: nowrap; cursor: pointer;
  }
  .ctx-item:hover{ background:#f6f7f9; }
  .ctx-item.danger{ color:#b42318; }

  .text{ white-space: pre-wrap; }

  .stamp{
    font-size: .68rem; color:#667085; white-space: nowrap; margin-top: 2px;
  }
  .row.other .stamp{ grid-column: 2; justify-self: start; }
  .row.me    .stamp{ grid-column: 1; justify-self: end; }

  /* Composer */
  .chat-composer{
    position: relative;
    background: #f0f2f5; border-top: 1px solid #e5e7eb;
    padding: 10px;
    display: grid; grid-template-columns: 1fr auto auto auto; gap: 10px;
  }
  .chat-input{
    height: 44px; border-radius: 9999px; padding: 0 14px;
    border: 1px solid #e5e7eb; background: #fff; outline: none;
  }
  .emoji-btn{
    width: 44px; height: 44px; border-radius: 9999px; border: 1px solid #e5e7eb;
    background:#fff; display:grid; place-items:center; cursor:pointer;
  }
  .emoji-btn:hover{ background:#f7f7f7; }
  .send-btn{
    height: 44px; padding: 0 16px; border-radius: 9999px;
    background: #F8C160;
    color: #111827; font-weight: 900;
    border: 1px solid rgba(254,132,25,.25);
    box-shadow: 0 12px 22px rgba(15,23,42,.12), inset 0 1px 0 rgba(255,255,255,.7);
  }
  .send-btn[disabled]{ opacity:.6; cursor:not-allowed; }

  /* Emoji picker (simple & estable) */
  .emoji-picker{
    position: absolute;
    bottom: 60px; right: 64px;
    width: 360px; max-width: 90vw;
    background: rgba(255,255,255,0.72);
    border: 1px solid rgba(255,255,255,0.65);
    border-radius: 18px;
    box-shadow: 0 20px 40px rgba(15,23,42,.18);
    backdrop-filter: blur(14px) saturate(150%);
    -webkit-backdrop-filter: blur(14px) saturate(150%);
    padding: 10px;
    display: none;
    z-index: 1000;
    height: 260px;
    flex-direction: column;
    gap: 10px;
  }
  .emoji-picker.open{ display: flex; }

  .emoji-pane{
    flex: 1;
    overflow: auto;
    scrollbar-width: none;
  }
  .emoji-pane::-webkit-scrollbar{ display: none; }

  .emoji-grid{
    display:grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 8px;
    padding-right: 2px;
  }
  .emoji{
    width: 36px;
    height: 36px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.65);
    background: rgba(255,255,255,0.7);
    display:grid;
    place-items:center;
    cursor:pointer;
    font-size: 20px;
    box-shadow: 0 1px 0 rgba(255,255,255,.6) inset, 0 10px 18px rgba(15,23,42,.07);
    transition: transform .12s ease;
  }
  .emoji:hover{ transform: translateY(-1px); }

  .emoji-tabs{
    display:flex;
    gap: 8px;
    overscroll-behavior-x: contain;
    min-width: 0;
    overflow-x:hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .emoji-tabs::-webkit-scrollbar{ display:none; }

  .emoji-tab{
    height: 36px;
    padding: 0 12px;
    border-radius: 9999px;
    border: 1px solid rgba(15,23,42,.10);
    background: rgba(255,255,255,.85);
    cursor: pointer;
    font-weight: 900;
    font-size: 12px;
    white-space: nowrap;
  }
  .emoji-tab[aria-selected="true"]{
    background: #0f172a;
    color: #fff;
    border-color: #0f172a;
  }

  /* ===== Search overlay ===== */
  #searchOverlay{
    position: absolute; top: 72px; right: 12px; z-index: 2147483100;
    display: none; align-items: center; gap: 6px;
    background: rgb(255, 255, 255);
    border:1px solid rgba(15,23,42,.10);
    border-radius: 9999px;
    padding: 6px 8px;
    box-shadow: 0 10px 24px rgba(15,23,42,.15);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
  }
  #searchOverlay.open{ display: flex; }
  #findInput{
    width: 190px; height: 34px;
    border:1px solid rgba(15,23,42,.10);
    border-radius: 9999px;
    padding: 0 12px;
    outline: none;
    background: rgba(255,255,255,.95);
  }
  .find-btn, .close-find{
    width: 34px; height: 34px;
    border-radius: 9999px;
    border:1px solid rgba(15,23,42,.10);
    background:#fff;
    display:grid; place-items:center;
    cursor:pointer;
  }
  .find-btn:hover, .close-find:hover{ background:#f6f7f9; }
  .find-count{ font-size: .8rem; color:#475569; padding: 0 4px; }

  mark.hl{ background: var(--hl-bg); padding: 0 .15em; border-radius: 3px; }
  .current-match mark.hl{ outline: 2px solid var(--hl-ring); }

  /* ===== Side panel (FIX: mismo alto que el chat) ===== */
  .panel-backdrop{
    position: absolute;
    inset: 64px 0 0 0; /* debajo del header del chat */
    background: rgba(15,23,42,.25);
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
    z-index: 88;
  }
  .panel-backdrop.open{
    opacity: 1;
    pointer-events: auto;
  }

  .side-panel{
    position: absolute;
    top: 64px; right: 0;
    height: calc(100% - 64px); /* ✅ mismo alto que body+composer */
    width: min(420px, 38%);
    max-width: min(420px, 38%);

    border-radius: 18px 0 0 18px;
    border: 1px solid var(--panel-stroke);
    box-shadow: var(--panel-shadow);

    background: var(--panel-glass);
    backdrop-filter: blur(12px) saturate(150%);
    -webkit-backdrop-filter: blur(12px) saturate(150%);

    transform: translateX(110%);
    opacity: 0;
    pointer-events: none;
    z-index: 90;
    transition: transform 220ms ease, opacity 220ms ease;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
  }
  .side-panel.open{
    transform: translateX(0);
    opacity: 1;
    pointer-events: auto;
  }

  .panel-header{
    padding: 12px 12px;
    display:flex;
    align-items:center;
    gap: 10px;
    border-bottom: 1px solid rgba(15,23,42,.08);
    background: rgb(255, 255, 255);
  }
  .panel-avatar{
    width: 44px; height: 44px;
    border-radius: 9999px;
    border: 1px solid rgba(15,23,42,.10);
    background: rgba(255, 255, 255, 0.7);
    display:grid;
    place-items:center;
    font-weight: 900;
    color:#0f172a;
    position: relative;
    overflow: hidden;
  }
  .panel-avatar img{ width:100%; height:100%; object-fit: cover; display:block; }
  .panel-avatar .panel-avatar-initial{ position:absolute; inset:0; display:grid; place-items:center; }

  .panel-title{ font-weight: 950; color:#0f172a; line-height: 1.05; }
  .panel-sub{ font-size: 12px; color:#475569; margin-top: 2px; }

  .panel-close{
    margin-left: auto;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    border: 1px solid rgba(15,23,42,.10);
    background: rgba(255,255,255,.85);
    box-shadow: 0 10px 18px rgba(15,23,42,.10), inset 0 1px 0 rgba(255,255,255,.8);
    display:grid; place-items:center;
    cursor:pointer;
  }
  .panel-close:hover{ background:#fff; }

  .panel-body{
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    padding: 12px;
    padding-bottom: calc(16px + env(safe-area-inset-bottom));
  }

  .panel-section-title{
    font-weight: 950;
    color:#0f172a;
    font-size: 13px;
    margin: 10px 2px 8px;
  }

  /* panel tools */
  .panel-tools{
    display:flex;
    gap:10px;
    padding: 10px;
    border: 1px solid rgba(15,23,42,.08);
    border-radius: 16px;
    background: rgba(255,255,255,.55);
    box-shadow: 0 12px 22px rgba(15,23,42,.10), inset 0 1px 0 rgba(255,255,255,.8);
    position: sticky;
    top: 8px;
    z-index: 2;
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
  }
  .tool-btn{
    flex: 1;
    height: 42px;
    border-radius: 9999px;
    border: 1px solid rgba(15,23,42,.10);
    background: rgba(255,255,255,.9);
    display:flex;
    align-items:center;
    justify-content:center;
    gap: 8px;
    font-weight: 950;
    cursor:pointer;
  }
  .tool-btn:hover{ background:#fff; }

  /* member cards (mejor estética) */
  .member-card{
    display:grid;
    grid-template-columns: 44px 1fr auto;
    gap: 12px;
    align-items:center;
    border: 1px solid rgba(15,23,42,.08);
    border-radius: 18px;
    padding: 10px 12px;
    margin-bottom: 10px;
    background: rgba(255,255,255,.92);
    box-shadow: 0 12px 22px rgba(15,23,42,.08), inset 0 1px 0 rgba(255,255,255,.7);
  }
  .member-avatar{
    width:44px; height:44px; border-radius:9999px; overflow:hidden;
    border:1px solid rgba(15,23,42,.10); background:#e2e8f0;
    display:grid; place-items:center;
    color:#0f172a; font-weight:900; font-size: 1rem;
    position: relative;
  }
  .member-avatar img{ width:100%; height:100%; object-fit:cover; display:block; }
  .member-avatar .initial{ display:none; }
  .member-avatar[data-fallback="1"] .initial{ display:grid; position:absolute; inset:0; place-items:center; }
  .member-avatar[data-fallback="1"] img{ display:none; }

  .member-info .name{ font-weight: 950; color:#0f172a; }
  .member-info .meta{ font-size: .85rem; color:#475569; margin-top: 2px; }

  .member-menu-btn{
    width: 38px;
    height: 38px;
    border-radius: 14px;
    border: 1px solid rgba(15,23,42,.10);
    background: rgba(255,255,255,.9);
    display:grid;
    place-items:center;
    cursor:pointer;
  }
  .member-menu-btn:hover{ background:#fff; }

  .member-menu{ position: relative; }
  .member-menu-content{
    position:absolute; top: 44px; right: 0;
    z-index: 10; display:none;
    background:#fff;
    border:1px solid rgba(15,23,42,.10);
    border-radius: 14px;
    overflow:hidden;
    box-shadow: 0 16px 30px rgba(15,23,42,.16);
    min-width: 180px;
  }
  .member-menu-content.open{ display:block; }
  .member-menu-item{ padding:10px 14px; cursor:pointer; font-weight: 800; }
  .member-menu-item:hover{ background:#f6f7f9; }
  .member-menu-item.danger{ color:#b42318; }

  /* =========================
    ✅ MOBILE PATCH (chat-group)
    - panel 2/3 del chat + mismo alto (NO full screen)
    ========================= */
  @media (max-width: 640px){
  :root{ --dock-offset: 166px; }

  .chat-frame{
    width: calc(100vw - 12px);
    max-width: calc(100vw - 12px);
    margin: 6px auto 0;
    border-radius: 18px;
    height: calc(100dvh - var(--dock-offset));
  }
  @supports (height: env(safe-area-inset-bottom)){
    .chat-frame{
      height: calc(100dvh - var(--dock-offset) - env(safe-area-inset-bottom));
    }
  }

  .chat-card{
    min-width: 0;
    border-radius: 18px;
  }

  .chat-header{
    height: auto;
    min-height: 58px;
    padding: 9px 10px 9px 12px;
    gap: 8px;
    grid-template-columns: minmax(0,1fr) auto;
  }

  .header-left{
    gap: 10px;
    min-width: 0;
    padding-right: 82px;
  }

  .avatar-wrap{ width:38px; height:38px; }
  .avatar-img{ width:38px; height:38px; }

  .chat-header .title{
    font-size: 13px;
    line-height: 1.15;
  }

  .chat-header .subtitle{
    display: none;
  }

  .header-kebab{
    width: 34px;
    height: 34px;
    position: relative;
    z-index: 130;
  }

  .chat-fs-btn{
    top: 12px;
    width: 34px;
    height: 34px;
    transform: none;
    z-index: 125;
  }

  #btnFullscreen{
    display: none !important;
  }

  .chat-back-btn,
  .chat-card.is-admin .chat-back-btn{
    right: 44px !important;
  }

  #btnBulkDelete{
    display: none !important;
  }

  .admin-bulk-tools{
    top: 58px;
    right: 8px;
    left: 8px;
    width: auto;
    justify-content: space-between;
    gap: 6px;
    padding: 8px;
    border-radius: 14px;
  }

  .admin-bulk-tools button{
    flex: 1;
    min-width: 0;
    height: 34px;
    padding: 0 8px;
    font-size: 12px;
  }

  #selectedCount{
    display: none;
  }

  .chat-body{
    padding: 10px 8px 12px;
    background-size: 280px 280px;
  }

  .row{
    width: 100%;
    max-width: 100%;
    gap: 6px;
    margin: 8px 0;
    padding-left: 0;
    padding-right: 0;
  }

  .row.other,
  .row.me{
    grid-template-columns: minmax(0,1fr);
  }

  .msg-avatar{
    display: none;
  }

  .msg-admin-check{
    top: 10px;
    transform: none;
    width: 16px;
    height: 16px;
  }

  .row.other .msg-admin-check,
  .row.me .msg-admin-check{
    left: auto;
    right: 4px;
  }

  .bubble{
    max-width: min(86vw, 100%);
    padding: 10px 12px;
    border-radius: 18px;
    font-size: .92rem;
    line-height: 1.35;
  }

  .row.other .bubble{
    margin-right: auto;
  }

  .row.me .bubble{
    margin-left: auto;
  }

  .bubble-head{
    gap: 6px;
    margin-bottom: 4px;
  }

  .who{
    font-size: .78rem;
  }

  .menu-btn{
    font-size: 16px;
  }

  .stamp{
    font-size: .64rem;
    margin-top: 1px;
  }

  .row.other .stamp{
    grid-column: 1;
    justify-self: start;
  }

  .row.me .stamp{
    grid-column: 1;
    justify-self: end;
  }

  .chat-composer{
    padding: 8px 8px calc(8px + env(safe-area-inset-bottom));
    gap: 8px;
    grid-template-columns: 40px minmax(0,1fr) 40px 40px;
    align-items: center;
  }

  .chat-input{
    min-width: 0;
    height: 40px;
    padding: 0 12px;
    font-size: 16px;
  }

  .emoji-btn,
  .attach-btn,
  .send-btn{
    width: 40px;
    height: 40px;
  }

  .send-btn{
    padding: 0;
    border-radius: 9999px;
    font-size: 0;
    display: grid;
    place-items: center;
  }

  .send-btn::before{
    content:"➤";
    font-size: 17px;
    line-height: 1;
  }

  .emoji-picker{
    left: 8px;
    right: 8px;
    width: auto;
    bottom: calc(60px + env(safe-area-inset-bottom));
    max-height: 42vh;
    overflow: auto;
  }

  .emoji-grid{
    grid-template-columns: repeat(8, 1fr);
  }

  #searchOverlay{
    left: 8px;
    right: 8px;
    top: 66px;
  }

  #findInput{
    width: 100%;
    min-width: 0;
  }

  .panel-backdrop{
    inset: 0;
    top: 0;
  }

  .side-panel{
    top: 0;
    height: 100%;
    width: min(88vw, 360px);
    max-width: none;
    border-radius: 18px 0 0 18px;
  }

  .panel-header{
    padding: 10px;
  }

  .panel-body{
    padding: 10px;
  }
}

  @media (max-width: 380px){
    .chat-header .title{ font-size: 13px; }
    .chat-header .subtitle{ font-size: 11px; }
    .row{ max-width: 96%; }
  }

  /* ===== Optimistic send states ===== */
.row.is-pending .bubble{ opacity: .78; }
.row.is-pending .stamp{ opacity: .75; font-weight: 800; }
.row.send-failed .bubble{ outline: 2px solid rgba(239,68,68,.65); }
.row.send-failed .stamp{ color:#b42318; font-weight: 950; }

/* ===== Mention highlight in text ===== */
.mention-tag{ color: #F8C160; font-weight: 950; }

/* ===== Scroll highlight when clicking mention banner ===== */
.row.mention-focus .bubble{
  outline: 2px solid rgba(248,193,96,.85);
  box-shadow: 0 22px 44px rgba(248,193,96,.18);
}
/* Wrapper con flechas para tabs de emoji */
.emoji-tabs-wrap{
  display: grid;
  grid-template-columns: 32px 1fr 32px;
  align-items: center;
  gap: 8px;
}

.emoji-nav-btn{
  width: 32px;
  height: 32px;
  border-radius: 9999px;
  border: 1px solid rgba(15,23,42,.10);
  background: rgba(255,255,255,.9);
  display: grid;
  place-items: center;
  cursor: pointer;
  font-weight: 900;
  font-size: 18px;
  line-height: 1;
  box-shadow: 0 6px 14px rgba(15,23,42,.08);
}

.emoji-nav-btn:hover{
  background: #fff;
}

.emoji-tabs{
  display:flex;
  gap: 8px;
  overflow-x:hidden;
  overscroll-behavior-x: contain;
  min-width: 0;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  scroll-behavior: smooth; /* ✅ scroll suave */
}

.emoji-tabs::-webkit-scrollbar{ display:none; }

.emoji-tab{
  flex: 0 0 auto; /* ✅ evita que se achiquen */
}
/* ===== WhatsApp share modal ===== */
/* ===== WhatsApp share modal (iOS style) ===== */
.wa-modal-overlay{
  position: fixed;
  inset: 0;
  z-index: 2147483646;
  background: rgba(15,23,42,.28);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 16px;
}
.wa-modal-overlay.open{ display:flex; }

.wa-modal{
  position: relative;
  width: min(430px, 96vw);
  border-radius: 24px;
  border: 1px solid rgba(255,255,255,.55);
  background: rgba(255,255,255,.72);
  backdrop-filter: blur(24px) saturate(160%);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  box-shadow:
    0 30px 60px rgba(15,23,42,.20),
    inset 0 1px 0 rgba(255,255,255,.75);
  overflow: hidden;
}

.wa-modal::before{
  content: "";
  position: absolute;
  top: 8px;
  left: 50%;
  transform: translateX(-50%);
  width: 38px;
  height: 4px;
  border-radius: 999px;
  background: rgba(15,23,42,.18);
}

.wa-modal-head{
  position: relative;
  display:flex;
  align-items:center;
  justify-content:center;
  padding: 16px 52px 10px;
  border-bottom: 1px solid rgba(15,23,42,.06);
  background: rgba(255,255,255,.35);
}

.wa-modal-title{
  font-weight: 900;
  color: #0f172a;
  font-size: 17px;
  letter-spacing: -.01em;
}

.wa-modal-x{
  position: absolute;
  right: 10px;
  top: 10px;
  width: 32px;
  height: 32px;
  border-radius: 9999px;
  border: 1px solid rgba(15,23,42,.08);
  background: rgba(255,255,255,.9);
  color: #0f172a;
  cursor: pointer;
  display: grid;
  place-items: center;
  font-size: 14px;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.9);
}
.wa-modal-x:hover{ background: #fff; }

.wa-modal-body{
  padding: 14px;
}

.wa-label{
  display:block;
  font-weight: 800;
  color:#475569;
  margin-bottom: 8px;
  font-size: 12px;
  letter-spacing: .02em;
  text-transform: uppercase;
}

.wa-input{
  width: 100%;
  height: 50px;
  border-radius: 14px;
  border: 1px solid rgba(15,23,42,.08);
  background: rgba(242,242,247,.88);
  padding: 0 14px;
  outline: none;
  font-size: 16px;
  color: #0f172a;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
}
.wa-input::placeholder{
  color: #94a3b8;
}
.wa-input:focus{
  border-color: rgba(52,199,89,.45);
  box-shadow:
    0 0 0 4px rgba(52,199,89,.14),
    inset 0 1px 0 rgba(255,255,255,.9);
  background: rgba(255,255,255,.95);
}

.wa-help{
  margin-top: 8px;
  font-size: 12px;
  line-height: 1.35;
  color: #64748b;
}

.wa-modal-actions{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  padding: 12px 14px 14px;
  border-top: 1px solid rgba(15,23,42,.06);
  background: rgba(255,255,255,.30);
}

.wa-btn{
  height: 44px;
  padding: 0 14px;
  border-radius: 14px;
  font-weight: 900;
  border: 1px solid rgba(15,23,42,.08);
  cursor: pointer;
  font-size: 15px;
  transition: transform .08s ease, opacity .12s ease, background .12s ease;
}
.wa-btn:active{
  transform: scale(.985);
}

.wa-btn-ghost{
  background: rgba(255,255,255,.85);
  color:#0f172a;
}
.wa-btn-ghost:hover{
  background: #fff;
}

.wa-btn-main{
  background: rgba(52,199,89,.95); /* iOS green */
  color: #fff;
  border-color: rgba(34,160,68,.65);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.25);
}
.wa-btn-main:hover{
  background: rgba(49,191,84,1);
}

@media (max-width: 640px){
  .wa-modal-overlay{
    align-items: flex-end;
    padding: 10px;
  }
  .wa-modal{
    width: 100%;
    border-radius: 22px 22px 16px 16px;
  }
}
/* ===== WhatsApp card in chat ===== */
.wa-card{
  margin-top: 2px;
  border-radius: 16px;
  border: 1px solid rgba(15,23,42,.10);
  background: rgba(255,255,255,.72);
  padding: 10px;
  box-shadow: 0 8px 18px rgba(15,23,42,.08);
}
.wa-card-title{
  font-size: .82rem;
  color:#475569;
  font-weight: 800;
  margin-bottom: 6px;
}
.wa-card-number{
  font-weight: 900;
  color:#0f172a;
  margin-bottom: 8px;
}
.wa-card-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  height: 38px;
  padding: 0 12px;
