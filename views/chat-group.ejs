/* =========================================================
   THEME BRIDGE (solo chat-group)
   - Light por defecto
   - Dark SOLO cuando layout activa su clase/atributo
========================================================= */

/* Light por defecto (explícito) */
#chatCard{
  --cg-bg: #ffffff;
  --cg-paper: #ffffff;
  --cg-header: #f7f7f7;
  --cg-header-border: #e5e7eb;
  --cg-composer: #f0f2f5;
  --cg-panel: rgba(255,255,255,.95);
  --cg-panel-2: rgba(255,255,255,.92);
  --cg-menu: #ffffff;
  --cg-input: #ffffff;
  --cg-input-border: #e5e7eb;
  --cg-text: #0f172a;
  --cg-muted: #64748b;
  --cg-icon: #111827;
  --cg-stroke: rgba(15,23,42,.10);
  --cg-row-hover: #f6f7f9;
  color-scheme: light;
}

/* ✅ Dark SOLO si layout marca dark con clase/atributo (soporta varios nombres) */
html.dark #chatCard,
body.dark #chatCard,
html.darkmode #chatCard,
body.darkmode #chatCard,
html.theme-dark #chatCard,
body.theme-dark #chatCard,
html[data-theme="dark"] #chatCard,
body[data-theme="dark"] #chatCard,
html[data-bs-theme="dark"] #chatCard,
body[data-bs-theme="dark"] #chatCard,
#chatCard.is-dark{
  --chat-bg: #0b1220;
  --chat-paper: #0f172a;

  --msg-me: #f8c160;
  --msg-oth: #1f2a44;

  --name-me: #fbbf24;
  --name-ot: #93c5fd;

  --ink: #e5e7eb;
  --muted: #94a3b8;

  --panel-glass: rgba(15,23,42,.92);
  --panel-stroke: rgba(148,163,184,.18);
  --panel-shadow: 0 18px 34px rgba(0,0,0,.45);

  --btn-bg: rgba(30,41,59,.75);
  --btn-stroke: rgba(148,163,184,.16);

  --cg-bg: #0f172a;
  --cg-paper: #0f172a;
  --cg-header: #111827;
  --cg-header-border: rgba(148,163,184,.14);
  --cg-composer: #0b1220;
  --cg-panel: rgba(15,23,42,.95);
  --cg-panel-2: rgba(15,23,42,.88);
  --cg-menu: #111827;
  --cg-input: #0b1220;
  --cg-input-border: rgba(148,163,184,.16);
  --cg-text: #e5e7eb;
  --cg-muted: #94a3b8;
  --cg-icon: #e5e7eb;
  --cg-stroke: rgba(148,163,184,.16);
  --cg-row-hover: rgba(148,163,184,.08);

  color-scheme: dark;
}

/* ===== superficies base ===== */
#chatCard{
  background: var(--cg-paper);
  color: var(--cg-text);
}
#chatCard .chat-header{
  background: var(--cg-header);
  border-bottom-color: var(--cg-header-border);
}
#chatCard .chat-composer{
  background: var(--cg-composer);
  border-top-color: var(--cg-header-border);
}
#chatCard .chat-input{
  background: var(--cg-input);
  border-color: var(--cg-input-border);
  color: var(--cg-text);
}
#chatCard .chat-input::placeholder{ color: var(--cg-muted); }

#chatCard .header-menu,
#chatCard .ctx-menu,
#chatCard .attach-menu,
#chatCard #searchOverlay,
#chatCard .side-panel,
#chatCard .emoji-picker{
  background: var(--cg-menu);
  border-color: var(--cg-stroke);
  color: var(--cg-text);
}

#chatCard .panel-header{
  background: var(--cg-header);
  border-bottom-color: var(--cg-stroke);
}
#chatCard .panel-title,
#chatCard .panel-section-title,
#chatCard .member-info .name,
#chatCard .chat-header .title{
  color: var(--cg-text);
}
#chatCard .panel-sub,
#chatCard .member-info .meta,
#chatCard .chat-header .subtitle,
#chatCard .stamp,
#chatCard .find-count{
  color: var(--cg-muted);
}

#chatCard .member-card,
#chatCard .panel-tools,
#chatCard .tool-btn,
#chatCard .member-menu-btn,
#chatCard .panel-close{
  background: var(--cg-panel-2);
  border-color: var(--cg-stroke);
  color: var(--cg-text);
}

#chatCard .header-menu .item:hover,
#chatCard .ctx-item:hover,
#chatCard .member-menu-item:hover,
#chatCard .tool-btn:hover,
#chatCard .member-menu-btn:hover,
#chatCard .panel-close:hover,
#chatCard .attach-item:hover,
#chatCard .find-btn:hover,
#chatCard .close-find:hover,
#chatCard .emoji-btn:hover,
#chatCard .attach-btn:hover,
#chatCard .header-kebab:hover,
#chatCard .chat-fs-btn:hover{
  background: var(--cg-row-hover);
}

/* ===== botones / iconos ===== */
#chatCard .chat-fs-btn,
#chatCard .attach-btn,
#chatCard .emoji-btn,
#chatCard .header-kebab,
#chatCard .find-btn,
#chatCard .close-find,
#chatCard .menu-btn,
#chatCard .js-member-menu{
  color: var(--cg-icon);
}

#chatCard .attach-btn,
#chatCard .emoji-btn,
#chatCard .find-btn,
#chatCard .close-find{
  border-color: var(--cg-stroke);
  background: var(--cg-input);
}

/* ✅ SVG outline ( + , fullscreen, back, etc ) */
#chatCard .chat-fs-btn svg *,
#chatCard .attach-btn svg *,
#chatCard .find-btn svg *,
#chatCard .close-find svg *{
  stroke: currentColor !important;
}
#chatCard .chat-fs-btn svg [fill="none"],
#chatCard .attach-btn svg [fill="none"],
#chatCard .find-btn svg [fill="none"],
#chatCard .close-find svg [fill="none"]{
  fill: none !important;
}

/* ✅ SVG del menú (share/copy/leave) que viene con fill negro */
#chatCard .header-menu .item{
  color: var(--cg-text);
}
#chatCard .header-menu .item svg *{
  stroke: currentColor !important;
  fill: currentColor !important;
}
#chatCard .header-menu .item svg [fill="none"]{
  fill: none !important;
}

/* ✅ botones admin arriba (dark visible) */
#chatCard .admin-bulk-tools{
  background: var(--btn-bg);
  border-color: var(--btn-stroke);
}
#chatCard .admin-bulk-tools button{
  background: var(--cg-input);
  border-color: var(--cg-stroke);
  color: var(--cg-text);
}
#chatCard #selectedCount{ color: var(--cg-muted); }

/* buscador */
#chatCard #findInput{
  background: var(--cg-input);
  border-color: var(--cg-stroke);
  color: var(--cg-text);
}
#chatCard #findInput::placeholder{ color: var(--cg-muted); }

/* emoji tabs */
#chatCard .emoji-tab{
  background: var(--cg-input);
  border-color: var(--cg-stroke);
  color: var(--cg-text);
}
#chatCard .emoji-tab[aria-selected="true"]{
  background: var(--cg-text);
  color: var(--cg-bg);
  border-color: var(--cg-text);
}
#chatCard .emoji{
  background: var(--cg-panel-2);
  border-color: var(--cg-stroke);
}

/* modal WhatsApp (si usás dark) */
#chatCard .wa-modal{
  background: var(--cg-menu);
  border-color: var(--cg-stroke);
}
#chatCard .wa-modal-head,
#chatCard .wa-modal-actions{
  background: transparent;
  border-color: var(--cg-stroke);
}
#chatCard .wa-modal-title,
#chatCard .wa-label{
  color: var(--cg-text);
}
#chatCard .wa-help{ color: var(--cg-muted); }
#chatCard .wa-input{
  background: var(--cg-input);
  border-color: var(--cg-stroke);
  color: var(--cg-text);
}
#chatCard .wa-input::placeholder{ color: var(--cg-muted); }
#chatCard .wa-btn-ghost{
  background: var(--cg-input);
  border-color: var(--cg-stroke);
  color: var(--cg-text);
}

/* reset banner también legible */
html.dark .reset-banner-pill,
body.dark .reset-banner-pill,
html.darkmode .reset-banner-pill,
body.darkmode .reset-banner-pill,
html.theme-dark .reset-banner-pill,
body.theme-dark .reset-banner-pill,
html[data-theme="dark"] .reset-banner-pill,
body[data-theme="dark"] .reset-banner-pill,
html[data-bs-theme="dark"] .reset-banner-pill,
body[data-bs-theme="dark"] .reset-banner-pill{
  background: rgba(15,23,42,.72);
  border-color: rgba(148,163,184,.20);
}
html.dark .reset-banner-pill p,
body.dark .reset-banner-pill p,
html.darkmode .reset-banner-pill p,
body.darkmode .reset-banner-pill p,
html.theme-dark .reset-banner-pill p,
body.theme-dark .reset-banner-pill p,
html[data-theme="dark"] .reset-banner-pill p,
body[data-theme="dark"] .reset-banner-pill p,
html[data-bs-theme="dark"] .reset-banner-pill p,
body[data-bs-theme="dark"] .reset-banner-pill p{
  color: #cbd5e1;
}
<style>
/* ===== FIX REAL MOBILE CHAT: evita choque con layout ===== */
body.cw-chat-page .chat-frame,
body.cw-chat-page .chat-card,
body.cw-chat-page .chat-body{
  min-width: 0 !important;
  min-height: 0 !important;
}

@media (max-width: 900px){
  /* el panel lateral del chat NO puede heredar el side-panel genérico del layout */
  body.cw-chat-page .side-panel{
    position: absolute !important;
    top: 60px !important;
    right: 0 !important;
    left: auto !important;
    bottom: auto !important;
    width: min(76vw, 360px) !important;
    max-width: min(76vw, 360px) !important;
    height: calc(100% - 60px) !important;
    margin: 0 !important;
    border-radius: 18px 0 0 18px !important;
    transform: translateX(110%) !important;
    opacity: 0 !important;
    pointer-events: none !important;
    z-index: 90 !important;
    display: grid !important;
    grid-template-rows: auto 1fr !important;
    overflow: hidden !important;
  }

  body.cw-chat-page .side-panel.open{
    transform: translateX(0) !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  body.cw-chat-page .panel-backdrop{
    position: absolute !important;
    inset: 60px 0 0 0 !important;
    z-index: 88 !important;
  }

  /* la mascota y ayuda chocan con el composer del chat en celular */
  body.cw-chat-page .user-badge-fixed,
  body.cw-chat-page .help-badge-fixed{
    display: none !important;
  }
}

@media (max-width: 640px){
  body.cw-chat-page .container-main{
    max-width: 100% !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  body.cw-chat-page .chat-frame{
    width: calc(100vw - 16px) !important;
    max-width: calc(100vw - 16px) !important;
    margin: 8px auto !important;
    border-radius: 22px !important;
    height: calc(100dvh - 184px - env(safe-area-inset-bottom)) !important;
    overflow: hidden !important;
  }

  body.cw-chat-page .chat-card{
    border-radius: 22px !important;
    display: grid !important;
    grid-template-rows: 60px minmax(0,1fr) auto !important;
    overflow: hidden !important;
  }

  body.cw-chat-page .chat-header{
    height: 60px !important;
    min-height: 60px !important;
  }

  body.cw-chat-page .chat-body{
    min-height: 0 !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    padding: 12px 10px 14px !important;
    background-size: 320px 320px !important;
  }

  body.cw-chat-page .row{
    max-width: 94% !important;
    padding-left: 28px !important;
    padding-right: 28px !important;
  }

  body.cw-chat-page .chat-composer{
    grid-template-columns: minmax(0, 1fr) 42px 42px 42px !important;
    align-items: center !important;
    gap: 8px !important;
    padding: 8px 10px calc(8px + env(safe-area-inset-bottom)) !important;
    background: #eef2f7 !important;
    border-top: 1px solid rgba(15,23,42,.08) !important;
  }

  body.cw-chat-page .chat-input{
    width: 100% !important;
    min-width: 0 !important;
    height: 42px !important;
    padding: 0 14px !important;
    border-radius: 9999px !important;
    border: 1px solid rgba(15,23,42,.08) !important;
    background: #ffffff !important;
    color: #0f172a !important;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.72),
      0 6px 14px rgba(15,23,42,.06) !important;
    outline: none !important;
    opacity: 1 !important;
  }

  body.cw-chat-page .chat-input::placeholder{
    color: #94a3b8 !important;
  }

  body.cw-chat-page .emoji-btn,
  body.cw-chat-page .attach-btn,
  body.cw-chat-page .send-btn{
    width: 42px !important;
    height: 42px !important;
    min-width: 42px !important;
    padding: 0 !important;
    border-radius: 9999px !important;
  }

  body.cw-chat-page .emoji-btn,
  body.cw-chat-page .attach-btn{
    border: 1px solid rgba(15,23,42,.08) !important;
    background: #ffffff !important;
    box-shadow: 0 6px 14px rgba(15,23,42,.06) !important;
  }

  body.cw-chat-page .send-btn{
    display: grid !important;
    place-items: center !important;
    background: #f8c160 !important;
    border: 1px solid rgba(248,193,96,.45) !important;
    box-shadow:
      0 10px 18px rgba(15,23,42,.12),
      inset 0 1px 0 rgba(255,255,255,.65) !important;
    color: #0f172a !important;
  }

  /* mata el parche viejo del ::before */
  body.cw-chat-page .send-btn::before{
    content: none !important;
    display: none !important;
  }

  body.cw-chat-page .send-btn svg{
    width: 18px !important;
    height: 18px !important;
    display: block !important;
  }

  body.cw-chat-page .emoji-picker{
    left: 10px !important;
    right: 10px !important;
    width: auto !important;
    bottom: 70px !important;
  }

  body.cw-chat-page #searchOverlay{
    left: 10px !important;
    right: 10px !important;
    top: 66px !important;
  }

  body.cw-chat-page #findInput{
    width: 100% !important;
    min-width: 0 !important;
  }
}
</style>
