<div class="chat-frame">
  <!-- WhatsApp Share Modal -->
  <div id="waModal" class="wa-modal-overlay" aria-hidden="true">
    <div class="wa-modal" role="dialog" aria-modal="true" aria-labelledby="waModalTitle">
      <div class="wa-modal-head">
        <div id="waModalTitle" class="wa-modal-title">Compartir WhatsApp</div>
        <button id="waModalClose" type="button" class="wa-modal-x" aria-label="Cerrar">✕</button>
      </div>

      <div class="wa-modal-body">
        <label for="waNumberInput" class="wa-label">Número o link de grupo de WhatsApp</label>
          <input
            id="waNumberInput"
            class="wa-input"
            type="text"
            inputmode="text"
            placeholder="+54 9 11 1234-5678 o https://chat.whatsapp.com/..."
            maxlength="300"
          />
          <div class="wa-help">
            Podés pegar un número o un link de invitación a grupo. Se guarda para próximas veces en este navegador.
          </div>
      </div>

      <div class="wa-modal-actions">
        <button id="waModalCancel" type="button" class="wa-btn wa-btn-ghost">Cancelar</button>
        <button id="waModalSend" type="button" class="wa-btn wa-btn-main">Enviar</button>
      </div>
    </div>
  </div>

  <div class="chat-card <%= (user && user.role === 'admin') ? 'is-admin' : '' %>" id="chatCard">
    <script>
      window.__IS_ADMIN__ = <%= (user && user.role === 'admin') ? 'true' : 'false' %>;
    </script>

    <!-- Header -->
    <div class="chat-header">
      <div id="btnTogglePanel" class="header-left" title="Ver información del grupo" aria-controls="panel" aria-expanded="false">
        <div class="avatar-wrap">
          <img id="chatGroupAvatar" class="avatar-img" alt="Avatar"
               src="/app/grupos/<%= subject.id %>/avatar/view?ts=<%= Date.now() %>"
               onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';">
          <span class="avatar-initial" style="display:none;"><%= groupInitial %></span>
        </div>
        <div class="min-w-0">
          <div class="title truncate"><%= groupName %></div>
          <div class="subtitle">Grupo · <%= subject.year %>º · Plan <%= subject.plan %></div>
        </div>
      </div>

      <div></div>

      <% if (user && user.role === 'admin') { %>
        <div class="admin-bulk-tools" style="display:flex; align-items:center;">
          <button id="btnSelectAllMsgs" type="button">Seleccionar todo</button>
          <button id="btnClearSelection" type="button">Quitar selección</button>
          <button id="btnDeleteSelected" type="button" disabled>Borrar</button>
          <span id="selectedCount" style="opacity:.7; font-size:13px;">0</span>
        </div>
      <% } %>

      <% if (user && user.role === 'admin') { %>
        <button id="btnBulkDelete" class="chat-fs-btn" type="button" aria-label="Eliminar mensajes seleccionados" title="Eliminar mensajes seleccionados" style="right: 140px;">
          <!-- icon trash simple -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 3h6l1 2h4v2H4V5h4l1-2Z" stroke="#111827" stroke-width="2" stroke-linejoin="round"/>
            <path d="M6 7l1 14h10l1-14" stroke="#111827" stroke-width="2" stroke-linejoin="round"/>
            <path d="M10 11v6M14 11v6" stroke="#111827" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      <% } %>

      <!-- Volver -->
      <button id="btnBack" class="chat-fs-btn chat-back-btn" type="button" aria-label="Volver" title="Volver">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 18l-6-6 6-6" stroke="#111827" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <button id="btnFullscreen" class="chat-fs-btn" type="button" aria-pressed="false" aria-label="Pantalla completa" style="right: 10px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <button id="headerKebab" class="header-kebab" aria-haspopup="menu" aria-expanded="false" aria-label="Opciones">⋯</button>

      <div id="headerMenu" class="header-menu" role="menu" aria-hidden="true">
        <div class="item" id="menuShare" role="menuitem">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M15.4306 7.70172C7.55045 7.99826 3.43929 15.232 2.17021 19.3956C2.07701 19.7014 2.31139 20 2.63107 20C2.82491 20 3.0008 19.8828 3.08334 19.7074C6.04179 13.4211 12.7066 12.3152 15.514 12.5639C15.7583 12.5856 15.9333 12.7956 15.9333 13.0409V15.1247C15.9333 15.5667 16.4648 15.7913 16.7818 15.4833L20.6976 11.6784C20.8723 11.5087 20.8993 11.2378 20.7615 11.037L16.8456 5.32965C16.5677 4.92457 15.9333 5.12126 15.9333 5.61253V7.19231C15.9333 7.46845 15.7065 7.69133 15.4306 7.70172Z" fill="#000000" stroke="#000000" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
          Compartir
        </div>

        <div class="item" id="menuCopy" role="menuitem">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M6 11C6 8.17157 6 6.75736 6.87868 5.87868C7.75736 5 9.17157 5 12 5H15C17.8284 5 19.2426 5 20.1213 5.87868C21 6.75736 21 8.17157 21 11V16C21 18.8284 21 20.2426 20.1213 21.1213C19.2426 22 17.8284 22 15 22H12C9.17157 22 7.75736 22 6.87868 21.1213C6 20.2426 6 18.8284 6 16V11Z" stroke="#1C274C" stroke-width="1.5"></path> <path opacity="0.5" d="M6 19C4.34315 19 3 17.6569 3 16V10C3 6.22876 3 4.34315 4.17157 3.17157C5.34315 2 7.22876 2 11 2H15C16.6569 2 18 3.34315 18 5" stroke="#1C274C" stroke-width="1.5"></path> </g></svg>
           Copiar enlace
        </div>

        <div class="item danger" id="menuLeave" role="menuitem">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10 7V5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2v-2" stroke="#111827" stroke-width="2"/><path d="M3 12h11" stroke="#111827" stroke-width="2" stroke-linecap="round"/><path d="M7 8l-4 4 4 4" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Salir
        </div>
      </div>
    </div>

    <!-- Backdrop panel (click outside closes) -->
    <div id="panelBackdrop" class="panel-backdrop" aria-hidden="true"></div>

    <!-- Side Panel -->
    <aside id="sidePanel" class="side-panel" aria-hidden="true">
      <div class="panel-header">
        <div class="panel-avatar" aria-hidden="true">
          <img src="/app/grupos/<%= subject.id %>/avatar/view?ts=<%= Date.now() %>"
               alt=""
               onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';">
          <span class="panel-avatar-initial" style="display:none;"><%= groupInitial %></span>
        </div>
        <div class="min-w-0">
          <div class="panel-title truncate"><%= groupName %></div>
          <div class="panel-sub truncate"><%= (__members && __members.length) ? (__members.length + " miembros") : "Miembros" %></div>
        </div>
        <button id="btnClosePanel" class="panel-close" type="button" aria-label="Cerrar panel" title="Cerrar">✕</button>
      </div>

      <div class="panel-body">
      <div class="panel-tools">
        <button class="tool-btn" id="btnPanelSearch" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-svg"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          Buscar
        </button>
        
        <button class="tool-btn" id="btnPanelInvite" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-svg"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          Invitar
        </button>
        
        <button class="tool-btn" id="btnPanelLeave" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-svg"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          Salir
        </button>
      </div>


        <div class="panel-section-title">Miembros</div>

        <% (__members || []).forEach(function(mem){ 
            const mName = mem.name || mem.user_name || mem.username || 'Usuario';
            const mId   = mem.user_id || mem.id || mem.uid || '';
            const mInit = (mName && mName[0] ? mName[0] : 'U').toUpperCase();
            const isMe  = (String(mId) === String(meId));
        %>
          <div class="member-card" data-userid="<%= mId %>">
            <div class="member-avatar" data-userid="<%= mId %>">
              <img src="/public/avatars/<%= mId %>.png" alt="Avatar" onerror="this.parentElement.setAttribute('data-fallback','1')">
              <span class="initial"><%= mInit %></span>
            </div>
            <div class="member-info">
              <div class="name truncate"><%= mName %> <%= isMe ? "(vos)" : "" %></div>
              <div class="meta truncate"><%= (mem.role || mem.member_role || '') %></div>
            </div>

            <div class="member-menu">
              <button class=" js-member-menu" type="button" aria-label="Opciones de miembro">⋯</button>
              <div class="member-menu-content">
                <div  class="member-menu-item js-member-dm"  data-userid="<%= mId %>"  data-username="<%= mName %>">Mandar mensaje</div>

                <% if (user && user.role === 'admin' && !isMe) { %>
                  <div class="member-menu-item danger js-member-kick" data-userid="<%= mId %>">Eliminar del grupo</div>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>

      </div>
    </aside>

    <!-- Body -->
    <div id="chatBody" class="chat-body">
      <% (messages || []).forEach(function(m){
          const mine   = (m.user_id === meId);
          const whoCls = mine ? 'me' : 'other';
          const who    = mine ? user.name : (m.user_name || 'Usuario');
          const init   = (who && who[0] ? who[0] : 'U').toUpperCase();
          const text   = m.text || '';
      %>
        <div class="row <%= whoCls %>" data-msgid="<%= m.id %>">
          <% if (user && user.role === 'admin') { %>
            <input
              type="checkbox"
              class="msg-admin-check"
              data-msg-id="<%= m.id %>"
              aria-label="Seleccionar mensaje"
            />
          <% } %>

          <% if (!mine) { %>
            <div class="msg-avatar" data-userid="<%= m.user_id %>">
              <img src="/public/avatars/<%= m.user_id %>.png" alt="Avatar" onerror="this.parentElement.setAttribute('data-fallback','1')">
              <span class="initial"><%= init %></span>
            </div>
          <% } %>

          <div class="bubble">
            <div class="bubble-head">
              <% if (mine) { %>
                <button class="menu-btn js-menu" type="button" aria-label="Más opciones">⋯</button>
              <% } %>
              <span class="who"><%= who %></span>
            </div>
            <div class="text"><%= text %></div>

            <% if (mine) { %>
              <div class="ctx-menu" role="menu">
                <div class="ctx-item js-copy" role="menuitem">Copiar</div>
                <div class="ctx-item danger js-delete" role="menuitem">Eliminar</div>
              </div>
            <% } %>
          </div>

          <% if (mine) { %>
            <div class="msg-avatar" data-userid="<%= m.user_id %>">
              <img src="/public/avatars/<%= m.user_id %>.png" alt="Avatar" onerror="this.parentElement.setAttribute('data-fallback','1')">
              <span class="initial"><%= init %></span>
            </div>
          <% } %>

          <div class="stamp"><%= fmt(m.created_at) %></div>
        </div>
      <% }) %>
    </div>

    <!-- Buscador mini -->
    <div id="searchOverlay" aria-hidden="true">
      <input id="findInput" type="text" placeholder="Buscar..." />
      <button id="findPrev" class="find-btn" type="button" title="Anterior" aria-label="Anterior">‹</button>
      <button id="findNext" class="find-btn" type="button" title="Siguiente" aria-label="Siguiente">›</button>
      <span id="findCount" class="find-count">0/0</span>
      <button id="findClose" class="close-find" type="button" title="Cerrar" aria-label="Cerrar">✕</button>
    </div>

    <!-- Composer -->
    <form id="composer" class="chat-composer" autocomplete="off">
      <input type="text" id="msgText" name="text" class="chat-input" maxlength="2000" placeholder="Escribir mensaje..." />
      <button class="emoji-btn" id="emojiBtn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Emojis">😊</button>
      <button class="attach-btn" id="attachBtn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Adjuntar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 5v14M5 12h14" stroke="#111827" stroke-width="2.4" stroke-linecap="round"/>
        </svg>
      </button>

      <button class="send-btn" id="sendBtn" type="submit" aria-label="Enviar">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 1 9 22 2"></polygon>
        </svg>
      </button>

      <div id="emojiPicker" class="emoji-picker" aria-hidden="true">
        <div class="emoji-pane">
          <div class="emoji-grid" id="emojiGrid"></div>
        </div>
            <div class="emoji-tabs-wrap">
              <button id="emojiTabsPrev" class="emoji-nav-btn" type="button" aria-label="Categoría anterior" title="Anterior">‹</button>

              <div class="emoji-tabs" id="emojiTabs" role="tablist" aria-label="Categorías de emojis">
                <button class="emoji-tab" data-cat="faces"    role="tab" aria-selected="true"  type="button">Caras</button>
