<script>
/* ===== Animación de entrada escalonada para las mat-card ===== */
(function(){
  function applyStagger(){
    const cards = document.querySelectorAll('#list .mat-card');
    cards.forEach((card, i) => {
      card.style.animationDelay = (i * 45) + 'ms';
    });
  }

  // Re-aplica cuando el JS filtra/renderiza nuevas cards
  const list = document.getElementById('list');
  if (list){
    const obs = new MutationObserver(() => applyStagger());
    obs.observe(list, { childList: true, subtree: true });
  }

  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', applyStagger, { once: true });
  } else {
    applyStagger();
  }
})();
</script>


