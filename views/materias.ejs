<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Materias · CleverWave</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* ===== Tokens ===== */
    :root{
      --glass-1: rgba(255,255,255,.78);
      --glass-2: rgba(255,255,255,.60);
      --stroke:  rgba(255,255,255,.75);
      --ink: #0f172a;
      --muted:#64748b;
      --shadow: 0 12px 28px rgba(15,23,42,.10);
      --tile-shadow: 0 12px 22px rgba(15,23,42,.14), inset 0 1px 0 rgba(255,255,255,.85), inset 0 -10px 24px rgba(15,23,42,.06);
      --thumb-shadow: 0 14px 26px rgba(15,23,42,.16), inset 0 1px 0 rgba(255,255,255,.95), inset 0 -10px 22px rgba(15,23,42,.06);
      --radius-xxl: 22px;
    }

    body{ color:var(--ink); }

    /* ===== Fondo suave iOS ===== */
    .bg-ios{
      background:
        radial-gradient(1200px 900px at 18% 8%, rgba(255,255,255,.95) 0%, rgba(255,255,255,.55) 50%, transparent 70%),
        radial-gradient(900px 700px at 88% 20%, rgba(255,255,255,.85) 0%, rgba(255,255,255,.35) 55%, transparent 75%),
        linear-gradient(180deg,#F7FAFE 0%,#EEF5FD 55%,#E9F1FB 100%),
        repeating-linear-gradient(45deg, rgba(183,201,227,.08) 0 1px, transparent 1px 22px),
        repeating-linear-gradient(-45deg, rgba(183,201,227,.06) 0 1px, transparent 1px 22px);
      background-blend-mode: screen,screen,normal,normal,normal;
      background-attachment: fixed;
    }

    /* ===== Glass base ===== */
    .glass{
      background: var(--glass-1);
      box-shadow: var(--shadow), inset 0 1px 0 rgba(255,255,255,.7);
      backdrop-filter: blur(14px) saturate(140%);
      -webkit-backdrop-filter: blur(14px) saturate(140%);
      border: 1px solid var(--stroke);
    }

    /* ===== Barra de búsqueda iOS ===== */
    .search-wrap{ position: relative; }
    .search-ios{
      height: 40px; width: 16rem; max-width: 100%;
      padding-left: 40px; padding-right: 12px;
      border-radius: 9999px;
      background: var(--glass-2);
      border: 1px solid var(--stroke);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.85), 0 6px 16px rgba(15,23,42,.06);
      backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%);
      color: #334155;
    }
    .search-ios::placeholder{ color: #8a99ad; }
    .search-icon{ position:absolute; left: 12px; top: 50%; transform: translateY(-50%); color:#9aa4b2; }
    .search-ios:focus{ outline: none; box-shadow: 0 0 0 3px rgba(14,165,233,.18), inset 0 1px 0 rgba(255,255,255,.9); }

    /* ===== Segmented control (más compacto, “mitad de largo”) ===== */
    #segYears{ --pill-pad: 3px; position: relative; }
      #segYears.glass{
        border-radius: 9999px; padding: 2px;
        border-color: var(--accent-25);
        background: var(--accent-12);
      }
      #segThumb{
        position:absolute; top:50%; transform:translateY(-50%);
        left: 0; width: 0; height: 26px; border-radius: 9999px;
        background: linear-gradient(145deg, var(--accent), var(--accent-dark));
        border: 1px solid var(--accent-25);
        box-shadow: 0 10px 22px rgba(254, 132, 25, 0), inset 0 1px 0 rgba(255, 255, 255, 0);
        transition: left .25s cubic-bezier(.2,.8,.2,1), width .25s cubic-bezier(.2,.8,.2,1), height .25s;
        backdrop-filter: blur(10px) saturate(140%); -webkit-backdrop-filter: blur(10px) saturate(140%);
      }
      .seg-btn[data-active="true"]{ color:#fff; }
      .seg-btn:not([data-active="true"]):hover{ color:#0f172a; }
      :root{
        --accent: #F8C160;
        --accent-dark: #F8C160;
        --accent-25: rgba(254, 132, 25, 0);
        --accent-12: rgba(254, 132, 25, 0);
      }
    .seg-group{ gap: .15rem; padding: 0 .15rem; }
    .seg-btn{
      height: 28px; padding: 0 4px; min-width: 76px;
      border-radius: 9999px;
      font-weight: 600; font-size: .78rem;
      color:#475569; transition: color .15s ease, transform .15s ease;
      white-space: nowrap; letter-spacing: -.01em;
    }
    .seg-btn[data-active="true"]{ color:#ffffff; }
    .seg-btn:active{ transform: translateY(1px); }

    /* ===== Materias ===== */
    .card{
      border-radius: var(--radius-xxl);
      background: linear-gradient(145deg, rgba(255,255,255,.35), rgba(255,255,255,.18));
      border: 1px solid var(--stroke);
      box-shadow: var(--tile-shadow);
      backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%);
      transition: transform .15s ease, box-shadow .15s ease;
    }
    .tile:hover{ transform: translateY(-2px); box-shadow: 0 18px 30px rgba(15,23,42,.12); }

    /* ===== Scroll horizontal suave para el segmented en móvil ===== */
    .no-scrollbar{ -ms-overflow-style: none; scrollbar-width: none; }
    .no-scrollbar::-webkit-scrollbar{ display: none; }

    /* ===== Responsive ===== */
    @media (max-width: 1024px){
      .search-ios{ width: 14rem; }
    }
        @media (max-width: 1280px) and (min-width: 641px){
      .toolbar{
        gap: .75rem;
        align-items: stretch;
      }

      .toolbar-right{
        width: 100%;
        display: grid;
        grid-template-columns: minmax(0,1fr) minmax(240px, 320px);
        grid-template-areas:
          "years years"
          "sem search";
        align-items: center;
        justify-content: stretch;
        gap: 10px;
      }

      .toolbar-right > .seg-wrap:nth-child(1){
        grid-area: years;
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding: 6px 8px;
      }

      .toolbar-right > .seg-wrap:nth-child(2){
        grid-area: sem;
        width: 100%;
        min-width: 0;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding: 6px 8px;
      }

      .toolbar-right > .search-wrap{
        grid-area: search;
        width: 100%;
        min-width: 0;
        margin-left: 0 !important;
      }

      #segYears{
        width: max-content;
        min-width: 100%;
      }

      #segSem{
        width: max-content;
        min-width: 100%;
      }

      .search-ios{
        width: 100% !important;
      }
    }
    @media (max-width: 640px){
      /* ===== Toolbar: apila y estira a ancho completo ===== */
      .toolbar{
        gap: .75rem;
        align-items: stretch;
      }

      /* Izquierda (admin filtros) */
      .toolbar-left{
        width: 100%;
        flex-wrap: wrap;
        gap: .5rem;
      }

      /* Controles admin (verificación / botones) */
      .toolbar-admin{
        width: 100%;
        flex-wrap: wrap;
        gap: .5rem;
        margin-left: 0 !important;
      }

      /* Derecha: segmented + buscador uno debajo del otro */
      .toolbar-right{
        width: 100%;
        flex-direction: column;
        align-items: stretch;
        justify-content: flex-start;
        gap: 10px;
      }

      /* Segmented: scroll horizontal cómodo y botones táctiles */
      .seg-wrap{
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding: 6px 8px;
      }
      #segYears{
        width: max-content;
        min-width: 100%;
      }
      .seg-group{
        gap: .35rem;
        padding: 0 .25rem;
      }
      .seg-btn{
        height: 40px;
        min-width: 64px;
        padding: 0 12px;
        font-size: .88rem;
      }
      #segThumb{
        height: 34px;
      }

      /* Buscador: full width + target táctil grande (override del h-[28px]) */
      .search-wrap{
        width: 100%;
        margin-left: 0 !important;
      }
      .search-ios{
        width: 100% !important;
        height: 44px !important;
        padding-left: 44px !important;
        padding-right: 14px !important;
        border-radius: 18px !important;
      }
      .search-icon{
        left: 14px;
      }

      /* ===== Materias: que NO se corte texto y cards más “tap-friendly” ===== */
      #list{
        gap: 12px;
      }
      #list .tile{
        padding: 16px;
      }

      /* Quita el “truncate” SOLO dentro de las materias en móvil */
      #list .tile .truncate{
        white-space: normal !important;
        overflow: visible !important;
        text-overflow: clip !important;
      }

      /* Un poquito más legible en móvil */
      #list .tile .text-xs{
        font-size: .82rem;
      }
      #list .tile .min-w-0{
        line-height: 1.2;
      }
    }

    /* ===== Tutorial Overlay siempre por encima ===== */
    .tutorial-overlay,
    #tutorialOverlay,
    [data-tutorial-overlay="true"],
    .tour-overlay,
    .tour-backdrop {
      z-index: 6000 !important;
      position: fixed !important;
    }

    /* Si hay spotlight/rectángulo de foco, que quede por encima también */
    .tour-spotlight,
    .tutorial-spotlight,
    [data-tutorial-spotlight="true"] {
      z-index: 6001 !important;
      position: relative !important;
    }


    /* ===== Admin: Panel lateral de códigos ===== */
    .codes-drawer{
      position: fixed; inset: 0; z-index: 1600; pointer-events: none;
    }
    .codes-dim{
      position:absolute; inset:0; background: rgba(0,0,0,.35); opacity:0; transition: opacity .2s ease; backdrop-filter: blur(2px);
    }
    .codes-panel{
      position:absolute; top:0; bottom:0; left:0; width:min(680px, 92vw);
      transform: translateX(-100%);
      transition: transform .25s cubic-bezier(.2,.8,.2,1);
      padding: 18px; display:flex; flex-direction:column; gap:12px;
    }
    .codes-drawer.is-open{ pointer-events: auto; }
    .codes-drawer.is-open .codes-dim{ opacity:1; }
    .codes-drawer.is-open .codes-panel{ transform: translateX(0); }
    .codes-box{
      white-space: pre-wrap; word-break: break-word;
      border-radius: 12px; padding: 12px; background: #fff; border: 1px solid #e2e8f0; min-height: 120px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 13px; color:#334155;
    }
  /* =========================
    MATERIAS · Layout aireado (sin cuadrado), flecha mini, papeles centrados atrás
    ========================= */
  /* =========================
    MATERIAS · Layout FINAL pedido:
    - SVG a la izquierda dentro del botón
    - Título con "..." si es largo
    - Subtítulo = carrera (también con "...")
    - Flecha pegada al borde derecho y abajo
    - Papeles más grandes, suben más, y se ven por delante del botón de arriba
    ========================= */

  .mat-grid{ display:grid; gap: 12px; }

  /* ✅ importante: cada card crea su “mundo”, y en hover se trae adelante
    para que los papeles queden por encima del botón de arriba */
  /* ===== Animación de entrada ===== */
  @keyframes matCardIn {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mat-card{
    position: relative !important;
    isolation: isolate;               /* stacking local */
    z-index: 0;                       /* base */
    display: flex;
    align-items: center;
    gap: 10px;

    padding: 16px 56px 16px 16px;     /* menos reserva derecha → más ancho para título */
    min-height: 104px;

    background: transparent;
    border: 0;
    box-shadow: none;

    border-radius: 18px;
    text-decoration: none;
    color: inherit;

    overflow: visible;                /* papeles pueden salir */
    transform: translateZ(0);
    transition: transform .18s ease, z-index 0s linear .18s;

    /* Animación de entrada */
    animation: matCardIn .45s cubic-bezier(.22,.8,.36,1) both;
  }

  .mat-card:hover{
    transform: translateY(-2px);
    z-index: 50;                      /* ✅ clave: papeles encima de otros botones */
    transition: transform .18s ease, z-index 0s;
  }

  /* ✅ “Botón blanco” real por encima de los papeles */
.mat-card::after{
  content:"";
  position:absolute;
  inset:0;
  border-radius: 18px;

  background: #ffffff;             /* ✅ opaco: NO se ven papeles a través */
  border: 1px solid rgba(15,23,42,.08);
  box-shadow: 0 14px 30px rgba(15,23,42,.10);

  z-index: 2;                      /* ✅ capa “botón” (encima de papeles) */
  pointer-events: none;
}




  .mat-card:hover::after{
    box-shadow: 0 22px 46px rgba(15,23,42,.14);
    border-color: rgba(15,23,42,.12);
  }

  /* ✅ Papeles: detrás del botón (tapados por ::after), centrados */
  .mat-papers{
    position:absolute;
    left: 50%;
    top: 44px;                        /* ✅ arranca más abajo para quedar 100% tapado */
    width: 124px;                     /* ✅ más grandes */
    height: 88px;

    opacity: 0;
    transform: translate(-50%, 0);
    transition: opacity .18s ease, transform .18s ease;

    z-index: 1;                        /* ✅ arriba del resto (pero debajo del botón ::after) */
    pointer-events:none;
  }

  /* ✅ en hover: suben MUCHO más (y se ven por delante del botón de arriba por z-index del card) */
  .mat-card:hover .mat-papers{
    opacity: 1;
    transform: translate(-50%, -96px);
  }

  /* Papeles */
  .mat-paper1,
  .mat-paper2{
    position:absolute;
    left:0; top:0;
    width: 124px;
    height: 88px;
    filter: drop-shadow(0 18px 26px rgba(15,23,42,.16));
  }

  .mat-paper2{
    transform: rotate(-10deg) translate(-12px, 12px);
    opacity: .86;
  }

  /* ✅ Todo lo que NO sea papeles va por encima del “botón blanco” */
  .mat-card > :not(.mat-papers){
    position: relative;
    z-index: 3; /* ✅ contenido arriba del botón (::after) */
  }

  /* ✅ SVG izquierdo */
.mat-icon{
  width: 50px;              /* ✅ más chico */
  height: 50px;             /* ✅ más chico */
  flex: 0 0 50px;           /* ✅ acompaña el tamaño */

  /* ✅ apenas a la derecha + misma inclinación */
  transform: translateX(4px) rotate(-4deg);

  transform-origin: center;
  filter: drop-shadow(0 10px 16px rgba(15,23,42,.12));

  display: block;           /* ✅ evita rarezas de inline */
  overflow: visible;        /* ✅ por si algún símbolo “asoma” */
}



  /* ✅ Texto: título + subtítulo (carrera) */
  .mat-meta{
    flex: 1;
    min-width: 0;                     /* ✅ necesario para ellipsis */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 6px;
    padding-right: 0;                 /* deja que el texto llegue más a la derecha */
  }

  .mat-title{
    display:block;
    max-width: 100%;
    font-weight: 900;
    font-size: 16px;
    line-height: 1.15;
    color: #0f172a;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;          /* ✅ ... */
  }

  .mat-sub{
    display:block;
    max-width: 100%;
    font-weight: 800;
    font-size: 12px;
    color: rgba(15,23,42,.55);

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;          /* ✅ ... */
  }
  .mat-sub:empty{ display:none; }

  /* ✅ Flecha: MÁS a la derecha y abajo, pegada al borde */
  .mat-go{
    position: absolute !important;

    /* ✅ extremo derecho + esquina inferior (diagonal inferior) */
    right: 13px !important;
    bottom: 13px !important;
    top: auto !important;
    left: auto !important;

    width: 22px;
    height: 22px;
    border-radius: 9999px;

    background: rgba(148, 163, 184, 0.055);
    border: 1px solid rgba(148, 163, 184, 0.034);

    display: grid;
    place-items: center;

    pointer-events: none;
    z-index: 3;

    margin: 0 !important;
    transform: none !important;
  }


  .mat-chev{
    display: block;
    width: 7px;
    height: 7px;

    border-right: 2px solid rgba(15, 23, 42, 0.150);
    border-top: 2px solid rgba(15, 23, 42, 0.150);

    /* ✅ centrado perfecto dentro del círculo */
    transform: rotate(45deg);
    margin: 0;

    transform: translateY(.5px) translatex(-1px) rotate(45deg);
  }
    /* Mobile (celular) — iPhone 15: 1 columna real + cards compactas */
  @media (max-width: 640px){
    /* ✅ evita overflow horizontal y fuerza 1 columna */
    #list.mat-grid{
      gap: 12px !important;
      grid-template-columns: 1fr !important;
    }

    html, body{
      overflow-x: hidden !important;
    }

    .mat-card{
      width: 100% !important;
      max-width: 100% !important;
      min-height: 78px;
      padding: 10px 42px 10px 10px;
      border-radius: 16px;
    }
    .mat-card::after{
      border-radius: 16px;
      box-shadow: none !important;
    }

    .mat-card:hover::after{
      box-shadow: none !important;
    }

    .mat-icon{
      width: 42px;
      height: 42px;
      flex: 0 0 42px;
      transform: translateX(2px) rotate(-4deg);
      filter: none !important;
    }

    .mat-title{
      font-size: 14px;
      line-height: 1.14;

      white-space: normal !important;
      overflow: visible !important;
      text-overflow: clip !important;
      overflow-wrap: anywhere !important;
      word-break: break-word !important;
    }

    .mat-sub{
      font-size: 11px;

      white-space: normal !important;
      overflow: visible !important;
      text-overflow: clip !important;
      overflow-wrap: anywhere !important;
      word-break: break-word !important;
    }

    .mat-go{
      right: 10px !important;
      bottom: 10px !important;
      width: 20px;
      height: 20px;
    }
    .mat-chev{
      width: 6px;
      height: 6px;
      transform: translateY(.5px) translateX(-.5px) rotate(45deg);
    }

    .mat-papers{
      width: 96px;
      height: 68px;
      top: 38px;
    }
    .mat-paper1, .mat-paper2{
      width: 96px;
      height: 68px;
    }
  }

  /* Extra: celulares muy chicos */
  @media (max-width: 380px){
    .mat-card{
      min-height: 74px;
      padding: 9px 40px 9px 9px;
    }
    .mat-title{ font-size: 13px; }
  }



  /* =========================
   Hover focus: opaca el resto cuando pasás por una materia
   ========================= */

  /* Desktop: cuando el mouse está sobre la grilla, bajá el resto */
  @media (hover:hover) and (pointer:fine){
    .mat-grid:hover .mat-card{
      opacity: .42;
      filter: blur(.6px) saturate(.92);
      transform: translateZ(0);
      transition: opacity .18s ease, filter .18s ease, transform .18s ease;
    }

    /* La que está bajo el mouse queda normal y arriba */
    .mat-grid:hover .mat-card:hover{
      opacity: 1;
      filter: none;
      z-index: 10;
    }

    /* Los papeles del hover deben quedar por delante del resto de cards */
    .mat-grid:hover .mat-card:hover .mat-papers{
      z-index: 1 !important;  /* ✅ detrás del botón por ::after, pero por delante del resto */ 
    }
  }
  /* ===== Segmented Semestre ===== */
  #segSem{ --pill-pad: 3px; position: relative; }
  #segSemThumb{
    position:absolute; top:50%; transform:translateY(-50%);
    left: 0; width: 0; height: 26px; border-radius: 9999px;
    background: linear-gradient(145deg, var(--accent), var(--accent-dark));
    border: 1px solid var(--accent-25);
    box-shadow: 0 10px 22px rgba(15,23,42,0);
    transition: left .25s cubic-bezier(.2,.8,.2,1), width .25s cubic-bezier(.2,.8,.2,1), height .25s;
    backdrop-filter: blur(10px) saturate(140%); -webkit-backdrop-filter: blur(10px) saturate(140%);
  }
  #segSem .seg-btn[data-active="true"]{ color:#fff; }
  </style>

  <!-- Injected: Mobile-friendly baseline -->
<style>
  /* Baseline mobile improvements (non-breaking) */
  @media (max-width: 480px){
    body{ -webkit-text-size-adjust: 100%; }
    img, video{ max-width:100% !important; height:auto !important; }
    .stack-mobile{ display:block !important; width:100% !important; }
    .fluid{ width:100% !important; }
    .touch-target{ min-height:44px; padding:12px 14px; }
    .hide-on-mobile{ display:none !important; }
    .card, .panel, .box{ border-radius:16px !important; }
    .toolbar, .header, .navbar{ position:sticky; top:0; z-index:20; }
    table{ display:block; width:100%; overflow-x:auto; -webkit-overflow-scrolling:touch; }
    .grid{ display:grid; grid-template-columns: 1fr !important; gap:12px; }
    .container, .content, main{ padding-left:12px !important; padding-right:12px !important; }
  }
</style>
</head>
<body class="min-h-screen bg-ios">

<% if (user && (user.isAdmin || user.role === 'admin')) { %>
  <a class="btn btn-admin-upload" href="/app/preguntas/upload" style="margin-left:12px; display:inline-flex; align-items:center; gap:8px; text-decoration:none; padding:8px 12px; border-radius:10px; background:#111827; color:#fff; max-width:100%; height:auto;">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M5 20h14v-2H5v2zm7-18l-5 5h3v6h4V7h3l-5-5z"/></svg>
    Cargar Preguntas
  </a>
   <button id="btnCreateCareer" type="button" style="margin-left:12px; display:inline-flex; align-items:center; gap:8px; text-decoration:none; padding:8px 12px; border-radius:10px; background:#0ea5e9; color:#fff; max-width:100%; height:auto;">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a1 1 0 011 1v6h6a1 1 0 110 2h-6v6a1 1 0 11-2 0v-6H5a1 1 0 110-2h6V3a1 1 0 011-1z"/></svg>
    Crear carrera
  </button>

<% } %>

  <!-- ===== Iconos SVG (una sola vez) ===== -->
  <svg id="cwSprite" aria-hidden="true" focusable="false" style="position:absolute; width:0; height:0; overflow:hidden;">
  <symbol id="ico-doc-a" viewBox="0 0 491.5 491.5">
    <rect x="55.978" y="27.651" transform="matrix(-1 0.0039 -0.0039 -1 492.5192 517.4346)" style="fill:#EBF0F3;" width="379.545" height="463.103"></rect>
    <g>
