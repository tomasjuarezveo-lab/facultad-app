  <!-- ===== NUEVO: Drawer lateral de códigos (solo admin) ===== -->
  <% if (user && user.role === 'admin') { %>
  <div id="codesDrawer" class="codes-drawer">
    <div id="codesDim" class="codes-dim"></div>
    <div class="codes-panel glass">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold">Códigos de verificación</h3>
        <button id="codesClose" class="h-8 w-8 rounded-full hover:bg-white flex items-center justify-center">✕</button>
      </div>

      <div class="grid grid-cols-1 gap-3">
        <div>
          <div class="flex items-center justify-between mb-1">
            <span class="text-sm font-medium">Activos (separados por “|”)</span>
            <label class="inline-flex items-center gap-2">
              <input id="codesFile" type="file" accept=".txt" class="hidden">
              <button id="btnAddCodes" class="h-8 px-2 rounded-md bg-amber-400/90 hover:bg-amber-400 text-slate-800 font-semibold text-sm" type="button">+</button>
            </label>
          </div>
          <div id="activeCodes" class="codes-box"></div>
        </div>

        <div>
          <div class="text-sm font-medium mb-1">Usados (separados por “|”)</div>
          <div id="usedCodes" class="codes-box"></div>
        </div>
      </div>
    </div>
  </div>
  <% } %>

<script>
  /* ===== Tabs iOS ultra compactos ===== */
  /* ===== Tabs iOS: Año + Semestre ===== */
  const segY     = document.getElementById('segYears');
  const thumbY   = document.getElementById('segThumb');
  const btnY     = segY ? Array.from(segY.querySelectorAll('.seg-btn')) : [];
  const padY     = segY ? parseInt(getComputedStyle(segY).getPropertyValue('--pill-pad')) || 0 : 0;

  const segS     = document.getElementById('segSem');
  const thumbS   = document.getElementById('segSemThumb');
  const btnS     = segS ? Array.from(segS.querySelectorAll('.seg-btn')) : [];
  const padS     = segS ? parseInt(getComputedStyle(segS).getPropertyValue('--pill-pad')) || 0 : 0;

  let ACTIVE_YEAR = (btnY.find(b=>b.dataset.active==='true')?.dataset.value) || '1';
  let ACTIVE_SEM  = (btnS.find(b=>b.dataset.active==='true')?.dataset.value) || 'all';

  function moveThumb(seg, thumb, el, pad){
    if(!seg || !el || !thumb) return;
    const rS = seg.getBoundingClientRect();
    const rB = el.getBoundingClientRect();
    thumb.style.left   = ((rB.left - rS.left) + pad) + 'px';
    thumb.style.width  = rB.width + 'px';
    thumb.style.height = el.offsetHeight + 'px';
  }

  function setActive(list, el){
    if (!list.length) return;
    list.forEach(b=>b.dataset.active='false');
    el.dataset.active='true';
  }

  function applyFilters(){
    const qEl = document.getElementById('qMaterias');
    const q = (qEl && qEl.value || '').trim().toLowerCase();

    document.querySelectorAll('#list [data-year]').forEach(c=>{
      const okYear = (ACTIVE_YEAR==='all') || (String(c.dataset.year)===String(ACTIVE_YEAR));

      const sem = String(c.dataset.semester || '').trim();
      const okSem = (ACTIVE_SEM==='all') || (sem && sem === String(ACTIVE_SEM));

      const okText = !q || (String(c.dataset.name || '')).includes(q);

      c.style.display = (okYear && okSem && okText) ? '' : 'none';
    });
  }

  function selectYear(btn, value){
    ACTIVE_YEAR = String(value);
    setActive(btnY, btn);
    moveThumb(segY, thumbY, btn, padY);
    applyFilters();
  }

  function selectSem(btn, value){
    ACTIVE_SEM = String(value);
    setActive(btnS, btn);
    moveThumb(segS, thumbS, btn, padS);
    applyFilters();
  }

  const qMaterias = document.getElementById('qMaterias');
  if (qMaterias){
    qMaterias.addEventListener('input', applyFilters);
  }

  window.addEventListener('DOMContentLoaded', ()=>{
    const ay = btnY.find(b=>b.dataset.active==='true') || btnY[0];
    const as = btnS.find(b=>b.dataset.active==='true') || btnS[0];
    if (ay) moveThumb(segY, thumbY, ay, padY);
    if (as) moveThumb(segS, thumbS, as, padS);
    applyFilters();
  });

  window.addEventListener('resize', ()=>{
    const ay = btnY.find(b=>b.dataset.active==='true');
    const as = btnS.find(b=>b.dataset.active==='true');
    if (ay) moveThumb(segY, thumbY, ay, padY);
    if (as) moveThumb(segS, thumbS, as, padS);
  });

  // Exponer funciones a los onclick del HTML
  window.selectYear = selectYear;
  window.selectSem  = selectSem;
  window.addEventListener('resize', ()=>{
    const active = buttons.find(b=>b.dataset.active==='true');
    if (active) moveThumbTo(active);
  });

  /* ===== Modal admin (crear materia) ===== */
  const btnNew = document.getElementById('btnNewSubject');
  const modal  = document.getElementById('modalNewSubject');
  const close  = document.getElementById('closeModal');
  const cancel = document.getElementById('cancelModal');
  function showModal(){ modal?.classList.remove('hidden'); }
  function hideModal(){ modal?.classList.add('hidden'); }
  btnNew?.addEventListener('click', showModal);
  close?.addEventListener('click', hideModal);
  cancel?.addEventListener('click', hideModal);
  modal?.addEventListener('click', (e)=>{ if(e.target===modal) hideModal(); });

  /* ===== NUEVO: Lógica verificación (admin controls) ===== */
  const isAdmin = "<%= user && user.role === 'admin' ? '1' : '' %>";
  if (isAdmin) {
    const verifyToggle = document.getElementById('verifyToggle');
    const toggleTrack  = document.getElementById('toggleTrack');
    const toggleThumb  = document.getElementById('toggleThumb');
    const btnCodesPanel= document.getElementById('btnCodesPanel');
    const drawer       = document.getElementById('codesDrawer');
    const dim          = document.getElementById('codesDim');
    const btnClose     = document.getElementById('codesClose');
    const activeBox    = document.getElementById('activeCodes');
    const usedBox      = document.getElementById('usedCodes');
    const btnAddCodes  = document.getElementById('btnAddCodes');
    const fileInput    = document.getElementById('codesFile');

    function paintToggle(on){
      if (!verifyToggle || !toggleTrack || !toggleThumb) return;
      verifyToggle.checked = !!on;
      if (on){
        toggleTrack.classList.remove('bg-slate-300');
        toggleTrack.classList.add('bg-amber-400');
        toggleThumb.style.transform = 'translateX(20px)';
      } else {
        toggleTrack.classList.add('bg-slate-300');
        toggleTrack.classList.remove('bg-amber-400');
        toggleThumb.style.transform = 'translateX(0)';
      }
    }

    async function loadCodes(){
      const r = await fetch('/verify/list', { credentials:'include' });
      const j = await r.json();
      paintToggle(!!j.enabled);
      if (activeBox) activeBox.textContent = j.active || '';
      if (usedBox)   usedBox.textContent   = j.used   || '';
    }
    async function setEnabled(next){
      await fetch('/verify/toggle', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        credentials:'include',
        body: JSON.stringify({ enabled: !!next })
      });
      paintToggle(!!next);
    }

    verifyToggle?.addEventListener('change', (e)=> setEnabled(e.target.checked));
    btnCodesPanel?.addEventListener('click', async ()=>{
      await loadCodes();
      drawer?.classList.add('is-open');
    });
    btnClose?.addEventListener('click', ()=> drawer?.classList.remove('is-open'));
    dim?.addEventListener('click', ()=> drawer?.classList.remove('is-open'));

    btnAddCodes?.addEventListener('click', ()=> fileInput?.click());
    fileInput?.addEventListener('change', async ()=>{
      if (!fileInput.files || !fileInput.files[0]) return;
      const fd = new FormData();
      fd.append('codesFile', fileInput.files[0]);
      const r = await fetch('/verify/upload', { method:'POST', credentials:'include', body: fd });
      const j = await r.json();
      if (j.ok && activeBox){
        activeBox.textContent = j.active || '';
      }
      fileInput.value = '';
    });

    // Inicializar estado del switch al entrar
    loadCodes().catch(()=>{});
  }

  /* ===== Chatbot Admin (subir KB) ===== */
  (function(){
    const btnOpen   = document.getElementById('btnChatbotAdmin');
    const modal     = document.getElementById('modalChatbotAdmin');
    if (!btnOpen || !modal) return;

    const closeBtn  = document.getElementById('closeChatbotAdmin');
    const closeBtn2 = document.getElementById('closeChatbotAdmin2');
    const fileArea  = document.getElementById('mcbFileArea');
    const fileInput = document.getElementById('mcbFileInput');
    const fileName  = document.getElementById('mcbFileName');
    const btnUpload = document.getElementById('mcbBtnUpload');
    const statusEl  = document.getElementById('mcbStatus');

    function openModal(){ modal.classList.add('is-open'); resetForm(); }
    function closeModal(){ modal.classList.remove('is-open'); }
    function resetForm(){
      fileInput.value = '';
      fileName.style.display = 'none';
      fileName.textContent = '';
      btnUpload.disabled = true;
      statusEl.textContent = '';
      statusEl.className = 'mcb-status';
    }

    fileArea.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', () => {
      const f = fileInput.files && fileInput.files[0];
      if (!f) return;
      fileName.textContent = f.name;
      fileName.style.display = 'block';
      btnUpload.disabled = false;
      statusEl.textContent = '';
      statusEl.className = 'mcb-status';
    });

    btnUpload.addEventListener('click', async () => {
      const f = fileInput.files && fileInput.files[0];
      if (!f) return;
      btnUpload.disabled = true;
      statusEl.textContent = 'Subiendo…';
      statusEl.className = 'mcb-status';
      try {
        const fd = new FormData();
        fd.append('chatbotFile', f);
        const r = await fetch('/admin/chatbot/upload', { method:'POST', credentials:'include', body: fd });
        const j = await r.json();
        if (!j.ok) throw new Error(j.error || 'Error desconocido');
        statusEl.textContent = `✓ Base cargada correctamente (${j.categories} categoría${j.categories===1?'':'s'}).`;
        statusEl.className = 'mcb-status ok';
        setTimeout(closeModal, 1800);
      } catch(e) {
        statusEl.textContent = '✗ ' + (e.message || 'Error al subir');
        statusEl.className = 'mcb-status err';
        btnUpload.disabled = false;
      }
    });

    btnOpen.addEventListener('click', openModal);
    closeBtn  && closeBtn.addEventListener('click',  closeModal);
    closeBtn2 && closeBtn2.addEventListener('click', closeModal);
    modal.addEventListener('click', ev => { if (ev.target === modal) closeModal(); });
  })();

  /* ===== NUEVO: opciones para selects de Carrera y Plan ===== */
  window.ADMIN_CAREERS = <%- JSON.stringify((adminFilters && adminFilters.careers) || ["Lic. en Administración de Empresas","Lic. en Economía","Contabilidad"]) %>;
    window.ADMIN_PLANS   = Array.from(new Set((<%- JSON.stringify((adminFilters && adminFilters.plans) || [6,7,8]) %> || []).map(v => parseInt(String(v), 10)).filter(v => [6,7,8].includes(v)))).sort((a,b)=>a-b);

  /* ===== Usuarios (Admin) — grilla + modal de edición ===== */
  (function(){
    const btnOpen  = document.getElementById('btnUsersPanel');
    const modal    = document.getElementById('modalUsers');
    if (!btnOpen || !modal) return;

    const closeBtn   = document.getElementById('closeUsers');
    const qBox       = document.getElementById('qUsers');
    const listBox    = document.getElementById('usersList');

    // Modal de edición
    const editModal  = document.getElementById('modalUserEdit');
    const editClose  = document.getElementById('closeUserEdit');
    const inName     = document.getElementById('mueInputName');
    const inEmail    = document.getElementById('mueInputEmail');
    const inPass     = document.getElementById('mueInputPass');
    const inPhone    = document.getElementById('mueInputPhone');
    const selCareer  = document.getElementById('mueSelCareer');
    const selPlan    = document.getElementById('mueSelPlan');
    const legalBox   = document.getElementById('mueLegal');
    const btnSave    = document.getElementById('mueBtnSave');
    const btnDel     = document.getElementById('mueBtnDel');
    const createdBox = document.getElementById('mueCreated');

    let timer = null;
    let lastQ = '';
    let activeUserId = null;
    let allRows = [];

    const TZ = 'America/Argentina/Buenos_Aires';
    function fmtAR(ts){
      if (!ts) return '';
      let s = String(ts).trim();
      if (/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}/.test(s)) s = s.replace(' ','T');
      if (!/[zZ]|[+-]\d{2}:?\d{2}$/.test(s)) s += 'Z';
      const d = new Date(s);
      if (isNaN(d.getTime())) return String(ts);
      return d.toLocaleString('es-AR',{timeZone:TZ,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false}).replace(',','');
    }
    function legalText(u){
      const a = u.terms_accepted_at   ? 'Términos y Condiciones: Sí · '+fmtAR(u.terms_accepted_at)   : 'Términos y Condiciones: No';
      const b = u.privacy_accepted_at ? 'Política de Privacidad: Sí · '+fmtAR(u.privacy_accepted_at) : 'Política de Privacidad: No';
      return a+'\n'+b;
    }
    function esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    function populateSel(el, opts, selected){
      if (!el) return;
      el.innerHTML = '';
      (opts||[]).forEach(v=>{
        const o = document.createElement('option');
        o.value = String(v); o.textContent = String(v);
        if (String(v)===String(selected)) o.selected = true;
        el.appendChild(o);
      });
    }

    // ── Abrir / cerrar modal principal ──────────────────────
    function openModal(){
      modal.classList.add('is-open');
      fetchAndPaint('');
      qBox.value = ''; qBox.focus();
    }
    function closeModal(){
      modal.classList.remove('is-open');
      listBox.innerHTML = '';
    }

    // ── Abrir modal de edición ───────────────────────────────
    function openEdit(u){
      activeUserId = u.id;
      inName.value  = u.name  || '';
      inEmail.value = u.email || '';
      inPass.value  = '';
      inPhone.value = u.phone || '';
      populateSel(selCareer, window.ADMIN_CAREERS||[], u.career||'');
      populateSel(selPlan,   window.ADMIN_PLANS||[],   u.plan||'');
      legalBox.textContent = legalText(u);
      createdBox.textContent = u.created_at ? 'Creado: '+fmtAR(u.created_at) : '';
      btnDel.disabled = String(u.role)==='admin';
      btnDel.title    = String(u.role)==='admin' ? 'No se puede eliminar un administrador' : '';
      editModal.classList.add('is-open');
    }
    function closeEdit(){ editModal.classList.remove('is-open'); activeUserId = null; }

    // ── Fetch usuarios ───────────────────────────────────────
    async function fetchUsers(q){
      const r = await fetch('/admin/users?q='+encodeURIComponent(q||''), { credentials:'include' });
      const j = await r.json();
      if (!j.ok) throw new Error(j.error||'Error listando usuarios');
      return j.users||[];
    }

    // ── Pintar grilla ────────────────────────────────────────
    function paintUsers(rows){
      allRows = rows;
      listBox.innerHTML = '';
      if (!rows.length){
        listBox.innerHTML = '<div class="mu-empty">No se encontraron usuarios para ese filtro.</div>';
        return;
      }
      rows.forEach(u => {
        const card = document.createElement('div');
        card.className = 'mu-card';
        const career = esc(u.career||'—');
        card.innerHTML = `
          <div class="mu-card-name" title="${esc(u.name||'')}">${esc(u.name||'Sin nombre')}</div>
          <div class="mu-card-line" title="${career}">${career}</div>
          <span class="mu-card-plan">Plan ${esc(String(u.plan||'?'))}</span>`;
        card.addEventListener('click', () => openEdit(u));
        listBox.appendChild(card);
      });
    }

    async function fetchAndPaint(q){
      try{ paintUsers(await fetchUsers(q)); }
      catch(e){ console.error(e); alert('Error cargando usuarios'); }
    }

    // ── Guardar cambios ──────────────────────────────────────
    btnSave && btnSave.addEventListener('click', async () => {
      if (!activeUserId) return;
      const payload = {
        name:     inName.value.trim(),
        email:    inEmail.value.trim(),
        password: inPass.value,
        phone:    inPhone.value.trim(),
        career:   selCareer ? selCareer.value : '',
        plan:     selPlan   ? parseInt(selPlan.value,10)||0 : 0
      };
      try{
        const r = await fetch('/admin/users/'+activeUserId,{
          method:'PUT', headers:{'Content-Type':'application/json'},
          credentials:'include', body:JSON.stringify(payload)
        });
        const j = await r.json();
        if (!j.ok) return alert(j.error||'No se pudo actualizar');
        inPass.value = '';
        // Refrescar la tarjeta en la grilla
        const idx = allRows.findIndex(u=>u.id===activeUserId);
        if (idx>=0){
          allRows[idx] = Object.assign(allRows[idx], j.user||payload, {id:activeUserId});
          paintUsers(allRows);
        }
        closeEdit();
      }catch(e){ alert('Error de red'); }
    });

    // ── Eliminar usuario ─────────────────────────────────────
    btnDel && btnDel.addEventListener('click', async () => {
      if (!activeUserId) return;
      if (!confirm('¿Eliminar este usuario? Esta acción no se puede deshacer.')) return;
      try{
        const r = await fetch('/admin/users/'+activeUserId,{method:'DELETE',credentials:'include'});
        const j = await r.json();
        if (!j.ok) return alert(j.error||'No se pudo eliminar');
        allRows = allRows.filter(u=>u.id!==activeUserId);
        paintUsers(allRows);
        closeEdit();
      }catch(e){ alert('Error de red'); }
    });

    // ── Eventos ──────────────────────────────────────────────
    btnOpen.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', ev=>{ if(ev.target===modal) closeModal(); });
    editClose && editClose.addEventListener('click', closeEdit);
    editModal && editModal.addEventListener('click', ev=>{ if(ev.target===editModal) closeEdit(); });

    qBox.addEventListener('input', ()=>{
      const q = qBox.value.trim();
      if (q===lastQ) return; lastQ = q;
      if (timer) clearTimeout(timer);
      timer = setTimeout(()=>fetchAndPaint(q), 220);
    });
  })();
</script>

