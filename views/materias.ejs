<script>
/* =========================================================
   ✅ ICONOS POR MATERIA — FIX DEFINITIVO
   - Usa SIEMPRE el sprite real (#cwSprite)
   - Asigna un icono estable por materia (hash del href)
   ========================================================= */
(function(){
  const SPRITE_ID = 'cwSprite';
  const XLINK_NS  = 'http://www.w3.org/1999/xlink';

  function hash32(str){
    // FNV-1a 32-bit (estable y rápido)
    let h = 2166136261;
    for (let i = 0; i < str.length; i++){
      h ^= str.charCodeAt(i);
      h = Math.imul(h, 16777619);
    }
    return h >>> 0;
  }

  function getSprite(){
    // 1) el que vos marcaste
    const byId = document.getElementById(SPRITE_ID);
    if (byId) return byId;

    // 2) fallback: cualquier svg que tenga symbols ico-
    return Array.from(document.querySelectorAll('svg'))
      .find(svg => svg.querySelector('symbol[id^="ico-"]')) || null;
  }

  function initSubjectIcons(){
    const sprite = getSprite();
    if (!sprite) return;

    const symbolIds = Array.from(sprite.querySelectorAll('symbol[id^="ico-"]'))
      .map(s => s.id)
      .filter(Boolean);

    // Si hay 0 o 1 símbolos, no tiene sentido variar
    if (symbolIds.length < 2) return;

    document.querySelectorAll('#list .mat-card').forEach((card) => {
      const useEl = card.querySelector('svg.mat-icon > use');
      if (!useEl) return;

      // Clave única por materia (tu href ya tiene el id)
      const key = String(card.getAttribute('href') || '');
      const idx = hash32(key) % symbolIds.length;
      const ref = '#' + symbolIds[idx];

      // Set robusto (SVG2 + compat)
      useEl.setAttribute('href', ref);
      useEl.setAttributeNS(null, 'href', ref);
      useEl.setAttributeNS(XLINK_NS, 'xlink:href', ref);

      try { useEl.href.baseVal = ref; } catch(_) {}
      try { useEl.xlinkHref.baseVal = ref; } catch(_) {}
    });
  }

  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', initSubjectIcons, { once:true });
  } else {
    initSubjectIcons();
  }
})();
</script>
