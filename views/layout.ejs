/* =========================
   PERFIL DRAWER (pdv2) — Layout: foto más grande + textos más chicos y juntos
   ========================= */

/* Foto circular más grande */
.pdv2-top{
  align-items:center; /* centra verticalmente foto + texto */
}

.pdv2-avaShell{
  width: 88px;
  height: 88px;
  flex: 0 0 88px;
}

.pdv2-avaRing{
  padding: 4px; /* aro un poquito más separado */
}

/* Nombre/Carrera más chicos y con menos margen SOLO en el bloque superior */
.pdv2-top .pdv2-meta{
  padding-top: 0;
}

.pdv2-top .pdv2-label{
  font-size: 10px;
  margin: 0 0 2px; /* menos margen */
}

.pdv2-top .pdv2-value{
  font-size: 14px;
  margin: 0 0 6px; /* nombre y carrera más cerca */
}

.pdv2-top .pdv2-value:last-of-type{
  margin-bottom: 0;
}


/* =========================
   PERFIL DRAWER — LIGHT MODE (NO toca cw-dark)
   Cambia SOLO el recuadro en light mode
   ========================= */

html:not(.cw-dark) .pd-panel{
  /* recuadro claro / light mode */
  background:
    radial-gradient(900px 600px at 20% 10%, rgba(255,255,255,.98), rgba(255,255,255,0) 55%),
    linear-gradient(180deg, rgba(255,255,255,.92), rgba(248,250,253,.86));

  border: 1px solid rgba(15,23,42,.10);
  border-left: 0; /* respeta tu panel lateral */
  box-shadow: 0 28px 56px rgba(15,23,42,.18);
  color: #0f172a;
}

/* Textos del drawer en light (para que no queden blancos) */
html:not(.cw-dark) .pdv2-label{
  color: rgba(100,116,139,.95);
}
html:not(.cw-dark) .pdv2-value{
  color: #0f172a;
}
html:not(.cw-dark) .pdv2-text{
  color: #334155;
}
html:not(.cw-dark) .pdv2-email{
  color: #0f172a;
}
html:not(.cw-dark) .pdv2-hr{
  background: rgba(15,23,42,.10);
}

/* Avatares y chips en light para que no queden “oscuros” */
html:not(.cw-dark) .pdv2-ava{
  border: 1px solid rgba(15,23,42,.08);
  background: rgba(15,23,42,.03);
  box-shadow: 0 16px 30px rgba(15,23,42,.10);
}
html:not(.cw-dark) .pdv2-peopleAva{
  border: 2px solid rgba(15,23,42,.10);
  background: rgba(15,23,42,.04);
  box-shadow: 0 12px 22px rgba(15,23,42,.10);
}
html:not(.cw-dark) .pdv2-peopleEmpty{
  color: rgba(100,116,139,.95);
}

