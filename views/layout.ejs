                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Abrir promoción de <%= item.title %>">
                  <div class="cw-clubPromo__qrWrap">
                    <img
                      class="cw-clubPromo__qr"
                      src="<%= item.qr %>"
                      alt="QR de <%= item.title %>"
                      loading="lazy"
                      decoding="async"
                      width="240"
                      height="240"
                      onerror="this.onerror=null;this.src='https://api.qrserver.com/v1/create-qr-code/?size=240x240&margin=0&data=https%3A%2F%2Fcleverwave.com.ar';">
                  </div>
                </a>

                <a
                  class="cw-clubPromo__redeemLink"
                  href="<%= item.link %>"
                  target="_blank"
                  rel="noopener noreferrer">Escanea o toca el QR</a>
              <% } else { %>
                <div class="cw-clubPromo__codeCardTitle">Código</div>
                <div class="cw-clubPromo__code"><%= item.code %></div>
                <div class="cw-clubPromo__redeem">Presentalo al comercio</div>
              <% } %>
            </div>

            <div class="cw-clubPromo__front <%= imageLeft ? 'cw-clubPromo__front--imageLeft' : '' %>">
              <div class="cw-clubPromo__copy">
                <h4 class="cw-clubPromo__title"><%= item.title %></h4>
                <div class="cw-clubPromo__discount"><%= item.discount %></div>
              </div>

              <div class="cw-clubPromo__media">
                <img
                  class="cw-clubPromo__img"
                  src="<%= item.image %>"
                  alt="<%= item.title %>"
                  loading="lazy"
                  decoding="async"
                  width="420"
                  height="420"
                  onerror="this.onerror=null;this.src='https://picsum.photos/seed/cwclubfallback<%= idx + 1 %>/420/420';">
              </div>

              <span class="cw-clubPromo__frontShade" aria-hidden="true"></span>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </div>

