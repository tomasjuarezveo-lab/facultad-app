/* =========================
   MINI AGENDA EN DRAWER — MISMA GRILLA QUE PERFIL (pero read-only)
   Renderiza dentro de: #pdAgendaMini
   ========================= */

/* Resetea el contenedor anterior (si lo tenías como “lista”) */
#pdAgendaMini.pdv2-agendaMini{
  margin-top: 14px !important;
  padding: 0 !important;
  background: transparent !important;
  border: 0 !important;
  max-height: none !important;
  overflow: visible !important;
}

/* Copia del look de perfil, scoped */
#pdAgendaMini .pf-agendaWrap{
  width: 100%;
  max-width: 720px;
  margin: 0;
  padding: 8px 0 0;
  box-sizing: border-box;
}

#pdAgendaMini .pf-agendaHeader{
  display:flex;
  align-items:center;
  justify-content: space-between;
  gap: 10px;
  margin: 0 0 10px;
}

#pdAgendaMini .pf-agendaMonth{
  font-weight: 950;
  font-size: 14px;
  color: rgba(15,23,42,.85);
}
html.cw-dark #pdAgendaMini .pf-agendaMonth{
  color: rgba(243,244,246,.92);
}

#pdAgendaMini .pf-agendaNav{
  width: 36px;
  height: 36px;
  border-radius: 14px;
  border: 1px solid rgba(15,23,42,.10);
  background: #fff;
  font-weight: 950;
  font-size: 18px;
  color: rgba(15,23,42,.80);
  pointer-events: none; /* visual, no hace nada */
  user-select:none;
}

#pdAgendaMini .pf-agendaDow{
  display:grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 8px;
  margin-bottom: 8px;
  color: rgba(15,23,42,.55);
  font-weight: 900;
  font-size: 11px;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}
#pdAgendaMini .pf-agendaDow > div{ text-align:center; }
html.cw-dark #pdAgendaMini .pf-agendaDow{
  color: rgba(229,231,235,.72);
}

#pdAgendaMini .pf-agendaGrid{
  display:grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 8px;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: visible;
}

#pdAgendaMini .pf-agendaCell{
  aspect-ratio: 1/1;
  border-radius: 16px;
  border: 1px solid rgba(15,23,42,.08);
  background: #fff;
  box-shadow: 0 12px 20px rgba(15,23,42,.06);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  position: relative;
  padding: 0;
  overflow: visible;
}

#pdAgendaMini .pf-agendaCell > :not(.pd-agendaBadge){
  overflow: hidden;
  border-radius: inherit;
}

#pdAgendaMini .pf-agendaCell.has-multi{
  background: var(--pf-multi-bg) !important;
  border-color: var(--pf-note) !important;
}

#pdAgendaMini .pd-agendaBadge{
  position: absolute;
  top: -6px;
  right: -6px;
  min-width: 17px;
  height: 17px;
  border-radius: 9999px;
  background: #ef4444;
  color: #fff;
  font-size: 9px;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 3px;
  z-index: 30;
  isolation: isolate;
  box-shadow: 0 2px 8px rgba(0,0,0,.38);
  pointer-events: none;
  line-height: 1;
  box-sizing: border-box;
}

#pdAgendaMini .pf-agendaCell.is-empty{
  background: rgba(255,255,255,.35);
  border-color: rgba(255,255,255,.0);
  box-shadow: none;
  cursor: default;
}

#pdAgendaMini .pf-agendaDay{
  position: absolute;
  top: 10px;
  left: 10px;
  font-weight: 950;
  font-size: 12px;
  color: rgba(15,23,42,.82);
}

#pdAgendaMini .pf-agendaCell.has-note:not(.has-multi){
  background: color-mix(in srgb, var(--pf-note) 18%, #fff);
  border-color: color-mix(in srgb, var(--pf-note) 22%, rgba(15,23,42,.08));
}

#pdAgendaMini .pf-agendaCell.is-important{
  box-shadow: 0 12px 20px rgba(15,23,42,.10), inset 0 0 0 2px rgba(15,23,42,.18);
}

/* Hover agranda igual a perfil */
#pdAgendaMini .pf-agendaCell{
  transition: transform .14s ease, box-shadow .14s ease;
  transform-origin: center;
}
@media (hover:hover) and (pointer:fine){
  #pdAgendaMini .pf-agendaCell:not(.is-empty):hover{
    transform: scale(1.06);
    z-index: 20;
  }
}
/* =========================
   PATCH v3 — Agenda (cuadrados + hover más grande + flechas clickeables)
   ========================= */

/* Días: más cuadrados (menos redondeo) */
#pdAgendaMini .pf-agendaCell{
  border-radius: 8px !important;
}

/* Hover: agranda más */
@media (hover:hover) and (pointer:fine){
  #pdAgendaMini .pf-agendaCell:not(.is-empty):hover{
    transform: scale(1.14) !important;
  }
}

/* Flechas: ahora clickeables */
#pdAgendaMini .pf-agendaNav{
  pointer-events: auto !important;
  cursor: pointer !important;
  user-select: none !important;
}
#pdAgendaMini .pf-agendaNav:active{
