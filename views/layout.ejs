  /* =========================
    DOCK iOS (con shift a la derecha + labels arriba)
    ========================= */
  .ios-dock-wrap{
    position:fixed;left:0;right:0;bottom:18px;
    display:flex;justify-content:center;
    z-index:1000;pointer-events:none;
    /* shift robusto a la derecha */
    padding-left:calc(8px + (var(--dockRightShift) * 2));
    padding-right:8px;
  }
  .ios-dock{
    pointer-events:auto;
    display:grid;grid-auto-flow:column;align-items:end;gap:18px;
    padding:16px 20px;border-radius:22px;
    background:var(--glass-2);
    border:1px solid var(--stroke);
    box-shadow:var(--shadow-strong), inset 0 1px 0 rgba(255,255,255,.75);
    backdrop-filter:blur(22px) saturate(160%);
    -webkit-backdrop-filter:blur(22px) saturate(160%);
    -webkit-tap-highlight-color:transparent;
  }
  .ios-dock{ overflow:visible; }
  .dock-item{
    width:82px;
    display:grid;grid-template-rows:62px auto;gap:6px;justify-items:center;
    text-decoration:none;cursor:pointer;
    position:relative;
  }
  .dock-tile{
    width:62px;height:62px;border-radius:var(--radius-lg);
    background:linear-gradient(145deg, rgba(255,255,255,.35), rgba(255,255,255,.18));
    border:1px solid var(--stroke);
    box-shadow:0 12px 22px rgba(15,23,42,.14), inset 0 1px 0 rgba(255,255,255,.85), inset 0 -10px 24px rgba(15,23,42,.06);
    display:grid;place-items:center;
    will-change:transform;
    transition:transform .2s cubic-bezier(.2,.8,.2,1), box-shadow .2s ease;
  }
  .dock-icon{
    width:30px;height:30px;
    filter:drop-shadow(0 1px 0 rgba(255,255,255,.55));
    transition:transform .2s cubic-bezier(.2,.8,.2,1), opacity .2s ease;
  }
  .dock-label{
    font-size:12px;line-height:1;color:#76839b;
    text-shadow:0 1px 2px rgba(0,0,0,.08);
    transition:transform .2s cubic-bezier(.2,.8,.2,1), color .2s ease, opacity .15s ease;
  }

  /* hover del dock (se mantiene) */
  @media (hover:hover){
    .dock-item:hover .dock-tile{
      transform:translateY(-8px) scale(1.04);
      box-shadow:0 18px 34px rgba(15,23,42,.20), inset 0 1px 0 rgba(255,255,255,.92), inset 0 -12px 28px rgba(15,23,42,.08);
    }
    .dock-item:hover .dock-icon{transform:translateY(-2px);opacity:.95;}
  }

  /* Activo */
  .dock-item.active .dock-tile{
    box-shadow:0 20px 30px rgba(15,23,42,.18), 0 0 0 3px rgba(255,255,255,.55) inset, inset 0 1px 0 rgba(255,255,255,.95);
  }

  /* Desktop: dock más compacto + label como tooltip arriba (sin caja) */
  @media (hover:hover) and (min-width:641px){
    .ios-dock-wrap{bottom:14px;}
    .ios-dock{padding:8px 12px;gap:10px;border-radius:20px;}
    .dock-item{width:68px;grid-template-rows:56px;gap:0;}
    .dock-tile{width:56px;height:56px;border-radius:16px;}
    .dock-label{
      position:absolute;left:50%;
      bottom:calc(56px + var(--dockLabelUp));
      transform:translateX(-50%) translateY(6px);
      opacity:0;pointer-events:none;
      background:transparent;border:0;box-shadow:none;padding:0;
      font-weight:800;color:var(--muted);
      white-space:nowrap;
    }
    .dock-item:hover .dock-label,
    .dock-item:focus-within .dock-label{
      opacity:1;transform:translateX(-50%) translateY(0);
    }
  }
  /* Touch: labels como tooltip arriba, nunca fijos debajo */
  @media (hover:none), (pointer:coarse){
    .dock-label{
      position:absolute;
      left:50%;
      bottom:calc(62px + var(--dockLabelUp));
      transform:translateX(-50%) translateY(6px);
      opacity:0;
      pointer-events:none;
      background:transparent;
      border:0;
      box-shadow:none;
      padding:0;
      white-space:nowrap;
    }

    .dock-item:active .dock-label,
    .dock-item:focus-within .dock-label,
    .dock-item:focus-visible .dock-label{
      opacity:1;
      transform:translateX(-50%) translateY(0);
    }
  }

  /* =========================
    USER BADGE (izq) + HELP BADGE (der)
    ========================= */
    /* =========================
    USER BADGE (izq) -> SOLO MASCOTA (sin foto/nombre/usuario, SIN expandir)
    ========================= */
  :root{
    --userBadgeW:50px;
    --userBadgeH:50px;
    --userBadgeR:16px; /* podés poner 14px si lo querés más “cuadrado” */
  }

  .user-badge-fixed{
    position:fixed;
    left:18px;
    bottom:34px;

    width:var(--userBadgeW);
    height:var(--userBadgeH);
    padding:0;

    border-radius:var(--userBadgeR);
    overflow:hidden;

    background:var(--glass-1);
    border:1px solid var(--stroke);
    box-shadow:var(--shadow);

    backdrop-filter:blur(14px) saturate(140%);
    -webkit-backdrop-filter:blur(14px) saturate(140%);

    -webkit-tap-highlight-color:transparent;
    -webkit-touch-callout:none;
    user-select:none;
    touch-action:manipulation;

    cursor:pointer;
    z-index:1001;

    display:block;
    appearance:none;
    -webkit-appearance:none;

    transition:box-shadow .2s ease, filter .18s ease, transform .15s ease;
  }
  .user-badge-fixed:focus{outline:none;}
  .user-badge-fixed{ aspect-ratio: 1 / 1; }
  .user-badge-fixed:focus-visible{outline:2px solid #2563eb;outline-offset:2px;}
  .user-badge-fixed:active{transform:translateY(1px) scale(.99);}
  @media (hover:hover){
    .user-badge-fixed:hover{box-shadow:var(--shadow-strong);}
  }

  .user-badge-buddy{
    position:absolute;
    inset:0;

    background:
      radial-gradient(10px 10px at 18% 22%, rgba(255,255,255,.95) 0 38%, rgba(255,255,255,0) 65%),
      radial-gradient(12px 12px at 78% 28%, rgba(255,255,255,.88) 0 40%, rgba(255,255,255,0) 68%),
      radial-gradient(14px 14px at 60% 80%, rgba(255,255,255,.85) 0 35%, rgba(255,255,255,0) 70%),
      linear-gradient(135deg, rgba(255,170,205,.96), rgba(190,235,255,.92) 55%, rgba(255,220,185,.92));
  }

  .user-badge-buddy .cw-buddy-face{
    position:absolute;
    left:50%;
    top:50%;
    transform:translate(-50%,-58%);
    width:30px;
    height:21px;
    pointer-events:none;
  }

  .help-badge-fixed{
    position:fixed;right:18px;bottom:34px;
    height:var(--badge-size);min-width:var(--badge-size);
    padding:10px 14px;display:inline-flex;align-items:center;gap:10px;
    background:var(--glass-1);border:1px solid var(--stroke);
    border-radius:9999px;box-shadow:var(--shadow);
    backdrop-filter:blur(14px) saturate(140%);
    -webkit-backdrop-filter:blur(14px) saturate(140%);
    text-decoration:none;color:var(--ink);
    -webkit-tap-highlight-color:transparent;
    transition:box-shadow .2s ease, transform .15s ease;
    z-index:1001;
  }
    /* Correlativas: fullscreen fallback (oculta dock/badges) */
  body.cw-correlativas-fs .ios-dock-wrap,
  body.cw-correlativas-fs .user-badge-fixed,
  body.cw-correlativas-fs .help-badge-fixed{
    display:none !important;
  }
  @media (hover:hover){
    .help-badge-fixed:hover{box-shadow:var(--shadow-strong);transform:translateY(-2px);}
  }
  .help-circle{
    width:36px;height:36px;border-radius:9999px;
    background:linear-gradient(145deg, rgba(255,255,255,.9), rgba(255,255,255,.7));
    border:1px solid var(--stroke);
    box-shadow:0 10px 20px rgba(15,23,42,.12), inset 0 1px 0 rgba(255,255,255,.85), inset 0 -8px 18px rgba(15,23,42,.06);
    display:grid;place-items:center;
    font-weight:800;font-size:18px;color:#1f2937;
