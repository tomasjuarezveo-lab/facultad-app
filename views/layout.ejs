<script>
(function () {
  const root = document.documentElement;

  function applyTheme(isDark){
  root.classList.toggle('cw-dark', isDark);

    // IMPORTANTÍSIMO: si alguna vez usaste data-cw-theme, que no quede colgado
    if (isDark) root.setAttribute('data-cw-theme', 'dark');
    else root.removeAttribute('data-cw-theme');

    // (opcional) sincroniza el switch visual del menú
    const btn = document.getElementById('cwMenuDark');
    const sw  = btn?.querySelector('.cw-switch');
    if (btn) btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
    if (sw) sw.classList.toggle('is-on', isDark);
  }

  function readStoredTheme(){
    try{
      const keys = ['theme','mode','darkmode','darkMode','cw-theme','cwTheme'];
      for (const k of keys){
        const v = localStorage.getItem(k);
        if (v == null) continue;
        const s = String(v).trim().toLowerCase();
        if (['dark','1','true','on','yes'].includes(s)) return 'dark';
        if (['light','0','false','off','no'].includes(s)) return 'light';
      }
    }catch(e){}
    return null;
  }

  function hasDarkToken(str){
    // ✅ evita falsos positivos como "markdown", "darken", etc.
    return /(^|\s)dark(\s|$)/i.test(str || '');
  }

  function computeTheme(){
    // 1) localStorage
    const stored = readStoredTheme();
    if (stored) return stored;

    // 2) atributos típicos (valores exactos)
    const attrTheme = (root.getAttribute('data-theme') || root.getAttribute('data-mode') || '').trim().toLowerCase();
    if (attrTheme === 'dark') return 'dark';
    if (attrTheme === 'light') return 'light';

    // 3) clases típicas (token exacto "dark")
    if (root.classList && root.classList.contains('dark')) return 'dark';
    if (document.body && document.body.classList && document.body.classList.contains('dark')) return 'dark';

    // fallback por si tu app usa string en className pero sin classList
    if (hasDarkToken(root.className)) return 'dark';
    if (document.body && hasDarkToken(document.body.className)) return 'dark';

    // 4) sistema
    return (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
  }

  function sync(){
    root.setAttribute('data-cw-theme', computeTheme()); // "dark" o "light"
  }

  sync();

  // observar cambios en html y body (muchos toggles cambian en body)
  const obs = new MutationObserver(sync);
  obs.observe(root, { attributes:true, attributeFilter:['class','data-theme','data-mode'] });
  if (document.body) {
    obs.observe(document.body, { attributes:true, attributeFilter:['class'] });
  }

  // cambios del sistema
  const mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
  if (mq && mq.addEventListener) mq.addEventListener('change', sync);
  else if (mq && mq.addListener) mq.addListener(sync);

  // nota: storage NO dispara en la misma pestaña, pero sirve si cambia en otra
  window.addEventListener('storage', sync);
})();
function setTheme(isDark){
  const html = document.documentElement;

  html.classList.toggle("cw-dark", isDark);

  if (isDark) html.setAttribute("data-cw-theme", "dark");
  else html.removeAttribute("data-cw-theme"); // <- CLAVE

  localStorage.setItem("cw_theme", isDark ? "dark" : "light");
}

</script>

<script>
(function(){
  if (window.__cwAccountWired) return;
  window.__cwAccountWired = true;

  const modal   = document.getElementById('cwAccountModal');
