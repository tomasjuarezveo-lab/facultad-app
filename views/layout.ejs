/* ===== Sparkle animation around subscription button ===== */
#cwSubscriptionsBtn{
  position: relative;
  overflow: visible !important;
}
@keyframes cwSparkleOrbit {
  0%   { transform: rotate(0deg)   translateX(18px) scale(0);   opacity: 0; }
  10%  { transform: rotate(36deg)  translateX(18px) scale(1);   opacity: 1; }
  70%  { transform: rotate(252deg) translateX(18px) scale(.9);  opacity: .9; }
  90%  { transform: rotate(324deg) translateX(18px) scale(.4);  opacity: .3; }
  100% { transform: rotate(360deg) translateX(18px) scale(0);   opacity: 0; }
}
@keyframes cwSparkleOrbit2 {
  0%   { transform: rotate(60deg)  translateX(16px) scale(0);   opacity: 0; }
  15%  { transform: rotate(120deg) translateX(16px) scale(1);   opacity: 1; }
  75%  { transform: rotate(300deg) translateX(16px) scale(.8);  opacity: .8; }
  92%  { transform: rotate(372deg) translateX(16px) scale(.3);  opacity: .2; }
  100% { transform: rotate(420deg) translateX(16px) scale(0);   opacity: 0; }
}
@keyframes cwSparkleOrbit3 {
  0%   { transform: rotate(130deg) translateX(20px) scale(0);   opacity: 0; }
  12%  { transform: rotate(194deg) translateX(20px) scale(1.1); opacity: 1; }
  72%  { transform: rotate(386deg) translateX(20px) scale(.85); opacity: .85;}
  91%  { transform: rotate(452deg) translateX(20px) scale(.3);  opacity: .2; }
  100% { transform: rotate(490deg) translateX(20px) scale(0);   opacity: 0; }
}
@keyframes cwSparkleOrbit4 {
  0%   { transform: rotate(200deg) translateX(15px) scale(0);   opacity: 0; }
  18%  { transform: rotate(272deg) translateX(15px) scale(.9);  opacity: .9; }
  78%  { transform: rotate(488deg) translateX(15px) scale(.7);  opacity: .7; }
  93%  { transform: rotate(556deg) translateX(15px) scale(.2);  opacity: .15;}
  100% { transform: rotate(560deg) translateX(15px) scale(0);   opacity: 0; }
}
@keyframes cwSparkleOrbit5 {
  0%   { transform: rotate(290deg) translateX(17px) scale(0);   opacity: 0; }
  20%  { transform: rotate(362deg) translateX(17px) scale(1);   opacity: 1; }
  80%  { transform: rotate(578deg) translateX(17px) scale(.75); opacity: .75;}
  94%  { transform: rotate(644deg) translateX(17px) scale(.25); opacity: .2; }
  100% { transform: rotate(650deg) translateX(17px) scale(0);   opacity: 0; }
}
@keyframes cwSparklePulse {
  0%, 100% { transform: scale(1);   }
  50%       { transform: scale(1.4); }
}

.cw-sparkle{
  position: absolute;
  top: 50%;
  left: 50%;
  width: 5px;
  height: 5px;
  margin: -2.5px 0 0 -2.5px;
  border-radius: 50%;
  background: radial-gradient(circle, #fff9c4 0%, #ffe566 55%, #ffc200 100%);
  box-shadow: 0 0 4px 2px rgba(255,220,50,.7), 0 0 8px 3px rgba(255,200,0,.35);
  pointer-events: none;
  will-change: transform, opacity;
  transform-origin: center center;
  opacity: 0;
  animation: cwSparklePulse .4s ease-in-out infinite alternate;
}
.cw-sparkle::after{
  content: '✦';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%,-50%) scale(.7);
  font-size: 6px;
  color: #fff9a0;
  line-height: 1;
}
.cw-sparkle--1 { animation: cwSparkleOrbit  2s ease-in-out forwards, cwSparklePulse .35s ease-in-out infinite alternate; }
.cw-sparkle--2 { animation: cwSparkleOrbit2 2s ease-in-out forwards, cwSparklePulse .40s ease-in-out infinite alternate; }
.cw-sparkle--3 { animation: cwSparkleOrbit3 2s ease-in-out forwards, cwSparklePulse .32s ease-in-out infinite alternate; }
.cw-sparkle--4 { animation: cwSparkleOrbit4 2s ease-in-out forwards, cwSparklePulse .45s ease-in-out infinite alternate; }
.cw-sparkle--5 { animation: cwSparkleOrbit5 2s ease-in-out forwards, cwSparklePulse .38s ease-in-out infinite alternate; }
