  const elPhone = document.getElementById('cwAccPhone');

  const elCar   = document.getElementById('cwAccCareer'); // hidden
  const elPlan  = document.getElementById('cwAccPlan');   // hidden

  const careerPick = document.getElementById('cwAccCareerPick'); // select
  const planPick   = document.getElementById('cwAccPlanPick');   // select

  const multiCareer = document.getElementById('cwAccMultiCareer');

  const hName  = document.getElementById('cwAccNameHint');
  const hEmail = document.getElementById('cwAccEmailHint');
  const hPhone = document.getElementById('cwAccPhoneHint');
  const hCar   = document.getElementById('cwAccCareerHint');
  const hPlan  = document.getElementById('cwAccPlanHint');

  const btnSave = document.getElementById('cwAccSave');

  if(!modal || !form || !btnSave || !careerPick || !planPick || !elCar || !elPlan) return;

  const settingsBtn  = document.getElementById('cwSettingsBtn');
  const settingsMenu = document.getElementById('cwSettingsMenu');

  function closeSettingsMenu(){
    if(!settingsMenu || !settingsBtn) return;
    settingsMenu.classList.remove('is-open');
    settingsMenu.setAttribute('aria-hidden','true');
    settingsBtn.setAttribute('aria-expanded','false');
  }

    const CAREERS = [
    'Lic. en Administración de Empresas',
    'Contabilidad',
    'Lic. en Economía'
  ];
  const PLANS_BY_CAREER = {
    'Lic. en Administración de Empresas': ['6','7','8'],
    'Contabilidad': ['6','7'],
    'Lic. en Economía': ['6','7']
  };

  function normalizeCareer(v){
    const s = String(v||'').trim();
    if (CAREERS.includes(s)) return s;
    if (/admin/i.test(s)) return CAREERS[0];
    if (/contab|contador/i.test(s)) return CAREERS[1];
    if (/econom/i.test(s)) return CAREERS[2];
    return CAREERS[0];
  }

  function getPlansForCareer(career){
    return (PLANS_BY_CAREER[normalizeCareer(career)] || ['6','7']).slice();
  }

  function normalizePlan(v, career){
    const allowed = getPlansForCareer(career);
    const s = String(v||'').trim();
    if (allowed.includes(s)) return s;
    const n = parseInt(s,10);
    if (!isNaN(n) && allowed.includes(String(n))) return String(n);
    return allowed[0] || '6';
  }

  function syncPlanOptions(career, preferred){
    const plans = getPlansForCareer(career);
    const selected = normalizePlan(preferred, career);
    planPick.innerHTML = plans.map(p => `<option value="${p}">Plan ${p}</option>`).join('');
    planPick.value = selected;
    elPlan.value = selected;
  }

  const uid = (document.body && (document.body.getAttribute('data-user-id') || document.body.dataset.userId)) || 'me';
  const DAY = 24 * 60 * 60 * 1000;
  const PHONE_DAY = 72 * 60 * 60 * 1000;

  function k(field){ return 'cw:acctCooldown:' + uid + ':' + field; }

  function fmt(ms){
    const s = Math.max(0, Math.floor(ms/1000));
    const h = Math.floor(s/3600);
    const m = Math.floor((s%3600)/60);
    return h + 'h ' + m + 'm';
  }

  // ✅ SOLO nombre/apellido/mail con cooldown 24h
    const FIELDS = [
    { key:'name',   el: elName,    hint: hName,  label:'nombre', cooldownMs: DAY },
    { key:'email',  el: elEmail,   hint: hEmail, label:'mail', cooldownMs: DAY },
    { key:'phone',  el: elPhone,   hint: hPhone, label:'teléfono', cooldownMs: PHONE_DAY },
    { key:'career', el: careerPick, hint: hCar,  label:'carrera', cooldownMs: DAY },
    { key:'plan',   el: planPick,   hint: hPlan, label:'plan', cooldownMs: DAY }
  ];

  const careerWrap = careerPick.closest('.cw-selectWrap');
  const planWrap   = planPick.closest('.cw-selectWrap');

  function applyLocks(){
    const now = Date.now();

    FIELDS.forEach(f=>{
      const ts = parseInt((localStorage.getItem(k(f.key)) || '0'), 10) || 0;
      const rem = ts ? ((f.cooldownMs || DAY) - (now - ts)) : 0;
      const locked = rem > 0;

      f.el.dataset.locked = locked ? '1' : '0';
      f.el.disabled = locked;

      if (f.hint){
        f.hint.textContent = locked ? ('Podés volver a cambiar ' + f.label + ' en ' + fmt(rem) + '.') : '';
      }
    });
  }

  // ✅ Gate: carrera/plan bloqueados salvo checkbox
    function applyCareerPlanGate(){
    const allowed = !!(multiCareer && multiCareer.checked);
    const currentCareer = normalizeCareer(elCar.value || careerPick.value);

    if(!allowed){
      careerPick.value = currentCareer;
      syncPlanOptions(currentCareer, elPlan.value);
    } else {
      careerPick.value = normalizeCareer(careerPick.value || currentCareer);
      syncPlanOptions(careerPick.value, elPlan.value || planPick.value);
    }

    careerPick.disabled = !allowed;
    planPick.disabled   = !allowed;

    if (careerWrap) careerWrap.classList.toggle('is-locked', !allowed);
    if (planWrap)   planWrap.classList.toggle('is-locked', !allowed);

    if (hCar){
      hCar.textContent = !allowed
        ? 'Bloqueado.'
        : '';
    }
    if (hPlan){
      hPlan.textContent = !allowed
        ? 'Bloqueado.'
        : '';
    }
  }

  // Mantener hidden actualizado (solo cuando está habilitado)
    careerPick.addEventListener('change', ()=>{
    if (careerPick.disabled) return;
    elCar.value = normalizeCareer(careerPick.value);
    syncPlanOptions(elCar.value, planPick.value);
  });
  planPick.addEventListener('change', ()=>{
    if (planPick.disabled) return;
    elPlan.value = normalizePlan(planPick.value, elCar.value || careerPick.value);
    planPick.value = elPlan.value;
  });

  if (multiCareer){
    multiCareer.addEventListener('change', ()=>{
      applyCareerPlanGate();
      // si habilita, sincronizamos selects desde hidden al inicio
      if (multiCareer.checked){
        careerPick.value = normalizeCareer(elCar.value);
        syncPlanOptions(careerPick.value, elPlan.value);
      }
    });
  }

  let lastFocus = null;
  let initial = {};

  function openModal(){
    lastFocus = document.activeElement;
    modal.setAttribute('aria-hidden','false');
    document.documentElement.style.overflow = 'hidden';
    if(status) status.textContent = '';

    // Normaliza valores actuales
    // Normaliza valores actuales
    elCar.value  = normalizeCareer(elCar.value);
    elPlan.value = normalizePlan(elPlan.value, elCar.value);

    careerPick.value = elCar.value;
    syncPlanOptions(careerPick.value, elPlan.value);

    if (multiCareer) multiCareer.checked = false; // ✅ siempre arranca bloqueado

    initial = {
      name:  (elName.value  || '').trim(),
      email: (elEmail.value || '').trim(),
      phone: (elPhone.value || '').trim(),
      career: (elCar.value || '').trim(),
      plan:   String(elPlan.value || '').trim()
    };

    applyLocks();
    applyCareerPlanGate();

    elName && elName.focus();
  }

  function closeModal(){
    modal.setAttribute('aria-hidden','true');
    document.documentElement.style.overflow = '';
    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
  }

  async function save(){
    if(status) status.textContent = '';

        const cur = {
      name:  (elName.value  || '').trim(),
      email: (elEmail.value || '').trim(),
      phone: (elPhone.value || '').trim(),
      career: normalizeCareer(elCar.value),
      plan:   normalizePlan(elPlan.value, elCar.value)
    };

    // Si NO habilitó “2 carreras”, no permitimos cambios en carrera/plan
    if (!(multiCareer && multiCareer.checked)){
      cur.career = initial.career;
      cur.plan   = initial.plan;
      elCar.value  = initial.career;
      elPlan.value = initial.plan;
    }

    const changed = [];
    Object.keys(cur).forEach(key=>{
      if ((cur[key] || '') !== (initial[key] || '')) changed.push(key);
    });

    if (!changed.length){
      if(status) status.textContent = 'No hay cambios para guardar.';
      return;
    }

    // ✅ Bloqueo 24h SOLO para nombre/apellido/mail
    for (const key of changed){
      const f = FIELDS.find(x=>x.key===key);
      if (f && f.el && f.el.dataset.locked === '1'){
        if(status) status.textContent = 'Ese campo está bloqueado por 24h. Esperá y probá de nuevo.';
        return;
      }
    }

    btnSave.disabled = true;
    btnSave.textContent = 'guardando...';

    try{
      const res = await fetch('/app/account/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
            body: JSON.stringify({
          name: cur.name,
          email: cur.email,
          phone: cur.phone,
          career: cur.career,
          plan: parseInt(cur.plan,10)
        })
      });

      let data = null;
      try{ data = await res.json(); }catch(_){ data = null; }

      if (!res.ok || !(data && data.ok)){
        if(status) status.textContent = (data && data.error) ? data.error : ('No se pudo guardar (HTTP ' + res.status + ').');
        return;
      }

      // Guardar cooldown local para reflejar el bloqueo de backend
      const now = Date.now();
      changed.forEach(key=>{
          if (key === 'name' || key === 'email' || key === 'phone' || key === 'career' || key === 'plan'){
            try{ localStorage.setItem(k(key), String(now)); }catch(_){}
          }
      });

      if(status) status.textContent = 'Cambios guardados.';
      applyLocks();

      setTimeout(()=>{ location.reload(); }, 650);
    }catch(_){
      if(status) status.textContent = 'Error de red al guardar.';
    }finally{
      btnSave.disabled = false;
      btnSave.textContent = 'guardar cambios';
    }
  }

  // ✅ Abrir desde el ítem real del menú (data-cw-open="account")
  // ✅ Abrir desde el ítem real del menú (data-cw-open="account")
  document.addEventListener('click', function(e){
    const a = e.target && e.target.closest ? e.target.closest('#cwSettingsMenu [data-cw-open="account"]') : null;
    if(!a) return;

    if (window.__CW_IS_GUEST) {
      e.preventDefault();
      e.stopPropagation();
      closeSettingsMenu();
      if (typeof window.cwGuestGate === 'function') {
        window.cwGuestGate('Configuración');
      }
      return;
    }

    e.preventDefault();
    e.stopPropagation();
    closeSettingsMenu();
    openModal();
  }, true);

  // Cerrar modal (backdrop o X con data-close="1")
  modal.addEventListener('click', (e)=>{
    const hit = e.target && (e.target.closest ? e.target.closest('[data-close="1"]') : null);
    if(hit) closeModal();
  });

  document.addEventListener('keydown', (e)=>{
    if(e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false'){
      closeModal();
    }
  });

  btnSave.addEventListener('click', save);
})();
</script>
