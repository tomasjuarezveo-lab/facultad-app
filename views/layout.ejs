}
  /* =========================
    DARK MODE (por clase cw-dark)
    ========================= */
  html.cw-dark{
    --ink:#E5E7EB; --muted:#9CA3AF;
    --glass-1:rgba(17,24,39,.72); --glass-2:rgba(17,24,39,.55);
    --stroke:rgba(255,255,255,.10);
  }
  html.cw-dark .bg-hatch-ios{
    background-color:#0b1220;
    background-image:
      radial-gradient(1200px 900px at 18% 10%, rgba(255,255,255,.08) 0%, rgba(255,255,255,0) 65%),
      radial-gradient(900px 700px at 88% 20%, rgba(59,130,246,.10) 0%, rgba(255,255,255,0) 70%),
      linear-gradient(180deg,#0b1220 0%,#0a1020 55%,#070b14 100%);
  }
  html.cw-dark .ios-dock,
  html.cw-dark .user-badge-fixed,
  html.cw-dark .help-badge-fixed,
