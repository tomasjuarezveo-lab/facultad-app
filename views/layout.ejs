  <!-- Expansión táctil del badge (perfil abajo-izquierda) -->
<!-- PERFIL DRAWER: abrir/cerrar + reloj + segmented -->
<script>
(function(){
  const badge    = document.getElementById('userBadge');
  const drawer   = document.getElementById('profileDrawer');
  const backdrop = document.getElementById('pdBackdrop');
  const panel    = document.getElementById('pdPanel');

  if(!drawer || !backdrop || !panel) return;

  const settingsBtn  = document.getElementById('cwSettingsBtn');
  const settingsMenu = document.getElementById('cwSettingsMenu');

  // Link "Perfil" del menú arriba-der (NO cambiamos HTML ni IDs)
  const menuProfileLink =
    document.querySelector('#cwSettingsMenu a.cw-menu__item[href="/app/perfil"]') ||
    Array.from(document.querySelectorAll('#cwSettingsMenu a.cw-menu__item'))
      .find(a => (a.getAttribute('href') || '').replace(/\/+$/,'') === '/app/perfil');

  let prevOverflow = '';

  function closeSettingsMenu(){
    if(!settingsMenu || !settingsBtn) return;
    settingsMenu.classList.remove('is-open');
    settingsMenu.setAttribute('aria-hidden','true');
    settingsBtn.setAttribute('aria-expanded','false');
  }

  function openDrawer(){
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden','false');
    prevOverflow = document.documentElement.style.overflow;
    document.documentElement.style.overflow = 'hidden';
  }

  function closeDrawer(){
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden','true');
    document.documentElement.style.overflow = prevOverflow || '';
  }

  const pdCloseBtn = document.getElementById('pdCloseBtn');
  if(pdCloseBtn){
    pdCloseBtn.addEventListener('click', (e)=>{
      e.preventDefault();
      e.stopPropagation();
      closeDrawer();
    });
  }

  // ✅ 1) Abajo-izq: NO abre el drawer nunca
  if(badge){
    badge.addEventListener('click', (e)=>{
      e.preventDefault();
      e.stopPropagation();
      // no hace nada
    });
  }

  // ✅ 2) Arriba-der: "Perfil" => abre drawer (y NO navega)
  if(menuProfileLink){
    menuProfileLink.addEventListener('click', (e)=>{
      e.preventDefault();
      e.stopPropagation();
      closeSettingsMenu();
      openDrawer();
    });
  }

  // Cerrar
  backdrop.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeDrawer(); });

  // Reloj
  const timeEl = document.getElementById('pdTime');
  function tick(){
    if(!timeEl) return;
    const now = new Date();
    timeEl.textContent = now.toLocaleTimeString('es-AR', {hour:'2-digit',minute:'2-digit',hour12:false});
  }
  tick();
  setInterval(tick, 1000);

  // Segmented (Info/Datos) + thumb
  const seg = document.getElementById('pdSeg');
  const thumb = document.getElementById('pdThumb');
  const buttons = seg ? Array.from(seg.querySelectorAll('.pd-segbtn')) : [];
  const views = Array.from(drawer.querySelectorAll('[data-pd-view]'));

  function setView(name){
    buttons.forEach(b=>{
      const active = (b.getAttribute('data-view') === name);
      b.setAttribute('data-active', active ? 'true' : 'false');
    });
    views.forEach(v=>{
      v.style.display = (v.getAttribute('data-pd-view') === name) ? '' : 'none';
    });

    if(thumb && seg){
      const activeBtn = buttons.find(b=>b.getAttribute('data-view')===name) || buttons[0];
      if(activeBtn){
        const rSeg = seg.getBoundingClientRect();
        const rBtn = activeBtn.getBoundingClientRect();
        thumb.style.left  = (rBtn.left - rSeg.left) + 'px';
        thumb.style.width = rBtn.width + 'px';
      }
    }
  }

  buttons.forEach(btn=>{
    btn.addEventListener('click', ()=> setView(btn.getAttribute('data-view') || 'info'));
  });

  // estado inicial
  setTimeout(()=> setView('info'), 0);

  window.addEventListener('resize', ()=>{
    const active = buttons.find(b=>b.getAttribute('data-active')==='true')?.getAttribute('data-view') || 'info';
    setView(active);
  });
})();
</script>

<script>
(function(){
  const box = document.getElementById('pdAgendaMini');
  if(!box) return;

  const drawer = document.getElementById('profileDrawer');

    // Fuente: DB (Turso) vía API del perfil
  let __pdAgendaRaw = '';
  let __pdAgendaFetching = false;
  let __pdAgendaLastFetch = 0;

  async function __pdAgendaFetch(force){
    const now = Date.now();
    if (!force && __pdAgendaFetching) return;
    if (!force && (now - __pdAgendaLastFetch) < 5000) return;

    __pdAgendaFetching = true;
    __pdAgendaLastFetch = now;

    try{
      const res = await fetch('/app/perfil/api/agenda', { credentials:'same-origin' });
      const j = await res.json().catch(()=>null);
      if (res.ok && j && j.ok && Array.isArray(j.events)){
        __pdAgendaRaw = JSON.stringify(j.events);
      }
    }catch(_){}
    finally{
      __pdAgendaFetching = false;
    }
  }

  function pfPad2(n){ return String(n).padStart(2,'0'); }
  function pfYMD(d){
    const dt = (d instanceof Date) ? d : new Date(d);
    return dt.getFullYear() + '-' + pfPad2(dt.getMonth()+1) + '-' + pfPad2(dt.getDate());
  }

  function readRaw(){ return __pdAgendaRaw || ''; }

  function parseEvents(raw){
    if(!raw) return [];
    try{
      const arr = JSON.parse(raw);
      if(Array.isArray(arr)) return arr.filter(Boolean);
    }catch(_){}
    return [];
  }

  function normEvent(e, i){
    const id = String(e.id || e._id || ('e_' + i));
    const title = String(e.title || '').trim();
    const text = String(e.text || '').trim();
    const color = String(e.color || '#22c55e').trim() || '#22c55e';
    const from = String(e.from || '').slice(0,10);
    const to = String(e.to || '').slice(0,10);
    const important = !!e.important;

    const safeFrom = /^\d{4}-\d{2}-\d{2}$/.test(from) ? from : '';
    const safeTo   = /^\d{4}-\d{2}-\d{2}$/.test(to) ? to : safeFrom;

    return { id, title, text, color, from: safeFrom, to: safeTo, important };
  }

  function getTopEventForDay(ymd, events){
    const day = String(ymd||'');
    const list = (events || []).filter(e => {
      const from = String(e.from||'');
      const to = String(e.to||'');
      if (!from || !to) return false;
      return (from <= day && day <= to);
    });

    if (!list.length) return null;

    list.sort((a,b) => {
      const ai = a.important ? 1 : 0;
      const bi = b.important ? 1 : 0;
      if (ai !== bi) return bi - ai;
      const c1 = String(a.from||'').localeCompare(String(b.from||''));
      if (c1 !== 0) return c1;
      return String(a.title||'').localeCompare(String(b.title||''));
    });

    return list[0];
  }

  function getAllEventsForDay(ymd, events){
    const day = String(ymd||'');
    const list = (events || []).filter(e => {
      const from = String(e.from||'');
      const to = String(e.to||'');
      if (!from || !to) return false;
      return (from <= day && day <= to);
    });
    list.sort((a,b) => {
      const ai = a.important ? 1 : 0;
      const bi = b.important ? 1 : 0;
      if (ai !== bi) return bi - ai;
      const c1 = String(a.from||'').localeCompare(String(b.from||''));
      if (c1 !== 0) return c1;
      return String(a.title||'').localeCompare(String(b.title||''));
    });
    return list;
  }

  // Cursor del calendario (mes actual)
  let cursor = new Date();
  cursor.setDate(1);

  // Bloqueo clicks SOLO para celdas (pero NO para flechas)
  if(!box.__ro){
    box.__ro = true;

    box.addEventListener('click', (e)=>{
      if (e.target.closest('.pf-agendaNav')) return; // deja pasar flechas
      e.preventDefault();
      e.stopPropagation();
    }, true);

    box.addEventListener('pointerdown', (e)=>{
      if (e.target.closest('.pf-agendaNav')) return; // deja pasar flechas
      e.preventDefault();
      e.stopPropagation();
    }, true);

    // Flechas: delegación de eventos
    box.addEventListener('click', (e)=>{
      const prev = e.target.closest('.pf-agendaPrev');
      const next = e.target.closest('.pf-agendaNext');
      if (!prev && !next) return;

      e.preventDefault();
      e.stopPropagation();

      const delta = prev ? -1 : 1;
      cursor.setMonth(cursor.getMonth() + delta);
      cursor.setDate(1);
      render(true);
    }, false);
  }

  let lastRaw = null;
  let lastView = '';

  function render(force){
    const y = cursor.getFullYear();
    const m = cursor.getMonth();
    const viewKey = y + '-' + (m+1);

    const raw = readRaw();
    if(!force && raw === lastRaw && viewKey === lastView) return;

    lastRaw = raw;
    lastView = viewKey;

    const events = parseEvents(raw).map(normEvent).filter(e => e.from && e.to);

    let monthLabel = '';
    try{
      monthLabel = cursor.toLocaleDateString('es-AR', { month:'long', year:'numeric' });
    }catch(_){
      monthLabel = `${y}-${pfPad2(m+1)}`;
    }

    const first = new Date(y, m, 1);
    const daysInMonth = new Date(y, m+1, 0).getDate();
    const startIndex = (first.getDay() + 6) % 7; // lun=0 ... dom=6

    let cells = '';
    for (let i=0;i<42;i++){
      const dayNum = i - startIndex + 1;

      if (dayNum < 1 || dayNum > daysInMonth){
        cells += `<div class="pf-agendaCell is-empty" aria-hidden="true"></div>`;
        continue;
      }

      const dt = new Date(y, m, dayNum);
      const ymd = pfYMD(dt);

      const allEvs = getAllEventsForDay(ymd, events);
      const ev = allEvs[0] || null;
      const has = !!ev;
      const imp = !!(ev && ev.important);
      const col = (ev && ev.color) ? String(ev.color) : '#22c55e';
      const evCount = allEvs.length;

      let multiStyle = '';
      let badgeHtml = '';
      let isMulti = false;
      if (evCount >= 2) {
        isMulti = true;
        const getCol = (e) => {
          const c = (e.color ? String(e.color) : '#22c55e');
          if (e.isGlobal) return c;
          return `color-mix(in srgb, ${c} 18%, #fff)`;
        };
        const colors = allEvs.slice(0, 4).map(getCol);
        let grad = '';
        if (evCount === 2) {
          grad = `linear-gradient(135deg, ${colors[0]} 50%, ${colors[1]} 50%)`;
        } else if (evCount === 3) {
          grad = `linear-gradient(135deg, ${colors[0]} 33.3%, ${colors[1]} 33.3% 66.6%, ${colors[2]} 66.6%)`;
        } else {
          grad = `linear-gradient(135deg, ${colors[0]} 25%, ${colors[1]} 25% 50%, ${colors[2]} 50% 75%, ${colors[3]} 75%)`;
        }
        multiStyle = `--pf-multi-bg:${grad};`;
        badgeHtml = `<span class="pd-agendaBadge">${evCount > 9 ? '9+' : evCount}</span>`;
      }

      cells += `
        <div
          class="pf-agendaCell ${has ? 'has-note' : ''} ${isMulti ? 'has-multi' : ''} ${imp ? 'is-important' : ''}"
          data-date="${ymd}"
          style="--pf-note:${col};${multiStyle}"
          aria-label="${ymd}"
        >
          ${badgeHtml}
          <div class="pf-agendaDay">${dayNum}</div>
        </div>
      `;
    }

    box.innerHTML = `
      <div class="pf-agendaWrap" aria-label="agenda">
        <div class="pf-agendaHeader">
          <button class="pf-agendaNav pf-agendaPrev" type="button" aria-label="Mes anterior">‹</button>
          <div class="pf-agendaMonth">${monthLabel}</div>
          <button class="pf-agendaNav pf-agendaNext" type="button" aria-label="Mes siguiente">›</button>
        </div>

        <div class="pf-agendaDow" aria-hidden="true">
          <div>Lun</div><div>Mar</div><div>Mié</div><div>Jue</div><div>Vie</div><div>Sáb</div><div>Dom</div>
        </div>

        <div class="pf-agendaGrid" aria-label="Calendario">${cells}</div>
      </div>
    `;
  }

  function isOpen(){
    return !!(drawer && drawer.classList.contains('is-open'));
  }

  let t = 0;

    function start(){
    __pdAgendaFetch(true).then(()=>{ render(true); });
    if(t) return;
    t = setInterval(function(){
      if(!isOpen()){
        stop();
        return;
      }
      __pdAgendaFetch(false).then(()=>{ render(false); });
    }, 2500);
  }

  function stop(){
    if(t){
      clearInterval(t);
      t = 0;
    }
  }

  if(drawer && !drawer.__pdAgendaObs){
    drawer.__pdAgendaObs = true;
    const obs = new MutationObserver(function(){
      if(isOpen()) start();
      else stop();
    });
    obs.observe(drawer, { attributes:true, attributeFilter:['class'] });
  }

  __pdAgendaFetch(true).then(()=>render(true));
})();
</script>

  <!-- Notificaciones: abrir/cerrar panel + render de items -->
  <script>
    (function(){
      const btn = document.getElementById('btnNotifications');
      const panel = document.getElementById('notifPanel');
      const overlay = document.getElementById('notifOverlay');
      const closeBtn = document.getElementById('notifClose');
      const list = document.getElementById('notifList');
      const role = (document.body.dataset.userRole || '').toLowerCase();
      const isAdmin = role === 'admin';

      async function loadFromServer(){
        try{
          const res = await fetch('/app/notifications?limit=50', { credentials: 'same-origin' });
          const data = await res.json();
          const items = Array.isArray(data.items) ? data.items : [];
          render(items);
        }catch(e){
          console.error('No se pudo cargar notificaciones', e);
        }
      }

      function render(items){
        if (!list) return;
        if (!items.length){
          list.innerHTML = `<div class="notif-empty">No hay notificaciones</div>`;
          return;
        }
        function escapeHtml(s){
          return String(s||'')
            .replaceAll('&','&amp;')
            .replaceAll('<','&lt;')
            .replaceAll('>','&gt;')
            .replaceAll('"','&quot;')
            .replaceAll("'",'&#039;');
        }
        list.innerHTML = items.map(n => {
          const b = escapeHtml(n.body||'');
          return `
            <div class="notif-card" data-id="${n.id}" data-title="Notificación" data-body="${b}">
              <div class="topbar__actions" style="display:flex; align-items:center; gap:8px; max-width:100%; height:auto;">
                <h4>Notificación</h4>
                ${isAdmin ? '<button class="notif-del btn-ios" title="Eliminar" aria-label="Eliminar">✕</button>' : ''}
              </div>
              <p>${b}</p>
            </div>`;
        }).join('');

        if (isAdmin){
          const dels = Array.from(list.querySelectorAll('.notif-del'));
          dels.forEach(delBtn=>{
            delBtn.addEventListener('click', async (e)=>{
              e.stopPropagation();
              const card = delBtn.closest('.notif-card');
              const id = card && card.dataset.id;
              if (!id) return;
              if (!confirm('¿Eliminar esta notificación para todos?')) return;
              try{
                const res = await fetch(`/app/notifications/${id}`, { method: 'DELETE', credentials: 'same-origin' });
                const data = await res.json().catch(()=>null);
                if (res.ok && data && data.ok){
                  card.remove();
                  if (!list.querySelector('.notif-card')){
                    list.innerHTML = `<div class="notif-empty">No hay notificaciones</div>`;
                  }
                } else {
                  alert((data && data.error) || 'No se pudo eliminar');
                }
              }catch(err){
                alert('Error de red al eliminar');
              }
            });
          });
        }
      }

      function openPanel(){
        overlay.classList.add('is-open');
        panel.classList.add('is-open');
        panel.setAttribute('aria-hidden','false');
        loadFromServer();
      }
      function closePanel(){
        overlay.classList.remove('is-open');
        panel.classList.remove('is-open');
        panel.setAttribute('aria-hidden','true');
      }

      window.__closeNotifPanel = closePanel;

      if (btn && !btn._wired){ btn._wired = true; btn.addEventListener('click', openPanel); }
      if (closeBtn && !closeBtn._wired){ closeBtn._wired = true; closeBtn.addEventListener('click', closePanel); }
      if (overlay && !overlay._wired){ overlay._wired = true; overlay.addEventListener('click', closePanel); }
    })();

  // ── Chatbot ──────────────────────────────────────────────────────────
  (function(){
    const btnOpen    = document.getElementById('btnChatbot');
    const panel      = document.getElementById('chatbotPanel');
    const overlay    = document.getElementById('chatbotOverlay');
    const closeBtn   = document.getElementById('chatbotClose');
    const messagesEl = document.getElementById('chatbotMessages');
    const backBtn    = document.getElementById('cbBackBtn');

    if (!btnOpen || !panel) return;

    let kb = [];
    let currentCat = null;

    function esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    function appendBubble(text, side){
      const div = document.createElement('div');
      div.className = 'cb-bubble ' + (side === 'user' ? 'cb-user' : 'cb-bot');
      div.innerHTML = esc(text).replace(/\n/g,'<br>');
      messagesEl.appendChild(div);
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function appendOptions(items, isPrimary){
      const wrap = document.createElement('div');
      wrap.className = 'cb-options';
      items.forEach(item => {
        const btn = document.createElement('button');
        btn.className = 'cb-opt-btn' + (isPrimary ? ' cb-opt-primary' : '');
        btn.type = 'button';
        btn.textContent = item.label;
        btn.addEventListener('click', () => item.onClick());
        wrap.appendChild(btn);
      });
      messagesEl.appendChild(wrap);
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function showBack(v){ v ? backBtn.classList.add('visible') : backBtn.classList.remove('visible'); }

    function showWelcome(){
      currentCat = null;
      messagesEl.innerHTML = '';
      showBack(false);
      if (!kb.length){
        messagesEl.innerHTML = `<div class="chatbot-empty">
          <svg viewBox="0 0 24 24" width="40" height="40" fill="none"><path fill="#e2e8f0" d="M23.54,14.04c1.27,1.63-0.32,3.35-1.94,4.1c-0.87,0.77-2.47,1.13-3.39,1.43c-2.26,0.73-4.65,1.01-7,0.72c-1.76-0.22-3.55-0.86-5.19-1.8c-1.07-0.51-2.08-1.14-2.97-1.88C1.63,15.57,0.07,14.17,0,12.48c-0.07-1.69,1.38-2.78,2.94-2.09c0.9,0.39,1.62,1.26,2.33,1.91c1.47,1.35,2.94,2.32,4.7,3.23c0.09,0.04,0.18,0.08,0.27,0.11c2.51,0.86,4.75,0.6,7.03-0.14C18.97,14.58,21.79,11.78,23.54,14.04z"/></svg>
          <p>El asistente aún no tiene contenido.<br>El administrador debe subir la base de conocimiento.</p>
        </div>`;
        return;
      }
      appendBubble('¡Hola! ¿En qué puedo ayudarte hoy?', 'bot');
      appendOptions(kb.map(cat => ({ label: cat.title, onClick: () => showCategory(cat) })), true);
    }

    function showCategory(cat){
      currentCat = cat;
      messagesEl.innerHTML = '';
      showBack(true);
      appendBubble('Seleccionaste: ' + cat.title, 'user');
      if (!cat.questions || !cat.questions.length){
        appendBubble('No hay preguntas disponibles en esta categoría.', 'bot');
        return;
      }
      appendBubble('¿Qué querés saber sobre ' + cat.title + '?', 'bot');
      appendOptions(cat.questions.map(q => ({ label: q.question, onClick: () => showAnswer(q) })), false);
    }

    function showAnswer(q){
      messagesEl.innerHTML = '';
      showBack(true);
      appendBubble(q.question, 'user');
      appendBubble(q.answer || 'Sin respuesta disponible.', 'bot');
      appendOptions([
        { label: '← Más preguntas sobre ' + currentCat.title, onClick: () => showCategory(currentCat) },
        { label: 'Menú principal', onClick: showWelcome }
      ], false);
    }

    async function loadKb(){
      try {
        const r = await fetch('/app/chatbot/kb', { credentials:'same-origin' });
        const d = await r.json();
        kb = Array.isArray(d.kb) ? d.kb : [];
      } catch(e) { kb = []; }
    }

    async function openPanel(){
      overlay.classList.add('is-open');
      panel.classList.add('is-open');
      panel.setAttribute('aria-hidden','false');
      await loadKb();
      showWelcome();
    }
    function closePanel(){
      overlay.classList.remove('is-open');
      panel.classList.remove('is-open');
      panel.setAttribute('aria-hidden','true');
    }

    if (!btnOpen._cbWired){ btnOpen._cbWired = true; btnOpen.addEventListener('click', openPanel); }
    if (!closeBtn._cbWired){ closeBtn._cbWired = true; closeBtn.addEventListener('click', closePanel); }
    if (!overlay._cbWired){ overlay._cbWired = true; overlay.addEventListener('click', closePanel); }
    if (!backBtn._cbWired){ backBtn._cbWired = true; backBtn.addEventListener('click', showWelcome); }
  })();
  // ─────────────────────────────────────────────────────────────────────

    (function(){
      const role = (document.body.dataset.userRole || '').toLowerCase();
      if (role !== 'admin') return;

      const btnCompose = document.getElementById('btnComposeNotif');
      const composeOverlay = document.getElementById('composeOverlay');
      const closeBtn = document.getElementById('composeClose');
      const sendBtn = document.getElementById('composeSend');
      const textarea = document.getElementById('composeText');
      const careerBtns = Array.from(document.querySelectorAll('.career-btn'));

      function openCompose(){
        if (!composeOverlay) return;
        composeOverlay.classList.add('is-open');
        composeOverlay.setAttribute('aria-hidden','false');
      }
      function closeCompose(){
        if (!composeOverlay) return;
        composeOverlay.classList.remove('is-open');
        composeOverlay.setAttribute('aria-hidden','true');
        if (textarea) textarea.value = '';
        careerBtns.forEach(b => b.classList.remove('active'));
        careerBtns.forEach(b => b.setAttribute('aria-pressed','false'));
      }

      careerBtns.forEach(btn=>{
        btn.setAttribute('aria-pressed', btn.classList.contains('active') ? 'true' : 'false');
        btn.addEventListener('click', ()=>{
          btn.classList.toggle('active');
          btn.setAttribute('aria-pressed', btn.classList.contains('active') ? 'true' : 'false');
        });
      });

      async function send(){
        if (!sendBtn) return;
        if (sendBtn._busy) return;
        sendBtn._busy = true;
        sendBtn.disabled = true;
        try{
          const text = (textarea && textarea.value || '').trim();
          const careers = careerBtns.filter(b => b.classList.contains('active')).map(b => b.dataset.career);
          if (!text){ alert('Escribe un mensaje.'); return; }
          if (!careers.length){ alert('Selecciona al menos una carrera.'); return; }

          const res = await fetch('/app/notifications', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ text, careers })
          });

          let data = null;
          try { data = await res.json(); } catch(_) { data = null; }

          if (res.ok && data && data.ok){
            closeCompose();
            const btnNotif = document.getElementById('btnNotifications');
            if (btnNotif) btnNotif.click();
          } else {
            alert((data && data.error) || ('Error ' + res.status));
          }
        }catch(err){
          console.error('send() error', err);
          alert('Error de red al enviar');
        }finally{
          sendBtn._busy = false;
          sendBtn.disabled = false;
        }
      }

      if (btnCompose) btnCompose.addEventListener('click', openCompose);
      if (closeBtn) closeBtn.addEventListener('click', closeCompose);
      if (composeOverlay) composeOverlay.addEventListener('click', (e)=>{ if (e.target === composeOverlay) closeCompose(); });
      if (sendBtn) sendBtn.addEventListener('click', send);
    })();
  </script>

  <!-- Modal de Notificación: creación on-demand + interacción -->
  <script>
    (function(){
      function ensureModal(){
        let overlay = document.getElementById('notifModalOverlay');
        if (overlay) return overlay;

        overlay = document.createElement('div');
        overlay.id = 'notifModalOverlay';
        overlay.className = 'notif-modal-overlay';
        overlay.setAttribute('aria-hidden','true');

        const modal = document.createElement('div');
        modal.className = 'notif-modal';
        modal.setAttribute('role','dialog');
        modal.setAttribute('aria-modal','true');
        modal.setAttribute('aria-labelledby','notifModalTitle');

        const btn = document.createElement('button');
        btn.id = 'notifModalClose';
        btn.className = 'notif-modal-close';
        btn.setAttribute('aria-label','Cerrar');
        btn.innerHTML = '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 7L17 17M17 7L7 17" stroke="#1F2937" stroke-width="1.8" stroke-linecap="round"/></svg>';

        const title = document.createElement('h3');
        title.id = 'notifModalTitle';
        title.className = 'notif-modal-title';

        const body = document.createElement('p');
        body.id = 'notifModalBody';
        body.className = 'notif-modal-body';

        modal.appendChild(btn);
        modal.appendChild(title);
        modal.appendChild(body);
        overlay.appendChild(modal);
        document.body.appendChild(overlay);

        return overlay;
      }

      const list = document.getElementById('notifList');
      if (!list) return;

      let overlay, titleEl, bodyEl, closeEl;

      function wireRefs(){
        overlay = document.getElementById('notifModalOverlay');
        titleEl = document.getElementById('notifModalTitle');
        bodyEl  = document.getElementById('notifModalBody');
        closeEl = document.getElementById('notifModalClose');

        if (!overlay.__wired){
          overlay.__wired = true;

          overlay.addEventListener('click', (e)=>{
            if (e.target === overlay) closeModal();
          });
          closeEl?.addEventListener('click', closeModal);
          window.addEventListener('keydown', (e)=>{ if (e.key === 'Escape') closeModal(); });
        }
      }

      function openModal(title, body){
        if (!document.getElementById('notifModalOverlay')) ensureModal();
        wireRefs();
        titleEl.textContent = title || 'Notificación';
        bodyEl.textContent  = body  || '';
        overlay.classList.add('is-open');
        document.documentElement.style.overflow = 'hidden';
      }
      function closeModal(){
        overlay?.classList.remove('is-open');
        document.documentElement.style.overflow = '';
      }

      list.addEventListener('click', (e)=>{
        const card = e.target.closest('.notif-card');
        if (!card) return;

        const t = card.getAttribute('data-title') || (card.querySelector('h4')?.textContent || '').trim();
        const b = card.getAttribute('data-body')  || (card.querySelector('p')?.textContent  || '').trim();

        try { window.__closeNotifPanel && window.__closeNotifPanel(); } catch(_) {}
        openModal(t, b);
      });
    })();
  </script>

  <script>
    (function(){
      try {
      if (window.CWMetricsBuffer) return;

      const TZ = 'America/Argentina/Buenos_Aires';
      const pending = new Map();
      const IDLE_FLUSH_MS = 30 * 1000;
      const BUFFER_FLUSH_THRESHOLD = 10;
      let idleTimer = null;

      function ymdNow(){
        try{
          const parts = new Intl.DateTimeFormat('en-CA', {
            timeZone: TZ,
            year: 'numeric',
            month: '2-digit',
            day: '2-digit'
          }).formatToParts(new Date());
          const map = {};
          parts.forEach((p) => { map[p.type] = p.value; });
          return `${map.year}-${map.month}-${map.day}`;
        }catch(_){
          const d = new Date();
          const m = String(d.getMonth() + 1).padStart(2, '0');
          const day = String(d.getDate()).padStart(2, '0');
          return `${d.getFullYear()}-${m}-${day}`;
        }
      }

      function slug(v, fallback){
        let s = String(v || '').trim().toLowerCase();
        try{ s = s.normalize('NFD').replace(/[\u0300-\u036f]/g, ''); }catch(_){}
        s = s.replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
        return s || (fallback || 'unknown');
      }

      function enqueue(metricKey, count){
        const key = String(metricKey || '').trim();
        if (!key) return;
        const metricDate = ymdNow();
        const compound = `${key}|${metricDate}`;
        pending.set(compound, (pending.get(compound) || 0) + Math.max(1, Number(count) || 1));
        console.log('[CWMetricsBuffer] evento agregado al buffer:', {
          metric_key: key,
          metric_date: metricDate,
          count: pending.get(compound),
          totalBufferedEvents: totalBufferedEvents(),
          totalBufferedKeys: pending.size
        });
        scheduleIdleFlush();
        if (totalBufferedEvents() >= BUFFER_FLUSH_THRESHOLD) {
          flush('threshold');
        }
      }

      function sectionFromPage(){
        const bodySection = String(document.body.getAttribute('data-section') || '').trim();
        if (bodySection) return slug(bodySection, 'other');
        const p = String(location.pathname || '').toLowerCase();
        if (p.indexOf('/app/materias/') === 0) return 'subject';
        if (p.indexOf('/app/materias') === 0) return 'materias';
        if (p.indexOf('/app/grupos') === 0) return 'grupos';
        if (p.indexOf('/app/finales') === 0) return 'finales';
        if (p.indexOf('/app/juegos') === 0) return 'juegos';
        if (p.indexOf('/app/profesores') === 0) return 'profesores';
        if (p.indexOf('/app/perfil') === 0) return 'perfil';
        if (p.indexOf('/app/autoevaluaciones') === 0) return 'autoevaluaciones';
        return 'other';
      }

      function snapshot(){
        const metrics = [];
        for (const [compound, count] of pending.entries()){
          const idx = compound.lastIndexOf('|');
          if (idx <= 0) continue;
          metrics.push({
            metric_key: compound.slice(0, idx),
            metric_date: compound.slice(idx + 1),
            count
          });
        }
        return metrics;
      }

      function totalBufferedEvents(){
        let total = 0;
        for (const count of pending.values()) total += Math.max(0, Number(count) || 0);
        return total;
      }

      function clearSent(items){
        (items || []).forEach((item) => {
          pending.delete(`${item.metric_key}|${item.metric_date}`);
        });
      }

      function scheduleIdleFlush(){
        if (idleTimer) clearTimeout(idleTimer);
        idleTimer = setTimeout(() => {
          flush('idle');
        }, IDLE_FLUSH_MS);
      }

      function markUserActivity(){
        if (!pending.size) return;
        scheduleIdleFlush();
      }

      async function flushViaFetch(payload, metrics){
        try{
          const res = await fetch('/api/analytics/track', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
              'Content-Type': 'application/json',
              'Cache-Control': 'no-cache'
            },
            body: payload,
            keepalive: true
          });

          if (!res.ok) {
            throw new Error(`HTTP ${res.status}`);
          }

          console.log('[CWMetricsBuffer] fallback fetch OK');
          clearSent(metrics);
          return true;
        } catch (err) {
          console.error('[CWMetricsBuffer] fallback fetch ERROR:', err);
          return false;
        }
      }

      function flush(reason){
        const metrics = snapshot();
        if (!metrics.length) return false;
        const payload = JSON.stringify({ metrics });
        console.log('[CWMetricsBuffer] intentando enviar métricas:', {
          reason: reason || 'manual',
          metrics
        });

        let sent = false;
        try{
          if (navigator.sendBeacon){
            const blob = new Blob([payload], { type: 'application/json' });
            sent = navigator.sendBeacon('/api/analytics/track', blob);
            console.log('[CWMetricsBuffer] resultado sendBeacon:', sent);
          }
        }catch(err){
          console.error('[CWMetricsBuffer] sendBeacon lanzó error:', err);
        }

        if (!sent) {
          console.warn('[CWMetricsBuffer] sendBeacon falló, intentando fetch inmediato');
          flushViaFetch(payload, metrics);
          return false;
        }

        if (sent) clearSent(metrics);
        return sent;
      }

      const api = {
        enqueue,
        enqueueSectionVisit(section){
          enqueue(`visit:section:${slug(section, 'other')}`);
        },
        enqueueSubjectClick(opts){
          const career = slug(opts && opts.career, 'unknown');
          const subject = slug(opts && opts.subject, 'unknown');
          enqueue(`visit:subject:${career}:${subject}`);
        },
        enqueuePdfDownload(opts){
          const career = slug(opts && opts.career, 'unknown');
          const subject = slug(opts && opts.subject, 'unknown');
          const section = slug(opts && (opts.section || opts.origin), 'unknown');
          enqueue(`pdf_down:${career}:${subject}:${section}`);
        },
        enqueueToolUse(tool){
          enqueue(`tool:${slug(tool, 'unknown')}`);
        },
        flush(reason){
          return flush(reason || 'manual');
        }
      };

      window.CWMetricsBuffer = api;

      api.enqueueSectionVisit(sectionFromPage());

      document.addEventListener('click', (e) => {
        const mat = e.target && e.target.closest ? e.target.closest('.mat-card[href^="/app/materias/"]') : null;
        if (mat) {
          api.enqueueSubjectClick({
            career: mat.getAttribute('data-metric-career'),
            subject: mat.getAttribute('data-metric-subject')
          });
        }

        const chatbotBtn = e.target && e.target.closest ? e.target.closest('#btnChatbot') : null;
        if (chatbotBtn) api.enqueueToolUse('chatbot');
      }, true);

      ['click', 'keydown', 'scroll', 'mousemove', 'touchstart'].forEach((eventName) => {
        window.addEventListener(eventName, markUserActivity, { passive: true });
      });

      window.addEventListener('pagehide', () => flush('pagehide'));
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') flush('hidden');
      });
      window.addEventListener('beforeunload', () => flush('beforeunload'));

      <% if (user && user.role === 'admin') { %>
      const debugBtn = document.createElement('button');
      debugBtn.id = 'btnForceMetricsFlush';
      debugBtn.type = 'button';
      debugBtn.textContent = 'Forzar Envío de Métricas';
      debugBtn.style.position = 'fixed';
      debugBtn.style.right = '18px';
      debugBtn.style.bottom = '18px';
      debugBtn.style.zIndex = '9999';
      debugBtn.style.padding = '10px 14px';
      debugBtn.style.borderRadius = '999px';
      debugBtn.style.border = '1px solid rgba(255,255,255,.22)';
      debugBtn.style.background = 'rgba(15,23,42,.82)';
      debugBtn.style.backdropFilter = 'blur(10px)';
      debugBtn.style.color = '#fff';
      debugBtn.style.fontSize = '12px';
      debugBtn.style.fontWeight = '700';
      debugBtn.style.boxShadow = '0 12px 28px rgba(15,23,42,.24)';
      debugBtn.addEventListener('click', () => {
        console.log('[CWMetricsBuffer] botón debug: forzando flush');
        api.flush('debug-button');
      });
      document.body.appendChild(debugBtn);
      <% } %>
      } catch (err) {
        console.error('[CWMetricsBuffer] init ERROR:', err);
      }
    })();
  </script>

  <script>
    (function(){
      const btn = document.getElementById('btnUserSuggestion');
      const overlay = document.getElementById('suggestionOverlay');
      const closeBtn = document.getElementById('suggestionClose');
      const sendBtn = document.getElementById('suggestionSend');
      const textarea = document.getElementById('suggestionText');
      const counter = document.getElementById('suggestionCounter');
      const theme = document.getElementById('suggestionTheme');
      if (!btn || !overlay || !sendBtn || !textarea || !counter || !theme) return;

      function syncCounter(){
        counter.textContent = `${String(textarea.value || '').length} / 200`;
      }

      function open(){
        overlay.classList.add('is-open');
        overlay.setAttribute('aria-hidden', 'false');
        document.documentElement.style.overflow = 'hidden';
        syncCounter();
        textarea.focus();
      }

      function close(){
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        document.documentElement.style.overflow = '';
      }

      async function send(){
        const message = String(textarea.value || '').trim().slice(0, 200);
        if (!message) {
          alert('Escribí tu sugerencia primero.');
          return;
        }
        sendBtn.disabled = true;
        try{
          const res = await fetch('/app/suggestions', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              theme: String(theme.value || 'general'),
              message
            })
          });
          const data = await res.json().catch(() => null);
          if (!res.ok || !data || !data.ok) {
            throw new Error((data && data.error) || 'No se pudo enviar la sugerencia');
          }
          textarea.value = '';
          theme.value = 'general';
          syncCounter();
          close();
        }catch(err){
          alert((err && err.message) || 'No se pudo enviar la sugerencia');
        }finally{
          sendBtn.disabled = false;
        }
      }

      btn.addEventListener('click', open);
      closeBtn && closeBtn.addEventListener('click', close);
      overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
      textarea.addEventListener('input', syncCounter);
      sendBtn.addEventListener('click', send);
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && overlay.classList.contains('is-open')) close();
      });
    })();
  </script>

  <script>
    (function(){
      const role = (document.body.dataset.userRole || '').toLowerCase();
      if (role !== 'admin') return;

      const btnStats = document.getElementById('btnAdminStats');
      const btnSuggestions = document.getElementById('btnAdminSuggestions');
      const overlay = document.getElementById('adminInsightsOverlay');
      const closeBtn = document.getElementById('adminInsightsClose');
      const titleEl = document.getElementById('adminInsightsTitle');
      const subEl = document.getElementById('adminInsightsSub');
      const bodyEl = document.getElementById('adminInsightsBody');
      if (!btnStats || !btnSuggestions || !overlay || !bodyEl) return;

      function esc(s){
        return String(s || '')
          .replaceAll('&','&amp;')
          .replaceAll('<','&lt;')
          .replaceAll('>','&gt;')
          .replaceAll('"','&quot;')
          .replaceAll("'", '&#039;');
      }

      function openPanel(title, subtitle){
        titleEl.textContent = title || 'Panel admin';
        subEl.textContent = subtitle || '';
        overlay.classList.add('is-open');
        overlay.setAttribute('aria-hidden', 'false');
        document.documentElement.style.overflow = 'hidden';
      }

      function closePanel(){
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        document.documentElement.style.overflow = '';
      }

      function renderLoading(text){
        bodyEl.innerHTML = `<div class="admin-loading">${esc(text || 'Cargando...')}</div>`;
      }

      function renderStats(summary){
        const topSections = Array.isArray(summary.topSections) ? summary.topSections : [];
        const lowSections = Array.isArray(summary.lowSections) ? summary.lowSections : [];
        const careers = Array.isArray(summary.popularSubjectsByCareer) ? summary.popularSubjectsByCareer : [];
        const toolUsage = Array.isArray(summary.toolUsage) ? summary.toolUsage : [];
        const pdf = summary.pdfDownloads || {};
        const pdfToday = Number(pdf.today && pdf.today.total || 0);
        const pdfYesterday = Number(pdf.yesterday && pdf.yesterday.total || 0);
        const delta = Number(pdf.delta || 0);
        const deltaText = delta === 0 ? 'Sin cambios vs ayer' : (delta > 0 ? `+${delta} vs ayer` : `${delta} vs ayer`);

        function renderList(items, emptyText){
          if (!items.length) return `<div class="admin-empty">${esc(emptyText)}</div>`;
          return `<div class="admin-list">` + items.map((item) => `
            <div class="admin-list-item">
              <div class="admin-list-text">
                <strong>${esc(item.label || item.subjectLabel || 'Sin dato')}</strong>
                <span>${esc(item.slug || item.subjectSlug || item.key || '')}</span>
              </div>
              <div class="admin-list-total">${Number(item.total || 0)}</div>
            </div>
          `).join('') + `</div>`;
        }

        const careersHtml = careers.length
          ? careers.map((career) => `
              <div class="admin-insights-card">
                <strong class="admin-card-title">${esc(career.careerLabel || 'Carrera')}</strong>
                ${renderList(career.items || [], 'Sin materias con uso reciente')}
              </div>
            `).join('')
          : `<div class="admin-empty">Todavía no hay visitas de materias registradas.</div>`;

        bodyEl.innerHTML = `
          <div class="admin-insights-grid">
            <div class="admin-insights-card full">
              <div class="admin-insights-kpi">
                <div class="admin-kpi">
                  <div class="admin-kpi-label">PDFs hoy</div>
                  <div class="admin-kpi-value">${pdfToday}</div>
                  <div class="admin-kpi-delta">${esc(pdf.today && pdf.today.date || '')}</div>
                </div>
                <div class="admin-kpi">
                  <div class="admin-kpi-label">PDFs ayer</div>
                  <div class="admin-kpi-value">${pdfYesterday}</div>
                  <div class="admin-kpi-delta">${esc(pdf.yesterday && pdf.yesterday.date || '')}</div>
                </div>
                <div class="admin-kpi">
                  <div class="admin-kpi-label">Variación</div>
                  <div class="admin-kpi-value">${delta > 0 ? '+' : ''}${delta}</div>
                  <div class="admin-kpi-delta">${esc(deltaText)}</div>
                </div>
              </div>
            </div>

            <div class="admin-insights-card">
              <strong class="admin-card-title">Top 5 secciones más usadas</strong>
              ${renderList(topSections, 'Sin secciones registradas')}
            </div>

            <div class="admin-insights-card">
              <strong class="admin-card-title">Top 5 secciones menos usadas</strong>
              ${renderList(lowSections, 'Sin secciones registradas')}
            </div>

            <div class="admin-insights-card full">
              <strong class="admin-card-title">Materias más populares por carrera</strong>
              <div class="admin-insights-grid" style="margin-top:10px;">
                ${careersHtml}
              </div>
            </div>

            <div class="admin-insights-card full">
              <strong class="admin-card-title">Herramientas más usadas</strong>
              ${renderList(toolUsage, 'Todavía no hay uso de herramientas registradas')}
            </div>
          </div>
        `;
      }

      function renderSuggestions(payload, activeTheme){
        const themes = Array.isArray(payload.themes) ? payload.themes : [];
        const items = Array.isArray(payload.items) ? payload.items : [];
        const options = ['<option value="">Todos los temas</option>']
          .concat(themes.map((theme) => `<option value="${esc(theme.value)}"${theme.value === activeTheme ? ' selected' : ''}>${esc(theme.label)} (${Number(theme.total || 0)})</option>`))
          .join('');

        bodyEl.innerHTML = `
          <div class="admin-filter-row">
            <label for="adminSuggestionsTheme" style="font-size:12px;color:#64748b;">Tema</label>
            <select id="adminSuggestionsTheme" class="admin-select">${options}</select>
          </div>
          <div class="admin-list">
            ${items.length ? items.map((item) => `
              <div class="admin-suggestion-item">
                <div class="admin-suggestion-head">
                  <span>${esc(item.themeLabel || 'General')}</span>
                  <span>${esc(item.created_at || '')}</span>
                </div>
                <div class="admin-suggestion-body">${esc(item.message || '')}</div>
              </div>
            `).join('') : `<div class="admin-empty">No hay sugerencias para este tema.</div>`}
          </div>
        `;

        const select = document.getElementById('adminSuggestionsTheme');
        if (select) {
          select.addEventListener('change', () => openSuggestions(select.value));
        }
      }

      async function openStats(){
        openPanel('Stats', 'Caché backend 1 hora · ventana analítica 30 días');
        renderLoading('Cargando estadísticas compactas...');
        try{
          const res = await fetch('/app/admin/metrics/summary', { credentials: 'same-origin' });
          const data = await res.json();
          if (!res.ok || !data || !data.ok) throw new Error((data && data.error) || 'No se pudo cargar stats');
          renderStats(data.summary || {});
        }catch(err){
          bodyEl.innerHTML = `<div class="admin-empty">${esc(err && err.message || 'No se pudo cargar stats')}</div>`;
        }
      }

      async function openSuggestions(theme){
        const activeTheme = String(theme || '').trim();
        openPanel('Sugerencias', 'Lista corta desde user_suggestions');
        renderLoading('Cargando sugerencias...');
        try{
          const url = '/app/admin/suggestions' + (activeTheme ? ('?theme=' + encodeURIComponent(activeTheme)) : '');
          const res = await fetch(url, { credentials: 'same-origin' });
          const data = await res.json();
          if (!res.ok || !data || !data.ok) throw new Error((data && data.error) || 'No se pudo cargar sugerencias');
          renderSuggestions(data, activeTheme);
        }catch(err){
          bodyEl.innerHTML = `<div class="admin-empty">${esc(err && err.message || 'No se pudo cargar sugerencias')}</div>`;
        }
      }

      btnStats.addEventListener('click', openStats);
      btnSuggestions.addEventListener('click', () => openSuggestions(''));
      closeBtn && closeBtn.addEventListener('click', closePanel);
      overlay.addEventListener('click', (e) => { if (e.target === overlay) closePanel(); });
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && overlay.classList.contains('is-open')) closePanel();
      });
    })();
  </script>

  <!-- Motor mínimo para disparar tutoriales por pantalla (reutilizable) -->
  <script>
    (function () {
      if (window.__fabHelpHooked) return;
      window.__fabHelpHooked = true;

      function emit(evtName) {
        window.dispatchEvent(new CustomEvent(evtName, { bubbles: true }));
      }

      function currentScreen() {
        var p = location.pathname;
        if (p.indexOf('/app/materias') === 0) return 'materias';
        if (p.indexOf('/app/profesores') === 0) return 'profesores';
        if (p.indexOf('/app/autoevaluaciones') === 0) return 'autoevaluaciones';
        if (p.indexOf('/app/juegos') === 0) return 'juegos';
        if (p.indexOf('/app/correlativas') === 0) return 'correlativas';
        if (p.indexOf('/app/finales') === 0) return 'finales';
        if (p.indexOf('/app/grupos') === 0) return 'grupos';
        return 'other';
      }

      var fab = document.getElementById('helpFab');
      if (fab) {
        fab.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var screen = currentScreen();
          emit('open-tutorial:' + screen);
        });
      }
    })();
