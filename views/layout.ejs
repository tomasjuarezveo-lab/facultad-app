   Usuarios -> divisor blanco + "agenda"
   ========================= */

.pdv2-hr--white{
  background: rgba(255,255,255,.92) !important;
  box-shadow: 0 0 0 1px rgba(15,23,42,.06); /* para que se vea en light */
