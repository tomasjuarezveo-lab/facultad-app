    .container,.content,main{padding-left:12px!important;padding-right:12px!important;}
  }

  /* =========================
    REDUCE MOTION
    ========================= */
  @media (prefers-reduced-motion:reduce){
    .dock-tile,.dock-icon,.dock-label,.user-badge-fixed,.help-badge-fixed,
