    function setDark(on){
      document.documentElement.classList.toggle('cw-dark', !!on);
      const sw = dark ? dark.querySelector('.cw-switch') : null;
      if (sw) sw.classList.toggle('is-on', !!on);
      if (dark) dark.setAttribute('aria-pressed', on ? 'true' : 'false');
      try { localStorage.setItem(KEY, on ? '1' : '0'); } catch(_){}
    }

    (function(){
      let saved = false;
      try { saved = localStorage.getItem(KEY) === '1'; } catch(_){}
      setDark(saved);
    })();

    if (dark){
      dark.addEventListener('click', ()=>{
        const isOn = document.documentElement.classList.contains('cw-dark');
        setDark(!isOn);
      });
    }
