      <script>
  (function(){
    if (window.__cwClubPromosWired) return;
    window.__cwClubPromosWired = true;

    const modal = document.getElementById('cwClubModal');
    const shell = modal ? modal.querySelector('.cw-club__shell') : null;
    const backdrop = modal ? modal.querySelector('.cw-club__backdrop') : null;
    const closeBtns = modal ? modal.querySelectorAll('[data-close="1"]') : [];
    const cards = modal ? Array.from(modal.querySelectorAll('.cw-clubPromo')) : [];
    let lastFocus = null;

    if (!modal || !shell) return;

    function isMobileClub(){
      return window.matchMedia('(max-width: 760px)').matches;
    }

    function closeAllCards(exceptCard){
      cards.forEach((card)=>{
        if (card !== exceptCard) card.classList.remove('is-revealed');
      });
    }

    function openClub(){
      lastFocus = document.activeElement;
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden','false');
      document.documentElement.style.overflow = 'hidden';
      cards.forEach((card)=> card.classList.remove('is-revealed'));
    }

    function closeClub(){
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden','true');
      document.documentElement.style.overflow = '';
      cards.forEach((card)=> card.classList.remove('is-revealed'));
      if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
