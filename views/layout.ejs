    <script>
      (function(){
        const buddy = document.getElementById('cwBuddyBadge');
        if(!buddy) return;

        // Por si quedó algo viejo en el DOM
        const oldFloat = document.getElementById('cwBuddyFloat');
        if(oldFloat) oldFloat.remove();

        buddy.addEventListener('contextmenu', e => e.preventDefault());

        const clamp = (v,min,max)=>Math.min(max,Math.max(min,v));
        const face = buddy.querySelector('.cw-buddy-face');

        // --- Ojos siguen el puntero ---
        function updateEyes(x, y){
          if(!face || !face.isConnected) return;

          const r = face.getBoundingClientRect();
          const cx = r.left + r.width/2;
          const cy = r.top  + r.height/2;

          const nx = clamp((x - cx)/40, -1, 1);
          const ny = clamp((y - cy)/40, -1, 1);

          const px = (nx*3.2).toFixed(2) + 'px';
          const py = (ny*2.6).toFixed(2) + 'px';

          face.querySelectorAll('.cw-buddy-eye').forEach(eye=>{
            eye.style.setProperty('--dx', px);
            eye.style.setProperty('--dy', py);
          });
        }

        window.addEventListener('pointermove', (e)=>{
          updateEyes(e.clientX, e.clientY);
        }, { passive:true });

        // --- Blink + emociones (igual que antes, pero solo en la carita) ---
        function scheduleLife(f){
          if(!f || f.__life) return;
          f.__life = true;

          (function blinkLoop(){
            const t = 1800 + Math.random()*2600;
            setTimeout(()=>{
              if(f.isConnected){
                f.classList.add('is-blink');
                setTimeout(()=>f.classList.remove('is-blink'), 140);
              }
              blinkLoop();
            }, t);
          })();

          (function emoLoop(){
            const t = 3200 + Math.random()*4200;
            setTimeout(()=>{
              if(f.isConnected){
                const pick = Math.random();
                f.classList.remove('is-excited','is-surprised');

                if(pick < 0.45){
                  f.classList.add('is-excited');
                  f.style.setProperty('--my','-1px');
                  setTimeout(()=>{
                    f.classList.remove('is-excited');
                    f.style.setProperty('--my','0px');
                  }, 900);
                } else if (pick < 0.72){
                  f.classList.add('is-surprised');
                  setTimeout(()=>f.classList.remove('is-surprised'), 750);
                } else {
                  f.style.setProperty('--my','-1.6px');
                  setTimeout(()=>f.style.setProperty('--my','0px'), 650);
                }
              }
              emoLoop();
            }, t);
          })();
        }
        if(face) scheduleLife(face);

        // --- Drag REAL del badge (sin flotante, sin cuerpo) ---
        buddy.style.touchAction = 'none';

        let pid = null;
        let startX = 0, startY = 0;
        let offX = 0, offY = 0;
        let dragging = false;

        function dockBottomPadding(){
          const dockWrap = document.querySelector('.ios-dock-wrap');
          if(!dockWrap) return 8;
          const r = dockWrap.getBoundingClientRect();
          // margen extra para que no se meta encima del dock
          return Math.max(8, r.height + 18);
        }

        function setFromRect(){
          const r = buddy.getBoundingClientRect();
          buddy.style.left = r.left + 'px';
          buddy.style.top = r.top + 'px';
          buddy.style.right = 'auto';
          buddy.style.bottom = 'auto';
        }

        function clampIntoViewport(){
          const w = buddy.offsetWidth;
          const h = buddy.offsetHeight;

          const minL = 8;
          const maxL = Math.max(8, window.innerWidth - w - 8);

          const minT = 8;
          const maxT = Math.max(8, window.innerHeight - h - dockBottomPadding());

          const curL = parseFloat(buddy.style.left || '0');
          const curT = parseFloat(buddy.style.top  || '0');

          buddy.style.left = clamp(curL, minL, maxL) + 'px';
          buddy.style.top  = clamp(curT, minT, maxT) + 'px';
        }

        buddy.addEventListener('pointerdown', (e)=>{
          if(e.button != null && e.button !== 0) return;

          pid = e.pointerId;
          startX = e.clientX;
          startY = e.clientY;
          dragging = false;

          setFromRect();
          const r = buddy.getBoundingClientRect();
          offX = e.clientX - r.left;
          offY = e.clientY - r.top;

          buddy.setPointerCapture(pid);
          e.preventDefault();
        }, { passive:false });

        buddy.addEventListener('pointermove', (e)=>{
          if(pid !== e.pointerId) return;

          const dist = Math.hypot(e.clientX - startX, e.clientY - startY);
          if(dist > 6) dragging = true;

          if(!dragging) return;

          const w = buddy.offsetWidth;
          const h = buddy.offsetHeight;

          const minL = 8;
          const maxL = Math.max(8, window.innerWidth - w - 8);

          const minT = 8;
          const maxT = Math.max(8, window.innerHeight - h - dockBottomPadding());

          const left = clamp(e.clientX - offX, minL, maxL);
          const top  = clamp(e.clientY - offY, minT, maxT);

          buddy.style.left = left + 'px';
          buddy.style.top  = top  + 'px';

          updateEyes(e.clientX, e.clientY);
          e.preventDefault();
        }, { passive:false });

        buddy.addEventListener('pointerup', (e)=>{
          if(pid !== e.pointerId) return;

          buddy.releasePointerCapture(pid);
          pid = null;

          // Tap (sin drag): animación corta
          if(!dragging && face){
            face.classList.add('is-excited');
            setTimeout(()=>face.classList.remove('is-excited'), 450);
          }

          dragging = false;
        }, { passive:true });

        buddy.addEventListener('pointercancel', ()=>{
          pid = null;
          dragging = false;
        }, { passive:true });

        window.addEventListener('resize', ()=>{
          // si ya fue arrastrado (tiene left/top inline), lo re-clampeamos
          if(buddy.style.left && buddy.style.top) clampIntoViewport();
        }, { passive:true });

      })();
      </script>

      <script>
