  <script>
    (function(){
      const IS_GUEST = !!window.__CW_IS_GUEST;
      const USER_ROLE = <%- JSON.stringify((user && user.role) || '') %>;
      const CAN_USE_CONTEXT_MENU = USER_ROLE === 'admin';

      const modal = document.getElementById('cwGuestModal');
      const bg    = document.getElementById('cwGuestBg');
      const x     = document.getElementById('cwGuestX');
      const keep  = document.getElementById('cwGuestKeep');
      const title = document.getElementById('cwGuestTitle');
      const text  = document.getElementById('cwGuestText');

      function openGate(section){
        if(!modal || !title || !text) return;
        const sec = (section || 'esta sección');
        title.textContent = 'Desbloqueá ' + sec;
        text.innerHTML =
          'Para acceder a <b>' + sec + '</b> necesitás crear una cuenta gratis. ' +
          '<b>Tardás 10 segundos</b> y desbloqueás Finales, Resúmenes, Definiciones, Juegos, Grupos y Perfil.';
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden','false');
      }
      function closeGate(){
        if(!modal) return;
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden','true');
      }

      window.cwGuestGate = openGate;

      if(bg) bg.addEventListener('click', closeGate);
      if(x) x.addEventListener('click', closeGate);
      if(keep) keep.addEventListener('click', closeGate);

      // ✅ Invitado: bloquear click derecho en toda la app
      // ✅ Bloquear click derecho para todos menos admin
      if (!CAN_USE_CONTEXT_MENU) {
        document.addEventListener('contextmenu', (e) => { e.preventDefault(); }, { capture:true });
      }

      // ✅ Interceptar navegación a secciones restringidas
      const RESTRICTED = new Map([
        ['/app/perfil', 'Perfil'],
        ['/app/finales','Finales'],
        ['/app/grupos', 'Grupos']
      ]);

      document.addEventListener('click', (e) => {
        if(!IS_GUEST) return;

        const a = e.target && e.target.closest ? e.target.closest('a') : null;
        if(!a) return;

        const href = a.getAttribute('href') || '';
        if(!href || href === '#') return;

        const path = href.split('#')[0].split('?')[0];

        if (RESTRICTED.has(path)) {
          e.preventDefault();
          e.stopPropagation();
          openGate(RESTRICTED.get(path));
        }
      }, { capture:true });

      // ✅ Interceptar Configuración (modal account)
      document.addEventListener('click', (e) => {
        if(!IS_GUEST) return;
        const el = e.target && e.target.closest ? e.target.closest('[data-cw-open="account"]') : null;
        if(!el) return;
        e.preventDefault();
        e.stopPropagation();
        openGate('Configuración');
      }, { capture:true });
    })();
  </script>

  <script>
  /* ===== Sparkle animation for subscription button ===== */
  (function(){
    const btn = document.getElementById('cwSubscriptionsBtn');
    if (!btn) return;

    function spawnSparkles(){
      // Remove any previous sparkles
      btn.querySelectorAll('.cw-sparkle').forEach(s => s.remove());

      for (let i = 1; i <= 5; i++){
        const dot = document.createElement('span');
        dot.className = 'cw-sparkle cw-sparkle--' + i;
        dot.setAttribute('aria-hidden', 'true');
        btn.appendChild(dot);
        // Clean up after animation ends (2s)
        dot.addEventListener('animationend', () => {
          if (dot.parentNode) dot.parentNode.removeChild(dot);
        }, { once: true });
      }
    }

    // First burst after 2s so it's not immediate on load
    setTimeout(spawnSparkles, 2000);
    // Then every 15s
    setInterval(spawnSparkles, 15000);
  })();
  </script>

