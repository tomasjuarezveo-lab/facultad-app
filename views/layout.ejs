        transform:translateX(-50%) translateY(6px) !important;
        opacity:0 !important;
        pointer-events:none !important;
        background:transparent !important;
        border:0 !important;
        box-shadow:none !important;
        padding:0 !important;
        font-size:11px !important;
        font-weight:800 !important;
        color:var(--muted) !important;
        white-space:nowrap !important;
      }

      .dock-item:hover .dock-label,
      .dock-item:focus-within .dock-label,
      .dock-item:active .dock-label{
        opacity:1 !important;
        transform:translateX(-50%) translateY(0) !important;
      }

      .ios-dock{
        align-items:center !important;
        gap:8px !important;
      }

      .dock-item{
        position:relative !important;
        justify-content:center !important;
        gap:0 !important;
        grid-template-rows:46px !important;
        min-height:48px !important;
      }

      .dock-tile{
        margin:0 auto !important;
      }
    }

    @media (max-width: 1024px) and (orientation: landscape){
      html:not(.auth-html) .bg-hatch-ios{
        padding-bottom:calc(108px + env(safe-area-inset-bottom)) !important;
      }

      header.topbar{
        height:56px !important;
        min-height:56px !important;
        padding-top:4px !important;
        padding-bottom:4px !important;
      }

      .topbar__brand{
        max-width:28vw !important;
        height:100% !important;
        display:flex !important;
        align-items:center !important;
      }

      .topbar__logoImg{
        height:30px !important;
        max-width:min(28vw, 150px) !important;
        width:auto !important;
        object-fit:contain !important;
      }

      .topbar__actions{
        gap:4px !important;
      }

      .topbar__actions .btn-not,
      .topbar__actions .cw-topbtn,
      #cwHelpBtn,
      #btnNotifications{
        width:34px !important;
        height:34px !important;
      }

      .topbar__actions .btn-not svg,
      .topbar__actions .cw-topbtn svg,
      #cwHelpBtn svg,
      #btnNotifications svg{
        width:20px !important;
        height:20px !important;
      }

      .ios-dock-wrap{
        padding:0 10px !important;
      }

      .ios-dock{
        width:min(calc(100vw - 20px), 760px) !important;
        padding:8px 10px !important;
        border-radius:16px !important;
      }

      .dock-tile{
        width:42px !important;
        height:42px !important;
        border-radius:13px !important;
      }

      .dock-icon{
        width:20px !important;
        height:20px !important;
      }
    }
    #cwSubscriptionsBtn{
  transition: transform .15s ease !important;
}
#cwSubscriptionsBtn:hover{
  transform: scale(1.18) !important;
}
#cwSubscriptionsBtn:active{
  transform: scale(1.05) !important;
}
