<!DOCTYPE html>
<html lang="es" class="<%= hideTabbar ? 'auth-html' : '' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title><%= (typeof title !== 'undefined' ? title : 'Facultad') %></title>

  <!-- Favicon (logo en la pestaña del navegador) -->
  <link rel="icon" type="image/png" href="https://www.dropbox.com/scl/fi/biw1gltms2icv30a1w25d/CW-logo.png?rlkey=vk846pz49nke0u8706gb0q11j&st=dht0fk9g&dl=1" />

  <!-- Tu CSS principal -->
  <link rel="stylesheet" href="/public/css/app.css" />

  <!-- Tailwind (si ya lo cargas en tu build, puedes quitar esta línea) -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Fuente -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet">

  <!-- ===== Estética iOS (fondo, header, dock, badge) ===== -->
  <style>

  /* =========================
    VARIABLES + BASE
    ========================= */
  :root{
    --ink:#0f172a; --muted:#64748b;
    --glass-1:rgba(255,255,255,.65); --glass-2:rgba(255,255,255,.40);
    --stroke:rgba(255,255,255,.60);
    --shadow-strong:0 26px 46px rgba(15,23,42,.18);
    --shadow:0 12px 28px rgba(15,23,42,.10);
    --shadow-soft:0 8px 20px rgba(15,23,42,.08);
    --radius-lg:18px; --radius-md:16px;
    --badge-size:56px;

    /* Parches */
    --cwSettingsSize:30px;
    --dockLabelUp:20px;
    --dockRightShift:18px;
  }
  @media (max-width:640px){ :root{ --cwSettingsSize:28px; } }

  body{font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,"Helvetica Neue",Arial;color:var(--ink);}
  .container-main{max-width:1040px;margin:0 auto;padding:0 20px;}

  /* =========================
    FONDO iOS
    ========================= */
  .bg-hatch-ios{
    background-color:#F8FAFD;
    background-image:
      radial-gradient(1200px 900px at 18% 10%, rgba(255,255,255,.95) 0%, rgba(255,255,255,.55) 50%, rgba(255,255,255,0) 70%),
      radial-gradient(900px 700px at 88% 20%, rgba(255,255,255,.85) 0%, rgba(255,255,255,.35) 55%, rgba(255,255,255,0) 75%),
      linear-gradient(180deg,#F7FAFE 0%,#EEF5FD 55%,#E9F1FB 100%),
      repeating-linear-gradient(45deg, rgba(183,201,227,.10) 0 1px, rgba(255,255,255,0) 1px 22px),
      repeating-linear-gradient(-45deg, rgba(183,201,227,.06) 0 1px, rgba(255,255,255,0) 1px 22px);
    background-blend-mode:screen,screen,normal,normal,normal;
    background-attachment:fixed;
    min-height:100%;
  }
  /* evita que el dock tape contenido (no auth) */
  html:not(.auth-html) .bg-hatch-ios{padding-bottom:150px;}
  @media (max-width:640px){
    html:not(.auth-html) .bg-hatch-ios{padding-bottom:calc(140px + env(safe-area-inset-bottom));}
  }

  /* =========================
    HEADER / TOPBAR
    ========================= */
  header{padding:18px 0;}
  header .text-xl{font-size:28px;font-weight:600;letter-spacing:-.02em;}
  header form button{color:#94a3b8;}
  header form button:hover{text-decoration:underline;}

  .topbar__actions{display:flex;align-items:center;gap:5px;max-width:100%;}
  .topbar__logout{display:flex;align-items:center;gap:3px;max-width:100%;}
  .topbar__logoImg{height:100%;width:auto;}

  /* ===== AUTH LOGO (login / register) ===== */
  html.auth-html .auth-brand{
    position: fixed !important;
    left: 14px !important;
    top: calc(10px + env(safe-area-inset-top)) !important;
    z-index: 60 !important;
    display: block !important;
    line-height: 0 !important;
  }
  html.auth-html .auth-brand__img{
    display: block !important;
    width: auto !important;
    height: 22px !important;
    max-width: min(148px, 42vw) !important;
    object-fit: contain !important;
  }

  @media (max-width: 430px){
    html.auth-html .auth-brand__img{
      height: 18px !important;
      max-width: min(132px, 40vw) !important;
    }
  }

  /* evita salto bajo logo (wrap) */
  .topbarWrap header{flex-wrap:nowrap;gap:10px;}
  .topbarWrap header>a{flex:0 0 auto;}
  .topbar__actions{flex:0 0 auto;white-space:nowrap;}
  @media (max-width:640px){
    .topbarWrap header{height:64px;}
    .topbarWrap header>a img{height:44px!important;width:auto!important;}
  }

  /* =========================
    BOTONES iOS (genéricos)
    ========================= */
  .btn-ios{
    display:inline-grid;place-items:center;
    width:40px;height:40px;border-radius:12px;
    background:linear-gradient(145deg, rgba(255,255,255,.35), rgba(255,255,255,.18));
    border:1px solid var(--stroke);
    box-shadow:0 10px 20px rgba(15,23,42,.12), inset 0 1px 0 rgba(255,255,255,.85), inset 0 -8px 18px rgba(15,23,42,.06);
    -webkit-tap-highlight-color:transparent;
    transition:transform .15s ease, box-shadow .2s ease, opacity .2s ease, filter .18s ease;
  }
  .btn-ios:active{transform:translateY(1px) scale(.99);}
  .btn-ios svg{width:22px;height:22px;}

  .btn-not{
    display:inline-grid;place-items:center;
    width:40px;height:40px;border-radius:12px;
    background:linear-gradient(145deg, rgba(255,255,255,0), rgba(255,255,255,.18));
    border:1px solid var(--stroke);
    -webkit-tap-highlight-color:transparent;
    transition:transform .15s ease, box-shadow .2s ease, opacity .2s ease, filter .18s ease;
  }
  .btn-not:active{transform:translateY(1px) scale(.99);}
  .btn-not svg{width:31px;height:31px;}

  .btn-cerrar-notificaciones{
    display:inline-grid;place-items:center;
    width:40px;height:40px;border-radius:12px;
    background:linear-gradient(145deg, rgba(255,255,255,0), rgba(255,255,255,0));
  }
  .career-btn.active{background:rgba(37,99,235,.12);border-color:rgba(37,99,235,.35);}

  /* =========================
    NOTIFICACIONES (overlay + panel + modal)
    ========================= */
  .notif-overlay{
    position:fixed;inset:0;
    background:rgba(15,23,42,.22);
    opacity:0;pointer-events:none;
    transition:opacity .25s ease;
    z-index:1000;
  }
  .notif-overlay.is-open{opacity:1;pointer-events:auto;}

  .notif-panel{
    position:fixed;top:0;bottom:0;right:0;
    width:430px;max-width:none;height:100vh;
    background:linear-gradient(180deg, rgba(255,255,255,.92), rgba(255,255,255,.86));
    box-shadow:-12px 0 40px rgba(15,23,42,.20);
    border-left:1px solid rgba(255,255,255,.7);
    backdrop-filter:blur(24px) saturate(160%);
    -webkit-backdrop-filter:blur(24px) saturate(160%);
    transform:translateX(100%);
    transition:transform .35s cubic-bezier(.2,.8,.2,1);
    z-index:10000;
    display:grid;grid-template-rows:auto 1fr;
  }
  .notif-panel.is-open{transform:translateX(0);}

  .notif-head{
    display:flex;align-items:center;justify-content:space-between;
    padding:16px 18px;
    border-bottom:1px solid rgba(15,23,42,.06);
  }
  .notif-title{font-weight:700;font-size:16px;letter-spacing:-.01em;}
  .notif-close.btn-ios{width:34px;height:34px;border:transparent;}

  .notif-list{
    display:grid;align-content:start;justify-content:stretch;
    grid-auto-rows:min-content;
    gap:0;overflow:auto;padding:0;
  }
  .notif-card{
    border-radius:18px;
    background:linear-gradient(145deg, rgba(255,255,255,.9), rgba(255,255,255,.7));
    border:1px solid rgba(255,255,255,.7);
    box-shadow:0 12px 26px rgba(15,23,42,.10), inset 0 1px 0 rgba(255,255,255,.85);
    padding:14px 16px;margin:5px 10px;
    cursor:pointer;user-select:none;
    transition:transform .12s ease, box-shadow .18s ease, opacity .18s ease;
  }
  @media (hover:hover){
    .notif-card:hover{
      transform:translateY(-2px);
      box-shadow:0 16px 28px rgba(15,23,42,.16), inset 0 1px 0 rgba(255,255,255,.9);
    }
  }
  .notif-card:active{transform:translateY(0) scale(.98);opacity:.95;}
  .notif-card h4{
    font-weight:700;font-size:14px;margin:0 0 4px;color:var(--ink);text-align:left;
    display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;
    overflow:hidden;text-overflow:ellipsis;white-space:normal;
  }
  .notif-card p{
    margin:0;font-size:11px;color:#4b5563;text-align:left;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;
    overflow:hidden;text-overflow:ellipsis;white-space:normal;
  }
  .notif-empty{display:flex;align-items:center;justify-content:center;text-align:center;min-height:50vh;color:#94a3b8;font-weight:500;}

  .notif-modal-overlay{
    position:fixed;inset:0;
    background:rgba(15,23,42,.45);
    display:none;align-items:center;justify-content:center;
    z-index:11000;opacity:0;
    transition:opacity .18s ease;
  }
  .notif-modal-overlay.is-open{display:flex;opacity:1;}

  .notif-modal{
    width:min(92vw, 560px);
    max-height:min(80vh, 720px);
    overflow:auto;border-radius:18px;
    background:linear-gradient(180deg, rgba(255,255,255,.98), rgba(255,255,255,.94));
    border:1px solid rgba(255,255,255,.8);
    box-shadow:0 28px 56px rgba(15,23,42,.22);
    backdrop-filter:blur(18px) saturate(160%);
    -webkit-backdrop-filter:blur(18px) saturate(160%);
    padding:18px 20px 20px;
    transform:scale(.96) translateY(6px);opacity:0;
    animation:notifModalIn .18s ease forwards;
  }
  @keyframes notifModalIn{to{transform:scale(1) translateY(0);opacity:1;}}
  .notif-modal-title{margin:0 0 10px;font-weight:800;font-size:18px;letter-spacing:-.01em;color:var(--ink);}
  .notif-modal-body{margin:0;font-size:14px;line-height:1.5;color:#374151;}
  .notif-modal-close{
    position:absolute;right:12px;top:12px;
    width:34px;height:34px;border-radius:9999px;
    display:inline-grid;place-items:center;
    background:linear-gradient(145deg, rgba(255,255,255,.9), rgba(255,255,255,.7));
    border:1px solid rgba(255,255,255,.8);
    box-shadow:0 10px 20px rgba(15,23,42,.12), inset 0 1px 0 rgba(255,255,255,.85), inset 0 -8px 18px rgba(15,23,42,.06);
    cursor:pointer;
    transition:transform .12s ease, box-shadow .18s ease;
  }
  @media (hover:hover){.notif-modal-close:hover{transform:translateY(-1px);}}
  .notif-modal-close:active{transform:translateY(0) scale(.98);}

  .admin-insights-overlay{
    position:fixed;inset:0;
    background:rgba(15,23,42,.42);
    display:none;align-items:center;justify-content:center;
    z-index:11050;opacity:0;
    transition:opacity .18s ease;
  }
  .admin-insights-overlay.is-open{display:flex;opacity:1;}
  .admin-insights-modal{
    width:min(94vw, 860px);
    max-height:min(84vh, 860px);
    overflow:auto;
    border-radius:22px;
    background:linear-gradient(180deg, rgba(255,255,255,.98), rgba(255,255,255,.94));
    border:1px solid rgba(255,255,255,.82);
    box-shadow:0 28px 56px rgba(15,23,42,.22);
    backdrop-filter:blur(18px) saturate(160%);
    -webkit-backdrop-filter:blur(18px) saturate(160%);
    padding:18px 18px 20px;
    position:relative;
  }
  .admin-insights-head{
    display:flex;align-items:center;justify-content:space-between;gap:12px;
    margin-bottom:14px;
  }
  .admin-insights-title{
    margin:0;
    font-weight:800;
    font-size:18px;
    letter-spacing:-.01em;
    color:var(--ink);
  }
  .admin-insights-sub{
    margin:4px 0 0;
    font-size:12px;
    color:#64748b;
  }
  .admin-insights-close{
    width:34px;height:34px;border-radius:9999px;
    border:1px solid rgba(15,23,42,.08);
    background:linear-gradient(145deg, rgba(255,255,255,.92), rgba(255,255,255,.74));
    display:grid;place-items:center;cursor:pointer;
  }
  .admin-insights-grid{
    display:grid;
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:12px;
  }
  .admin-insights-card{
    border-radius:18px;
    background:linear-gradient(145deg, rgba(255,255,255,.92), rgba(255,255,255,.75));
    border:1px solid rgba(15,23,42,.06);
    box-shadow:0 12px 24px rgba(15,23,42,.08), inset 0 1px 0 rgba(255,255,255,.84);
    padding:14px;
  }
  .admin-card-title{
    display:block;
    font-size:14px;
    color:#0f172a;
  }
  .admin-insights-card.full{grid-column:1 / -1;}
  .admin-insights-kpi{
    display:flex;gap:10px;flex-wrap:wrap;
  }
  .admin-kpi{
    flex:1 1 160px;
    min-width:160px;
    border-radius:16px;
    padding:12px 14px;
    background:rgba(248,250,252,.9);
    border:1px solid rgba(15,23,42,.05);
  }
  .admin-kpi-label{
    font-size:11px;
    color:#64748b;
    text-transform:uppercase;
    letter-spacing:.06em;
  }
  .admin-kpi-value{
    margin-top:6px;
    font-size:28px;
    font-weight:800;
    color:#0f172a;
    letter-spacing:-.03em;
  }
  .admin-kpi-delta{
    margin-top:4px;
    font-size:12px;
    color:#475569;
  }
  .admin-list{
    display:grid;
    gap:8px;
    margin-top:10px;
  }
  .admin-list-item{
    display:flex;align-items:center;justify-content:space-between;gap:10px;
    border-radius:14px;
    padding:10px 12px;
    background:rgba(248,250,252,.88);
    border:1px solid rgba(15,23,42,.05);
  }
  .admin-list-text{
    min-width:0;
    display:flex;flex-direction:column;gap:3px;
  }
  .admin-list-text strong{
    font-size:13px;color:#0f172a;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  }
  .admin-list-text span{
    font-size:11px;color:#64748b;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  }
  .admin-list-total{
    flex:0 0 auto;
    font-weight:800;
    color:#0f172a;
    font-size:13px;
  }
  .admin-filter-row{
    display:flex;align-items:center;gap:10px;flex-wrap:wrap;
    margin-bottom:12px;
  }
  .admin-select{
    appearance:none;
    border-radius:14px;
    border:1px solid rgba(15,23,42,.08);
    background:rgba(255,255,255,.92);
    padding:10px 14px;
    font-size:13px;
    color:#0f172a;
  }
  .admin-empty{
    padding:18px;
    text-align:center;
    color:#64748b;
    font-size:13px;
  }
  .admin-loading{
    padding:26px 18px;
    text-align:center;
    color:#64748b;
    font-size:13px;
  }
  .admin-suggestion-item{
    border-radius:16px;
    padding:12px 14px;
    background:rgba(248,250,252,.9);
    border:1px solid rgba(15,23,42,.05);
    display:grid;
    gap:6px;
  }
  .admin-suggestion-head{
    display:flex;align-items:center;justify-content:space-between;gap:10px;
    font-size:11px;color:#64748b;
    text-transform:uppercase;letter-spacing:.05em;
  }
  .admin-suggestion-body{
    font-size:13px;line-height:1.5;color:#0f172a;
    white-space:pre-wrap;
    word-break:break-word;
  }
  @media (max-width: 720px){
    .admin-insights-grid{grid-template-columns:1fr;}
    .admin-insights-modal{width:min(96vw, 640px); padding:16px;}
  }

  html.cw-dark .admin-insights-modal{
    background:linear-gradient(180deg, rgba(2,6,23,.96), rgba(15,23,42,.90));
    border-color:rgba(255,255,255,.10);
    box-shadow:0 30px 70px rgba(0,0,0,.60), inset 0 1px 0 rgba(255,255,255,.06);
  }
  html.cw-dark .admin-insights-title,
  html.cw-dark .admin-kpi-value,
  html.cw-dark .admin-list-text strong,
  html.cw-dark .admin-list-total,
  html.cw-dark .admin-suggestion-body,
  html.cw-dark .admin-card-title{
    color:rgba(243,244,246,.95);
  }
  html.cw-dark .admin-insights-sub,
  html.cw-dark .admin-kpi-label,
  html.cw-dark .admin-kpi-delta,
  html.cw-dark .admin-list-text span,
  html.cw-dark .admin-empty,
  html.cw-dark .admin-loading,
  html.cw-dark .admin-suggestion-head{
    color:rgba(148,163,184,.92);
  }
  html.cw-dark .admin-insights-card,
  html.cw-dark .admin-kpi,
  html.cw-dark .admin-list-item,
  html.cw-dark .admin-suggestion-item{
    background:rgba(15,23,42,.72);
    border-color:rgba(255,255,255,.08);
    box-shadow:none;
  }
  html.cw-dark .admin-select,
  html.cw-dark .admin-insights-close{
    background:rgba(15,23,42,.84);
    border-color:rgba(255,255,255,.12);
    color:rgba(243,244,246,.95);
  }
  html.cw-dark #suggestionText{
    background:rgba(15,23,42,.84) !important;
    border-color:rgba(255,255,255,.12) !important;
    color:rgba(243,244,246,.95) !important;
  }
  html.cw-dark #suggestionText::placeholder{
    color:rgba(148,163,184,.9) !important;
  }

  /* =========================
    CHATBOT (panel derecho)
    ========================= */
  .chatbot-overlay{
    position:fixed;inset:0;
    background:rgba(15,23,42,.22);
    opacity:0;pointer-events:none;
    transition:opacity .25s ease;
    z-index:1000;
  }
  .chatbot-overlay.is-open{opacity:1;pointer-events:auto;}

  .chatbot-panel{
    position:fixed;top:0;bottom:0;right:0;
    width:400px;max-width:100vw;height:100vh;
    background:#ffffff;
    box-shadow:-10px 0 36px rgba(15,23,42,.14);
    border-left:1px solid #e5e7eb;
    transform:translateX(100%);
    transition:transform .35s cubic-bezier(.2,.8,.2,1);
    z-index:10000;
    display:flex;flex-direction:column;
    font-family:inherit;
  }
  .chatbot-panel.is-open{transform:translateX(0);}

  /* Header */
  .chatbot-head{
    display:flex;align-items:center;gap:10px;
    padding:16px 18px 14px;
    border-bottom:1px solid #f1f3f7;
    flex-shrink:0;
  }
  .chatbot-head-avatar{
    width:38px;height:38px;border-radius:50%;
    background:#0f172a;
    display:grid;place-items:center;flex-shrink:0;
  }
  .chatbot-head-info{flex:1;min-width:0;}
  .chatbot-head-name{font-weight:700;font-size:15px;color:#0f172a;letter-spacing:-.01em;}
  .chatbot-head-status{font-size:11px;color:#22c55e;font-weight:500;display:flex;align-items:center;gap:4px;}
  .chatbot-head-status::before{content:'';width:6px;height:6px;border-radius:50%;background:#22c55e;display:inline-block;}
  .chatbot-close{
    width:34px;height:34px;border-radius:50%;border:none;
    background:#f1f5f9;cursor:pointer;
    display:grid;place-items:center;
    transition:background .15s;flex-shrink:0;
  }
  .chatbot-close:hover{background:#e2e8f0;}

  /* Messages area */
  .chatbot-messages{
    flex:1;overflow-y:auto;overflow-x:hidden;
    padding:16px 14px;
    display:flex;flex-direction:column;gap:10px;
    scroll-behavior:smooth;
  }

  /* Bubble base */
  .cb-bubble{
    max-width:82%;word-break:break-word;
    font-size:13.5px;line-height:1.5;
    padding:10px 14px;border-radius:18px;
    animation:cbFadeIn .18s ease both;
  }
  @keyframes cbFadeIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:none;}}

  /* Bot bubble (left) */
  .cb-bot{
    align-self:flex-start;
    background:#f1f5f9;color:#1e293b;
    border-radius:4px 18px 18px 18px;
  }

  /* User bubble (right) */
  .cb-user{
    align-self:flex-end;
    background:#2a250f;color:#f8fafc;
    border-radius:18px 18px 4px 18px;
  }

  /* Quick reply buttons */
  .cb-options{
    display:flex;flex-wrap:wrap;gap:8px;
    align-self:flex-start;
    max-width:100%;
    animation:cbFadeIn .22s ease both;
  }
  .cb-opt-btn{
    border:1.5px solid #e2e8f0;
    background:#fff;color:#1e293b;
    border-radius:20px;
    padding:8px 14px;
    font-size:13px;font-weight:500;
    cursor:pointer;
    transition:background .15s, border-color .15s, color .15s;
    text-align:left;line-height:1.3;
  }
  .cb-opt-btn:hover{background:#f1f5f9;border-color:#cbd5e1;}
  .cb-opt-btn:active{background:#e2e8f0;}
  .cb-opt-btn.cb-opt-primary{
    background:#F8C160;color:#f8fafc;border-color:#F8C160;
  }
  .cb-opt-btn.cb-opt-primary:hover{background:#f8c0608f;border-color:#ffdc9f;}

  /* Footer */
  .chatbot-footer{
    padding:12px 14px 16px;
    border-top:1px solid #f1f3f7;
    flex-shrink:0;
    display:flex;flex-direction:column;gap:8px;
  }
  .cb-back-btn{
    background:none;border:1.5px solid #e2e8f0;
    border-radius:20px;padding:8px 16px;
    font-size:13px;font-weight:500;color:#64748b;
    cursor:pointer;align-self:flex-start;
