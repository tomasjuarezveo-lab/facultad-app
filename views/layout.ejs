  <div id="cwAccountModal" class="cw-account" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="cwAccountTitle">
    <div class="cw-account__backdrop" data-close="1"></div>

    <div class="cw-account__card" role="document">
      <button class="cw-account__close" type="button" aria-label="Cerrar" title="Cerrar" data-close="1">×</button>

      <h3 id="cwAccountTitle" class="cw-account__title">Configuración</h3>

      <form id="cwAccountForm" autocomplete="off">
        <div class="cw-account__warn">
          ⚠️ Importante: si modificás <b>nombre</b>, <b>mail</b>, <b>carrera</b> o <b>plan</b>, no vas a poder volver a cambiarlos por <b>24 horas</b>. El <b>teléfono</b> se puede editar una vez cada <b>72 horas</b>.
        </div>
        <div class="cw-account__grid">

            <!-- fila 1: nombre | apellido -->
            <!-- fila 1: nombre | mail -->
            <div class="cw-field">
              <label class="cw-account__label" for="cwAccName">nombre</label>
              <input id="cwAccName" class="cw-account__input" type="text" maxlength="11" spellcheck="false"
                value="<%= (user && user.name) ? user.name : '' %>" />
              <div id="cwAccNameHint" class="cw-account__hint"></div>
            </div>

            <div class="cw-field">
              <label class="cw-account__label" for="cwAccEmail">
                mail
                <span class="cw-lockIcon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14">
                    <path d="M7 11V8a5 5 0 0 1 10 0v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M7 11h10v9H7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  </svg>
                </span>
              </label>
              <input id="cwAccEmail" class="cw-account__input" type="email"
                value="<%= (user && user.email) ? user.email : '' %>"
                readonly disabled
                style="opacity:.65;cursor:not-allowed;pointer-events:none;" />
              <div id="cwAccEmailHint" class="cw-account__hint"></div>
            </div>

            <div class="cw-field">
              <label class="cw-account__label" for="cwAccPhone">teléfono</label>
              <input id="cwAccPhone" class="cw-account__input" type="tel" maxlength="32" inputmode="tel"
                placeholder="+54 9 11 1234-5678"
                value="<%= (user && user.phone) ? user.phone : '' %>" />
              <div id="cwAccPhoneHint" class="cw-account__hint"></div>
            </div>

            <!-- fila 2: carrera | plan + checkbox -->
            <div class="cw-field">
              <label class="cw-account__label" for="cwAccCareerPick">
                carrera
                <span class="cw-lockIcon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14">
                    <path d="M7 11V8a5 5 0 0 1 10 0v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    <path d="M7 11h10v9H7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                  </svg>
                </span>
              </label>

              <input id="cwAccCareer" type="hidden" value="<%= (user && user.career) ? user.career : '' %>" />

              <div class="cw-selectWrap is-locked">
                <select id="cwAccCareerPick" class="cw-account__select" aria-label="carrera">
                  <option value="Lic. en Administración de Empresas">Lic. en Administración</option>
                  <option value="Contabilidad">Contabilidad</option>
                  <option value="Lic. en Economía">Lic. en Economía</option>
                </select>

                <span class="cw-selectArrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="16" height="16">
                    <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>

              <div id="cwAccCareerHint" class="cw-account__hint"></div>
            </div>

            <div class="cw-planRow">
              <div class="cw-field cw-field--plan">
                <label class="cw-account__label" for="cwAccPlanPick">
                  plan
                  <span class="cw-lockIcon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14">
                      <path d="M7 11V8a5 5 0 0 1 10 0v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      <path d="M7 11h10v9H7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </label>

                <input id="cwAccPlan" type="hidden" value="<%= (user && user.plan) ? user.plan : '' %>" />

                <div class="cw-selectWrap is-locked">
                  <select id="cwAccPlanPick" class="cw-account__select" aria-label="plan">
                    <option value="6">Plan 6</option>
                    <option value="7">Plan 7</option>
                    <option value="8">Plan 8</option>
                  </select>

                  <span class="cw-selectArrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16">
                      <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>

                <div id="cwAccPlanHint" class="cw-account__hint"></div>
              </div>

              <div class="cw-field cw-field--toggle">
                <div class="cw-account__toggleRow">
                  <label class="cw-account__toggle" for="cwAccMultiCareer">
                    <input id="cwAccMultiCareer" type="checkbox" />
                    <span>Estudio 2 carreras</span>
                  </label>
                </div>
              </div>
            </div>
          </div>

        <button id="cwAccSave" class="cw-account__save" type="button">guardar cambios</button>
        <div id="cwAccStatus" class="cw-account__status" aria-live="polite"></div>
      </form>
    </div>
  </div>

