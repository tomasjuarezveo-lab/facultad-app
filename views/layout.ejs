  /* layout icono izq */
  .cw-menu__left{display:inline-flex;align-items:center;gap:10px;min-width:0;}
  .cw-menu__iconL{width:18px;height:18px;flex:0 0 18px;opacity:.95;}
  .cw-menu__iconR{width:18px;height:18px;flex:0 0 auto;opacity:.95;}

  .cw-menu__item{
    width:100%;
    display:flex;align-items:center;justify-content:flex-start;
    gap:10px;padding:10px 10px;border-radius:10px;
    font-weight:900;font-size:13px;color:var(--ink);
    text-decoration:none;
    background:transparent;border:0;box-shadow:none;
    cursor:pointer;-webkit-tap-highlight-color:transparent;
    transition:background .16s ease, filter .16s ease, color .16s ease;
  }
  /* item toggle: switch a la derecha */
  .cw-menu__item--toggle{justify-content:space-between;}
  /* SIN movimiento hover en items */
  @media (hover:hover){ .cw-menu__item:hover{background:#F1F5F9;} }
  .cw-menu__item:active{filter:brightness(.98);}

  .cw-menu__divider{height:1px;background:rgba(15,23,42,.10);margin:6px 6px;}
  .cw-menu__danger{color:#b91c1c!important;}

  .cw-switch{
    width:38px;height:22px;border-radius:9999px;padding:2px;
    display:inline-flex;align-items:center;flex:0 0 auto;
    background:rgba(148,163,184,.45);
    border:1px solid rgba(148,163,184,.55);
    transition:background .18s ease, border-color .18s ease;
  }
  .cw-switch__thumb{
    width:18px;height:18px;border-radius:9999px;background:#fff;
    box-shadow:0 6px 14px rgba(15,23,42,.14);
    transform:translateX(0);
    transition:transform .18s ease;
  }
  .cw-switch.is-on{background:rgba(34,197,94,.45);border-color:rgba(34,197,94,.55);}
  .cw-switch.is-on .cw-switch__thumb{transform:translateX(16px);}

  .cw-sr-only{
    position:absolute!important;width:1px!important;height:1px!important;
    padding:0!important;margin:-1px!important;overflow:hidden!important;
    clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important;
  }

  /* =========================
    AVATARES (sin aro) + SETTINGS más chico
    ========================= */
  .cw-avatarRing{background:transparent!important;padding:0!important;display:grid;place-items:center;border-radius:9999px;}
  .cw-avatarInner{border-radius:9999px!important;overflow:hidden!important;background:transparent!important;display:grid;place-items:center;}
  .cw-avatarImg{width:100%;height:100%;object-fit:cover;display:block;}

  /* botón settings (avatar) */
  /* botón configuración (ARRIBA DERECHA): SOLO SVG, transparente, SVG blanco */
#cwSettingsBtn{
  width:var(--cwSettingsSize)!important;
  height:var(--cwSettingsSize)!important;
  border-radius:9999px!important;
  padding:0!important;

  background:transparent!important;
  border:0!important;
  box-shadow:none!important;

  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;

  color:#ffffff!important; /* <-- hace el SVG blanco */
}
/* =========================
   FIX: Avatar TOP RIGHT (#cwSettingsBtn)
   Siempre circular + mismo tamaño
   ========================= */
#cwSettingsBtn{
  overflow: visible !important;
  aspect-ratio: 1 / 1 !important;
  position: relative !important;
}

/* Anillo giratorio alrededor del avatar */
#cwSettingsBtn::before{
  content: "" !important;
  position: absolute !important;
  inset: -3px !important;
  border-radius: 9999px !important;
  background: conic-gradient(
    #F8C160 0%,
    #FDFEFF 30%,
    #FE6017 55%,
    #F8C160 70%,
    #FDFEFF 85%,
    #FE6017 100%
  ) !important;
  z-index: -1 !important;
  animation: cwAvatarRingSpin 2.4s linear infinite !important;
  pointer-events: none !important;
}

/* Fondo blanco entre el anillo y la foto */
#cwSettingsBtn::after{
  content: "" !important;
  position: absolute !important;
  inset: -1px !important;
  border-radius: 9999px !important;
  background: #ffffff !important;
  z-index: -1 !important;
  pointer-events: none !important;
}

@keyframes cwAvatarRingSpin{
  from{ transform: rotate(0deg); }
  to{ transform: rotate(360deg); }
}

/* En dark mode el fondo del gap es oscuro */
html.cw-dark #cwSettingsBtn::after{
  background: #0b1220 !important;
}

#cwSettingsBtn .cw-avatarRing{
  width:100% !important;
  height:100% !important;
  border-radius:9999px !important;
  padding:0 !important;
  background:transparent !important;
  display:grid !important;
  place-items:center !important;
}

#cwSettingsBtn .cw-avatarInner{
  width:100% !important;
  height:100% !important;
  border-radius:9999px !important;
  overflow:hidden !important;
  background:transparent !important;
  display:grid !important;
  place-items:center !important;
}

#cwSettingsBtn .cw-avatarImg{
  width:100% !important;
  height:100% !important;
  object-fit:cover !important;
  display:block !important;
  border-radius:9999px !important;
}

/* Fallback SVG centrado (cuando no hay avatarUrl) */
