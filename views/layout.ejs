    .notif-card p{font-size:10.5px;-webkit-line-clamp:2;}

    /* Dock mobile (entra iPhone vertical) */
    .ios-dock-wrap{
      bottom:calc(10px + env(safe-area-inset-bottom));
      padding:0 8px;
    }
    .ios-dock{
      width:calc(100vw - 16px);
      display:flex;justify-content:space-between;align-items:flex-end;
      gap:6px;padding:10px;border-radius:18px;
    }
    .dock-item{
      width:auto;flex:1 1 0;min-width:0;
      grid-template-rows:46px;gap:0;
    }
    .dock-tile{width:46px;height:46px;border-radius:14px;}
    .dock-icon{width:22px;height:22px;}
    .dock-label{
      font-size:11px;
      position:absolute;
      left:50%;
      bottom:calc(46px + 14px);
      transform:translateX(-50%) translateY(6px);
      opacity:0;
