.help-badge-fixed{right:10px;bottom:calc(92px + env(safe-area-inset-bottom));height:var(--userBadgeH);min-width:var(--userBadgeW);width:var(--userBadgeW);padding:0;gap:0;border-radius:var(--userBadgeR);}
