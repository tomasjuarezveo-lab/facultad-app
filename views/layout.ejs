}

/* Si todavía existe el badge viejo de perfil (avatar+nombre), lo ocultamos */
.user-badge,
#userBadge,
#userBadgeBtn,
#profileBadge,
.user-badge-fixed.profile,
.user-badge-fixed.user{
  display:none !important;
}
/* FAILSAFE: si por error queda algún script viejo, nunca mostrar el flotante con cuerpo */
#cwBuddyFloat,
.cw-buddy-float,
.cw-buddy3d{
  display:none !important;
}
