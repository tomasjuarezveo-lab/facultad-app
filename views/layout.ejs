  }
  .cw-menu.is-open{display:block;}

  .cw-menu__profileHead{display:flex;align-items:center;gap:10px;padding:8px 10px 10px;}
  .cw-menu__profileMeta{min-width:0;display:grid;gap:2px;}
  .cw-menu__profileName{font-weight:900;font-size:13px;line-height:1.1;color:#0f172a;}
  .cw-menu__profileEmail{
