   DARK MODE — Dock más claro y prolijo
   (pegalo al final del <style>)
   ========================= */

/* (opcional pero recomendado) mejora inputs/controles nativos en dark */
html.cw-dark { color-scheme: dark; }

/* Recuadro del menú principal (la barra glass) */
html.cw-dark .ios-dock{
  /* más “frosted” y más claro */
  background:
    linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,.04)),
    rgba(17,24,39,.40);

  border-color: rgba(255,255,255,.14) !important;

  box-shadow:
