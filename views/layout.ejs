  <style id="cw-responsive-global-patch">
  /* =========================================================
     SOLO MOBILE / TABLET
     En desktop NO toca la estética original
     ========================================================= */

  @media (max-width: 1180px){
    html, body{
      max-width:100%;
      overflow-x:hidden;
    }

    body{
      -webkit-text-size-adjust:100%;
      text-size-adjust:100%;
    }

    .container-main{
      width:min(100%, 1440px) !important;
      max-width:1440px !important;
      padding-left:clamp(12px, 2.2vw, 24px) !important;
      padding-right:clamp(12px, 2.2vw, 24px) !important;
      margin-left:auto !important;
      margin-right:auto !important;
      box-sizing:border-box !important;
    }

    main,
    main > *{
      min-width:0 !important;
      max-width:100% !important;
      box-sizing:border-box !important;
    }

    img,
    svg,
    video,
    canvas,
    iframe{
      max-width:100%;
      height:auto;
    }

    .cwFinalesShell,
    .cwFinalesAdminWrap,
    .cwFinalesList,
    .correlativas-card,
    .correlativas-ui,
    .profsWrap,
    .pf-wrap,
    .games-hub,
    .game-shell,
    .game-panel,
    .grupos-page,
    .viewer-shell,
    .mat-grid,
    .ui-panel,
    .ui-leftpanel,
    .ui-rightpanel,
    .ui-secondarypanel,
    .leftcol,
    .rightcol,
    .leftcol-new,
    .rightcol-new,
    .content-bound{
      width:100% !important;
      max-width:100% !important;
      min-width:0 !important;
      box-sizing:border-box !important;
    }

    .top-tabs,
    .sub-tabs{
      left:12px !important;
      right:12px !important;
      transform:none !important;
      width:auto !important;
      max-width:none !important;
      justify-content:flex-start !important;
      overflow-x:auto !important;
      overflow-y:hidden !important;
      padding-right:14px !important;
      -ms-overflow-style:none;
      scrollbar-width:none;
    }

    .top-tabs::-webkit-scrollbar,
    .sub-tabs::-webkit-scrollbar{
      display:none;
    }

    .year-panel,
      .left-panel,
      .side-panel,
      .ui-leftpanel,
      .ui-rightpanel,
      .ui-secondarypanel,
      .rightcol,
      .rightcol-new{
        position:relative !important;
        inset:auto !important;
        top:auto !important;
        left:auto !important;
        right:auto !important;
        bottom:auto !important;
        transform:none !important;
        width:100% !important;
        max-width:100% !important;
        height:auto !important;
        margin:0 0 14px 0 !important;
      }

    .doc-list{
      flex-direction:row !important;
      flex-wrap:wrap !important;
      justify-content:flex-start !important;
      gap:10px !important;
    }

    .doc-item,
    .doc-item-icon{
      width:72px !important;
    }

    .wheel-wrap{
      max-width:min(100%, 680px) !important;
      padding-left:0 !important;
      padding-right:0 !important;
    }

    .count-wrap,
    .points-badge{
      position:relative !important;
      inset:auto !important;
      transform:none !important;
      margin:0 auto 10px auto !important;
      width:fit-content !important;
      max-width:100% !important;
    }
  }

  @media (max-width: 900px){
    .topbar{
      height:auto !important;
      min-height:64px !important;
      padding-top:6px !important;
      padding-bottom:6px !important;
      gap:10px !important;
    }

    .topbar__actions{
      gap:8px !important;
      margin-left:auto !important;
    }

    .cwFinalesTop,
    .pf-mainRow,
    .top-month,
    .row-top,
    .controls-stack,
    .game-topbar{
      display:grid !important;
      grid-template-columns:1fr !important;
    }

    .game-shell,
    .game-panel,
    .correlativas-card,
    .pf-wrap,
    .profsWrap,
    .cwFinalesShell{
      border-radius:22px !important;
    }

    /* ===== MISMA ESTÉTICA DEL GATE GLOBAL SOLO EN TABLET/CELU ===== */
    .guest-lock-card,
    .guest-pdfgate-card,
    .ggate-card,
    .guest-locked-card{
      width:min(560px, 92vw) !important;
      border-radius:28px !important;
      background:linear-gradient(180deg, rgba(255,255,255,.98), rgba(255,255,255,.94)) !important;
      border:1px solid rgba(255,255,255,.80) !important;
      box-shadow:0 28px 56px rgba(15,23,42,.22) !important;
      backdrop-filter:blur(18px) saturate(160%) !important;
      -webkit-backdrop-filter:blur(18px) saturate(160%) !important;
      padding:18px !important;
      color:#0f172a !important;
      text-align:left !important;
      box-sizing:border-box !important;
      position:relative !important;
    }

    .guest-lock-title,
    .guest-pdfgate-title,
    .ggate-title,
    .guest-locked-title{
      margin:0 !important;
      font-weight:800 !important;
      font-size:22px !important;
      line-height:1.08 !important;
      letter-spacing:-.02em !important;
      color:#0f172a !important;
    }

    .guest-lock-sub,
    .guest-pdfgate-sub,
    .ggate-sub,
    .guest-locked-sub,
    .guest-locked-foot{
      margin-top:10px !important;
      font-size:14px !important;
      line-height:1.5 !important;
      color:#374151 !important;
      font-weight:600 !important;
    }

    .guest-lock-actions,
    .guest-pdfgate-actions,
    .ggate-actions,
    .guest-locked-actions{
      display:flex !important;
      flex-wrap:wrap !important;
      gap:10px !important;
      margin-top:16px !important;
    }

    .guest-lock-btn,
    .guest-pdfgate-btn,
    .ggate-btn,
    .guest-btn{
      min-height:48px !important;
      flex:1 1 180px !important;
      border-radius:16px !important;
      display:flex !important;
      align-items:center !important;
      justify-content:center !important;
      text-align:center !important;
      padding:12px 14px !important;
      text-decoration:none !important;
      border:1px solid rgba(255,255,255,.82) !important;
      background:linear-gradient(145deg, rgba(255,255,255,.92), rgba(255,255,255,.76)) !important;
      color:#0f172a !important;
      box-shadow:0 14px 34px rgba(15,23,42,.12), inset 0 1px 0 rgba(255,255,255,.85) !important;
      font-weight:900 !important;
      user-select:none !important;
      box-sizing:border-box !important;
    }

    .guest-lock-btn--primary,
    .guest-pdfgate-btn--primary,
    .ggate-btn--primary,
    .guest-btn--primary{
      background:linear-gradient(180deg, #F8C160, #F4B24D) !important;
      color:#0f172a !important;
      border-color:rgba(244,178,77,.55) !important;
    }

    .guest-btn--ghost{
      background:transparent !important;
      border-color:rgba(15,23,42,.12) !important;
      box-shadow:none !important;
    }

    .guest-overlay,
    .guest-pdfgate-overlay,
    .ggate,
    .guest-locked-wrap{
      padding:22px 14px !important;
      backdrop-filter:blur(10px) saturate(140%) !important;
      -webkit-backdrop-filter:blur(10px) saturate(140%) !important;
    }

    .guest-pdfgate-close{
      position:absolute !important;
      top:10px !important;
      right:10px !important;
      width:36px !important;
      height:36px !important;
      border-radius:14px !important;
      border:1px solid rgba(15,23,42,.10) !important;
      background:rgba(255,255,255,.72) !important;
      box-shadow:0 10px 24px rgba(15,23,42,.10) !important;
      color:#0f172a !important;
    }

    html.cw-dark .guest-lock-card,
    html.cw-dark .guest-pdfgate-card,
    html.cw-dark .ggate-card,
    html.cw-dark .guest-locked-card{
      background:linear-gradient(180deg, rgba(19,24,33,.98), rgba(19,24,33,.94)) !important;
      border-color:rgba(255,255,255,.08) !important;
      box-shadow:0 28px 56px rgba(0,0,0,.45) !important;
