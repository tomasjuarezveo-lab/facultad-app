/* =========================
   FIX: que el nombre se lea completo (sin ellipsis)
   ========================= */

/* Mobile / touch: permitir 2 líneas y no cortar */
@media (hover:none){
  .dock-label{
    max-width:92px;              /* ajustá 84–110 según tu dock */
    white-space:normal !important;
    overflow:visible !important;
    text-overflow:clip !important;
    line-height:1.1;
    text-align:center;

    display:-webkit-box;
    -webkit-line-clamp:2;        /* hasta 2 líneas */
    -webkit-box-orient:vertical;
  }
}

/* Desktop (tooltip): que no se recorte al ancho del item */
@media (hover:hover) and (min-width:641px){
  .dock-label{
    max-width:none !important;
    overflow:visible !important;
    text-overflow:clip !important;
    white-space:nowrap !important; /* tooltip en 1 línea */
  }
}

/* =========================
   DOCK: CARITA ANIMADA (cw-face)
   ========================= */
.cw-face-item{
  border:0;
  background:transparent;
  padding:0;
  font:inherit;
  color:inherit;
  cursor:pointer;
}
.cw-face-item:focus-visible{
  outline:2px solid rgba(37,99,235,.55);
  outline-offset:4px;
  border-radius:18px;
}

/* La carita vive adentro del tile */
.cw-face{
  width:32px;height:32px;
  position:relative;
  display:block;
  --look-x:0;
  --look-y:0;
  --mouth-y:0;
}

.cw-eye-wrap{
  position:absolute;
  top:9px;
  width:12px;height:12px;
  display:grid;place-items:center;
}
.cw-eye-wrap.left{ left:6px; }
.cw-eye-wrap.right{ right:6px; }

.cw-eye{
  font-size:14px;
  line-height:1;
  font-weight:900;
  color:#1f2937;
  transform:translate(calc(var(--look-x)*1px), calc(var(--look-y)*1px));
  transition:transform .12s ease, opacity .12s ease;
  will-change:transform, opacity;
  user-select:none;
}

.cw-mouth{
  position:absolute;
  left:50%;
  top:19px;
  transform:translate(-50%, calc(var(--mouth-y)*1px));
  font-size:18px;
  line-height:1;
  font-weight:900;
  color:#1f2937;
  transition:transform .12s ease;
  will-change:transform;
  user-select:none;
}

/* Pestañeo: ojos aparecen/desaparecen */
.cw-face.is-blink .cw-eye{
  opacity:0;
  transform:translate(calc(var(--look-x)*1px), calc(var(--look-y)*1px)) scaleY(.12);
}

/* Emoción: emoción/“excited” */
.cw-face.is-excited .cw-eye{
  font-size:16px;
  letter-spacing:-1px;
}
.cw-face.is-excited .cw-mouth{
  transform:translate(-50%, calc((var(--mouth-y) - 2)*1px));
}

/* Emoción: timidez */
.cw-face.is-shy .cw-eye{
  opacity:.92;
}

/* “Boop” al click */
.cw-face.is-boop{ animation:cwFaceBoop .22s ease; }
@keyframes cwFaceBoop{
  0%{transform:scale(1)}
  50%{transform:scale(1.08)}
  100%{transform:scale(1)}
}

/* IMPORTANTÍSIMO: en mobile con 8 items, achicamos TODOS para que entren */
@media (max-width:640px){
  .ios-dock:has(.dock-item:nth-child(8)) .dock-tile{ width:42px;height:42px; }
  .ios-dock:has(.dock-item:nth-child(8)) .dock-icon{ width:20px;height:20px; }
  .ios-dock:has(.dock-item:nth-child(8)) .dock-item{ grid-template-rows:42px auto; }
}
@media (max-width:420px){
  .ios-dock:has(.dock-item:nth-child(8)) .dock-item{ grid-template-rows:42px; }
}

/* Reduce motion */
@media (prefers-reduced-motion:reduce){
  .cw-eye,.cw-mouth,.cw-face{ transition:none!important; animation:none!important; }
}

/* =========================
   CW BUDDY: kawai + divisor + flotante 3D
   ========================= */

/* tile kawai (no transparente) */
.dock-tile--buddy{
  background:
    radial-gradient(10px 10px at 18% 22%, rgba(255,255,255,.95) 0 38%, rgba(255,255,255,0) 65%),
    radial-gradient(12px 12px at 78% 28%, rgba(255,255,255,.88) 0 40%, rgba(255,255,255,0) 68%),
    radial-gradient(14px 14px at 60% 80%, rgba(255,255,255,.85) 0 35%, rgba(255,255,255,0) 70%),
    linear-gradient(135deg, rgba(255,170,205,.96), rgba(190,235,255,.92) 55%, rgba(255,220,185,.92));
  border-color: rgba(255,255,255,.85) !important;
}

/* divisor vertical blanco y grueso a la derecha del personaje (sin romper layout) */
/* divisor vertical blanco a la derecha de “Mascota” (bien visible) */
.dock-item--buddy{
  position:relative;
  z-index:3; /* asegura que quede por arriba */
}

.dock-item--buddy::after{
  content:"";
  position:absolute;

  /* en vez de right:-12px, lo ponemos en el “gap” */
  left: calc(100% + 10px);

  top:50%;
  transform: translateY(-50%);

  width: 5px;
  height: 56px;
  border-radius: 9999px;

  background: rgba(255,255,255,.96);

  /* borde + sombra para que SE NOTE sobre glass */
  box-shadow:
    0 0 0 1px rgba(15,23,42,.12),
    0 12px 22px rgba(15,23,42,.18);

  pointer-events:none;
}

@media (max-width:640px){
  .dock-item--buddy::after{
    left: calc(100% + 6px);
    width: 4px;
    height: 44px;
  }
}

html.cw-dark .dock-item--buddy::after{
  background: rgba(255,255,255,.88);
  box-shadow:
    0 0 0 1px rgba(255,255,255,.18),
    0 12px 22px rgba(0,0,0,.35);
}
/* cara (centrada más arriba en vertical) */
.dock-tile--buddy{ position:relative; overflow:hidden; }
.cw-buddy-face{
  position:absolute;
  left:50%;
  top:50%;
  transform:translate(-50%,-58%); /* <-- más centrado/arriba */
  width:34px;
  height:24px;
  pointer-events:none;
}

/* mejillas kawai */
.cw-buddy-face::before,
.cw-buddy-face::after{
  content:"";
  position:absolute;
  top:10px;
  width:9px;
  height:7px;
  border-radius:9999px;
  background:rgba(255,120,170,.28);
  filter:blur(.1px);
}
.cw-buddy-face::before{ left:-2px; }
.cw-buddy-face::after{ right:-2px; }

/* ojos */
.cw-buddy-eye{
  position:absolute;
  top:2px;
  width:12px;
  height:12px;
  border-radius:9999px;
}
.cw-buddy-eye--l{ left:4px; }
.cw-buddy-eye--r{ right:4px; }

.cw-buddy-dot{
  position:absolute;
  left:50%;
  top:50%;
  width:6px;
  height:6px;
  border-radius:9999px;
  background:#111827;
  transform:translate(calc(-50% + var(--dx,0px)), calc(-50% + var(--dy,0px))) scale(var(--b,1));
  transition:transform .08s linear;
}
.cw-buddy-glyph{
  position:absolute;
  left:50%;
  top:50%;
  transform:translate(-50%,-56%);
  font-weight:1000;
  font-size:12px;
  color:#111827;
  display:none;
  line-height:1;
}

/* boca */
.cw-buddy-mouth{
  position:absolute;
  left:50%;
  top:16px;
  transform:translate(-50%,0);
  width:18px;
  height:10px;
}
.cw-buddy-mouthLine{
  position:absolute;
  left:50%;
  top:50%;
  width:14px;
  height:2.6px;
  border-radius:9999px;
  background:#111827;
  transform:translate(-50%, calc(-50% + var(--my,0px)));
  transition:transform .16s ease;
}

/* blink */
.cw-buddy-face.is-blink .cw-buddy-dot{ --b:0.12; }

/* emoción “excited”: ojos > < */
.cw-buddy-face.is-excited .cw-buddy-dot{ display:none; }
.cw-buddy-face.is-excited .cw-buddy-glyph{ display:block; }
.cw-buddy-face.is-excited .cw-buddy-mouthLine{ transform:translate(-50%, calc(-50% - 2px)); }

/* emoción “surprise”: boca redonda */
.cw-buddy-face.is-surprised .cw-buddy-mouthLine{
  width:7px; height:7px; border-radius:9999px;
  background:transparent;
  border:2.4px solid #111827;
  transform:translate(-50%, calc(-50% - 1px));
}

/* =========================
   Flotante 3D (arriba del dock)
   ========================= */
.cw-buddy-float{
  position:fixed;
  z-index:1002;
  width:150px;
  height:160px;
  left:20px;
  top:200px;
  touch-action:none;
  user-select:none;
}
.cw-buddy-float[aria-hidden="true"]{ display:none; }

.cw-buddy3d{
  position:absolute;
  inset:0;
  pointer-events:auto;
}
.cw-buddy3d__head{
  position:absolute;
  left:50%;
  top:0;
  width:112px;
  height:112px;
  transform:translateX(-50%);
  border-radius:9999px;
  background:
    radial-gradient(40px 30px at 35% 30%, rgba(255,255,255,.95), rgba(255,255,255,0) 70%),
    linear-gradient(145deg, rgba(255,175,210,.96), rgba(190,235,255,.92) 58%, rgba(255,220,190,.92));
  box-shadow:0 26px 50px rgba(15,23,42,.22), inset 0 2px 0 rgba(255,255,255,.9);
  border:1px solid rgba(255,255,255,.75);
  overflow:hidden;
}
.cw-buddy3d__head .cw-buddy-face{
  left:50%;
  top:52%;
  transform:translate(-50%,-58%);
  width:44px;
  height:30px;
}
.cw-buddy3d__head .cw-buddy-eye{ top:3px; width:14px; height:14px; }
.cw-buddy3d__head .cw-buddy-dot{ width:7px; height:7px; }
.cw-buddy3d__head .cw-buddy-mouth{ top:20px; }
.cw-buddy3d__head .cw-buddy-face::before,
.cw-buddy3d__head .cw-buddy-face::after{
  top:13px; width:12px; height:9px; background:rgba(255,110,170,.22);
}

.cw-buddy3d__neck{
  position:absolute;
  left:50%;
  top:96px;
  width:26px;
  height:20px;
  transform:translateX(-50%);
  border-radius:9999px;
  background:linear-gradient(180deg, rgba(255,220,205,.95), rgba(255,210,195,.88));
  box-shadow:0 10px 18px rgba(15,23,42,.12);
  border:1px solid rgba(255,255,255,.65);
}

.cw-buddy3d__torso{
  position:absolute;
  left:50%;
  top:110px;
  width:126px;
  height:70px;
  transform:translateX(-50%);
  border-radius:22px;
  background:
    radial-gradient(50px 30px at 35% 30%, rgba(255,255,255,.8), rgba(255,255,255,0) 70%),
    linear-gradient(145deg, rgba(255,230,215,.95), rgba(230,245,255,.90));
  box-shadow:0 22px 40px rgba(15,23,42,.18), inset 0 1px 0 rgba(255,255,255,.9);
  border:1px solid rgba(255,255,255,.7);
  overflow:visible;
}

/* brazos apoyados sobre la barra del dock */
.cw-buddy3d__arm{
  position:absolute;
  top:10px;
  width:54px;
  height:28px;
  border-radius:18px;
  background:linear-gradient(145deg, rgba(255,235,225,.98), rgba(220,240,255,.92));
  box-shadow:0 14px 24px rgba(15,23,42,.16), inset 0 1px 0 rgba(255,255,255,.9);
  border:1px solid rgba(255,255,255,.7);
}
.cw-buddy3d__arm--l{ left:-8px; transform:rotate(-6deg); }
.cw-buddy3d__arm--r{ right:-8px; transform:rotate(6deg); }

.cw-buddy-float.is-idle .cw-buddy3d{
  animation:cwBuddyBob 2.6s ease-in-out infinite;
}
@keyframes cwBuddyBob{
  0%,100%{ transform:translateY(0); }
  50%{ transform:translateY(-2px); }
}

@media (prefers-reduced-motion:reduce){
  .cw-buddy-float.is-idle .cw-buddy3d{ animation:none!important; }
}
/* Buddy: sin texto debajo (no muestra nada, mantiene el alto del dock) */
.dock-item--buddy .dock-label{
  visibility:hidden !important;
  opacity:0 !important;
  pointer-events:none !important;
}
/* El badge de mascota SOLO puede mostrar el fondo/mascota */
#cwBuddyBadge > :not(.user-badge-buddy){
