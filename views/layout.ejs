  <script>
(function(){
  if (window.__cwAccountWired_v2) return;
  window.__cwAccountWired_v2 = true;
  return;

  const modal   = document.getElementById('cwAccountModal');
  const status  = document.getElementById('cwAccStatus');
  const btnSave = document.getElementById('cwAccSave');

    // ===== Validación Nombre/Apellido (solo letras, max 11) =====
  const NAME_MAX = 11;
  // Letras (incluye acentos/ñ) + espacios + ' y -
  const NAME_RE = /^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ\s'-]{1,11}$/;

  function cleanName(raw){
    let s = String(raw || '');
    // borra todo lo que NO sea letras/espacios/'/-
    s = s.replace(/[^A-Za-zÁÉÍÓÚÜÑáéíóúüñ\s'-]/g, '');
    // colapsa espacios
    s = s.replace(/\s+/g, ' ').trim();
    // corta a 11 chars
    if (s.length > NAME_MAX) s = s.slice(0, NAME_MAX);
    return s;
  }

  function validateNameField(el, label){
    const cleaned = cleanName(el.value);
    if (el.value !== cleaned) el.value = cleaned;

    if (!cleaned) return `${label} es obligatorio.`;
    if (cleaned.length > NAME_MAX) return `${label} no puede superar ${NAME_MAX} caracteres.`;
    if (!NAME_RE.test(cleaned)) return `${label} solo puede tener letras (sin números).`;
    return '';
  }

  // Filtrado en vivo (no deja números ni símbolos raros)
  if (elName){
    elName.addEventListener('input', ()=>{
      if (elName.dataset.locked === '1') return;
      elName.value = cleanName(elName.value);
    });
  }
  if (elLast){
    elLast.addEventListener('input', ()=>{
      if (elLast.dataset.locked === '1') return;
      elLast.value = cleanName(elLast.value);
    });
  }

  const elName  = document.getElementById('cwAccName');
  const elLast  = document.getElementById('cwAccLast');
  const elEmail = document.getElementById('cwAccEmail');
  const elCar   = document.getElementById('cwAccCareer');
  const elPlan  = document.getElementById('cwAccPlan');

  const careerPick = document.getElementById('cwAccCareerPick');
  const planPick   = document.getElementById('cwAccPlanPick');

  const hName  = document.getElementById('cwAccNameHint');
  const hLast  = document.getElementById('cwAccLastHint');
  const hEmail = document.getElementById('cwAccEmailHint');
  const hCar   = document.getElementById('cwAccCareerHint');
  const hPlan  = document.getElementById('cwAccPlanHint');

  if(!modal || !btnSave || !elName || !elLast || !elEmail || !elCar || !elPlan) return;

  const settingsBtn  = document.getElementById('cwSettingsBtn');
  const settingsMenu = document.getElementById('cwSettingsMenu');

  function closeSettingsMenu(){
    if(!settingsMenu || !settingsBtn) return;
    settingsMenu.classList.remove('is-open');
    settingsMenu.setAttribute('aria-hidden','true');
    settingsBtn.setAttribute('aria-expanded','false');
  }

  const CAREERS = [
    'Lic. en Administración de Empresas',
    'Contabilidad',
    'Lic. en Economía'
  ];
  const PLANS = ['1','2','3','4','5'];

  function normalizeCareer(v){
    const s = String(v||'').trim();
    if (CAREERS.includes(s)) return s;
    if (/admin/i.test(s)) return CAREERS[0];
    if (/contab/i.test(s)) return CAREERS[1];
    if (/econom/i.test(s)) return CAREERS[2];
    return '';
  }

  function normalizePlan(v){
    const s = String(v||'').trim();
    if (PLANS.includes(s)) return s;
    const n = parseInt(s,10);
    if (!isNaN(n) && PLANS.includes(String(n))) return String(n);
    return '';
  }

  function setChoice(pickEl, hiddenEl, value){
    if(!pickEl || !hiddenEl) return;
    hiddenEl.value = String(value || '').trim();

    pickEl.querySelectorAll('.cw-choice').forEach(btn=>{
      const on = String(btn.dataset.value) === String(hiddenEl.value);
      btn.classList.toggle('is-on', on);
      btn.setAttribute('aria-selected', on ? 'true' : 'false');
    });
  }

  // wiring picks (una sola vez)
  if (careerPick && !careerPick.__wired){
    careerPick.__wired = true;
    careerPick.addEventListener('click', (e)=>{
      const btn = e.target.closest('.cw-choice');
      if(!btn) return;
      if (elCar.dataset.locked === '1') return;
      const v = String(btn.dataset.value || '').trim();
      if(!CAREERS.includes(v)) return;
      setChoice(careerPick, elCar, v);
    });
  }

  if (planPick && !planPick.__wired){
    planPick.__wired = true;
    planPick.addEventListener('click', (e)=>{
      const btn = e.target.closest('.cw-choice');
      if(!btn) return;
      if (elPlan.dataset.locked === '1') return;
      const v = String(btn.dataset.value || '').trim();
      if(!PLANS.includes(v)) return;
      setChoice(planPick, elPlan, v);
    });
  }

  const uid = (document.body && (document.body.getAttribute('data-user-id') || document.body.dataset.userId)) || 'me';
  const DAY = 24 * 60 * 60 * 1000;

  const FIELDS = [
    { key:'name',   el: elName,  hint: hName,  label:'nombre' },
    { key:'last',   el: elLast,  hint: hLast,  label:'apellido' },
    { key:'email',  el: elEmail, hint: hEmail, label:'mail' },
    { key:'career', el: elCar,   hint: hCar,   label:'carrera' },
    { key:'plan',   el: elPlan,  hint: hPlan,  label:'plan' },
  ];

  function keyCooldown(field){ return 'cw:acctCooldown:' + uid + ':' + field; }

  function fmt(ms){
    const s = Math.max(0, Math.floor(ms/1000));
    const h = Math.floor(s/3600);
    const m = Math.floor((s%3600)/60);
    return h + 'h ' + m + 'm';
  }

  function applyLocks(){
    const now = Date.now();

    FIELDS.forEach(f=>{
      let ts = 0;
      try{ ts = parseInt(localStorage.getItem(keyCooldown(f.key)) || '0', 10) || 0; }catch(_){ ts = 0; }

      const rem = ts ? (DAY - (now - ts)) : 0;
      const locked = rem > 0;

      f.el.dataset.locked = locked ? '1' : '0';

      // Inputs normales: disabled. Career/Plan: bloqueamos botones.
      if (f.key !== 'career' && f.key !== 'plan'){
        f.el.disabled = locked;
      }

      if (f.hint){
        f.hint.textContent = locked ? ('Podés volver a cambiar ' + f.label + ' en ' + fmt(rem) + '.') : '';
      }

      if (f.key === 'career' && careerPick){
        careerPick.querySelectorAll('.cw-choice').forEach(b=>{
          b.classList.toggle('is-disabled', locked);
        });
      }

      if (f.key === 'plan' && planPick){
        planPick.querySelectorAll('.cw-choice').forEach(b=>{
          b.classList.toggle('is-disabled', locked);
        });
      }
    });
  }

  let lastFocus = null;
  let initial = null;

  function openAccount(){
    lastFocus = document.activeElement;
    modal.setAttribute('aria-hidden','false');
    document.documentElement.style.overflow = 'hidden';
    if (status) status.textContent = '';

    // Normaliza + defaults
    elCar.value  = normalizeCareer(elCar.value) || CAREERS[0];
    elPlan.value = normalizePlan(elPlan.value) || PLANS[0];

    setChoice(careerPick, elCar, elCar.value);
    setChoice(planPick, elPlan, elPlan.value);

    initial = {
      name:  (elName.value || '').trim(),
      last:  (elLast.value || '').trim(),
      email: (elEmail.value || '').trim(),
      career:(elCar.value  || '').trim(),
      plan:  String(elPlan.value || '').trim(),
    };

    applyLocks();
    elName.focus();
  }

  function closeAccount(){
    modal.setAttribute('aria-hidden','true');
    document.documentElement.style.overflow = '';
    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
  }

  async function save(){
    if(!initial) return;

    // Limpia + valida nombre/apellido antes de continuar
    const errN = validateNameField(elName, 'El nombre');
    if (errN){ if(status) status.textContent = errN; elName.focus(); return; }

    const errL = validateNameField(elLast, 'El apellido');
    if (errL){ if(status) status.textContent = errL; elLast.focus(); return; }

    const cur = {
      name:  (elName.value  || '').trim(),
      email: (elEmail.value || '').trim(),
      career: normalizeCareer(elCar.value),
      plan:   normalizePlan(elPlan.value, elCar.value)
    };

    if (!CAREERS.includes(cur.career)){
      if (status) status.textContent = 'Elegí una carrera válida.';
      return;
    }
    if (!PLANS.includes(cur.plan)){
      if (status) status.textContent = 'Elegí un plan válido.';
      return;
    }

    const changed = [];
    Object.keys(cur).forEach(k=>{
      if ((cur[k] || '') !== (initial[k] || '')) changed.push(k);
    });

    if (!changed.length){
      if (status) status.textContent = 'No hay cambios para guardar.';
      return;
    }

    for (const k of changed){
      const f = FIELDS.find(x=>x.key===k);
      if (f && f.el && f.el.dataset.locked === '1'){
        if (status) status.textContent = 'Ese campo está bloqueado por 24h. Esperá y probá de nuevo.';
        return;
      }
    }

    btnSave.disabled = true;
    btnSave.textContent = 'guardando...';

    try{
      const res = await fetch('/app/account/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          name: cur.name,
          lastName: cur.last,
          email: cur.email,
          career: cur.career,
          plan: parseInt(cur.plan,10)
        })
      });

      let data = null;
      try{ data = await res.json(); }catch(_){ data = null; }

      if (!res.ok || !(data && data.ok)){
        if (status) status.textContent = (data && data.error) ? data.error : ('No se pudo guardar (HTTP ' + res.status + ').');
        return;
      }

      const now = Date.now();
      changed.forEach(k=>{
        try{ localStorage.setItem(keyCooldown(k), String(now)); }catch(_){}
      });

      if (status) status.textContent = 'Cambios guardados.';
      applyLocks();

      setTimeout(()=>{ location.reload(); }, 650);
    }catch(_){
      if (status) status.textContent = 'Error de red al guardar.';
    }finally{
      btnSave.disabled = false;
      btnSave.textContent = 'guardar cambios';
    }
  }

  // ✅ Intercepta SIEMPRE el click del ítem Configuración del menú (y NO navega)
  document.addEventListener('click', function(e){
    const a = e.target && e.target.closest ? e.target.closest('#cwSettingsMenu [data-cw-open="account"]') : null;
    if (!a) return;

    if (window.__CW_IS_GUEST) return;

    e.preventDefault();
    e.stopPropagation();
    closeSettingsMenu();
    openAccount();
  }, true);

  // Cerrar modal (backdrop / X)
  modal.addEventListener('click', (e)=>{
    const hit = e.target && (e.target.hasAttribute('data-close') || e.target.closest('[data-close="1"]') || e.target === modal);
    if (hit) closeAccount();
  });

  document.addEventListener('keydown', (e)=>{
    if (e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false'){
      closeAccount();
    }
  });

  btnSave.addEventListener('click', save);
})();
</script>

  <script>
  (function(){
    // ===== Fecha (día / mes / número / año) =====
    const dowEl = document.querySelector('.pd-dateDow');
    const mEl   = document.querySelector('.pd-dateMonth');
    const dEl   = document.querySelector('.pd-dateDay');
    const yEl   = document.querySelector('.pd-dateYear');

    if(dowEl && mEl && dEl && yEl){
      const now = new Date();
      const dow = new Intl.DateTimeFormat('es-AR',{ weekday:'long' }).format(now).toLowerCase();
      const mon = new Intl.DateTimeFormat('es-AR',{ month:'long' }).format(now).toLowerCase();
      dowEl.textContent = dow;
      mEl.textContent   = mon;
      dEl.textContent   = String(now.getDate());
      yEl.textContent   = String(now.getFullYear());
    }

    // ===== Segmented (Perfil / Extra) =====
    const seg = document.querySelector('.pd-seg');
    if(seg){
      const thumb = seg.querySelector('.pd-thumb');
      const btns = Array.from(seg.querySelectorAll('.pd-segbtn'));

      const setActive = (btn) => {
        btns.forEach(b => b.dataset.active = 'false');
        btn.dataset.active = 'true';

        if(thumb){
          const sr = seg.getBoundingClientRect();
          const br = btn.getBoundingClientRect();
          thumb.style.width = br.width + 'px';
          thumb.style.left  = (br.left - sr.left) + 'px';
        }
      };

      const initial = btns.find(b => b.dataset.active === 'true') || btns[0];
      if(initial) setActive(initial);

      btns.forEach(b => b.addEventListener('click', () => setActive(b)));

      window.addEventListener('resize', () => {
        const cur = seg.querySelector('.pd-segbtn[data-active="true"]') || btns[0];
        if(cur) setActive(cur);
      });
    }
  })();
