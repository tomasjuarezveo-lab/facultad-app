      height:clamp(36px,10vw,42px)!important;
    }
    #cwHelpBtn svg{
      width:clamp(20px,6.2vw,26px)!important;
      height:clamp(20px,6.2vw,26px)!important;
    }
    #btnNotifications svg{
      width:clamp(22px,6.8vw,28px)!important;
