  </style>
</head>

<body>
<%
  function fmtCount(n){
    n = Number(n||0);
    if (!n) return '0';
    if (n < 1000) return String(n);
    if (n < 10000){
      let s = (n/1000).toFixed(2);
      s = s.replace(/\.00$/,'').replace(/0$/,'');
      return s + 'k';
    }
    let s = (n/1000).toFixed(1);
    s = s.replace(/\.0$/,'');
    return s + 'k';
  }
  function avgStars(avg){
    const v = Math.max(0, Math.min(5, Number(avg||0)));
    return v;
  }
  function subjList(txt){
    return String(txt||'').split(/[,;\n]/).map(s=>s.trim()).filter(Boolean);
  }
  function firstSubject(txt){
    const a = subjList(txt);
    return a[0] || 'Sin asignar';
  }
  function normKey(s){
    return String(s||'')
      .trim()
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .replace(/\s+/g,' ');
  }
%>

  <div class="profsWrap">
    <div class="profsTopbar">
      <div class="profsLeft">
        <div class="profsTitle">Profesores</div>
        <div class="profsSubtitle"><%= carrera %> · Plan <%= plan %></div>
      </div>

      <div class="profsActions">
        <form id="profsSearchForm" class="profsSearch" action="/app/profesores" method="GET">
          <input id="qInput" name="q" value="<%= (q||'') %>" placeholder="Buscar profesor…" autocomplete="off" />
          <div class="profsSuggest" id="profsSuggest" aria-hidden="true"></div>
        </form>

        <% if (typeof isAdmin !== 'undefined' && isAdmin){ %>
          <button type="button" class="adminBtn" id="openAdmin">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M12 5v14"/><path d="M5 12h14"/>
            </svg>
            Agregar profesor
          </button>
        <% } %>
      </div>
    </div>

   <%
  const __allProfs = (typeof profesoresAll !== 'undefined' && Array.isArray(profesoresAll) && profesoresAll.length)
    ? profesoresAll
    : (Array.isArray(profesores) ? profesores : []);
%>
<% if (__allProfs && __allProfs.length){ %>
  <div class="top-month" id="topMonth">
    <img class="tpBgTrophy" src="https://image.similarpng.com/file/similarpng/original-picture/2020/06/Gold-badge-rewards-with-podium-on-transparent-background-PNG.png" alt="" aria-hidden="true">

    <div class="tpControls">
      <div class="tpSelectWrap">
  <select class="tpSelect" id="tpRankSel" aria-label="Ranking">
    <option value="best" selected>Mejores Profesores</option>
    <option value="worst">Peores profesores</option>
  </select>
  <svg class="tpSelectChevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</div>

<div class="tpSelectWrap">
  <select class="tpSelect" id="tpMatSel" aria-label="Materia">
    <option value="__all__" selected>Todas las materias</option>
  </select>
  <svg class="tpSelectChevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</div>
    </div>

    <div class="tpStage" id="tpStage"></div>
    <div class="tpEmpty" id="tpEmpty" style="display:none;">Sin datos para esta selección.</div>

    <!-- HTML antiguo mantenido (oculto por CSS / compat). Podés borrarlo si ya no lo usás -->
    <div class="top-month-head" style="display:none;">
      <div class="topText">
        <div class="topMain">Top del mes</div>
        <div class="topSub">últimos 30 días</div>
      </div>
    </div>

    <div class="top-row" id="topRow" style="display:none;">
      <% (topMes || []).slice(0,5).forEach(function(t){ %>
        <div class="topCard" data-prof-id="<%= t.id %>">
          <div class="tAvatar">
            <img src="<%= t.avatar %>" alt="<%= t.nombre %>">
          </div>
          <div class="tName"><%= t.nombre %></div>
          <div class="starsline">
            <div class="stars">
              <% for (let i=1;i<=5;i++){ %>
                <svg viewBox="0 0 24 24" fill="currentColor" style="opacity:<%= (i<=Math.round(t.monthAvg||0))?1:.25 %>">
                  <path d="M12 17.3l-6.18 3.64 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.67 1.64 7.03L12 17.3z"/>
                </svg>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

  </div>
<% } %>
    <div class="listScroll" id="listScroll">
      <%
        const profBySubj = new Map();
        const materiasBase = Array.isArray(materias) ? materias.slice() : [];
        const materiasNormMap = new Map();
        materiasBase.forEach(m => materiasNormMap.set(normKey(m), m));

        const discovered = new Set();
        (profesores||[]).forEach(p=>{
          const subs = subjList(p.subjects_text);
          subs.forEach(s => {
            const nk = normKey(s);
            if (!materiasNormMap.has(nk)) discovered.add(s);
          });
        });

        const allMaterias = materiasBase.concat(Array.from(discovered));
        allMaterias.forEach(m => profBySubj.set(m, []));

        const unassigned = [];
        (profesores||[]).forEach(p => {
          const subs = subjList(p.subjects_text);
          if (!subs.length){ unassigned.push(p); return; }

          let added = false;
          subs.forEach(s => {
            const nk = normKey(s);
            let matched = null;
            for (const mat of allMaterias){
              if (normKey(mat) === nk){ matched = mat; break; }
            }
            if (matched && profBySubj.has(matched)){
              profBySubj.get(matched).push(p);
              added = true;
            }
          });

          if (!added) unassigned.push(p);
        });
      %>

      <% (allMaterias||[]).forEach(function(mat){
          const list = profBySubj.get(mat) || [];
          if (!list.length) return;
      %>
        <div class="section" data-section-mat="<%= mat %>">
                    <%
            let __wSum = 0, __wCnt = 0;
            (list||[]).forEach(pp => {
              const a = avgStars(pp.avg);
              const c = Number(pp.count || 0);
              if (c > 0 && a > 0){
                __wSum += a * c;
                __wCnt += c;
              }
            });
            const __matAvg = __wCnt ? (__wSum / __wCnt) : 0;
            let __diffTxt = 'dificultad: —';
            let __diffCls = 'diffNone';
            if (__wCnt){
              if (__matAvg <= 2){ __diffTxt = 'dificultad: dificil'; __diffCls = 'diffHard'; }
              else if (__matAvg < 4){ __diffTxt = 'dificultad: medio'; __diffCls = 'diffMed'; }
              else { __diffTxt = 'dificultad: facil'; __diffCls = 'diffEasy'; }
            }
          %>
          <div class="section-head">
            <div class="section-left">
              <div class="section-title"><%= mat %></div>
              <div class="section-diff <%= __diffCls %>"><%= __diffTxt %></div>
            </div>
            <div class="section-sub"><%= list.length %> profesor(es)</div>
          </div>

          <div class="rowWrap">
            <button class="rowNav left" type="button" aria-label="Desplazar a la izquierda">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14.5 6.5L8.5 12l6 5.5"></path>
              </svg>
            </button>

                        <%
              const sortedList = (list||[]).slice().sort((a,b)=>{
                const sa = avgStars(a.avg);
                const sb = avgStars(b.avg);
                if (sb !== sa) return sb - sa;
                const ca = Number(a.count||0);
                const cb = Number(b.count||0);
                if (cb !== ca) return cb - ca;
                return String(a.name||'').localeCompare(String(b.name||''), 'es', { sensitivity:'base' });
              });
            %>

            <div class="row">
              <% sortedList.forEach(function(p, idx){
                  const avatar = (p.photo_url && String(p.photo_url).trim())
                    ? p.photo_url
                    : `https://ui-avatars.com/api/?name=${encodeURIComponent(p.name)}`;
                  const s = avgStars(p.avg);
                  const cnt = Number(p.count||0);
              %>
                <div
                  class="prof"
                  data-prof-id="<%= p.id %>"
                  data-name="<%= (p.name||'') %>"
                  data-subjects="<%= (p.subjects_text||'') %>"
                >
                  <% if (typeof isAdmin !== "undefined" && isAdmin){ %>
                    <button class="delProf" type="button" data-del-prof-id="<%= p.id %>" aria-label="Eliminar profesor" title="Eliminar">×</button>
                  <% } %>

                  <div class="avatarShell <%= (idx===0?'rank-1':(idx===1?'rank-2':(idx===2?'rank-3':''))) %>">
                    <div class="avatar"><img src="<%= avatar %>" alt="<%= p.name %>" loading="lazy" decoding="async"></div>
                    <div class="rateBadge" aria-hidden="true">
                      <% if (!cnt || !s){ %>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <circle cx="12" cy="12" r="8" fill="#9CA3AF"></circle>
                        </svg>
                      <% } else if (s > 3){ %>
                        <svg viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M20 6L9 17l-5-5"></path>
                        </svg>
                      <% } else if (s < 3){ %>
                        <svg viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M18 6L6 18"></path><path d="M6 6l12 12"></path>
                        </svg>
                      <% } else { %>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <circle cx="12" cy="12" r="8" fill="#9CA3AF"></circle>
                        </svg>
                      <% } %>
                    </div>
                  </div>
                  <div class="pname"><%= p.name %></div>
                  <div class="psub"><%= firstSubject(p.subjects_text) %></div>

                  <div class="starsline">
                    <div class="stars">
                      <% for (let i=1;i<=5;i++){ %>
                        <svg viewBox="0 0 24 24" fill="currentColor" style="opacity:<%= (i<=Math.round(s))?1:.25 %>"><path d="M12 17.3l-6.18 3.64 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.67 1.64 7.03L12 17.3z"/></svg>
                      <% } %>
                    </div>
                    <div class="count">(<%= fmtCount(p.count) %>)</div>
                  </div>
                </div>
              <% }) %>
            </div>

            <button class="rowNav right" type="button" aria-label="Desplazar a la derecha">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9.5 6.5L15.5 12l-6 5.5"></path>
              </svg>
            </button>
          </div>
        </div>
      <% }) %>

      <% if (unassigned.length){ %>
        <div class="section" data-section-mat="Sin asignar">
          <div class="section-head">
            <div class="section-title">Sin asignar</div>
            <div class="section-sub"><%= unassigned.length %> profesor(es)</div>
          </div>

          <div class="rowWrap">
            <button class="rowNav left" type="button" aria-label="Desplazar a la izquierda">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14.5 6.5L8.5 12l6 5.5"></path>
              </svg>
            </button>

            <div class="row">
                          <%
              const sortedUnassigned = (unassigned||[]).slice().sort((a,b)=>{
                const sa = avgStars(a.avg);
                const sb = avgStars(b.avg);
                if (sb !== sa) return sb - sa;
                const ca = Number(a.count||0);
                const cb = Number(b.count||0);
                if (cb !== ca) return cb - ca;
                return String(a.name||'').localeCompare(String(b.name||''), 'es', { sensitivity:'base' });
              });
            %>

            <div class="row">
              <% sortedUnassigned.forEach(function(p, idx){
                const avatar = (p.photo_url && String(p.photo_url).trim())
                  ? p.photo_url
                  : `https://ui-avatars.com/api/?name=${encodeURIComponent(p.name)}`;
                const s = avgStars(p.avg);
                const cnt = Number(p.count||0);
              %>
                <div
                  class="prof"
                  data-prof-id="<%= p.id %>"
                  data-name="<%= (p.name||'') %>"
                  data-subjects="<%= (p.subjects_text||'') %>"
                >
                  <% if (typeof isAdmin !== "undefined" && isAdmin){ %>
                    <button class="delProf" type="button" data-del-prof-id="<%= p.id %>" aria-label="Eliminar profesor" title="Eliminar">×</button>
                  <% } %>

                  <div class="avatar"><img src="<%= avatar %>" alt="<%= p.name %>"></div>
                  <div class="pname"><%= p.name %></div>
                  <div class="psub"><%= firstSubject(p.subjects_text) %></div>

                  <div class="starsline">
                    <div class="stars">
                      <% for (let i=1;i<=5;i++){ %>
                        <svg viewBox="0 0 24 24" fill="currentColor" style="opacity:<%= (i<=Math.round(avgStars(p.avg)))?1:.25 %>"><path d="M12 17.3l-6.18 3.64 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.67 1.64 7.03L12 17.3z"/></svg>
                      <% } %>
                    </div>
                    <div class="count">(<%= fmtCount(p.count) %>)</div>
                  </div>
                </div>
              <% }) %>
            </div>

            <button class="rowNav right" type="button" aria-label="Desplazar a la derecha">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9.5 6.5L15.5 12l-6 5.5"></path>
              </svg>
            </button>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- ===== Modal Profesor ===== -->
  <div class="overlay" id="overlay" role="dialog" aria-modal="true" aria-label="Detalle del profesor">
    <div class="modal" id="modal">
      <button class="close" id="closeBtn" aria-label="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6L6 18"/><path d="M6 6l12 12"/>
        </svg>
      </button>
            <% if (typeof isAdmin !== 'undefined' && isAdmin){ %>
        <button class="mEditBtn" id="mEditBtn" type="button" aria-label="Editar profesor">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9"/>
            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
          </svg>
          Editar
        </button>
      <% } %>

      <div class="mhead mhead-new">
        <div class="mBanner" aria-hidden="true">
          <div class="" aria-hidden="true">
          </div>
        </div>

        <button type="button" class="mSaveBtn" id="mSaveBtn" aria-label="Guardar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
          </svg>
        </button>

        <div class="mHeaderRow">
          <!-- Perfil -->
          <div class="mprof">
            <div class="mavatar"><img id="mAvatar" alt=""><div class="mRateBadge" id="mRateBadge" aria-hidden="true"></div></div>

            <div class="minfo">
              <div class="mTextCol">
                <div class="mname" id="mName"></div>
                <div class="mmat" id="mMat"></div>
              </div>

              <div class="mstars">
                <div class="stars" id="mStars"></div>
                <div class="mCountPill" id="mCount"></div>
              </div>
            </div>

            <div class="mMood" id="mMood" aria-label="Buena onda (emoji promedio)"></div>
          </div>

          <!-- KPI strip (a la derecha del perfil) -->
          <div class="kpiStrip" id="kpiStrip">
            <div class="kpiItem">
              <div class="kpiVal">
                <span class="kpiIcon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 17.3l-6.18 3.64 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.67 1.64 7.03L12 17.3z"/>
                  </svg>
                </span>
                <span id="kStarAvg">—</span>
              </div>
              <div class="kpiLbl">estrellas</div>
            </div>

            <div class="kpiItem">
              <div class="kpiVal small">
                <span class="kpiIcon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M4 19.5V6a2 2 0 0 1 2-2h12v15.5"/>
                    <path d="M6 4v15.5"/>
                    <path d="M18 19.5H8a2 2 0 0 0-2 2"/>
                  </svg>
                </span>
                <span id="kBiblioTxt">—</span>
              </div>
              <div class="kpiLbl">bibliografía</div>
            </div>

            <div class="kpiItem">
              <div class="kpiVal small">
                <span class="kpiIcon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M16 11a4 4 0 1 0-8 0"/>
                    <path d="M12 11v10"/>
                    <path d="M7 21h10"/>
                  </svg>
                </span>
                <span id="kGroupTxt">—</span>
              </div>
              <div class="kpiLbl">trabajo en grupos</div>
            </div>

            <div class="kpiItem">
              <div class="kpiVal small">
                <span class="kpiIcon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 20h16"/><path d="M7 17l4-10 2 5 2-3 2 8"/>
                  </svg>
                </span>
                <span id="kCorreTxt">—</span>
              </div>
              <div class="kpiLbl">corrección</div>
            </div>

            <div class="kpiItem">
              <div class="kpiVal small">
                <span class="kpiIcon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M4 7h16"/><path d="M7 4v16"/><path d="M20 17H4"/>
                  </svg>
                </span>
                <span id="kClasesTxt">—</span>
              </div>
              <div class="kpiLbl">calidad de clases</div>
            </div>

            <div class="kpiItem">
              <div class="kpiVal">
                <span class="kpiMark" id="kRepiteMark" aria-hidden="true">—</span>
              </div>
              <div class="kpiLbl">repite exámenes</div>
            </div>

            <div class="kpiItem">
              <div class="kpiVal small">
                <span class="kpiIcon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M4 19h16"/><path d="M8 19V9"/><path d="M12 19V5"/><path d="M16 19v-7"/>
                  </svg>
                </span>
                <span id="kEnfoqueTxt">—</span>
              </div>
              <div class="kpiLbl">se enfoca en</div>
            </div>
          </div>

          <!-- Tabs (a la derecha del strip) -->
          <!-- Tabs + métricas extra (Toma lista + Promoción + Aprobación) -->
          <div class="mTabsBar" id="mTabsBar" aria-label="Secciones">
            <div class="mTabsKpiFloat" id="mTabsKpiFloat" aria-label="Métricas extra">
              <div class="kpiItem">
                <div class="kpiVal"><span id="kListaPct">—</span></div>
                <div class="kpiLbl">Toma lista</div>
              </div>
              <div class="kpiItem">
                <div class="kpiVal">
                  <span id="kPromoAvg">—</span>
                  <% if (typeof isAdmin !== 'undefined' && isAdmin){ %>
                    <button type="button" class="kpiMiniEdit" id="kPromoEditBtn" aria-label="Editar promedio de promoción">✎</button>
                  <% } %>
                </div>
                <div class="kpiLbl">Promedio de promoción</div>
              </div>
              <div class="kpiItem">
                <div class="kpiVal">
                  <span id="kAprobPct">—</span>
                  <% if (typeof isAdmin !== 'undefined' && isAdmin){ %>
                    <button type="button" class="kpiMiniEdit" id="kAprobEditBtn" aria-label="Editar promedio de aprobación">✎</button>
                  <% } %>
                </div>
                <div class="kpiLbl">Promedio de aprobación</div>
              </div>
            </div>

            <div class="mTabs" aria-label="Secciones">
              <button type="button" class="mTab" id="tabResumen">Resumen</button>
              <button type="button" class="mTab active" id="tabComentarios">Perfil profesor</button>
              <button type="button" class="mTab" id="tabCalificar">Calificar</button>
            </div>
            <div class="mKpiScrollerMobile" id="mKpiScrollerMobile" aria-label="Métricas"></div>
          </div>
        </div>

        <div class="mDividerLine" aria-hidden="true"></div>

        <!-- Bloque antiguo mantenido (IDs vivos, oculto por CSS) -->
        <div class="mStatsRow" aria-label="Resumen de métricas">
          <div class="mChip">
            <div class="mChipTop">
              <div class="mChipTitle">Bibliografía</div>
              <div class="mChipVal" id="barBiblioPct">Sin datos</div>
            </div>
            <div class="mMiniBar"><div class="mMiniFill" id="barBiblio"></div></div>
          </div>
          <div class="mChip">
            <div class="mChipTop">
              <div class="mChipTitle">Grupo</div>
              <div class="mChipVal" id="barGroupPct">Sin datos</div>
            </div>
            <div class="mMiniBar"><div class="mMiniFill" id="barGroup"></div></div>
          </div>
          <div class="mChip">
            <div class="mChipTop">
              <div class="mChipTitle">Corrección</div>
              <div class="mChipVal" id="cCorre">—</div>
            </div>
            <div class="mMiniBar"><div class="mMiniFill" id="cOnda"></div></div>
          </div>
          <div class="mChip">
            <div class="mChipTop">
              <div class="mChipTitle">Clases</div>
              <div class="mChipVal" id="cClases">—</div>
            </div>
            <div class="mMiniBar"><div class="mMiniFill" id="cClasesFill"></div></div>
          </div>
        </div>
      </div>

      <div class="mbody mbody-new">
        <!-- Pane Resumen (ID intacta, oculto por CSS) -->
        <div class="mPane" id="paneResumen" style="padding:14px 18px 18px; display:flex; align-items:flex-start; justify-content:flex-start;">
          <div style="color:rgba(100,116,139,.85); font-weight:900; font-size:13px; line-height:1.5;">
            Tip: revisá <b>Comentarios</b> (ordenados por likes) o calificá en <b>10 segundos</b>.
          </div>
        </div>

        <!-- Pane Comentarios -->
        <div class="mPane active" id="paneComentarios">
          <div class="rightcol rightcol-new">
            <div class="rightHead">
              <h3 class="block-title">Comentarios</h3>
              <div class="filters" id="filters">
                <button type="button" class="fbtn active" data-star="0">Todo</button>
                <button type="button" class="fbtn" data-star="1"><span>1</span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.3l-6.18 3.64 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.67 1.64 7.03L12 17.3z"/></svg></button>
                <button type="button" class="fbtn" data-star="2"><span>2</span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.3l-6.18 3.64 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.67 1.64 7.03L12 17.3z"/></svg></button>
                <button type="button" class="fbtn" data-star="3"><span>3</span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.3l-6.18 3.64 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.67 1.64 7.03L12 17.3z"/></svg></button>
                <button type="button" class="fbtn" data-star="4"><span>4</span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.3l-6.18 3.64 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.67 1.64 7.03L12 17.3z"/></svg></button>
                <button type="button" class="fbtn" data-star="5"><span>5</span><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.3l-6.18 3.64 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.67 1.64 7.03L12 17.3z"/></svg></button>
              </div>
            </div>

            <div class="commentWrap">
              <div class="commentGrid" id="comments"></div>
            </div>
          </div>
        </div>

        <!-- Pane Calificar -->
        <div class="mPane" id="paneCalificar">
          <div class="leftcol leftcol-new">
            <h3 class="block-title">Calificar</h3>

            <div class="promptTitle" style="display:none;">Estado de humor (buena onda)</div>
            <div class="moodRow" id="moodRow" aria-label="Calificación por emoji" style="display:none;"></div>

            <div class="field ghostField">
              <div class="l">Estrellas</div>
              <div class="starsPick" id="starsPick"></div>
            </div>

            <div class="rateGrid">
              <div class="rateCard">
                <div class="rateTitle">Corrección <span class="rateHint" id="valCorre">7/10</span></div>
                <div class="seg" id="segCorre">
                  <button type="button" class="segBtn" data-v="3">Malo</button>
                  <button type="button" class="segBtn active" data-v="7">Normal</button>
                  <button type="button" class="segBtn" data-v="10">Bueno</button>
                </div>
              </div>

              <div class="rateCard">
                <div class="rateTitle">Calidad de clases <span class="rateHint" id="valClases">7/10</span></div>
                <div class="seg" id="segClases">
                  <button type="button" class="segBtn" data-v="3">Inútiles</button>
                  <button type="button" class="segBtn active" data-v="7">Normales</button>
                  <button type="button" class="segBtn" data-v="10">Útiles</button>
                </div>
              </div>

              <div class="rateCard">
                <div class="rateTitle">Bibliografía <span class="rateHint" id="valBiblioTxt">Normal</span></div>
                <div class="seg" id="segBiblio">
                  <button type="button" class="segBtn" data-v="1">Poco</button>
                  <button type="button" class="segBtn active" data-v="2">Normal</button>
                  <button type="button" class="segBtn" data-v="3">Mucho</button>
                </div>
              </div>

              <div class="rateCard">
                <div class="rateTitle">Trabajo en grupo <span class="rateHint" id="valGroupTxt">Medio</span></div>
                <div class="seg" id="segGroup">
                  <button type="button" class="segBtn" data-v="1">Innecesarias</button>
                  <button type="button" class="segBtn active" data-v="2">Medio</button>
                  <button type="button" class="segBtn" data-v="3">importante</button>
                </div>
              </div>

              <div class="rateCard">
                <div class="rateTitle">Repite exámenes</div>
                <div class="seg" id="segRepite">
                  <button type="button" class="segBtn active" data-v="0">No sé</button>
                  <button type="button" class="segBtn" data-v="1">Sí</button>
                  <button type="button" class="segBtn" data-v="2">No</button>
                </div>
              </div>
                <div class="rateCard">
                  <div class="rateTitle">Toma lista</div>
                  <div class="seg" id="segLista">
                  <button type="button" class="segBtn" data-v="1">Sí</button>
                  <button type="button" class="segBtn" data-v="2">No</button>
                </div>
              </div>
              <div class="rateCard">
                <div class="rateTitle">Se enfoca en</div>
                <div class="seg" id="segEnfoque">
                  <button type="button" class="segBtn active" data-v="mixto">Teórico-práctico</button>
                  <button type="button" class="segBtn" data-v="teoria">Teoría</button>
                  <button type="button" class="segBtn" data-v="practica">Práctica</button>
                </div>
              </div>
            </div>

            <div class="field ghostField">
              <div class="l">Comentario</div>
              <textarea id="inComment" class="commentBox" rows="2" maxlength="500" placeholder="Corto y útil (opcional)…"></textarea>
            </div>

            <button class="calificarBtnBottom" id="sendRate" type="button">Calificar</button>
            <div class="note" id="rateNote"></div>

            <!-- Inputs con MISMAS IDs (ocultos, pero vivos para tu backend) -->
            <input id="inCorre" class="hRange" type="range" min="1" max="10" step="1" value="7" style="display:none;">
            <input id="inClases" class="hRange" type="range" min="1" max="10" step="1" value="7" style="display:none;">
            <input id="inOnda" class="hRange" type="range" min="1" max="10" step="1" value="7" style="display:none;">
            <input id="inGroup" class="vRange" type="range" min="1" max="3" step="1" value="2" style="display:none;">
            <input id="inBiblio" class="vRange" type="range" min="1" max="3" step="1" value="2" style="display:none;">

            <input type="hidden" id="hiddenRepite" value="0">
            <input type="hidden" id="hiddenEnfoque" value="mixto">
            <input type="hidden" id="hiddenLista" value="0">

            <!-- valOnda se conserva por compatibilidad (ID intacta) -->
            <div style="display:none"><span id="valOnda">7/10</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== Admin: Agregar profesor ===== -->
  <% if (typeof isAdmin !== 'undefined' && isAdmin){ %>
    <div class="adminOverlay" id="adminOverlay" role="dialog" aria-modal="true" aria-label="Agregar profesor" style="position:fixed; inset:0; z-index:9999; display:none; align-items:center; justify-content:center; background: rgba(15,23,42,.45); backdrop-filter: blur(6px);">
      <div class="adminModal" style="width: min(720px, 94vw); background:#fff; border:1px solid rgba(15,23,42,.10); border-radius: 24px; box-shadow: var(--shadow); padding: 16px; position:relative;">
        <button class="close" id="adminClose" aria-label="Cerrar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg>
        </button>

        <h3 style="margin:0 0 10px; font-weight:950; letter-spacing:-.01em;">Agregar profesor</h3>

        <!-- ✅ Modo de carga (default: 1 por 1) -->
        <div id="adminModeBar" style="display:flex; gap:10px; margin: 0 0 12px;">
          <button type="button" id="adminModeSingleBtn" aria-pressed="true" style="height:36px; padding:0 14px; border-radius: 999px; border:1px solid rgba(15,23,42,.10); background:#0f172a; color:#fff; cursor:pointer; font-weight:950;">1 por 1</button>
          <button type="button" id="adminModeMateriaBtn" aria-pressed="false" style="height:36px; padding:0 14px; border-radius: 999px; border:1px solid rgba(15,23,42,.10); background:#fff; color:#0f172a; cursor:pointer; font-weight:950;">Por materia</button>
        </div>

        <form action="/app/profesores" method="POST" id="adminForm">
          <input type="hidden" name="admin_mode" id="admin_mode" value="single" />

          <!-- ✅ 1 por 1 (modo actual) -->
          <div id="adminModeSingle">
            <div class="adminGrid" style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
              <div class="adminField" style="display:flex; flex-direction:column; gap:6px; background: var(--pill); border:1px solid var(--pillLine); border-radius: 18px; padding: 12px;">
                <label style="font-size:12px; color:rgba(15,23,42,.65); font-weight:900;">Nombre</label>
                <input id="adminNameSingle" name="name" placeholder="Ej: Juan Pérez" required style="width:100%; border: 1px solid rgba(15,23,42,.12); background:#fff; border-radius: 14px; padding: 10px 10px; font-family:inherit; font-size:13px; outline:none;" />
              </div>

              <div class="adminField" style="display:flex; flex-direction:column; gap:6px; background: var(--pill); border:1px solid var(--pillLine); border-radius: 18px; padding: 12px;">
                <label style="font-size:12px; color:rgba(15,23,42,.65); font-weight:900;">Foto (URL)</label>
                <input id="adminPhotoSingle" name="photo_url" placeholder="https://..." style="width:100%; border: 1px solid rgba(15,23,42,.12); background:#fff; border-radius: 14px; padding: 10px 10px; font-family:inherit; font-size:13px; outline:none;" />
              </div>

              <div class="adminField" style="grid-column:1 / -1; display:flex; flex-direction:column; gap:6px; background: var(--pill); border:1px solid var(--pillLine); border-radius: 18px; padding: 12px;">
                <label style="font-size:12px; color:rgba(15,23,42,.65); font-weight:900;">Materias (separadas por coma)</label>
                <input id="adminSubjectsSingle" name="subjects_text" placeholder="Matemática 1, Administración 1" style="width:100%; border: 1px solid rgba(15,23,42,.12); background:#fff; border-radius: 14px; padding: 10px 10px; font-family:inherit; font-size:13px; outline:none;" />
              </div>
            </div>
          </div>

            <!-- ✅ Por materia (bulk) -->
          <div id="adminModeMateria" style="display:none;">
            <div class="adminGrid" style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
                <div class="adminField" style="display:flex; flex-direction:column; gap:6px; background: var(--pill); border:1px solid var(--pillLine); border-radius: 18px; padding: 12px;">
                  <label style="font-size:12px; color:rgba(15,23,42,.65); font-weight:900;">Nombre (separados por coma)</label>
                  <input id="bulkNames" name="names_bulk" placeholder="Ej: Juan Pérez, Ana Gómez, Luis Rivas" disabled style="width:100%; border: 1px solid rgba(15,23,42,.12); background:#fff; border-radius: 14px; padding: 10px 10px; font-family:inherit; font-size:13px; outline:none;" />
                </div>

                <div class="adminField" style="display:flex; flex-direction:column; gap:6px; background: var(--pill); border:1px solid var(--pillLine); border-radius: 18px; padding: 12px;">
                  <label style="font-size:12px; color:rgba(15,23,42,.65); font-weight:900;">Materia</label>
                  <input id="bulkSubject" name="bulk_subject" placeholder="Ej: Administración 1" disabled style="width:100%; border: 1px solid rgba(15,23,42,.12); background:#fff; border-radius: 14px; padding: 10px 10px; font-family:inherit; font-size:13px; outline:none;" />
                </div>
              </div>
            <div id="bulkNote" style="margin-top:10px; font-size:12px; font-weight:900; color:rgba(15,23,42,.65);"></div>
          </div>

          <input type="hidden" name="career" value="<%= carrera %>" />
          <input type="hidden" name="plan" value="<%= plan %>" />

          <div class="adminActions" style="margin-top:10px; display:flex; gap:10px; justify-content:flex-end;">
            <button type="button" class="btnGhost" id="adminCancel" style="height:40px; padding:0 14px; border-radius: 14px; border:1px solid rgba(15,23,42,.10); background:#fff; cursor:pointer; font-weight:950;">Cancelar</button>
