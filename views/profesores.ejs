      if(!btn) return;
      const v = btn.dataset.v;
      if(hiddenLista) hiddenLista.value = v;
      activateSeg(segLista, v);
    });
  }

  function labelBiblio(v){
    const n = Number(v);
    if (n === 3) return 'mucho';
    if (n === 2) return 'normal';
    if (n === 1) return 'poco';
    return '—';
  }
  function labelGroup(v){
    const n = Number(v);
    if (n === 3) return 'importante';
    if (n === 2) return 'medio';
    if (n === 1) return 'Innecesarias';
    return '—';
  }
  function labelCorre(v10){
    const n = Number(v10);
    if (!isFinite(n)) return '—';
    if (n <= 4) return 'malo';
    if (n <= 7) return 'normal';
    return 'bueno';
  }
  function labelClases(v10){
    const n = Number(v10);
    if (!isFinite(n)) return '—';
    if (n <= 4) return 'inútiles';
    if (n <= 7) return 'normales';
    return 'útiles';
  }
  function labelEnfoque(code){
    const s = String(code||'').toLowerCase();
    if (s === 'teo' || s === 'teoria') return 'teoría';
    if (s === 'prac' || s === 'practica') return 'práctica';
    if (s === 'mix' || s === 'mixto') return 'teórico-práctico';
    return '—';
  }
  function markRepite(v){
    const n = Number(v);
    if (n === 1){
      return `<svg viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6L9 17l-5-5"/>
      </svg>`;
    }
    if (n === 2){
      return `<svg viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="3" stroke-linecap="round">
        <path d="M18 6L6 18"/><path d="M6 6l12 12"/>
      </svg>`;
    }
    return `<svg viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 2-3 4"/>
      <path d="M12 17h.01"/>
    </svg>`;
  }
  function dominantFromRatings(arr, pickFn){
    const counts = new Map();
    const a = Array.isArray(arr) ? arr : [];
    for (const r of a){
      const key = pickFn(r);
      if (key === null || key === undefined || key === '') continue;
      const k = String(key);
      counts.set(k, (counts.get(k) || 0) + 1);
    }
    if (!counts.size) return null;
    let bestK = null, bestC = -1;
    for (const [k,c] of counts.entries()){
      if (c > bestC){ bestC = c; bestK = k; }
    }
    return bestK;
  }


  // ===== Confetti helper (sin librerías) =====
  function burstConfetti(anchorEl, count = 18){
    if(!anchorEl) return;
    const colors = ['#EF4444','#F59E0B','#3B82F6','#FACC15','#22C55E'];
    const rect = anchorEl.getBoundingClientRect();
    const wrap = document.createElement('div');
    wrap.className = 'confettiBurst';
    document.body.appendChild(wrap);

    const cx = rect.left + rect.width/2;
    const cy = rect.top + rect.height/2;

    for(let i=0;i<count;i++){
      const p = document.createElement('span');
      p.className = 'confettiPiece';
      const a = (Math.random()*Math.PI*2);
      const r = 30 + Math.random()*46;
      const dx = Math.cos(a)*r;
      const dy = Math.sin(a)*r - (10 + Math.random()*10);
      p.style.setProperty('--x', cx+'px');
      p.style.setProperty('--y', cy+'px');
      p.style.setProperty('--dx', dx+'px');
      p.style.setProperty('--dy', dy+'px');
      p.style.setProperty('--rot', (Math.random()*220-110)+'deg');
      p.style.background = colors[i % colors.length];
      wrap.appendChild(p);
    }

    setTimeout(()=>{ try{ wrap.remove(); }catch(e){} }, 900);
  }

