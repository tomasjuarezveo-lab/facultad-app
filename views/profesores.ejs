  #mName.mname{
    font-size: 12px !important;
    line-height: 1.05 !important;
    margin: 0 !important;
    text-align: center !important;
    max-width: calc(100vw - 20px) !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
  }

  #mMat.mmat{
    font-size: 9px !important;
    line-height: 1.05 !important;
    margin: 0 !important;
    text-align: center !important;
    max-width: calc(100vw - 20px) !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  .mCountPill{
    height: 18px !important;
    padding: 0 6px !important;
    font-size: 9px !important;
    border-radius: 999px !important;
    margin-top: 1px !important;
  }

  /* --- Tabs: Perfil profesor / Calificar (chicos y sin cortar) --- */
  .mTabsBar{
    width: 100% !important;
    margin: 0 !important;
    justify-self: stretch !important;
    display: block !important;
  }

  .mTabsKpiFloat{
    display: none !important;
  }

  .mTabs{
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    transform: none !important;
    padding: 2px !important;
    border-radius: 10px !important;

    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 4px !important;

    overflow: hidden !important;
    min-width: 0 !important;
  }

  .mTab{
    width: 100% !important;
    min-width: 0 !important;
    height: 26px !important;
    padding: 0 4px !important;
    font-size: 10px !important;
    line-height: 1 !important;
    border-radius: 8px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  /* --- STRIPS KPI (transparentes, sin borde, sin sombra) --- */
  .kpiStrip{
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    margin: 0 !important;
    transform: none !important;

    display: none !important;
    flex-wrap: nowrap !important;
    gap: 6px !important;

    overflow-x: auto !important;
    overflow-y: hidden !important;
    -webkit-overflow-scrolling: touch !important;
    touch-action: pan-x !important;

    padding: 2px 0 !important;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;

    scroll-snap-type: x proximity !important;
  }

  .kpiStrip::-webkit-scrollbar{
    display: none !important;
  }

  /* --- Items KPI: transparentes y compactos --- */
  .kpiItem{
    flex: 0 0 auto !important;
    min-width: 92px !important;
    max-width: 92px !important;
    width: 92px !important;

    padding: 4px 3px !important;
    gap: 2px !important;
    border-radius: 0 !important;

    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;

    scroll-snap-align: start !important;
  }

  .kpiItem::before,
  .kpiItem::after{
    display: none !important;
    content: none !important;
  }

  .kpiVal,
  .kpiVal.small{
    font-size: 10px !important;
    line-height: 1 !important;
    gap: 4px !important;
    justify-content: center !important;
  }

  .kpiLbl{
    font-size: 8px !important;
    line-height: 1.02 !important;
    text-align: center !important;
    white-space: normal !important;
    overflow: visible !important;
    text-overflow: clip !important;
    word-break: break-word !important;
  }

  .kpiIcon,
  .kpiIcon svg{
    width: 11px !important;
    height: 11px !important;
  }

  .kpiMark,
  .kpiMark svg{
    width: 13px !important;
    height: 13px !important;
  }

  /* --- Asegura que el strip de KPIs no se recorte a la derecha --- */
  .mHeaderRow > *{
    min-width: 0 !important;
  }

  /* --- Bloque "toma lista / promedio promoción / promedio aprobación"
         usa la misma estética transparente si comparte estas clases --- */
  .mTabsBar .kpiStrip,
  .mHeaderRow .kpiStrip{
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
  }

  .mTabsBar .kpiItem,
  .mHeaderRow .kpiItem{
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
  }

  /* --- Body scroll interno del modal --- */
  .mbody,
  .mbody-new{
    min-height: 0 !important;
    overflow: auto !important;
    -webkit-overflow-scrolling: touch !important;
    padding: 4px 8px calc(10px + env(safe-area-inset-bottom)) 8px !important;
  }

  .leftcol-new,
  .rightcol-new{
    padding: 8px 0 10px !important;
    min-width: 0 !important;
  }

  .mDividerLine{
    margin: 4px 0 !important;
  }

  /* --- Comentarios / contenido no rompan ancho --- */
  .commentWrap,
  .mPane,
  .leftcol-new,
  .rightcol-new{
    min-width: 0 !important;
    overflow: visible !important;
  }
}
