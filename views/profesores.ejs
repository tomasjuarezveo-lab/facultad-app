    .cUser{
      font-size:12px;
      font-weight:950;
      color: rgba(15,23,42,.85);
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .cStars{ display:flex; gap:2px; align-items:center; }
    .cStars svg{ width:13px; height:13px; color: var(--accent); }

    .cTxt{
      margin-top: 8px;
      font-size: 13px;
      color:#0f172a;
      line-height: 1.45;
      white-space: pre-wrap;
      word-break: break-word;
    }

    /* Like/Dislike sin caja */
    .cVotes{ margin-top: 10px; display:flex; gap: 12px; justify-content:flex-end; align-items:center; }
    .cVoteBtn{
      display:inline-flex;
      gap:6px;
      align-items:center;
      justify-content:center;
      border:none !important;
      background: transparent !important;
      cursor:pointer;
      font-weight:950;
      color: rgba(15,23,42,.85);
      padding: 0 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      transition: opacity .12s ease;
    }
    .cVoteBtn:hover{ opacity:.85; }
    .cVoteBtn:focus{ outline:none; }
    .cVoteBtn:focus-visible{ outline:none; }
    .cVoteBtn{ -webkit-tap-highlight-color: transparent; }
    .cVoteBtn svg{ width:16px; height:16px; opacity:.92; fill:none; stroke:currentColor; }
    .cVoteBtn.active svg{ color: var(--accent); fill: currentColor; stroke: currentColor; }
    .cVoteBtn .n{ color:rgba(15,23,42,.55); font-weight:950; font-size:12px; }

    /* Admin: borrar comentario */
    .cDelBtn{
      position:absolute;
      top: 10px;
      right: 10px;
      width: 28px;
      height: 28px;
      border-radius: 10px;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(255,255,255,.95);
      box-shadow: 0 10px 18px rgba(15,23,42,.10);
      display:flex;
      align-items:center;
      justify-content:center;
      cursor:pointer;
      font-weight: 950;
      color: rgba(15,23,42,.70);
      z-index: 5;
      transition: transform .12s ease, opacity .12s ease;
    }
    .cDelBtn:hover{ transform: scale(1.04); opacity:.9; }

    /* Confetti */
    .confettiBurst{ position:fixed; inset:0; pointer-events:none; z-index: 100000; }
    .confettiPiece{
      position:absolute;
      width: 7px;
      height: 7px;
      border-radius: 2px;
      left: var(--x);
      top: var(--y);
      transform: translate(-50%,-50%);
      animation: confettiFly .8s ease-out forwards;
      opacity: .95;
    }
    @keyframes confettiFly{
      to{ transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) rotate(var(--rot)); opacity: 0; }
    }

    /* Primer calificación overlay */
    .firstRateOverlay{
      position:fixed; inset:0; z-index: 100001;
      display:none; align-items:center; justify-content:center;
      background: rgba(15,23,42,.40);
      backdrop-filter: blur(8px);
    }
    .firstRateCard{
      width: min(620px, 92vw);
      background:#fff;
      border: 1px solid rgba(15,23,42,.10);
      border-radius: 26px;
      box-shadow: 0 30px 70px rgba(15,23,42,.22);
      padding: 22px 20px 18px;
      position:relative;
      overflow:hidden;
    }
    .firstRateTitle{ font-size: 18px; font-weight: 1000; color:#0f172a; letter-spacing: -.02em; }
    .firstRateSub{ margin-top: 8px; font-size: 13px; color: rgba(15,23,42,.75); font-weight: 850; }
    .firstRateClose{
      margin-top: 16px;
      width: 100%;
      height: 42px;
      border-radius: 16px;
      border: 1px solid rgba(15,23,42,.10);
      background:#0f172a;
      color:#fff;
      font-weight: 950;
      cursor:pointer;
    }
    .garland{ position:absolute; top: 12px; width: 140px; opacity:.95; }
    .garland.left{ left: 14px; }
    .garland.right{ right: 14px; transform: scaleX(-1); }


    /* ===== Calificar (como antes: segmented horizontal, más compacto) ===== */
    .leftcol-new{
      width:100%;
      overflow:auto; /* ✅ evita “cortado” si algo no entra */
      padding: 14px 18px 18px;
      display:flex;
      flex-direction:column;
      gap: 10px;
    }
    .leftcol-new{ scrollbar-width:none; -ms-overflow-style:none; }
    .leftcol-new::-webkit-scrollbar{ display:none; }

    .field.ghostField{ background: transparent !important; border:none !important; padding:0 !important; }
    .field.ghostField .l{
      padding: 0;
      margin: 0 0 8px;
      font-weight: 950;
      font-size: 12px;
      display:flex;
      align-items:center;
      justify-content:flex-start;
      color: rgba(15,23,42,.78);
    }

    /* Estrellas: sin movimiento al hover */
    .starsPick{
      display:flex;
      gap:10px;
      align-items:center;
      justify-content:flex-start;
      width: fit-content;
      padding: 0;
      border-radius: 0;
      border: none;
      background: transparent;
      box-shadow: none;
    }
    .starsPick button{
      border:none;
      background:transparent;
      padding:0;
      cursor:pointer;
      display:flex;
      align-items:center;
      justify-content:center;
      color: rgba(148,163,184,.95);
      transition: color .10s ease; /* ✅ solo color */
    }
    .starsPick button svg{ width:34px; height:34px; }
    .starsPick button:hover{ transform:none !important; } /* ✅ NO sube */
    .starsPick button.is-on,
    .starsPick button.is-hover{ color: var(--accent); }

    /* Grid compacta para que entren */
    .rateGrid{
      display:grid;
      grid-template-columns: repeat(3, 1fr);  /* ✅ 3 por fila */
      gap: 10px 12px;
      margin-top: 2px;
    }

    /* Responsive: baja a 2 y luego a 1 */
    @media (max-width: 1080px){
      .rateGrid{ grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 720px){
      .rateGrid{ grid-template-columns: 1fr; }
    }
    @media (max-width: 980px){
      .mHeaderRow{ grid-template-columns: 1fr; }
      .mavatar{ margin-top: -48px; }
      .mTabs{ justify-content: space-between; }
      .rateGrid{ grid-template-columns: 1fr; }
    }

    .rateCard{
      border-radius: 0;            /* ✅ sin “caja” */
      background: transparent;     /* ✅ transparente */
      border: none;                /* ✅ sin borde */
      box-shadow: none;            /* ✅ sin sombra */
      padding: 0;                  /* ✅ sin relleno de contenedor */
      overflow: visible;
    }
    .rateTitle{
      position:relative;
      z-index:2;
      font-size:12px;
      font-weight: 950;
      color: rgba(15,23,42,.78);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-bottom: 8px;
    }
    .rateHint{ display:none !important; } /* ✅ no mostrar “7/10” */

    .seg{
      position:relative;
      z-index:2;
      display:inline-flex;
      gap:6px;
      padding: 6px;
      border-radius: 999px;
      background: rgba(255,255,255,.96);
      border: 1px solid rgba(15,23,42,.08);
      box-shadow: 0 14px 26px rgba(15,23,42,.08), 0 1px 0 rgba(255,255,255,.90) inset;
      width: fit-content;
      flex-wrap:nowrap;
    }
    .segBtn{
      height: 30px;
      padding: 0 12px;
      border-radius: 999px;
      border: none;
      background: transparent;
      cursor:pointer;
      font-weight: 950;
      font-size: 12px;
      color: rgba(15,23,42,.70);
      transition: background .12s ease, color .12s ease, box-shadow .12s ease;
      white-space:nowrap;
    }
    .segBtn.active{
      background: var(--accent);
      color:#fff;
      box-shadow: 0 16px 26px rgba(245,190,94,.18);
    }

    .commentBox{
      width: 100%;
      border: 1px solid rgba(15,23,42,.10);
      outline:none;
      background: rgba(255,255,255,.96);
      border-radius: 18px;
      padding: 10px 12px;
      font-family: inherit;
      font-size: 13px;
      color:#0f172a;
      box-shadow: 0 14px 26px rgba(15,23,42,.08), 0 1px 0 rgba(255,255,255,.90) inset;
      resize: none;
      min-height: 52px; /* ✅ más chico */
    }

    /* Botón Calificar: amarillo #F5BE5E */
    .calificarBtnBottom{
      margin-top: 2px;
      width: fit-content;
      align-self: flex-end;
      height: 44px;
      padding: 0 18px;
      border-radius: 999px;
      border: none;
      background: var(--accent);
      color:#fff;
      font-weight: 950;
      cursor:pointer;
      box-shadow: 0 18px 30px rgba(245,190,94,.20);
      position: static;
      z-index: 999;
    }
    .calificarBtnBottom:disabled{ opacity:.65; cursor:not-allowed; }

    .note{
      font-size:12px;
      font-weight:900;
      color: rgba(100,116,139,.85);
      margin-top: 6px;
    }
    /* ✅ Oculta TODOS los íconos de KPI... */
      .kpiStrip .kpiItem .kpiIcon{
        display: none !important;
      }

      /* ✅ ...excepto el primer KPI (estrellas) */
      .kpiStrip .kpiItem:first-child .kpiIcon{
        display: inline-flex !important;
      }
      /* ✅ Centrar todo el contenido del pane Calificar en horizontal */
      /* ✅ Desktop: centrado “lindo” (NO afecta mobile) */
      @media (min-width: 721px){
        #paneCalificar .leftcol-new{
          align-items: center;
        }
        #paneCalificar .leftcol-new > *{
          width: min(780px,100%);
        }
        #paneCalificar .calificarBtnBottom{
          align-self: center;
        }
      }

      /* ✅ Mobile: botón Calificar pegado abajo (debajo del comentario) */
      @media (max-width: 720px){
        #paneCalificar{
          align-items: stretch;
        }
        #paneCalificar .leftcol-new{
          width: 100%;
          max-width: 100%;
          align-items: stretch;
          justify-content: flex-start;
          min-height: 100%;
        }
        #paneCalificar .leftcol-new > *{
          width: 100%;
        }
        #paneCalificar .commentWrap{
          flex: 1;
          display:flex;
          flex-direction:column;
          min-height: 140px;
        }
        #paneCalificar #inComment{
          flex: 1;
          min-height: 160px;
        }
        #paneCalificar .calificarBtnBottom{
          width: 100%;
          align-self: stretch;
          margin-top: 12px;
        }
      }

      /* ✅ Centrar TODO el pane Comentarios en horizontal (como Calificar) */
      #paneComentarios .rightcol-new{
        align-items: center;                 /* centra hijos */
      }

      /* ✅ Mantener el contenido con un ancho “bonito” y centrado */
      #paneComentarios .rightcol-new > *{
        width: min(980px, 100%);             /* ajustá: 860/920/980 */
      }

      /* ✅ Centrar la grilla de comentarios */
      #paneComentarios .commentGrid{
        justify-content: center;             /* centra el grid dentro del ancho */
      }
      #paneComentarios .rightHead{
        align-items: center;
        text-align: center;
      }
      /* ============================================================
    ✅ PATCH MOBILE (NO cambia PC)
    - Topbar + buscador + botón admin en columna
    - Cards más grandes y tocables
    - Oculta flechas laterales (se usa swipe)
    - Modal full-screen en mobile (sin cortes)
    - KPI strip sin transforms raros (se reacomoda)
    ============================================================ */

  @media (max-width: 720px){

    /* ✅ En mobile, evitá el “corte” típico por overflow:hidden + 100vh */
    body{
      overflow: auto;               /* antes hidden (solo en mobile) */
    }

    .wrap{
      height: auto;                 /* en PC queda igual */
      min-height: 100dvh;           /* mejor que 100vh en iOS */
      margin: 10px auto 14px;
      padding: 0 12px;
      gap: 10px;
    }

    /* ===== Header ===== */
    .topbar{
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .actions{
      margin-left: 0;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .search{
      width: 100%;
    }
    .search input{
      width: 100%;
      max-width: none;
    }

    .adminBtn{
      width: 100%;
      justify-content: center;
    }

    /* ===== Lista / secciones ===== */
    .listScroll{
      padding-bottom: 32px; /* en mobile no hace falta 120px */
    }

    .section-head{
      padding: 0 2px;
    }
    .rowWrap{
      padding: 0 2px 10px;
    }
    .row{
      gap: 10px;
      padding: 4px 2px 10px;
    }

    /* ✅ En mobile: las flechas se pisan, mejor swipe */
    .rowNav{
      display: none !important;
    }

    /* ===== Tarjeta profesor más “tocable” ===== */
    .prof{
      width: 172px;
      padding: 10px 10px 12px;
    }
    .avatar{
      width: 86px;
      height: 86px;
    }
    .pname{
      font-size: 13px;
    }
    .psub{
      font-size: 11px;
      max-width: 160px;
    }

    .delProf{
      width: 28px;
      height: 28px;
      top: 6px;
      right: 6px;
      font-size: 16px;
    }

    /* ===== Modal FULL SCREEN ===== */
    .overlay{
      align-items: stretch;
      justify-content: stretch;
      padding: 0;
    }
    .modal{
      width: 100vw;
      height: 100dvh;
      border-radius: 0;
    }

    .close{
      position: fixed;      /* siempre visible */
      top: 10px;
      right: 10px;
      z-index: 99999;
    }

    /* Header del modal en una sola columna */
    .mHeaderRow{
      grid-template-columns: 1fr !important;
      gap: 10px;
      padding: calc(var(--bannerH) + 12px) 14px 10px 14px;
    }

    .mprof{
      margin-left: 0 !important;     /* evita que se vaya a la izquierda */
    }

    .mavatar{
      width: 124px;
      height: 124px;
      margin-top: -56px;
    }

    /* Materias: que no corte en una sola línea en pantallas chicas */
    #mMat.mmat{
      max-width: 92vw;
      white-space: normal;
    }

    /* Tabs: sin transform raro, que se acomoden */
    .mTabs{
      transform: none !important;
      width: 100%;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    /* ✅ KPI strip: en desktop lo tenés con width 150% + translate.
          En mobile eso rompe: lo reseteamos y lo hacemos grilla 2 columnas */
    .kpiStrip{
      width: 100% !important;
      height: auto !important;
      transform: none !important;
      margin-left: 0 !important;

      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      column-gap: 12px !important;
      row-gap: 10px !important;
    }

    .kpiItem{
      padding: 10px 0 !important;
    }
    .kpiItem::after{
      display: none !important; /* los divisores verticales en 2 columnas quedan raros */
    }

    /* Padding más cómodo dentro de panes */
    .rightcol-new,
    .leftcol-new{
      padding: 12px 14px 16px;
    }
  }

  /* ============================================================
  ✅ PATCH MOBILE (NO cambia PC)
  - Arregla: Top del Mes cortado / modal sin comments / avatar círculo / calificar chico
  ============================================================ */

  @media (max-width: 720px){

    /* ✅ iOS: evita cortes raros por 100vh + barras */
    html, body{
      height: auto !important;
    }
    body{
      overflow: auto !important;
      -webkit-text-size-adjust: 100%;
    }

    .wrap{
      height: auto !important;
      min-height: 100dvh;
      margin: 10px auto 14px;
      padding: 0 12px;
      gap: 10px;
    }

    /* ===== Header arriba ===== */
    .topbar{
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
      padding-top: max(6px, env(safe-area-inset-top));
    }

    .actions{
      margin-left: 0;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .search{ width: 100%; }
    .search input{
      width: 100%;
      max-width: none;
    }

    .adminBtn{
      width: 100%;
      justify-content: center;
    }

    /* ✅ En mobile: mejor scroll de página (no scroll interno raro) */
    .listScroll{
      overflow: visible !important;
      padding-bottom: calc(18px + env(safe-area-inset-bottom));
    }

    /* ============================================================
      ✅ TOP DEL MES: no se corta + se ven bien 3/5 perfiles
      - quitamos height fijo en mobile
      - quitamos translateY negativo del escenario
      ============================================================ */
    .top-month{
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      padding: 12px 12px 14px !important;
    }

    .tpStage{
      transform: none !important;
      padding: 8px 10px 10px !important;
      gap: 10px !important;
    }

    /* anillos un toque más chicos para que entren lindo */
    .tpRing{ width: 66px; height: 66px; }
    .tpPic{ width: 50px; height: 50px; }
    .tpWinner .tpRing{ width: 74px; height: 74px; }
    .tpWinner .tpPic{ width: 58px; height: 58px; }
    .tpCrown{ top: -16px; width: 34px; height: 34px; }

    /* trophy bg que no empuje todo para abajo */
    .tpBgTrophy{
      width: 120%;
      height: 210px;
      bottom: -18px;
      opacity: .22;
    }

    /* ============================================================
      ✅ Modal FULL SCREEN estable + comentarios visibles
      - 1 solo scroll dentro del modal (evita bugs iOS)
      ============================================================ */
    .overlay{
      align-items: stretch;
      justify-content: stretch;
      padding: 0;
    }

    .modal{
      width: 100vw;
      height: 100dvh;
      border-radius: 0;
    }

    .close{
      position: fixed;
      top: 10px;
      right: 10px;
      z-index: 99999;
    }

    /* ✅ reduce un poco el banner para que no “coma” pantalla */
    :root{
      --bannerH: 120px;
    }

    .mHeaderRow{
      grid-template-columns: 1fr !important;
      gap: 10px;
      padding: calc(var(--bannerH) + 12px) 14px 10px 14px !important;
    }

    .mprof{
      margin-left: 0 !important;
    }

    .mavatar{
      width: 120px;
      height: 120px;
      margin-top: -52px;
    }

    /* materias: que no corte raro */
    #mMat.mmat{
      max-width: 92vw;
      white-space: normal;
    }

    /* Tabs en 2 filas si hace falta */
    .mTabs{
      transform: none !important;
      width: 100%;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
    }
    .mTab{
      flex: 1 1 auto;
      text-align: center;
    }

    /* ✅ KPI strip: reseteo transforms y lo hago más “mobile” */
    .kpiStrip{
      width: 100% !important;
      height: auto !important;
      transform: none !important;
      margin-left: 0 !important;

      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      column-gap: 12px !important;
      row-gap: 10px !important;
    }
    .kpiItem{ padding: 10px 0 !important; }
    .kpiItem::after{ display: none !important; }

    /* ✅ ESTE es el fix clave para “no se ven comentarios” en mobile:
      hacemos que el body del modal sea el scroll principal */
    .mbody-new{
      overflow: auto !important;
      -webkit-overflow-scrolling: touch;
    }
    .mPane{
      overflow: visible !important;
    }
    .rightcol-new,
    .leftcol-new{
      overflow: visible !important;
      padding: 12px 14px 16px !important;
    }
    .commentWrap{
      overflow: visible !important;
    }

    /* comentarios: una columna ya la tenés, pero reforzamos spacing */
    .commentGrid{
      gap: 10px !important;
    }

    /* ============================================================
      ✅ Calificar: botón grande y cómodo en mobile
      ============================================================ */
    .starsPick button svg{ width: 36px; height: 36px; }

    .calificarBtnBottom{
      width: 100% !important;
      height: 48px !important;
      border-radius: 18px !important;
      position: sticky !important;
      bottom: calc(10px + env(safe-area-inset-bottom));
      margin-top: 10px;
      z-index: 999;
    }
  }

  @media (max-width: 420px){
    .prof{ width: 160px; }
    .avatar{ width: 80px; height: 80px; }
  }
/* =========================
   ✅ DARK MODE (respeta cw:darkmode)
   ========================= */
html.cw-dark{
  --bg:    #0b1220;
  --panel: rgba(17,24,39,.62);
  --glass: rgba(17,24,39,.46);
  --line:  rgba(255,255,255,.10);
  --ink:   rgba(229,231,235,.96);
  --muted: rgba(156,163,175,.95);
  --shadow: 0 22px 60px rgba(0,0,0,.45);
}

html.cw-dark body{
  color: var(--ink) !important;
  background:
    radial-gradient(circle at 18% 18%, rgba(99,102,241,.18), rgba(2,6,23,0) 52%),
    radial-gradient(circle at 82% 28%, rgba(245,188,96,.14), rgba(2,6,23,0) 55%),
    linear-gradient(180deg, #050A14, #0B1220 55%, #050A14) !important;
}

/* textos */
html.cw-dark .brand-title,
html.cw-dark .section-title,
html.cw-dark .pname,
html.cw-dark .tpName,
html.cw-dark .tpTitle,
html.cw-dark .tName{
  color: var(--ink) !important;
}
html.cw-dark .brand-sub,
html.cw-dark .section-sub,
html.cw-dark .psub,
html.cw-dark .tpSub2{
  color: var(--muted) !important;
}

/* inputs + botones */
html.cw-dark .search input{
  background: rgba(255,255,255,.06) !important;
  border-color: rgba(255,255,255,.12) !important;
  color: var(--ink) !important;
  box-shadow: 0 14px 28px rgba(0,0,0,.28) !important;
}
html.cw-dark .search input::placeholder{ color: rgba(156,163,175,.78) !important; }

html.cw-dark .adminBtn{
  background: rgba(255,255,255,.08) !important;
  border-color: rgba(255,255,255,.12) !important;
  color: var(--ink) !important;
  box-shadow: 0 14px 28px rgba(0,0,0,.28) !important;
}

html.cw-dark .rowNav{
  background: rgba(255,255,255,.08) !important;
  border-color: rgba(255,255,255,.12) !important;
  box-shadow: 0 12px 22px rgba(0,0,0,.30) !important;
}
html.cw-dark .rowNav svg{ opacity: .92 !important; }

/* cards */
html.cw-dark .prof{
  background: rgba(255,255,255,.02) !important;
}
html.cw-dark .avatar{
