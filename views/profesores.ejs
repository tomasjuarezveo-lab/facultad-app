    const full = String(r.comment||'').trim();
    const isTrunc = full.length > 70;
    const short = isTrunc ? (full.slice(0,70) + '...') : full;
    const dataAttr = isTrunc ? ` data-full="${escapeHtml(full)}" data-trunc="1"` : '';

    return `
      <div class="cCard" data-review-id="${r.id}">
