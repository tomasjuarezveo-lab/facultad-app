      .mCountPill{
        height: 26px;
        display:inline-flex;
        align-items:center;
        padding: 0 10px;
        border-radius: 999px;
        border: 1px solid rgba(15,23,42,.08);
        background: rgba(255,255,255,.92);
        box-shadow: 0 14px 28px rgba(15,23,42,.10), 0 1px 0 rgba(255,255,255,.90) inset;
        font-size: 12px;
        font-weight: 950;
        color: rgba(15,23,42,.70);
        white-space:nowrap;
      }

      /* Emoji: NO */
      #mMood, .mMood{ display:none !important; }

      /* ✅ 7 en una fila + MÁS separación real entre ellos */
      .kpiStrip{
        width: 150%;
        height: 135%;
        min-width: 0;

        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        align-items: center;

        column-gap: 26px;          /* ✅ MÁS separación (probá 18/22/30) */
        overflow: visible;

        background: transparent;
        border: none;
        box-shadow: none;
        margin-left: -55px;
        transform: translatex(-135px) translateY(45px);
        border-radius: 0;
        padding: 0;
        margin: 0;
      }
      /* ✅ Ítems transparentes + divisor visible entre cada uno */
      .kpiItem{
        min-width: 0;

        /* ✅ un poco más grandes */
        padding: 15px 0;            /* antes 8px 0 */
        background: transparent;
        border: none;
        box-shadow: none;

        display:flex;
        flex-direction:column;
        justify-content:center;
        align-items:center;
        gap: 7px;                   /* antes 6px */
        text-align:center;

        position: relative;         /* ✅ necesario para el divisor */
      }

      /* ✅ divisor vertical “en el medio” del espacio entre columnas */
      .kpiItem::after{
        content:"";
        position:absolute;
        top: 50%;
        transform: translateY(-50%);
        right: -13px;               /* ✅ column-gap/2 (26px → 13px) */
        width: 1px;
        height: 40px;               /* antes 34px */
        background: rgba(15,23,42,.22);
        opacity: 1;
      }

      /* ✅ el último NO debe tener divisor */
      .kpiItem:last-child::after{
        display:none;
      }

      /* ✅ Texto negro (valor) más grande que el gris */
      .kpiVal{
        display:flex;
        align-items:center;
        justify-content:center;
        gap: 15px;
        font-weight: 900;
        color:#0f172a;
        font-size: 15px;            /* antes 14px */
        line-height: 1;
        white-space: nowrap;
      }
      .kpiVal.small{
        font-size: 15px;            /* antes 12.5px */
        font-weight: 900;
      }
      .kpiMiniEdit{
        width: 26px;
        height: 26px;
        border-radius: 10px;
        border: 1px solid rgba(15,23,42,.10);
        background: rgba(255,255,255,.92);
        box-shadow: 0 10px 18px rgba(15,23,42,.10);
        display:inline-flex;
        align-items:center;
        justify-content:center;
        font-weight: 950;
        font-size: 12px;
        color: rgba(15,23,42,.70);
        cursor:pointer;
        -webkit-tap-highlight-color: transparent;
      }
      .kpiMiniEdit:active{ transform: translateY(1px) scale(.99); }
      .mTabsKpiFloat .kpiMiniEdit{ pointer-events:auto; }
      /* ✅ Texto gris (label) más chico */
      .kpiLbl{
        text-align:center;
        font-size: 10px;            /* antes 10.5px */
        font-weight: 750;
        color: rgba(100,116,139,.85);
        white-space: nowrap;
      }

      /* ✅ Mobile: reset corrimientos y gap */
      @media (max-width: 980px){
        .mprof{ margin-left: 0; }
        .kpiStrip{ column-gap: 12px; }
        .kpiItem::after{ right: -6px; height: 34px; } /* gap/2 para 12px */
      }

      /* ✅ Mobile real (teléfono): compactar header para liberar espacio a Comentarios/Calificación */
    @media (max-width: 640px){

      /* 1) Banner más bajo en mobile */
      :root{
        --bannerH: 108px; /* antes 150px */
      }

      /* 2) Modal un poco más “alto útil” en mobile (sin tocar desktop) */
      .modal{
        width: min(96vw, 560px);
        height: min(92dvh, 860px);
        border-radius: 22px;
      }

      /* 3) Header del modal: apilado y compacto */
      .mHeaderRow{
        padding: calc(var(--bannerH) + 10px) 12px 8px 12px; /* antes calc(--bannerH + 14px) 18px 12px */
        grid-template-columns: 1fr; /* antes 300px 1.35fr auto */
        gap: 10px;
        justify-items: center;
        align-items: center;
      }

      /* 4) Avatar más chico + menos “salto” hacia arriba */
      .mavatar{
        width: 112px;     /* antes 154px */
        height: 112px;    /* antes 154px */
        margin-top: -46px;/* antes -74px */
        border-width: 4px;
        box-shadow: 0 18px 36px rgba(15,23,42,.18);
      }

      /* 5) Materias: permitir 2 líneas si hace falta */
      #mMat.mmat{
        max-width: 86vw;
        white-space: normal; /* antes nowrap */
      }

      /* 6) KPI strip: NO empujar hacia abajo, hacerlo horizontal scrolleable */
      .kpiStrip{
        width: 100%;
        height: auto;
        display: flex;
        gap: 12px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding: 6px 2px 0;
        transform: none;     /* antes translateX/translateY */
        margin: 0;
      }

      /* items KPI: más compactos y sin divisores */
      .kpiItem{
        flex: 0 0 auto;
        padding: 8px 10px;
        gap: 6px;
      }
      .kpiItem::after{ display:none; }

      /* 7) Tabs: sin translate raro, centradas */
      .mTabs{
        transform: none;      /* antes translatey(-50px) */
        margin: 6px auto 0;
        justify-content: center;
      }

      /* 8) Divisor + contenido: menos padding para ganar alto útil */
      .mDividerLine{ margin: 6px 12px; }
      .rightcol-new{ padding: 12px 12px 14px; }
    }


