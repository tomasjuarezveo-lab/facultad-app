            <button class="cVoteBtn ${my===1?'active':''}" data-vote="1" type="button" aria-label="Like">
              ${thumbUpSVG()} <span class="n" data-kind="likes">${fmtCount(likes)}</span>
            </button>
            <button class="cVoteBtn ${my===-1?'active':''}" data-vote="-1" type="button" aria-label="Dislike">
