<!-- ✅ PROFESORES.EJS — VERSION AJUSTADA NUEVA 08 01 2026 (TOP DEL MES COMPACTO + SIN TROFEO DROPBOX + SIN BASES BLANCAS) -->

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Profesores — <%= carrera %> / <%= plan %></title>
  <link rel="preconnect" href="https://ui-avatars.com">
  <style>
    :root{
      --bg:#F3F6FB;
      --panel:#FFFFFF;
      --ink:#0F172A;
      --muted:#64748B;
      --line:rgba(15,23,42,.10);
      --shadow: 0 18px 45px rgba(15,23,42,.14);

      /* ✅ Amarillo pedido */
      --accent:#F5BE5E;

      --good:#22C55E;
      --mid:#F97316;
      --cool:#3B82F6;

      --pill:#F8FAFC;
      --pillLine:rgba(15,23,42,.10);

      /* Banner suave violeta → lila → turquesa */
      --bannerH: 150px;
      --bannerV: rgba(124,58,237,.90);
      --bannerL: rgba(167,139,250,.86);
      --bannerT: rgba(94,234,212,.56);
    }

    html,body{ margin:0; padding:0; font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial; color:var(--ink); height:100%; }
    body{ background: var(--bg); overflow:hidden; }
    a{ color:inherit; text-decoration:none; }
    button{ font-family:inherit; }
    *{ box-sizing:border-box; }

    .profsWrap{
      max-width: 1260px;
      margin: 18px auto 18px;
      padding: 0 16px;
      height: calc(100vh - 36px);
      display:flex;
      flex-direction:column;
      gap:14px;
    }

    /* ===== Header ===== */
    .profsTopbar{ display:flex; align-items:center; gap:12px; flex:0 0 auto; }
    .profsTitle{ font-weight:900; letter-spacing:-.02em; font-size:22px; }
    .profsSubtitle{ font-size:12px; color:var(--muted); margin-top:2px; }
    .profsLeft{ display:flex; flex-direction:column; }

    .profsActions{ margin-left:auto; display:flex; align-items:center; gap:10px; }

    /* Search: SIN lupa SVG */
    .profsSearch{ position:relative; background:transparent; }
    .profsSearch input{
      width: 320px; max-width: 60vw;
      height: 40px;
      border-radius: 999px;
      border: 1px solid rgba(15,23,42,.08);
      background: #fff;
      padding: 0 16px 0 16px;
      outline:none;
      box-shadow: 0 10px 22px rgba(15,23,42,.10);
      font-size:14px;
      color: #0f172a;
    }
    .profsSearch input::placeholder{ color: rgba(15,23,42,.45); font-weight:800; }
    /* ===== Autocomplete (dropdown) ===== */
    .profsSuggest{
      position:absolute;
      left:0;
      right:0;
      top: 46px;
      background: rgba(255,255,255,.98);
      border: 1px solid rgba(15,23,42,.10);
      border-radius: 18px;
      box-shadow: 0 22px 46px rgba(15,23,42,.16);
      overflow:hidden;
      display:none;
      z-index: 50;
    }
    .profsSuggest.is-open{ display:block; }
    .profsSuggestItem{
      width:100%;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding: 10px 12px;
      background: transparent;
      border:0;
      cursor:pointer;
      text-align:left;
    }
    .profsSuggestItem:hover{ background: rgba(245,190,94,.18); }
    .profsSuggestMain{
      display:flex;
      flex-direction:column;
      gap:2px;
      min-width:0;
    }
    .profsSuggestName{
      font-weight: 950;
      color: #0f172a;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
      max-width: 56vw;
    }
    .profsSuggestSub{
      font-size: 12px;
      font-weight: 850;
      color: rgba(100,116,139,.95);
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
      max-width: 56vw;
    }
    .profsSuggestChip{
      flex: 0 0 auto;
      font-size: 11px;
      font-weight: 950;
      padding: 6px 10px;
      border-radius: 999px;
      border: 1px solid rgba(15,23,42,.10);
      background: rgba(15,23,42,.04);
      color: rgba(15,23,42,.70);
      white-space:nowrap;
    }
    @media (max-width: 430px){
      .profsSuggestName, .profsSuggestSub{ max-width: 68vw; }
    }
    .adminBtn{
      height: 40px;
      padding: 0 14px;
      border-radius: 999px;
      border: 1px solid rgba(15,23,42,.10);
      background: #fff;
      cursor:pointer;
      font-weight:950;
      box-shadow: 0 10px 22px rgba(15,23,42,.10);
      display:inline-flex;
      align-items:center;
      gap:8px;
      white-space:nowrap;
    }
    .adminBtn svg{ width:16px; height:16px; }

    /* ===== Top del mes (ORIGINAL) ===== */
    .top-month{
      flex:0 0 auto;
      background: #fff;
      border-radius: 22px;
      padding: 14px;
      position:relative;
      overflow:hidden;

      border: none;
      box-shadow:
        0 18px 46px rgba(15,23,42,.18),
        0 8px 18px rgba(15,23,42,.12),
        0 2px 0 rgba(255,255,255,.78) inset,
        0 -10px 16px rgba(15,23,42,.05) inset;
    }

    .top-month::before{
      content:"";
      position:absolute;
      inset:-30%;
      background: linear-gradient(120deg,
        rgba(249,115,22,.18),
        rgba(248,193,96,.16),
        rgba(59,130,246,.16),
        rgba(248,193,96,.14),
        rgba(249,115,22,.16)
      );
      background-size: 220% 220%;
      animation: topGlow 10s ease-in-out infinite;
      filter: blur(18px);
      opacity: .95;
      z-index:0;
    }
    @keyframes topGlow{
      0%{ background-position: 0% 40%; transform: translate3d(0,0,0) rotate(0deg); }
      50%{ background-position: 100% 60%; transform: translate3d(0,0,0) rotate(1deg); }
      100%{ background-position: 0% 40%; transform: translate3d(0,0,0) rotate(0deg); }
    }

    .top-month-head{
      display:flex;
      align-items:flex-start;
      justify-content:center;
      gap:12px;
      position:relative;
      z-index:2;
      padding-left: 0;
      text-align:center;
    }

    .topText{
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:2px;
    }
    .topMain{
      font-size: 20px;
      font-weight: 950;
      letter-spacing: -.02em;
      color: #0f172a;
      text-shadow: 0 12px 22px rgba(15,23,42,.10);
      line-height: 1.05;
    }
    .topSub{
      font-size: 12px;
      font-weight: 900;
      color: rgba(15,23,42,.55);
      line-height: 1.1;
    }

    .topTrophyWrap{ display:none; }
    .topTrophy{ display:none; }
    .trophyConfettiLayer{ display:none; }

    .top-row{
      margin-top:12px;
      display:grid;
      grid-template-columns: repeat(5, 1fr);
      gap:6px;
      padding: 2px 170px 10px 14px;
      position:relative;
      z-index:2;
      justify-items:center;
      align-items:start;
    }

    .topCard{
      width: 100%;
      max-width: 120px;
      border-radius: 18px;
      padding: 0;
      background: transparent;
      border: none;
      box-shadow: none;
      cursor:pointer;
      user-select:none;
      transition: transform .12s ease, filter .12s ease;
    }
    .topCard:hover{
      transform: translateY(-2px);
      filter: drop-shadow(0 14px 18px rgba(15,23,42,.10));
    }

    .tAvatar{
      width: 58px; height: 58px;
      border-radius: 999px;
      overflow:hidden;
      background:#fff;
      margin: 0 auto 8px;

      border: 3px solid rgba(255,255,255,.98);
      box-shadow:
        0 16px 26px rgba(15,23,42,.16),
        0 2px 0 rgba(255,255,255,.85) inset,
        0 -10px 18px rgba(15,23,42,.06) inset;
      position:relative;
    }
    .tAvatar::after{
      content:"";
      position:absolute;
      inset: -10px;
      border-radius: 999px;
      background: radial-gradient(circle at 35% 30%, rgba(255,255,255,.45), rgba(255,255,255,0) 55%);
      pointer-events:none;
    }

    .tAvatar img{ width:100%; height:100%; object-fit:cover; }
        /* ✅ Avatar shell + rank rings + badges (lista de profesores) */
    .avatarShell{
      width: 72px;
      height: 72px;
      margin: 2px auto 8px;
      position: relative;
    }
    .avatarShell .avatar{ margin:0; }
    .avatarShell .avatar img{ width:100%; height:100%; object-fit:cover; }

    .avatarShell.rank-1 .avatar{
      box-shadow:
        0 18px 34px rgba(15,23,42,.18),
        0 2px 0 rgba(255,255,255,.85) inset,
        0 -10px 18px rgba(15,23,42,.06) inset,
        0 0 0 4px #D4AF37;
    }
    .avatarShell.rank-2 .avatar{
      box-shadow:
        0 18px 34px rgba(15,23,42,.18),
        0 2px 0 rgba(255,255,255,.85) inset,
        0 -10px 18px rgba(15,23,42,.06) inset,
        0 0 0 4px #FACC15;
    }
    .avatarShell.rank-3 .avatar{
      box-shadow:
        0 18px 34px rgba(15,23,42,.18),
        0 2px 0 rgba(255,255,255,.85) inset,
        0 -10px 18px rgba(15,23,42,.06) inset,
        0 0 0 4px #C0C0C0;
    }
    .rateBadge{
      position:absolute;
      right: 1px;
      bottom: 1px;
      transform: translate(32%, 32%);
      width: 32px;
      height: 32px;
      border-radius: 999px;
      background:#ffffff00;
      display:flex;
      align-items:center;
      justify-content:center;
      z-index: 3;
      pointer-events:none;
    }
    .rateBadge svg{ width: 25px; height: 25px; display:block; }
    .tName{
      text-align:center;
      font-weight:950;
      font-size:12px;
      line-height:1.1;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
      padding: 0 4px;
    }
    .starsline{ display:flex; align-items:center; justify-content:center; gap:6px; margin-top:7px; }
    .stars{ display:flex; gap:2px; justify-content:center; }
    .stars svg{ width:13px; height:13px; color: var(--accent); }
    .count{ display:none; }

    /* ===== Scroll interno ===== */
    .listScroll{
      flex: 1 1 auto;
      min-height: 0;
      overflow-y:auto;
      padding-bottom: 120px;
    }
    .listScroll{ scrollbar-width:none; -ms-overflow-style:none; }
    .listScroll::-webkit-scrollbar{ display:none; }

    /* ===== Agrupado por materia ===== */
    .section{ margin-top:18px; }
    .section-head{ display:flex; align-items:baseline; justify-content:space-between; gap:12px; padding: 0 6px; }
    .section-title{ font-weight:900; font-size:16px; letter-spacing:-.01em; }
    .section-sub{ color:var(--muted); font-size:12px; }
        .section-left{ display:flex; align-items:baseline; gap:10px; min-width:0; }
    .section-diff{
      font-weight: 950;
      font-size: 12px;
      letter-spacing: -.01em;
      white-space: nowrap;
      padding: 6px 10px;
      background: rgba(255, 255, 255, 0);
    }
    .section-diff.diffHard{ color:#EF4444; }
    .section-diff.diffMed{ color:#F59E0B; }
    .section-diff.diffEasy{ color:#22C55E; }
    .section-diff.diffNone{ color: rgba(100,116,139,.85); }

    .rowWrap{
      position:relative;
      margin-top:10px;
      padding: 0 6px 12px;
    }
    .row{
      display:flex;
      gap:12px;
      overflow-x:auto;
      padding: 4px 6px 10px;
      scroll-snap-type:x mandatory;
    }
    .row{ scrollbar-width:none; -ms-overflow-style:none; }
    .row::-webkit-scrollbar{ display:none; }

    .rowNav{
      position:absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 26px; height: 26px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0);
      display:flex;
      align-items:center;
      justify-content:center;
      cursor:pointer;
      z-index:5;
      padding:0;
    }
    .rowNav.left{ left: 6px; }
    .rowNav.right{ right: 6px; }
    .rowNav svg{ width: 14px; height: 14px; opacity:.75; display:block; }

    /* ===== Tarjeta profesor ===== */
    .prof{
      width: 152px;
      flex: 0 0 auto;
      scroll-snap-align: start;
      cursor:pointer;
      user-select:none;
      border-radius: 18px;
      padding: 8px 8px 10px;
      transition: transform .12s ease;
      background: transparent;
      position:relative;
    }
    .prof:hover{ transform: translateY(-2px); }

    .avatar{
      width: 72px; height: 72px;
      border-radius: 999px;
      overflow:hidden;
      margin: 2px auto 8px;
      background:#fff;
      border: 3px solid rgba(255,255,255,.98);
      box-shadow:
        0 18px 34px rgba(15,23,42,.18),
        0 2px 0 rgba(255,255,255,.85) inset,
        0 -10px 18px rgba(15,23,42,.06) inset;
      position:relative;
      transform: translateZ(0);
    }
    .avatar::after{
      content:"";
      position:absolute;
      inset: -10px;
      border-radius: 999px;
      background: radial-gradient(circle at 35% 30%, rgba(255,255,255,.45), rgba(255,255,255,0) 55%);
      pointer-events:none;
    }
    .avatar img{ width:100%; height:100%; object-fit:cover; }
    .pname{ text-align:center; font-weight:950; font-size:12px; line-height:1.1; }
    .psub{ text-align:center; color:var(--muted); font-size:10.5px; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

    .delProf{
      position:absolute;
      top: 6px;
      right: 8px;
      width: 24px;
      height: 24px;
      border-radius: 999px;
      border: none;
      background:#fff;
      box-shadow: 0 12px 24px rgba(15,23,42,.16);
      cursor:pointer;
      font-weight: 950;
      line-height: 1;
      display:flex;
      align-items:center;
      justify-content:center;
      color:#0f172a;
    }

        /* ✅ MOBILE: Top del mes horizontal (5 cards en fila) */
    @media (max-width: 640px){
      .top-month{
        height:auto; min-height:0; max-height:none;
        padding: 12px 12px 16px;
      }

      .tpStage{
        grid-template-columns: none;
        display: flex;
        align-items: stretch;
        gap: 12px;
        overflow-x: auto;
        overflow-y: hidden;
        padding: 10px 6px 6px;
        -webkit-overflow-scrolling: touch;
        scroll-snap-type: x mandatory;
        transform: none;
        margin-top: 10px;
      }

      .tpCard{
        flex: 0 0 148px;               /* tamaño consistente */
        scroll-snap-align: start;
        transform: none !important;
      }
      .tpSmall,
      .tpWinner{
        transform: none !important;
      }

      .tpCrown{ display:none; }        /* en mobile molesta más de lo que suma */

      .tpRing{ width: 58px; height: 58px; }
      .tpPic{ width: 42px; height: 42px; }

      .tpName{ font-size: 12px; }
      .tpMeta{ font-size: 11px; }
    }


    /* ===== Modal ===== */
    .overlay{ position:fixed; inset:0; z-index:9998; display:none; align-items:center; justify-content:center; background: rgba(15,23,42,.50); backdrop-filter: blur(6px); }
    .modal{
      width: min(1240px, 96vw);
      height: min(86vh, 860px);
      background: var(--panel);
      border-radius: 30px;
      border: 1px solid rgba(15,23,42,.08);
      box-shadow:
        0 28px 70px rgba(15,23,42,.24),
        0 2px 0 rgba(255,255,255,.85) inset;
      overflow:hidden;
      display:flex;
      flex-direction:column;
      position:relative;
    }
    .close{
      position:absolute; top:12px; right:12px;
      width:42px; height:42px;
      border-radius:999px;
      border:1px solid rgba(15,23,42,.08);
      background:#fff;
      cursor:pointer;
      box-shadow: 0 18px 34px rgba(15,23,42,.16), 0 1px 0 rgba(255,255,255,.90) inset;
      display:flex; align-items:center; justify-content:center;
      z-index: 80;
    }
    .close svg{ width:16px; height:16px; }

    /* ============================================================
       ✅ TOP DEL MES COMPACTO
       ============================================================ */
    #topMonth .top-month-head,
    #topMonth .top-row{ display:none !important; }

    .top-month{
      padding: 10px 14px 10px !important;
      border-radius: 26px !important;
      background: #F5F7FB !important;
      box-shadow:
        0 18px 42px rgba(15,23,42,.10),
        0 2px 0 rgba(255,255,255,.82) inset,
        0 -18px 24px rgba(15,23,42,.03) inset !important;

      height: 190px !important;
      min-height: 190px !important;
      max-height: 190px !important;
      position: relative !important;
      overflow: hidden !important;
    }

    .top-month::before{
      inset:-20% !important;
      opacity:.28 !important;
      filter: blur(22px) !important;
      animation: none !important;
      background:
        radial-gradient(circle at 40% 10%, rgba(255,255,255,.85), rgba(255,255,255,0) 55%),
        radial-gradient(circle at 82% 26%, rgba(248,193,96,.18), rgba(248,193,96,0) 55%),
        radial-gradient(circle at 18% 62%, rgba(59,130,246,.12), rgba(59,130,246,0) 55%) !important;
    }

    .top-month::after{
      content:"";
      position:absolute;
      inset: 10px;
      border-radius: 22px;
      border: 2px solid rgba(255,255,255,.55);
      box-shadow: 0 0 0 1px rgba(15,23,42,.04);
      pointer-events:none;
      z-index: 1;
    }

    .tpHead{ position: relative; z-index: 3; text-align:left; margin-top: -4px; padding-left: 8px; }
    .tpTitle{ font-weight: 950; font-size: 16px; letter-spacing: -0.02em; color: rgba(15,23,42,.62); line-height: 1; }
    .tpSub2{ margin-top: 2px; font-weight: 900; font-size: 10.5px; color: rgba(100,116,139,.55); }
      .tpControls{
  position: relative;
  z-index: 3;
  margin-top: 4px;
  padding: 0 8px;
  display:flex;
  align-items:center;
  justify-content:flex-start;
  gap: 10px;
}
.tpSelectWrap{
  position: relative;
  display: inline-flex;
  align-items: center;
}
.tpSelect{
  height: 34px;
  padding: 0 14px;
  padding-right: 36px;
  border-radius: 999px;
  border: 1px solid rgba(15,23,42,.10);
  background: #fff;
  cursor:pointer;
  font-weight: 950;
  box-shadow: 0 16px 30px rgba(15,23,42,.10);
  font-size: 12px;
  color: rgba(15,23,42,.78);
  outline:none;
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
  background-image: none;
}
.tpSelectChevron{
  position:absolute;
  right: 14px;
  width: 16px;
  height: 16px;
  pointer-events:none;
  opacity: .55;
  color: rgba(15,23,42,.78);
}

.tpSelect:focus{
  box-shadow: 0 0 0 4px rgba(245,190,94,.25), 0 16px 30px rgba(15,23,42,.10);
  border-color: rgba(245,190,94,.65);
}
/* ✅ iOS (solo PC) — selects Ranking/Materia */
  @media (min-width: 901px){
    #topMonth .tpControls{ justify-content:flex-start !important; }
    #topMonth .tpControls{ margin-right:auto !important; }
  .tpSelect{
    height: 34px;
    background: rgba(255,255,255,.62);
    border: 1px solid rgba(15,23,42,.10);
    box-shadow: 0 20px 46px rgba(15,23,42,.14), 0 1px 0 rgba(255,255,255,.85) inset;
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    padding-left: 16px;
    padding-right: 38px;
  }

  /* ✅ PC: achica un poco el Top para que no sobresalga del recuadro */
  .tpRing{ width: 62px; height: 62px; margin-bottom: 4px; }
  .tpPic{ width: 44px; height: 44px; }
  .tpWinner .tpRing{ width: 70px; height: 70px; margin-bottom: 4px; }
  .tpWinner .tpPic{ width: 50px; height: 50px; }
  .tpCrown{ top: -14px; width: 30px; height: 30px; }
  .tpStars{ margin-top: 3px; gap: 4px; }
  .tpSelect:hover{ filter: brightness(1.01); }
  .tpSelect:focus{ box-shadow: 0 0 0 4px rgba(245,190,94,.22), 0 20px 46px rgba(15,23,42,.14); }
}
    .tpSelect{
      height: 34px;
      padding: 0 14px;
      border-radius: 999px;
      border: 1px solid rgba(15,23,42,.10);
      background: #fff;
      cursor:pointer;
      font-weight: 950;
      box-shadow: 0 16px 30px rgba(15,23,42,.10);
      font-size: 12px;
      color: rgba(15,23,42,.78);
      outline:none;
      max-width: 220px;
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      -webkit-appearance: none;
      -moz-appearance: none;
      appearance: none;
      padding-right: 34px;
      background-image:
        linear-gradient(45deg, transparent 50%, rgba(15,23,42,.55) 50%),
        linear-gradient(135deg, rgba(15,23,42,.55) 50%, transparent 50%),
        linear-gradient(to right, transparent, transparent);
      background-position:
        calc(100% - 18px) 14px,
        calc(100% - 13px) 14px,
        0 0;
      background-size:
        5px 5px,
        5px 5px,
        100% 100%;
      background-repeat: no-repeat;
    }
    .tpSelect:focus{
      box-shadow: 0 0 0 4px rgba(245,190,94,.25), 0 16px 30px rgba(15,23,42,.10);
      border-color: rgba(245,190,94,.65);
    }
        /* ✅ iOS (solo PC) — selects Ranking/Materia */
    @media (min-width: 901px){
      .tpControls{ justify-content:flex-end; }
      .tpSelect{
        height: 38px;
        background: rgba(255,255,255,.62);
        border: 1px solid rgba(15,23,42,.10);
        box-shadow: 0 20px 46px rgba(15,23,42,.14), 0 1px 0 rgba(255,255,255,.85) inset;
        backdrop-filter: blur(16px) saturate(160%);
        -webkit-backdrop-filter: blur(16px) saturate(160%);
        padding-left: 16px;
        padding-right: 38px;
      }
      .tpSelect:hover{ filter: brightness(1.01); }
      .tpSelect:focus{ box-shadow: 0 0 0 4px rgba(245,190,94,.22), 0 20px 46px rgba(15,23,42,.14); }
    }

    .tpStage{
