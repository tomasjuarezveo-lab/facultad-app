    sendRate.disabled = true;

    if (!currentStars || currentStars < 1){
      rateNote.textContent = 'Elegí una calificación de estrellas (1 a 5).';
      sendRate.disabled = false;
      return;
    }

    const commentText = (inComment.value || '').trim();
    if (commentText && profContainsBadWord(commentText)){
      rateNote.textContent = 'Tu comentario contiene palabras no permitidas. Por favor revisalo.';
      sendRate.disabled = false;
      return;
    }

    try{
      const ondaCompat = currentMood ? (currentMood * 2) : Number(inOnda.value || 7);
      inOnda.value = String(Math.max(1, Math.min(10, ondaCompat)));

      const payload = {
        stars: currentStars,
        rating: currentStars,
        comment: (inComment.value || '').trim(),
        mood: currentMood || null,

        group_level: Number(inGroup.value),
        biblio_level: Number(inBiblio.value),

        corre: Number(inCorre.value),
        correccion: Number(inCorre.value),
        clases: Number(inClases.value),

        onda: Number(inOnda.value),
        buena_onda: Number(inOnda.value),

        group_imp: Number(inGroup.value),
        biblio_imp: Number(inBiblio.value),

        // ✅ nuevos campos categóricos
        repite: Number(hiddenRepite?.value || 0),
        exam_imp: Number(hiddenRepite?.value || 0),
        focus: String(hiddenEnfoque?.value || 'mixto'),
        tp_imp: Number(inGroup.value),
        biblio_imp: Number(inBiblio.value),

        toma_lista: Number(hiddenLista?.value || 0),
        lista: Number(hiddenLista?.value || 0)  
      };

      const res = await fetch(`/app/profesores/${current.id}/review`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json().catch(()=>null);
      if (!res.ok || !data?.ok){
        const msg = data?.error || 'No se pudo guardar la calificación.';
        throw new Error(msg);
      }

      // ✅ Felicitaciones + confetti (solo la primera vez por usuario)
            try{
        const k = 'facultad_first_prof_rate';
        if (!localStorage.getItem(k)){
          localStorage.setItem(k, '1');
          showFirstRateOverlay(()=> window.location.reload());
          rateNote.textContent = '';
          return;
        }
      }catch(e){}

      rateNote.textContent = 'Guardado. Actualizando…';
      window.location.reload();
    }catch(err){
      rateNote.textContent = err?.message || 'Error guardando calificación.';
    }finally{
      sendRate.disabled = false;
    }
  });

  (function(){
    const openAdminBtn = document.getElementById('openAdmin');
    const adminOverlay = document.getElementById('adminOverlay');
    const adminClose = document.getElementById('adminClose');
    const adminCancel = document.getElementById('adminCancel');

    const modeSingleBtn = document.getElementById('adminModeSingleBtn');
    const modeMateriaBtn = document.getElementById('adminModeMateriaBtn');
    const modeInput = document.getElementById('admin_mode');

    const boxSingle = document.getElementById('adminModeSingle');
    const boxMateria = document.getElementById('adminModeMateria');

    const adminNameSingle = document.getElementById('adminNameSingle');
    const adminPhotoSingle = document.getElementById('adminPhotoSingle');
    const adminSubjectsSingle = document.getElementById('adminSubjectsSingle');

    const bulkNames = document.getElementById('bulkNames');
    const bulkSubject = document.getElementById('bulkSubject');
    const adminForm = document.getElementById('adminForm');
    const adminSubmitBtn = document.getElementById('adminSubmitBtn');
    const bulkNote = document.getElementById('bulkNote');

    function paint(btn, active){
      if(!btn) return;
      btn.style.background = active ? '#0f172a' : '#fff';
      btn.style.color = active ? '#fff' : '#0f172a';
    }

    function setMode(mode){
      const isMateria = String(mode||'single') === 'materia';
      if(modeInput) modeInput.value = isMateria ? 'materia' : 'single';

      if(boxSingle) boxSingle.style.display = isMateria ? 'none' : '';
      if(boxMateria) boxMateria.style.display = isMateria ? '' : 'none';

      if(adminNameSingle){
        adminNameSingle.disabled = isMateria;
        adminNameSingle.required = !isMateria;
      }
      if(adminPhotoSingle) adminPhotoSingle.disabled = isMateria;
      if(adminSubjectsSingle) adminSubjectsSingle.disabled = isMateria;

      if(bulkNames){
        bulkNames.disabled = !isMateria;
        bulkNames.required = isMateria;
      }
      if(bulkSubject){
        bulkSubject.disabled = !isMateria;
        bulkSubject.required = isMateria;
      }

      if(modeSingleBtn){
        modeSingleBtn.setAttribute('aria-pressed', String(!isMateria));
        paint(modeSingleBtn, !isMateria);
      }
      if(modeMateriaBtn){
        modeMateriaBtn.setAttribute('aria-pressed', String(isMateria));
        paint(modeMateriaBtn, isMateria);
      }
    }
    function openAdmin(){
      if(!adminOverlay) return;
      setMode('single');
      adminOverlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeAdmin(){
      if(!adminOverlay) return;
      adminOverlay.style.display = 'none';
      document.body.style.overflow = '';
    }

    async function submitBulkMateria(){
      if(!adminForm || !bulkNames || !bulkSubject) return;

      // ✅ asegurá que el backend reciba el modo correcto
      if(modeInput) modeInput.value = 'materia';

      const raw = String(bulkNames.value || '');
      const materia = String(bulkSubject.value || '').trim();

      const names = raw
        .split(/[,;\n]/)
        .map(s=>s.trim())
        .filter(Boolean);

      if(!names.length){
        if(bulkNote) bulkNote.textContent = 'Escribí al menos 1 nombre (separados por coma).';
        return;
      }
      if(!materia){
        if(bulkNote) bulkNote.textContent = 'Escribí 1 materia.';
        return;
      }

      // ✅ Normaliza para backend (bulk real por 1 solo submit)
      bulkNames.value = names.join(', ');
      bulkSubject.value = materia;

      if(bulkNote) bulkNote.textContent = `Subiendo ${names.length} profesor(es)…`;

      if(adminSubmitBtn) adminSubmitBtn.disabled = true;
      if(modeSingleBtn) modeSingleBtn.disabled = true;
      if(modeMateriaBtn) modeMateriaBtn.disabled = true;

      try{
        if(adminForm.checkValidity()){
          adminForm.submit(); // ✅ 1 solo POST con admin_mode=materia
          return;
        } else {
          if(adminForm.reportValidity) adminForm.reportValidity();
          if(bulkNote) bulkNote.textContent = 'Revisá los campos obligatorios.';
        }
      }catch(err){
        if(bulkNote) bulkNote.textContent = err?.message || 'Error subiendo profesores.';
      }finally{
        if(adminSubmitBtn) adminSubmitBtn.disabled = false;
        if(modeSingleBtn) modeSingleBtn.disabled = false;
        if(modeMateriaBtn) modeMateriaBtn.disabled = false;
      }
    }

    if(adminForm){
      adminForm.addEventListener('submit', (e)=>{
        // ✅ si está en modo materia, lo manejamos nosotros (1 submit)
        if(modeInput && modeInput.value === 'materia'){
          e.preventDefault();
          submitBulkMateria();
        }
      });
    }

    if(adminSubmitBtn){
      adminSubmitBtn.addEventListener('click', (e)=>{
        e.preventDefault();

        // ✅ modo bulk: 1 submit con admin_mode=materia
        if(modeInput && modeInput.value === 'materia'){
          submitBulkMateria();
          return;
        }

        // ✅ modo single: submit normal (con validación)
        if(!adminForm) return;
        if(adminForm.checkValidity()){
          adminForm.submit();
        } else {
          if(adminForm.reportValidity) adminForm.reportValidity();
        }
      });
    }

    if(modeSingleBtn) modeSingleBtn.addEventListener('click', ()=> setMode('single'));
    if(modeMateriaBtn) modeMateriaBtn.addEventListener('click', ()=> setMode('materia'));

    if(openAdminBtn) openAdminBtn.addEventListener('click', openAdmin);
    if(adminClose) adminClose.addEventListener('click', closeAdmin);
    if(adminCancel) adminCancel.addEventListener('click', closeAdmin);
    if(adminOverlay) adminOverlay.addEventListener('click', (e)=>{ if(e.target === adminOverlay) closeAdmin(); });
    window.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeAdmin(); });
  })();

  document.addEventListener('click', (e)=>{
    const btn = e.target.closest('.delProf');
    if(!btn) return;
    e.preventDefault();
    e.stopPropagation();

    const id = btn.getAttribute('data-del-prof-id');
    if(!id) return;

    const ok = confirm('¿Eliminar este profesor? Esta acción no se puede deshacer.');
    if(!ok) return;

    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `/app/profesores/${id}?_method=DELETE`;

    const hm = document.createElement('input');
    hm.type = 'hidden';
    hm.name = '_method';
    hm.value = 'DELETE';
    form.appendChild(hm);

    document.body.appendChild(form);
    form.submit();
  });

  document.querySelectorAll('.rowWrap').forEach(wrap=>{
    const row = wrap.querySelector('.row');
    const left = wrap.querySelector('.rowNav.left');
    const right = wrap.querySelector('.rowNav.right');
    if(!row || !left || !right) return;

    function scrollByX(dir){
      const amt = Math.round(row.clientWidth * 0.75) * dir;
      row.scrollBy({ left: amt, behavior: 'smooth' });
    }

    left.addEventListener('click', (e)=>{ e.preventDefault(); e.stopPropagation(); scrollByX(-1); });
    right.addEventListener('click', (e)=>{ e.preventDefault(); e.stopPropagation(); scrollByX(1); });
  });

  // ============================================================
// ✅ TOP 5 (Mejores/Peores) + filtro por materia (sin recargar)
// ============================================================
const tpStage = document.getElementById('tpStage');
const tpEmpty = document.getElementById('tpEmpty');
const tpRankSel = document.getElementById('tpRankSel');
const tpMatSel  = document.getElementById('tpMatSel');

function normTop(s){
  return String(s||'')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g,'')
    .replace(/\s+/g,' ')
    .trim();
}

function splitSubjectsTop(txt){
  return String(txt||'')
    .split(/[,;\n]/)
    .map(s=>s.trim())
    .filter(Boolean);
}

function tpStarSVG(active){
  return `<svg viewBox="0 0 24 24" fill="currentColor" style="opacity:${active?1:.25}"><path d="M12 17.3l-6.18 3.64 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.67 1.64 7.03L12 17.3z"/></svg>`;
}

function tpCrownSVG(){
  return `<svg class="tpCrown" viewBox="0 0 128 128" aria-hidden="true">
    <defs>
      <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#FFD89A"/>
        <stop offset="55%" stop-color="#F8C160"/>
        <stop offset="100%" stop-color="#E9A826"/>
      </linearGradient>
    </defs>
    <path d="M18 92h92c6 0 10 4 10 10v6H8v-6c0-6 4-10 10-10z" fill="url(#gold)"/>
    <path d="M22 88l10-44 22 22 10-36 10 36 22-22 10 44H22z" fill="url(#gold)"/>
    <circle cx="32" cy="44" r="8" fill="#FFE9BF"/>
    <circle cx="64" cy="30" r="9" fill="#FFE9BF"/>
    <circle cx="96" cy="44" r="8" fill="#FFE9BF"/>
  </svg>`;
}

function tpCardHtml(p, cls){
  const avatar = (p.photo_url && String(p.photo_url).trim())
    ? p.photo_url
    : `https://ui-avatars.com/api/?name=${encodeURIComponent(p.name)}`;

  const avg = Math.max(0, Math.min(5, Number(p.avg||0)));
  const r = Math.round(avg);

  return `
    <div class="tpCard ${cls||''}" data-prof-id="${p.id}">
      <div class="tpRing">
        ${cls === 'tpWinner' ? tpCrownSVG() : ''}
        <div class="tpPic"><img src="${avatar}" alt="${String(p.name||'')}"></div>
      </div>
      <div class="tpName">${escapeHtml(p.name||'')}</div>
      <div class="tpStars">${Array.from({length:5}, (_,i)=>tpStarSVG(i+1<=r)).join('')}</div>
    </div>
  `;
}

function fillMateriaOptions(){
  if(!tpMatSel) return;

  const src = Array.isArray(PROFESSORS_ALL) ? PROFESSORS_ALL : [];
  const set = new Map(); // norm -> original
  for (const p of src){
    const subs = splitSubjectsTop(p.subjects_text || p.subjects || '');
    for (const s of subs){
      const nk = normTop(s);
      if(!nk) continue;
      if(!set.has(nk)) set.set(nk, s);
    }
  }

  const items = Array.from(set.entries())
    .map(([nk, orig])=>({ nk, orig }))
    .sort((a,b)=> a.orig.localeCompare(b.orig, 'es', { sensitivity:'base' }));

  tpMatSel.innerHTML = `<option value="__all__" selected>Todas las materias</option>` +
    items.map(it=> `<option value="${escapeHtml(it.nk)}">${escapeHtml(it.orig)}</option>`).join('');
}

  function computeTop(){
    const src = Array.isArray(PROFESSORS_ALL) ? PROFESSORS_ALL : [];
    const mode = tpRankSel ? String(tpRankSel.value||'best') : 'best';
    const matKey = tpMatSel ? String(tpMatSel.value||'__all__') : '__all__';

    let list = src.slice();

    if(matKey !== '__all__'){
      list = list.filter(p=>{
        const subs = splitSubjectsTop(p.subjects_text || '');
        return subs.some(s => normTop(s) === matKey);
      });
    }

    if(mode === 'worst'){
      list = list.filter(p => Number(p.count||0) > 0);
    }

    list.sort((a,b)=>{
      const sa = Math.max(0, Math.min(5, Number(a.avg||0)));
      const sb = Math.max(0, Math.min(5, Number(b.avg||0)));
      if(mode === 'worst'){
        if (sa !== sb) return sa - sb;
      } else {
        if (sb !== sa) return sb - sa;
      }
      const ca = Number(a.count||0), cb = Number(b.count||0);
      if (cb !== ca) return cb - ca;
      return String(a.name||'').localeCompare(String(b.name||''), 'es', { sensitivity:'base' });
    });

    return list.slice(0,5);
  }

  function renderTop(){
    if(!tpStage) return;

    const top5 = computeTop();
    if (!top5.length){
      tpStage.innerHTML = '';
      if(tpEmpty) tpEmpty.style.display = '';
      return;
    }
    if(tpEmpty) tpEmpty.style.display = 'none';

    const t1 = top5[0] || null;
    const t2 = top5[1] || null;
    const t3 = top5[2] || null;
    const t4 = top5[3] || null;
    const t5 = top5[4] || null;

    tpStage.innerHTML =
      (t2 ? tpCardHtml(t2, '') : '') +
      (t3 ? tpCardHtml(t3, '') : '') +
      (t1 ? tpCardHtml(t1, 'tpWinner') : '') +
      (t4 ? tpCardHtml(t4, '') : '') +
      (t5 ? tpCardHtml(t5, '') : '');
  }

  function clampLabel(full, maxChars){
  full = String(full || '');
  if (full.length <= maxChars) return full;
  return full.slice(0, maxChars) + '...';
}

function clampSelectOptions(sel, maxChars){
  if(!sel) return;
  Array.from(sel.options).forEach(opt=>{
    const full = opt.getAttribute('data-full') || opt.textContent;
    if(!opt.getAttribute('data-full')) opt.setAttribute('data-full', full);
    opt.textContent = clampLabel(full, maxChars);
    opt.title = full;
  });

  const so = sel.options[sel.selectedIndex];
  if(so){
    const full = so.getAttribute('data-full') || so.textContent;
    sel.title = full;
  }
}

function applyTopSelectClamp(){
  const isMobile = window.matchMedia('(max-width: 430px)').matches;  // iPhone 15
  const isDesktop = window.matchMedia('(min-width: 901px)').matches; // PC
  const maxChars = isMobile ? 10 : (isDesktop ? 20 : 14);

  clampSelectOptions(tpRankSel, maxChars);
  clampSelectOptions(tpMatSel, maxChars);
  }

  function onTopSelectChange(){
    applyTopSelectClamp();
    renderTop();
  }

  fillMateriaOptions();
  applyTopSelectClamp();
  renderTop();

  if(tpRankSel) tpRankSel.addEventListener('change', onTopSelectChange);
  if(tpMatSel)  tpMatSel.addEventListener('change', onTopSelectChange);
  window.addEventListener('resize', applyTopSelectClamp);

  function norm(s){
    return String(s||'')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .replace(/\s+/g,' ')
      .trim();
  }
  const profsSearchForm = document.getElementById('profsSearchForm');
    if (profsSearchForm){
      profsSearchForm.addEventListener('submit', (e)=>{
        e.preventDefault();
        e.stopPropagation();
        return false;
      });
    }
  const qInput = document.getElementById('qInput');
    const suggestBox = document.getElementById('profsSuggest');

    function hideSuggest(){
      if(!suggestBox) return;
      suggestBox.classList.remove('is-open');
      suggestBox.setAttribute('aria-hidden','true');
      suggestBox.innerHTML = '';
    }

    function renderSuggest(q){
      if(!suggestBox) return;
      if(!q){
        hideSuggest();
        return;
      }

      const src = Array.isArray(PROFESSORS_ALL) ? PROFESSORS_ALL : [];
      const hits = [];

      for (const p of src){
        const nm = norm(p.name);
        const sb = norm(p.subjects_text);
        if (nm.includes(q) || sb.includes(q)){
          const starts = nm.startsWith(q) ? 2 : 0;
          const score = starts + (nm.includes(q) ? 1 : 0) + (sb.includes(q) ? 0.25 : 0);
          hits.push({ p, score });
        }
      }

      hits.sort((a,b)=> b.score - a.score || String(a.p.name||'').localeCompare(String(b.p.name||''), 'es', { sensitivity:'base' }));
      const top = hits.slice(0, 8).map(x=>x.p);

      if(!top.length){
        hideSuggest();
        return;
      }

      suggestBox.innerHTML = top.map(p=>{
        const subj = (p.subjects_text && String(p.subjects_text).trim()) ? String(p.subjects_text) : 'Sin materias asignadas';
        return `
          <button type="button" class="profsSuggestItem" data-prof-id="${String(p.id)}">
            <div class="profsSuggestMain">
              <div class="profsSuggestName">${escapeHtml(String(p.name||''))}</div>
              <div class="profsSuggestSub">${escapeHtml(subj)}</div>
            </div>
            <div class="profsSuggestChip">ver</div>
          </button>`;
      }).join('');

      suggestBox.classList.add('is-open');
      suggestBox.setAttribute('aria-hidden','false');
    }

    function applyClientFilter(){
      const q = norm(qInput ? qInput.value : '');
      const profs = document.querySelectorAll('.prof[data-prof-id]');
      const sections = document.querySelectorAll('.section');

      if(!q){
        profs.forEach(p=> p.style.display = '');
        sections.forEach(s=> s.style.display = '');
        renderSuggest('');
        return;
      }

      profs.forEach(card=>{
        const nm = norm(card.getAttribute('data-name'));
        const sb = norm(card.getAttribute('data-subjects'));
        const ok = nm.includes(q) || sb.includes(q);
        card.style.display = ok ? '' : 'none';
      });

      sections.forEach(sec=>{
        const visible = Array.from(sec.querySelectorAll('.prof[data-prof-id]')).some(p => p.style.display !== 'none');
        sec.style.display = visible ? '' : 'none';
      });

      renderSuggest(q);
    }

    if(qInput){
      qInput.addEventListener('input', applyClientFilter);
      qInput.addEventListener('focus', applyClientFilter);
      qInput.addEventListener('keydown', (e)=>{
      if(e.key === 'Escape'){
        hideSuggest();
        qInput.blur();
        return;
      }
      if(e.key === 'Enter'){
        e.preventDefault();
        e.stopPropagation();

        // si el dropdown está abierto, abre el primer resultado
        if (suggestBox && suggestBox.classList.contains('is-open')){
          const first = suggestBox.querySelector('.profsSuggestItem');
          if(first){
            first.click();
            return;
          }
        }

        // si no hay dropdown, solo filtra (sin navegar)
        applyClientFilter();
        hideSuggest();
        return;
      }
    });

      document.addEventListener('click', (e)=>{
        if(!suggestBox) return;
        const inside = e.target && (e.target.closest ? e.target.closest('.profsSearch') : null);
        if(!inside) hideSuggest();
      });

      if(suggestBox && !suggestBox.__wired){
        suggestBox.__wired = true;
        suggestBox.addEventListener('click', (e)=>{
          const btn = e.target && (e.target.closest ? e.target.closest('.profsSuggestItem') : null);
          if(!btn) return;
          const id = String(btn.getAttribute('data-prof-id') || '').trim();
          if(!id) return;
          const p = (Array.isArray(PROFESSORS_ALL) ? PROFESSORS_ALL : []).find(x => String(x.id) === id);
          if (!p) return;
          hideSuggest();
          if(qInput) qInput.value = p.name || '';
          applyClientFilter();
          openProfModal(p);
        });
      }

      applyClientFilter();
    }
</script>
