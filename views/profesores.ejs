  document.addEventListener('click', async (e) => {
    // Admin: borrar comentario
    const del = e.target.closest('.cDelBtn');
    if (del){
      const card = del.closest('[data-review-id]');
      if (!card) return;
      const rid = Number(card.getAttribute('data-review-id'));
      if (!rid) return;
      if (!confirm('¿Eliminar este comentario?')) return;
      try{
        const res = await fetch(`/app/reviews/${rid}/delete`, { method:'POST', headers:{ 'Content-Type':'application/json', 'Accept':'application/json' }, body: '{}' });
        const data = await res.json().catch(()=>null);
        if (!res.ok || !data?.ok) throw new Error(data?.error || 'Error');
        // quitar del DOM
        card.remove();
        // quitar de memoria
        if (current && Array.isArray(current.ratings)) current.ratings = current.ratings.filter(x => Number(x.id) !== rid);
      }catch(err){ console.error(err); }
      return;
    }

    const btn = e.target.closest('.cVoteBtn');
    if (!btn) return;
    const card = btn.closest('[data-review-id]');
    if (!card) return;

    // evita dobles clicks mientras pide al server
    if (card.dataset.voting === '1') return;
    card.dataset.voting = '1';

    const rid = Number(card.getAttribute('data-review-id'));
    const vote = Number(btn.getAttribute('data-vote'));

    const likeBtn = card.querySelector('.cVoteBtn[data-vote="1"]');
    const disBtn  = card.querySelector('.cVoteBtn[data-vote="-1"]');
    const likeNEl = card.querySelector('[data-kind="likes"]');
    const disNEl  = card.querySelector('[data-kind="dislikes"]');

    // estado actual (desde memoria si existe, sino desde DOM)
    let it = null;
    if (current && Array.isArray(current.ratings)){
      it = current.ratings.find(x => Number(x.id) === rid) || null;
    }

    const prev = {
      my_vote: it ? Number(it.my_vote||0)
                 : (likeBtn?.classList.contains('active') ? 1 : (disBtn?.classList.contains('active') ? -1 : 0)),
      likes: it ? Number(it.likes||0) : 0,
      dislikes: it ? Number(it.dislikes||0) : 0,
    };

    const nextVote = (prev.my_vote === vote) ? 0 : vote;

    // ===== UI optimista (instantáneo) =====
    let optLikes = prev.likes;
    let optDis   = prev.dislikes;

    if (prev.my_vote === 1) optLikes -= 1;
    if (prev.my_vote === -1) optDis -= 1;
    if (nextVote === 1) optLikes += 1;
    if (nextVote === -1) optDis += 1;

    optLikes = Math.max(0, optLikes);
    optDis   = Math.max(0, optDis);

    likeBtn && likeBtn.classList.toggle('active', nextVote === 1);
    disBtn  && disBtn.classList.toggle('active', nextVote === -1);
    if (likeNEl) likeNEl.textContent = fmtCount(optLikes);
    if (disNEl)  disNEl.textContent  = fmtCount(optDis);

    // memoria optimista (para que si re-renderiza no "vuelva atrás")
    if (it){
      it.likes = optLikes;
      it.dislikes = optDis;
      it.my_vote = nextVote;
    }

    try{
      const res = await fetch(`/app/reviews/${rid}/vote`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ vote: nextVote })
      });
      const data = await res.json().catch(()=>null);
      if (!res.ok || !data || !data.ok) throw new Error(data?.error || 'Error');

      likeBtn && likeBtn.classList.toggle('active', Number(data.my_vote) === 1);
      disBtn  && disBtn.classList.toggle('active', Number(data.my_vote) === -1);
      if (likeNEl) likeNEl.textContent = fmtCount(data.likes);
      if (disNEl)  disNEl.textContent  = fmtCount(data.dislikes);

      if (it){
        it.likes = data.likes;
        it.dislikes = data.dislikes;
        it.my_vote = data.my_vote;
      }

      // confetti primera vez que vota (solo si realmente votó algo)
            try{
        const k = 'facultad_first_comment_vote';
        if (!localStorage.getItem(k) && nextVote !== 0){
          localStorage.setItem(k, '1');
          burstConfetti(btn);
        }
      }catch(e){}
    }catch(err){
      // rollback UI
      likeBtn && likeBtn.classList.toggle('active', prev.my_vote === 1);
      disBtn  && disBtn.classList.toggle('active', prev.my_vote === -1);
      if (likeNEl) likeNEl.textContent = fmtCount(prev.likes);
      if (disNEl)  disNEl.textContent  = fmtCount(prev.dislikes);

      if (it){
        it.likes = prev.likes;
        it.dislikes = prev.dislikes;
        it.my_vote = prev.my_vote;
      }

      console.error(err);
    }finally{
      delete card.dataset.voting;
    }
  });

