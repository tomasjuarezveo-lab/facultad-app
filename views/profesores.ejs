      background-size: cover;               /* Ajusta la imagen para que cubra todo el banner */
      background-position: center;          /* Centra la imagen */
      background-repeat: no-repeat;         /* Evita que la imagen se duplique */
      /* ------------------- */

      z-index: 0;
      overflow: hidden; 
    } 

    /* Rank pill (como la foto): “media pastilla” visible */
    .mRankClip{
