  function commentCard(r){
    const stars = Math.max(1, Math.min(5, Number(r.stars||0)));
    const likes = Number(r.likes||0);
    const dislikes = Number(r.dislikes||0);
    const my = Number(r.my_vote||0);

    const uname = r.user_name || r.username || r.author || r.name || 'Usuario';
    const uavatar = r.user_avatar || r.avatar || r.photo_url || r.userPhoto || '';
    const initials = String(uname).trim().split(/\s+/).slice(0,2).map(s=>s[0]?.toUpperCase()||'U').join('');
    const avatarHtml = uavatar
      ? `<img src="${escapeHtml(uavatar)}" alt="${escapeHtml(uname)}">`
