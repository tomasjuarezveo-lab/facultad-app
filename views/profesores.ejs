  let activeStarFilter = 0;

  function renderComments(p){
    const arr = Array.isArray(p.ratings) ? p.ratings : [];
    const filtered = activeStarFilter
      ? arr.filter(r => Number(r.stars||0) === activeStarFilter)
      : arr;

    const sorted = filtered.slice().sort((a,b)=>{
      const al = Number(a.likes||0), bl = Number(b.likes||0);
      if(bl !== al) return bl - al;
      const ad = Number(a.dislikes||0), bd = Number(b.dislikes||0);
      if(ad !== bd) return ad - bd;
      const at = new Date(a.created_at||a.createdAt||0).getTime();
      const bt = new Date(b.created_at||b.createdAt||0).getTime();
      return bt - at;
    });

    commentsEl.innerHTML = sorted.length
      ? sorted.map(commentCard).join('')
      : `<div class="cCard cEmpty" style="grid-template-columns:1fr; text-align:center;">
        <div class="cEmptyTxt">Todavía no hay comentarios.</div>
         </div>`;
  }

