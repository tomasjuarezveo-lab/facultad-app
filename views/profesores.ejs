  function fmtCount(n){
    n = Number(n||0);
    if (!n) return '0';
    if (n < 1000) return String(n);
    if (n < 10000){
      let s = (n/1000).toFixed(2);
      s = s.replace(/\.00$/,'').replace(/0$/,'');
      return s + 'k';
    }
    let s = (n/1000).toFixed(1);
    s = s.replace(/\.0$/,'');
    return s + 'k';
  }

  function escapeHtml(str){
    return String(str||'')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }
    function trunc20_ellipsisIfOver30(str){
    const t = String(str||'');
    return (t.length > 30) ? (t.slice(0,20) + '...') : t;
  }

  function badgeSVGFor(avg, count){
    const s = Number(avg||0);
    const c = Number(count||0);
    if (!c || !s){
      return `<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="#9CA3AF"></circle></svg>`;
    }
    if (s > 3){
      return `<svg viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>`;
    }
    if (s < 3){
      return `<svg viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6L6 18"></path><path d="M6 6l12 12"></path></svg>`;
    }
    return `<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="#9CA3AF"></circle></svg>`;
  }

    function openCommentFull(txt){
    if(!commentFullOverlay || !commentFullText) return;
    commentFullText.textContent = String(txt||'');
    commentFullOverlay.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    }
    function closeCommentFull(){
      if(!commentFullOverlay) return;
      commentFullOverlay.style.display = 'none';
      document.body.style.overflow = (overlay && overlay.style.display === 'flex') ? 'hidden' : '';
    }
      function openEditOverlay(){
    if(!IS_ADMIN || !editOverlay || !current) return;
    editOverlay.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    if(editId) editId.value = String(current.id||'');
    if(editName) editName.value = String(current.name||'');
    if(editPhoto) editPhoto.value = String(current.photo_url||'');
    if(editSubjects) editSubjects.value = String(current.subjects_text||'');
    if(editForm){
      editForm.action = `/app/profesores/${current.id}?_method=PUT`;
    }
  }
  function closeEditOverlay(){
    if(!editOverlay) return;
    editOverlay.style.display = 'none';
    document.body.style.overflow = (overlay && overlay.style.display === 'flex') ? 'hidden' : '';
  }

  function starSVG(active){
    return `<svg viewBox="0 0 24 24" fill="currentColor" style="opacity:${active?1:.25}"><path d="M12 17.3l-6.18 3.64 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.67 1.64 7.03L12 17.3z"/></svg>`;
  }

  function setStars(el, avg){
    const v = Math.max(0, Math.min(5, Number(avg||0)));
    const r = Math.round(v);
    el.innerHTML = Array.from({length:5}, (_,i)=>starSVG(i+1<=r)).join('');
  }

  function starIcon(){
    return `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.3l-6.18 3.64 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.67 1.64 7.03L12 17.3z"/></svg>`;
  }

  function setStarsPick(n){
    currentStars = Number(n||0);
    starsPick.querySelectorAll('button').forEach((b)=>{
      const v = Number(b.dataset.v);
      b.classList.toggle('is-on', (currentStars >= 1) && (v <= currentStars));
      b.setAttribute('aria-pressed', ((currentStars >= 1) && (v <= currentStars)) ? 'true' : 'false');
    });
  }

  function setStarsHover(n){
    const hv = Number(n||0);
    starsPick.querySelectorAll('button').forEach((b)=>{
      const v = Number(b.dataset.v);
      b.classList.toggle('is-hover', v <= hv);
    });
  }

  function clearStarsHover(){
    starsPick.querySelectorAll('button').forEach((b)=> b.classList.remove('is-hover'));
  }

  function renderStarsPick(){
    starsPick.innerHTML = Array.from({length:5}, (_,i)=>{
      const v = i+1;
      return `<button type="button" data-v="${v}" aria-label="${v} estrellas">${starIcon()}</button>`;
    }).join('');

    starsPick.querySelectorAll('button').forEach((b)=>{
      const v = Number(b.dataset.v);
      b.addEventListener('mouseenter', ()=> setStarsHover(v));
      b.addEventListener('mousemove', ()=> setStarsHover(v));
      b.addEventListener('mouseleave', clearStarsHover);
      b.addEventListener('click', ()=> setStarsPick(v));
    });

    starsPick.addEventListener('mouseleave', clearStarsHover);
    setStarsPick(0);
  }
  renderStarsPick();

  function pctFromValue(v){
    if (v === null || v === undefined || v === '') return null;
    const n = Number(v);
    if (!isFinite(n) || n <= 0) return null;
    if (n <= 3.01){
      return Math.max(0, Math.min(99, Math.round((n/3)*99)));
    }
    return Math.max(0, Math.min(100, Math.round(n*10)));
  }

  function setBar(fillEl, txtEl, value){
    const pct = pctFromValue(value);
    if (pct == null){
      fillEl.style.width = '0%';
      txtEl.textContent = 'Sin datos';
      txtEl.style.opacity = '.85';
      return;
    }
    fillEl.style.width = pct + '%';
    txtEl.textContent = pct + '%';
    txtEl.style.opacity = '1';
  }

  function thumbUpSVG(){
    return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11a2 2 0 0 0 2-2l1-7a2 2 0 0 0-2-2h-5z"/><path d="M7 22H4a2 2 0 0 1-2-2V11a2 2 0 0 1 2-2h3"/></svg>`;
  }
  function thumbDownSVG(){
    return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H6a2 2 0 0 0-2 2l-1 7a2 2 0 0 0 2 2h5z"/><path d="M17 2h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-3"/></svg>`;
  }

  function setActiveTab(which){
    [tabResumen, tabComentarios, tabCalificar].forEach(b=> b && b.classList.remove('active'));
    [paneResumen, paneComentarios, paneCalificar].forEach(p=> p && p.classList.remove('active'));

    if(which === 'resumen'){
      tabResumen && tabResumen.classList.add('active');
      paneResumen && paneResumen.classList.add('active');
    } else if(which === 'comentarios'){
      tabComentarios && tabComentarios.classList.add('active');
      paneComentarios && paneComentarios.classList.add('active');
    } else {
      tabCalificar && tabCalificar.classList.add('active');
      paneCalificar && paneCalificar.classList.add('active');
    }
  }

  if(tabResumen) tabResumen.addEventListener('click', ()=> setActiveTab('resumen'));
  if(tabComentarios) tabComentarios.addEventListener('click', ()=> setActiveTab('comentarios'));
  if(tabCalificar) tabCalificar.addEventListener('click', ()=> setActiveTab('calificar'));

  function activateSeg(container, value){
    if(!container) return;
    container.querySelectorAll('.segBtn').forEach(b=>{
      b.classList.toggle('active', String(b.dataset.v) === String(value));
    });
  }

  function bindSegToRange(container, rangeInput, labelEl, mapLabel){
    if(!container || !rangeInput) return;
    container.addEventListener('click', (e)=>{
      const btn = e.target.closest('.segBtn');
      if(!btn) return;
      const v = btn.dataset.v;
      rangeInput.value = v;
      activateSeg(container, v);
      if(labelEl){
        labelEl.textContent = mapLabel ? mapLabel(v) : String(v);
      }
    });
  }

  bindSegToRange(segCorre, inCorre, valCorre, ()=> '');
  bindSegToRange(segClases, inClases, valClases, ()=> '');
  bindSegToRange(segBiblio, inBiblio, valBiblioTxt, (v)=> ({'1':'Poco','2':'Normal','3':'Mucho'}[String(v)] || ''));
  bindSegToRange(segGroup, inGroup, valGroupTxt, (v)=> ({'1':'Innecesarias','2':'Medio','3':'importante'}[String(v)] || ''));

  if(segRepite){
    segRepite.addEventListener('click', (e)=>{
      const btn = e.target.closest('.segBtn');
      if(!btn) return;
      const v = btn.dataset.v;
      if(hiddenRepite) hiddenRepite.value = v;
      activateSeg(segRepite, v);
    });
