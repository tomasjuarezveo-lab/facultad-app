          const stage = hub.querySelector('.games-stage');
          const grid  = hub.querySelector('.games-grid');
          const btnPrev = hub.querySelector('.games-nav-left');
          const btnNext = hub.querySelector('.games-nav-right');

          let cards = [];
          let index = 0;

          function collect(){
            cards = Array.from(hub.querySelectorAll('.game-card[data-game]'));
            return cards.length > 0;
          }

          function measure(){
            if (!grid) return;
            const active = cards[index];
            if (!active) return;
            const h = active.offsetHeight || 0;
            if (h) grid.style.height = h + 'px';
          }

          // ✅ distancia relativa con wrap (loop real)
          function relWrap(i){
            const n = cards.length;
            if (n <= 1) return 0;

            // Caso especial si algún día quedaran SOLO 2 cards:
            // cuando estás en la primera, la otra aparece a la izquierda;
            // cuando estás en la segunda, la otra aparece a la derecha.
            if (n === 2){
              if (i === index) return 0;
              return (index === 0) ? -1 : 1;
            }

            let d = (i - index) % n;       // puede ser negativo
            if (d > n/2) d -= n;
            if (d < -n/2) d += n;
            return d;
          }

          function update(animated){
            if (!cards.length && !collect()) return;

            // loop seguro
            index = ((index % cards.length) + cards.length) % cards.length;

            if (stage && !animated) stage.classList.add('no-anim');

            cards.forEach((card, i) => {
              const rel = relWrap(i);

              // ✅ Mostramos también la anterior y la siguiente (más chicas y blureadas)
              let tx = 0, sc = 1, op = 1, blur = 0;

              if (rel === 0){
                tx = 0;   sc = 1;    op = 1;    blur = 0;
              } else if (rel === -1){
                tx = -78; sc = 0.86; op = 0.62; blur = 8;
              } else if (rel === 1){
                tx = 78;  sc = 0.86; op = 0.62; blur = 8;
              } else if (rel < 0){
                tx = -150; sc = 0.75; op = 0; blur = 16;
              } else {
                tx = 150;  sc = 0.75; op = 0; blur = 16;
              }

              card.style.transform = `translateX(${tx}%) scale(${sc})`;
              card.style.opacity = String(op);
              card.style.filter = `blur(${blur}px)`;
              card.style.zIndex = String(30 - Math.min(10, Math.abs(rel)));

              const isActive = (rel === 0);
              // (podés dejar sólo el activo clickeable; si querés clic en laterales, decime)
              card.style.pointerEvents = isActive ? 'auto' : 'none';
              card.setAttribute('aria-hidden', isActive ? 'false' : 'true');
              card.tabIndex = isActive ? 0 : -1;
            });

            requestAnimationFrame(() => {
              measure();
              if (stage && !animated) stage.classList.remove('no-anim');
            });
          }

          function go(delta){
            if (!cards.length && !collect()) return;
            index = (index + delta) % cards.length;
            if (index < 0) index += cards.length;
            update(true);
          }

          if (btnPrev) btnPrev.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); go(-1); });
          if (btnNext) btnNext.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); go(1); });

          window.addEventListener('resize', () => update(false));

          const obs = new MutationObserver(() => {
            const isHidden = hub.style.display === 'none';
            if (!isHidden) update(false);
          });
          obs.observe(hub, { attributes: true, attributeFilter: ['style'] });

          update(false);
        })();


  const MAX_SLICES = 5, MIN_SLICES = 2;
  let sliceCount = Math.max(MIN_SLICES, Math.min(MAX_SLICES, (ALL_SUBJECTS.length || 2)));
  let slices = [];

  // ===== Modo “configuración”: hasta que el usuario elija materias, NO mostramos nombres =====
  let selecting = true;
  const chosenIds = new Set();

  function _sid(v){ return String(v ?? ''); }

  // Devuelve materias disponibles para el slice actual:
  // - No muestra las ya elegidas
  // - PERO deja ver la materia actual del slice (para no “desaparecerla” al reabrir)
  function getAvailableSubjectsForSlice(sliceIndex){
    const currentId = _sid(slices?.[sliceIndex]?.id);
    return (ALL_SUBJECTS || []).filter(s => {
      const id = _sid(s.id);
      return !chosenIds.has(id) || (currentId && id === currentId);
    });
  }

  // Búsqueda “tolerante”: Administración 1 ~ Administración I
  function normKey(str){
    let t = String(str || '')
      .toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g,'')   // sin tildes
      .replace(/\./g,' ')
      .replace(/\s+/g,' ')
      .trim();

    // roman -> arabic (i, ii, iii, iv, v, vi, vii, viii, ix, x)
    const roman = {
      ' x ': ' 10 ', ' ix ': ' 9 ', ' viii ': ' 8 ', ' vii ': ' 7 ',
      ' vi ': ' 6 ', ' v ': ' 5 ', ' iv ': ' 4 ', ' iii ': ' 3 ',
      ' ii ': ' 2 ', ' i ': ' 1 '
    };
    t = ` ${t} `;
    Object.keys(roman).forEach(k => { t = t.replaceAll(k, roman[k]); });
    t = t.trim();

    return t;
  }

    // =========================================================
  // ✅ Fetch de pregunta "SMART" (Subasta) — soporta ID y NOMBRE
  // Devuelve: { text, options[], answer } o null
  // =========================================================
// =========================================================
// ✅ Fetch de pregunta "SMART" (Subasta) — FIX REAL
// - prueba primero /app (tu backend real), luego /api, luego root
// - soporta subjectId y subjectName
// - normaliza muchas formas de respuesta
// =========================================================
async function fetchRandomQuizSmart(subjectId, subjectName){
  const sid = String(subjectId ?? '').trim();
  const sname = String(subjectName ?? '').trim();

  // ✅ Tu app normalmente responde en /app/...
  const BASES = ['/app', '/api', '']; // orden IMPORTANTE

  const ENDPOINTS = [
    '/quizzes/random',
    '/questions/random',
    '/quiz/random',
    '/quizzes',
    '/questions'
  ];

  const tries = [];

  // helpers para armar URLs
  function addGet(base, path, qs){
    const url = (base ? `${base}${path}` : path) + (qs ? `?${qs}` : '');
    tries.push({ url, method: 'GET' });
  }
  function addPost(base, path, body){
    const url = base ? `${base}${path}` : path;
    tries.push({ url, method: 'POST', body });
  }

  // 1) GET por ID
  if (sid){
    const qsList = [
      `subjectId=${encodeURIComponent(sid)}`,
      `id=${encodeURIComponent(sid)}`,
      `subject_id=${encodeURIComponent(sid)}`
    ];
    for (const base of BASES){
      for (const ep of ENDPOINTS){
        for (const qs of qsList) addGet(base, ep, qs);
      }
      // POST fallback
      addPost(base, '/quizzes/random', { subjectId: sid });
      addPost(base, '/questions/random', { subjectId: sid });
    }
  }

  // 2) GET por NOMBRE (muchas implementaciones usan esto)
  if (sname){
    const qsList = [
      `subject=${encodeURIComponent(sname)}`,
      `subjectName=${encodeURIComponent(sname)}`,
      `name=${encodeURIComponent(sname)}`
    ];
    for (const base of BASES){
      for (const ep of ENDPOINTS){
        for (const qs of qsList) addGet(base, ep, qs);
      }
      // POST fallback
      addPost(base, '/quizzes/random', { subject: sname, subjectName: sname, name: sname });
      addPost(base, '/questions/random', { subject: sname, subjectName: sname, name: sname });
    }
  }

  function normalizeOne(obj){
    if (!obj || typeof obj !== 'object') return null;

    const text =
      obj.text ?? obj.question ?? obj.q ?? obj.prompt ?? obj.enunciado ?? obj.pregunta ?? null;

    let options =
      obj.options ?? obj.choices ?? obj.answers ?? obj.opciones ?? obj.respuestas ?? null;

    let answer =
      obj.answer ?? obj.correctIndex ?? obj.correct ?? obj.ok ?? obj.correct_answer ?? obj.correctAnswer ?? null;

    if (!text || !Array.isArray(options) || options.length < 2) return null;

    // options puede venir como array de objetos
    options = options.map(o => {
      if (o && typeof o === 'object'){
        return String(o.text ?? o.label ?? o.value ?? o.option ?? '');
      }
      return String(o);
    }).map(s => String(s ?? ''));

    // Si answer viene como texto, lo convertimos a índice si coincide
    if (typeof answer === 'string'){
      const idx = options.findIndex(o => String(o).trim() === String(answer).trim());
      answer = idx >= 0 ? idx : 0;
    }

    answer = Number.isFinite(Number(answer)) ? Number(answer) : 0;

    return {
      text: String(text),
      options,
      answer
    };
  }

  const debugFails = [];

  async function tryFetch(t){
    try{
      const init = { method: t.method || 'GET', headers: {} };
      if (t.method === 'POST'){
        init.headers['Content-Type'] = 'application/json';
        init.body = JSON.stringify(t.body || {});
      }

      const res = await fetch(t.url, init);
      if (!res.ok){
        debugFails.push(`${res.status} ${t.url}`);
        return null;
      }

      // algunos backends devuelven JSON, otros texto JSON
      let data = null;
      const ct = String(res.headers.get('content-type') || '');
      if (ct.includes('application/json')){
        data = await res.json();
      } else {
        const txt = await res.text();
        try{ data = JSON.parse(txt); }catch{ data = null; }
      }
      if (!data) return null;

      // A veces viene {question:{...}} o {questions:[...]}
      const direct = normalizeOne(data);
      if (direct) return direct;

      if (data && typeof data === 'object'){
        if (data.question){
          const q1 = normalizeOne(data.question);
          if (q1) return q1;
        }
        if (Array.isArray(data.questions) && data.questions.length){
          const pick = data.questions[(Math.random()*data.questions.length)|0];
          const q2 = normalizeOne(pick);
          if (q2) return q2;
        }
        if (Array.isArray(data) && data.length){
          const pick = data[(Math.random()*data.length)|0];
          const q3 = normalizeOne(pick);
          if (q3) return q3;
        }
      }

      return null;
    }catch(e){
      debugFails.push(`ERR ${t.url}`);
      return null;
    }
  }

  for (const t of tries){
    const q = await tryFetch(t);
    if (q) return q;
  }

  // ✅ si no encontró, al menos te deja rastro REAL en consola
  if (debugFails.length){
    console.warn('[Subasta] No encontró preguntas. Intentos fallidos:', debugFails.slice(0, 12));
  } else {
    console.warn('[Subasta] No encontró preguntas (sin respuestas).');
  }
  return null;
}


