    function renderHearts(){
      const livesEl = document.getElementById('hpLives');
      const heartsEl = document.getElementById('hpHearts');
      if (!livesEl || !heartsEl) return;

      const n = Math.max(0, Math.min(5, parseInt(String(livesEl.textContent||'0'),10) || 0));
      // Mostramos 3 "slots" por defecto (como tu juego), pero se adapta si algún día cambias.
      const slots = Math.max(3, n);

      heartsEl.innerHTML = '';
      for (let i=0;i<slots;i++){
        const s = document.createElement('span');
        s.className = 'h' + (i < n ? '' : ' off');
        heartsEl.appendChild(s);
      }
    }

  (function setupHeartsObserver(){
    const livesEl = document.getElementById('hpLives');
    if (!livesEl) return;
    renderHearts();
    const mo = new MutationObserver(()=> renderHearts());
    mo.observe(livesEl, { childList:true, subtree:true, characterData:true });
  })();


