      // correcto: seguimos (resetea timer al empezar la siguiente)
      if (hpMsg) hpMsg.textContent = '✅ Bien. Seguimos…';

      // ¿terminó el total 15?
      const totalAnswered = (hpRound-1)*HP_PER_ROUND + hpInRound;
      if (totalAnswered >= (HP_ROUNDS*HP_PER_ROUND)){
        hpWinAll();
        return;
      }

            // ✅ fin de ronda (cada 3 preguntas)
        if (hpInRound === HP_PER_ROUND){
          try{ window.__SFX && window.__SFX.play('win'); }catch(_){}
        }

      setTimeout(()=> hpNextQuestion(), 520);
    }

