            b.disabled = false;
            b.addEventListener('click', ()=> hpAnswer(i));
            hpOpts.appendChild(b);
          });
        }

        // 3) Y recién ahí empieza el timer real (25/15/10)
        hpStartTimer();
        hpActive = true;
        if (hpMsg) hpMsg.textContent = '';
