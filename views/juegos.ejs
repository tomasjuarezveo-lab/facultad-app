    const subjOverlay = document.getElementById('subjPickerOverlay');
    const subjClose   = document.getElementById('subjPickerClose');
    const subjSearch  = document.getElementById('subjPickerSearch');
    const subjList    = document.getElementById('subjPickerList');
    let __onPickSubject = null;

      function normTxt(s){
        let t = String(s||'')
          .toLowerCase()
          .normalize('NFD').replace(/[\u0300-\u036f]/g,'');

        // Romanos -> Arábigos (I..X) como palabras completas
        const map = { x:'10', ix:'9', viii:'8', vii:'7', vi:'6', v:'5', iv:'4', iii:'3', ii:'2', i:'1' };
        t = t.replace(/\b(x|ix|viii|vii|vi|v|iv|iii|ii|i)\b/g, (m)=> map[m] || m);

        // limpiar y compactar
        t = t.replace(/[^a-z0-9]+/g,' ').replace(/\s+/g,' ').trim();
        return t;
      }

    function openSubjectPicker(onPick){
      __onPickSubject = (typeof onPick === 'function') ? onPick : null;
      if (!subjOverlay) return;
      subjOverlay.classList.add('show');
      subjOverlay.setAttribute('aria-hidden','false');
      if (subjSearch){
        subjSearch.value = '';
        setTimeout(()=> subjSearch.focus(), 0);
      }
      renderSubjectList('');
    }

    function closeSubjectPicker(){
      if (!subjOverlay) return;
      subjOverlay.classList.remove('show');
      subjOverlay.setAttribute('aria-hidden','true');
      __onPickSubject = null;
    }

    function renderSubjectList(q){
      const query = normTxt(q);
      const items = (Array.isArray(ALL_SUBJECTS) ? ALL_SUBJECTS : [])
        .filter(s => s && s.id != null && s.name)
        .filter(s => !query || normTxt(s.name).includes(query))
        .slice(0, 200);

      if (!subjList) return;
      subjList.innerHTML = items.map(s => `
        <button type="button" class="subj-item" data-id="${s.id}">
          ${s.name}
          <small>ID: ${s.id}</small>
        </button>
      `).join('') || `<div style="padding:10px;font-weight:900;color:#64748b;">No se encontraron materias.</div>`;
    }

    subjOverlay && subjOverlay.addEventListener('click', (e)=>{
      if (e.target === subjOverlay) closeSubjectPicker();
    });
    subjClose && subjClose.addEventListener('click', closeSubjectPicker);
    subjSearch && subjSearch.addEventListener('input', (e)=> renderSubjectList(e.target.value || ''));

    subjList && subjList.addEventListener('click', (e)=>{
      const btn = e.target.closest('.subj-item');
      if (!btn) return;
      const id = btn.getAttribute('data-id');
      const subj = (ALL_SUBJECTS || []).find(s => String(s.id) === String(id));
      if (subj && __onPickSubject) __onPickSubject(subj);
      closeSubjectPicker();
    });

