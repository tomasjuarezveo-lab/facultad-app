    function hpStartTimer(){
      const secs = hpSecondsByDiff();
      hpDeadline = Date.now() + secs * 1000;

      // ✅ prende mecha + la resetea a la izquierda
      document.body.classList.add('hp-ticking');
      hpSetFuseProgress(0);

      if (hpTimer) hpTimer.textContent = String(secs);

      if (hpInterval){ clearInterval(hpInterval); hpInterval = null; }
      hpInterval = setInterval(()=>{
        const remainingMs = Math.max(0, hpDeadline - Date.now());

        // contador
        const left = Math.max(0, Math.ceil(remainingMs / 1000));
        if (hpTimer) hpTimer.textContent = String(left);

        // ✅ progreso mecha (0 -> 1)
        const progress = (secs <= 0) ? 1 : (1 - (remainingMs / (secs * 1000)));
        hpSetFuseProgress(progress);

        if (remainingMs <= 0){
          clearInterval(hpInterval); hpInterval = null;

          // asegura que llegue al final
          hpSetFuseProgress(1);

          hpFail('⏱️ Se acabó el tiempo.');
        }
      }, 120);
    }

    function hpRenderQuestion(q){
      hpQ = q;

      // UI de ronda/pregunta (esto queda abajo como referencia)
      if (hpQText){
