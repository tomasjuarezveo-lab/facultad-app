        nlReset();
      }
    });


    
      function nlCfg(){
        const d = window.__GAME_DIFFICULTY || 'easy';
        if (d === 'medium') return { need: 5 };
        if (d === 'hard') return { need: 7 };
        return { need: 3 };
      }

      function nlMult(){
        const d = window.__GAME_DIFFICULTY || 'easy';
        if (d === 'hard') return 3;
        if (d === 'medium') return 2;
        return 1;
      }

      function nlBaseReward(){
        // 5..15 inclusive
        return 5 + Math.floor(Math.random()*11);
      }

      function nlInfoText(){
        return `¡Elige tu nivel y multiplica tus puntos! No te compliques con las respuestas: lo breve también cuenta. ¡Dale con todo y mucha suerte!`;
      }

      function nlUpdateInfo(){
        // Mostramos info SOLO cuando no está corriendo (para no molestar en juego)
        if (!nlMsg) return;
        if (!nlRunning){
          nlMsg.textContent = nlInfoText();
        }
      }


    function nlNorm(s){
      return String(s ?? '')
        .toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
        .replace(/\s+/g,' ')
        .trim()
        .replace(/[^a-z0-9 ]+/g,'')
        .replace(/\s+/g,' ');
    }

    function nlGetCorrectText(q){
      // principal: opción correcta por índice
      if (q && Array.isArray(q.options) && q.options.length && q.answer != null && q.options[q.answer] != null){
        return String(q.options[q.answer]);
      }
      // fallback: si viniera en otro campo
      if (q && typeof q.correct === 'string') return q.correct;
      if (q && typeof q.answer_text === 'string') return q.answer_text;
      return '';
    }

    function nlPickDigit(){
        const pool = ['1','2','3','4','5','6','7','8','9'].filter(x => !nlUsed.has(x));
        if (!pool.length) return '1';
        return pool[Math.floor(Math.random()*pool.length)];
      }

    function nlRenderDigits(){
      if (!nlDigitsEl) return;
      nlDigitsEl.innerHTML = nlDigits.map(d => `<span class="nl-chip">${d}</span>`).join('');
    }

    function nlBuildSlots(n, editable){
      if (!nlBoard) return;
      nlBoard.innerHTML = '';
      for (let i=0; i<n; i++){
        const slot = document.createElement('div');
        slot.className = 'nl-slot';
        if (editable){
          slot.innerHTML = `<input inputmode="numeric" maxlength="1" aria-label="Dígito ${i+1}" />`;
        } else {
          slot.textContent = '—';
        }
        nlBoard.appendChild(slot);
      }
    }

    function nlSlotsValues(){
        if (!nlBoard) return [];
        const inputs = nlBoard.querySelectorAll('input');
        return Array.from(inputs).map(inp => String(inp.value || '').trim());
      }

    function nlShowClues(clues){
      if (nlCluesBox) nlCluesBox.style.display = 'block';
      if (nlClueList){
        nlClueList.innerHTML = (clues || []).map(t => `<li>${t}</li>`).join('');
      }
    }

    function nlHideClues(){
      if (nlCluesBox) nlCluesBox.style.display = 'none';
      if (nlClueList) nlClueList.innerHTML = '';
    }

    function nlSetRunning(on){
      nlRunning = !!on;
      if (nlStart) nlStart.textContent = nlRunning ? 'Me rindo' : 'Iniciar';

      // ocultar fila de elegir materia mientras corre (igual que dinamita)
      try{
        const row = nlPickSubj ? nlPickSubj.closest('.game-subject-row') : null;
        if (row){
          row.classList.toggle('is-hidden', nlRunning);
          row.style.display = nlRunning ? 'none' : '';
        }
      }catch(_){}

      // HUD label
      try{
        if (document.body.getAttribute('data-active-game') === 'num-logic'){
          window.__setHudPickLabel(nlSubject ? nlSubject.name : 'Elegir materia');
        }
      }catch(_){}
    }

    function nlSetSubject(subj){
      nlSubject = subj || null;
      if (nlSubjLabel) nlSubjLabel.textContent = nlSubject ? (window.__gameShortSubj ? window.__gameShortSubj(nlSubject.name) : nlSubject.name) : 'Sin materia seleccionada';
      if (nlPickSubj) nlPickSubj.textContent = nlSubject ? nlSubject.name : 'Elegir materia';
      if (nlMsg) nlMsg.textContent = nlSubject ? '' : 'Elegí una materia para jugar.';

      try{
        if (document.body.getAttribute('data-active-game') === 'num-logic'){
          window.__setHudPickLabel(nlSubject ? nlSubject.name : 'Elegir materia');
        }
      }catch(_){}
    }

    nlPickSubj && nlPickSubj.addEventListener('click', ()=>{
      if (window.openSubjectPicker) window.openSubjectPicker(nlSetSubject);
    });

    function nlReset(){
      const cfg = nlCfg();
      nlNeed = cfg.need;
      nlAward = cfg.award;

      nlStage = 'idle';
      nlDigits = [];
      nlUsed = new Set();
      nlSolvedOrder = [];
      nlQuizDone = 0;
      nlCurrentQ = null;

      nlBuildSlots(nlNeed, false);
      nlRenderDigits();
      nlHideClues();

      if (nlAnswerRow) nlAnswerRow.style.display = 'none';
      if (nlSolveRow) nlSolveRow.style.display = 'none';

      if (nlQText) nlQText.textContent = 'Tocá iniciar';
      if (nlMsg) nlMsg.textContent = '';
      if (nlAnswer) nlAnswer.value = '';

      if (nlSubmit) nlSubmit.disabled = false;
      if (nlSolve) nlSolve.disabled = false;

      nlUpdateInfo();

      window.__onDifficultyChange = function(){
        // si estás en caja fuerte, refresca el texto de recompensa
        try{
          if (document.body.getAttribute('data-active-game') === 'num-logic'){
            nlUpdateInfo();
          }
        }catch(_){}
      };


    }

    function nlTemplates3(d){
      // d asc: [a<b<c]
      const a=d[0], b=d[1], c=d[2];
      return [
        {
          order: [b,c,a],
          clues: [
            'El número más alto va en el medio.',
            'El número más bajo va último.'
          ]
        },
        {
          order: [c,a,b],
          clues: [
            'El número más alto va primero.',
            'El número más bajo va en el medio.'
          ]
        },
        {
          order: [b,a,c],
          clues: [
            'El número que NO es ni el más alto ni el más bajo va primero.',
            'El número más alto va último.'
          ]
        }
      ];
    }

    function nlTemplates5(d){
      // d asc: [a<b<c<d<e]
      const a=d[0], b=d[1], c=d[2], dd=d[3], e=d[4];
      return [
        {
          order: [dd,e,c,b,a],
          clues: [
            'El número más alto va segundo.',
            'El número más bajo va último.',
            'El segundo más alto va primero.',
            'El número del medio es el tercero más chico.'
          ]
        },
        {
          order: [a,c,e,dd,b],
          clues: [
            'El número más bajo va primero.',
            'El número más alto va tercero.',
            'El segundo más bajo va último.',
            'El segundo más alto va cuarto.'
          ]
        },
        {
          order: [a,b,e,c,dd],
          clues: [
            'El número del medio es el más alto.',
            'Los dos más chicos ocupan la 1ra y 2da posición.',
            'El segundo más alto va último.'
          ]
        }
      ];
    }

    function nlTemplates7(d){
      // d asc: [a<b<c<d<e<f<g]
      const a=d[0], b=d[1], c=d[2], dd=d[3], e=d[4], f=d[5], g=d[6];
      return [
        {
          order: [f,dd,b,g,e,c,a],
          clues: [
            'El número más alto va 4to.',
            'El número más bajo va 7mo.',
            'El segundo más alto va 1ro.',
            'El segundo más bajo va 3ro.',
            'El tercero más bajo va 6to.',
            'El cuarto más bajo va 2do.'
          ]
        },
        {
          order: [b,g,dd,a,e,c,f],
          clues: [
            'El número más bajo va 4to.',
            'El número más alto va 2do.',
            'El segundo más bajo va 1ro.',
            'El segundo más alto va 7mo.',
            'El tercer más alto va 5to.',
            'El cuarto más alto va 3ro.'
          ]
        },
        {
          order: [e,a,f,dd,g,b,c],
          clues: [
            'El tercer más alto va 1ro.',
            'El número más bajo va 2do.',
            'El segundo más alto va 3ro.',
            'El cuarto más bajo va 4to.',
            'El número más alto va 5to.',
            'El segundo más bajo va 6to.'
          ]
        }
      ];
    }

    function nlMakePuzzle(){
      const asc = [...nlDigits].sort((x,y)=> Number(x)-Number(y)); // orden por valor
      let pack = [];
      if (nlNeed === 3) pack = nlTemplates3(asc);
      else if (nlNeed === 5) pack = nlTemplates5(asc);
      else pack = nlTemplates7(asc);

      const pick = pack[Math.floor(Math.random()*pack.length)];
      nlSolvedOrder = pick.order.map(String);

      nlStage = 'puzzle';
      nlHideClues();
      nlShowClues(pick.clues);

      // mostrar slots editables
      nlBuildSlots(nlNeed, true);

      if (nlAnswerRow) nlAnswerRow.style.display = 'none';
      if (nlSolveRow) nlSolveRow.style.display = 'flex';

      if (nlQText) nlQText.textContent = `Ordená los ${nlNeed} números con las pistas.`;
      if (nlMsg) nlMsg.textContent = '';
    }

    async function nlNextQuestion(){
      if (!nlSubject || nlSubject.id == null){
        if (nlMsg) nlMsg.textContent = 'Elegí una materia para jugar.';
        return;
      }

      nlStage = 'quiz';
      nlQuizDone += 1;

      if (nlAnswerRow) nlAnswerRow.style.display = 'flex';
      if (nlSolveRow) nlSolveRow.style.display = 'none';
      nlHideClues();

      if (nlAnswer) nlAnswer.value = '';
      if (nlSubmit) nlSubmit.disabled = false;

      let q = null;
      try{
        q = await fetchRandomQuiz(nlSubject.id);
      }catch(_){ q = null; }

      if (!q){
        q = { text:'(No hay preguntas)', options:['OK'], answer:0 };
      }

      nlCurrentQ = q;

      if (nlQText){
        nlQText.textContent = `Pregunta ${nlQuizDone}/${nlNeed}: ${q.text || 'Pregunta'}`;
      }
      if (nlMsg) nlMsg.textContent = '';
      setTimeout(()=>{ try{ nlAnswer && nlAnswer.focus(); }catch(_){} }, 0);
    }

    async function nlStartGame(){
      const cfg = nlCfg();
      nlNeed = cfg.need;
      nlAward = cfg.award;

      if (!nlSubject || nlSubject.id == null){
        if (nlMsg) nlMsg.textContent = 'Elegí una materia para jugar.';
        return;
      }

      nlReset();
      nlSetRunning(true);

      nlStage = 'quiz';
      nlBuildSlots(nlNeed, false);
      nlRenderDigits();

      await nlNextQuestion();
    }

    function nlCheckTypedAnswer(){
      const typed = nlNorm(nlAnswer ? nlAnswer.value : '');
      if (!typed) return { ok:false, msg:'Escribí una respuesta.' };

      const correct = nlNorm(nlGetCorrectText(nlCurrentQ));
      if (!correct){
        // si no hay correct, no bloqueamos: aceptamos cualquier cosa (pero avisamos)
        return { ok:true, msg:'(Pregunta sin respuesta registrada) ✅' };
      }

      // match exacto normalizado
      if (typed === correct) return { ok:true, msg:'✅ Correcto' };

      // match “contiene” (tolerancia)
      if (typed.length >= 3 && (correct.includes(typed) || typed.includes(correct))) return { ok:true, msg:'✅ Correcto' };

      return { ok:false, msg:`❌ Incorrecto.` };
    }

    async function nlSubmitAnswer(){
      if (nlStage !== 'quiz' || !nlCurrentQ) return;
      if (nlSubmit) nlSubmit.disabled = true;

      const res = nlCheckTypedAnswer();
      if (!res.ok){
        if (nlMsg) nlMsg.textContent = res.msg || 'Incorrecto.';
        if (nlSubmit) nlSubmit.disabled = false;
        return;
      }

      // correcto -> ganar dígito
      const digit = nlPickDigit();
      nlDigits.push(String(digit));
      nlRenderDigits();

      if (nlMsg) nlMsg.textContent = `✅ Bien. Ganaste el número ${digit}.`;

      if (nlDigits.length >= nlNeed){
        // pasar a puzzle
        setTimeout(()=> nlMakePuzzle(), 450);
        return;
      }

      // siguiente pregunta
      setTimeout(()=> nlNextQuestion(), 450);
    }

    async function nlSolvePuzzle(){
      if (nlStage !== 'puzzle') return;

      const vals = nlSlotsValues().map(v => String(v||'').trim());
      const filled = vals.every(v => /^[0-9]$/.test(v));
      if (!filled){
        if (nlMsg) nlMsg.textContent = 'Completá todos los casilleros con un dígito.';
        return;
      }

      // validar que usó EXACTAMENTE los dígitos ganados
      const wantSorted = [...nlDigits].sort().join(',');
      const gotSorted  = [...vals].sort().join(',');
      if (wantSorted !== gotSorted){
        if (nlMsg) nlMsg.textContent = 'Usá SOLO los números que ganaste (sin repetir ni inventar).';
        return;
      }

      const ok = vals.join('') === nlSolvedOrder.join('');
      if (!ok){
        if (nlMsg) nlMsg.textContent = '❌ No coincide con las pistas. Probá otra vez.';
        try{ window.__SFX && window.__SFX.play('lose'); }catch(_){}
        return;
      }

      nlStage = 'done';
      if (nlMsg) nlMsg.textContent = `🏆 ¡Perfecto! Sumaste +${nlAward} puntos ✅`;
      try{ window.__SFX && window.__SFX.play('win'); }catch(_){}
      const base = nlBaseReward();     // 5..15
      const mult = nlMult();           // x1/x2/x3
      const total = base * mult;

      await addServerPoints(total);

      // animación + cartel
      nlShowReward(total, mult);

      // auto-cierre por si no toca "Seguir"
      setTimeout(()=>{
        try{
          if (nlRewardOverlay && nlRewardOverlay.classList.contains('show')){
            nlHideReward();
            nlSetRunning(false);
            nlReset();
          }
        }catch(_){}
      }, 2200);

      nlSetRunning(false);
    }

    nlSubmit && nlSubmit.addEventListener('click', nlSubmitAnswer);
    nlAnswer && nlAnswer.addEventListener('keydown', (e)=>{
      if (e.key === 'Enter'){
        e.preventDefault();
        nlSubmitAnswer();
      }
    });

    nlSolve && nlSolve.addEventListener('click', nlSolvePuzzle);

      nlStart && nlStart.addEventListener('click', async ()=>{
        // Si está corriendo, ahora es “Me rindo”
        if (nlRunning){
          nlSetRunning(false);
          nlReset(); // vuelve a "Tocá iniciar", sin pregunta
          // vuelve el botón de materia visible (nlSetRunning ya lo maneja)
