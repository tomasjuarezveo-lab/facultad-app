        const hpMsg = document.getElementById('hpMsg');
        const notRunning = !document.body.classList.contains('hp-running');
        if (hpMsg && notRunning){
          const label = (d === 'hard') ? 'Difícil' : (d === 'medium') ? 'Medio' : 'Fácil';
          hpMsg.textContent = `Dificultad: ${label} (${sec}s)`;
        }
      }catch(_){}
    };


