  // Paleta
  const COLS = [
    ['#F4B24D','#F6C56F'],
    ['#7C8CF6','#9AA5FF'],
    ['#5B8CF8','#7DB0FF'],
    ['#55D6BF','#8BE7D9'],
    ['#7B7BEA','#A09EFF']
  ];

    // ===============================
  // ✅ FORZAR botones del layout (Tutorial / Perfil) visibles también dentro de juegos
  // (NO crea nada nuevo, solo vuelve visibles los que ya están en el layout)
  // ===============================
  (function keepLayoutTutorialProfileVisible(){
    function candidates(){
      // Probamos IDs/clases comunes sin asumir tu layout exacto
      return document.querySelectorAll([
        '#btnTutorial', '#tutorialBtn', '#tutorialButton', '#tutorial',
        '#btnPerfil', '#btnProfile', '#profileBtn', '#profileButton', '#perfil',
        '[data-action="tutorial"]', '[data-action="profile"]',
        '[data-role="tutorial"]',  '[data-role="profile"]',
        'a[href*="tutorial"]', 'a[href*="perfil"]', 'a[href*="profile"]',
        'button[aria-label*="Tutorial"]', 'button[aria-label*="Perfil"]', 'button[aria-label*="Profile"]'
      ].join(','));
    }

    function forceVisible(){
      const els = candidates();
      if (!els || !els.length) return;

      els.forEach(el=>{
        // si tu layout usa hidden/is-hidden, los levantamos sin romper nada
        el.classList.remove('hidden','is-hidden');
        el.style.display = '';
        el.style.visibility = 'visible';
        el.style.opacity = '1';
        el.style.pointerEvents = 'auto';

        // clave: que queden arriba del topbar de juegos
        el.style.position = el.style.position || ''; // no lo cambiamos si ya tiene
        el.style.zIndex = '120';
      });
    }

    // 1) al cargar
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', forceVisible, { once:true });
    } else {
      forceVisible();
    }

    // 2) cada vez que cambian clases (cuando entrás/salís de juegos)
    const obs = new MutationObserver(()=> forceVisible());
    obs.observe(document.documentElement, { attributes:true, attributeFilter:['class'] });
    obs.observe(document.body, { attributes:true, attributeFilter:['class'] });

    // 3) por si el layout renderiza tarde
    setTimeout(forceVisible, 200);
    setTimeout(forceVisible, 800);
  })();


  const svg   = document.getElementById('wheelSvg');
