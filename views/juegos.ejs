      // mostramos texto de pregunta debajo del círculo como “mini título”
      // (solo si querés: queda suave)
      // hpQText ya lo usa para ronda/pregunta; el texto real va en mensaje:
      if (hpMsg) hpMsg.textContent = q.text || 'Pregunta';

      hpRenderQuestion(q);
