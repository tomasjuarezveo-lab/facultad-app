@media (min-width: 521px){
  /* 🔧 si el hub está oculto al entrar a un juego, respetarlo */
  #gamesHub[style*="display: none"]{
    display: none !important;
  }

  /* ✅ no scroll en el hub (desktop) */
  body:not(.in-game){
    overflow: hidden !important;
    height: 100dvh !important;
    max-height: 100dvh !important;
    overscroll-behavior: none !important;
  }

  html, body{
    overflow-x: hidden !important;
  }

  /* ✅ hub en una sola pantalla y más compacto */
  #gamesHub.games-hub{
    box-sizing: border-box;
    width: 100%;
    height: calc(100dvh - 82px) !important;
    min-height: calc(100dvh - 82px) !important;
    max-height: calc(100dvh - 82px) !important;
    margin: 0 auto !important;
    padding: 8px 16px 8px !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    overflow: hidden !important;
  }

  /* ✅ acercamos cards al título/subtítulo */
  #gamesHub .games-hero{
    margin: 0 0 8px !important;
    text-align: center;
  }

  #gamesHub .games-hero h2{
    margin: 0 !important;
  }

  #gamesHub .games-hero p{
    margin: 6px auto 0 !important;
  }

  #gamesHub .games-carousel{
    margin-top: 2px !important;
    padding-top: 0 !important;
  }

  #gamesHub .games-stage{
    margin-top: 0 !important;
  }
}
  /* =========================================================
     ✅ AJUSTES FINALES MOBILE + SPEEDRUN (PC y celular)
     ========================================================= */
  body.in-game.in-nonroulette #gameView-speedrun .sr-grid{
    gap: 22px;
  }
  body.in-game.in-nonroulette #gameView-speedrun .sr-stack{
    --srCardSize: 112px;
    grid-template-rows: repeat(3, var(--srCardSize));
    justify-items: center;
    gap: 14px;
  }
  body.in-game.in-nonroulette #gameView-speedrun .sr-card{
    width: var(--srCardSize);
    height: var(--srCardSize);
    min-height: 0;
    padding: 8px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    text-align: center;
    line-height: 1.08;
    font-size: 11px;
    overflow: hidden;
    word-break: break-word;
  }
  body.in-game.in-nonroulette #gameView-speedrun .sr-wire-base{
    stroke-width: 10;
    opacity: .98;
  }
  body.in-game.in-nonroulette #gameView-speedrun .sr-wire-hi{
    stroke-width: 3.4;
  }

  @media (max-width:640px){
    /* Ruleta: primero cantidad (2/3/4/5), abajo Mis puntos */
    .wheel-wrap .count-wrap{
      order: 1;
      margin-bottom: 8px;
    }
    .wheel-wrap .points-badge{
      order: 2;
      margin-bottom: 10px;
    }

    /* Pop de “+” siempre centrado en pantalla */
    .slice-pop{
      position: fixed !important;
      left: 50vw !important;
      top: 50dvh !important;
      transform: translate(-50%, -50%) !important;
      z-index: 9999 !important;
      width: min(92vw, 360px);
      max-height: 62vh;
    }

    /* Escape: cajas más chicas + HUD llaves/llaves en una fila */
    body.in-game.in-nonroulette #gameView-escape .esc-hud{
      flex-wrap: nowrap;
      justify-content: center;
      gap: 8px;
      width: 100%;
      margin-inline: auto;
    }
    body.in-game.in-nonroulette #gameView-escape .esc-badge{
