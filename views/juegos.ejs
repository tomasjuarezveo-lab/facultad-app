    let srSubject = null;
    let srRunning = false;
    let srTickInt = null;
    let srEndsAt = 0;

    let srPairs = [];               // [{ q, a }]
    let srAnsOrder = [];            // [a,a,a] (orden mostrado)
    let srCorrectMap = [0,0,0];     // qIdx -> aIdx correcto
    let srLinks = [null,null,null]; // qIdx -> aIdx conectado
    let srUsedA = new Set();

    let srDrag = null;              // { qIdx, pointerId }

    // ✅ estado de interacción (evita globals sueltos)
    let srSelected = null;       // { type:'q'|'a', idx }
    let srPress = null;          // { type, idx, pointerId, x0, y0 }
    let srDragging = false;
    let srSkipClickUntil = 0;

    const srPickSubj  = document.getElementById('srPickSubj');
    const srSubjLabel = document.getElementById('srSubjLabel');
    const srTimeBomb  = document.getElementById('srTimeBomb');
    const srRoundText = document.getElementById('srRoundText');
