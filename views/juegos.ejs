        // shuffle local (no depende del resto del archivo)
    function escShuffle(a){
      for (let i=a.length-1;i>0;i--){
        const j = (Math.random()*(i+1))|0;
        const t = a[i]; a[i] = a[j]; a[j] = t;
      }
      return a;
    }

    function escShow(el, on){
      if (!el) return;
      el.classList.toggle('is-hidden', !on);
      el.style.display = on ? '' : 'none';
    }

    function escSetRunning(on){
      escRunning = !!on;

      if (escStart) escStart.textContent = escRunning ? 'Salir' : 'Iniciar';

      try{
        if (escSubjRow){
          escSubjRow.classList.toggle('is-hidden', escRunning);
          escSubjRow.style.display = escRunning ? 'none' : '';
        }
      }catch(_){}

      escShow(escPre, !escRunning);
      escShow(escPlay, escRunning);

      try{
        if (document.body.getAttribute('data-active-game') === 'escape'){
          window.__setHudPickLabel(escSubject ? escSubject.name : 'Elegir materia');
        }
      }catch(_){}
    }

    function escSetSubject(subj){
      escSubject = subj || null;

      if (escSubjLabel) escSubjLabel.textContent = escSubject ? (window.__gameShortSubj ? window.__gameShortSubj(escSubject.name) : escSubject.name) : 'Sin materia seleccionada';
      if (escPickSubj) escPickSubj.textContent = escSubject ? escSubject.name : 'Elegir materia';

      if (escMsg){
        escMsg.textContent = escSubject ? '' : 'Elegí una materia para jugar.';
      }

      try{
        if (document.body.getAttribute('data-active-game') === 'escape'){
          window.__setHudPickLabel(escSubject ? escSubject.name : 'Elegir materia');
        }
      }catch(_){}
    }

    escPickSubj && escPickSubj.addEventListener('click', ()=>{
      if (window.openSubjectPicker) window.openSubjectPicker(escSetSubject);
    });

    function escUpdateKeys(){
      if (escKeysMeEl) escKeysMeEl.textContent = String(escKeysMe);
      if (escKeysCpuEl) escKeysCpuEl.textContent = String(escKeysCpu);
    }

    function escPickKeys(){
      escKeyPos = new Set();
      const idxs = escShuffle([0,1,2,3,4,5,6,7,8]);
      escKeyPos.add(idxs[0]);
      escKeyPos.add(idxs[1]);
    }

    function escBuildGrid(){
      if (!escGrid) return;
      escGrid.innerHTML = '';
      for (let i=0;i<9;i++){
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'esc-cell';
        b.setAttribute('data-i', String(i));
        b.innerHTML = ESC_BOX_SVG;
        b.addEventListener('click', ()=> escOnPickBox(i));
        escGrid.appendChild(b);
      }
    }

    function escMarkOpened(i, who){
      if (!escGrid) return;
      const cell = escGrid.querySelector(`.esc-cell[data-i="${i}"]`);
      if (!cell) return;

      cell.classList.add('is-open');
      cell.classList.toggle('is-me', who === 'me');
      cell.classList.toggle('is-cpu', who === 'cpu');
      cell.disabled = true;

      const hadKey = escKeyPos.has(i);

      cell.innerHTML =
        `<div class="esc-open-ico">📦</div>` +
        (hadKey ? `<div class="esc-key">🗝️</div>` : ``) +
        `<div class="esc-owner">${who === 'me' ? '🙂' : '🤖'}</div>`;

      if (hadKey){
        escKeyPos.delete(i);
        if (who === 'me') escKeysMe++;
        else escKeysCpu++;
        escUpdateKeys();
      }
    }

    function escClosedIndices(){
      const arr = [];
      for (let i=0;i<escBoxes.length;i++){
        if (escBoxes[i] === 0) arr.push(i);
      }
      return arr;
    }

    function escOpenQ(){
      if (!escQAOverlay) return;
      escQAOverlay.classList.add('show');
      escQAOverlay.setAttribute('aria-hidden','false');
    }

    function escCloseQ(){
      if (!escQAOverlay) return;
      escQAOverlay.classList.remove('show');
      escQAOverlay.setAttribute('aria-hidden','true');
      if (escQFeedback) escQFeedback.textContent = '';
      if (escOpts) escOpts.innerHTML = '';
      if (escQText) escQText.textContent = '';
    }

    function escCancelQuestion(){
      escPendingIndex = -1;
      escLockGrid = false;
      escResolving = false;
      escCloseQ();
    }

    escQClose && escQClose.addEventListener('click', ()=>{
      if (escResolving) return;
      escCancelQuestion();
    });

    escQAOverlay && escQAOverlay.addEventListener('click', (e)=>{
      if (e.target === escQAOverlay && !escResolving){
        escCancelQuestion();
      }
    });

    function escBuild4Options(q){
      const options = (q && Array.isArray(q.options)) ? q.options.map(x=>String(x)) : [];
      const ans = Number.isFinite(Number(q && q.answer)) ? Number(q.answer) : 0;
      const correctIdx = Math.max(0, Math.min(options.length-1, ans));

      if (options.length <= 4){
        const pack = options.map((t,i)=>({ t, ok: i === correctIdx }));
        escShuffle(pack);
        return { four: pack.map(p=>p.t), correct: pack.findIndex(p=>p.ok) };
      }

      const wrong = [];
      for (let i=0;i<options.length;i++) if (i !== correctIdx) wrong.push(i);
      shuffle(wrong);

      const pack = [
        { t: options[correctIdx], ok:true },
        { t: options[wrong[0]], ok:false },
        { t: options[wrong[1]], ok:false },
        { t: options[wrong[2]], ok:false }
      ];
      shuffle(pack);
      return { four: pack.map(p=>p.t), correct: pack.findIndex(p=>p.ok) };
    }

    async function escAskQuestion(){
      if (!escSubject || escSubject.id == null){
        if (escMsg) escMsg.textContent = 'Elegí una materia para jugar.';
        escCancelQuestion();
        return;
      }

      if (escQText) escQText.textContent = 'Cargando pregunta…';
      if (escOpts) escOpts.innerHTML = '';
      if (escQFeedback) escQFeedback.textContent = '';

      let q = null;
      try{
        q = await fetchRandomQuiz(escSubject.id);
      }catch(_){}

      if (!q || !q.text || !Array.isArray(q.options) || !q.options.length){
        if (escMsg) escMsg.textContent = '(No hay preguntas registradas) — Probá con otra materia.';
        escCancelQuestion();
        return;
      }

      if (escQText) escQText.textContent = String(q.text);

      const pack = escBuild4Options(q);
      if (!pack){
        if (escMsg) escMsg.textContent = '(Pregunta inválida) — Probá con otra materia.';
        escCancelQuestion();
        return;
      }

      escOpts.innerHTML = pack.four.map((t,i)=>`
        <button type="button" class="opt" data-i="${i}">
          <span style="font-weight:900;color:#0f172a">${t}</span>
        </button>
      `).join('');

      escOpts.querySelectorAll('.opt').forEach(btn=>{
        btn.addEventListener('click', async ()=>{
          if (!escRunning) return;
          if (escResolving) return;

          escResolving = true;
          const picked = parseInt(btn.getAttribute('data-i')||'-1',10);
          const ok = (picked === pack.correct);

          escOpts.querySelectorAll('.opt').forEach(b=> b.disabled = true);

          if (ok){
            if (escQFeedback) escQFeedback.textContent = 'Correcto ✅';
          } else {
            const corrTxt = pack.four[pack.correct] != null ? pack.four[pack.correct] : '—';
            if (escQFeedback) escQFeedback.textContent = `Incorrecto ❌ Respuesta correcta: ${corrTxt}`;
          }

          setTimeout(async ()=>{
            try{
              await escResolveTurn(ok);
            }finally{
              escCloseQ();
            }
          }, ok ? 350 : 520);
        });
      });

      escOpenQ();
    }

    function escEnd(result, msg){
      escLockGrid = false;
      escResolving = false;
      escPendingIndex = -1;

      if (result === 'win'){
        if (escMsg) escMsg.textContent = msg || '¡Escapaste! 🎉 Encontraste 2 llaves · +5 puntos';
        try{ window.__SFX && window.__SFX.play && window.__SFX.play('win'); }catch(_){}
        try{ addServerPoints(5); }catch(_){}
      } else if (result === 'lose'){
        if (escMsg) escMsg.textContent = msg || 'Perdiste 😵 La máquina consiguió 2 llaves primero.';
        try{ window.__SFX && window.__SFX.play && window.__SFX.play('lose'); }catch(_){}
      } else {
        if (escMsg) escMsg.textContent = msg || 'Empate 🤝 Se repartieron las llaves 1 y 1.';
      }

      escSetRunning(false);
      escCloseQ();
    }

    async function escResolveTurn(ok){
      if (!escRunning) return;

      const idx = escPendingIndex;
      escPendingIndex = -1;

      if (idx == null || idx < 0 || idx > 8){
        escLockGrid = false;
        escResolving = false;
        return;
      }

      // Turno jugador
      if (ok){
        if (escBoxes[idx] === 0){
          escBoxes[idx] = 1;
          escMarkOpened(idx, 'me');
        }
      }

      if (escKeysMe >= 2){
        escEnd('win', '¡Escapaste! 🎉 Encontraste 2 llaves · +5 puntos');
        return;
      }

      // Turno CPU (siempre después de tu intento)
      const closed = escClosedIndices();
      if (!closed.length){
        if (escKeysCpu >= 2) escEnd('lose', 'Perdiste 😵 La máquina consiguió 2 llaves primero.');
        else if (escKeysMe >= 2) escEnd('win', '¡Escapaste! 🎉 Encontraste 2 llaves · +5 puntos');
        else escEnd('tie', 'Empate 🤝 Se repartieron las llaves 1 y 1.');
        return;
      }

      const cpuIdx = closed[(Math.random()*closed.length)|0];
      escBoxes[cpuIdx] = 2;
      escMarkOpened(cpuIdx, 'cpu');

      if (escKeysCpu >= 2){
        escEnd('lose', 'Perdiste 😵 La máquina consiguió 2 llaves primero.');
        return;
      }

      if (!escClosedIndices().length && escKeysMe < 2 && escKeysCpu < 2){
        escEnd('tie', 'Empate 🤝 Se repartieron las llaves 1 y 1.');
        return;
      }

      if (escMsg) escMsg.textContent = 'Tu turno: elegí otra caja.';

      escLockGrid = false;
      escResolving = false;
    }

    function escOnPickBox(i){
      if (!escRunning) return;
      if (escLockGrid) return;
      if (escBoxes[i] !== 0) return;

      escLockGrid = true;
      escPendingIndex = i;
      escAskQuestion();
