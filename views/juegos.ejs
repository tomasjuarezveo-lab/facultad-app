        if (bombT) bombT.textContent = String(totalSec);

        setHolder('me');
        setStatus(`Dificultad: ${d.label} (${d.sec}s).`);
      }

      window.stopFalseRoom = stopFalseRoom;

      function frOnDiffChange(){
        if (running) return;
        resetRunUI();
      }
      if (!window.__FR_PATCHED_ONDIFF){
        window.__FR_PATCHED_ONDIFF = true;
        const prev = window.__onDifficultyChange;
        window.__onDifficultyChange = function(d){
          try{ if (typeof prev === 'function') prev(d); }catch(_){}
          try{ frOnDiffChange(); }catch(_){}
        };
      }

      pickBtn.addEventListener('click', ()=>{
        if (running){ setMsg('No podés cambiar de materia con la partida iniciada.'); return; }
        try{
          openSubjectPicker((subj)=>{
            frSubject = subj || null;

            // primero refrescamos UI/estado
            resetRunUI();

            // y luego mostramos confirmación (para que no lo borre resetRunUI)
            if (frSubject && frSubject.id != null){
              setMsg(`Materia: ${frSubject.name}`);
            }else{
              setMsg('');
            }
          });
        }catch(_){ setMsg('No pude abrir el selector de materias.'); }
      });

      startBtn.addEventListener('click', async ()=>{
        if (running) return;

        if (!frSubject || frSubject.id == null){
          setMsg('Elegí una materia para jugar.');
          return;
        }

        if (endOv) endOv.classList.remove('show');

        resetRunUI();
        running = true;

        const d = diffNow();
        totalSec = d.sec;
        endAt = Date.now() + totalSec * 1000;

        startBtn.style.display = 'none';
        subjRow && (subjRow.style.display = 'none');
              if (hudEl) hudEl.style.display = 'flex';

        setHolder('me');
        setStatus('¡Arrancó! Respondé rápido…');

        syncTime(totalSec);
        startTimer();

        await loadQuestion();
      }, false);

      passBtn.addEventListener('click', ()=>{
        if (!running) return;
        if (holder !== 'me') return;
        if (!canPass) return;

        canPass = false;
        passBtn.disabled = true;
        setMsg('')
        cpuTurn();
      }, false);

      quitBtn.addEventListener('click', ()=>{
        stopFalseRoom();
        setMsg('Partida cancelada.');
      }, false);

      endAgain && endAgain.addEventListener('click', ()=>{
        if (endOv) endOv.classList.remove('show');
        resetRunUI();
        startBtn.click();
      }, false);

      endClose && endClose.addEventListener('click', ()=>{
        if (endOv) endOv.classList.remove('show');
        const backBtn = document.getElementById('btnGamesBack');
        if (backBtn) backBtn.click();
        else stopFalseRoom();
      }, false);

      resetRunUI();
    })();




/* =========================================================
   ✅ SUBASTA: FIX DEFINITIVO (V3) — 100% FUNCIONAL
   - Materia: modal propio de subasta (#aucSubjPickerOverlay)
   - Flechas ▲▼: funcionan siempre (delegación en #aucBoard)
   - Iniciar → Apostar → Siguiente (5 rondas)
   - Animación gris secuencial x5, luego rojo/verde + overlay central
   - Puntos: -sum(incorrectas) + 2x(apuestaCorrecta); bote acumula si NO apostás a la correcta
   - Actualiza mirrors: #score #pointsValue #aucScoreMirror #hpScoreMirror
   ========================================================= */
(function(){
  if (window.__AUC_FIX_V3__) return;
  window.__AUC_FIX_V3__ = true;

  function $id(id){ return document.getElementById(id); }
  function onReady(fn){
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn, { once:true });
    else fn();
  }

  onReady(() => {
    const view     = $id('gameView-auction');
    const wrap     = $id('aucWrap');
    const board    = $id('aucBoard');

    const pickBtn  = $id('aucPickSubj');
    const pickLbl  = $id('aucSubjLabel');

    const startBtn = $id('aucStartReal');
    const msgEl    = $id('aucGateMsg');

    const clueEl   = $id('aucClue');
    const tipEl    = $id('aucTip');

    const valEls  = [$id('aucVal1'), $id('aucVal2'), $id('aucVal3')];
    const lblEls  = [$id('aucLbl1'), $id('aucLbl2'), $id('aucLbl3')];
    const slotEls = [$id('aucSlot1'), $id('aucSlot2'), $id('aucSlot3')];

    const winBox   = $id('aucWin');
    const winTitle = $id('aucWinTitle');
    const winPts   = $id('aucWinPts');

    const pickerOv     = $id('aucSubjPickerOverlay');
    const pickerClose  = $id('aucSubjPickerClose');
    const pickerSearch = $id('aucSubjPickerSearch');
    const pickerList   = $id('aucSubjPickerList');

    if (!view || !wrap || !board || !pickBtn || !pickLbl || !startBtn || !msgEl || !clueEl) return;
    if (!pickerOv || !pickerClose || !pickerSearch || !pickerList) return;

    // asegurar visible
    wrap.style.display = 'block';

    // ======================
    // STATE
    // ======================
    let subjId = '';
    let subjName = '';

    let qText = '';
    let opts3 = ['','',''];
    let correct = 0;

    let bets = [0,0,0];
    let round = 0;
    const MAX_ROUNDS = 5;

    let phase = 'idle'; // idle | betting | resolving | done
    let pot = 0;

    // ======================
    // POINTS
    // ======================
    function getPoints(){
      const a = $id('pointsValue');
      const b = $id('score');
      const c = $id('scoreAlt');
      const d = $id('aucScoreMirror');
      const raw = (d && d.textContent) || (a && a.textContent) || (b && b.textContent) || (c && c.textContent) || '0';
      const n = parseInt(String(raw).replace(/[^\d-]/g,''), 10);
      return Number.isFinite(n) ? n : 0;
    }

    function setPoints(n){
      const v = String(Math.max(0, Math.floor(Number(n) || 0)));
      ['score','scoreAlt','pointsValue','hpScoreMirror','aucScoreMirror'].forEach(id=>{
        const el = $id(id);
        if (el) el.textContent = v;
      });
    }

    // ======================
    // UI helpers
    // ======================
    function say(t){ msgEl.textContent = t || ''; }
    function setClue(t){ clueEl.textContent = t || ''; }

    function resetVisual(){
      slotEls.forEach(s=>{
        if (!s) return;
        s.classList.remove('is-red','win-green','path-on','is-flash','is-ghost');
      });
      lblEls.forEach(l=>{
        if (!l) return;
        l.classList.remove('is-ghost');
      });
      if (winBox) winBox.classList.remove('show');
    }

    function renderBets(){
      for (let i=0;i<3;i++){
        if (valEls[i]) valEls[i].textContent = String(bets[i]||0);
      }
      const total = bets[0]+bets[1]+bets[2];
      const pts = getPoints();
      if (tipEl) tipEl.textContent = `Tip: tu apuesta total no puede superar tus puntos actuales. (Total: ${total} / ${pts}) · Bote: ${pot}`;
    }

    function clampToPoints(){
      let pts = getPoints();
      let total = bets[0]+bets[1]+bets[2];
      if (total <= pts) return;

      while (total > pts){
        let maxI = 0;
        for (let i=1;i<3;i++) if (bets[i] > bets[maxI]) maxI = i;
        if (bets[maxI] <= 0) break;
        bets[maxI] -= 1;
        total -= 1;
      }
    }

    function shuffle(arr){
      for (let i=arr.length-1;i>0;i--){
        const j = (Math.random()*(i+1))|0;
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    function build3Options(q){
      if (!q || !q.text || !Array.isArray(q.options) || q.options.length < 3) return null;

      const options = q.options.map(x=>String(x));
      const ans = Number.isFinite(Number(q.answer)) ? Number(q.answer) : 0;
      const correctIdx = Math.max(0, Math.min(options.length-1, ans));

      const wrong = [];
      for (let i=0;i<options.length;i++) if (i !== correctIdx) wrong.push(i);
      shuffle(wrong);

      const pack = [
        { t: options[correctIdx], ok:true },
        { t: options[wrong[0]], ok:false },
        { t: options[wrong[1] ?? wrong[0]], ok:false }
      ];
      shuffle(pack);

      return { three: pack.map(p=>p.t), correctIndex: pack.findIndex(p=>p.ok) };
    }

    async function loadRound(){
      say('');
      resetVisual();

      bets = [0,0,0];
      renderBets();

      if (!subjId){
        say('Elegí una materia primero.');
        return false;
      }

      setClue('Cargando pregunta…');

      const q = await fetchRandomQuizSmart(subjId, subjName);
      const pack = build3Options(q);

      if (!q || !pack){
        setClue('No pude cargar preguntas para esta materia.');
        say('No pude cargar preguntas (endpoint no respondió o no existe).');
        phase = 'idle';
        startBtn.textContent = 'Iniciar';
        return false;
      }

      qText = String(q.text);
      opts3 = pack.three.slice(0,3);
      correct = pack.correctIndex;

      setClue(qText);
      for (let i=0;i<3;i++){
        if (lblEls[i]) lblEls[i].textContent = opts3[i] || `Respuesta ${i+1}`;
      }

      phase = 'betting';
      startBtn.textContent = 'Apostar';
      return true;
    }

      function showWin(title, pts){
      if (!winBox || !winTitle || !winPts) return;

      const APPEAR_DELAY_MS = 1500; // ✅ tarda 1.5s más en aparecer
      const VISIBLE_MS      = 1400; // duración visible (igual que antes)

      winTitle.textContent = title || 'Resultado';
      winPts.textContent   = String(pts ?? 0);

      // Reset para que la animación siempre se vea bien
      winBox.classList.remove('show');

      // Cancelar timers previos si existían
      if (winBox.__aucTShow) clearTimeout(winBox.__aucTShow);
      if (winBox.__aucTHide) clearTimeout(winBox.__aucTHide);

      // Mostrar con delay
      winBox.__aucTShow = setTimeout(() => {
        winBox.classList.add('show');

        // Ocultar luego del tiempo visible
        winBox.__aucTHide = setTimeout(() => {
          try { winBox.classList.remove('show'); } catch {}
        }, VISIBLE_MS);

      }, APPEAR_DELAY_MS);
    }


    async function flashSequence(){
      // 5 ciclos: 1-2-3 (triple lento)
      const STEP = 360;
      for (let cycle=0; cycle<5; cycle++){
        for (let i=0;i<3;i++){
          slotEls.forEach(s=>s && s.classList.remove('is-flash'));
          if (slotEls[i]) slotEls[i].classList.add('is-flash');
          await new Promise(r=>setTimeout(r, STEP));
        }
      }
      slotEls.forEach(s=>s && s.classList.remove('is-flash'));
    }

    function resolveRound(){
      phase = 'resolving';

      const betCorrect = bets[correct] || 0;
      const total = bets[0]+bets[1]+bets[2];
      const incorrectSum = total - betCorrect;

      let pts = getPoints();

      // siempre perdés las incorrectas
      pts -= incorrectSum;

      let gain = 0;
      if (betCorrect > 0){
        gain = (2 * betCorrect) + pot;
        pts += gain;
        pot = 0;
      } else {
        // no apostaste a la correcta => “fallaste”: el bote crece
        pot += total;
      }

      pts = Math.max(0, pts);
      setPoints(pts);

      // pintar slots
      for (let i=0;i<3;i++){
        const s = slotEls[i];
        if (!s) continue;
        s.classList.remove('is-red','win-green');
        if (i === correct) s.classList.add('win-green');
        else s.classList.add('is-red');
      }

      const delta = (gain - incorrectSum);
      const deltaTxt = (delta >= 0 ? `+${delta}` : `${delta}`);
      showWin(delta >= 0 ? '¡Ganaste!' : 'Perdiste', deltaTxt);

      renderBets();

      phase = 'done';
      startBtn.textContent = (round >= MAX_ROUNDS ? 'Terminar' : 'Siguiente');
    }

    async function startFlow(){
      if (phase === 'idle'){
        // nueva ronda
        if (!subjId){
          say('Elegí una materia primero.');
          return;
        }

        if (round === 0) pot = 0;

        round += 1;
        if (round > MAX_ROUNDS) round = 1;

        startBtn.disabled = true;
        const ok = await loadRound();
        startBtn.disabled = false;

        if (ok && tipEl){
          tipEl.textContent = `Ronda ${round}/${MAX_ROUNDS} · Total: 0 / ${getPoints()} · Bote: ${pot}`;
        }
        return;
      }

      if (phase === 'betting'){
        const total = bets[0]+bets[1]+bets[2];
        if (total <= 0){
          say('Tenés que apostar al menos 1 punto.');
          return;
        }

        clampToPoints();
        renderBets();
        say('');

        startBtn.disabled = true;
        await flashSequence();
        startBtn.disabled = false;

        resolveRound();
        return;
      }

      if (phase === 'done'){
        if (winBox) winBox.classList.remove('show');

        if (round >= MAX_ROUNDS){
          // reset
          round = 0;
          pot = 0;
          phase = 'idle';

          resetVisual();
          bets = [0,0,0];
          renderBets();

          setClue('Tocá iniciar');
          lblEls.forEach((l,i)=>{ if (l) l.textContent = `Respuesta ${i+1}`; });

          startBtn.textContent = 'Iniciar';
          say('Juego terminado. Tocá Iniciar para jugar otra vez.');
          return;
        }

        // siguiente ronda
        phase = 'idle';
        await startFlow();
      }
    }

    // ======================
    // PICKER SUBASTA (MODAL PROPIO)
    // ======================
    function pickerShow(){
      pickerOv.classList.add('show');
      pickerOv.setAttribute('aria-hidden','false');
      pickerSearch.value = '';
      renderPickerList('');
      setTimeout(()=>{ try{ pickerSearch.focus(); }catch{} }, 0);
    }

    function pickerHide(){
      pickerOv.classList.remove('show');
      pickerOv.setAttribute('aria-hidden','true');
    }

    function renderPickerList(q){
      const query = String(q ?? '');
      const hasNorm = (typeof normKey === 'function');
      const kq = hasNorm ? normKey(query) : query.toLowerCase().trim();

      const list = (typeof ALL_SUBJECTS !== 'undefined' && Array.isArray(ALL_SUBJECTS)) ? ALL_SUBJECTS : [];
      const filtered = !kq ? list : list.filter(s=>{
        const nm = String(s?.name ?? '');
        const kn = hasNorm ? normKey(nm) : nm.toLowerCase().trim();
        return kn.includes(kq);
      });

      pickerList.innerHTML = '';

      if (!filtered.length){
        const div = document.createElement('div');
        div.className = 'subj-item';
        div.style.opacity = '.7';
        div.style.cursor = 'default';
        div.textContent = 'No hay resultados';
        pickerList.appendChild(div);
        return;
      }

      for (const s of filtered){
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'subj-item';
        btn.dataset.sid = String(s.id);
        btn.dataset.sname = String(s.name);
        btn.innerHTML = `${String(s.name)}<small>ID: ${String(s.id)}</small>`;
        pickerList.appendChild(btn);
      }
    }

    pickBtn.addEventListener('click', (e)=>{
      e.preventDefault();
      pickerShow();
    }, false);

    pickerClose.addEventListener('click', (e)=>{
      e.preventDefault();
      pickerHide();
    }, false);

    pickerOv.addEventListener('click', (e)=>{
      if (e.target === pickerOv) pickerHide();
    }, false);

    pickerSearch.addEventListener('input', ()=>{
      renderPickerList(pickerSearch.value);
    }, false);

    pickerList.addEventListener('click', (e)=>{
      const btn = e.target && e.target.closest ? e.target.closest('button.subj-item') : null;
      if (!btn) return;

      subjId = String(btn.dataset.sid || '').trim();
      subjName = String(btn.dataset.sname || '').trim();

      pickBtn.textContent = subjName ? (window.__gameShortSubj ? window.__gameShortSubj(subjName) : subjName) : 'Materia seleccionada';
      pickLbl.textContent = subjName ? (window.__gameShortSubj ? window.__gameShortSubj(subjName) : subjName) : 'Materia seleccionada';

      // reset por cambio de materia
      round = 0;
      pot = 0;
      phase = 'idle';
      bets = [0,0,0];

      resetVisual();
      renderBets();

      setClue('Tocá iniciar');
      lblEls.forEach((l,i)=>{ if (l) l.textContent = `Respuesta ${i+1}`; });

      startBtn.textContent = 'Iniciar';
      say('');

      pickerHide();
    }, false);

    // ======================
    // BETS ▲▼ (delegación)
    // ======================
    board.addEventListener('click', (e)=>{
      const btn = e.target && e.target.closest ? e.target.closest('button.auc-slot-btn') : null;
      if (!btn) return;

      e.preventDefault();

      if (phase !== 'betting'){
        say('Tocá Iniciar para cargar una ronda.');
        return;
      }

      const row = Math.max(1, Math.min(3, parseInt(String(btn.dataset.row || '0'), 10) || 0)) - 1;
      const dir = String(btn.dataset.au || '');

      if (dir === 'up') bets[row] += 1;
      else if (dir === 'down') bets[row] = Math.max(0, (bets[row] || 0) - 1);

      clampToPoints();
      renderBets();
    }, false);

    // ======================
    // START
    // ======================
    startBtn.addEventListener('click', async (e)=>{
      e.preventDefault();
      if (phase === 'resolving') return;
      await startFlow();
    }, false);

    // init
    resetVisual();
    bets = [0,0,0];
    renderBets();
    setClue('Tocá iniciar');
    startBtn.textContent = 'Iniciar';
  });
})();



