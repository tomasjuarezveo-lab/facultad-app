/* =========================
   ✅ SUBASTA (Auction) — REHECHA 100% FUNCIONAL
   ========================= */

  .auc-wrap{
    width:100%;
    max-width: 720px;
    margin: 0 auto;
  }

  .auc-title{
    font-weight: 950;
    color:#0f172a;
    letter-spacing:-.02em;
    text-align:center;
    font-size: 22px;
  }
  .auc-sub{
    margin: 8px auto 14px;
    text-align:center;
    color:#64748b;
    font-weight: 850;
    font-size: 13px;
    max-width: 620px;
    line-height: 1.25;
  }

  /* tablero */
  .auc-demo{
    margin: 10px auto 10px;
    width: min(560px, 92vw);
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    padding: 0 !important;
    position: relative;
    overflow: visible;
  }

  /* clue */
  .auc-clue{
    width: min(680px, 100%);
    margin: 8px auto 10px;
    text-align:center;
    font-weight: 950;
    color:#0f172a;
    font-size: clamp(15px, 2.2vw, 20px);
    letter-spacing: -.01em;
    line-height: 1.22;
    opacity:.92;
  }

  /* 3 cajas */
  .auc-slots{
    display:grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 10px;
    align-items:end;
  }
  .auc-slot{
    position: relative;
    height: 118px;
    display:flex;
    flex-direction:column;
    justify-content:flex-end;
    align-items:center;
    padding: 10px 10px 12px;
    background: transparent;
    border-radius: 16px;
    transform: translateZ(0);
  }

  /* borde abajo animable */
  .auc-slot::before{
    content:"";
    position:absolute;
    inset: 0;
    border-radius: 16px;
    border-left: 2px solid rgba(255,255,255,.22);
    border-right: 2px solid rgba(255,255,255,.22);
    border-top: 2px solid rgba(255,255,255,.22);
    border-bottom: 4px solid rgba(15,23,42,.28);
    pointer-events:none;
    transition: border-bottom-color 1.26s ease, opacity 1.62s ease; /* ✅ triple lento */
  }

  /* flechas */
  .auc-slot-btn{
    width: 34px;
    height: 30px;
    border-radius: 12px;
    border: 1px solid rgba(15,23,42,.12);
    background: rgba(255,255,255,.95);
    cursor:pointer;
    font-weight: 950;
    color:#0f172a;
    box-shadow: none;
    transition: transform .08s ease, opacity .12s ease;
  }
  .auc-slot-btn:active{ transform: scale(.99); }
  .auc-slot-btn:disabled{ opacity:.35; cursor:not-allowed; }

  /* valor */
  .auc-slot-val{
    margin: 8px 0 8px;
    min-height: 26px;
    font-weight: 950;
    font-size: 28px;
    line-height: 28px;
    color:#0f172a;
    opacity: .92;
    transition: color 1.44s ease, opacity 1.62s ease; /* ✅ triple lento */
  }

  /* labels */
  .auc-slot-labels{
    display:grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 10px;
    margin-top: 8px;
  }
  .auc-slot-label{
    text-align:center;
    font-weight: 950;
    color:#0f172a;
    opacity:.78;
    font-size: 12px;
    letter-spacing:.01em;
    transition: opacity 1.62s ease, color 1.44s ease; /* ✅ triple lento */
  }

  /* hint */
  .auc-footnote{
    text-align:center;
    color:#64748b;
    font-weight: 850;
    font-size: 12px;
    margin-top: 10px;
  }

  /* estados animados */
  .auc-slot.path-on::before{ border-bottom-color: rgba(15,23,42,.12) !important; }

  /* rojo */
  .auc-slot.is-red::before{ border-bottom-color: rgba(255,59,48,.92) !important; }
  .auc-slot.is-red .auc-slot-val{ color: rgba(255,59,48,.92) !important; }

  /* verde */
  .auc-slot.win-green::before{ border-bottom-color: rgba(52,211,153,.95) !important; }
  .auc-slot.win-green .auc-slot-val{ color: rgba(52,211,153,.95) !important; }

  /* ghost */
  .auc-slot.is-ghost .auc-slot-btn,
  .auc-slot.is-ghost .auc-slot-val{ opacity: 0 !important; }
  .auc-slot.is-ghost::before{ opacity: .22; }
  .auc-slot-label.is-ghost{ opacity: 0 !important; }

  /* win overlay */
  .auc-win{
    position:absolute;
    left:50%;
    top:50%;
    transform: translate(-50%,-50%) scale(.98);
    opacity: 0;
    pointer-events:none;
    background: rgba(255,255,255,.96);
    border: 2px solid #F8C160;
    border-radius: 22px;
    box-shadow: 0 18px 42px rgba(15,23,42,.20);
    text-align:center;
  }
  .auc-win-big{
    min-width: min(92vw, 520px);
    padding: 24px 22px;
  }
  .auc-win.show{
    opacity: 1;
    transform: translate(-50%,-50%) scale(1);
    transition: opacity 1.62s ease, transform 1.62s ease; /* ✅ triple lento */
  }
  .auc-win-title{
    font-weight: 950;
    color:#0f172a;
    font-size: 16px;
    opacity: .92;
  }
  .auc-win-points{
    margin-top: 8px;
    font-weight: 950;
    color:#0f172a;
    font-size: 34px;
  }

  /* ✅ Subasta: flash “gris claro” secuencial (cargando) */
  .auc-slot.is-flash{
    background: rgba(15,23,42,.06);
  }
  .auc-slot.is-flash::before{
    border-bottom-color: rgba(15,23,42,.10) !important;
  }

