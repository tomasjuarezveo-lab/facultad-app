            <div class="body"></div>
            <div class="loot"></div>
            <div class="door"></div>
            <div class="dial"></div>
          </div>

          <div class="nl-reward-title">Ganaste lo que había dentro de la caja fuerte</div>
          <div class="nl-reward-points">
            <span id="nlRewardPts">0</span> puntos
            <small id="nlRewardMult">—</small>
          </div>

          <button id="nlRewardOk" class="nl-btn" type="button">Seguir</button>
        </div>
      </div>


        </div>
      </div>
    </div>
  </section>


