  <section id="gameView-num-logic" class="game-view">
    <div class="game-shell">
      <div class="game-panel">
        <h3 class="game-h">🧠 Código Lógico</h3>
        <p class="game-p">Ganás números respondiendo y después los ordenás con pistas.</p>

        <div class="nl-wrap">

          <div class="nl-board" id="nlBoard"></div>

          <div class="nl-digits" id="nlDigits"></div>

