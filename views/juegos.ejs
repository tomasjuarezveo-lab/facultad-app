          subjPickerList.appendChild(b);
        });
      }

/* =========================================================
   ✅ SPEEDRUN: UI gate
   - Antes de iniciar: oculta #srBoard y muestra #srIntro
   - Al iniciar: muestra #srBoard y oculta #srIntro
   - Al volver al HUB y re-entrar: resetea a pre-inicio
   ========================================================= */
(function(){
  if (window.__SR_UI_GATE_READY__) return;
  window.__SR_UI_GATE_READY__ = true;

  const board = document.getElementById('srBoard');
  const intro = document.getElementById('srIntro');
  const start = document.getElementById('srStart');

  if (!board || !intro || !start) return;

  function pre(){
    intro.classList.remove('is-hidden');
    board.classList.add('is-hidden');
  }
  function run(){
    intro.classList.add('is-hidden');
    board.classList.remove('is-hidden');
  }

  // estado inicial
  pre();

  // al iniciar
  start.addEventListener('click', () => {
    if (String(document.body.dataset.activeGame || '') !== 'speedrun') return;
    run();
  });

  // si cambia el juego activo (HUB), resetea cuando entrás a speedrun
  const mo = new MutationObserver(() => {
    if (String(document.body.dataset.activeGame || '') === 'speedrun') pre();
  });
  mo.observe(document.body, { attributes:true, attributeFilter:['data-active-game'] });
})();


</script>

<script>
/* =========================================================
   ✅ SUBASTA: abrir modal "Elegir materia" (aucSubjPickerOverlay)
   - Hace funcional el botón #aucPickSubj
   - Renderiza lista + buscador
   - Al elegir: cambia el texto del botón y guarda el id/nombre
   ========================================================= */
(function(){
  if (window.__AUC_SUBJ_PICKER_READY__) return;
  window.__AUC_SUBJ_PICKER_READY__ = true;

  const overlay = document.getElementById('aucSubjPickerOverlay');
  const btnOpen = document.getElementById('aucPickSubj');
  const btnClose = document.getElementById('aucSubjPickerClose');
  const search = document.getElementById('aucSubjPickerSearch');
  const list = document.getElementById('aucSubjPickerList');
  const label = document.getElementById('aucSubjLabel');

  if (!overlay || !btnOpen || !btnClose || !search || !list) return;

  // Estado global (para que el resto del juego lo pueda leer si lo necesita)
  window.__AUC_SUBJECT__ = window.__AUC_SUBJECT__ || { id:'', name:'' };

  function norm(s){
    return String(s || '')
      .toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
      .replace(/\./g,' ')
      .replace(/\s+/g,' ')
      .trim();
  }

  function setPicked(id, name){
    const sid = String(id || '');
    const sname = String(name || '');

    window.__AUC_SUBJECT__ = { id: sid, name: sname };

    // guardar también en dataset (por si tu lógica lo usa)
    btnOpen.dataset.subjectId = sid;
    btnOpen.dataset.subjectName = sname;

    // UX: el botón pasa a mostrar el nombre elegido
    btnOpen.textContent = sname ? (window.__gameShortSubj ? window.__gameShortSubj(sname) : sname) : 'Elegir materia';

    if (label) label.textContent = sname ? (window.__gameShortSubj ? window.__gameShortSubj(sname) : sname) : 'Sin materia seleccionada';

    // Evento por si tu lógica ya escucha algo similar
    try{
      document.dispatchEvent(new CustomEvent('auction:subject', { detail: { id: sid, name: sname } }));
    }catch{}
  }

  function render(){
    const q = norm(search.value);
    const items = (window.ALL_SUBJECTS || ALL_SUBJECTS || []).filter(s => {
      if (!q) return true;
      return norm(s.name).includes(q);
    });

    list.innerHTML = '';

    if (!items.length){
      const empty = document.createElement('div');
      empty.className = 'slice-pop-empty';
      empty.textContent = 'No se encontraron materias.';
      list.appendChild(empty);
      return;
    }

    items.forEach(s => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'subj-item';
      b.innerHTML = `${String(s.name)}<small>ID: ${String(s.id)}</small>`;
      b.addEventListener('click', () => {
        setPicked(s.id, s.name);
        close();
      });
      list.appendChild(b);
    });
  }

  function open(){
    overlay.classList.add('show');
    overlay.setAttribute('aria-hidden', 'false');
    search.value = '';
    render();
    setTimeout(()=>{ try{ search.focus(); }catch{} }, 0);
  }

  function close(){
    overlay.classList.remove('show');
    overlay.setAttribute('aria-hidden', 'true');
  }

  // Abrir
  btnOpen.addEventListener('click', (e) => {
    e.preventDefault();
    open();
  });

  // Cerrar (botón)
  btnClose.addEventListener('click', (e) => {
    e.preventDefault();
    close();
  });

  // Cerrar tocando afuera (overlay)
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) close();
  });

  // Buscar
  search.addEventListener('input', render);

  // ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('show')) close();
  });
})();

/* =========================
   ✅ SPEED RUN — mostrar/ocultar tablero al iniciar o abandonar
   - Al iniciar: muestra #srBoard y oculta #srIntro
   - Al abandonar / volver al HUB: oculta #srBoard y muestra #srIntro
   - ⚠️ NO limpia #srSvg al iniciar (si no, desaparecen los cables)
   ========================= */
(function initSpeedRunReveal(){
  const srStart = document.getElementById('srStart');
  const srQuit  = document.getElementById('srQuit');
  const srBoard = document.getElementById('srBoard');
  const srIntro = document.getElementById('srIntro');
  const srMsg   = document.getElementById('srMsg');
  const srSvg   = document.getElementById('srSvg');

  if (!srStart || !srBoard) return;

  function srShowBoard(){
    srBoard.classList.remove('is-hidden');
    if (srIntro) srIntro.classList.add('is-hidden');
    if (srMsg) srMsg.textContent = '';
  }

  function srHideBoard(){
    srBoard.classList.add('is-hidden');
    if (srIntro) srIntro.classList.remove('is-hidden');
    if (srSvg) srSvg.innerHTML = '';
    if (srMsg) srMsg.textContent = '';
  }

  // estado inicial
  srHideBoard();

  // click iniciar → mostrar tablero (la lógica del juego se encarga de cargar todo)
  srStart.addEventListener('click', (e) => {
    e.preventDefault();
    srShowBoard();
  });

  // click abandonar → ocultar tablero (solo vuelve a aparecer con Iniciar)
  if (srQuit){
    srQuit.addEventListener('click', () => {
      srHideBoard();
    });
  }

  // al volver al HUB
  const back = document.getElementById('btnGamesBack');
  if (back){
    back.addEventListener('click', () => {
      srHideBoard();
    });
  }
})();

/* ===== PATCH UNIR (MATCH) ===== */
(() => {
  const wrap = document.querySelector('[data-game="match"]');
  if (!wrap) return;

  const svg     = wrap.querySelector('[data-role="match-lines"]');
  const timerEl = wrap.querySelector('[data-role="match-timer"]');
  const shell   = wrap.querySelector('[data-role="match-shell"]');
  const board   = wrap.querySelector('[data-role="match-board"]');
  const qCol    = wrap.querySelector('[data-role="match-qcol"]');
  const aCol    = wrap.querySelector('[data-role="match-acol"]');

  const btnStart = wrap.querySelector('[data-action="match-start"]');
  const btnPick  = wrap.querySelector('[data-action="match-pick"]');

  if (!svg || !timerEl || !board || !qCol || !aCol || !btnStart || !btnPick || !shell) return;

  shell.classList.add('match-shell');

  let running = false;
  let selected = null; // { el, side, key }

  const q2a = new Map(); // qKey -> aKey
  const a2q = new Map(); // aKey -> qKey
  const lines = new Map(); // qKey -> pathEl

  const DEFAULT_SECONDS = 25;
  let tLeft = DEFAULT_SECONDS;
  let tInt = null;

  const setTimerText = () => { timerEl.textContent = String(tLeft); };

  function stopTimer(){
    if (tInt) clearInterval(tInt);
    tInt = null;
  }
  function startTimer(){
    stopTimer();
    tLeft = DEFAULT_SECONDS;
    setTimerText();
    tInt = setInterval(() => {
      if (!running) return;
      tLeft -= 1;
      if (tLeft <= 0){
        tLeft = 0;
        setTimerText();
        endGame();
        return;
      }
      setTimerText();
    }, 1000);
  }

  function relCenter(el){
    const r = el.getBoundingClientRect();
    const w = wrap.getBoundingClientRect();
    return { x:(r.left+r.right)/2 - w.left, y:(r.top+r.bottom)/2 - w.top };
  }

  function makePath(className){
    const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    p.setAttribute('class', className);
    return p;
  }

  function drawLine(qEl, aEl, pathEl){
    const p1 = relCenter(qEl);
    const p2 = relCenter(aEl);
    const dx = Math.max(90, Math.abs(p2.x - p1.x) * 0.45);

    const c1x = p1.x + dx, c1y = p1.y;
    const c2x = p2.x - dx, c2y = p2.y;

    pathEl.setAttribute('d', `M ${p1.x} ${p1.y} C ${c1x} ${c1y}, ${c2x} ${c2y}, ${p2.x} ${p2.y}`);
  }

  function redrawAll(){
    for (const [qKey, aKey] of q2a.entries()){
      const qEl = wrap.querySelector(`.match-card[data-side="q"][data-k="${CSS.escape(qKey)}"]`);
      const aEl = wrap.querySelector(`.match-card[data-side="a"][data-k="${CSS.escape(aKey)}"]`);
      const p   = lines.get(qKey);
      if (qEl && aEl && p) drawLine(qEl, aEl, p);
    }
  }

  function clearSelection(){
    if (selected?.el) selected.el.classList.remove('is-selected');
    selected = null;
  }

  function getCard(target){
    const el = target.closest('.match-card');
    if (!el || !wrap.contains(el)) return null;
    const side = el.getAttribute('data-side');
    const key  = el.getAttribute('data-k');
    if ((side !== 'q' && side !== 'a') || !key) return null;
    return { el, side, key };
  }

  function unlinkQuestion(qKey){
    const aKey = q2a.get(qKey);
    if (!aKey) return;

    q2a.delete(qKey);
    a2q.delete(aKey);

    const p = lines.get(qKey);
    if (p) p.remove();
    lines.delete(qKey);

    const qEl = wrap.querySelector(`.match-card[data-side="q"][data-k="${CSS.escape(qKey)}"]`);
    const aEl = wrap.querySelector(`.match-card[data-side="a"][data-k="${CSS.escape(aKey)}"]`);
    if (qEl) qEl.classList.remove('is-linked');
    if (aEl) aEl.classList.remove('is-linked');
  }

  function link(qKey, aKey){
    // reemplazar unión previa del q
    unlinkQuestion(qKey);

    // si la respuesta ya estaba unida, liberar su pregunta previa
    const prevQ = a2q.get(aKey);
    if (prevQ) unlinkQuestion(prevQ);

    q2a.set(qKey, aKey);
    a2q.set(aKey, qKey);

    const qEl = wrap.querySelector(`.match-card[data-side="q"][data-k="${CSS.escape(qKey)}"]`);
    const aEl = wrap.querySelector(`.match-card[data-side="a"][data-k="${CSS.escape(aKey)}"]`);
    if (!qEl || !aEl) return;

    qEl.classList.add('is-linked');
    aEl.classList.add('is-linked');

    const p = makePath('match-line');
    svg.appendChild(p);
    lines.set(qKey, p);
    drawLine(qEl, aEl, p);
  }

  function setRunningUI(on){
    running = on;
    btnStart.textContent = on ? 'Rendirse' : 'Iniciar';
    btnPick.style.display = on ? 'none' : '';
  }

  function resetBoard(){
    clearSelection();
    stopTimer();

    for (const p of lines.values()) p.remove();
    lines.clear();
    q2a.clear();
    a2q.clear();

    wrap.querySelectorAll('.match-card.is-linked').forEach(el => el.classList.remove('is-linked'));

    tLeft = DEFAULT_SECONDS;
    setTimerText();
  }

  function startGame(){
    resetBoard();
    setRunningUI(true);
    startTimer();
    redrawAll();
  }

  function endGame(){
    setRunningUI(false);
    stopTimer();
    clearSelection();
    resetBoard();
  }

  // CLICK-CLICK para unir
  board.addEventListener('click', (e) => {
    if (!running) return;
    const c = getCard(e.target);
    if (!c) return;

    if (!selected){
      selected = c;
      selected.el.classList.add('is-selected');
      return;
    }

    if (selected.el === c.el){
      clearSelection();
      return;
    }

    if (selected.side === c.side){
      clearSelection();
      selected = c;
      selected.el.classList.add('is-selected');
      return;
    }

    const qKey = (selected.side === 'q') ? selected.key : c.key;
    const aKey = (selected.side === 'a') ? selected.key : c.key;
    link(qKey, aKey);
    clearSelection();
  }, { passive:true });

  // DRAG: mantener presionado + arrastrar + soltar
  let drag = null; // { from, pointerId, temp, p1 }

  function removeTemp(){
    if (drag?.temp) drag.temp.remove();
    drag = null;
  }

  board.addEventListener('pointerdown', (e) => {
    if (!running) return;
    const c = getCard(e.target);
    if (!c) return;

    e.preventDefault();
    board.setPointerCapture(e.pointerId);

    const p1 = relCenter(c.el);
    const tmp = makePath('match-temp');
    svg.appendChild(tmp);

    drag = { from:c, pointerId:e.pointerId, temp:tmp, p1 };

    clearSelection();
    selected = c;
    selected.el.classList.add('is-selected');

    const w = wrap.getBoundingClientRect();
    tmp.setAttribute('d', `M ${p1.x} ${p1.y} L ${e.clientX - w.left} ${e.clientY - w.top}`);
  });

  board.addEventListener('pointermove', (e) => {
    if (!drag || e.pointerId !== drag.pointerId) return;

    const w = wrap.getBoundingClientRect();
    drag.temp.setAttribute('d', `M ${drag.p1.x} ${drag.p1.y} L ${e.clientX - w.left} ${e.clientY - w.top}`);
  });

  board.addEventListener('pointerup', (e) => {
    if (!drag || e.pointerId !== drag.pointerId) return;

    const under = document.elementFromPoint(e.clientX, e.clientY);
    const target = under ? getCard(under) : null;

    if (target && target.el !== drag.from.el && target.side !== drag.from.side){
      const qKey = (drag.from.side === 'q') ? drag.from.key : target.key;
      const aKey = (drag.from.side === 'a') ? drag.from.key : target.key;
      link(qKey, aKey);
    }

    removeTemp();
    clearSelection();
  });

  board.addEventListener('pointercancel', (e) => {
    if (!drag || e.pointerId !== drag.pointerId) return;
    removeTemp();
    clearSelection();
  });

  // Botón iniciar: captura para que NO ejecute tu handler viejo
  btnStart.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopImmediatePropagation();
    if (!running) startGame();
    else endGame();
  }, true);

  window.addEventListener('resize', redrawAll, { passive:true });
  window.addEventListener('scroll', redrawAll, { passive:true });

  setTimerText();
  setRunningUI(false);
})();
/* =========================
   ✅ PATCH: Botón "Iniciar" con animación de carga (PC + móvil)
   ========================= */
(function(){
  if (window.__START_BTN_LOADING_PATCH__) return;
  window.__START_BTN_LOADING_PATCH__ = true;

  const START_IDS = new Set([
    'escStart',
    'srStart',
    'nlStart',
    'hpStart',
    'frStart',
    'safeStart',
    'aucStartReal',
    'aucStart',
    'aucFakeStart'
  ]);

  const stateMap = new WeakMap();

  function isStartButton(btn){
    if (!btn || btn.tagName !== 'BUTTON') return false;

    // prioridad por id (exactos)
    if (btn.id && START_IDS.has(btn.id)) return true;

    // fallback seguro: CTA con texto iniciar
    if (!btn.classList.contains('game-cta')) return false;
    const t = String(btn.textContent || '').trim().toLowerCase();
    return t === 'iniciar' || t.startsWith('iniciar ');
  }

  function beginLoading(btn){
    if (!isStartButton(btn)) return;
    if (btn.dataset.startLoading === '1') return;

    const currentTxt = String(btn.textContent || '').trim().toLowerCase();

    // si ya no dice iniciar (ej: "Listo", "Me rindo"), no forzar loading
    if (!(currentTxt === 'iniciar' || currentTxt.startsWith('iniciar '))) return;

    const saved = {
      html: btn.innerHTML,
      pe: btn.style.pointerEvents || '',
      aria: btn.getAttribute('aria-disabled')
    };

    btn.dataset.startLoading = '1';
    btn.style.pointerEvents = 'none';
    btn.setAttribute('aria-disabled', 'true');

    let dots = 0;
    btn.textContent = 'Iniciando';

    const tick = setInterval(()=>{
      if (!btn.isConnected) return;
      dots = (dots + 1) % 4; // 0..3
      btn.textContent = 'Iniciando' + '.'.repeat(dots);
    }, 240);

    // fallback para que nunca quede clavado
    const timeout = setTimeout(()=> endLoading(btn), 7000);

    stateMap.set(btn, { tick, timeout, saved });
  }

  function endLoading(btn){
    const st = stateMap.get(btn);
    if (!st) return;

    clearInterval(st.tick);
    clearTimeout(st.timeout);
    stateMap.delete(btn);

    // solo restauramos si todavía está mostrando nuestro texto
    const txt = String(btn.textContent || '').trim().toLowerCase();
    if (txt.startsWith('iniciando')){
      btn.innerHTML = st.saved.html;
    }

    btn.style.pointerEvents = st.saved.pe || '';
    if (st.saved.aria == null) btn.removeAttribute('aria-disabled');
    else btn.setAttribute('aria-disabled', st.saved.aria);

    delete btn.dataset.startLoading;
  }

  function endAllLoading(){
    document.querySelectorAll('button[data-start-loading="1"]').forEach(endLoading);
  }

  // expuesto por si querés usarlo manualmente en algún juego puntual
  window.__beginStartBtnLoading = beginLoading;
  window.__endStartBtnLoading = endLoading;
  window.__endAllStartBtnLoading = endAllLoading;

  // 1) arranca loading ANTES de los handlers normales (capture=true)
  document.addEventListener('click', function(e){
    const btn = e.target && e.target.closest ? e.target.closest('button') : null;
    if (!btn) return;
    beginLoading(btn);
  }, true);

  // 2) si el botón cambia de texto/estado/visibilidad, cortamos loading
  const mo = new MutationObserver(()=>{
    document.querySelectorAll('button[data-start-loading="1"]').forEach((btn)=>{
      if (!btn.isConnected){
        endLoading(btn);
        return;
      }

      const txt = String(btn.textContent || '').trim().toLowerCase();
      const hiddenByStyle = btn.style.display === 'none' || btn.hidden;
      const disabledNow = btn.disabled === true;

      // si el handler ya cambió el texto (ej: "Listo", "Me rindo") o lo ocultó, cortamos
      if (hiddenByStyle || (txt && !txt.startsWith('iniciando'))){
        endLoading(btn);
        return;
      }

      // si quedó disabled pero cambió el estado del juego, también lo soltamos
      if (disabledNow && !txt.startsWith('iniciando')){
        endLoading(btn);
      }
    });
  });

  mo.observe(document.documentElement, {
    subtree: true,
    childList: true,
    characterData: true,
    attributes: true,
    attributeFilter: ['style', 'class', 'hidden', 'disabled']
  });

  // 3) cuando termina una llamada de red (fetch), damos un pequeño margen y cortamos loading
  //    (sirve para "hasta que aparece la pregunta")
  if (!window.__START_BTN_LOADING_FETCH_WRAPPED__ && typeof window.fetch === 'function'){
    window.__START_BTN_LOADING_FETCH_WRAPPED__ = true;
    const _fetch = window.fetch.bind(window);

    const stopSoon = ()=>{
      setTimeout(()=>{
        requestAnimationFrame(()=>{
          requestAnimationFrame(()=>{
            endAllLoading();
          });
        });
      }, 120);
    };

    window.fetch = function(...args){
      return _fetch(...args)
        .then((res)=>{
          stopSoon();
          return res;
        })
        .catch((err)=>{
          stopSoon();
          throw err;
        });
    };
  }

  // 4) si volvés al HUB o cambiás de juego, aseguramos limpieza
  window.addEventListener('popstate', ()=> endAllLoading(), { passive:true });
  document.addEventListener('visibilitychange', ()=>{
    if (document.hidden) endAllLoading();
  });
})();
</script>




