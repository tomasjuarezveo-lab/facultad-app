    function srCfg(){
      const d = (window.__GAME_DIFFICULTY === 'hard' || window.__GAME_DIFFICULTY === 'medium') ? window.__GAME_DIFFICULTY : 'easy';
      if (d === 'hard')   return { sec: 30, reward: 10, label:'Difícil' };
      if (d === 'medium') return { sec: 60, reward: 7,  label:'Medio' };
      return { sec: 90, reward: 5, label:'Fácil' };
