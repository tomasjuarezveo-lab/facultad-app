  /* ===== PATCH UNIR (MATCH) ===== */
.match-wrap{ position: relative; width:100%; min-height: 560px; }

/* Timer: rectángulo arriba-izquierda */
.match-wrap [data-role="match-timer"]{
  position:absolute;
  left:14px; top:14px;
  height:44px;
  min-width:132px;
  padding:0 14px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  border-radius:14px;
  font-weight:800;
  letter-spacing:.3px;
  transform:none !important;
}

/* Contenedor grande 100% transparente, sin borde/sombra */
.match-wrap .match-shell,
.match-wrap [data-role="match-shell"]{
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}

/* Board centrado y columnas más separadas */
.match-wrap .match-board,
.match-wrap [data-role="match-board"]{
  position: relative;
  display:flex;
  justify-content:center;
  align-items:flex-start;
  gap: 150px;              /* MÁS separación */
  padding: 92px 18px 18px; /* deja lugar al timer */
}

/* Columnas */
.match-wrap .match-col{
  width: min(440px, 42vw);
  display:flex;
  flex-direction:column;
  gap:14px;
}

/* Cards */
.match-wrap .match-card{
  user-select:none;
  -webkit-user-select:none;
  touch-action:none;
  cursor:pointer;
  border-radius:16px;
}

/* Selección */
.match-wrap .match-card.is-selected{
  outline:2px solid rgba(45,212,191,.95);
  outline-offset:2px;
}

/* SVG líneas */
.match-wrap .match-lines{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  pointer-events:none;
  overflow:visible;
}

/* líneas */
.match-wrap .match-lines .match-line,
.match-wrap .match-lines .match-temp{
  fill:none;
  stroke: rgba(45,212,191,.95);
  stroke-width: 4;
  stroke-linecap: round;
  vector-effect: non-scaling-stroke;
  filter: drop-shadow(0 10px 18px rgba(15,23,42,.18));
}
@media (max-width: 520px){
  .match-wrap .match-board{
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding: 12px 12px 14px;
  }
  .match-wrap .match-col{
    gap: 10px;
  }
  .match-wrap .match-card{
    font-size: 13px;
    padding: 10px 10px;
  }
  .match-wrap .match-lines .match-line,
  .match-wrap .match-lines .match-temp{
    stroke-width: 3;
  }
}

/* ===== FIX: evitar scroll y subir el carrusel ===== */
html, body{ height: 100%; }
body{ overflow-x:hidden; }

/* Subí el bloque del carrusel */
@media (min-width: 641px){
  .wheel-wrap{ margin-top: -18px; }
}

/* Si tu contenedor del carrusel es más alto de lo necesario, recortalo al viewport */
.cards-viewport{
  max-height: calc(100vh - 220px);
  max-height: calc(100dvh - 220px);
  overflow: hidden;
}

/* Aislar pintura/layouteo para menos lag */
.cards-viewport, .cards-stage{
  contain: layout paint;
}

/* GPU + smoother transforms */
.game-card{
  transform: translate3d(0,0,0);
  backface-visibility: hidden;
}
/* =========================
   CAROUSEL: prev / active / next visibles (loop)
   ========================= */

/* A) El contenedor NO debe cortar laterales */
#gamesCarousel{
  position: relative;
  overflow: visible; /* <- clave para ver laterales */
}

/* B) Track en modo “escenario” */
#gamesTrack{
  position: relative;
  min-height: 320px; /* ajustá si tu card es más alta */
  overflow: visible;
}

/* C) Cards: apiladas y movidas por clases */
#gamesTrack .gameCard{
  position: absolute;
  left: 50%;
  top: 0;
  transform: translateX(-50%) scale(.92);
  opacity: .55;
  pointer-events: none;
  z-index: 1;
  transition: transform .45s ease, opacity .45s ease, filter .45s ease;
  filter: blur(.2px);
  will-change: transform, opacity;
}

/* Card activa */
#gamesTrack .gameCard.is-active{
  transform: translateX(-50%) scale(1);
  opacity: 1;
  pointer-events: auto;
  z-index: 3;
  filter: none;
}

/* Laterales */
#gamesTrack .gameCard.is-prev{
  transform: translateX(calc(-50% - var(--shift, 290px))) scale(.92);
  opacity: .60;
  z-index: 2;
}

#gamesTrack .gameCard.is-next{
  transform: translateX(calc(-50% + var(--shift, 290px))) scale(.92);
  opacity: .60;
  z-index: 2;
}

/* Responsive: distancia lateral */
@media (max-width: 520px){
  #gamesTrack{ min-height: 360px; }
  #gamesTrack .gameCard{ --shift: 210px; }
}
