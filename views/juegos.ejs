  }

  srResetUI();

  const ok = await srLoadRound();
  if (!ok) return;

  const cfg = srCfg();
  srEndsAt = Date.now() + (cfg.sec * 1000);

  srSetRunning(true);
  srTick();
  srTickInt = setInterval(srTick, 140);

  srSay('Conectá 3 pares y tocá Listo.');
});

