  ========================= */

  /* =========================
    ✅ DINAMITA: SIN BORDE ANIMADO
    - Se elimina el hilo/llama alrededor
    - Se deja SOLO el “suben/bajan” (hpFusePulse)
  ========================= */

  body.in-game.in-nonroulette #gameView-hotpotato .hp-optbtn{
    position: relative;
    border-radius: 18px;
    background: #fff;
