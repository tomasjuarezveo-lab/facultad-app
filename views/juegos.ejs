  async function animateCount(el, to, ms){
    const from = 0;
    const steps = Math.max(1, Math.min(30, to));
    const stepMs = Math.max(12, Math.floor(ms / steps));
    for (let i=from;i<=to;i++){
      el.textContent = String(i);
      await sleep(stepMs);
    }
  }

  async function pathPulse(times){
    // “camino” secuencial 1→2→3, 3 veces
    for (let t=0;t<times;t++){
      slot1.classList.add('path-on'); slot2.classList.remove('path-on'); slot3.classList.remove('path-on');
      await sleep(150);
      slot2.classList.add('path-on'); slot1.classList.remove('path-on'); slot3.classList.remove('path-on');
      await sleep(150);
      slot3.classList.add('path-on'); slot1.classList.remove('path-on'); slot2.classList.remove('path-on');
      await sleep(150);
    }
    slot1.classList.remove('path-on');
    slot2.classList.remove('path-on');
    slot3.classList.remove('path-on');
  }

  async function introSequence(){
    // 1) valores 0→3, 0→5, 0→1
    resetSlotsVisual();
    if (val1) val1.textContent = '0';
    if (val2) val2.textContent = '0';
    if (val3) val3.textContent = '0';

    await Promise.all([
      animateCount(val1, 3, 420),
      animateCount(val2, 5, 520),
      animateCount(val3, 1, 260),
    ]);

    // 2) botón falso “presionado”
    if (aucFakeStart){
      aucFakeStart.classList.add('is-pressed');
      aucFakeStart.disabled = true;
    }

    // 3) camino gris secuencial 3 veces
    await pathPulse(3);

    // 4) rojo + transparente en 1 y 3
    slot1.classList.add('is-red','is-ghost');
    slot3.classList.add('is-red','is-ghost');

    // 5) el del medio verde
    slot2.classList.add('win-green');

    // 6) cartel ganaste (pastilla)
    if (winTitle) winTitle.textContent = 'Ganaste';
    if (winPts) winPts.textContent = '10';
    if (winBox) winBox.classList.add('show');

    await sleep(650);

    // 7) desaparece toda la animación y aparece gate
    introDone = true;
    if (winBox) winBox.classList.remove('show');
    if (aucFakeWrap) aucFakeWrap.style.display = 'none';
    showGateOnly();
  }

  // ========= juego real =========
  function getCurrentPoints(){
    // usa scoreAlt si existe (topbar non-roulette), si no pointsValue, si no score
    const tryNum = (el) => {
      const n = parseInt((el && el.textContent) ? el.textContent : '0', 10);
      return Number.isFinite(n) ? n : 0;
    };
    return Math.max(0, tryNum(window.scoreAltEl) || tryNum(document.getElementById('scoreAlt')) || tryNum(document.getElementById('pointsValue')) || tryNum(document.getElementById('score')));
  }

  function getPickedSubject(){
    // NO rompemos tu picker: leemos dataset si tu código ya lo setea
    const idRaw =
      (pickBtn && pickBtn.dataset && pickBtn.dataset.subjId) ||
      (pickLbl && pickLbl.dataset && pickLbl.dataset.subjId) ||
      '';
    const nameRaw = (pickLbl && pickLbl.textContent) ? pickLbl.textContent.trim() : '';

    const idNum = Number(idRaw);
    const id = Number.isFinite(idNum) && idNum > 0 ? idNum : null;

    // fallback: si tu picker no usa dataset, pero cambia el texto del label
    const hasName = nameRaw && nameRaw.toLowerCase() !== 'sin materia seleccionada';

    return { id, name: hasName ? nameRaw : '' };
  }

  async function fetchQuestion3(subjectId){
    let q = null;
    try{
      const __p = (Number(window.__USER_PLAN||0) > 0) ? `&plan=${encodeURIComponent(String(window.__USER_PLAN))}` : '';
      const r = await fetch(`/api/quizzes?subject_id=${encodeURIComponent(subjectId)}&limit=20${__p}`);
      const arr = await r.json();
      if (Array.isArray(arr) && arr.length) q = arr[Math.floor(Math.random()*arr.length)];
    }catch(_){}

    if(!q || !Array.isArray(q.options) || q.options.length < 3){
      // fallback
      return {
        text: '(No hay preguntas registradas) — Probá con otra materia.',
        options: ['OK', 'OK', 'OK'],
        answer: 0
      };
    }

    // armamos 3 opciones garantizando la correcta
    const correct = q.answer;
    const opts = q.options.map((t, i)=>({ text:String(t), origIndex:i, isCorrect:(i===correct) }));
    let keep = [];

    // metemos correcta
    keep.push(opts.find(o=>o.isCorrect));

    // agregamos dos distintas (primeras que no sean correct)
    for (let i=0;i<opts.length && keep.length<3;i++){
      if (!opts[i].isCorrect) keep.push(opts[i]);
    }

    // si por lo que sea no llegamos (raro), duplicamos safe
    while(keep.length<3) keep.push({ text:'—', origIndex:-1, isCorrect:false });

    // shuffle simple pero estable
    for(let i=keep.length-1;i>0;i--){
      const j = Math.floor(Math.random()*(i+1));
      [keep[i],keep[j]] = [keep[j],keep[i]];
    }

    const correctIdx = keep.findIndex(o=>o.isCorrect);
    return { text: q.text || 'Pista', options3: keep, correctIdx };
  }

  function renderGameUI(qText, options3){
    // mostrar “pista”
    if (aucClue) aucClue.textContent = qText || 'Pista';

    // respuestas debajo (3 tarjetas)
    if (aucAnswers){
      aucAnswers.innerHTML = options3.map((o, idx)=>`
        <div class="auc-ans" data-idx="${idx}">
          <div class="auc-ans-bet">
            <strong style="font-weight:950;color:#0f172a;opacity:.9;">Apuesta:</strong>
          </div>
          <div class="auc-ans-text">
            ${o.text}
            <span class="auc-ans-sub">Elegí puntos con las flechas de arriba</span>
          </div>
        </div>
      `).join('');
    }

    // reset apuestas (cajas)
    bets = [0,0,0];
    if (val1) val1.textContent = '0';
    if (val2) val2.textContent = '0';
    if (val3) val3.textContent = '0';

    resetSlotsVisual();
    setSlotEnabled(true);

    // botón principal
    if (aucReveal){
      aucReveal.textContent = 'Apostar';
      aucReveal.disabled = false;
    }
    if (aucMsg) aucMsg.textContent = '';
  }

  function betDelta(row, dir){
    if (resolving) return;
    const i = row - 1;
    if (i<0 || i>2) return;

    const pts = getCurrentPoints();
    const sum = bets[0] + bets[1] + bets[2];

    if (dir === 'up'){
      if (sum + 1 > pts) return; // no pasar puntos
      bets[i] += 1;
    } else {
      bets[i] = Math.max(0, bets[i] - 1);
    }

    if (val1) val1.textContent = String(bets[0]);
    if (val2) val2.textContent = String(bets[1]);
    if (val3) val3.textContent = String(bets[2]);
  }

  async function resolveRound(){
    if (resolving) return;
    resolving = true;

    if (aucReveal) aucReveal.disabled = true;
    setSlotEnabled(false);

    // secuencia gris 3 veces
    await pathPulse(3);

    // revela correcto: verde, otros desaparecen
    const slots = [slot1,slot2,slot3];
    const vals  = [val1,val2,val3];

    slots.forEach((s, i)=>{
      s.classList.remove('is-red','is-ghost','win-green','drop');
      if(i === correctIndex){
        s.classList.add('win-green');
      }else{
        s.classList.add('drop');
      }
    });

    await sleep(320);

      // cálculo puntos: ganás doble de la apuesta en la correcta y perdés el total apostado
      const totalBet = bets[0] + bets[1] + bets[2];
      const winBet   = bets[correctIndex] || 0;
      const delta    = (winBet * 2) - totalBet;

      // impacta en servidor
      try{
        await addServerPoints(delta);
      }catch(_){}

      // mensaje + overlay resultado
      if (resTitle) resTitle.textContent = (delta >= 0) ? '¡Ganaste!' : 'Perdiste';
      if (resPts) resPts.textContent = (delta >= 0)
        ? `Sumaste ${delta} puntos`
        : `Perdiste ${Math.abs(delta)} puntos`;

      if (resOverlay){
        resOverlay.classList.add('show');
        resOverlay.setAttribute('aria-hidden','false');
      }
    }

    function closeResultOverlay(){
      if (resOverlay){
        resOverlay.classList.remove('show');
        resOverlay.setAttribute('aria-hidden','true');
      }
    }

    async function startGameReal(){
      const subj = getPickedSubject();
      if (!subj.id){
        if (aucGateMsg) aucGateMsg.textContent = 'Primero elegí una materia.';
        return;
      }

      // mostrar demo (cajas) y juego
      if (aucStartGate) aucStartGate.classList.remove('is-show');
      if (aucDemo) aucDemo.classList.remove('is-hidden');
      if (aucGame) aucGame.classList.remove('is-hidden');

      gameRunning = true;
      resolving = false;

      // traer pregunta y render
      const q = await fetchQuestion3(subj.id);
      currentQ = q;
      currentOpt3 = q.options3 || [];
      correctIndex = Number.isFinite(q.correctIdx) ? q.correctIdx : 1;

      renderGameUI(`Pista: ${q.text || '—'}`, currentOpt3);
    }

    // click flechas (reusa los mismos botones del demo)
    aucDemo.addEventListener('click', (e)=>{
      const btn = e.target.closest('.auc-slot-btn');
      if(!btn) return;

      if (!gameRunning || resolving) return; // en intro no
      const dir = btn.dataset.demo; // 'up'|'down'
      const row = parseInt(btn.dataset.row, 10);
      if (!row) return;
      betDelta(row, dir);
    });

    // apostar
    if (aucReveal){
      aucReveal.addEventListener('click', async ()=>{
        if (!gameRunning || resolving) return;

        const pts = getCurrentPoints();
        const total = bets[0]+bets[1]+bets[2];
        if (total > pts){
          if (aucMsg) aucMsg.textContent = 'Tu apuesta total no puede superar tus puntos.';
          return;
        }
        await resolveRound();
      });
    }

    // siguiente (volver al gate sin animación)
    if (resNext){
      resNext.addEventListener('click', ()=>{
        closeResultOverlay();

        // volver al inicio SIN animación
        showGateOnly();
      });
    }

    // intro: botón falso
    if (aucFakeStart){
      aucFakeStart.addEventListener('click', async ()=>{
        if (introRunning && !introDone && !introSequence.__running){
          introSequence.__running = true;
          await introSequence();
          introSequence.__running = false;
        }
      });
    }

    // iniciar real
    if (aucStart){
      aucStart.addEventListener('click', async ()=>{
        await startGameReal();
      });
    }

    // cuando entrás a subasta (detecta data-active-game)
    let last = '';
    const mo = new MutationObserver(async ()=>{
      const g = body.getAttribute('data-active-game') || '';
      if (g === last) return;
      last = g;

      if (g === 'auction'){
        // al entrar:
        // - si no se hizo intro aún en esta sesión → mostrar intro + demo + botón falso
        // - si ya se jugó → mostrar gate sin animación
        if (!introDone){
          showIntro();
          // valores arrancan en 0 siempre al entrar
          resetSlotsVisual();
          if (winBox) winBox.classList.remove('show');
        }else{
          showGateOnly();
        }
      }
    });
    mo.observe(body, { attributes:true, attributeFilter:['data-active-game'] });

    // estado inicial por si ya estaba activo
    const g0 = body.getAttribute('data-active-game') || '';
    if (g0 === 'auction'){
      if (!introDone) showIntro(); else showGateOnly();
    }
  })();

  /* =========================
   ✅ SUBASTA (Auction) — Intro + Juego Real
   ========================= */


        // ✅ Mirror de puntos: mantiene #hpScoreMirror sincronizado con #scoreAlt/#score
      (function(){
        const dst = document.getElementById('hpScoreMirror');
        if (!dst) return;

        const pickSource = () =>
          document.getElementById('scoreAlt') ||
