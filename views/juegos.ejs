            <ul id="nlClueList"></ul>
          </div>

          <div class="game-subject-row">
            <button type="button" class="game-subject-btn" id="nlPickSubj">Elegir materia</button>
            <div class="game-subject-label" id="nlSubjLabel">Sin materia seleccionada</div>
          </div>

          <div class="nl-q" id="nlQText">Tocá iniciar</div>

          <div class="nl-ansrow" id="nlAnswerRow" style="display:none;">
            <input id="nlAnswer" class="nl-input" placeholder="Escribí tu respuesta…" autocomplete="off" />
            <button id="nlSubmit" class="nl-btn" type="button">Responder</button>
          </div>

          <div class="nl-ansrow" id="nlSolveRow" style="display:none;">
            <button id="nlSolve" class="nl-btn secondary" type="button">Resolver</button>
          </div>

          <div style="display:flex;justify-content:center;margin-top:10px;">
            <button id="nlStart" class="game-cta" type="button">Iniciar</button>
          </div>

          <div id="nlMsg" class="game-msg"></div>

