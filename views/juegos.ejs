  /* ✅ respiración (queda tal cual) */
  body.in-game.in-nonroulette #gameView-hotpotato #hpOpts.hp-burning .hp-optbtn{
    animation: hpFusePulse .22s ease-in-out infinite alternate;
  }
  @keyframes hpFusePulse{
    from{ transform: translateY(0px); }
    to{ transform: translateY(-1px); }
  }

    /* =========================
      ✅ MECHA HORIZONTAL (Dinamita)
      - Arranca izquierda cuando inicia el contador
      - El fuego llega a la derecha al finalizar
      - Solo visible cuando el timer está corriendo (body.hp-ticking)
    ========================= */
    .hp-fuse{
      display:none;
      justify-content:center;
      margin: 6px auto 10px;
      opacity: 0;
      transform: translateY(-2px);
      transition: opacity .18s ease;
    }

    body.hp-running[data-active-game="hotpotato"] .hp-fuse{
      display:flex;
    }
    body.hp-running.hp-ticking[data-active-game="hotpotato"] .hp-fuse{
      opacity: 1;
    }

    .hp-fuse-line{
        position: relative;
        width: min(360px, 78vw);
        height: 10px;
        border-radius: 9999px;
        background: rgba(15,23,42,.08);
        border: 1px solid rgba(15,23,42,.12);
        overflow: visible; /* ✅ deja que la llama sobresalga */
      }

    .hp-fuse-fill{
      position:absolute;
      left:0; top:0;
      height:100%;
      width:0%;
      background: linear-gradient(90deg,
        rgba(244,186,93,.95),
        rgba(255,159,10,.95),
        rgba(255,59,48,.95)
      );
      opacity:.55;
    }

    .hp-fuse-flame{
      position:absolute;
      top:50%;
      left:0%;
      transform: translate(-50%,-60%); /* ✅ un toque más arriba */
      width: 22px;
      height: 22px;
      z-index: 3; /* ✅ arriba del borde */
      filter: drop-shadow(0 2px 10px rgba(255,59,48,.25));
      transition: left .12s linear;
    }
    .hp-fuse-flame svg{ width:22px; height:22px; display:block; }



  /* =========================
    ✅ Dinamita: Nivel/Vidas INLINE (debajo respuestas, arriba de Iniciar)
