  function sleep(ms){ return new Promise(r=>setTimeout(r, ms)); }

  function resetSlotsVisual(){
    [slot1,slot2,slot3].forEach(s=>{
      s.classList.remove('path-on','is-red','is-ghost','win-green','drop','flash-gray','flash-red');
    });
