    };

    const SLUG_TO_GAME = {};
    Object.keys(GAME_TO_SLUG).forEach(k => { SLUG_TO_GAME[GAME_TO_SLUG[k]] = k; });
    // aceptar también keys como “slug” (por compatibilidad)
    Object.keys(GAME_TO_SLUG).forEach(k => { SLUG_TO_GAME[k] = k; });

    function setUrlHub(replace){
      const url = '/app/juegos';
      if (replace) history.replaceState({ hub:true }, '', url);
      else history.pushState({ hub:true }, '', url);
    }

    function setUrlGame(key, replace){
      const slug = GAME_TO_SLUG[key] || key;
      const url = `/app/juegos/${encodeURIComponent(slug)}`;
      if (replace) history.replaceState({ game:key }, '', url);
      else history.pushState({ game:key }, '', url);
    }

    function forceAbortActiveMiniGame(){
  try{
    const active = document.querySelector('.game-view.is-active');
    if (!active) return;

    const clickIfPresent = (sel)=>{
      const b = active.querySelector(sel);
      if (!b || b.disabled) return false;
      b.click();
      return true;
    };

    const clickIfTextMatch = (sel, words)=>{
      const b = active.querySelector(sel);
      if (!b || b.disabled) return false;
      const t = String(b.textContent || '').toLowerCase();
      if (!words.some(w => t.includes(w))) return false;
      b.click();
      return true;
    };

      // juegos con botón "Abandonar" dedicado
      clickIfPresent('#srQuit');
      clickIfPresent('#frQuit');

      // juegos donde el botón de iniciar cambia a "Salir" / "Me rindo"
      clickIfTextMatch('#escStart', ['salir']);
      clickIfTextMatch('#nlStart', ['rindo', 'rendir']);
      clickIfTextMatch('#hpStart', ['rindo', 'rendir']);
    }catch(_){ }
  }
  window.__forceAbortActiveMiniGame = forceAbortActiveMiniGame;

  function showHub(opts={}){
    try{ forceAbortActiveMiniGame(); }catch(_){ }
    hideAll();
    if (hub) hub.style.display = 'block';
    if (top) top.classList.remove('is-show');
    document.body.classList.remove('in-game','in-nonroulette');
    document.body.removeAttribute('data-active-game');
    try{ window.__setHudPickLabel('Elegir materia'); }catch(_){}
    stopAllDemos();

    if (!opts.noUrl) setUrlHub(!!opts.replaceUrl);
  }

    function showGame(key, opts={}){
      hideAll();
      if (hub) hub.style.display = 'none';
      if (top) top.classList.add('is-show');

      document.body.classList.add('in-game');
      document.body.setAttribute('data-active-game', key);
      if (key !== 'roulette') document.body.classList.add('in-nonroulette');
      else document.body.classList.remove('in-nonroulette');

      const mapTitle = {
        roulette: 'Ruleta Quiz',
        hotpotato: 'Dinamita',
        escape: 'Escape Room',
        'num-logic': 'Caja Fuerte',
        'impostor-phrase': 'Frase Impostora',
        'false-room': 'Sala de Falsas',
        'impostor-topic': 'Impostor',
        auction: 'Subasta',
        sketch: 'Pinturillo'
      };
      if (title) title.textContent = mapTitle[key] || 'Juego';

      const v = views[key];
      if (v) v.classList.add('is-active');

      // cada vez que entrás a un juego, frenamos timers previos
      stopAllDemos();

      if (!opts.noUrl) setUrlGame(key, !!opts.replaceUrl);
    }

    hub && hub.addEventListener('click', (e)=>{
      const card = e.target.closest('[data-game]');
      if (!card) return;
      showGame(card.getAttribute('data-game'));
