  function polarToXY(cx, cy, r, ang){ return [cx + r * Math.cos(ang), cy + r * Math.sin(ang)]; }
  function slicePath(startAng, endAng){
    const [x1,y1] = polarToXY(CX, CY, R, startAng);
    const [x2,y2] = polarToXY(CX, CY, R, endAng);
    const largeArc = (endAng - startAng) > Math.PI ? 1 : 0;
    return `M ${CX} ${CY} L ${x1} ${y1} A ${R} ${R} 0 ${largeArc} 1 ${x2} ${y2} Z`;
  }

  function positionPlusArrow(){
    const arrow = document.getElementById('roulettePlusArrow');
    const wheel = document.getElementById('wheelSvg');
    const wrap  = document.querySelector('#gameView-roulette .wheel-wrap');
    if (!arrow || !wheel || !wrap) return;

    const idx = slices.findIndex(s => !(s && s.id != null));
    if (idx < 0) return;

    const n = slices.length || 1;
    const step = (Math.PI * 2) / n;
    const a0 = -Math.PI/2 + idx * step;
    const a1 = a0 + step;
    const mid = (a0 + a1) / 2;

    // mismo radio que el botón + del sector
    const [ix, iy] = polarToXY(CX, CY, R*0.46, mid);

    const pt = wheel.createSVGPoint();
    pt.x = ix; pt.y = iy;

    const ctm = wheel.getScreenCTM();
    if (!ctm) return;

    const screen = pt.matrixTransform(ctm);
    const wr = wrap.getBoundingClientRect();

    // ubicamos la flecha "cerca" y un toque arriba del +
    const left = (screen.x - wr.left) + 18;
    const top  = (screen.y - wr.top) - 110;

    arrow.style.left = `${left}px`;
    arrow.style.top  = `${top}px`;
  }

  function updateRouletteHint(){
    const hint  = document.getElementById('rouletteNeedPick');
    const arrow = document.getElementById('roulettePlusArrow');
    if (!hint) return;

    const allChosen = slices.length && slices.every(s => s && s.id != null);
    const dismissed = sessionStorage.getItem('rouletteNeedPickDismissed') === '1';

    if (!allChosen){
      if (!dismissed) hint.classList.add('show');
      else hint.classList.remove('show');

      if (arrow){
        arrow.classList.add('show');
        positionPlusArrow();
      }
    } else {
      hint.classList.remove('show');
      if (arrow) arrow.classList.remove('show');
      sessionStorage.removeItem('rouletteNeedPickDismissed');
    }
  }

  function renderWheel(){
    if (!spinG) return;
    spinG.innerHTML = '';
    const n = slices.length;
    const step = (Math.PI * 2) / n;

    for (let i=0;i<n;i++){
      const a0 = -Math.PI/2 + i*step;
      const a1 = a0 + step;

      const g  = document.createElementNS('http://www.w3.org/2000/svg','g');
      g.setAttribute('data-index', i);

      const gradId = `grad${i}`;
      const defs = document.createElementNS('http://www.w3.org/2000/svg','defs');
      const lg = document.createElementNS('http://www.w3.org/2000/svg','linearGradient');
      lg.setAttribute('id', gradId);
      lg.setAttribute('x1','0%'); lg.setAttribute('y1','0%'); lg.setAttribute('x2','100%'); lg.setAttribute('y2','100%');
      const s1 = document.createElementNS('http://www.w3.org/2000/svg','stop'); s1.setAttribute('offset','0%'); s1.setAttribute('stop-color', COLS[i%COLS.length][0]);
      const s2 = document.createElementNS('http://www.w3.org/2000/svg','stop'); s2.setAttribute('offset','100%'); s2.setAttribute('stop-color', COLS[i%COLS.length][1]);
      lg.appendChild(s1); lg.appendChild(s2); defs.appendChild(lg); g.appendChild(defs);

      const path = document.createElementNS('http://www.w3.org/2000/svg','path');
      path.setAttribute('d', slicePath(a0, a1));
      path.setAttribute('fill', `url(#${gradId})`);
      path.setAttribute('opacity','0.96');
      g.appendChild(path);

      const mid = (a0 + a1) / 2;
      const [tx,ty] = polarToXY(CX, CY, R*0.55, mid);
      const text = document.createElementNS('http://www.w3.org/2000/svg','text');
      text.setAttribute('x', tx);
      text.setAttribute('y', ty);
      text.setAttribute('class','slice-label');
      text.setAttribute('style','font-size:26px; cursor:pointer; user-select:none;');

      const nm = slices[i].name || '';
      if (!slices[i].id){
        text.textContent = '';
        text.style.pointerEvents = 'none';
      } else {
        const short = nm.length > 16 ? (nm.slice(0,15)+'…') : nm;
        text.textContent = short;
        text.style.pointerEvents = 'auto';
      }

      text.addEventListener('click', (e)=> openPicker(i, e.clientX, e.clientY));
      g.appendChild(text);

      // mini botón + / ✓
      const [ix,iy] = polarToXY(CX, CY, R*0.46, mid);
      const iconG = document.createElementNS('http://www.w3.org/2000/svg','g');
      iconG.setAttribute('class','slice-icon slice-icon-badge');
      iconG.style.pointerEvents = 'all';

      const ic = document.createElementNS('http://www.w3.org/2000/svg','circle');
      ic.setAttribute('cx', ix);
      ic.setAttribute('cy', iy);
      ic.setAttribute('r', 40);
      ic.setAttribute('fill', 'rgba(255,255,255,.28)');
      ic.setAttribute('stroke', 'rgba(255,255,255,.55)');
      ic.setAttribute('stroke-width', '2.5');
      ic.style.pointerEvents = 'all';
      iconG.appendChild(ic);

      const hasSub = !!(slices[i] && slices[i].id != null);

      if(!hasSub){
        const p1 = document.createElementNS('http://www.w3.org/2000/svg','path');
        p1.setAttribute('d', `M ${ix-16} ${iy} L ${ix+16} ${iy}`);
        p1.setAttribute('stroke', '#fff');
        p1.setAttribute('stroke-width', '5');
        p1.setAttribute('stroke-linecap', 'round');
        p1.style.pointerEvents = 'all';

        const p2 = document.createElementNS('http://www.w3.org/2000/svg','path');
        p2.setAttribute('d', `M ${ix} ${iy-16} L ${ix} ${iy+16}`);
        p2.setAttribute('stroke', '#fff');
        p2.setAttribute('stroke-width', '5');
        p2.setAttribute('stroke-linecap', 'round');
        p2.style.pointerEvents = 'all';

        iconG.appendChild(p1);
        iconG.appendChild(p2);

        iconG.addEventListener('click', (e)=> {
          e.stopPropagation();
          openPicker(i, e.clientX, e.clientY);
        });

        g.appendChild(iconG);
      }

      spinG.appendChild(g);
    }

    updateRouletteHint();
  }

  // Popover de materias
  let popEl=null;

    // ===============================
  // ✅ Picker mode: "roulette" (no repetir) vs "game" (mostrar todas)
  // ===============================
  let __subjPickerMode = 'roulette'; // default

  function setPickerMode(mode){
    __subjPickerMode = (mode === 'game') ? 'game' : 'roulette';
  }

  // Botones de juegos (incluye Subasta) => modo game (NO filtra por chosenIds)
  (function bindGamePickButtons(){
    const ids = ['hpPickSubj','nlPickSubj','escPickSubj','aucPickSubj'];
    ids.forEach(id=>{
      const btn = document.getElementById(id);
      if (!btn) return;
      btn.addEventListener('click', ()=>{
        setPickerMode('game');
      }, true); // capture: corre antes que tu handler actual, no rompe nada
    });
  })();

  function openPicker(idx, x, y){
    closePicker();
    popEl = document.createElement('div');
    popEl.className = 'slice-pop';
    popEl.style.left = x + 'px';
    popEl.style.top  = y + 'px';

    popEl.innerHTML = `
      <div class="slice-pop-header">
        <input class="slice-pop-search" type="text" placeholder="Buscar materia…" aria-label="Buscar materia" />
      </div>
      <div class="slice-pop-list"></div>
    `;

    document.body.appendChild(popEl);

    const input = popEl.querySelector('.slice-pop-search');
    const list  = popEl.querySelector('.slice-pop-list');

    function renderList(query){
      const qk = normKey(query);

      const items = (ALL_SUBJECTS || []).filter(s => {
        if(!qk) return true;
        return normKey(s.name).includes(qk);
      });

      if(!ALL_SUBJECTS.length){
        list.innerHTML = `<div class="slice-pop-empty">No hay materias disponibles.</div>`;
        return;
      }

      if(!items.length){
        list.innerHTML = `<div class="slice-pop-empty">No se encontraron coincidencias.</div>`;
        return;
      }

      list.innerHTML = '';
      items.forEach(s => {
        const b = document.createElement('button');
        b.type = 'button';
        b.dataset.id = s.id;
        b.textContent = s.name || '';
        b.addEventListener('click', () => {
          const id = b.dataset.id;
          const numId = (id != null && id !== '') ? Number(id) : null;
          window.setSlice(idx, Number.isFinite(numId) ? numId : id, (s.name || ''));
        });
        list.appendChild(b);
      });
    }

    renderList('');
    input.addEventListener('input', () => renderList(input.value));
    setTimeout(() => { try{ input.focus(); }catch(_){} }, 0);

    requestAnimationFrame(() => {
      if(!popEl) return;
      const rect = popEl.getBoundingClientRect();
      const pad = 12;
      const halfW = rect.width / 2;
      const halfH = rect.height / 2;
      let cx = x, cy = y;
      cx = Math.max(halfW + pad, Math.min(window.innerWidth  - halfW - pad, cx));
      cy = Math.max(halfH + pad, Math.min(window.innerHeight - halfH - pad, cy));
      popEl.style.left = cx + 'px';
      popEl.style.top  = cy + 'px';
    });

    setTimeout(() => {
      document.addEventListener('click', outsidePicker, { once:true });
    }, 0);

    window.addEventListener('resize', closePicker, { once:true });
    window.addEventListener('scroll', closePicker, { once:true, passive:true });
  }

  function outsidePicker(){ closePicker(); }
  function closePicker(){ if(popEl){ popEl.remove(); popEl=null; } }

  window.setSlice = (i,id,name)=>{
    if (slices[i] && slices[i].id != null) chosenIds.delete(slices[i].id);
    slices[i] = { id, name };
    if (id != null) chosenIds.add(id);

    const allChosen = slices.length && slices.every(s => s && s.id != null);
    if (allChosen) selecting = false;

    renderWheel();
    closePicker();
  };

  // Giro
  let spinning=false, currentRot=0;
  const btnSpin  = document.getElementById('btnSpin');
  let currentAnim = null;

  function spin(){
    if (spinning || !slices.length) return;

    // ✅ NO girar si no están todas seleccionadas
    const allChosen = slices.every(s => s && s.id != null);
    if (!allChosen){
      updateRouletteHint();
      const hint = document.getElementById('rouletteNeedPick');
      if (hint){
        hint.classList.add('show');
        setTimeout(()=> hint.classList.remove('show'), 1800);
      }
      return;
    }

    selecting = false;
    renderWheel();

    spinning = true;
    closePicker();

    if (currentAnim){ try{ currentAnim.cancel(); }catch(_){} currentAnim=null; }

    const n = slices.length;
    const stepDeg = 360 / n;
    const targetIdx = Math.floor(Math.random()*n);
    const targetAngle = (targetIdx * stepDeg) + stepDeg/2;

    const fastTurns = 100 + Math.floor(Math.random()*40);
    const approachTurns = 1 + Math.floor(Math.random()*2);

    const fastDeg = fastTurns * 360;
    const finalDeg = fastDeg + (approachTurns * 360) + targetAngle;

    const startDeg = currentRot;
    const midDeg = startDeg + fastDeg;
    const endDeg = startDeg + finalDeg;

    const keyframes = [
      { transform: `rotate(${startDeg}deg)` },
      { transform: `rotate(${midDeg}deg)`, offset: 0.8, easing: 'cubic-bezier(.05,.9,.2,1)' },
      { transform: `rotate(${endDeg}deg)`, offset: 1, easing: 'cubic-bezier(.2,1,.25,1)' }
    ];

    currentAnim = spinG.animate(keyframes, { duration: 5000, easing: 'linear', fill: 'forwards' });

    currentAnim.addEventListener('finish', () => {
      currentRot = ((endDeg % 360) + 360) % 360;
      spinning = false;
      const chosen = slices[targetIdx];
      loadQuestion(chosen);
    }, { once:true });
  }

  if (btnSpin) btnSpin.addEventListener('click', spin);
  const wheelStage = document.querySelector('.wheel-stage');
  wheelStage && wheelStage.addEventListener('dblclick', spin);

  // ====== Overlay de Preguntas ======
  const qaOverlay = document.getElementById('qaOverlay');
  const qText     = document.getElementById('qText');
  const optsBox   = document.getElementById('opts');
  const btnNext   = document.getElementById('btnNext');
  const btnCancel = document.getElementById('btnCancel');
  const qFeedback = document.getElementById('qFeedback');

  function openQA(){
    qaOverlay.classList.add('show');
    qaOverlay.setAttribute('aria-hidden','false');
  }
  function closeQA(){
    qaOverlay.classList.remove('show');
    qaOverlay.setAttribute('aria-hidden','true');
    qFeedback.textContent = '';
    btnNext.disabled = false;
  }

  qaOverlay.addEventListener('click', (e)=>{ if (e.target === qaOverlay) closeQA(); });
  btnCancel.addEventListener('click', closeQA);

  async function loadQuestion(subject){
    qText.textContent = `Cargando pregunta de ${subject.name || 'Materia'}…`;
    optsBox.innerHTML = '';
    qFeedback.textContent = '';
    openQA();

    let q = null;
    try{
      if (subject.id!=null){
        const __p = (Number(window.__USER_PLAN||0) > 0) ? `&plan=${encodeURIComponent(String(window.__USER_PLAN))}` : '';
        const r = await fetch(`/api/quizzes?subject_id=${encodeURIComponent(subject.id)}&limit=10${__p}`);
        const arr = await r.json();
        if (Array.isArray(arr) && arr.length) q = arr[Math.floor(Math.random()*arr.length)];
      }
    }catch(e){}

    if(!q){
      q = { text:'(No hay preguntas registradas) — Probá con otra materia.', options:['OK'], answer:0 };
    }

    qText.textContent = q.text || 'Pregunta';

    if (Array.isArray(q.options) && q.options.length){
      optsBox.innerHTML = q.options.map((opt,i)=>`
        <label class="opt">
          <input type="radio" name="ans" value="${i}">
          <span>${opt}</span>
        </label>
      `).join('');

      btnNext.onclick = async ()=> {
        const checked = optsBox.querySelector('input[name="ans"]:checked');
        if (!checked) { qFeedback.textContent = 'Elegí una opción'; return; }
        btnNext.disabled = true;

        const u = parseInt(checked.value,10);
        const ok = (u === q.answer);

        if (ok) {
          qFeedback.textContent = '¡Correcto! 🎉 +1 punto';
          await addServerPoints(1);
        } else {
          const correct = (q.options && q.options[q.answer] != null) ? q.options[q.answer] : '—';
          qFeedback.textContent = `Incorrecto. Respuesta correcta: ${correct}`;
        }
        setTimeout(()=> { closeQA(); }, 1200);
      };
    } else {
      btnNext.onclick = ()=> { closeQA(); };
    }
  }

  // Selector de cantidad
  const countWrap = document.getElementById('countWrap');
  countWrap && countWrap.addEventListener('click', (e)=>{
    const btn = e.target.closest('.count-btn'); if(!btn) return;
    const n = parseInt(btn.dataset.count,10);
    sliceCount = Math.max(MIN_SLICES, Math.min(MAX_SLICES, n));
    countWrap.querySelectorAll('.count-btn').forEach(b=>b.setAttribute('aria-pressed','false'));
    btn.setAttribute('aria-pressed','true');
    seedSlices();
    renderWheel();
  });

  // Init ruleta
  seedSlices();
  renderWheel();
  fetchPointsAndSyncUI();
</script>

<script>
  /* =========================
     ✅ HUB: show/hide de juegos
     (ACÁ ESTABA TU PROBLEMA: faltaba stopAllDemos() y te rompía TODO)
     ========================= */
  (function(){

        /* =========================
       ✅ FIX CRÍTICO: stopAllDemos()
       - Evita ReferenceError cuando cambiás de juego / volvés al HUB
       - Limpia timers/intervalos y resetea UI de demos
       ========================= */
    function stopAllDemos(){
      // 1) Timers/intervalos registrados en window.__aucDemoTimers (si existen)
      try{
        if (window.__aucDemoTimers && Array.isArray(window.__aucDemoTimers)){
          window.__aucDemoTimers.forEach(t=>{
            try{
              if (!t) return;
              if (t.type === 'i') clearInterval(t.id);
              else clearTimeout(t.id);
            }catch(_){}
          });
          window.__aucDemoTimers = [];
        }
      }catch(_){}

      // 2) Reset UI demo Subasta (si existe)
      try{
        const demoWin = document.getElementById('aucDemoWin');
        if (demoWin) demoWin.classList.remove('show');

        ['aucSlot1','aucSlot2','aucSlot3'].forEach(id=>{
            const el = document.getElementById(id);
            if (!el) return;
            el.classList.remove('flash-gray','flash-red','win-green','drop');
          });

        ['aucDemoVal1','aucDemoVal2','aucDemoVal3'].forEach(id=>{
          const v = document.getElementById(id);
          if (v) v.textContent = '0';
        });
      }catch(_){}

      // 3) Si dejaste un loop de tick sonoro corriendo en algún lado
      try{
        if (window.__sfxTickInt){
          clearInterval(window.__sfxTickInt);
          window.__sfxTickInt = null;
        }
      }catch(_){}

      // 4) Si tenés stop handlers globales (no rompe si no existen)
      try{ if (typeof window.stopHotPotato === 'function') window.stopHotPotato(); }catch(_){}
      try{ if (typeof window.stopAuction === 'function') window.stopAuction(); }catch(_){}
      try{ if (typeof window.stopFalseRoom === 'function') window.stopFalseRoom(); }catch(_){}
      try{ if (typeof window.stopSketch === 'function') window.stopSketch(); }catch(_){}
      try{ if (typeof window.__STOP_SR === 'function') window.__STOP_SR(); }catch(_){}
      try{ if (typeof window.__STOP_ESC === 'function') window.__STOP_ESC(); }catch(_){}
      try{ if (typeof window.__STOP_NL === 'function') window.__STOP_NL(); }catch(_){}
      try{ if (typeof window.__STOP_HP === 'function') window.__STOP_HP(); }catch(_){}
      try{ if (typeof window.__STOP_SAFE === 'function') window.__STOP_SAFE(); }catch(_){}
    }

    // Exponerlo por si lo llamás desde otros lados
    window.stopAllDemos = stopAllDemos;

        /* =========================
       🔊 SFX (Sonidos)
       - Sin librerías
       - Mobile-friendly: desbloquea audio en primer touch/click
       ========================= */

    const SFX = {
      // ✅ Poné rutas reales a tus audios (mp3/ogg/wav)
      win:  ['/sounds/win.mp3', '/sounds/win.ogg'],
      lose: ['/sounds/lose.mp3', '/sounds/lose.ogg'],
      tick: ['/sounds/tick.mp3', '/sounds/tick.ogg'], // opcional
    };

    function pickPlayableSrc(list){
      if (!Array.isArray(list)) return null;
      const a = document.createElement('audio');
      for (const src of list){
        const ext = String(src).split('.').pop().toLowerCase();
        const mime =
          ext === 'mp3' ? 'audio/mpeg' :
          ext === 'ogg' ? 'audio/ogg'  :
          ext === 'wav' ? 'audio/wav'  : '';
        if (!mime || a.canPlayType(mime)) return src;
      }
      return list[0] || null;
    }

    const __SFX_CACHE = {};
    let __SFX_ENABLED = true;
    let __SFX_UNLOCKED = false;

    function sfxLoad(name){
      const src = pickPlayableSrc(SFX[name]);
      if (!src) return null;
      if (__SFX_CACHE[name]) return __SFX_CACHE[name];
      const au = new Audio(src);
      au.preload = 'auto';
      au.volume = 0.9; // ajustá si querés
      __SFX_CACHE[name] = au;
      return au;
    }

    function sfxUnlock(){
      if (__SFX_UNLOCKED) return;
      __SFX_UNLOCKED = true;

      // “warmup” para iOS/Chrome mobile
      try{
        Object.keys(SFX).forEach(k=>{
          const au = sfxLoad(k);
          if (!au) return;
          au.muted = true;
          au.play().then(()=>{ au.pause(); au.currentTime = 0; au.muted = false; }).catch(()=>{});
        });
      }catch(_){}
    }

    function sfxPlay(name){
      if (!__SFX_ENABLED) return;
      const au = sfxLoad(name);
      if (!au) return;

      // Reiniciar para que suene aunque se dispare seguido
      try{
        au.pause();
        au.currentTime = 0;
        au.play().catch(()=>{});
      }catch(_){}
    }

    // Desbloqueo de audio en el primer gesto del usuario
    window.addEventListener('pointerdown', sfxUnlock, { once:true, passive:true });
    window.addEventListener('keydown', sfxUnlock, { once:true });

    // Exponer por si querés mutear desde UI más adelante
    window.__SFX = {
      play: sfxPlay,
      setEnabled: (v)=>{ __SFX_ENABLED = !!v; }
    };

    const hub   = document.getElementById('gamesHub');
    const top   = document.getElementById('gameTopbar');
    const back  = document.getElementById('btnGamesBack');
    const title = document.getElementById('gameTopTitle');

    const views = {
      roulette: document.getElementById('gameView-roulette'),
      hotpotato: document.getElementById('gameView-hotpotato'),
      escape: document.getElementById('gameView-escape'),
      'num-logic': document.getElementById('gameView-num-logic'),
      'impostor-phrase': document.getElementById('gameView-impostor-phrase'),
      'false-room': document.getElementById('gameView-false-room'),
      'impostor-topic': document.getElementById('gameView-impostor-topic'),
      auction: document.getElementById('gameView-auction'),
      sketch: document.getElementById('gameView-sketch'),
    };

    function hideAll(){
      Object.values(views).forEach(v => v && v.classList.remove('is-active'));
    }



        // =========================
    // ✅ SUBASTA: Intro animación NUEVA (3 cajas)
    // - lenta
    // - al terminar: desaparece animación
    // - recién ahí muestra: “¿Deseas empezar el juego ya? Elegir materia Iniciar”
    // =========================
    async function runAuctionIntro(){
      const demo = document.getElementById('aucDemo');
      const gate = document.getElementById('aucStartGate');

      const v1 = document.getElementById('aucDemoVal1');
      const v2 = document.getElementById('aucDemoVal2');
      const v3 = document.getElementById('aucDemoVal3');

      const s1 = document.getElementById('aucSlot1');
      const s2 = document.getElementById('aucSlot2');
      const s3 = document.getElementById('aucSlot3');

      const l1 = document.getElementById('aucLbl1');
      const l2 = document.getElementById('aucLbl2');
      const l3 = document.getElementById('aucLbl3');

      const win = document.getElementById('aucDemoWin');
      const winPts = document.getElementById('aucDemoWinPts');

      if (!demo || !gate || !v1 || !v2 || !v3 || !s1 || !s2 || !s3 || !l1 || !l2 || !l3 || !win) return;

      // Reset visual
      gate.classList.remove('is-show');               // ✅ NO se ve el gate
      demo.style.display = '';                       // ✅ se ve demo
      win.classList.remove('show');

      s1.className = 'auc-slot';
      s2.className = 'auc-slot';
      s3.className = 'auc-slot';

      l1.style.display = '';
      l2.style.display = '';
      l3.style.display = '';

      v1.textContent = '0';
      v2.textContent = '0';
      v3.textContent = '0';
      if (winPts) winPts.textContent = '10';

      // helper timers (para stopAllDemos)
      const timers = [];
      window.__aucDemoTimers = window.__aucDemoTimers || [];
      function wait(ms){
        return new Promise(res=>{
          const id = setTimeout(res, ms);
          timers.push(id);
          window.__aucDemoTimers.push({ type:'t', id });
        });
      }

      // ✅ Paso 1: pone "3" en primera caja (se ve arriba de la única línea “real” = abajo)
      await wait(650);
      v1.textContent = '3';

      // ✅ Paso 2: sube caja 2 hasta 5 (uno a uno, lento)
      await wait(650);
      for (let n=1;n<=5;n++){
        v2.textContent = String(n);
        await wait(520);
      }

      // ✅ Paso 3: sube caja 3 hasta 1 (uno a uno, lento)
      await wait(650);
      v3.textContent = '1';

      // ✅ Paso 4: titilan las 3 líneas (gris oscuro <-> gris claro)
      await wait(520);
      s1.classList.add('flash-gray');
      s2.classList.add('flash-gray');
      s3.classList.add('flash-gray');
      await wait(2400);
      s1.classList.remove('flash-gray');
      s2.classList.remove('flash-gray');
      s3.classList.remove('flash-gray');

      // ✅ Paso 5: 1 y 3 titilan rojo
      s1.classList.add('flash-red');
      s3.classList.add('flash-red');
      await wait(1600);
      s1.classList.remove('flash-red');
      s3.classList.remove('flash-red');

      // ✅ Paso 6: desaparecen 1 y 3 (línea + número + pregunta)
      s1.classList.add('drop');
      s3.classList.add('drop');
      l1.style.display = 'none';
      l3.style.display = 'none';
      await wait(320);

      // ✅ Paso 7: queda solo 2 en verde
      s2.classList.add('win-green');

      // ✅ Paso 8: “Ganaste” + “10 puntos”
      await wait(360);
