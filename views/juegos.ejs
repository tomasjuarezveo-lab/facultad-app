    });

    function getGameFromPath(){
      const p = String(location.pathname || '');
      const m = p.match(/\/app\/juegos\/([^\/?#]+)/i);
      if (!m) return '';
      const slug = decodeURIComponent(m[1]).toLowerCase();
      return SLUG_TO_GAME[slug] || '';
    }

    // ✅ Init: si venís desde /app/juegos/<slug> abre ese juego
    const initKeyServer = (typeof __INITIAL_GAME_KEY !== 'undefined') ? String(__INITIAL_GAME_KEY || '') : '';
    const initKeyPath = getGameFromPath();
    const initKey = (initKeyServer && views[initKeyServer]) ? initKeyServer : initKeyPath;

    if (initKey && views[initKey]) showGame(initKey, { replaceUrl:true });
    else showHub({ replaceUrl:true });

    // Back/forward del navegador
    window.addEventListener('popstate', ()=>{
      const k = getGameFromPath();
