    const hudPickBtn = document.querySelector('.hud-pick-subj');
    window.__HUD_PICK_BTN = hudPickBtn;

    window.__shortGameSubjectLabel = function(txt){
      const raw = (txt == null ? '' : String(txt)).trim();
      if (!raw) return 'Elegir materia';
      if (/^elegir\s+materia$/i.test(raw)) return 'Elegir materia';
      if (raw.length <= 7) return raw;
      return raw.slice(0, 7).trimEnd() + '...';
    };

    window.__setHudPickLabel = function(txt){
      if (!hudPickBtn) return;
      hudPickBtn.textContent = window.__shortGameSubjectLabel(txt);
    };

    try{
      const __truncateSubjBtnText = (root)=>{
        (root || document).querySelectorAll('.game-subject-btn').forEach(btn=>{
          const raw = String(btn.textContent || '').trim();
          const next = window.__shortGameSubjectLabel(raw);
          if (raw !== next) btn.textContent = next;
        });
      };

      __truncateSubjBtnText(document);

      const __subjObs = new MutationObserver((mutList)=>{
        for (const m of mutList){
          const t = m && m.target;
          if (!t || !t.classList) continue;
          if (!t.classList.contains('game-subject-btn')) continue;
          const raw = String(t.textContent || '').trim();
          const next = window.__shortGameSubjectLabel(raw);
          if (raw !== next) t.textContent = next;
        }
      });

      document.querySelectorAll('.game-subject-btn').forEach(btn=>{
        __subjObs.observe(btn, { childList:true, characterData:true, subtree:true });
      });
    }catch(_){ }

    function getActivePickBtn(){
      const active = document.querySelector('.game-view.is-active');
      if (!active) return null;
      return active.querySelector('[id$="PickSubj"]');
