          return;
        }

        // Si NO está corriendo, iniciar normal
        if (!nlSubject){
          if (nlMsg) nlMsg.textContent = 'Elegí una materia para jugar.';
          return;
        }

        nlReset();
        nlSetRunning(true);

        // Arranque real del juego (lo que ya tenías)
        // 👉 acá dejá tu flujo actual: primer pregunta / etc.
        // Si tu código actual llama a una función para cargar pregunta, mantenelo.
        try{
          if (typeof nlNextQuestion === 'function'){
            nlNextQuestion();
          }
        }catch(_){}
      });

    // stop externo
    window.__STOP_NL = function(){
      try{
        nlRunning = false;
        nlStage = 'idle';
        if (nlSubmit) nlSubmit.disabled = false;
        if (nlSolve) nlSolve.disabled = false;
        if (nlAnswerRow) nlAnswerRow.style.display = 'none';
        if (nlSolveRow) nlSolveRow.style.display = 'none';
        nlHideClues();
      }catch(_){}
    };

    // init UI base
    nlReset();

    /* =========================
       ✅ DINAMITA (HotPotato) REAL
       - Timer en círculo: easy=25, medium=15, hard=10
       - 5 rondas x 3 preguntas (15 correctas para ganar)
       - Al ganar: +10 puntos
       - Incorrecta o tiempo: pierde vida (3)
       ========================= */
    let hpInterval = null;
    let hpLives = 3;
        let hpRunning = false;

    function hpSetRunning(on){
      hpRunning = !!on;
      if (hpStart) hpStart.textContent = hpRunning ? 'Me rindo' : 'Iniciar';
      document.body.classList.toggle('hp-running', hpRunning);
      hpTogglePickSubj(hpRunning); // ✅ oculto mientras corre la partida

      // asegurar que el HUD muestre la materia elegida
      try{
        if (document.body.getAttribute('data-active-game') === 'hotpotato'){
          window.__setHudPickLabel(hpSubject ? hpSubject.name : 'Elegir materia');
        }
      }catch(_){}
    }

    function hpGiveUp(){
      // termina la partida sin puntos, pero mantiene la materia elegida
      hpStop();
      hpSetRunning(false);

      // resetea run, pero NO toca la materia
      hpLives = 3;
      hpRound = 1;
      hpInRound = 0;
      hpQ = null;

      if (hpTimer) hpTimer.textContent = '—';
      if (hpQText) hpQText.textContent = 'Tocá iniciar';
      if (hpOpts){
        hpOpts.classList.remove('hp-burning');
        hpOpts.innerHTML = '';
      }
      if (hpMsg) hpMsg.textContent = 'Te rendiste. No sumaste puntos.';
      hpSyncUI();
    }

    let hpRound = 1;
    let hpInRound = 0; // 0..3
    const HP_ROUNDS = 5;
    const HP_PER_ROUND = 3;
    let hpActive = false;
    let hpSubject = null;
    let hpQ = null;
    let hpDeadline = 0;

    const hpTimer = document.getElementById('hpTimer');
