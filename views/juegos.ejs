    function srInitSvg(){
      if (!srSvg) return;

            srSvg.setAttribute('viewBox','0 0 1000 1000');
            srSvg.setAttribute('preserveAspectRatio','none');


      srSvg.innerHTML = `
        <defs>
          <linearGradient id="srWire0" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%"  stop-color="rgba(239,68,68,.95)"/>
            <stop offset="100%" stop-color="rgba(127,29,29,.95)"/>
          </linearGradient>
          <linearGradient id="srWire1" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%"  stop-color="rgba(245,158,11,.95)"/>
            <stop offset="100%" stop-color="rgba(146,64,14,.95)"/>
          </linearGradient>
          <linearGradient id="srWire2" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%"  stop-color="rgba(59,130,246,.95)"/>
            <stop offset="100%" stop-color="rgba(30,58,138,.95)"/>
          </linearGradient>
        </defs>
        <g id="srWires"></g>
        <path id="srPrevBase" class="sr-wire-base" style="display:none" />
        <path id="srPrevHi" class="sr-wire-hi" style="display:none" />
      `;

      __srWiresG = srSvg.querySelector('#srWires');
      __srPrevBase = srSvg.querySelector('#srPrevBase');
      __srPrevHi = srSvg.querySelector('#srPrevHi');
    }

    function srSvgPointFromClient(cx, cy){
      const r = srSvg.getBoundingClientRect();
      const x = ((cx - r.left) / (r.width || 1)) * 1000;
      const y = ((cy - r.top) / (r.height || 1)) * 1000;
      return { x, y };
    }

        function srCenter(el){
      const r = el.getBoundingClientRect();
      const id = String(el.id || '');
      const pad = 10;

      const cx = id.startsWith('srQ')
        ? (r.right - pad)
        : id.startsWith('srA')
          ? (r.left + pad)
          : (r.left + r.width / 2);

      const cy = r.top + r.height / 2;
      const p = srSvgPointFromClient(cx, cy);
      return p;
    }

    function srCurve(p1, p2){
      const dx = (p2.x - p1.x);
      const dy = (p2.y - p1.y);
      const adx = Math.abs(dx);
      const ady = Math.abs(dy);

      // Curva estilo “cable”: si están a la misma altura (layout en 2 columnas),
      // hace una panza suave; si están uno arriba del otro, curva lateral.
      if (adx >= ady){
        const bulge = Math.min(150, Math.max(55, adx * 0.18));
        const c1x = p1.x + dx * 0.35;
        const c2x = p1.x + dx * 0.65;
        const c1y = p1.y - bulge;
        const c2y = p2.y + bulge;
        return `M ${p1.x.toFixed(2)} ${p1.y.toFixed(2)} C ${c1x.toFixed(2)} ${c1y.toFixed(2)}, ${c2x.toFixed(2)} ${c2y.toFixed(2)}, ${p2.x.toFixed(2)} ${p2.y.toFixed(2)}`;
      } else {
        const bulge = Math.min(150, Math.max(55, ady * 0.18));
        const c1y = p1.y + dy * 0.35;
        const c2y = p1.y + dy * 0.65;
        const c1x = p1.x + bulge;
        const c2x = p2.x - bulge;
        return `M ${p1.x.toFixed(2)} ${p1.y.toFixed(2)} C ${c1x.toFixed(2)} ${c1y.toFixed(2)}, ${c2x.toFixed(2)} ${c2y.toFixed(2)}, ${p2.x.toFixed(2)} ${p2.y.toFixed(2)}`;
      }
    }

    function srDrawLinks(){
      if (!__srWiresG) return;
      __srWiresG.innerHTML = '';

      for (let qIdx=0;qIdx<3;qIdx++){
        const aIdx = srLinks[qIdx];
        if (aIdx == null) continue;

        const qEl = srQ[qIdx];
        const aEl = srA[aIdx];
        if (!qEl || !aEl) continue;

        const p1 = srCenter(qEl);
        const p2 = srCenter(aEl);
        const d = srCurve(p1, p2);
        const grad = `url(#srWire${qIdx})`;

        const g = document.createElementNS('http://www.w3.org/2000/svg','g');

        const base = document.createElementNS('http://www.w3.org/2000/svg','path');
        base.setAttribute('d', d);
        base.setAttribute('class','sr-wire-base');
        base.setAttribute('stroke', grad);

        const hi = document.createElementNS('http://www.w3.org/2000/svg','path');
        hi.setAttribute('d', d);
        hi.setAttribute('class','sr-wire-hi');

        const c1 = document.createElementNS('http://www.w3.org/2000/svg','circle');
        c1.setAttribute('cx', String(p1.x));
        c1.setAttribute('cy', String(p1.y));
        c1.setAttribute('r', '7');
        c1.setAttribute('fill', grad);
        c1.setAttribute('class','sr-plug');

        const c2 = document.createElementNS('http://www.w3.org/2000/svg','circle');
        c2.setAttribute('cx', String(p2.x));
        c2.setAttribute('cy', String(p2.y));
        c2.setAttribute('r', '7');
        c2.setAttribute('fill', grad);
        c2.setAttribute('class','sr-plug');

        g.appendChild(base);
        g.appendChild(hi);
        g.appendChild(c1);
        g.appendChild(c2);

        __srWiresG.appendChild(g);
      }
    }

        function srShowPreview(qIdx, clientX, clientY){
      const qEl = srQ[qIdx];
      srShowPreviewFrom(qEl, qIdx, clientX, clientY);
    }

    function srShowPreviewFrom(startEl, wireIdx, clientX, clientY){
      if (!__srPrevBase || !__srPrevHi) return;
      if (!startEl) return;

      const p1 = srCenter(startEl);
      const p2 = srSvgPointFromClient(clientX, clientY);
      const d = srCurve(p1, p2);

      __srPrevBase.style.display = '';
      __srPrevHi.style.display = '';

      __srPrevBase.setAttribute('d', d);
      __srPrevHi.setAttribute('d', d);

      __srPrevBase.setAttribute('stroke', `url(#srWire${wireIdx % 3})`);
      __srPrevBase.style.strokeDasharray = '8 6';
      __srPrevHi.style.strokeDasharray = '8 6';
      __srPrevHi.style.opacity = '.95';
    }
        function srShowPreviewFrom(startEl, wireIdx, clientX, clientY){
      if (!__srPrevBase || !__srPrevHi || !startEl) return;

      const p1 = srCenter(startEl);
      const p2 = srSvgPointFromClient(clientX, clientY);
      const d = srCurve(p1, p2);

      __srPrevBase.style.display = '';
      __srPrevHi.style.display = '';

      __srPrevBase.setAttribute('d', d);
      __srPrevHi.setAttribute('d', d);
      __srPrevBase.setAttribute('stroke', `url(#srWire${Math.max(0, Math.min(2, Number(wireIdx) || 0))})`);
    }

        function srHidePreview(){
      if (__srPrevBase){
        __srPrevBase.style.display = 'none';
        __srPrevBase.style.strokeDasharray = 'none';
      }
      if (__srPrevHi){
        __srPrevHi.style.display = 'none';
        __srPrevHi.style.strokeDasharray = 'none';
      }
    }

    function srClearCards(){
      for (let i=0;i<3;i++){
        if (srQ[i]){
          srQ[i].textContent = '';
          srQ[i].classList.remove('is-q','is-linked','is-bad');
        }
        if (srA[i]){
          srA[i].textContent = '';
          srA[i].classList.remove('is-a','is-linked','is-used','is-bad');
        }
      }
    }

    async function srFetchPairs(){
      if (!srSubject || srSubject.id == null) return null;

      const __p = (Number(window.__USER_PLAN||0) > 0) ? `&plan=${encodeURIComponent(String(window.__USER_PLAN))}` : '';
      const r = await fetch(`/api/quizzes?subject_id=${encodeURIComponent(srSubject.id)}&limit=20${__p}`);
      const arr = await r.json();

      const pool = (Array.isArray(arr) ? arr : [])
        .filter(q => q && q.text && Array.isArray(q.options) && q.options.length);

      // mezclar pool
      pool.sort(() => Math.random() - 0.5);

      const usedQ = new Set();
      const usedA = new Set();
      const chosen = [];

      for (const q of pool){
        const qText = String(q.text || '').trim();
        if (!qText || usedQ.has(qText)) continue;

        const ansIdx = Number.isFinite(Number(q.answer)) ? Number(q.answer) : 0;
        const aText = (q.options && q.options[ansIdx] != null) ? String(q.options[ansIdx]).trim() : '';
        if (!aText || usedA.has(aText)) continue;

        chosen.push({ q: qText, a: aText });
        usedQ.add(qText);
        usedA.add(aText);

        if (chosen.length === 3) break;
      }

      return (chosen.length === 3) ? chosen : null;
    }

    async function srLoadRound(){
      srClearCards();
      srInitSvg();
      srHidePreview();

      srPairs = [];
      srAnsOrder = [];
      srCorrectMap = [0,0,0];
      srLinks = [null,null,null];
      srUsedA = new Set();

      if (srRoundText) srRoundText.textContent = 'Conectá 3 cables';

      srSay('Cargando…');

      let pairs = null;
      try{
        pairs = await srFetchPairs();
      }catch(_){}

      if (!pairs){
        srSay('(No hay suficientes preguntas únicas) — Probá otra materia.');
        srSetRunning(false);
        return false;
      }

      // mezclar orden de preguntas
      pairs = pairs.slice().sort(() => Math.random() - 0.5);
      srPairs = pairs;

      // respuestas en orden mezclado
      srAnsOrder = pairs.map(p => p.a).sort(() => Math.random() - 0.5);

      for (let i=0;i<3;i++){
        srCorrectMap[i] = srAnsOrder.indexOf(srPairs[i].a);
      }

      for (let i=0;i<3;i++){
        if (srQ[i]){
          srQ[i].textContent = srPairs[i].q;
          srQ[i].classList.add('is-q');
        }
        if (srA[i]){
          srA[i].textContent = srAnsOrder[i];
          srA[i].classList.add('is-a');
        }
      }

      srDrawLinks();
      srSay('Mantené apretado una pregunta y soltá sobre su respuesta.');

      return true;
    }

    function srStopTimer(){
      if (srTickInt){
        clearInterval(srTickInt);
        srTickInt = null;
      }
    }

    function srTick(){
      const left = Math.max(0, srEndsAt - Date.now());
      srSetTime(left / 1000);

      if (left <= 0){
        srLose('⏱️ Se acabó el tiempo.');
      }
    }

    async function srWin(){
      if (!srRunning) return;

      srStopTimer();

      const cfg = srCfg();
      srSetRunning(false);

      try{ window.__SFX && window.__SFX.play && window.__SFX.play('win'); }catch(_){}
      try{ await addServerPoints(cfg.reward); }catch(_){}

      srOpenWin('¡Ganaste! ✅', cfg.reward, `${cfg.label} · reiniciado automáticamente`, 'Entendido');
      srResetUI();
      srSay('');
    }

    function srLose(msg){
      if (!srRunning) return;

      srStopTimer();

      for (let i=0;i<3;i++){
        if (srQ[i] && srLinks[i] == null) srQ[i].classList.add('is-bad');
      }

      const cfg = srCfg();
      srSetRunning(false);

      const cleanMsg = String(msg || 'Perdiste ❌');
      const title = /abandonaste/i.test(cleanMsg) ? 'Ronda cancelada' : 'Perdiste ❌';

      srOpenWin(title, 0, `${cfg.label} · ${cleanMsg} · reiniciado automáticamente`, 'Entendido');
      srResetUI();
      srSay('');

      try{ window.__SFX && window.__SFX.play && window.__SFX.play('lose'); }catch(_){}
    }

    function srResetUI(){
      srStopTimer();
      srDrag = null;

      const cfg = srCfg();
      srSetTime(cfg.sec);

      if (srRoundText) srRoundText.textContent = 'Conectá 3 cables';

      srHidePreview();
      if (srSvg) srInitSvg();
      srClearCards();

      srPairs = [];
      srAnsOrder = [];
      srCorrectMap = [0,0,0];
      srLinks = [null,null,null];
      srUsedA = new Set();

      if (!srRunning){
        srSetRunning(false);
      }
    }

    // Interacción: arrastre desde preguntas (Q) hacia respuestas (A)
// === Conectar: click (selección) y drag (mantener + arrastrar) ===
function srClearSelection(){
  srSelected = null;
  srQ.forEach(el=> el && el.classList.remove('is-selected'));
  srA.forEach(el=> el && el.classList.remove('is-selected'));
}

function srSelect(type, idx){
  srClearSelection();
  srSelected = { type, idx };
  const el = (type==='q') ? srQ[idx] : srA[idx];
  if (el) el.classList.add('is-selected');
}

function srUnsetLinkForQ(qIdx){
  const prevA = srLinks[qIdx];
  if (prevA == null) return;
  srLinks[qIdx] = null;
  srUsedA.delete(prevA);
  if (srQ[qIdx]) srQ[qIdx].classList.remove('is-linked','is-bad');
  if (srA[prevA]) srA[prevA].classList.remove('is-linked','is-used','is-bad');
}

function srUnsetLinkForA(aIdx){
  const qIdx = srLinks.findIndex(x => x === aIdx);
  if (qIdx < 0) return;
  srUnsetLinkForQ(qIdx);
}

function srSetLink(qIdx, aIdx){
  if (qIdx < 0 || aIdx < 0) return;

  srUnsetLinkForQ(qIdx);
  srUnsetLinkForA(aIdx);

  srLinks[qIdx] = aIdx;
  srUsedA.add(aIdx);

  if (srQ[qIdx]) srQ[qIdx].classList.add('is-linked');
  if (srA[aIdx]) srA[aIdx].classList.add('is-linked','is-used');

  srDrawLinks();
  srSay(`Conectado ✅ ${srUsedA.size}/3`);
}

function srCardClick(type, idx){
  if (!srRunning) return;
  if (Date.now() < srSkipClickUntil) return;

  if (!srSelected){
    srSelect(type, idx);
    srSay('Ahora tocá el cuadro con el que lo querés unir.');
    return;
  }

  if (srSelected.type === type){
    srSelect(type, idx);
    return;
  }

  const qIdx = (type === 'q') ? idx : srSelected.idx;
  const aIdx = (type === 'a') ? idx : srSelected.idx;

  srSetLink(qIdx, aIdx);
  srClearSelection();
}

function srTypeIdxFromEl(card){
  if (!card) return null;
  const qi = srQ.findIndex(x => x === card);
  if (qi >= 0) return { type:'q', idx: qi };
  const ai = srA.findIndex(x => x === card);
  if (ai >= 0) return { type:'a', idx: ai };
  return null;
}

function srPressStart(type, idx, ev){
  if (!srRunning) return;
  if (ev.button != null && ev.button !== 0) return;
  try{ ev.preventDefault(); }catch(_){}

  srPress = { type, idx, pointerId: ev.pointerId, x0: ev.clientX, y0: ev.clientY };
  srDragging = false;

  try{
    const el = (type==='q') ? srQ[idx] : srA[idx];
    if (el) el.setPointerCapture(ev.pointerId);
  }catch(_){}
}

function srPressMove(ev){
  if (!srPress) return;
  if (ev.pointerId !== srPress.pointerId) return;

  const dx = ev.clientX - srPress.x0;
  const dy = ev.clientY - srPress.y0;

  if (!srDragging){
    if ((dx*dx + dy*dy) < 36) return;
    srDragging = true;
    srSkipClickUntil = Date.now() + 250;
  }

  const startEl = (srPress.type==='q') ? srQ[srPress.idx] : srA[srPress.idx];
  const wireIdx = srPress.idx;
  srShowPreviewFrom(startEl, wireIdx, ev.clientX, ev.clientY);
}

function srPressEnd(ev){
  if (!srPress) return;
  if (ev.pointerId !== srPress.pointerId) return;

  const start = srPress;
  srPress = null;

  if (!srDragging){
    srDragging = false;
    return;
  }

  srDragging = false;
  srHidePreview();

  const elAt = document.elementFromPoint(ev.clientX, ev.clientY);
  const card = elAt && elAt.closest ? elAt.closest('.sr-card') : null;
  const info = srTypeIdxFromEl(card);
  if (!info) return;
  if (info.type === start.type) return;

  const qIdx = (start.type === 'q') ? start.idx : info.idx;
  const aIdx = (start.type === 'a') ? start.idx : info.idx;

  srSetLink(qIdx, aIdx);
}

// Bindings
srQ.forEach((el,i)=>{
