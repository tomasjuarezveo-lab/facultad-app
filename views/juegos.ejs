      .nl-safe2d{
        width: 170px;
        height: 150px;
        margin: 6px auto 10px;
        position: relative;
        border-radius: 22px;
        background: rgba(15,23,42,.06);
        border: 1px solid rgba(15,23,42,.12);
        overflow: hidden;
      }

      .nl-safe2d .body{
        position:absolute;
        inset: 10px;
        border-radius: 20px;
        background: linear-gradient(180deg, rgba(255,255,255,.9), rgba(255,255,255,.72));
        border: 1px solid rgba(15,23,42,.12);
      }

      .nl-safe2d .door{
        position:absolute;
        inset: 22px 18px 22px 22px;
        border-radius: 16px;
        background: #fff;
        border: 1px solid rgba(15,23,42,.14);
        transform-origin: left center;
        transform: perspective(600px) rotateY(0deg);
      }

      .nl-safe2d .dial{
        position:absolute;
        width: 56px; height:56px;
        right: 34px; top: 50%;
        transform: translateY(-50%);
        border-radius: 9999px;
        background: rgba(15,23,42,.06);
        border: 1px solid rgba(15,23,42,.14);
        display:grid;
        place-items:center;
        font-weight: 950;
        color:#0f172a;
      }
      .nl-safe2d .dial::before{
        content:"";
        width: 10px; height:10px;
        border-radius: 9999px;
        background:#0f172a;
        opacity:.6;
      }
      .nl-safe2d .loot{
        position:absolute;
        inset: 36px 18px 36px 22px;
        border-radius: 14px;
        background: radial-gradient(circle at 30% 30%, rgba(245,188,96,.55), rgba(245,188,96,.08));
        opacity: 0;
        transform: scale(.92);
      }

      .nl-reward-title{
        font-weight: 950;
        color:#0f172a;
        letter-spacing:-.01em;
        margin-top: 6px;
      }
      .nl-reward-points{
        font-weight: 950;
        color:#0f172a;
        margin-top: 6px;
        font-size: 22px;
      }
      .nl-reward-points small{
        display:block;
        font-size: 12px;
        color:#64748b;
        font-weight: 900;
        margin-top: 2px;
      }

      /* Animación al mostrar */
      .nl-reward-overlay.show .nl-safe2d .door{
        animation: nlDoorOpen .55s ease forwards;
      }
      .nl-reward-overlay.show .nl-safe2d .loot{
        animation: nlLootPop .55s ease .25s forwards;
      }
      @keyframes nlDoorOpen{
        to{ transform: perspective(600px) rotateY(-55deg); }
      }
      @keyframes nlLootPop{
        to{ opacity:1; transform: scale(1); }
      }

