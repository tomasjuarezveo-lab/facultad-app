<!-- views/juegos.ejs -->
<!-- JUEGOS · Ruleta iOS de materias con botón central y selector de cantidad -->

<style>
  body{
    overflow-x:hidden;
    overflow-y:auto;
    -webkit-overflow-scrolling:touch;
  }
  body.in-game{
    overflow:hidden;
  }
  :root{
    --ink:#0f172a; --muted:#64748b;
    --glass-1: rgba(255,255,255,.70);
    --glass-2: rgba(255,255,255,.42);
    --ring:    rgba(255,255,255,1);
    --shadow-outer: 0 20px 38px rgba(15,23,42,.18);
    --shadow-soft:  0 12px 26px rgba(15,23,42,.12);
    --thumb:        0 1px 0 rgba(255,255,255,.9) inset, 0 10px 22px rgba(15,23,42,.12) inset;
    --radius-xl: 22px;
  }
  .wheel-wrap{ max-width: 560px; margin: 0 auto; position: relative; }

  /* Selector de cantidad (2–5) */
  .count-wrap{
    position: absolute; right: -10px; top: -8px; z-index: 6;
    display:flex; gap:6px; align-items:center;
    background: var(--glass-2); border:1px solid rgba(255,255,255,.7);
    border-radius: 9999px; padding:6px 8px;
    backdrop-filter: blur(16px) saturate(150%); -webkit-backdrop-filter: blur(16px) saturate(150%);

    box-shadow: var(--shadow-soft);
    transform: translateX(100%); /* pegado al lado derecho del wheel */
  }
  .count-label{ font-size:12px; color:#475569; font-weight:700; letter-spacing:.01em; }
  .count-btn{
    min-width:30px; height:28px; padding:0 8px; border-radius:9999px; font-size:12px; font-weight:800;
    background: linear-gradient(145deg, rgba(255,255,255,.34), rgba(255,255,255,.18));
    border:1px solid rgba(255,255,255,.7); color:#0f172a; cursor:pointer;
    display:inline-flex; align-items:center; justify-content:center; line-height:1;
  }
  .count-btn[aria-pressed="true"]{
    background:#F4BA5D; color:#fff; box-shadow: 0 8px 18px rgba(15,23,42,.25), inset 0 1px 0 rgba(255,255,255,.2);
  }

  /* Contador de puntos (izquierda, alineado con “Sectores”) */
  .points-badge{
    position:absolute; left:-10px; top:-8px; z-index:6;
    transform: translateX(-100%); /* pegado al lado izquierdo del wheel */
    display:flex; align-items:center; gap:6px;
    background: var(--glass-2); border:1px solid rgba(255,255,255,.7);
    border-radius: 9999px; padding:6px 10px;
    backdrop-filter: blur(16px) saturate(150%); -webkit-backdrop-filter: blur(16px) saturate(150%);
    font-size:12px; color:#0f172a; font-weight:800; letter-spacing:.01em;
  }
  .points-dot{
    width:8px; height:8px; border-radius:9999px; background:#F5BC60; opacity:.8;
  }

  .wheel-stage{
    position: relative; aspect-ratio: 1/1; width: min(88vw, 520px);
    margin: 0 auto; filter: drop-shadow(var(--shadow-outer));
  }
  .wheel-stage::before{
    content:""; position:absolute; inset:-12px; border-radius: 9999px;
    background: radial-gradient(120% 120% at 50% 30%, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0) 60%, transparent);
    z-index:0;
  }
  .wheel-svg{ position:absolute; inset:0; z-index:1; }
  .wheel-ring{ fill:#f6f9ff; filter: drop-shadow(0 6px 12px rgba(15,23,42,.12)); }

  /* botón central (girar) */
  .spin-btn{
    position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); z-index:4;
    width:75px; height:75px; border-radius:9999px;
    background: linear-gradient(145deg, rgba(255,255,255,.36), rgba(255, 255, 255, 0));
    border:1px solid rgba(255, 255, 255, 0);
    box-shadow: 0 12px 24px rgba(15,23,42,.18), inset 0 1px 0 rgba(255,255,255,.9);
    display:grid; place-items:center; cursor:pointer;
    transition: transform .08s ease;
  }
  .spin-btn:active{ transform:translate(-50%,-50%) scale(.98); }
  .spin-btn svg{ width:40px; height:40px; opacity:.85 }

  /* etiquetas */
  .slice-label{
    font-weight: 800; letter-spacing: -.01em; fill:#fff; text-anchor: middle;
    paint-order: stroke; stroke: rgba(0,0,0,.08); stroke-width: 1.2px;
  }

  /* Ícono pequeño por sector */
  .slice-icon{
    fill:#fff;
    opacity:.95;
    pointer-events:auto;
    filter: drop-shadow(0 1px 1px rgba(0,0,0,.25));
  }
  .slice-icon{ pointer-events: all; filter: drop-shadow(0 1px 1px rgba(0,0,0,.25)); }

  /* Botón + / ✓ dentro del sector */
  .slice-icon-badge{
    cursor: pointer;
    opacity: .98;
    transform-origin: center;
    transition: transform .12s ease, opacity .12s ease;
  }
  .slice-icon-badge:hover{ transform: scale(1.05); opacity: 1; }
  .slice-icon-badge:active{ transform: scale(.97); }

  /* Popover: header + buscador */
  .slice-pop-header{
    position: sticky;
    top: 0;
    z-index: 2;
    padding-bottom: 8px;
    margin-bottom: 8px;
    border-bottom: 1px solid rgba(255,255,255,.55);
    background: linear-gradient(180deg, rgba(255,255,255,.55), rgba(255,255,255,.28));
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    border-radius: 14px;
  }

  .slice-pop-search{
    width: 100%;
    border: 1px solid rgba(15,23,42,.22);
    background: transparent;
    border-radius: 12px;
    padding: 10px 12px;
    outline: none;
    font-weight: 800;
    color: #0f172a;
    box-shadow: none;
  }
  .slice-pop-search:focus{
    border-color: rgba(245,188,96,.85);
    box-shadow: 0 0 0 4px rgba(245,188,96,.22);
  }
  .slice-pop-search::placeholder{
    color: rgba(100,116,139,.9);
    font-weight: 800;
  }

  .slice-pop-list{ padding-top: 2px; }

  .slice-pop-empty{
    padding: 10px 10px;
    border-radius: 12px;
    font-weight: 800;
    color: #0f172a;
    background: rgba(255,255,255,.45);
    border: 1px solid rgba(255,255,255,.6);
  }

  /* Giro: 5s con ease-out agresivo */
  .spin {
    transition: transform 5s cubic-bezier(.05,.7,0,1);
    will-change: transform;
    transform-origin: 50% 50%;
  }

  /* OVERLAY de pregunta */
  .qa-overlay{
    position: fixed; inset: 0; z-index: 50; display:none;
    background: rgba(15,23,42,.42);
    backdrop-filter: blur(4px) saturate(120%); -webkit-backdrop-filter: blur(4px) saturate(120%);
  }
  .qa-overlay.show{ display:block; }
  .qa-card{
    position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
    width: min(92vw, 720px);
    background:#fff; border-radius: 22px; padding: 20px 18px;
    box-shadow: 0 18px 30px rgba(15,23,42,.18), 0 1px 0 rgba(255,255,255,.9) inset;
    border: 1px solid #eef2f7;
  }
  .qa-header{
    display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:8px;
  }
  .qa-title{ font-size: clamp(17px, 2vw, 22px); font-weight: 800; color:#0f172a; letter-spacing:-.01em; }
  .qa-cancel{
    border:1px solid #e5e7eb; border-radius:9999px; padding:8px 12px; background:#fafafa; font-weight:700; cursor:pointer;
  }
  .opt{
    display:flex; align-items:center; gap:10px;
    border-radius: 14px; border:1px solid #e6ebf3; padding:10px 12px;
    background:#fff; transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
  }
  .opt:hover{ transform: translateY(-1px); box-shadow: 0 8px 16px rgba(15,23,42,.08); }
  .btn-continue{
    display:block; margin:14px auto 2px; min-width: 210px;
    padding:12px 20px; border-radius: 9999px; color:#fff; font-weight: 800; letter-spacing:.01em;
    background: linear-gradient(180deg, #f9c56b 0%, #f3b343 100%);
    cursor:pointer;
  }
  .qa-feedback{
    margin-top:10px; text-align:center; font-weight:800; color:#0f172a;
  }

  /* Popover materias */
  .slice-pop{
    position:absolute; transform: translate(-50%,-50%); z-index:5;
    background: var(--glass-2); border:1px solid rgba(255,255,255,.7);
    backdrop-filter: blur(16px) saturate(150%); -webkit-backdrop-filter: blur(16px) saturate(150%);
    border-radius: 16px; padding:10px; box-shadow: var(--shadow-soft);
    width: min(70vw, 320px); max-height: 46vh; overflow:auto;
  }
  .slice-pop button{ display:block; width:100%; text-align:left; padding:8px 10px; border-radius:12px; cursor:pointer; }
  .slice-pop button:hover{ background: rgba(255,255,255,.6); }

  /* Hint: “tenés que elegir materias” */
  .roulette-hint{
    position:absolute;
    left:50%;
    top:50%;
    transform: translate(-50%,-50%);
    z-index: 8;
    width: min(360px, calc(100% - 34px));
    padding: 14px 14px;
    border-radius: 14px; /* menos redondeado */
    background: rgba(255,255,255,.72);
    border: 1px solid rgba(255,255,255,.72);
    box-shadow: 0 18px 40px rgba(15,23,42,.18);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    display:none;
    cursor: pointer;
    user-select: none;
  }

  .roulette-hint.show{ display:block; }

  .roulette-hint .rh-title{
    font-weight: 950;
    color:#0f172a;
    font-size: 14px;
    line-height: 1.2;
  }
  .roulette-hint .rh-sub{
    margin-top: 6px;
    font-weight: 800;
    color:#475569;
    font-size: 12.5px;
  }

  @keyframes hintBounce{
    from{ transform: translateY(0px); }
    to{ transform: translateY(-3px); }
  }

  @media (max-width:640px){
    /* En mobile: apilamos badges para que NO se superpongan con la rueda */
    .wheel-wrap{
      max-width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      overflow: visible;
    }

    /* ✅ Evita que el dock “muerda” la parte baja de la ruleta */
    .wheel-stage{ margin-bottom: calc(92px + env(safe-area-inset-bottom)); }

    .points-badge,
    .count-wrap{
      position: static;
      left: auto; right: auto; top: auto;
      transform: none !important;
      margin: 0 0 10px 0;
      max-width: 100%;
    }

    .points-badge{ width: fit-content; }

    .count-wrap{
      width: fit-content;
      flex-wrap: wrap;
      justify-content: center;
    }

    .wheel-stage{ width: min(92vw, 440px); }

    .wheel-pointer{ top: -10px; width: 46px; height: 46px; }

    .spin-btn{ width: 82px; height: 82px; }
    .spin-btn svg{ width: 38px; height: 38px; }

    /* Labels del SVG: en mobile el inline font-size:26px puede ser grande → lo pisamos */
    .slice-label{ font-size: clamp(12px, 3.8vw, 18px) !important; }

    /* Popover más amigable en mobile */
    .slice-pop{
      width: min(92vw, 360px);
      max-height: 55vh;
    }
  }

  @media (max-width:420px){
    .slice-label{ font-size: clamp(13px, 4.2vw, 20px) !important; }
  }

  .Transparenttotal{ color:#0f172a00; }

  /* =========================
     ✅ HUB DE JUEGOS
     ========================= */
  .games-hub{
    max-width: 980px;
    margin: 0 auto;
    padding: 14px 12px 120px;
  }
  .games-hero{
    text-align:center;
    margin: 8px 0 14px;
  }
  .games-hero h2{
    margin: 0;
    font-weight: 900;
    letter-spacing: -.02em;
    color:#0f172a;
    font-size: 28px;
  }
  .games-hero p{
    margin: 8px auto 0;
    max-width: 720px;
    color:#64748b;
    font-weight: 800;
  }

    /* ====== HUB: Carrusel (1 carta a la vez) ====== */
  .games-hub{
    max-width: 1100px;
    margin: 0 auto;
    padding: 6px 16px calc(40px + env(safe-area-inset-bottom));
    min-height: calc(100vh - 90px);
    min-height: calc(100dvh - 90px);
    display:flex;
    flex-direction:column;
    gap: 10px;
  }

  .games-carousel{
    position: relative;
    width: 100%;
    flex: 1;
    display:flex;
    align-items:center;
    justify-content:center;
    gap: 48px;                /* ⬅ más separados */
    padding: 0;
    margin-top: -28px;
  }

  .games-stage{
    width: min(76vw, 300px);  /* ⬅ 2/3 aprox */
    position: relative;
    overflow: visible;
    margin-top: -10px;
  }
  .games-stage.no-anim .game-card{ transition:none !important; }

  /* ✅ “Cartas fantasma” detrás (dos capas) */
  .games-stage::before{
    transform: translate(-10px, 8px) rotate(-3deg);
    opacity: .55;
  }
  .games-stage::after{
    transform: translate(10px, 14px) rotate(3deg);
    opacity: .35;
  }

  /* El "grid" ahora funciona como stage (cards apiladas) */
  .games-grid{
    position: relative;
    width: 100%;
    height: 390px; /* ⬅ más bajo */
    transition: height .22s ease;
    z-index: 2;
  }

  .game-card{
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 26px;
    overflow: hidden;
    border: 0;
    background: transparent;
    padding: 0;
    box-shadow: none;
    cursor:pointer;
    text-align:left;
    transition:
      transform .38s cubic-bezier(.2,.9,.2,1),
      opacity .22s ease,
      filter .22s ease;
    will-change: transform, opacity, filter;
  }
  .game-card::after{
    content:"";
    position:absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 45%, rgba(0,0,0,.72) 100%);
    z-index: 1;
    pointer-events:none;
  }
    .gc-bg{
    position:absolute;
    inset: 0;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position: center;
    display:block;
    transform: scale(1.02);
    z-index: 0;
  }
  .gc-bottom{
    position:absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    z-index: 3;
    display:flex;
    flex-direction:column;
    gap: 4px;
    pointer-events:none;
  }
  .game-card:active{ transform: translateX(0%) scale(.99); }
  /* ✅ PRÓXIMAMENTE (banda diagonal + bloqueo) */
  .game-card.is-soon{
    cursor: not-allowed;
    filter: grayscale(.25) saturate(.85) brightness(.95);
  }
  .game-card.is-soon:disabled{
    opacity: 1; /* evita el gris nativo del disabled */
  }
  .game-card.is-soon .gc-open{ opacity: .55; }
  .game-card.is-soon .gc-meta{ opacity: .8; }
  .game-card.is-soon .gc-bottom{ opacity: .92; }

  .game-card.is-soon .gc-ribbon{
    position:absolute;
    left: 50%;
    top: 50%;
    width: 170%;
    height: 34px;
    transform: translate(-50%,-50%) rotate(45deg);
    display:flex;
    align-items:center;
    justify-content:center;
    background: rgba(15,23,42,.62);
    border: 1px solid rgba(255, 255, 255, 0);
    box-shadow: 0 18px 34px rgba(0,0,0,.22);
    color: rgba(255,255,255,.96);
    font-weight: 950;
    letter-spacing: .16em;
    text-transform: uppercase;
    font-size: 11px;
    z-index: 5;
    pointer-events:none;
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
  }
  /* Contenedor interno (para animación "flotando" sin romper transforms del carrusel) */
  .gc-float{
    display:flex;
    flex-direction:column;
    align-items:stretch;
    gap: 10px;
  }

    /* ✅ Flotación real: mueve la carta completa (no solo el contenido) */
  @keyframes cardFloatY{
    0%,100%{ top: 0px; }
    50%{ top: -10px; }
  }

  /* Solo la carta central flota */
  .game-card[aria-hidden="false"]{
    animation: cardFloatY 4.2s ease-in-out infinite;
  }


  /* Top-left: modalidad (sin borde/sombra) */
  .gc-meta{
    position:absolute;
    top: 14px;
    left: 14px;
    font-size: 12px;
    font-weight: 950;
    color: rgba(255,255,255,.78);
    white-space: nowrap;
    z-index: 3;
  }
  .gc-meta .meta-tag{
    display:flex;
    flex-direction:row;          /* ⬅ ícono al lado derecho */
    align-items:center;
    gap: 8px;
    padding: 0;
    border-radius: 999px;
    background: transparent;     /* ⬅ sin fondo */
    border: 0;                   /* ⬅ sin borde */
    box-shadow: none;            /* ⬅ sin sombra */
  }
  .gc-meta .meta-text{ font-weight: 950; }
  .gc-meta .meta-ico{ display:block; }
  .gc-meta .meta-ico svg{ width: 20px; height: 20px; display:block; opacity:.9; }

  /* Top-right: círculo + flecha (sin borde/sombra) */
  .gc-open{
    position:absolute;
    top: 14px;
    right: 14px;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: rgba(255,255,255,.18); /* ⬅ 50% aprox */
    border: 0;
    display:grid;
    place-items:center;
    box-shadow: none;
    z-index: 3;
  }
  .gc-open svg{ width: 18px; height: 18px; color:#fff; opacity:.92; }

  .gc-title{
    margin: 0;
    text-transform: none;
    text-align:left;
    font-weight: 950;
    color:#fff;
    letter-spacing:-.02em;
    font-size: 18px;
    text-shadow: 0 10px 26px rgba(0,0,0,.55);
  }

  .gc-play{
    align-self:center;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(255,255,255,.16);
    border: 1px solid rgba(255,255,255,.18);
    color: rgba(255,255,255,.96);
    font-weight: 950;
    letter-spacing: .01em;
    box-shadow: none;
    user-select:none;
  }

  .gc-photo{
    width: 100%;
    aspect-ratio: 6 / 5;   /* ⬅ menos alta (casi cuadrado) */
    border-radius: 22px;
    overflow:hidden;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.12);
    box-shadow: none;
  }
  .gc-photo img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
  }

    .gc-sub{
      margin: 0;
      text-align:left;
      color: rgba(255,255,255,.82);
      font-weight: 800;
      font-size: 12.5px;
      line-height: 1.25;
      text-shadow: 0 10px 26px rgba(0,0,0,.55);
    }


  /* Flechas laterales (más lejos + blur) */
  .games-nav{
    width: 58px;
    height: 58px;
    border-radius: 999px;
    border: 0;
    background: rgba(0,0,0,.26);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    box-shadow: none;
    display:grid;
    place-items:center;
    cursor:pointer;
    user-select:none;
    transition: transform .14s ease, opacity .14s ease;
  }
  .games-nav:hover{ transform: translateY(-1px); }
  .games-nav:active{ transform: translateY(0); }
  .games-nav svg{ width: 22px; height: 22px; color:#fff; opacity:.92; }
  .games-nav.is-hidden{ opacity:0; pointer-events:none; }
  .games-nav:disabled{ opacity:.25; pointer-events:none; }

  @media (min-width: 900px){
    .games-carousel{ gap: 86px; } /* ⬅ aún más lejos en desktop */
  }

  @media (max-width: 520px){
    .games-carousel{ gap: 0; }
    .games-nav{
      position:absolute;
      top: 50%;
      transform: translateY(-50%);
    }
    .games-nav:hover{ transform: translateY(-50%); }
    .games-nav:active{ transform: translateY(-50%); }
    .games-nav-left{ left: 10px; }
    .games-nav-right{ right: 10px; }
  }
  @media (max-width: 520px){
  /* ✅ Hub mobile: bajar título/subtítulo y separar más la card */
  #gamesHub.games-hub{
    justify-content: flex-start !important;
    padding-top: 26px !important;
  }

  #gamesHub .games-hero{
    margin: 16px 0 46px !important;
  }

  #gamesHub .games-hero h2{
    margin: 0 !important;
  }

  #gamesHub .games-hero p{
    margin: 10px auto 0 !important;
  }

  /* ✅ anulamos los márgenes negativos del carrusel en mobile */
  #gamesHub .games-carousel{
    margin-top: 34px !important;
  }

  #gamesHub .games-stage{
    margin-top: 18px !important;
  }
}
  @media (max-width: 520px){
  /* ✅ HUB mobile: título/subtítulo un poco más abajo + más distancia con cards */
  #gamesHub.games-hub{
    justify-content: flex-start !important;
    padding-top: 22px !important;
  }

  #gamesHub .games-hero{
    margin: 14px 0 42px !important;
  }

  #gamesHub .games-hero h2{
    margin: 0 !important;
  }

  #gamesHub .games-hero p{
    margin: 10px auto 0 !important;
  }

  #gamesHub .games-carousel{
    margin-top: 32px !important;
  }

  #gamesHub .games-stage{
    margin-top: 14px !important;
  }
}
  @media (max-width: 520px){
  /* 🔧 si el hub tiene style="display: none", respetarlo (fix click mobile) */
  #gamesHub[style*="display: none"]{
    display: none !important;
  }

  /* ✅ mantenemos el título donde está */
  #gamesHub.games-hub{
    justify-content: flex-start !important;
    padding-top: 14px !important;
  }

  #gamesHub .games-hero{
    margin: 6px 0 30px !important;
  }

  #gamesHub .games-hero h2{
    margin: 0 !important;
  }

  #gamesHub .games-hero p{
    margin: 8px auto 0 !important;
  }

  /* ✅ más distancia entre subtítulo y cards */
  #gamesHub .games-carousel{
    margin-top: 22px !important;
  }

  #gamesHub .games-stage{
    margin-top: 10px !important;
  }
}
  /* ===== MOBILE FULLSCREEN HUB (iPhone 15 / celulares) ===== */
@media (max-width: 520px){
  /* ✅ Sin scroll cuando estás en el hub de juegos */
  body:not(.in-game){
    overflow: hidden !important;
    height: 100dvh !important;
    max-height: 100dvh !important;
    overscroll-behavior: none !important;
    -webkit-overflow-scrolling: auto !important;
  }

  /* ✅ El hub ocupa una sola pantalla (dejando espacio para menú inferior) */
  #gamesHub.games-hub{
    box-sizing: border-box;
    width: 100%;
    height: calc(100dvh - 82px - env(safe-area-inset-bottom)) !important;
    min-height: calc(100dvh - 82px - env(safe-area-inset-bottom)) !important;
    max-height: calc(100dvh - 82px - env(safe-area-inset-bottom)) !important;
    margin: 0 auto !important;
    padding: 10px 12px 8px !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    overflow: hidden !important;
    touch-action: manipulation;
  }

  /* ✅ Título + subtítulo compactos y centrados */
  #gamesHub .games-hero{
    margin: 0 !important;
    text-align: center;
    flex: 0 0 auto;
  }
  #gamesHub .games-hero h2{
    margin: 0 !important;
    font-size: 26px !important;
    line-height: 1.05;
  }
  #gamesHub .games-hero p{
    margin: 6px auto 0 !important;
    max-width: 320px !important;
    font-size: 13px !important;
    line-height: 1.25;
  }

  /* ✅ Carrusel centrado sin empujar la pantalla */
  #gamesHub .games-carousel{
    position: relative;
    width: 100%;
    flex: 0 0 auto;
    margin-top: 0 !important;
    padding: 0 !important;
    gap: 0 !important;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
  }

  /* ✅ Stage recorta TODO lo de atrás */
  #gamesHub .games-stage{
    width: min(78vw, 300px) !important;
    max-width: 300px !important;
    margin-top: 0 !important;
    position: relative;
    overflow: hidden !important;
    border-radius: 26px;
  }

  /* ✅ Oculta las “cartas fantasma” detrás */
  #gamesHub .games-stage::before,
  #gamesHub .games-stage::after{
    display: none !important;
  }

  /* ✅ Solo 1 card visible en mobile */
  #gamesHub .game-card[aria-hidden="true"]{
    opacity: 0 !important;
    pointer-events: none !important;
    filter: none !important;
    transform: translateX(120%) scale(.98) !important;
  }

  #gamesHub .game-card[aria-hidden="false"]{
    opacity: 1 !important;
    pointer-events: auto !important;
    filter: none !important;
    transform: translateX(0%) scale(1) !important;
  }

  /* ✅ Flechas siempre visibles a los costados */
  #gamesHub .games-nav{
    width: 50px !important;
    height: 50px !important;
    z-index: 40;
  }
  #gamesHub .games-nav-left{ left: 6px !important; }
  #gamesHub .games-nav-right{ right: 6px !important; }

  /* ✅ Evita scroll horizontal accidental */
  html, body{
    overflow-x: hidden !important;
  }
}
