  // Materias del perfil del usuario (robusto: career normalizado + plan entero)
  function normCareer(v){
    return String(v || '')
      .toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
      .replace(/\./g,'')
      .replace(/\s+/g,' ')
      .trim();
  }
  function planInt(v){
    const raw = String(v ?? '').trim().replace(',', '.');
    const n = parseInt(raw.split('.')[0], 10);
    return Number.isFinite(n) ? n : 0;
  }

  const uCareer = normCareer(user?.career);
  const uPlan   = planInt(user?.plan);

  const _subs = (subjects || []).filter(s => {
    if (!uCareer || !uPlan) return true;
    return normCareer(s.career) === uCareer && planInt(s.plan) === uPlan;
  });
%>

