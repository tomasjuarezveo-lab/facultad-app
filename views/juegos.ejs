<script>
  // ======= Datos iniciales =======
  // ======= Datos iniciales =======
  const ALL_SUBJECTS = <%- JSON.stringify((_subs || []).map(s => ({ id: String(s.id), name: String(s.name) }))) %>;
  window.__IS_GUEST__ = <%- JSON.stringify(!!(user && user.role === 'guest')) %>;
  window.__GUEST_GAME_PLAYS__ = <%- JSON.stringify(guestGamePlays || {}) %>;

  window.__USER_PLAN = <%- JSON.stringify(Number(uPlan || 0)) %>;
  const __INITIAL_GAME_KEY = <%- JSON.stringify(initialGameKey || '') %>;

  /* =========================================================
    ✅ HUB NAV (V3) — URL real /app/juegos/<nombre-del-juego>
    - Click en card => abre vista + pushState
    - Volver => hub + pushState(/app/juegos)
    - Soporta refresh directo en /app/juegos/<slug>
    - popstate: back/forward del navegador
    ========================================================= */
    (function(){
      if (window.__GAMES_HUB_NAV_V3__) return;
      window.__GAMES_HUB_NAV_V3__ = true;

      const $ = (id)=>document.getElementById(id);
      const BASE = '/app/juegos';

      function normSlug(str){
        return String(str || '')
          .toLowerCase()
          .normalize('NFD').replace(/[\u0300-\u036f]/g,'') // sin tildes
          .replace(/[^a-z0-9]+/g,'-')
          .replace(/(^-|-$)/g,'');
      }

      function escAttr(val){
        const v = String(val || '');
        if (window.CSS && typeof CSS.escape === 'function') return CSS.escape(v);
        return v.replace(/["\\]/g, '\\$&');
      }

      function getCards(){
        return [...document.querySelectorAll('.game-card[data-game]')];
      }

      function getTitleForKey(key){
        const sel = `.game-card[data-game="${escAttr(key)}"]`;
        const card = document.querySelector(sel);
        const t = card ? card.querySelector('.gc-title') : null;
        const title = t ? String(t.textContent || '').trim() : String(key || '').trim();
        return title || String(key || 'Juego');
      }

      function slugForKey(key){
        return normSlug(getTitleForKey(key)) || normSlug(key) || String(key || '').trim();
      }

      function keyForSlug(slug){
        const s = String(slug || '').trim();
        if (!s) return '';
        const cards = getCards();

        // match por título
        for (const c of cards){
          const key = String(c.getAttribute('data-game') || '').trim();
          const t = c.querySelector('.gc-title');
          const title = t ? String(t.textContent || '').trim() : key;
          if (normSlug(title) === s) return key;
        }
        // fallback: match por key
        for (const c of cards){
          const key = String(c.getAttribute('data-game') || '').trim();
          if (normSlug(key) === s) return key;
        }
        return '';
      }

      function pathSlug(){
        const p = String(location.pathname || '');
        if (!p.startsWith(BASE)) return '';
        const rest = p.slice(BASE.length).replace(/^\/+/, '').replace(/\/+$/, '');
        return rest || '';
      }

      function pushUrlFor(key){
        const slug = key ? slugForKey(key) : '';
        const url = slug ? `${BASE}/${slug}` : BASE;
        if (String(location.pathname) === url) return;
        history.pushState({ gameKey: key || '' }, '', url);
      }

      function showHub(opts){
        opts = opts || {};
        try{ if (window.__forceAbortActiveMiniGame) window.__forceAbortActiveMiniGame(); }catch(_){ }
        const hub = $('gamesHub');
        const top = $('gameTopbar');
        if (hub) hub.style.display = '';
        if (top) top.classList.remove('is-show');

        document.querySelectorAll('.game-view.is-active').forEach(v => v.classList.remove('is-active'));

        document.body.classList.remove('in-game','in-nonroulette');
        delete document.body.dataset.activeGame;

        if (!opts.skipHistory) pushUrlFor('');
      }

      function showGame(gameKey, titleText, opts){
        opts = opts || {};
        const hub = $('gamesHub');
        const top = $('gameTopbar');
        const tEl = $('gameTopTitle');

        const viewId = `gameView-${gameKey}`;
        const view = $(viewId);

        if (!view){
          console.warn('[HUB] No existe la vista:', viewId);
          return showHub({ skipHistory:true });
        }

        if (hub) hub.style.display = 'none';
        if (top) top.classList.add('is-show');

        document.querySelectorAll('.game-view.is-active').forEach(v => v.classList.remove('is-active'));
        view.classList.add('is-active');

        document.body.classList.add('in-game');
        document.body.dataset.activeGame = String(gameKey);

        if (String(gameKey) !== 'roulette') document.body.classList.add('in-nonroulette');
        else document.body.classList.remove('in-nonroulette');

        if (tEl) tEl.textContent = titleText || getTitleForKey(gameKey) || 'Juego';

        if (!opts.skipHistory) pushUrlFor(gameKey);
      }

      // ✅ Click HUB (captura)
            // ✅ Click HUB (captura)
      document.addEventListener('click', function(e){
        const card = e.target && e.target.closest ? e.target.closest('.game-card[data-game]') : null;
        if (!card) return;

        // ✅ Bloqueo: juegos “Próximamente”
        if (card.classList.contains('is-soon') || card.hasAttribute('disabled') || card.getAttribute('aria-disabled') === 'true'){
          e.preventDefault();
          e.stopPropagation();
          if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
          return;
        }

        e.preventDefault();
        e.stopPropagation();
        if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();

        const key = String(card.getAttribute('data-game') || '').trim();
        const titleNode = card.querySelector('.gc-title');
        const title = titleNode ? String(titleNode.textContent || '').trim() : key;

        if (!key) return;

      const isGuest = !!window.__IS_GUEST__;
      const plays = window.__GUEST_GAME_PLAYS__ || {};

      const gate = document.getElementById('guestGameGate');
      const gateText = document.getElementById('ggateText');

      function openGate(t){
        if (gateText) gateText.textContent = `Como invitado podés jugar 1 vez cada juego. Para volver a jugar “${t}”, creá tu cuenta gratis.`;
        if (gate){
          gate.style.display = 'flex';
          gate.classList.add('show');
          gate.setAttribute('aria-hidden','false');
        }
      }

      function markPlayed(gameKey){
        try{
          const payload = JSON.stringify({ game: gameKey });
          if (navigator.sendBeacon){
            const blob = new Blob([payload], { type:'application/json' });
            navigator.sendBeacon('/app/api/guest/game-played', blob);
          } else {
            fetch('/app/api/guest/game-played', {
              method:'POST',
              headers:{ 'Content-Type':'application/json' },
              body: payload
            });
          }
        }catch(_){}
      }

      if (isGuest){
        const titleSafe = title || getTitleForKey(key) || 'este juego';

        if (plays[key]){
          openGate(titleSafe);
          return showHub({ skipHistory:true });
        }

        plays[key] = true;
        window.__GUEST_GAME_PLAYS__ = plays;
        markPlayed(key);
      }

      showGame(key, title);
      }, true);

      // ✅ Volver (botón de arriba)
      document.addEventListener('click', function(e){
        const back = e.target && e.target.closest ? e.target.closest('#btnGamesBack') : null;
        if (!back) return;

        e.preventDefault();
        e.stopPropagation();
        if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();

        showHub();
      }, true);

      // ✅ Back/Forward navegador
      window.addEventListener('popstate', function(){
        const st = history.state || null;
        if (st && st.gameKey){
          const key = String(st.gameKey || '').trim();
          if (key) return showGame(key, getTitleForKey(key), { skipHistory:true });
          return showHub({ skipHistory:true });
        }

        const slug = pathSlug();
        if (slug){
          const key = keyForSlug(slug);
          if (key) return showGame(key, getTitleForKey(key), { skipHistory:true });
        }
        showHub({ skipHistory:true });
      });

      // ✅ Entrada directa / refresh en /app/juegos/<slug>
      document.addEventListener('DOMContentLoaded', () => {
        const slug = pathSlug();
        if (slug){
          const key = keyForSlug(slug);
          if (key) return showGame(key, getTitleForKey(key), { skipHistory:true });
        }

        // fallback server
        try{
          if (typeof __INITIAL_GAME_KEY !== 'undefined' && __INITIAL_GAME_KEY){
            const key = String(__INITIAL_GAME_KEY).trim();
            if (key) return showGame(key, getTitleForKey(key), { skipHistory:true });
          }
        }catch{}

        showHub({ skipHistory:true });
      });
    })();

  /* =========================================================
     ✅ CARRUSEL DE JUEGOS (V1) — 1 carta a la vez
     - Flechas laterales: anterior / siguiente
     - Animación: actual → derecha (siguiente) / izquierda (anterior)
     - No toca ningún ID existente
     ========================================================= */
      (function(){
          if (window.__GAMES_CAROUSEL_V1__) return;
