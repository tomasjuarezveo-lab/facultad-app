    async function fetchRandomQuiz(subjectId){
      const __p = (Number(window.__USER_PLAN||0) > 0) ? `&plan=${encodeURIComponent(String(window.__USER_PLAN))}` : '';
      const r = await fetch(`/api/quizzes?subject_id=${encodeURIComponent(subjectId)}&limit=10${__p}`);
      const arr = await r.json();
      if (Array.isArray(arr) && arr.length) return arr[Math.floor(Math.random()*arr.length)];
      return null;
    }

