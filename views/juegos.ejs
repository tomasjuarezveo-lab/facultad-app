});

srA.forEach((el,i)=>{
  if (!el) return;
  el.addEventListener('click', ()=> srCardClick('a', i));
  el.addEventListener('pointerdown', (ev)=> srPressStart('a', i, ev), { passive:false });
});

window.addEventListener('pointermove', srPressMove, { passive:false });
window.addEventListener('pointerup', srPressEnd, { passive:false });
window.addEventListener('pointercancel', srPressEnd, { passive:false });

function srSubmit(){
  if (!srRunning) return;

  const done = srUsedA.size;
  if (done < 3 || srLinks.some(x => x == null)){
    srSay(`Te faltan conexiones (${done}/3).`);
    return;
  }

  srStopTimer();

  let ok = true;
  for (let q=0;q<3;q++){
    if (srLinks[q] !== srCorrectMap[q]) ok = false;
  }

  if (ok){
    srWin();
  } else {
    for (let q=0;q<3;q++){
      const a = srLinks[q];
      if (a !== srCorrectMap[q]){
        if (srQ[q]) srQ[q].classList.add('is-bad');
        if (srA[a]) srA[a].classList.add('is-bad');
      }
    }
    srLose('Incorrecto ❌ Algunas conexiones están mal.');
  }
}

// Botón principal: Iniciar / Listo
srStart && srStart.addEventListener('click', async ()=>{
