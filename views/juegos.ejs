        const GAME_TO_SLUG = {
      roulette: 'ruletaquiz',
      hotpotato: 'dinamita',
      escape: 'escaperoom',
      'num-logic': 'cajafuerte',
      'impostor-phrase': 'impostorfrase',
      'false-room': 'salafalsa',
      'impostor-topic': 'impostortema',
      auction: 'subasta',
