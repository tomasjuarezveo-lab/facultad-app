    height: 1px;
    background: rgba(15,23,42,.15);
    flex: 0 0 32px;
  }
  .auth-social__divider span{
    position:relative;
    z-index:1;
    padding:0 10px;
    background: transparent;
  }
  html.cw-dark .auth-social__btn{
    background:rgba(15,23,42,.82);
    border-color:rgba(255,255,255,.08);
    box-shadow:0 14px 34px rgba(0,0,0,.30), inset 0 1px 0 rgba(255,255,255,.04);
    color:rgba(248,250,252,.96);
  }
  html.cw-dark .auth-social__divider{
    color:rgba(203,213,225,.78);
  }
  html.cw-dark .auth-social__divider::before{
    border-top-color:rgba(255,255,255,.08);
  }
  html.cw-dark .auth-social__divider span{
    background:rgba(2,6,23,.82);
  }
  .oauth-legal{
    margin: 0 0 10px;
  }
  .oauth-legal__field{
    display:flex;
    align-items:flex-start;
    gap:10px;
    padding:12px 14px;
    border-radius:16px;
    background:transparent;
    transition:transform .16s ease, border-color .16s ease, box-shadow .16s ease;
  }
  .oauth-legal__field input[type="checkbox"]{
    width:18px;
    height:18px;
    margin-top:2px;
    flex:0 0 18px;
    accent-color:#F8C160;
    cursor:pointer;
  }
  .oauth-legal__field label{
    font-size:12px;
    font-weight:700;
    line-height:1.5;
    color:#334155;
    cursor:pointer;
  }
  .oauth-legal__field label a{
    color:#d97706;
    font-weight:800;
    text-decoration:underline;
    text-underline-offset:2px;
  }
  .oauth-legal__error{
    display:none;
    margin-top:6px;
    font-size:11px;
    line-height:1.4;
    font-weight:700;
    color:#dc2626;
  }
  .oauth-legal__error.is-visible{
    display:block;
  }
  .oauth-legal__field.is-invalid{
    border-color:rgba(220,38,38,.22);
    box-shadow:0 0 0 3px rgba(220,38,38,.08);
  }
  .oauth-legal__field.is-shaking,
  .auth-social__btn.is-shaking{
    animation:cwShakeX .42s linear;
  }
  @keyframes cwShakeX{
    0%,100%{ transform:translateX(0); }
    20%{ transform:translateX(-6px); }
    40%{ transform:translateX(6px); }
    60%{ transform:translateX(-4px); }
    80%{ transform:translateX(4px); }
  }
  html.cw-dark .oauth-legal__field{
    background:transparent;
    border-color:rgba(255,255,255,.08);
  }
  html.cw-dark .oauth-legal__field label{
    color:rgba(241,245,249,.92);
  }
