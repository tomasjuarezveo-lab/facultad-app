<style>
/* ============ AUTH MOBILE FIX (solo login) ============ */
  @media (max-width: 640px){

    html.auth-html, html.auth-html body{
      height: auto !important;
      min-height: 100dvh !important;
      overflow: auto !important;
    }

    /* ✅ En mobile damos espacio arriba para que el header/logo NO tape títulos */
    .auth-split{
      height: auto !important;
      min-height: 100dvh !important;
      align-items: flex-start !important;
      padding-top: calc(92px + env(safe-area-inset-top)) !important;
      padding-bottom: max(16px, env(safe-area-inset-bottom)) !important;

/* ✅ Logo auth-brand (arriba izquierda) — más chico y siempre visible */
html.auth-html .auth-brand{
  position: fixed !important;
  left: 14px !important;
  top: calc(10px + env(safe-area-inset-top)) !important;
  z-index: 60 !important;
  display: block !important;
}
html.auth-html .auth-brand img{
  height: 22px !important;
  width: auto !important;
  max-width: 160px !important;
  display:block !important;
  object-fit: contain !important;
}

    }

    /* ✅ Si el header/logo está fijo/absoluto, lo hacemos más chico y prolijo */
    .auth-header, .header, .top-header, .brand-header{
      position: fixed !important;
      left: 0; right: 0; top: 0;
      height: 76px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      z-index: 50 !important;
      padding-top: env(safe-area-inset-top) !important;
      background: rgba(255,255,255,.72) !important;
      backdrop-filter: blur(12px) saturate(140%) !important;
      -webkit-backdrop-filter: blur(12px) saturate(140%) !important;
      border-bottom: 1px solid rgba(15,23,42,.08) !important;
    }

    /* ✅ Logo (si usa .logo o img dentro del header) */
    .auth-header img, .header img, .top-header img, .brand-header img,
    .auth-header .logo, .header .logo, .top-header .logo, .brand-header .logo{
      max-height: 22px !important;
      width: auto !important;
    }

    /* ✅ sacamos transforms que “suben” el bloque en mobile */
    .auth-center{
      transform: none !important;
      margin: 0 !important;
      padding: 0 !important;
      align-items: start !important;
    }

    /* ✅ Form full width */
    form.max-w-md{ max-width: 100% !important; }

    /* ✅ Inputs y botones cómodos */
    .ios-input{ padding: 13px 14px !important; }
    .ios-btn-primary{ padding: 13px 16px !important; }

@media (max-width: 430px){
  html.auth-html .auth-brand img{
    height: 18px !important;
  }
}

  }
  .ios-checkbox {
    accent-color: #F8C160;
  }
    .auth-social{
    display:grid;
    gap:12px;
    margin:0 0 16px;
  }
  .auth-social__btn{
    width:100%;
    min-height:52px;
    border-radius:20px;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:12px;
    padding:14px 18px;
    border:1px solid rgba(15,23,42,.08);
    background:rgba(255,255,255,.78);
    box-shadow:0 10px 28px rgba(15,23,42,.08), inset 0 1px 0 rgba(255,255,255,.68);
    backdrop-filter:blur(16px) saturate(140%);
    -webkit-backdrop-filter:blur(16px) saturate(140%);
    color:#0f172a;
    font-weight:700;
    letter-spacing:-.01em;
    text-decoration:none;
    transition:transform .16s ease, box-shadow .16s ease, background .16s ease;
  }
  .auth-social__btn:hover{
