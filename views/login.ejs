<div class="auth-split relative">
  <div class="auth-line" aria-hidden="true"></div>

  <div class="auth-center grid grid-cols-1 lg:grid-cols-2 items-center relative z-10">
    <!-- IZQUIERDA: INICIO DE SESIÓN (sin tarjeta) -->
    <section class="px-6 sm:px-10 lg:pr-20">
  <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight mb-2">Iniciar sesión</h1>
  <p class="text-sm sm:text-base text-slate-500 mb-8">Accedé a tu carrera y planes de estudio.</p>

  <% if (typeof error !== "undefined" && error) { %>
    <div class="mb-5 text-sm text-red-600 font-medium bg-red-50 p-3 rounded-xl border border-red-100"><%= error %></div>
  <% } %>

  <form method="POST" action="/login" class="space-y-4 max-w-md">
    <label class="block">
      <span class="ios-label text-xs font-bold text-slate-400 uppercase ml-1">Email</span>
      <input class="ios-input mt-1" type="email" name="email" required placeholder="tu@email.com" value="<%= (typeof email !== 'undefined' && email) ? email : '' %>" />
    </label>

    <label class="block">
      <span class="ios-label text-xs font-bold text-slate-400 uppercase ml-1">Contraseña</span>
      <div class="ios-input-wrap mt-1">
        <input class="ios-input" id="loginPw" type="password" name="password" required placeholder="••••••••" />
        <button type="button" class="ios-pw-toggle text-orange-500 font-bold" data-pw-target="loginPw">Mostrar</button>
      </div>
    </label>

    <div class="flex items-center justify-between px-1">
      <label class="flex items-center gap-2 cursor-pointer select-none">
        <input type="checkbox" id="remember" name="remember" value="1" class="ios-checkbox w-4 h-4" <%= ((typeof remember !== 'undefined') && remember) ? 'checked' : '' %> />
        <span class="text-sm text-slate-600">Mantener sesión iniciada</span>
      </label>
      <a href="/forgot" class="text-sm font-semibold text-slate-400 hover:text-orange-500 transition">¿Olvidaste tu clave?</a>
    </div>

    <button class="ios-btn-primary w-full mt-2 bg-[#F8C160] text-slate-900 font-bold" style="box-shadow:none;">Entrar</button>
  </form>

  <div class="mt-6 max-w-md space-y-3">
    
    <button id="btnGuest" type="button"
      class="w-full rounded-2xl px-4 py-3 font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition shadow-sm">
      Ingresar como Invitado
    </button>

    <div class="auth-social__divider"><span>o también podés</span></div>

    <% if (googleAuthEnabled) { %>
      <a id="loginGoogleBtn" class="auth-social__btn" href="/auth/google?accept_legal=1" style="border-radius: 16px; border: 1.5px solid #e2e8f0; font-weight: 500;">
        <svg class="auth-social__icon" viewBox="0 0 24 24">
          <path fill="#EA4335" d="M12 10.2v3.9h5.4c-.23 1.27-.97 2.35-2.05 3.07l3.31 2.57c1.93-1.78 3.04-4.4 3.04-7.52 0-.72-.06-1.4-.19-2.03H12z"/>
          <path fill="#34A853" d="M12 22c2.75 0 5.05-.91 6.74-2.48l-3.31-2.57c-.92.62-2.09.99-3.43.99-2.64 0-4.88-1.78-5.68-4.18l-3.42 2.64A9.99 9.99 0 0 0 12 22z"/>
          <path fill="#4A90E2" d="M6.32 13.76A5.99 5.99 0 0 1 6 12c0-.61.11-1.21.32-1.76L2.9 7.6A10 10 0 0 0 2 12c0 1.61.39 3.13 1.09 4.4l3.23-2.64z"/>
          <path fill="#FBBC05" d="M12 6.06c1.5 0 2.84.52 3.9 1.54l2.92-2.92C17.04 3.02 14.75 2 12 2A9.99 9.99 0 0 0 3.09 7.6l3.23 2.64C7.12 7.84 9.36 6.06 12 6.06z"/>
        </svg>
        <span>Continuar con Google</span>
      </a>

      <div class="oauth-legal" style="margin-top:10px;">
        <div class="oauth-legal__field" id="loginGoogleLegalField">
          <input type="checkbox" id="loginGoogleLegalCheck" />
          <label for="loginGoogleLegalCheck">
            Acepto los
            <a href="/terminos-y-condiciones-de-uso" target="_blank" rel="noopener">Términos y Condiciones</a>
            y la
            <a href="/politica-de-privacidad-y-proteccion-de-datos" target="_blank" rel="noopener">Política de Privacidad</a>
          </label>
        </div>
        <p id="loginGoogleLegalError" class="oauth-legal__error">Para continuar con Google tenés que aceptar los Términos y Condiciones y la Política de Privacidad.</p>
      </div>
    <% } %>

    <div class="pt-6 text-center">
      <p class="text-sm text-slate-500">
        ¿No tenés cuenta? 
        <a class="font-bold text-orange-300 hover:underline ml-1" href="/register">Crear cuenta</a>
      </p>
    </div>
  </div>
</section>

    <!-- DERECHA VACÍA -->
    <section class="hidden lg:block"></section>
  </div>
</div>



  <!-- =========================
      MODAL INVITADO (Carrera + Plan)
      ========================= -->
  <div id="guestModal" class="fixed inset-0 z-[9999] hidden" aria-hidden="true">
    <div id="guestModalBg" class="absolute inset-0 bg-black/40"></div>

    <div class="absolute left-1/2 top-1/2 w-[92vw] max-w-md -translate-x-1/2 -translate-y-1/2 rounded-3xl border border-white/40 bg-white/80 backdrop-blur-2xl shadow-2xl p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <div class="text-lg font-extrabold text-slate-900">Ingresar como Invitado</div>
          <div class="text-sm text-slate-600 mt-1">Elegí tu carrera y plan para ver contenido de muestra.</div>
        </div>
        <button id="guestClose" type="button" class="w-10 h-10 rounded-full bg-white/70 border border-white/60 shadow flex items-center justify-center">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 6L18 18" stroke="#0f172a" stroke-width="2.2" stroke-linecap="round"/>
            <path d="M18 6L6 18" stroke="#0f172a" stroke-width="2.2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <form id="guestForm" method="POST" action="/guest" class="mt-4 space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">Carrera</label>
          <select id="guestCareer" name="career"
            class="w-full h-11 rounded-2xl border border-white/60 bg-white/70 px-3 font-semibold text-slate-900 shadow-sm outline-none">
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">Plan</label>
          <select id="guestPlan" name="plan"
            class="w-full h-11 rounded-2xl border border-white/60 bg-white/70 px-3 font-semibold text-slate-900 shadow-sm outline-none">
          </select>
        </div>

        <button type="submit" class="w-full rounded-2xl px-4 py-3 font-extrabold shadow-lg"
          style="background:#F8C160; color:#0f172a;">
          Entrar como invitado
        </button>

        <div class="text-xs text-slate-500 text-center">
          ¿Querés desbloquear todo? <a href="/register" class="font-bold underline" style="color:#e59f12;">Crear cuenta</a>
        </div>
      </form>
    </div>
    <!-- Modal Términos y Condiciones -->
  <div id="modalTerms" class="reg-legal-overlay" role="dialog" aria-modal="true" aria-label="Términos y Condiciones">
    <div class="reg-legal-card">
      <div class="reg-legal-head">
        <span class="reg-legal-title">Términos y Condiciones</span>
        <button class="reg-legal-close" onclick="closeLegalModal('terms')" aria-label="Cerrar">✕</button>
      </div>
      <div class="reg-legal-body">
        <h3>1. Aceptación</h3>
        <p>Al crear una cuenta en CleverWave, aceptás estos Términos y Condiciones en su totalidad. Si no estás de acuerdo, no podés usar la plataforma.</p>
        <h3>2. Uso de la plataforma</h3>
        <p>CleverWave es una plataforma educativa. Te comprometés a usarla de forma responsable, sin compartir contenido inapropiado ni violar los derechos de otros usuarios.</p>
        <h3>3. Cuenta</h3>
        <p>Sos responsable de mantener la confidencialidad de tu contraseña y de todas las actividades que ocurran bajo tu cuenta.</p>
        <h3>4. Modificaciones</h3>
        <p>CleverWave se reserva el derecho de modificar estos términos en cualquier momento. Te notificaremos ante cambios importantes.</p>
        <h3>5. Contacto</h3>
        <p>Para consultas sobre estos términos, podés contactarnos a través de los canales oficiales de CleverWave.</p>
        <p style="margin-top:16px; font-size:11px; color:rgba(15,23,42,.45);">— Reemplazá este texto por tus Términos y Condiciones definitivos —</p>
      </div>
    </div>
  </div>

  <!-- Modal Políticas de Privacidad -->
  <div id="modalPrivacy" class="reg-legal-overlay" role="dialog" aria-modal="true" aria-label="Políticas de Privacidad">
    <div class="reg-legal-card">
      <div class="reg-legal-head">
        <span class="reg-legal-title">Políticas de Privacidad</span>
        <button class="reg-legal-close" onclick="closeLegalModal('privacy')" aria-label="Cerrar">✕</button>
      </div>
      <div class="reg-legal-body">
        <h3>1. Datos que recopilamos</h3>
        <p>Recopilamos tu nombre, email, carrera y plan de estudios al momento del registro, así como datos de uso de la plataforma.</p>
        <h3>2. Uso de los datos</h3>
        <p>Tus datos se utilizan exclusivamente para brindarte el servicio educativo de CleverWave. No los vendemos ni compartimos con terceros sin tu consentimiento.</p>
        <h3>3. Seguridad</h3>
        <p>Implementamos medidas de seguridad para proteger tu información. Sin embargo, ningún sistema es 100% seguro.</p>
        <h3>4. Tus derechos</h3>
        <p>Podés solicitar el acceso, rectificación o eliminación de tus datos personales en cualquier momento contactándonos.</p>
        <h3>5. Cookies</h3>
        <p>Usamos cookies esenciales para el funcionamiento de la plataforma. No usamos cookies de rastreo publicitario.</p>
        <p style="margin-top:16px; font-size:11px; color:rgba(15,23,42,.45);">— Reemplazá este texto por tus Políticas de Privacidad definitivas —</p>
      </div>
    </div>
  </div>
  </div>

  <script>
  document.addEventListener('DOMContentLoaded', () => {
    // === Invitado ===
    const btnGuest = document.getElementById('btnGuest');
    const guestModal = document.getElementById('guestModal');
    const guestBg = document.getElementById('guestModalBg');
    const guestClose = document.getElementById('guestClose');
    const guestCareer = document.getElementById('guestCareer');
    const guestPlan = document.getElementById('guestPlan');

    const openGuest = () => { if(!guestModal) return; guestModal.classList.remove('hidden'); guestModal.setAttribute('aria-hidden','false'); };
    const closeGuest = () => { if(!guestModal) return; guestModal.classList.add('hidden'); guestModal.setAttribute('aria-hidden','true'); };

    if(btnGuest){
      btnGuest.addEventListener('click', async () => {
        openGuest();
        try{
          const r = await fetch('/options', { credentials:'include' });
          const j = await r.json().catch(()=>null);
          if(!r.ok || !j || !j.ok) return;

          const careers = Array.isArray(j.careers) ? j.careers : [];
          const plansByCareer = (j.plansByCareer && typeof j.plansByCareer==='object') ? j.plansByCareer : {};

          if (guestCareer) guestCareer.innerHTML = careers.map(c=>`<option value="${String(c).replace(/"/g,'&quot;')}">${c}</option>`).join('');

          const setPlans = () => {
            const c = guestCareer ? guestCareer.value : '';
            const plans = Array.isArray(plansByCareer[c]) ? plansByCareer[c] : [];
            if (guestPlan) guestPlan.innerHTML = plans.map(p=>`<option value="${p}">Plan ${p}</option>`).join('');
          };
          guestCareer && guestCareer.addEventListener('change', setPlans);
          setPlans();
        }catch(e){}
      });
    }
    if(guestBg) guestBg.addEventListener('click', closeGuest);
    if(guestClose) guestClose.addEventListener('click', closeGuest);

  // ✅ Fix logo de Dropbox en Safari/iPhone (auth-brand)
  const authLogo = document.querySelector('.auth-brand img');
  if (authLogo){
    const src = authLogo.getAttribute('src') || '';
    if (src.includes('dropbox.com') && src.includes('clear-way.png') && src.includes('dl=1') && !src.includes('raw=1')){
      authLogo.setAttribute('src', src.replace('dl=1','raw=1'));
    }
    authLogo.setAttribute('loading','eager');
    authLogo.setAttribute('decoding','async');
    authLogo.setAttribute('referrerpolicy','no-referrer');
    authLogo.addEventListener('error', () => {
      const s = authLogo.getAttribute('src') || '';
      if (s.includes('raw=1')){
        authLogo.setAttribute('src', s.replace('raw=1','dl=1'));
      }
    }, { once:true });
  }
    // ✅ Email case-insensitive: normalizar antes de enviar
    const loginEmail = document.querySelector('form[action="/login"] input[name="email"]');
    if (loginEmail){
      const normalizeLoginEmail = () => {
        loginEmail.value = String(loginEmail.value || '').trim().toLowerCase();
      };
      loginEmail.addEventListener('blur', normalizeLoginEmail);
      const loginForm = loginEmail.closest('form');
      loginForm && loginForm.addEventListener('submit', normalizeLoginEmail);
    }
        const loginGoogleLegalCheck = document.getElementById('loginGoogleLegalCheck');
    const loginGoogleLegalField = document.getElementById('loginGoogleLegalField');
    const loginGoogleLegalError = document.getElementById('loginGoogleLegalError');
    const loginGoogleBtn = document.getElementById('loginGoogleBtn');

    if (loginGoogleLegalCheck && loginGoogleLegalField && loginGoogleLegalError && loginGoogleBtn) {
      let loginGoogleAccepted = !!loginGoogleLegalCheck.checked;

      const clearLoginGoogleError = () => {
        loginGoogleLegalField.classList.remove('is-invalid');
        loginGoogleLegalField.classList.remove('is-shaking');
        loginGoogleBtn.classList.remove('is-shaking');
        loginGoogleLegalError.classList.remove('is-visible');
      };

      const playLoginGoogleShake = () => {
        loginGoogleLegalField.classList.remove('is-shaking');
        loginGoogleBtn.classList.remove('is-shaking');
        void loginGoogleLegalField.offsetWidth;
        loginGoogleLegalField.classList.add('is-invalid', 'is-shaking');
        loginGoogleBtn.classList.add('is-shaking');
        loginGoogleLegalError.classList.add('is-visible');
      };

      loginGoogleLegalCheck.addEventListener('change', () => {
        loginGoogleAccepted = !!loginGoogleLegalCheck.checked;
        if (loginGoogleAccepted) clearLoginGoogleError();
      });

      loginGoogleBtn.addEventListener('click', (e) => {
        loginGoogleAccepted = !!loginGoogleLegalCheck.checked;
        if (loginGoogleAccepted) {
          clearLoginGoogleError();
          return;
        }
        e.preventDefault();
        playLoginGoogleShake();
      });

      loginGoogleLegalField.addEventListener('animationend', () => {
        loginGoogleLegalField.classList.remove('is-shaking');
      });

      loginGoogleBtn.addEventListener('animationend', () => {
        loginGoogleBtn.classList.remove('is-shaking');
      });
    }

    const input = document.getElementById('loginPw');
    const btn   = document.querySelector('[data-pw-target="loginPw"]');
    if (!input || !btn) return;

      btn.addEventListener('click', () => {
      const isPwd = input.getAttribute('type') === 'password';
      input.setAttribute('type', isPwd ? 'text' : 'password');
      btn.textContent = isPwd ? 'Ocultar' : 'Mostrar';
    });
  });

  // ===== Modales legales =====
  function openLegalModal(which){
    const id = which === 'terms' ? 'modalTerms' : 'modalPrivacy';
    const el = document.getElementById(id);
    if (el){
      el.classList.add('is-open');
      document.documentElement.style.overflow = 'hidden';
      el.addEventListener('click', function onOverlay(e){
        if (e.target === el){
          closeLegalModal(which);
          el.removeEventListener('click', onOverlay);
        }
      });
    }
  }
  function closeLegalModal(which){
    const id = which === 'terms' ? 'modalTerms' : 'modalPrivacy';
    const el = document.getElementById(id);
    if (el) el.classList.remove('is-open');
    document.documentElement.style.overflow = '';
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape'){
      closeLegalModal('terms');
      closeLegalModal('privacy');
    }
  });
