    box-shadow:0 14px 34px rgba(15,23,42,.12), inset 0 1px 0 rgba(255,255,255,.7);
  }
  .auth-social__btn:active{ transform:translateY(0); }
  .auth-social__icon{
    width:20px;
    height:20px;
    display:block;
    flex:0 0 20px;
  }
  .auth-social__divider{
    display:flex;
    align-items:center;
    justify-content:center;
    gap: 0;
    margin:12px 0 18px;
    color:#64748b;
    font-size:12px;
    font-weight:800;
    letter-spacing:.04em;
    text-transform:uppercase;
  }
  .auth-social__divider::before,
  .auth-social__divider::after{
    content:'';
