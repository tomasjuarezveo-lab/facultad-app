    width: 100% !important;
    margin-left: 0 !important;
  }

  /* Materias: 1 columna */
  #pfViewAffinity .pf-affinitySubjectsDeck{
    grid-template-columns: 1fr !important;
  }

  /* Cabecera: apilada */
  #pfViewAffinity .pf-affinityHead,
  #pfViewAffinity .pf-affinityResultTop{
    flex-direction: column !important;
    gap: 6px !important;
  }
  #pfViewAffinity .pf-affinityCounter{
    align-self: flex-start !important;
  }

  /* Stepper: solo números, sin texto */
  #pfViewAffinity .pf-affinityStepper{
    gap: 6px !important;
    justify-content: center !important;
  }
  #pfViewAffinity .pf-affinityStepText{ display: none !important; }

  /* Tipografías */
  #pfViewAffinity .pf-affinityTitle{ font-size: 13px !important; }
  #pfViewAffinity .pf-affinitySub{ font-size: 10px !important; }
  #pfViewAffinity .pf-affinityQuestionText{ font-size: 12px !important; }
  #pfViewAffinity .pf-affinityQuestionCard{ padding: 10px !important; }
  #pfViewAffinity .pf-affinityCurrentList{ max-height: 200px !important; }

  /* Opciones */
  #pfViewAffinity .pf-affinityOption{
    width: 90px !important;
    max-width: 90px !important;
    min-width: 90px !important;
    font-size: 10px !important;
    height: 24px !important;
    padding: 0 8px !important;
  }

    /* Footer */
    #pfViewAffinity .pf-affinityBtn{ font-size: 12px !important; height: 32px !important; padding: 0 12px !important; }
    #pfViewAffinity .pf-affinityFooter{ gap: 6px !important; margin-top: 10px !important; padding-top: 10px !important; }
    #pfViewAffinity .pf-affinityProgressWrap{ margin-bottom: 10px !important; }

    /* Resultados */
    #pfViewAffinity .pf-affinityResultToolbar{ flex-direction: column !important; gap: 6px !important; }
    #pfViewAffinity .pf-affinitySearchWrap.is-result{
      width: 100% !important;
      max-width: 100% !important;
      flex: 0 0 auto !important;
      height: 34px !important;
      border-radius: 9999px !important;
      padding: 0 12px !important;
      background: rgba(15,23,42,.06) !important;
      display: flex !important;
      align-items: center !important;
      box-sizing: border-box !important;
    }
  }
  #pfAgendaImportTxtBtn{
    min-height:40px;
    padding:0 14px;
    border-radius:999px;
    border:1px solid rgba(15,23,42,.10);
    background:rgba(255,255,255,.88);
    color:rgba(15,23,42,.86);
    font-size:13px;
    font-weight:900;
    box-shadow:0 12px 24px rgba(15,23,42,.08);
    cursor:pointer;
  }
  #pfAgendaImportTxtBtn:disabled{
    opacity:.6;
    cursor:default;
  }
  html.cw-dark #pfAgendaImportTxtBtn{
    background:rgba(255,255,255,.08);
    border-color:rgba(255,255,255,.12);
    color:rgba(243,244,246,.92);
  }
</style>
