/* ✅ FINAL: Modal Editar foto tipo carrusel */
#pfIgModal .pf-photoCard{
  width: min(760px, calc(100vw - 32px));
  height: min(470px, calc(100vh - 32px));
  border-radius: 36px;
  background:
    radial-gradient(circle at 14% 18%, rgba(124,58,237,.10), transparent 22%),
    radial-gradient(circle at 82% 78%, rgba(248,193,96,.16), transparent 24%),
    radial-gradient(circle at 74% 18%, rgba(249,115,22,.10), transparent 20%),
    linear-gradient(180deg, #ffffff 0%, #fffdf8 100%) !important;
  border: 1px solid rgba(15,23,42,.08);
  box-shadow: 0 34px 90px rgba(15,23,42,.18);
  position: relative;
  overflow: hidden;
  isolation: isolate;
}

#pfIgModal .pf-photoCard::before{
  content: "";
  position: absolute;
  inset: -10%;
  z-index: 0;
  pointer-events: none;
  opacity: .82;
  background:
    radial-gradient(95% 34% at 12% 72%, transparent 96.2%, rgba(124,58,237,.46) 97%, transparent 97.8%),
    radial-gradient(82% 26% at 48% 24%, transparent 96.2%, rgba(248,193,96,.64) 97%, transparent 97.8%),
    radial-gradient(74% 28% at 88% 64%, transparent 96.2%, rgba(249,115,22,.34) 97%, transparent 97.8%);
  transform: rotate(-2deg);
}

#pfIgModal .pf-photoCard::after{
  content: "";
  position: absolute;
  inset: -12%;
  z-index: 0;
  pointer-events: none;
  opacity: .68;
  background:
    radial-gradient(86% 30% at 18% 32%, transparent 96.3%, rgba(124,58,237,.30) 97.1%, transparent 97.9%),
    radial-gradient(90% 32% at 70% 78%, transparent 96.3%, rgba(248,193,96,.56) 97.1%, transparent 97.9%),
    radial-gradient(68% 24% at 92% 18%, transparent 96.3%, rgba(245,158,11,.28) 97.1%, transparent 97.9%);
  transform: rotate(2deg);
}

#pfIgModal .pf-photoClose{
  top: 16px;
  right: 16px;
  width: 36px;
  height: 36px;
  border-radius: 9999px;
  color: rgba(15,23,42,.78);
  background: rgba(255,255,255,.78);
  backdrop-filter: blur(10px) saturate(140%);
  -webkit-backdrop-filter: blur(10px) saturate(140%);
  z-index: 5;
}

#pfIgModal .pf-photoBody{
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 24px 22px 22px;
  background: transparent !important;
  position: relative;
  z-index: 2;
}

#pfIgModal #pfPhotoMsg{
  display: none !important;
}

#pfIgModal #pfPhotoPanelAvatar{
  width: 100%;
  height: 100%;
  display: flex !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
}

#pfIgModal .pf-avaRow{
  position: relative;
  width: 100%;
  height: 300px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

#pfIgModal #pfPhotoAvaGrid{
  position: relative;
  width: min(660px, calc(100vw - 120px));
  height: 270px;
  margin: 0 auto;
  overflow: visible;
  display: block;
  padding: 0;
  min-height: 0;
  -webkit-mask-image: none;
  mask-image: none;
}

#pfIgModal .pf-photoAva{
  position: absolute;
  top: 50%;
  left: 50%;
  width: 120px;
  height: 120px;
  margin: 0;
  padding: 0;
  border: none !important;
  border-radius: 28px;
  background: transparent !important;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
  transform-origin: center center;
  transition: transform .34s ease, opacity .34s ease, filter .34s ease;
  will-change: transform, opacity;
  box-shadow: 0 18px 34px rgba(15,23,42,.18);
}

#pfIgModal .pf-photoAva img{
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 28px;
  display: block;
  background: rgba(15,23,42,.05);
  border: 3px solid #F8C160;
}

#pfIgModal .pf-photoAva.is-prev2,
#pfIgModal .pf-photoAva.is-prev,
#pfIgModal .pf-photoAva.is-center,
#pfIgModal .pf-photoAva.is-next,
#pfIgModal .pf-photoAva.is-next2{
  opacity: 1;
  pointer-events: auto;
}

#pfIgModal .pf-photoAva.is-prev2{
  z-index: 1;
  filter: saturate(.88);
  transform: translate(-282px, -28%) rotate(-14deg) scale(.72);
}

#pfIgModal .pf-photoAva.is-prev{
  z-index: 3;
  filter: saturate(.96);
  transform: translate(-176px, -44%) rotate(-8deg) scale(.90);
}

#pfIgModal .pf-photoAva.is-center{
  z-index: 5;
  transform: translate(-50%, -50%) rotate(0deg) scale(1.62);
}

#pfIgModal .pf-photoAva.is-next{
  z-index: 3;
  filter: saturate(.96);
  transform: translate(56px, -44%) rotate(8deg) scale(.90);
}

#pfIgModal .pf-photoAva.is-next2{
  z-index: 1;
  filter: saturate(.88);
  transform: translate(162px, -28%) rotate(14deg) scale(.72);
}

#pfIgModal .pf-avaArrow{
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 1px solid rgba(255,255,255,.42);
  border-radius: 9999px;
  background: rgba(255,255,255,.30);
  backdrop-filter: blur(16px) saturate(155%);
  -webkit-backdrop-filter: blur(16px) saturate(155%);
  box-shadow: 0 18px 36px rgba(15,23,42,.16);
  opacity: 1;
  z-index: 20;
}

#pfIgModal .pf-avaArrow:hover{
  opacity: 1;
}

#pfIgModal .pf-avaArrow:active{
  transform: translateY(calc(-50% + 1px)) scale(.98);
}

#pfIgModal .pf-avaArrow svg{
