/* ---------- NEXT (3 próximos) ---------- */
function pfFindNextOccurrence(ev, todayYMD){
  const from = String(ev.from||'');
  const to   = String(ev.to||'');
  if (!from || !to) return null;

  const start = (todayYMD > from) ? todayYMD : from;
  const sdt = pfParseYMD(start);
  const tdt = pfParseYMD(to);
  if (!sdt || !tdt) return null;

  // scan acotado
  const maxDays = 420;
  const cur = new Date(sdt.getTime());
  for (let i=0;i<maxDays;i++){
    const d = pfYMD(cur);
    if (d > to) break;
    if (pfEventAppliesToDay(ev, d)) return d;
    cur.setDate(cur.getDate()+1);
  }
  return null;
}

function pfAgendaRenderNext(){
  if (!pfAgendaNextRowEl) return;

  const today = pfYMD(new Date());

  const seen = new Set();
  const nexts = (pfAgendaEvents || [])
    .map(ev => {
      const nd = pfFindNextOccurrence(ev, today);
      return nd ? { ev, nextDate: nd } : null;
    })
    .filter(Boolean)
    .sort((a,b) => pfCmpYMD(a.nextDate, b.nextDate))
    .filter(x => {
      const id = String(x.ev.id || x.ev._id || x.ev.title || '');
      if (seen.has(id)) return false;
      seen.add(id);
      return true;
    })
    .slice(0,3);

  if (!nexts.length){
    pfAgendaNextRowEl.innerHTML = `<div class="pf-nextEmpty">no hay eventos próximos</div>`;
    return;
  }

  pfAgendaNextRowEl.innerHTML = nexts.map(x => {
    const rawTitle = String(x.ev && x.ev.title ? x.ev.title : '').trim();
    const title = rawTitle || 'Recordatorio';
    const shown = (title.length > 10) ? (title.slice(0, 10) + '...') : title;
    const date = String(x.nextDate || '');
    const tip = (title ? (title + (date ? (' · ' + date) : '')) : date);
    const dotColor = (x.ev && x.ev.color) ? String(x.ev.color) : '#F8C160';

    return `
      <div class="pf-nextItem" title="${escapeHtml(tip)}" aria-label="${escapeHtml(tip)}">
        <span class="pf-nextDot" aria-hidden="true" style="--pf-dot-color:${dotColor};"></span>
        <span class="pf-nextTxt">${escapeHtml(shown)}</span>
      </div>
    `;
  }).join('');
}

/* ---------- Range Modal (2 clicks) ---------- */
let pfRangeCursor = new Date();
pfRangeCursor.setDate(1);

let pfRangeStart = null; // ymd
let pfRangeEnd = null;   // ymd

function pfOpenRangeModal(){
  if (!pfRangeModalEl) return;

  // init from current
  const f = String(pfAgendaFromEl && pfAgendaFromEl.value ? pfAgendaFromEl.value.slice(0,10) : '');
  const t = String(pfAgendaToEl && pfAgendaToEl.value ? pfAgendaToEl.value.slice(0,10) : '');

  pfRangeStart = f || null;
  pfRangeEnd = t || null;

  const base = pfParseYMD(pfRangeStart || pfAgendaOpenDay || pfYMD(new Date()));
  if (base){
    pfRangeCursor = new Date(base.getFullYear(), base.getMonth(), 1);
  }

  pfRenderRangeMonth();

  pfRangeModalEl.classList.add('is-open');
  pfRangeModalEl.setAttribute('aria-hidden','false');
  document.documentElement.classList.add('pf-lock');
  document.body.classList.add('pf-lock');
}

function pfCloseRangeModal(){
  if (!pfRangeModalEl) return;
  pfRangeModalEl.classList.remove('is-open');
  pfRangeModalEl.setAttribute('aria-hidden','true');
  document.documentElement.classList.remove('pf-lock');
  document.body.classList.remove('pf-lock');
}

function pfRenderRangeMonth(){
  if (!pfRangeMonthEl || !pfRangeGridEl) return;

  try{
    pfRangeMonthEl.textContent = pfRangeCursor.toLocaleDateString('es-AR', { month:'long', year:'numeric' });
  }catch(_){
    pfRangeMonthEl.textContent = pfYMD(pfRangeCursor).slice(0,7);
  }

  const y = pfRangeCursor.getFullYear();
  const m = pfRangeCursor.getMonth();
  const first = new Date(y, m, 1);
  const daysInMonth = new Date(y, m+1, 0).getDate();
  const startIndex = (first.getDay() + 6) % 7;

  const start = pfRangeStart ? String(pfRangeStart) : '';
  const end   = pfRangeEnd   ? String(pfRangeEnd)   : '';
  const rr = (start && end) ? pfClampRange(start,end) : { from:start, to:end };

  let html = '';
  for (let i=0;i<42;i++){
    const dayNum = i - startIndex + 1;
    if (dayNum < 1 || dayNum > daysInMonth){
      html += `<div class="pf-rangeCell is-empty" aria-hidden="true"></div>`;
      continue;
    }

    const dt = new Date(y, m, dayNum);
    const ymd = pfYMD(dt);

    const isStart = (rr.from && ymd === rr.from);
    const isEnd = (rr.to && ymd === rr.to);
    const inRange = (rr.from && rr.to && rr.from < ymd && ymd < rr.to);

    html += `
      <button type="button"
        class="pf-rangeCell ${isStart ? 'is-start' : ''} ${isEnd ? 'is-end' : ''} ${inRange ? 'is-inrange' : ''}"
        data-date="${ymd}"
      >
        <div class="pf-rangeDay">${dayNum}</div>
      </button>
    `;
  }

  pfRangeGridEl.innerHTML = html;

  pfRangeGridEl.querySelectorAll('.pf-rangeCell[data-date]').forEach(b => {
    b.addEventListener('click', () => {
      const d = String(b.getAttribute('data-date') || '');
      if (!d) return;

      // 2 clicks: start -> end
      if (!pfRangeStart || (pfRangeStart && pfRangeEnd)){
        pfRangeStart = d;
        pfRangeEnd = null;
      }else{
        pfRangeEnd = d;
      }
      pfRenderRangeMonth();
    });
  });
}

/* ---------- Repeat Modal ---------- */
let pfRepeatMode = 'weekly';
let pfRepeatDows = new Set();
let pfRepeatDom  = new Set();

function pfBuildRepeatMonthGridOnce(){
  if (!pfRepeatMonthGridEl) return;
  if (pfRepeatMonthGridEl.dataset.built === '1') return;

  let html = '';
  for (let i=1;i<=31;i++){
    html += `<button type="button" class="pf-repeatDom" data-dom="${i}">${i}</button>`;
  }
  pfRepeatMonthGridEl.innerHTML = html;
  pfRepeatMonthGridEl.dataset.built = '1';
}

function pfOpenRepeatModal(){
  if (!pfRepeatModalEl) return;

  pfBuildRepeatMonthGridOnce();

  // load current
  const rep = pfAgendaRepeat || { mode:'none', dows:[], dom:[] };
  if (rep.mode === 'monthly'){
    pfRepeatMode = 'monthly';
    pfRepeatDom = new Set((rep.dom || []).map(Number));
    pfRepeatDows = new Set();
  }else if (rep.mode === 'weekly'){
    pfRepeatMode = 'weekly';
    pfRepeatDows = new Set((rep.dows || []).map(Number));
    pfRepeatDom = new Set();
  }else{
    pfRepeatMode = 'weekly';
    pfRepeatDows = new Set();
    pfRepeatDom = new Set();
  }

  // apply UI
  const setMode = (mode) => {
    pfRepeatMode = mode;
    if (pfRepeatSegWeekEl) pfRepeatSegWeekEl.classList.toggle('is-active', mode === 'weekly');
    if (pfRepeatSegMonthEl) pfRepeatSegMonthEl.classList.toggle('is-active', mode === 'monthly');
    if (pfRepeatPaneWeekEl) pfRepeatPaneWeekEl.classList.toggle('is-active', mode === 'weekly');
    if (pfRepeatPaneMonthEl) pfRepeatPaneMonthEl.classList.toggle('is-active', mode === 'monthly');
  };

  setMode(pfRepeatMode);

  // week chips
  pfRepeatModalEl.querySelectorAll('.pf-repeatChip[data-dow]').forEach(btn => {
    const d = Number(btn.getAttribute('data-dow'));
    btn.classList.toggle('is-on', pfRepeatDows.has(d));
  });

  // month dom
  if (pfRepeatMonthGridEl){
    pfRepeatMonthGridEl.querySelectorAll('.pf-repeatDom[data-dom]').forEach(btn => {
      const d = Number(btn.getAttribute('data-dom'));
      btn.classList.toggle('is-on', pfRepeatDom.has(d));
    });
  }

  pfRepeatModalEl.classList.add('is-open');
  pfRepeatModalEl.setAttribute('aria-hidden','false');
  document.documentElement.classList.add('pf-lock');
  document.body.classList.add('pf-lock');

  // bind seg
  if (pfRepeatSegWeekEl) pfRepeatSegWeekEl.onclick = () => setMode('weekly');
  if (pfRepeatSegMonthEl) pfRepeatSegMonthEl.onclick = () => setMode('monthly');

  // bind week
  pfRepeatModalEl.querySelectorAll('.pf-repeatChip[data-dow]').forEach(btn => {
    btn.onclick = () => {
      const d = Number(btn.getAttribute('data-dow'));
      if (pfRepeatDows.has(d)) pfRepeatDows.delete(d);
      else pfRepeatDows.add(d);
      btn.classList.toggle('is-on', pfRepeatDows.has(d));
    };
  });

  // bind month
  if (pfRepeatMonthGridEl){
    pfRepeatMonthGridEl.querySelectorAll('.pf-repeatDom[data-dom]').forEach(btn => {
      btn.onclick = () => {
        const d = Number(btn.getAttribute('data-dom'));
        if (pfRepeatDom.has(d)) pfRepeatDom.delete(d);
        else pfRepeatDom.add(d);
        btn.classList.toggle('is-on', pfRepeatDom.has(d));
      };
    });
  }
}

function pfCloseRepeatModal(){
  if (!pfRepeatModalEl) return;
  pfRepeatModalEl.classList.remove('is-open');
  pfRepeatModalEl.setAttribute('aria-hidden','true');
  document.documentElement.classList.remove('pf-lock');
  document.body.classList.remove('pf-lock');
}

/* ---------- Init ---------- */
function pfAgendaInitV2(){
  if (pfAgendaDidInit) return;
  pfAgendaDidInit = true;

  pfAgendaEvents = [];

  pfLoadAgendaEvents().then((events) => {
    pfAgendaEvents = Array.isArray(events) ? events : [];
    pfAgendaRenderYears();
    pfAgendaRenderMonth();
    pfAgendaRenderNext();
  });
    pfPaintAgendaDots();

  // ✅ años
  if (pfAgendaYearsEl){
    pfAgendaYearsEl.addEventListener('click', (e) => {
      const btn = e.target && e.target.closest('.pf-yearBtn');
      if (!btn) return;
      const y = Number(btn.getAttribute('data-year'));
      if (!Number.isFinite(y)) return;

      pfAgendaCursor.setFullYear(y);
      pfAgendaCursor.setDate(1);
      pfAgendaRenderYears();
      pfAgendaRenderMonth();
      pfAgendaRenderNext();
    });
  }

  if (pfYearPrevBtn){
    pfYearPrevBtn.addEventListener('click', () => {
      pfAgendaCursor.setFullYear(pfAgendaCursor.getFullYear() - 1);
      pfAgendaCursor.setDate(1);
      pfAgendaRenderYears(); pfAgendaRenderMonth(); pfAgendaRenderNext();
    });
  }
  if (pfYearNextBtn){
    pfYearNextBtn.addEventListener('click', () => {
      pfAgendaCursor.setFullYear(pfAgendaCursor.getFullYear() + 1);
      pfAgendaCursor.setDate(1);
      pfAgendaRenderYears(); pfAgendaRenderMonth(); pfAgendaRenderNext();
    });
  }

  // ✅ mes
  if (pfAgendaPrevBtn){
    pfAgendaPrevBtn.addEventListener('click', () => {
      pfAgendaCursor.setMonth(pfAgendaCursor.getMonth() - 1);
      pfAgendaCursor.setDate(1);
      pfAgendaRenderYears(); pfAgendaRenderMonth(); pfAgendaRenderNext();
    });
  }
  if (pfAgendaNextBtn){
    pfAgendaNextBtn.addEventListener('click', () => {
      pfAgendaCursor.setMonth(pfAgendaCursor.getMonth() + 1);
      pfAgendaCursor.setDate(1);
      pfAgendaRenderYears(); pfAgendaRenderMonth(); pfAgendaRenderNext();
    });
  }

  // ✅ click día => abre VER
  if (pfAgendaGridEl){
    pfAgendaGridEl.addEventListener('click', (e) => {
      const cell = e.target && e.target.closest ? e.target.closest('.pf-agendaCell') : null;
      if (!cell) return;
      if (cell.classList.contains('is-empty')) return;

      const ymd = String(cell.getAttribute('data-date') || '');
      if (!ymd) return;

      e.preventDefault();
      e.stopPropagation();
      pfAgendaOpenViewModalForDay(ymd);
    });
  }

  // ===== Tooltip hover celdas (solo desktop) =====
  (function(){
    const tt = document.getElementById('pfAgendaCellTooltip');
    if (!tt || !pfAgendaGridEl) return;

    // Solo activo en dispositivos con hover real
    if (!window.matchMedia('(hover:hover) and (pointer:fine)').matches) return;

    let hideTimer = null;

    function showTooltip(cell, x, y){
      const ymd = String(cell.getAttribute('data-date') || '');
      if (!ymd) return;

      const evs = pfListEventsForDay(ymd);
      if (!evs.length) return;

      const MAX = 3;
      const shown = evs.slice(0, MAX);
      const extra = evs.length - MAX;

      let html = shown.map(ev => {
        const name = String(ev.title || '').trim() || 'Recordatorio';
        const short = name.length > 22 ? name.slice(0, 22) + '…' : name;
        const color = String(ev.color || '#22c55e');
        return `<div class="pf-ttRow"><span class="pf-ttDot" style="background:${color};"></span>- ${escapeHtml(short)}</div>`;
      }).join('');

      if (extra > 0){
        html += `<div class="pf-ttMore">+${extra} más…</div>`;
      }

      tt.innerHTML = html;

      // Posición: arriba del cursor, centrado horizontalmente
      tt.style.left = '0px';
      tt.style.top = '0px';
      tt.classList.add('is-visible');

      const ttW = tt.offsetWidth;
      const ttH = tt.offsetHeight;
      const margin = 10;

      let left = x - ttW / 2;
      let top = y - ttH - margin;

      // Evitar que salga por los bordes
      if (left < 8) left = 8;
      if (left + ttW > window.innerWidth - 8) left = window.innerWidth - 8 - ttW;
      if (top < 8) top = y + margin + 20; // si no hay espacio arriba, mostrar abajo

      tt.style.left = left + 'px';
      tt.style.top = top + 'px';
    }

    function hideTooltip(){
      tt.classList.remove('is-visible');
      tt.innerHTML = '';
    }

    pfAgendaGridEl.addEventListener('mouseover', (e) => {
      const cell = e.target && e.target.closest ? e.target.closest('.pf-agendaCell') : null;
      if (!cell || cell.classList.contains('is-empty')) { hideTooltip(); return; }
      if (hideTimer){ clearTimeout(hideTimer); hideTimer = null; }
      const rect = cell.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top;
      showTooltip(cell, cx, cy);
    });

    pfAgendaGridEl.addEventListener('mouseleave', () => {
      hideTimer = setTimeout(hideTooltip, 80);
    });
  })();

  // ✅ cerrar VER
  if (pfAgendaViewCloseEl){
    pfAgendaViewCloseEl.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      pfAgendaCloseViewModal();
    });
  }

  if (pfAgendaViewModalEl){
    pfAgendaViewModalEl.addEventListener('click', (e) => {
      if (e.target === pfAgendaViewModalEl){
        pfAgendaCloseViewModal();
      }
    });
  }
  if (pfAgendaViewPrevEl){
  pfAgendaViewPrevEl.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();

    const total = Array.isArray(pfAgendaViewListCache) ? pfAgendaViewListCache.length : 0;
    if (total <= 1) return;

    pfAgendaViewIndex = Math.max(0, pfAgendaViewIndex - 1);
    pfAgendaRenderViewList();
  });
}

if (pfAgendaViewNextEl){
  pfAgendaViewNextEl.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();

    const total = Array.isArray(pfAgendaViewListCache) ? pfAgendaViewListCache.length : 0;
    if (total <= 1) return;

    pfAgendaViewIndex = Math.min(total - 1, pfAgendaViewIndex + 1);
    pfAgendaRenderViewList();
  });
}

if (pfAgendaViewStrikeEl){
  pfAgendaViewStrikeEl.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();

    const id = String(pfAgendaSelectedId || '');
    if (!id) return;

    pfAgendaToggleStrike(id);
    pfAgendaRenderViewList();
  });
}


  // ✅ click en un recordatorio (VER)
  // - click en checkbox => seleccionar para Editar
  // - click en botón => ver detalle dentro del mismo modal + Back
  if (pfAgendaViewBodyEl){
    pfAgendaViewBodyEl.addEventListener('click', (e) => {
      const chk = e.target && e.target.closest ? e.target.closest('.pf-agendaViewPick') : null;
      if (chk){
        e.stopPropagation();
        const id = String(chk.getAttribute('data-id') || '');
        if (!id) return;

        // solo 1 seleccionado
        if (chk.checked){
          pfAgendaSetSelected(id);
        }else{
          pfAgendaSetSelected(null);
        }
        return;
      }

      const btn = e.target && e.target.closest ? e.target.closest('.pf-agendaViewBtn') : null;
      if (!btn) return;
      const id = String(btn.getAttribute('data-id') || '');
      if (!id) return;

      // al ver detalle también queda seleccionado para editar
      pfAgendaSetSelected(id);
      pfAgendaSetViewMode('detail', id);
      pfAgendaRenderViewDetailById(id);
    });
  }

  // ✅ Back (detalle -> lista)
  if (pfAgendaViewBackEl){
    pfAgendaViewBackEl.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      const day = String(pfAgendaOpenDay || '');
      const list = day ? pfListEventsForDay(day) : [];
      pfAgendaSetViewMode('list');
      pfAgendaRenderViewList(list);
    });
  }

  // ✅ Crear (VER)
  if (pfAgendaViewCreateEl){
    pfAgendaViewCreateEl.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      const day = String(pfAgendaOpenDay || '');
      pfAgendaCloseItemModal();
      pfAgendaCloseViewModal();
      if (!day) return;
      setTimeout(() => pfAgendaOpenCreateModalForDay(day), 0);
    });
  }

  // ✅ Editar (VER)
  if (pfAgendaViewEditEl){
    pfAgendaViewEditEl.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      const day = String(pfAgendaOpenDay || '');
      const id = String(pfAgendaSelectedId || '');
      const ev = pfAgendaFindById(id);
      if (!day || !id || !pfAgendaCanEditEvent(ev)) return;
      pfAgendaCloseItemModal();
      pfAgendaCloseViewModal();
      setTimeout(() => {
        pfAgendaOpenDay = day;
        pfAgendaOpenEditModalForId(id);
      }, 0);
    });
  }

  // ✅ cerrar DETALLE
  if (pfAgendaItemCloseEl){
    pfAgendaItemCloseEl.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      pfAgendaCloseItemModal();
    });
  }
  if (pfAgendaItemModalEl){
    pfAgendaItemModalEl.addEventListener('click', (e) => {
      if (e.target === pfAgendaItemModalEl) pfAgendaCloseItemModal();
    });
  }

  // ✅ DETALLE: Crear / Editar
  if (pfAgendaItemCreateEl){
    pfAgendaItemCreateEl.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      const day = String(pfAgendaOpenDay || '');
      pfAgendaCloseItemModal();
      pfAgendaCloseViewModal();
      if (!day) return;
      setTimeout(() => pfAgendaOpenCreateModalForDay(day), 0);
    });
  }
  if (pfAgendaItemEditEl){
    pfAgendaItemEditEl.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      const day = String(pfAgendaOpenDay || '');
      const id = String(pfAgendaItemOpenId || pfAgendaSelectedId || '');
      const ev = pfAgendaFindById(id);
      if (!day || !id || !pfAgendaCanEditEvent(ev)) return;
      pfAgendaCloseItemModal();
      pfAgendaCloseViewModal();
      setTimeout(() => {
        pfAgendaOpenDay = day;
        pfAgendaOpenEditModalForId(id);
      }, 0);
    });
  }


  // ✅ cerrar CREAR
  if (pfAgendaCloseEl){
    pfAgendaCloseEl.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      pfAgendaCloseModal();
    });
  }
  if (pfAgendaModalEl){
    pfAgendaModalEl.addEventListener('click', (e) => {
      if (e.target === pfAgendaModalEl) pfAgendaCloseModal();
    });
  }

  // ✅ ESC cierra lo que esté abierto
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;

    if (pfAgendaModalEl && pfAgendaModalEl.classList.contains('is-open')) pfAgendaCloseModal();
    if (pfAgendaViewModalEl && pfAgendaViewModalEl.classList.contains('is-open')) pfAgendaCloseViewModal();
    if (pfRangeModalEl && pfRangeModalEl.classList.contains('is-open')) pfCloseRangeModal();
    if (pfRepeatModalEl && pfRepeatModalEl.classList.contains('is-open')) pfCloseRepeatModal();
  });

  // ✅ colores (click)
  if (pfAgendaColorRowEl){
    pfAgendaColorRowEl.addEventListener('click', (e) => {
      const dot = e.target && e.target.closest ? e.target.closest('.pf-colorDot') : null;
      if (!dot) return;
      const c = String(dot.getAttribute('data-color') || '#22c55e');
      pfAgendaColor = c;

      pfPaintAgendaDots();
      pfAgendaColorRowEl.querySelectorAll('.pf-colorDot').forEach(b => {
        const bc = String(b.getAttribute('data-color') || '');
        b.classList.toggle('is-on', bc.toLowerCase() === pfAgendaColor.toLowerCase());
      });
    });
  }

  const pfCustomColorBtn = document.getElementById('pfAgendaCustomColorBtn');
  const pfCustomColorInput = document.getElementById('pfAgendaCustomColorInput');

  if (pfCustomColorBtn && pfCustomColorInput){
    pfCustomColorBtn.addEventListener('click', () => {
      pfCustomColorInput.value = pfAgendaColor || '#22c55e';
      pfCustomColorInput.click();
    });

    pfCustomColorInput.addEventListener('input', () => {
      const c = String(pfCustomColorInput.value || '#22c55e');
      pfAgendaColor = c;
      pfCustomColorBtn.style.background = c;
      pfCustomColorBtn.style.border = 'none';
      pfCustomColorBtn.textContent = '';
      pfPaintAgendaDots();
      pfAgendaColorRowEl.querySelectorAll('.pf-colorDot').forEach(b => {
        b.classList.remove('is-on');
      });
    });
  }

  if (PF_IS_ADMIN){
    if (pfAgendaScopePersonalEl){
      pfAgendaScopePersonalEl.addEventListener('click', () => {
        pfAgendaSetScope('personal');
      });
    }

    if (pfAgendaScopeGlobalEl){
      pfAgendaScopeGlobalEl.addEventListener('click', () => {
        pfAgendaSetScope('global');
      });
    }

    if (pfAgendaCareerRowEl){
      pfAgendaCareerRowEl.querySelectorAll('.pf-agendaCareerBtn').forEach(btn => {
        btn.addEventListener('click', () => {
          const c = String(btn.getAttribute('data-career') || '');
          if (!c) return;

          if (pfAgendaCareers.has(c)) pfAgendaCareers.delete(c);
          else pfAgendaCareers.add(c);

          btn.classList.toggle('is-on', pfAgendaCareers.has(c));
        });
      });
    }
  }

  if (pfAgendaImportTxtBtnEl && pfAgendaImportTxtInputEl){
    pfAgendaImportTxtBtnEl.addEventListener('click', () => {
      pfAgendaImportTxtInputEl.value = '';
      pfAgendaImportTxtInputEl.click();
    });

    pfAgendaImportTxtInputEl.addEventListener('change', async (e) => {
      const file = e.target && e.target.files && e.target.files[0] ? e.target.files[0] : null;
      if (!file) return;

      if (!String(file.name || '').toLowerCase().endsWith('.txt')){
        alert('Subí un archivo .txt');
        return;
      }

      const content = await file.text();
      if (!String(content || '').trim()){
        alert('El archivo está vacío.');
        return;
      }

      if (!confirm('Esto reemplaza por completo el archivo anterior importado en agenda.')) return;

      const oldText = pfAgendaImportTxtBtnEl.textContent;
      pfAgendaImportTxtBtnEl.disabled = true;
      pfAgendaImportTxtBtnEl.textContent = 'Importando…';

      try{
        const j = await postJSON('/app/perfil/api/agenda/import-text', { content });
        if (!j || !j.ok) throw new Error((j && j.error) || 'No se pudo importar');

        pfAgendaEvents = await pfLoadAgendaEvents();
        pfAgendaRenderYears();
        pfAgendaRenderMonth();
        pfAgendaRenderNext();
        alert('Agenda importada correctamente. Eventos cargados: ' + String(j.imported || 0));
      }catch(err){
        console.error('agenda import failed:', err);
        alert(err && err.message ? err.message : 'No se pudo importar el archivo.');
      }finally{
        pfAgendaImportTxtBtnEl.disabled = false;
        pfAgendaImportTxtBtnEl.textContent = oldText;
      }
    });
  }

  // ✅ quick buttons (hoy / semana / mes)
  document.querySelectorAll('#pfAgendaModal .pf-qbtn').forEach(btn => {
    btn.addEventListener('click', () => {
      const q = String(btn.getAttribute('data-q') || '');
      const base = pfParseYMD(String(pfAgendaOpenDay || pfYMD(new Date())));
      if (!base) return;

      const from = pfYMD(base);
      const toDt = new Date(base.getTime());

      if (q === 'today'){
        // mismo día
      }else if (q === 'week'){
        toDt.setDate(toDt.getDate() + 7);
      }else if (q === 'month'){
        toDt.setMonth(toDt.getMonth() + 1);
      }

      const to = pfYMD(toDt);
      pfSetRange(from, to);

      document.querySelectorAll('#pfAgendaModal .pf-qbtn').forEach(b => b.classList.remove('is-on'));
      btn.classList.add('is-on');
    });
  });

  // ✅ abrir selector rango
  if (pfAgendaRangeBtnEl){
    pfAgendaRangeBtnEl.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      pfOpenRangeModal();
