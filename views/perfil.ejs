  /* Centrar y contener el panel */
  #pfViewAffinity{
    padding: 0 4px 16px !important;
    box-sizing: border-box !important;
  }
  #pfViewAffinity .pf-affinityPanel{
    max-width: 100% !important;
    padding: 0 !important;
  }
  #pfViewAffinity .pf-affinityPanelCard{
    padding: 12px 10px !important;
    border-radius: 14px !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    overflow: hidden !important;
  }

  /* Toolbar: tabs año arriba, buscador debajo */
  #pfViewAffinity .pf-affinityToolbar{
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 6px !important;
  }
  #pfViewAffinity .pf-affinityYearTabs{
    justify-content: center !important;
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    scrollbar-width: none !important;
  }
  #pfViewAffinity .pf-affinityYearTabs::-webkit-scrollbar{ display: none !important; }
