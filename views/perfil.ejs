@media (max-width: 520px){
  #pfViewAgenda .pf-agendaTopBar{
    flex-direction: column;
    align-items: stretch;
  }
  #pfViewAgenda .pf-agendaSearchWrap{
    max-width: 100%;
  }
}
/* =========================
   ✅ Placeholder SVG universal (sin foto)
========================= */
.pf-avaSvg{
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  color: rgba(15,23,42,.55);
}

.pf-avaSvg svg{
  width: 22px;
  height: 22px;
  opacity: .92;
}

/* variantes por contexto */
.pf-avatarWrap .pf-avaSvg{
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
}
.pf-avatarWrap .pf-avaSvg svg{
  width: 100%;
  height: 100%;
  object-fit: cover;
}       /* avatar grande arriba izquierda */
.pf-composeAvatar .pf-avaSvg svg{ width: 18px; height: 18px; }       /* avatar al lado de “escribir post” */
