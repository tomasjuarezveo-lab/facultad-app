function pfAgendaHexToRgb(hex){
  const raw = String(hex || '').trim().replace('#', '');
  if (!/^[0-9a-fA-F]{3,8}$/.test(raw)) return null;

  let full = raw;
  if (full.length === 3 || full.length === 4){
    full = full.split('').map(ch => ch + ch).join('');
  }
  if (full.length < 6) return null;

  return {
    r: parseInt(full.slice(0, 2), 16),
    g: parseInt(full.slice(2, 4), 16),
    b: parseInt(full.slice(4, 6), 16)
  };
}

function pfAgendaPickReadableText(color){
  const rgb = pfAgendaHexToRgb(color);
  if (!rgb) return '#0f172a';
  const lum = ((0.299 * rgb.r) + (0.587 * rgb.g) + (0.114 * rgb.b)) / 255;
  return lum >= 0.72 ? '#0f172a' : '#ffffff';
}

function pfAgendaBuildViewDateLabel(ev){
  const from = String((ev && ev.from) || pfAgendaOpenDay || '');
