function pfAddDaysYMD(ymd, delta){
  const dt = pfParseYMD(ymd);
  if (!dt) return '';
  dt.setDate(dt.getDate() + Number(delta || 0));
  return pfYMD(dt);
}

function pfAgendaGetRangeClass(ev, ymd, cellIndex){
  if (!ev || !ev.isGlobal) return '';
  if (String(ev.from || '') >= String(ev.to || '')) return '';

  const rep = (ev.repeat && typeof ev.repeat === 'object') ? ev.repeat : null;
  if (rep && rep.mode && rep.mode !== 'none') return '';

  const prevYmd = pfAddDaysYMD(ymd, -1);
  const nextYmd = pfAddDaysYMD(ymd, 1);

  const prevTop = prevYmd ? pfGetTopEventForDay(prevYmd) : null;
  const nextTop = nextYmd ? pfGetTopEventForDay(nextYmd) : null;

  const joinLeft = (cellIndex % 7 !== 0) && prevTop && String(prevTop.id || '') === String(ev.id || '');
  const joinRight = (cellIndex % 7 !== 6) && nextTop && String(nextTop.id || '') === String(ev.id || '');

  if (joinLeft && joinRight) return 'is-global-range range-mid';
  if (joinLeft) return 'is-global-range range-end';
  if (joinRight) return 'is-global-range range-start';
  return 'is-global-range range-single';
}

