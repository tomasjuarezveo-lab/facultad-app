        <div id="pfViewFriends" class="pf-view">
          <div class="pf-friendsWrap">
            <div class="pf-friendsTitle">Amigos</div>

            <div id="pfFriendsGrid" class="pf-friendsGrid">
              <%
                const _followersIdsFriends =
                  (typeof followersIds !== 'undefined' && Array.isArray(followersIds)) ? followersIds : [];
                const _followingIdsFriends =
                  (typeof followingIds !== 'undefined' && Array.isArray(followingIds)) ? followingIds : [];

                const _followersSetFriends = new Set(_followersIdsFriends.map(v => String(v)).filter(Boolean));
                const _followingSetFriends = new Set(_followingIdsFriends.map(v => String(v)).filter(Boolean));
                const _friendsSet = new Set(Array.from(_followersSetFriends).filter(id => _followingSetFriends.has(id)));

                const _friends = (safeUsers || [])
                  .filter(x => String(x.id || ''))
                  .filter(x => String(x.id || '') !== String(uId || ''))
                  .filter(x => _friendsSet.has(String(x.id || '')));
              %>

              <% if (_friends.length === 0) { %>
                <div class="pf-friendsEmpty">Todavía no hay amigos.</div>
              <% } %>

              <% _friends.forEach((p)=>{ %>
                <%
                  const _pid = String(p.id || '');
                  const _av  = String(p.avatarUrl || '');
                %>

                <a class="pf-friendCard" href="/app/perfil/<%= encodeURIComponent(_pid) %>">
                  <div class="pf-friendAva">
                    <% if (_av) { %>
                      <img src="<%= _av %>" alt="" />
                    <% } else { %>
                      <div class="pf-avaSvg" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                          <circle cx="12" cy="8" r="4" fill="currentColor"></circle>
                          <ellipse opacity="0.45" cx="12" cy="18" rx="7" ry="4" fill="currentColor"></ellipse>
                        </svg>
                      </div>
                    <% } %>
                  </div>
                  <div class="pf-friendName"><%= p.name || 'Usuario' %></div>
                </a>
              <% }) %>
            </div>
          </div>
