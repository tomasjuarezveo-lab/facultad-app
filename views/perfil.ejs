<%
  const _followersIds =
    (typeof followersIds !== 'undefined' && Array.isArray(followersIds)) ? followersIds : [];
  const _followingIds =
    (typeof followingIds !== 'undefined' && Array.isArray(followingIds)) ? followingIds : [];

  const _socialSet = new Set([].concat(_followersIds, _followingIds).map(v => String(v)).filter(Boolean));

  // solo usuarios sociales (no te incluyas a vos)
  const _socialPeople = (safeUsers || [])
    .filter(x => String(x.id || ''))
    .filter(x => String(x.id || '') !== String(viewerId || ''))
    .filter(x => _socialSet.has(String(x.id || '')));

  // shuffle helper (server-side)
  function _shuffle(arr){
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--){
      const j = Math.floor(Math.random() * (i + 1));
      const t = a[i]; a[i] = a[j]; a[j] = t;
    }
    return a;
  }

  let dockPeople = [];

  // ✅ si ya hay 3+ sociales => mostrar SOLO sociales
  if (_socialPeople.length >= 3){
    dockPeople = _socialPeople.slice(0, 3);
  } else {
    // ✅ si hay menos de 3 sociales => completar con 3 random distintos
    const chosen = new Set(_socialPeople.map(u => String(u.id || '')));
    dockPeople = _socialPeople.slice();

    const pool = _shuffle((safeUsers || [])
      .filter(x => String(x.id || ''))
      .filter(x => String(x.id || '') !== String(viewerId || ''))
      .filter(x => !chosen.has(String(x.id || '')))
    );

    for (const p of pool){
      if (dockPeople.length >= 3) break;
      dockPeople.push(p);
    }

    dockPeople = dockPeople.slice(0, 3);
  }
%>

