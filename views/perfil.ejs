/* =========================
   ✅ DOCK THEME: Light por defecto, Dark automático
========================= */
:root{
  --pf-dock-bg: rgba(255,255,255,.78);
  --pf-dock-border: rgba(15,23,42,.12);
  --pf-dock-shadow: 0 18px 34px rgba(15,23,42,.12);

  --pf-dock-text: rgba(15,23,42,.92);
  --pf-dock-text-muted: rgba(15,23,42,.28);   /* ✅ más baja opacidad */
  --pf-dock-text-hover: rgba(15,23,42,.92);   /* ✅ fuerte al hover */

  --pf-dock-sep: rgba(15,23,42,.18);
  --pf-dock-item-hover: rgba(15,23,42,.06);

  --pf-dock-search-bg: rgba(15,23,42,.06);
  --pf-dock-search-border: rgba(15,23,42,.12);
  --pf-dock-search-ph: rgba(15,23,42,.42);

  --pf-dock-people-bg: rgba(15,23,42,.06);
  --pf-dock-people-border: rgba(15,23,42,.12);
}

/* Dark automático (OS) */
@media (prefers-color-scheme: dark){
  :root{
    --pf-dock-bg: rgba(15,23,42,.58);
    --pf-dock-border: rgba(255,255,255,.14);
    --pf-dock-shadow: 0 22px 44px rgba(0,0,0,.28);

    --pf-dock-text: rgba(255,255,255,.96);
    --pf-dock-text-muted: rgba(255,255,255,.28);  /* ✅ baja opacidad */
    --pf-dock-text-hover: rgba(255,255,255,.96);  /* ✅ fuerte al hover */

    --pf-dock-sep: rgba(255,255,255,.70);
    --pf-dock-item-hover: rgba(255,255,255,.10);

    --pf-dock-search-bg: rgba(255,255,255,.16);
    --pf-dock-search-border: rgba(255,255,255,.14);
    --pf-dock-search-ph: rgba(255,255,255,.70);

    --pf-dock-people-bg: rgba(0,0,0,.18);
    --pf-dock-people-border: rgba(255,255,255,.14);
  }
}

/* Dark por clase (por si tu app usa un toggle) */
html.dark, body.dark, html.theme-dark, body.theme-dark, html.pf-dark, body.pf-dark{
  --pf-dock-bg: rgba(15,23,42,.58);
  --pf-dock-border: rgba(255,255,255,.14);
  --pf-dock-shadow: 0 22px 44px rgba(0,0,0,.28);

  --pf-dock-text: rgba(255,255,255,.96);
  --pf-dock-text-muted: rgba(255,255,255,.28);
  --pf-dock-text-hover: rgba(255,255,255,.96);

  --pf-dock-sep: rgba(255,255,255,.70);
  --pf-dock-item-hover: rgba(255,255,255,.10);

  --pf-dock-search-bg: rgba(255,255,255,.16);
  --pf-dock-search-border: rgba(255,255,255,.14);
  --pf-dock-search-ph: rgba(255,255,255,.70);

  --pf-dock-people-bg: rgba(0,0,0,.18);
  --pf-dock-people-border: rgba(255,255,255,.14);
}

/* =========================
   ✅ Aplicación del theme al dock
========================= */
#pfBottomDock.pf-bottomDock{
  background: var(--pf-dock-bg) !important;
  border: 1px solid var(--pf-dock-border) !important;
  box-shadow: var(--pf-dock-shadow) !important;
  color: var(--pf-dock-text) !important;
}

/* botones */
#pfBottomDock .pf-bottomDockIconBtn{
  color: var(--pf-dock-text-muted) !important;
}
#pfBottomDock .pf-bottomDockIconBtn:hover{
  color: var(--pf-dock-text-hover) !important;
}

/* label: opacidad MUY baja, sube al hover del item */
#pfBottomDock .pf-dockLabel{
  color: var(--pf-dock-text-muted) !important;
}
#pfBottomDock .pf-bottomDockIconBtn:hover .pf-dockLabel,
#pfBottomDock .pf-dockMe:hover .pf-dockLabel{
  color: var(--pf-dock-text-hover) !important;
}

/* hover suave del item (cuando expandido) */
#pfBottomDock:hover .pf-bottomDockIconBtn:hover,
#pfBottomDock:hover .pf-dockMe:hover{
  background: var(--pf-dock-item-hover) !important;
}

/* separadores */
#pfBottomDock .pf-bottomDockSep{
  background: var(--pf-dock-sep) !important;
}

/* caja de perfiles */
#pfBottomDock .pf-bottomDockPeopleBox{
  background: var(--pf-dock-people-bg) !important;
  border: 1px solid var(--pf-dock-people-border) !important;
}

/* search */
#pfBottomDock .pf-dockSearchInputWrap{
  background: var(--pf-dock-search-bg) !important;
  border: 1px solid var(--pf-dock-search-border) !important;
}
#pfBottomDock .pf-dockSearchInput{
  color: var(--pf-dock-text) !important;
}
#pfBottomDock .pf-dockSearchInput::placeholder{
  color: var(--pf-dock-search-ph) !important;
}
/* =========================
   ✅ Dock: centrado perfecto cuando está retraído
========================= */
#pfBottomDock.pf-bottomDock .pf-bottomDockLeft{
  align-items: center !important;     /* ✅ centra separadores y botones */
}

#pfBottomDock.pf-bottomDock .pf-dockMe{
  justify-content: center !important; /* ✅ avatar arriba centrado */
}

#pfBottomDock.pf-bottomDock .pf-bottomDockBtns{
  align-items: center !important;
}

#pfBottomDock.pf-bottomDock .pf-bottomDockIconBtn{
  justify-content: center !important;
  padding: 0 !important;             /* ✅ evita “corrimiento” */
}

/* al expandir: vuelve a estirar y alinear a la izquierda */
#pfBottomDock.pf-bottomDock:hover .pf-bottomDockLeft{
  align-items: stretch !important;
}

#pfBottomDock.pf-bottomDock:hover .pf-dockMe{
  justify-content: flex-start !important;
}

#pfBottomDock.pf-bottomDock:hover .pf-bottomDockIconBtn{
  justify-content: flex-start !important;
  padding: 0 10px !important;
}
#pfBottomDock .pf-bottomDockSep{
  width: 44px;
  transition: width .18s cubic-bezier(.2,.8,.2,1), opacity .18s ease;
  opacity: .75;
}

#pfBottomDock:hover .pf-bottomDockSep{
  width: calc(100% - 8px);
  opacity: 1;
}
.pf-postsEmptyText{
  grid-column: 1 / -1;
  padding: 14px 6px;
  font-weight: 900;
  font-size: 12px;
  color: rgba(15,23,42,.38); /* gris clarito */
  text-align: center;
}
