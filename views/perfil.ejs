<script>
(function(){
  // =========================
  // Utils
  // =========================
  const $ = (id) => document.getElementById(id);

    const viewerId = <%- JSON.stringify(viewerId) %>;
  const uId = <%- JSON.stringify(uId) %>;
  const isOwn = <%- JSON.stringify(!!isOwn) %>;
  const isAdmin = <%- JSON.stringify(String((user && user.role) || '').trim().toLowerCase() === 'admin') %>;
  // ✅ clase para estilos según perfil propio / ajeno
  document.body.classList.toggle('pf-own', !!isOwn);
  document.body.classList.toggle('pf-not-own', !isOwn);
  const DEFAULT_AVATAR_DATA = <%- JSON.stringify(DEFAULT_AVATAR_DATA) %>;

  const USERS = <%- JSON.stringify(safeUsers) %>;
  const SUBJECTS = <%- JSON.stringify(safeSubjects) %>;
  const PROFESSORS = <%- JSON.stringify(safeProfessors) %>;

  const SERVER_PROFILE_POSTS = <%- JSON.stringify(initialProfilePosts) %>;
  const SERVER_FEED_POSTS = <%- JSON.stringify(initialFeedPosts) %>;
  const PF_SOCIAL_LINKS = <%- JSON.stringify((typeof socialLinks !== 'undefined' && socialLinks && typeof socialLinks === 'object') ? socialLinks : {}) %>;

  function norm(s){
    return String(s || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'')
      .trim();
  }

  function buildCareer(career, plan){
    const c = String(career || '');
    const p = String(plan || '');
    if (!c && !p) return '';
    const nice = c.includes('Admin') ? 'Lic. en Admin.' : (c.includes('Econom') ? 'Lic. en Economía' : c);
    return nice + (p ? (' · Plan ' + p) : '');
  }

  function escapeHtml(s){
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function fmtDate(ts){
    try{
      const d = new Date(ts);
      if (Number.isNaN(d.getTime())) return '';
      return d.toLocaleDateString([], { year:'numeric', month:'short', day:'2-digit' });
    }catch(_){ return ''; }
  }

  function wordCount(s){
    const t = String(s || '').trim();
    if (!t) return 0;
    return t.split(/\s+/g).filter(Boolean).length;
  }

  async function postJSON(url, data){
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data || {})
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    let out = null;
    try{ out = await res.json(); }catch(_){ out = null; }
    return out;
  }

  async function getJSON(url){
  const res = await fetch(url, {
    method: 'GET',
    headers: { 'Accept': 'application/json' }
  });
  if (!res.ok) throw new Error('HTTP ' + res.status);
  let out = null;
  try{ out = await res.json(); }catch(_){ out = null; }
  return out;
}
async function tryUpdateProfile(payload){
    const endpoints = [
      '/app/perfil/update',
      '/app/profile/update'
    ];

    let lastErr = null;
    for (const url of endpoints){
      try{
        const out = await postJSON(url, payload);
        return out;
      }catch(err){
        lastErr = err;
      }
    }
    throw lastErr || new Error('update failed');
  }

  const PF_SOCIAL_DEFS = {
    instagram: { label:'Instagram', mode:'handle', prefix:'https://www.instagram.com/' },
    facebook:  { label:'Facebook',  mode:'url',    prefix:'' },
    vsco:      { label:'VSCO',      mode:'url',    prefix:'' },
    x:         { label:'X',         mode:'handle', prefix:'https://x.com/' },
    pinterest: { label:'Pinterest', mode:'url',    prefix:'' }
  };

  const SOCIAL_PHOTOS = {
    instagram: 'https://i.pinimg.com/736x/04/43/f2/0443f2433f935e7f7c44aba64bbf2c23.jpg',
    facebook:  'https://cdn.pixabay.com/photo/2014/09/18/22/42/letters-451496_640.jpg',
    vsco:      'https://i.pinimg.com/564x/19/bb/7f/19bb7fc60f184769d12d4141e3312313.jpg',
    x:         'https://img.freepik.com/vector-gratis/nuevo-logotipo-twitter-x-sombra_1017-45419.jpg?w=360',
    pinterest: 'https://cdn-icons-png.flaticon.com/512/25/25698.png'
  };

  const SOCIAL_NAMES = {
    instagram: 'Instagram',
    facebook:  'Facebook',
    vsco:      'VSCO',
    x:         'X',
    pinterest: 'Pinterest'
  };

  let pfSocialDraft = (PF_SOCIAL_LINKS && typeof PF_SOCIAL_LINKS === 'object') ? JSON.parse(JSON.stringify(PF_SOCIAL_LINKS)) : {};
  try{ window.__pfSocialDraft = pfSocialDraft; }catch(_){}

  function pfNormalizeSocialValue(key, raw){
    const val = String(raw || '').trim();
    if (!val) return '';

    if (key === 'instagram'){
      const clean = val
        .replace(/^@+/, '')
        .replace(/^https?:\/\/(www\.)?instagram\.com\//i, '')
        .replace(/^\/+/, '')
        .replace(/\/+$/, '');
      return clean ? ('https://www.instagram.com/' + clean) : '';
    }

    if (key === 'x'){
      const clean = val
        .replace(/^@+/, '')
        .replace(/^https?:\/\/(www\.)?x\.com\//i, '')
        .replace(/^\/+/, '')
        .replace(/\/+$/, '');
      return clean ? ('https://x.com/' + clean) : '';
    }

    return val;
  }

  function pfSocialShortLabel(key){
    if (key === 'instagram') return 'IG';
    if (key === 'facebook') return 'f';
    if (key === 'vsco') return 'VS';
    if (key === 'x') return 'X';
    if (key === 'pinterest') return 'P';
    return '?';
  }

  function pfSocialDisplayText(key, url){
    const val = String(url || '').trim();
    if (!val) return '';

    if (key === 'instagram'){
      return '@' + val
        .replace(/^https?:\/\/(www\.)?instagram\.com\//i, '')
        .replace(/^\/+/, '')
        .replace(/\/+$/, '');
    }

    if (key === 'x'){
      return '@' + val
        .replace(/^https?:\/\/(www\.)?x\.com\//i, '')
        .replace(/^\/+/, '')
        .replace(/\/+$/, '');
    }

    if (key === 'facebook') return 'Facebook';
    if (key === 'vsco') return 'VSCO';
    if (key === 'pinterest') return 'Pinterest';

    return val;
  }

  function pfRenderSocialStack(){
    const stack = document.getElementById('pfSocialStack');
    if (!stack) return;

    const PREVIEW_AVATARS = [
      'https://i.pinimg.com/736x/04/43/f2/0443f2433f935e7f7c44aba64bbf2c23.jpg',
      'https://cdn.pixabay.com/photo/2014/09/18/22/42/letters-451496_640.jpg',
      'https://i.pinimg.com/564x/19/bb/7f/19bb7fc60f184769d12d4141e3312313.jpg'
    ];

    const order = ['instagram','facebook','vsco','x','pinterest'];

    // redes que el usuario ya cargó
    const loaded = order.filter(key => String((pfSocialDraft && pfSocialDraft[key]) || '').trim());

    let html = '';

    if (loaded.length > 0){
      // ✅ mostrar los círculos de las redes cargadas (visibles para todos)
      loaded.forEach((key, i) => {
        const url   = String(pfSocialDraft[key]).trim();
        const photo = SOCIAL_PHOTOS[key] || '';
        const name  = SOCIAL_NAMES[key]  || key;
        html += `<a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer" aria-label="${escapeHtml(name)}" title="${escapeHtml(name)}" style="width:34px;height:34px;min-width:34px;min-height:34px;max-width:34px;max-height:34px;border-radius:9999px;overflow:hidden;border:2px solid rgba(255,255,255,.96);background:rgba(255,255,255,.75);flex:0 0 34px;box-shadow:0 4px 10px rgba(15,23,42,.10);display:inline-flex;align-items:center;justify-content:center;position:relative;z-index:${loaded.length - i};${i>0?'margin-left:-10px;':''}margin-top:10px;margin-bottom:10px;text-decoration:none;transition:transform .15s ease,box-shadow .15s ease;cursor:pointer;" onmouseover="this.style.transform='translateY(-3px)';this.style.zIndex='10';this.style.boxShadow='0 8px 16px rgba(15,23,42,.18)';" onmouseout="this.style.transform='translateY(0)';this.style.zIndex='${loaded.length - i}';this.style.boxShadow='0 4px 10px rgba(15,23,42,.10)';">` +
          `<img src="${escapeHtml(photo)}" alt="${escapeHtml(name)}" style="width:34px;height:34px;min-width:34px;min-height:34px;max-width:34px;max-height:34px;object-fit:cover;object-position:center;display:block;border-radius:9999px;flex:none;" /></a>`;
      });
    } else if (isOwn) {
