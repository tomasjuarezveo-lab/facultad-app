    const dt = pfParseYMD(ymd);
    if (!dt) return String(ymd || '');
    return dt.toLocaleDateString('es-AR', { day:'numeric', month:'long', year:'numeric' });
  };

  if (from && to && from !== to){
    return `${fmt(from)} — ${fmt(to)}`;
  }
  return fmt(from || pfAgendaOpenDay || '');
}

