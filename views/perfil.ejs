function parseTagsFromRow(p){
  const tags = { subjects: [], people: [] };

  if (p && p.tags && typeof p.tags === 'object'){
    const t = p.tags;
    tags.subjects = Array.isArray(t.subjects) ? t.subjects.map(x => String((x && x.id !== undefined) ? x.id : x)).filter(Boolean) : [];
    tags.people   = Array.isArray(t.people)   ? t.people.map(x => String((x && x.id !== undefined) ? x.id : x)).filter(Boolean) : [];
    return tags;
  }

  const raw = String((p && (p.tags_json || p.tagsJson)) || '').trim();
  if (raw){
    try{
      const tj = JSON.parse(raw);
      tags.subjects = Array.isArray(tj.subjects) ? tj.subjects.map(x => String((x && (x.id ?? x.subjectId ?? x.subject_id)) ?? x)).filter(Boolean) : [];
      tags.people   = Array.isArray(tj.people)   ? tj.people.map(x => String((x && (x.id ?? x.userId ?? x.user_id)) ?? x)).filter(Boolean) : [];
      return tags;
    }catch(_){ }
  }

  tags.subjects = Array.isArray(p && p.subjects) ? p.subjects.map(x => String(x)).filter(Boolean) : [];
  tags.people   = Array.isArray(p && p.people)   ? p.people.map(x => String(x)).filter(Boolean) : [];
  return tags;
}

function normalizePost(p){
  const id = String((p && (p.id ?? p._id ?? p.postId)) || ('p_' + Math.random().toString(16).slice(2)));

  const userId = String((p && (p.userId ?? p.user_id ?? p.authorId ?? p.author_id ?? p.ownerId ?? p.owner_id)) || '');
  const userName = String((p && (p.userName ?? p.user_name ?? p.authorName ?? p.author_name ?? p.name ?? p.nombre ?? p.username)) || 'Usuario');
  const userAvatarUrl = String((p && (p.userAvatarUrl ?? p.user_avatar ?? p.author_avatar ?? p.authorAvatar ?? p.avatarUrl ?? p.avatar)) || '');

  const text = String((p && (p.text ?? p.content ?? p.message)) || '');
  const createdAt = (p && (p.createdAt ?? p.created_at ?? p.date ?? p.ts)) || new Date().toISOString();

  const liked = !!(p && (p.liked ?? p.isLiked ?? p.is_liked));
  const likes = Number((p && (p.likes ?? p.likes_count ?? p.likesCount)) || 0) || 0;

  const tags = parseTagsFromRow(p);

  return { id, userId, userName, userAvatarUrl, text, createdAt, tags, liked, likes };
}

async function loadProfilePostsFromServer(){
  const uid = encodeURIComponent(String(uId || viewerId || ''));
  const j = await getJSON('/app/perfil/api/posts/' + uid);
  if (!j || !j.ok) throw new Error((j && j.error) || 'No se pudieron cargar los posts');
  profilePosts = Array.isArray(j.posts) ? j.posts.map(normalizePost) : [];
  profileLoaded = true;
}

async function loadFeedPostsFromServer(){
  const j = await getJSON('/app/perfil/api/feed');
  if (!j || !j.ok) throw new Error((j && j.error) || 'No se pudo cargar el feed');
  feedPosts = Array.isArray(j.posts) ? j.posts.map(normalizePost) : [];
  feedLoaded = true;
}

async function ensureProfilePostsLoaded(){
  if (profileLoaded) return;
  try{
    await loadProfilePostsFromServer();
  }catch(e){
    console.error('profile posts load failed:', e);
    profilePosts = Array.isArray(SERVER_PROFILE_POSTS) ? SERVER_PROFILE_POSTS.map(normalizePost) : [];
    profileLoaded = true;
  }
}

async function ensureFeedPostsLoaded(){
  if (feedLoaded) return;
  try{
    await loadFeedPostsFromServer();
  }catch(e){
    console.error('feed load failed:', e);
    feedPosts = Array.isArray(SERVER_FEED_POSTS) ? SERVER_FEED_POSTS.map(normalizePost) : [];
    feedLoaded = true;
  }
}

