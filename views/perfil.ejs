    font-weight:900;
    color:#0f172a;
  }
  .pf-studyMethodName{
    font-size:16px;
    font-weight:900;
    color:#0f172a;
    line-height:1.1;
  }
  .pf-studyMethodMeta{
    margin-top:6px;
    font-size:11px;
    font-weight:900;
    letter-spacing:.10em;
    text-transform:uppercase;
    color:rgba(15,23,42,.48);
  }
  .pf-studyMethodText{
    margin-top:8px;
    font-size:13px;
    line-height:1.6;
    color:rgba(15,23,42,.72);
  }
  .pf-studyTodayList{
    display:grid;
    gap:8px;
  }
  .pf-studyTodayItem{
    padding:10px 12px;
    border-radius:14px;
    background:rgba(15,23,42,.05);
    color:#0f172a;
    font-size:12px;
    line-height:1.45;
    font-weight:800;
  }
  .pf-studyTodayItem.is-break{
    background:rgba(248,193,96,.18);
    color:#7c5a13;
  }
  .pf-studyEmpty{
    color:rgba(15,23,42,.52);
    font-size:13px;
    line-height:1.55;
    font-weight:800;
  }
  .pf-studyEmpty.is-tight{ padding:0; }

  .pf-studyWeek{
    display:grid;
    grid-template-columns:56px repeat(7, 1fr);
    gap:6px;
    overflow:auto;
  }
  .pf-studyWeekCorner,
  .pf-studyWeekHead,
  .pf-studyWeekHour,
  .pf-studyWeekCell{
    min-width:28px;
    min-height:24px;
    border-radius:12px;
  }
  .pf-studyWeekCorner,
  .pf-studyWeekHead,
  .pf-studyWeekHour{
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(255,255,255,.72);
    border:1px solid rgba(15,23,42,.08);
    color:#0f172a;
    font-size:10px;
    font-weight:900;
  }
  .pf-studyWeekCell{
    background:rgba(255,255,255,.50);
    border:1px solid rgba(15,23,42,.08);
  }
  .pf-studyWeekCell.is-on{
    background:#F8C160;
    border-color:rgba(248,193,96,.32);
  }

  html.cw-dark .pf-studyWidget,
  html.cw-dark .pf-studyBlock,
  html.cw-dark .pf-studyMiniBtn,
  html.cw-dark .pf-studyActionBtn,
  html.cw-dark .pf-studyWeekCorner,
  html.cw-dark .pf-studyWeekHead,
  html.cw-dark .pf-studyWeekHour,
  html.cw-dark .pf-studyWeekCell{
    background:rgba(15,23,42,.74) !important;
    border-color:rgba(255,255,255,.08) !important;
  }
  html.cw-dark .pf-studyWidgetTitle,
  html.cw-dark .pf-studyBlockTitle,
  html.cw-dark .pf-studyMethodName,
  html.cw-dark .pf-studyTodayItem,
  html.cw-dark .pf-studyWeekCorner,
  html.cw-dark .pf-studyWeekHead,
  html.cw-dark .pf-studyWeekHour{
    color:rgba(243,244,246,.96) !important;
  }
  html.cw-dark .pf-studyMethodMeta,
  html.cw-dark .pf-studyMethodText,
  html.cw-dark .pf-studyEmpty,
  html.cw-dark .pf-studyWidgetEyebrow{
    color:rgba(148,163,184,.88) !important;
  }
  html.cw-dark .pf-studyMiniBtn,
  html.cw-dark .pf-studyActionBtn{
    color:rgba(243,244,246,.96) !important;
  }
  html.cw-dark .pf-studyActionBtn.is-primary,
  html.cw-dark .pf-studyMiniBtn.is-primary,
  html.cw-dark .pf-studyWeekCell.is-on,
  html.cw-dark .pf-studyQuickBtn{
    background:#F8C160 !important;
    color:#000 !important;
  }
  html.cw-dark .pf-studyTodayItem.is-break,
  html.cw-dark .pf-studyCallout{
    background:rgba(248,193,96,.16) !important;
    color:#f8c160 !important;
    border-color:rgba(248,193,96,.18) !important;
  }

/* =====================================================================
   MOBILE — Scroll lateral en grillas + MindHacks completo
   Aplica desde 820px hacia abajo (cubre todos los celulares)
   ===================================================================== */
@media (max-width: 820px) {

  /* ══════════════════════════════════════════════════
     BLOQUEAR overflow en toda la cadena contenedora
     para que MindHacks no ensanche la pantalla
  ══════════════════════════════════════════════════ */
  #pfViewStudy,
  .pf-studyPanel,
  .pf-studyAvailCard,
  .pf-studyWeekCard,
  .pf-studyResultWrap {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    overflow: hidden !important;
  }

  /* Solo el scroll wrapper puede desbordarse en X */
  #pfViewStudy .pf-studyGridScroll {
    overflow-x: auto !important;
    overflow-y: hidden !important;
    -webkit-overflow-scrolling: touch !important;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    padding-bottom: 4px !important;
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
  }
  #pfViewStudy .pf-studyGridScroll::-webkit-scrollbar { display: none !important; }

  /* ── La grilla ocupa exactamente el ancho disponible ── */
  #pfViewStudy .pf-studyGrid {
    display: grid !important;
    grid-template-columns: 68px repeat(10, 1fr) !important;
    gap: 3px !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
  }

  /* Celdas: cuadradas y fluidas (aspect-ratio gana a width/height fijos) */
  #pfViewStudy .pf-studyCell,
  #pfViewStudy .pf-studyHourHead,
  #pfViewStudy .pf-studyHourHead.is-blank,
  #pfViewStudy .pf-studySpacer {
    width: 100% !important;
    min-width: 0 !important;
    height: auto !important;
    min-height: 0 !important;
    aspect-ratio: 1 / 1 !important;
    font-size: 8px !important;
    border-radius: 6px !important;
    padding: 0 !important;
  }
  #pfViewStudy .pf-studyCell {
    touch-action: none !important;
    cursor: pointer !important;
  }
  #pfViewStudy .pf-studyGridCorner {
    height: auto !important;
    min-height: 0 !important;
    font-size: 8px !important;
    padding: 0 !important;
  }
  #pfViewStudy .pf-studyRowHead {
    width: 68px !important;
    min-width: 68px !important;
    height: auto !important;
    min-height: 0 !important;
    gap: 4px !important;
    padding: 0 !important;
  }
  #pfViewStudy .pf-studyRowName {
    font-size: 8px !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    max-width: 44px !important;
  }
  #pfViewStudy .pf-studyRowCheck {
    width: 12px !important;
    height: 12px !important;
    flex-shrink: 0 !important;
  }

  /* ── Panel principal ── */
  #pfViewStudy { padding: 0 !important; overflow: hidden !important; }
  #pfViewStudy .pf-studyPanel { border-radius: 22px !important; padding: 14px 12px 18px !important; overflow: hidden !important; }

  /* ── Cabecera ── */
  #pfViewStudy .pf-studyHead   { flex-direction: column !important; align-items: flex-start !important; gap: 6px !important; margin-bottom: 8px !important; }
  #pfViewStudy .pf-studyTitle  { font-size: 18px !important; line-height: 1.15 !important; }
  #pfViewStudy .pf-studySub    { font-size: 11px !important; line-height: 1.5 !important; max-width: none !important; }

  /* ── Preguntas ── */
  #pfViewStudy .pf-studyQuestionLayout { grid-template-columns: 1fr !important; gap: 12px !important; }
  #pfViewStudy .pf-studyQuestionCard   { border-radius: 16px !important; padding: 12px !important; }
  #pfViewStudy .pf-studyQuestionText   { font-size: 13px !important; line-height: 1.5 !important; }
  #pfViewStudy .pf-studyOptions        { gap: 7px !important; }
  #pfViewStudy .pf-studyOption         { font-size: 12px !important; padding: 10px 12px !important; border-radius: 12px !important; min-height: 42px !important; }
  #pfViewStudy .pf-studyQNav           { display: none !important; }

  /* ── Navegación pasos ── */
  #pfViewStudy .pf-studyNavRow { flex-direction: column !important; gap: 8px !important; margin-top: 12px !important; }
  #pfViewStudy .pf-studyBtns   { width: 100% !important; }
  #pfViewStudy .pf-studyBtn    { width: 100% !important; min-height: 44px !important; font-size: 13px !important; border-radius: 13px !important; justify-content: center !important; }

  /* ── Disponibilidad ── */
  #pfViewStudy .pf-studyAvailHead  { flex-direction: column !important; align-items: flex-start !important; gap: 4px !important; margin-bottom: 8px !important; }
  #pfViewStudy .pf-studyAvailTitle { font-size: 15px !important; }
  #pfViewStudy .pf-studyAvailSub   { font-size: 10px !important; max-width: none !important; }
  #pfViewStudy .pf-studyWindowRow  { margin-bottom: 8px !important; }
  #pfViewStudy .pf-studyWindowPill { font-size: 11px !important; padding: 0 10px !important; }
  #pfViewStudy .pf-studyWindowArrow { width: 32px !important; height: 32px !important; font-size: 15px !important; }

  /* ── Resultado ── */
  #pfViewStudy .pf-studyResultWrap { grid-template-columns: 1fr !important; gap: 14px !important; }
  #pfViewStudy .pf-studyWeekCard   { grid-column: 1 / -1 !important; }
  #pfViewStudy .pf-studyCardTitle  { font-size: 14px !important; margin-bottom: 8px !important; }
  #pfViewStudy .pf-studyWeekActions { flex-direction: column !important; gap: 8px !important; margin-top: 12px !important; }
  #pfViewStudy .pf-studyWeekActions .pf-studyBtn { width: 100% !important; }
  #pfViewStudy .pf-studyBottomRow  { grid-template-columns: 1fr !important; gap: 8px !important; }
  #pfViewStudy .pf-studyResultDividerV { display: none !important; }
  #pfViewStudy .pf-studyNextCard,
  #pfViewStudy .pf-studyMethodCard { border-radius: 12px !important; padding: 10px !important; background: rgba(255,255,255,.70) !important; border: 1px solid rgba(255,255,255,.50) !important; }
  #pfViewStudy .pf-studyNextLabel  { font-size: 9px !important; text-transform: uppercase !important; letter-spacing: .08em !important; color: rgba(15,23,42,.52) !important; font-weight: 900 !important; }
  #pfViewStudy .pf-studyNextValue  { font-size: 13px !important; font-weight: 900 !important; margin-top: 3px !important; line-height: 1.3 !important; }

  html.cw-dark #pfViewStudy .pf-studyNextCard,
  html.cw-dark #pfViewStudy .pf-studyMethodCard { background: rgba(255,255,255,.07) !important; border-color: rgba(255,255,255,.10) !important; }
}

/* ── iPhone SE y pantallas ≤ 390px ── */
@media (max-width: 390px) {
  #pfViewStudy .pf-studyPanel  { padding: 10px 10px 14px !important; border-radius: 18px !important; }
  #pfViewStudy .pf-studyTitle  { font-size: 16px !important; }
  #pfViewStudy .pf-studyGrid   { grid-template-columns: 60px repeat(10, 1fr) !important; }
  #pfViewStudy .pf-studyRowHead { width: 60px !important; min-width: 60px !important; }
  #pfViewStudy .pf-studyRowName { max-width: 38px !important; }
  #pfViewStudy .pf-studyOption { font-size: 11px !important; padding: 9px 10px !important; }
}

/* ===== Mis Intereses ===== */
#pfViewAffinity .pf-affinityPanel{
  padding: 10px 2px;
}

/* =====================================================
   AFFINITY — Rediseño completo iOS minimalista v2
   ===================================================== */

/* Panel container transparente */
#pfViewAffinity .pf-affinityPanelCard{
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 0;
}

#pfViewAffinity .pf-affinityPanelCard.is-result{
  background: transparent;
  border: none;
  box-shadow: none;
}

/* Scroll container */
#pfViewAffinity{
  height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding-bottom: 12px;
  box-sizing: border-box;
}
#pfViewAffinity::-webkit-scrollbar{ width:0; height:0; }

/* Empty / error states */
#pfViewAffinity .pf-affinityEmpty,
#pfViewAffinity .pf-affinityError{
  padding: 18px 4px;
  color: rgba(15,23,42,.52);
  font-weight: 800;
  font-size: 13px;
}

#pfViewAffinity .pf-affinityEmptyState{
  padding: 30px 6px;
  text-align: center;
  color: rgba(15,23,42,.38);
  font-weight: 800;
  font-size: 12px;
}

/* ---- Stepper minimalista: solo puntos + texto, SIN recuadros ni línea divisoria ---- */
#pfViewAffinity .pf-affinityStepper{
  display: flex;
  align-items: center;
  gap: 0;
  margin-bottom: 22px;
}

#pfViewAffinity .pf-affinityStep{
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  position: relative;
  background: transparent;
  border: none;
  padding: 0;
  min-height: 0;
}

/* línea conectora entre pasos */
#pfViewAffinity .pf-affinityStep:not(:last-child)::after{
  content: "";
  position: absolute;
  right: -50%;
  top: 11px;
  width: 100%;
  height: 1px;
  background: rgba(15,23,42,.10);
  z-index: 0;
}
#pfViewAffinity .pf-affinityStep.is-done:not(:last-child)::after{
  background: #F8C160;
}

#pfViewAffinity .pf-affinityStepBall{
  width: 22px;
  height: 22px;
  border-radius: 9999px;
  border: 1.5px solid rgba(15,23,42,.14);
  background: transparent;
  display: grid;
  place-items: center;
  font-size: 10px;
  font-weight: 900;
  color: rgba(15,23,42,.40);
  position: relative;
  z-index: 1;
  transition: .15s ease;
}
#pfViewAffinity .pf-affinityStep.is-active .pf-affinityStepBall{
  background: #0f172a;
  border-color: #0f172a;
  color: #fff;
}
#pfViewAffinity .pf-affinityStep.is-done .pf-affinityStepBall{
  background: #F8C160;
  border-color: #F8C160;
  color: #0f172a;
}
#pfViewAffinity .pf-affinityStepText{
  font-size: 9.5px;
  font-weight: 800;
  color: rgba(15,23,42,.35);
  text-align: center;
  white-space: nowrap;
}
#pfViewAffinity .pf-affinityStep.is-active .pf-affinityStepText{
  color: rgba(15,23,42,.80);
  font-weight: 950;
}
#pfViewAffinity .pf-affinityStep.is-done .pf-affinityStepText{
  color: rgba(15,23,42,.50);
}

/* ---- Head ---- */
#pfViewAffinity .pf-affinityHead,
#pfViewAffinity .pf-affinityResultTop{
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
}

#pfViewAffinity .pf-affinityTitle{
  font-size: 15px;
  font-weight: 950;
  color: #0f172a;
  letter-spacing: -.02em;
  line-height: 1.2;
  margin-bottom: 3px;
}
#pfViewAffinity .pf-affinitySub{
  font-size: 11px;
  font-weight: 800;
  color: rgba(15,23,42,.45);
  line-height: 1.45;
}

#pfViewAffinity .pf-affinityCounter{
  font-size: 11px;
  font-weight: 900;
  color: rgba(15,23,42,.55);
  white-space: nowrap;
  padding: 4px 10px;
  border-radius: 9999px;
  background: rgba(15,23,42,.05);
  border: 1px solid rgba(15,23,42,.08);
  flex: 0 0 auto;
}

/* ---- Toolbar: tabs de año + buscador iOS en la misma fila ---- */
#pfViewAffinity .pf-affinityToolbar{
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 14px;
  flex-wrap: nowrap;
}

/* Tabs de año — iOS pill compacta */
#pfViewAffinity .pf-affinityYearTabs{
  display: flex;
  gap: 4px;
  flex: 0 0 auto;
  flex-wrap: nowrap;
}
#pfViewAffinity .pf-affinityYearTab{
  width: 32px;
  height: 32px;
  min-width: 32px;
  padding: 0;
  border-radius: 9999px;
  border: none;
  background: rgba(15,23,42,.06);
  color: rgba(15,23,42,.50);
  font-size: 12px;
  font-weight: 900;
  cursor: pointer;
  transition: .12s ease;
  -webkit-tap-highlight-color: transparent;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  outline: none;
  box-shadow: none;
}
#pfViewAffinity .pf-affinityYearTab:hover{
  background: rgba(15,23,42,.10);
  color: rgba(15,23,42,.75);
  border: none;
}
#pfViewAffinity .pf-affinityYearTab.is-active{
  background: #F8C160;
  border: none;
  color: #fff;
}

/* Buscador iOS estilo UISearchBar */
#pfViewAffinity .pf-affinitySearchWrap{
  flex: 0 0 auto;
  width: 33%;
  min-width: 0;
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 7px;
  height: 32px;
  border-radius: 9999px;
  background: rgba(15,23,42,.06);
  border: none;
  padding: 0 12px;
  box-shadow: none;
}
#pfViewAffinity .pf-affinitySearchWrap.is-result{
  /* en resultados: alineado izquierda, mismo estilo */
  flex: 0 1 260px;
  min-width: 0;
  margin-left: 0;
}
#pfViewAffinity .pf-affinitySearchIcon{
  width: 13px;
  height: 13px;
  flex: 0 0 auto;
  color: rgba(15,23,42,.38);
  position: static;
  transform: none;
}
#pfViewAffinity .pf-affinitySearchInput{
  flex: 1 1 auto;
  min-width: 0;
  border: none;
  outline: none;
  background: transparent;
  font-size: 12px;
  font-weight: 800;
  color: #0f172a;
  height: 100%;
  padding: 0;
}
#pfViewAffinity .pf-affinitySearchInput::placeholder{
  color: rgba(15,23,42,.36);
}
#pfViewAffinity .pf-affinityToolbarInfo{
  font-size: 11px;
  font-weight: 800;
  color: rgba(15,23,42,.38);
  white-space: nowrap;
  flex: 0 0 auto;
  padding: 0;
  background: none;
  border: none;
}

/* ---- Subject cards (paso 1) ---- */
#pfViewAffinity .pf-affinitySubjectsDeck{
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 7px;
  margin-bottom: 4px;
}
#pfViewAffinity .pf-affinitySubjectCard{
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  padding: 10px 10px;
  border-radius: 12px;
  background: transparent;
  border: none;
  cursor: pointer;
  transition: .12s ease;
  -webkit-tap-highlight-color: transparent;
}
#pfViewAffinity .pf-affinitySubjectCard:hover{
  background: rgba(15,23,42,.04);
  border: none;
}
#pfViewAffinity .pf-affinitySubjectCard.is-selected{
  background: rgba(248,193,96,.14);
  border: none;
}
#pfViewAffinity .pf-affinitySubjectMain{
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}
#pfViewAffinity .pf-affinitySubjectName{
  font-size: 12px;
  line-height: 1.3;
  font-weight: 900;
  color: rgba(15,23,42,.86);
}
#pfViewAffinity .pf-affinitySubjectMeta{
  font-size: 10px;
  font-weight: 800;
  color: rgba(15,23,42,.40);
}
#pfViewAffinity .pf-affinitySubjectTick{
  width: 17px;
  height: 17px;
  min-width: 17px;
  border-radius: 5px;
  border: 1.5px solid rgba(15,23,42,.12);
  background: transparent;
  display: grid;
  place-items: center;
  font-size: 9px;
  font-weight: 900;
  color: transparent;
  flex: 0 0 auto;
}
#pfViewAffinity .pf-affinitySubjectCard.is-selected .pf-affinitySubjectTick{
  background: #F8C160;
  border-color: #F8C160;
  color: #0f172a;
}

/* ---- Lista de cursada actual (paso 2) — scroll con max 5 items visibles ---- */
#pfViewAffinity .pf-affinityCurrentList{
  display: flex;
  flex-direction: column;
  gap: 0;
  /* 5 items × ~44px + separadores de año */
  max-height: 260px;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
  border: 1px solid rgba(15,23,42,.08);
  border-radius: 16px;
  margin-bottom: 4px;
}
#pfViewAffinity .pf-affinityCurrentList::-webkit-scrollbar{ width:0; height:0; }

#pfViewAffinity .pf-affinityCurrentYearLabel{
  font-size: 10px;
  font-weight: 950;
  color: rgba(15,23,42,.38);
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 10px 14px 4px;
  background: transparent;
}

#pfViewAffinity .pf-affinityCurrentItem{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 11px 14px;
  border-top: 1px solid rgba(15,23,42,.06);
  background: transparent;
  cursor: pointer;
  transition: background .10s ease;
  -webkit-tap-highlight-color: transparent;
}
#pfViewAffinity .pf-affinityCurrentItem:first-child{
  border-top: none;
}
#pfViewAffinity .pf-affinityCurrentYearLabel + .pf-affinityCurrentItem{
  border-top: none;
}
#pfViewAffinity .pf-affinityCurrentItem:hover{
  background: rgba(15,23,42,.03);
}
#pfViewAffinity .pf-affinityCurrentItem.is-selected{
  background: rgba(248,193,96,.10);
}
#pfViewAffinity .pf-affinityCurrentItemLeft{
  display: flex;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
}
#pfViewAffinity .pf-affinityCurrentItemName{
  font-size: 13px;
  font-weight: 900;
  color: #0f172a;
}
#pfViewAffinity .pf-affinityCurrentItemMeta{
  font-size: 10px;
  font-weight: 800;
  color: rgba(15,23,42,.40);
}
#pfViewAffinity .pf-affinityCurrentItemCheck{
  width: 20px;
  height: 20px;
  min-width: 20px;
  border-radius: 9999px;
  border: 1.5px solid rgba(15,23,42,.14);
  background: transparent;
  display: grid;
  place-items: center;
  font-size: 10px;
  color: transparent;
  flex: 0 0 auto;
  transition: .12s ease;
}
#pfViewAffinity .pf-affinityCurrentItem.is-selected .pf-affinityCurrentItemCheck{
  background: #F8C160;
  border-color: #F8C160;
  color: #0f172a;
  font-weight: 900;
}

/* ---- Barra de progreso agua (paso 3) ---- */
#pfViewAffinity .pf-affinityProgressWrap{
  width: 100%;
  height: 7px;
  border-radius: 9999px;
  background: rgba(15,23,42,.07);
  overflow: hidden;
  margin-bottom: 14px;
  position: relative;
}
#pfViewAffinity .pf-affinityProgressFill{
  height: 100%;
  border-radius: 9999px;
  background: linear-gradient(90deg, #F8C160 0%, #f9d08a 40%, #F8C160 70%, #f5b840 100%);
  background-size: 200% 100%;
  animation: pf-water-fill 2s ease-in-out infinite;
  transition: width .4s cubic-bezier(.4,0,.2,1);
  position: relative;
  min-width: 0%;
}
@keyframes pf-water-fill{
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ---- Preguntas (paso 3) — 2 por página, una debajo de la otra, altura auto ---- */
#pfViewAffinity .pf-affinityQuestions{
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 4px;
}

#pfViewAffinity .pf-affinityQuestionCard{
  padding: 14px;
  border-radius: 16px;
  border: 1px solid rgba(15,23,42,.08);
  background: transparent;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

#pfViewAffinity .pf-affinityQuestionTop{
  display: flex;
  align-items: baseline;
  gap: 8px;
}
#pfViewAffinity .pf-affinityQuestionIndex{
  font-size: 9px;
  font-weight: 950;
  color: rgba(15,23,42,.28);
  letter-spacing: .10em;
  text-transform: uppercase;
  white-space: nowrap;
  flex: 0 0 auto;
}
#pfViewAffinity .pf-affinityQuestionLabel{
  font-size: 9px;
  font-weight: 900;
  color: rgba(15,23,42,.36);
  text-transform: uppercase;
  letter-spacing: .06em;
}
#pfViewAffinity .pf-affinityQuestionMode{ display: none; }

#pfViewAffinity .pf-affinityQuestionText{
  font-size: 13px;
  font-weight: 950;
  color: #0f172a;
  line-height: 1.35;
}
#pfViewAffinity .pf-affinityQuestionHint{
  font-size: 10px;
  font-weight: 800;
  color: rgba(15,23,42,.34);
  margin-top: -4px;
}

#pfViewAffinity .pf-affinityOptions{
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  align-items: flex-start;
}

/* Botones de respuesta — pills compactas con tooltip al hover */
#pfViewAffinity .pf-affinityOption{
  height: 26px;
  padding: 0 10px;
  border-radius: 9999px;
  border: none;
  background: rgba(15,23,42,.07);
  color: rgba(15,23,42,.65);
  font-size: 11px;
  font-weight: 800;
  cursor: pointer;
  transition: background .10s ease, color .10s ease;
  -webkit-tap-highlight-color: transparent;
  white-space: nowrap;
  width: 110px;
  max-width: 110px;
  min-width: 110px;
  overflow: hidden;
  text-overflow: ellipsis;
  outline: none;
  box-shadow: none;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
}
#pfViewAffinity .pf-affinityOption:hover{
  background: rgba(15,23,42,.11);
  color: rgba(15,23,42,.85);
  border: none;
}
#pfViewAffinity .pf-affinityOption.is-selected{
  background: #F8C160;
  border: none;
  color: #fff;
  font-weight: 900;
}
#pfViewAffinity .pf-affinityOption.is-selected:hover{
  background: #f5b840;
}

/* Tooltip global para opciones largas */
#pf-option-tooltip{
  position: fixed;
  z-index: 99999;
  pointer-events: none;
  background: #0f172a;
  color: #fff;
  font-size: 11px;
  font-weight: 800;
  padding: 5px 11px;
  border-radius: 9999px;
  white-space: nowrap;
  opacity: 0;
  transition: opacity .12s ease;
  max-width: 300px;
  overflow: hidden;
  text-overflow: ellipsis;
  box-shadow: 0 4px 12px rgba(0,0,0,.18);
}

/* Pager */
#pfViewAffinity .pf-affinityQuestionPager{
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin: 8px 0 0;
  font-size: 11px;
  font-weight: 900;
  color: rgba(15,23,42,.38);
}

/* ---- Footer ---- */
#pfViewAffinity .pf-affinityFooter{
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid rgba(15,23,42,.07);
}

/* ---- Buttons ---- */
#pfViewAffinity .pf-affinityBtn{
  height: 34px;
  padding: 0 16px;
  border-radius: 10px;
  border: 1px solid rgba(15,23,42,.12);
  background: transparent;
  color: rgba(15,23,42,.65);
  font-size: 12px;
  font-weight: 900;
  cursor: pointer;
  transition: .12s ease;
  -webkit-tap-highlight-color: transparent;
}
#pfViewAffinity .pf-affinityBtn:active{ transform: translateY(1px) scale(.99); }
#pfViewAffinity .pf-affinityBtn.is-primary{
  background: #0f172a;
  border-color: #0f172a;
  color: #fff;
}
#pfViewAffinity .pf-affinityBtn:disabled{ opacity:.55; cursor:default; }

/* ---- RESULTADOS — Encontrá tu grupo ---- */

/* Botón "Rehacer" — transparente sin borde */
#pfViewAffinity .pf-affinityRehacerBtn{
  background: transparent;
  border: none;
  box-shadow: none;
  color: rgba(15,23,42,.50);
  font-size: 13px;
  font-weight: 900;
  cursor: pointer;
  padding: 0 4px;
  height: auto;
  flex: 0 0 auto;
  -webkit-tap-highlight-color: transparent;
  transition: color .12s ease;
}
#pfViewAffinity .pf-affinityRehacerBtn:hover{ color: rgba(15,23,42,.85); }

/* Header resultados */
#pfViewAffinity .pf-affinityResultTop{
  align-items: center;
  margin-bottom: 14px;
}

/* Toolbar resultados: buscador a la izquierda */
#pfViewAffinity .pf-affinityResultToolbar{
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 16px;
}

/* Lista de usuarios */
#pfViewAffinity .pf-affinityUsersGrid{
  display: flex;
  flex-direction: column;
  gap: 3px;
}

#pfViewAffinity .pf-affinityUserCard{
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 4px;
  border-radius: 0;
  background: transparent;
  border: none;
  border-bottom: 1px solid rgba(15,23,42,.06);
  text-decoration: none;
  color: inherit;
  transition: background .10s ease;
  cursor: pointer;
}
#pfViewAffinity .pf-affinityUserCard:last-child{ border-bottom: none; }
#pfViewAffinity .pf-affinityUserCard:hover{ background: rgba(15,23,42,.03); border-radius: 12px; }

#pfViewAffinity .pf-affinityUserAvatar{
  width: 40px; height: 40px;
  min-width: 40px;
  border-radius: 9999px;
  overflow: hidden;
  background: rgba(15,23,42,.06);
  border: 1.5px solid rgba(15,23,42,.08);
  display: grid;
  place-items: center;
  flex: 0 0 auto;
}
#pfViewAffinity .pf-affinityUserAvatarImg{
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  border-radius: 9999px;
}
#pfViewAffinity .pf-affinityUserAvatarFallback{
  width: 100%; height: 100%;
  display: grid;
  place-items: center;
  font-size: 15px;
  font-weight: 950;
  color: rgba(15,23,42,.55);
}

#pfViewAffinity .pf-affinityUserInfo{
  flex: 1 1 auto;
  min-width: 0;
}
#pfViewAffinity .pf-affinityUserName{
  font-size: 13px;
  font-weight: 950;
  color: #0f172a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
#pfViewAffinity .pf-affinityUserCareer{
  font-size: 10.5px;
  font-weight: 800;
  color: rgba(15,23,42,.42);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: 1px;
}

#pfViewAffinity .pf-affinityUserMeta{
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
  flex: 0 0 auto;
}
#pfViewAffinity .pf-affinityMatchBadge{
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: 9999px;
  background: rgba(248,193,96,.18);
  border: 1px solid rgba(248,193,96,.40);
  font-size: 10px;
  font-weight: 950;
  color: rgba(15,23,42,.70);
}
#pfViewAffinity .pf-affinityUserMeta span:not(.pf-affinityMatchBadge){
  font-size: 9.5px;
  font-weight: 800;
  color: rgba(15,23,42,.36);
}

