const postViewModal = $('pfPostViewModal');
const postViewClose = $('pfPostViewClose');
const postViewBody  = $('pfPostViewBody');
const postViewTags  = $('pfPostViewTags');

function closePostViewModal(){
  if (!postViewModal) return;
  postViewModal.classList.remove('is-open');
  postViewModal.setAttribute('aria-hidden', 'true');
  if (postViewBody) postViewBody.innerHTML = '';
  if (postViewTags) postViewTags.innerHTML = '';
}

function openPostViewModal(p){
  if (!postViewModal || !postViewBody) return;

  const pid  = String((p && p.id) || '');
  const name = escapeHtml(String((p && p.userName) || 'Usuario'));
  const ava  = String((p && p.userAvatarUrl) || '').trim();
  const avaStyle = ava ? `style="background-image:url('${escapeHtml(ava)}')"` : '';
  const date = escapeHtml(fmtDate(p && p.createdAt));
  const text = escapeHtml(String((p && p.text) || ''));

  const likes = Number((p && p.likes) || 0) || 0;
  const liked = !!(p && p.liked);

  postViewBody.innerHTML = `
    <div class="pf-postModalMid">
      <div class="pf-postHeader">
        <div class="pf-postModalName">${name}</div>
        <div class="pf-postAvatarTiny" ${avaStyle}></div>
      </div>

      <div class="pf-postModalContent">${text}</div>
    </div>

    <div class="pf-postFooterRow">
      <div class="pf-postDate">${date}</div>
      <div class="pf-likeWrap">
        <button class="pf-reactBtn pf-likeBtn ${liked ? 'is-on' : ''}" type="button" data-id="${escapeHtml(pid)}" aria-label="Like">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.749 2.25 5.437 4.922 3 8.25 3c1.833 0 3.544.802 4.75 2.07C14.206 3.802 15.917 3 17.75 3 21.078 3 23.75 5.437 23.75 8.749c0 3.425-2.438 6.611-4.739 8.758a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.218l-.022.012-.007.003-.003.002a.75.75 0 0 1-.704 0l-.003-.002Z" fill="currentColor"></path>
          </svg>
        </button>
        <div class="pf-likeCount">${likes}</div>
      </div>
    </div>
  `;

  // ✅ Tags fuera del recuadro (máx 2 visibles + scroll)
  if (postViewTags){
    const t = (p && p.tags) ? p.tags : {};
    const sids = Array.isArray(t.subjects) ? t.subjects : [];
    const pids = Array.isArray(t.people) ? t.people : [];

    const chips = [];

    sids.forEach(sid => {
      const s = (SUBJECTS || []).find(x => String(x.id) === String(sid));
      const label = '@' + String(s ? (s.name || sid) : sid);
      if (label !== '@') chips.push(label);
    });

        pids.forEach(uid => {
      const raw = String(uid || '');
      if (!raw) return;

      if (raw.startsWith('prof:')){
        const pid = raw.slice(5);
        const pr = (PROFESSORS || []).find(x => String(x.id) === String(pid));
        const label = '@' + String(pr ? (pr.name || raw) : raw);
        if (label !== '@') chips.push(label);
        return;
      }

      const u = (USERS || []).find(x => String(x.id) === String(raw));
      const label = '@' + String(u ? (u.name || raw) : raw);
      if (label !== '@') chips.push(label);
    });

    postViewTags.innerHTML = chips.map(x => `<div class="pf-postTagChip">${escapeHtml(x)}</div>`).join('');
  }

  // ✅ Like dentro del modal
  const likeBtn = postViewBody.querySelector('.pf-likeBtn');
  const likeCountEl = postViewBody.querySelector('.pf-likeCount');

if (likeBtn){
  // evita que el mismo botón quede con 2 listeners por re-renders o re-binds
  if (likeBtn.dataset.likeBound === '1') {
    // ya está bindeado
  } else {
    likeBtn.dataset.likeBound = '1';

    let _inFlight = false;

    // estado confirmado por servidor
    let _serverLiked = null;
    let _serverLikes = null;

    // estado deseado por el usuario (lo que la UI debe mostrar ya)
    let _desiredLiked = null;

    // id a usar en el request (por si el server devuelve otro)
    let _postIdSrv = String(pid || '');

    const readUI = () => {
      const liked = likeBtn.classList.contains('is-on');
      const likes = Number((likeCountEl && likeCountEl.textContent) || 0) || 0;
      return { liked, likes };
    };

    const shownLikes = () => {
      // si no tenemos confirmado, usamos lo que ya se ve
      if (_serverLiked === null || _serverLikes === null || _desiredLiked === null){
        const cur = readUI();
        return cur.likes;
      }
      // ajuste respecto del último confirmado
      const delta = (_desiredLiked ? 1 : 0) - (_serverLiked ? 1 : 0);
      return Math.max(0, (_serverLikes + delta));
    };

    const applyDesiredUI = () => {
      const likesToShow = shownLikes();

      // UI instantánea
      likeBtn.classList.toggle('is-on', !!_desiredLiked);
      if (likeCountEl) likeCountEl.textContent = String(likesToShow);

      // mantiene coherencia visual en todas las instancias del post
      try{
        patchPostEverywhere(_postIdSrv, { liked: !!_desiredLiked, likes: likesToShow });
      }catch(_e){}
    };

    const syncToServer = async () => {
      if (_inFlight) return;
      _inFlight = true;

      try{
        // guard para evitar loops raros
        let guard = 0;

        while (_serverLiked !== _desiredLiked && guard < 8){
          guard++;

          const j = await postJSON('/app/perfil/api/posts/like-toggle', { id: _postIdSrv });
          if (!j || !j.ok) throw new Error((j && j.error) || 'like failed');

          _postIdSrv = String(j.postId || _postIdSrv);

          _serverLikes = Number(j.likes || 0) || 0;
          _serverLiked = !!j.liked;

          // NO pisamos la UI con el confirmado si el usuario ya cambió de idea;
          // mantenemos la UI en "deseado"
          applyDesiredUI();

          // actualiza memoria con el confirmado (para que los renders usen data real)
          try{
            patchPostEverywhere(_postIdSrv, { liked: _serverLiked, likes: _serverLikes });
          }catch(_e){}
        }

        // Cuando ya está alineado, recién ahí re-render
        if (_serverLiked === _desiredLiked){
          try{
            patchPostEverywhere(_postIdSrv, { liked: _serverLiked, likes: _serverLikes });
          }catch(_e){}

          renderProfilePosts();
          renderFeedPosts();
        }
      }catch(err){
        console.error('like failed:', err);

        // rollback al último confirmado (si existía)
        if (_serverLiked !== null && _serverLikes !== null){
          _desiredLiked = _serverLiked;
          likeBtn.classList.toggle('is-on', !!_serverLiked);
          if (likeCountEl) likeCountEl.textContent = String(_serverLikes);

          try{
            patchPostEverywhere(_postIdSrv, { liked: !!_serverLiked, likes: _serverLikes });
          }catch(_e){}
        }
      }finally{
        _inFlight = false;

        // si durante el vuelo el usuario cambió el deseado, sincronizamos de nuevo
        if (_serverLiked !== _desiredLiked){
          syncToServer();
        }
      }
    };

    likeBtn.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      if (!_postIdSrv) return;

      // inicializa desde lo que se ve (1ra vez)
      if (_serverLiked === null || _serverLikes === null || _desiredLiked === null){
        const cur = readUI();
        _serverLiked = cur.liked;
        _serverLikes = cur.likes;
        _desiredLiked = cur.liked;
      }

      // ✅ cada click cambia el deseado y se ve INMEDIATO
      _desiredLiked = !_desiredLiked;
      applyDesiredUI();

      // ✅ sincroniza, pero sin perder clicks rápidos
      syncToServer();
    });
  }
}

  postViewModal.classList.add('is-open');
  postViewModal.setAttribute('aria-hidden', 'false');
}

if (postViewClose) postViewClose.addEventListener('click', closePostViewModal);
if (postViewModal){
  postViewModal.addEventListener('click', (e) => {
    if (e.target === postViewModal) closePostViewModal();
  });
}
document.addEventListener('keydown', (e) => {
  if (!postViewModal || !postViewModal.classList.contains('is-open')) return;
  if (e.key === 'Escape') closePostViewModal();
});

// =========================
// Like optimista (instantáneo en UI)
// =========================
const likeInFlight = new Set();

function cssEsc(s){
  const str = String(s || '');
  if (window.CSS && typeof CSS.escape === 'function') return CSS.escape(str);
  return str.replace(/["\\]/g, '\\$&');
}

function getPostStateById(pid){
  const id = String(pid || '');
  if (!id) return null;

  const p1 = Array.isArray(profilePosts) ? profilePosts.find(x => String(x.id || '') === id) : null;
  if (p1) return { liked: !!p1.liked, likes: Number(p1.likes || 0) || 0 };

  const p2 = Array.isArray(feedPosts) ? feedPosts.find(x => String(x.id || '') === id) : null;
  if (p2) return { liked: !!p2.liked, likes: Number(p2.likes || 0) || 0 };

  return null;
}

function getDomLikeState(pid){
  const id = String(pid || '');
  if (!id) return null;

  const btn = document.querySelector('.pf-likeBtn[data-id="' + cssEsc(id) + '"]');
  if (!btn) return null;

  const wrap = btn.closest('.pf-likeWrap');
  const c = wrap ? wrap.querySelector('.pf-likeCount') : null;

  const liked = btn.classList.contains('is-on');
  const likes = c ? (Number(String(c.textContent || '').trim()) || 0) : 0;

  return { liked, likes };
}

function setLikeUIForId(pid, liked, likes, pending){
  const id = String(pid || '');
  if (!id) return;

  const sel = '.pf-likeBtn[data-id="' + cssEsc(id) + '"]';

  document.querySelectorAll(sel).forEach(btn => {
    if (typeof pending === 'boolean'){
      btn.disabled = pending;
      btn.classList.toggle('is-pending', pending);
    }

    if (typeof liked === 'boolean'){
      btn.classList.toggle('is-on', liked);
    }

    if (typeof likes === 'number'){
      const wrap = btn.closest('.pf-likeWrap');
      const c = wrap ? wrap.querySelector('.pf-likeCount') : null;
      if (c) c.textContent = String(likes);
    }
  });
}

async function optimisticLikeToggle(postId){
  const pid = String(postId || '');
  if (!pid) return;
  if (likeInFlight.has(pid)) return;

  const prev = getPostStateById(pid) || getDomLikeState(pid) || { liked: false, likes: 0 };
  const prevLiked = !!prev.liked;
  const prevLikes = Number(prev.likes || 0) || 0;

  const nextLiked = !prevLiked;
  const nextLikes = Math.max(0, prevLikes + (nextLiked ? 1 : -1));

  likeInFlight.add(pid);

  // ✅ 1) UI inmediata
  patchPostEverywhere(pid, { liked: nextLiked, likes: nextLikes });
  setLikeUIForId(pid, nextLiked, nextLikes, true);

  try{
    const j = await postJSON('/app/perfil/api/posts/like-toggle', { id: pid });
    if (!j || !j.ok) throw new Error((j && j.error) || 'like failed');

    const finalId = String(j.postId || pid);
    const finalLikes = Number(j.likes || 0) || 0;
    const finalLiked = !!j.liked;

    patchPostEverywhere(finalId, { liked: finalLiked, likes: finalLikes });
    setLikeUIForId(finalId, finalLiked, finalLikes, false);

    // mantiene tu comportamiento actual (re-render) pero recién al confirmar servidor
    renderProfilePosts();
    renderFeedPosts();
  }catch(err){
    console.error('like failed:', err);

    // ✅ rollback si falla
    patchPostEverywhere(pid, { liked: prevLiked, likes: prevLikes });
    setLikeUIForId(pid, prevLiked, prevLikes, false);
  }finally{
    likeInFlight.delete(pid);
  }
}

function patchPostEverywhere(postId, patch){
  const pid = String(postId || '');
  const apply = (arr) => {
    if (!Array.isArray(arr)) return;
    const i = arr.findIndex(x => String(x.id || '') === pid);
    if (i >= 0) arr[i] = Object.assign({}, arr[i], patch);
  };
  apply(profilePosts);
  apply(feedPosts);
}

function removePostEverywhere(postId){
  const pid = String(postId || '');
  profilePosts = Array.isArray(profilePosts) ? profilePosts.filter(x => String(x.id || '') !== pid) : [];
  feedPosts    = Array.isArray(feedPosts)    ? feedPosts.filter(x => String(x.id || '') !== pid) : [];
}

function renderPostsInto(container, list, opts){
  if (!container) return;

  const allowDelete = !!(opts && opts.allowDelete);
  const canDeletePost = !!(allowDelete || (isAdmin && container && container.id === 'pfFeedScroll'));
  const isProfileGrid = (container && (container.id === 'pfPostsScroll' || container.id === 'pfFeedScroll'));
  const arr = Array.isArray(list) ? list.slice() : [];

  arr.sort((a,b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

  if (!arr.length){
    container.innerHTML = `<div class="pf-postEmpty">Todavía no hay posts.</div>`;
    return;
  }

  container.innerHTML = arr.map(p => {
    const id = escapeHtml(String(p.id || ''));
    const name = escapeHtml(String(p.userName || 'Usuario'));
    const ava  = String(p.userAvatarUrl || '').trim();
    const avaStyle = ava ? `style="background-image:url('${escapeHtml(ava)}')"` : '';
    const date = escapeHtml(fmtDate(p.createdAt));
    const text = escapeHtml(String(p.text || ''));
    const likes = Number(p.likes || 0) || 0;
    const liked = !!p.liked;
    const userId = String(p.userId || '');
    const isOwnPost = userId === String('<%= u._id || u.id || "" %>');
    const profileHref = (!isOwnPost && userId) ? `/app/perfil/${userId}` : `/app/perfil`;

    return `
      <article class="pf-postCard ${canDeletePost ? 'has-x' : ''}" data-id="${id}">
        ${canDeletePost ? `<button class="pf-postClose" type="button" data-id="${id}" aria-label="Eliminar">✕</button>` : ``}
        <button class="pf-postMoreBtn" type="button" data-id="${id}">Ver más</button>

          <div class="pf-postMid">
          ${isProfileGrid ? `
            <div class="pf-postCenterBlock">
              <div class="pf-postHeader">
                <a class="pf-postAuthorLink" href="${profileHref}"><div class="pf-postName">${name}</div>
                <div class="pf-postAvatarTiny" ${avaStyle}></div></a>
              </div>

              <div class="pf-postContent">${text}</div>
            </div>
          ` : `
            <div class="pf-postHeader">
              <a class="pf-postAuthorLink" href="${profileHref}"><div class="pf-postName">${name}</div>
              <div class="pf-postAvatarTiny" ${avaStyle}></div></a>
            </div>

            <div class="pf-postContent">${text}</div>
          `}

          <div class="pf-postFooterRow">
            <div class="pf-postDate">${date}</div>
            <div class="pf-likeWrap">
              <button class="pf-reactBtn pf-likeBtn ${liked ? 'is-on' : ''}" type="button" data-id="${id}" aria-label="Like">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                  <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.749 2.25 5.437 4.922 3 8.25 3c1.833 0 3.544.802 4.75 2.07C14.206 3.802 15.917 3 17.75 3 21.078 3 23.75 5.437 23.75 8.749c0 3.425-2.438 6.611-4.739 8.758a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.218l-.022.012-.007.003-.003.002a.75.75 0 0 1-.704 0l-.003-.002Z" fill="currentColor"></path>
                </svg>
              </button>
              <div class="pf-likeCount">${likes}</div>
            </div>
          </div>
        </div>
      </article>
    `;
  }).join('');

  // Ver más (modal)
  container.querySelectorAll('.pf-postMoreBtn').forEach(b => {
    b.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      const id = String(b.getAttribute('data-id') || '');
      const p = arr.find(x => String(x.id || '') === id);
      if (p) openPostViewModal(p);
    });
  });

  // Like
    container.querySelectorAll('.pf-likeBtn').forEach(b => {
    b.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      const id = String(b.getAttribute('data-id') || '');
      if (!id) return;
      optimisticLikeToggle(id);
    });
  });

  // Delete
  if (canDeletePost){
    container.querySelectorAll('.pf-postClose').forEach(b => {
      b.addEventListener('click', async (e) => {
        e.preventDefault(); e.stopPropagation();
        const id = String(b.getAttribute('data-id') || '');
        if (!id) return;

        if (!confirm('¿Eliminar este post?')) return;

        try{
          const j = await postJSON('/app/perfil/api/posts/delete', { id });
          if (!j || !j.ok) throw new Error((j && j.error) || 'delete failed');

          removePostEverywhere(id);
          renderProfilePosts();
          renderFeedPosts();
        }catch(err){
          console.error('delete failed:', err);
          alert('No se pudo eliminar.');
        }
      });
    });
  }
}

async function renderProfilePosts(){
  try{ await ensureProfilePostsLoaded(); }catch(_){}
  renderPostsInto($('pfPostsScroll'), profilePosts, { allowDelete: isOwn, compact: false });
}

  // =========================
  // Feed: buscar / filtrar / ordenar
  // =========================
  const VIEWER_CAREER = <%- JSON.stringify(String(viewer.career || viewer.carrera || '')) %>;
  const VIEWER_PLAN   = <%- JSON.stringify(String(viewer.plan || '')) %>;

  let feedQuery  = '';
  let feedFilter = 'all';   // all | career_* | has_subjects | has_people
  let feedSort   = 'new';   // new | likes | old
  let feedSortTouched = false;

  function tagTextForPost(p){
    const t = (p && p.tags) ? p.tags : {};
    const sids = Array.isArray(t.subjects) ? t.subjects : [];
    const pids = Array.isArray(t.people) ? t.people : [];

    const sn = sids.map(id => {
      const s = (SUBJECTS || []).find(x => String(x.id) === String(id));
      return s ? String(s.name || '') : '';
    }).filter(Boolean);

    const pn = pids.map(id => {
      const raw = String(id || '');
      if (!raw) return '';

      if (raw.startsWith('prof:')){
        const pid = raw.slice(5);
        const pr = (PROFESSORS || []).find(x => String(x.id) === String(pid));
        return pr ? String(pr.name || '') : '';
      }

      const u = (USERS || []).find(x => String(x.id) === String(raw));
      return u ? String(u.name || '') : '';
    }).filter(Boolean);

    return sn.concat(pn).join(' ');
  }

  function careerTextForUserId(uid){
    const id = String(uid || '');
    if (id && String(viewerId || '') === id){
      return buildCareer(VIEWER_CAREER, VIEWER_PLAN);
    }
    const u = (USERS || []).find(x => String(x.id || '') === id);
    if (u) return buildCareer(u.career, u.plan);
    return '';
  }

  function careerKeyFromText(ctext){
    const n = norm(ctext);
    if (n.includes('admin')) return 'career_admin';
    if (n.includes('contab')) return 'career_conta';
    if (n.includes('econo')) return 'career_econo';
    return '';
  }

  function postMatchesQuery(p, q){
    const nq = norm(q);
    if (!nq) return true;

    if (norm(p.text).includes(nq)) return true;
    if (norm(p.userName).includes(nq)) return true;

    const tg = norm(tagTextForPost(p));
    if (tg && tg.includes(nq)) return true;

    return false;
  }

  function getFilteredFeedList(baseList){
    let arr = Array.isArray(baseList) ? baseList.slice() : [];

    arr = arr.filter(p => postMatchesQuery(p, feedQuery));

    if (feedFilter === 'has_subjects'){
      arr = arr.filter(p => (p.tags && Array.isArray(p.tags.subjects) && p.tags.subjects.length));
    }else if (feedFilter === 'has_people'){
      arr = arr.filter(p => (p.tags && Array.isArray(p.tags.people) && p.tags.people.length));
    }else if (feedFilter.startsWith('career_')){
      arr = arr.filter(p => {
        const key = careerKeyFromText(careerTextForUserId(p.userId));
        return key === feedFilter;
      });
    }

    if (feedSort === 'old'){
      arr.sort((a,b) => new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime());
        }else if (feedSort === 'likes'){
          arr.sort((a,b) => {
            const bl = (Number(b.likes || 0) || 0) || likeCount(b.id);
            const al = (Number(a.likes || 0) || 0) || likeCount(a.id);
            const d = bl - al;
            if (d !== 0) return d;
            return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
          });
    }else{
      // new
      arr.sort((a,b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
    }

    return arr;
  }

  async function renderFeedPosts(){
    try{ await ensureFeedPostsLoaded(); }catch(_){}
    const baseList = (feedPosts && feedPosts.length) ? feedPosts : profilePosts;
    const list = getFilteredFeedList(baseList);
    renderPostsInto($('pfFeedScroll'), list, { allowDelete: !!isAdmin, compact: true });
  }

  // ===== Toolbar (Feed) =====
  const feedInput = $('pfFeedSearchInput');
  const feedFilterBtn = $('pfFeedFilterBtn');
  const feedFilterMenu = $('pfFeedFilterMenu');
  const feedSortBtn = $('pfFeedSortBtn');
  const feedSortMenu = $('pfFeedSortMenu');

  function closeFeedMenus(){
    if (feedFilterMenu) feedFilterMenu.style.display = 'none';
    if (feedSortMenu) feedSortMenu.style.display = 'none';
    if (feedFilterBtn) feedFilterBtn.setAttribute('aria-expanded','false');
    if (feedSortBtn) feedSortBtn.setAttribute('aria-expanded','false');
  }

  function openMenu(which){
    closeFeedMenus();
    if (which === 'filter' && feedFilterMenu && feedFilterBtn){
      feedFilterMenu.style.display = 'block';
      feedFilterBtn.setAttribute('aria-expanded','true');
    }
    if (which === 'sort' && feedSortMenu && feedSortBtn){
      feedSortMenu.style.display = 'block';
      feedSortBtn.setAttribute('aria-expanded','true');
    }
  }

  function setSelected(menuEl, val){
    if (!menuEl) return;
    menuEl.querySelectorAll('.pf-feedOpt').forEach(b => {
      b.classList.toggle('is-on', String(b.getAttribute('data-val') || '') === String(val || ''));
    });
  }

    function pfTrunc4(s){
    const t = String(s || '').trim();
    if (!t) return '';
    return t.slice(0, 4) + '...';
  }

  function pfTrunc9NoMas(s){
    const t0 = String(s || '').trim();
    const t1 = t0.replace(/^más\s+/i, '').trim();
    if (!t1) return '';
    return (t1.length <= 9) ? t1 : (t1.slice(0, 9) + '...');
  }

  function updateFilterBtnLabel(){
    if (!feedFilterBtn) return;
    const map = {
      all: 'Filtros',
      career_admin: 'Usuarios: Admin. de empresas',
      career_conta: 'Usuarios: Contabilidad',
      career_econo: 'Usuarios: Lic. en Econo.',
      has_subjects: 'Hable de materias (cuando @)',
      has_people: 'Hable de profesores (cuando @)'
    };

    const full = map[feedFilter] || 'Filtros';
    const lbl = (feedFilter === 'all') ? 'Filtros' : pfTrunc4(full);
    feedFilterBtn.childNodes[0].nodeValue = lbl + ' ';
  }

  function updateSortBtnLabel(){
    if (!feedSortBtn) return;
