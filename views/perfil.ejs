let __pfAgendaCreateOpening = false;
function __pfAgendaForceOpenCreate(day){
  const targetDay = String(day || pfAgendaOpenDay || '').trim();
  if (!targetDay || __pfAgendaCreateOpening) return;
  __pfAgendaCreateOpening = true;

  try{ pfAgendaCloseItemModal(); }catch(_){ }
  try{ pfAgendaCloseViewModal(); }catch(_){ }
  try{ document.documentElement.classList.remove('pf-lock'); }catch(_){ }
  try{ document.body.classList.remove('pf-lock'); }catch(_){ }

  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      try{ pfAgendaOpenCreateModalForDay(targetDay); }catch(_){ }
      if (pfAgendaModalEl){
        pfAgendaModalEl.classList.add('is-open');
        pfAgendaModalEl.setAttribute('aria-hidden', 'false');
      }
      setTimeout(() => { __pfAgendaCreateOpening = false; }, 260);
    });
  });
}

function __pfAgendaBindCreateTrigger(el, getDay){
  if (!el || el.dataset.pfCreatePatched === '1') return;
  el.dataset.pfCreatePatched = '1';

  const handler = (e) => {
    if (e){
      e.preventDefault();
      e.stopPropagation();
    }
    let day = '';
    try{ day = String((typeof getDay === 'function' ? getDay() : '') || ''); }catch(_){ day = ''; }
    __pfAgendaForceOpenCreate(day);
  };

  el.addEventListener('touchend', handler, { passive:false });
  el.addEventListener('pointerup', handler);
}

__pfAgendaBindCreateTrigger(typeof pfAgendaViewCreateEl !== 'undefined' ? pfAgendaViewCreateEl : null, () => String(pfAgendaOpenDay || ''));
__pfAgendaBindCreateTrigger(typeof pfAgendaItemCreateEl !== 'undefined' ? pfAgendaItemCreateEl : null, () => String(pfAgendaOpenDay || ''));
</script>
<script>
(function(){
  const $ = (id) => document.getElementById(id);
  const isOwn = <%- JSON.stringify(!!isOwn) %>;
  if (!isOwn) return;

  async function getJSON(url){
    const res = await fetch(url, {
      method: 'GET',
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json' }
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    return res.json();
  }

  function esc(s){
    return String(s || '')
      .replace(/&/g,'&amp;')
      .replace(/</g,'&lt;')
      .replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;')
      .replace(/'/g,'&#039;');
  }

  function openStudyInsideProfile(){
    if (typeof window.pfOpenStudySection === 'function'){
      window.pfOpenStudySection();
      return;
    }

    const btn = document.querySelector('.pf-menuItem[data-key="study"]');
    if (btn) btn.click();
  }

  function bindStudyOpeners(scope){
    if (!scope) return;
    scope.querySelectorAll('[data-pf-open-study]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openStudyInsideProfile();
      });
    });
  }

  async function loadStudyWidget(){
    const body = $('pfStudyWidgetBody');
    if (!body) return;

    const miniOpen = $('pfStudyMiniOpen');
    if (miniOpen && !miniOpen.dataset.boundStudyOpen){
      miniOpen.dataset.boundStudyOpen = '1';
      miniOpen.addEventListener('click', (e) => {
        e.preventDefault();
        openStudyInsideProfile();
      });
    }

    const days = ['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'];
    const hours = Array.from({ length: 18 }, (_, i) => i + 6);

    function renderWeek(schedule){
      const weekly = Array.isArray(schedule?.weekly) ? schedule.weekly : [];
      let html = '<div class="pf-studyWeek">';
      html += '<div class="pf-studyWeekCorner">Hora</div>';
      days.forEach((d) => { html += `<div class="pf-studyWeekHead">${d}</div>`; });

      hours.forEach((hour) => {
        html += `<div class="pf-studyWeekHour">${String(hour).padStart(2,'0')}</div>`;
        weekly.forEach((day) => {
          const on = Array.isArray(day.hourHighlights) && day.hourHighlights.includes(hour);
          html += `<div class="pf-studyWeekCell ${on ? 'is-on' : ''}"></div>`;
        });
      });

      html += '</div>';
      return html;
    }

    try{
      const out = await getJSON('/estudio/api/resumen');

      if (!out || !out.ok){
        body.innerHTML = '<div class="pf-studyEmpty">No se pudo cargar tu panel de estudio.</div>';
        return;
      }

      if (!out.completed){
        body.innerHTML = `
          <div class="pf-studyCallout">
            Todavía no completaste el test. Hacelo una sola vez y la app te va a guardar el método, la disponibilidad y el cronograma en tu cuenta.
          </div>
          <button type="button" class="pf-studyActionBtn is-primary" data-pf-open-study="1">Hacer test</button>
        `;
        bindStudyOpeners(body);
        return;
      }

      const todayEntries = (out.schedule && Array.isArray(out.schedule.weekly))
        ? (out.schedule.weekly[out.schedule.todayIndex]?.entries || [])
        : [];

      const todayHtml = todayEntries.length
        ? todayEntries.map((entry) => `
            <div class="pf-studyTodayItem ${entry.type === 'break' ? 'is-break' : ''}">
              ${esc(entry.text)}
            </div>
          `).join('')
        : '<div class="pf-studyEmpty is-tight">Hoy no tenés bloques asignados.</div>';

      body.innerHTML = `
        <div class="pf-studyCallout">${esc(out.schedule.widgetMessage || '')}</div>

        ${renderWeek(out.schedule)}

        <div class="pf-studyActionRow">
          <button type="button" class="pf-studyActionBtn" data-pf-open-study="1">
            Editar Horarios
          </button>
          <button type="button" class="pf-studyActionBtn is-primary" data-pf-open-study="1">
            Ver resultado
          </button>
        </div>

        <div class="pf-studyBlock">
          <div class="pf-studyBlockTitle">Hoy</div>
          <div class="pf-studyTodayList">${todayHtml}</div>
        </div>

        <div class="pf-studyBlock">
          <div class="pf-studyBlockTitle">Método recomendado</div>
          <div class="pf-studyMethodName">${esc(out.method.profile || '')}</div>
          <div class="pf-studyMethodMeta">
            ${esc(out.method.title || '')} · ${esc(out.method.workMin || 0)}/${esc(out.method.breakMin || 0)}
          </div>
          <div class="pf-studyMethodText">${esc(out.method.explanation || '')}</div>
        </div>
      `;

      bindStudyOpeners(body);
    }catch(err){
      body.innerHTML = '<div class="pf-studyEmpty">No se pudo cargar tu panel de estudio.</div>';
    }
  }

  window.__reloadStudyWidget = loadStudyWidget;
  loadStudyWidget();
})();
</script>
<script>
(function(){
  const $ = (id) => document.getElementById(id);
  const isOwn = <%- JSON.stringify(!!isOwn) %>;

  function escapeHtml(s){
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  async function postJSON(url, data){
    const res = await fetch(url, {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify(data || {})
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    let out = null;
    try{ out = await res.json(); }catch(_){ out = null; }
    return out;
  }

  async function getJSON(url){
    const res = await fetch(url, {
      method: 'GET',
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json' }
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    let out = null;
    try{ out = await res.json(); }catch(_){ out = null; }
    return out;
  }

  if (!isOwn) return;

  const studyPanelEl = $('pfStudyPanel');
  if (!studyPanelEl) return;

  const STUDY_HOURS = Array.from({ length: 18 }, (_, i) => i + 6);
  const STUDY_DAYS = ['Lunes','Martes','Miércoles','Jueves','Viernes','Sábado','Domingo'];
  const STUDY_SHORT = ['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'];
  const STUDY_SCALE = [
    { value: 1, label: 'Nada que ver conmigo' },
    { value: 2, label: 'Poco' },
    { value: 3, label: 'Intermedio' },
    { value: 4, label: 'Bastante' },
    { value: 5, label: 'Muy yo' }
  ];

  const studyState = {
    loaded: false,
    loading: false,
    completed: false,
    step: 0,
    phase: 'questions',
    questions: [],
    answers: {},
    availability: {},
        result: null,
    paintDown: false,
    paintValue: false,
    hourWindowStart: 6
  };

  function blankAvailability(){
    const out = {};
    for (let dow = 0; dow < 7; dow++) out[dow] = { allDay: false, hours: [] };
    return out;
  }

  function normalizeAvailability(input){
    const out = blankAvailability();
    const src = (input && typeof input === 'object') ? input : {};
    for (let dow = 0; dow < 7; dow++){
      const row = src[dow] || src[String(dow)] || {};
      const hours = Array.isArray(row.hours)
        ? Array.from(new Set(row.hours.map(Number).filter(h => STUDY_HOURS.includes(h)))).sort((a,b) => a-b)
        : [];
      const allDay = !!row.allDay || hours.length === STUDY_HOURS.length;
      out[dow] = { allDay, hours: allDay ? [...STUDY_HOURS] : hours };
    }
    return out;
  }

    function getStudyHourWindowStart(){
  return Number(studyState.hourWindowStart) === 16 ? 16 : 6;
}

function getStudyVisibleHours(){
  return getStudyHourWindowStart() === 16
    ? [15,16,17,18,19,20,21,22,23,null]
    : [6,7,8,9,10,11,12,13,14,null];
}

function getStudyHourWindowLabel(){
  return getStudyHourWindowStart() === 16 ? 'de 3 PM a 11 PM' : 'de 6 AM a 2 PM';
}

function toggleStudyHourWindow(dir){
  const curr = getStudyHourWindowStart();
  studyState.hourWindowStart = curr === 6 ? 16 : 6;

  // Actualizar pill sin re-renderizar todo
  const pill = studyPanelEl.querySelector('.pf-studyWindowPill');
  if (pill) pill.textContent = getStudyHourWindowLabel();

  // Re-renderizar solo la grilla
  const oldGrid = studyPanelEl.querySelector('.pf-studyGridScroll');
  if (oldGrid){
    const scheduleMode = (studyState.phase === 'result') ? (studyState.result?.schedule || null) : null;
    const tmp = document.createElement('div');
    tmp.innerHTML = renderStudyGrid(scheduleMode);
    oldGrid.replaceWith(tmp.firstElementChild);
  }

  if (studyState.phase === 'availability'){
    syncStudyGridFromState();
    // re-bindear celdas
    studyPanelEl.querySelectorAll('.pf-studyCell').forEach(cell => {
      cell.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        studyState.paintDown = true;
        const dow = Number(cell.dataset.dow);
        const hour = Number(cell.dataset.hour);
        const occupied = !!studyState.availability[dow]?.hours?.includes(hour);
        studyState.paintValue = !occupied;
        setStudyCellOccupied(dow, hour, studyState.paintValue);
        syncStudyGridFromState();
      });
      cell.addEventListener('pointerenter', () => {
        if (!studyState.paintDown) return;
        setStudyCellOccupied(Number(cell.dataset.dow), Number(cell.dataset.hour), studyState.paintValue);
        syncStudyGridFromState();
      });
    });
  }
}

function getStudyDisplayPct(frac){
  const safe = Math.max(0, Math.min(1, Number(frac || 0)));
  if (safe <= 0) return 0;
  return Math.max(25, Math.min(100, Math.round(safe * 4) * 25));
}

  function getStudyCoverageFraction(scheduleMode, dow, hour){
    const weekly = Array.isArray(scheduleMode?.weekly) ? scheduleMode.weekly : [];
    const day = weekly[dow];
    const blocks = Array.isArray(day?.studyBlocks) ? day.studyBlocks : [];
    const cellStart = hour * 60;
    const cellEnd = (hour + 1) * 60;
    let covered = 0;

    for (const block of blocks){
      const start = Number(block?.startMin || 0);
      const end = Number(block?.endMin || 0);
      const overlap = Math.max(0, Math.min(cellEnd, end) - Math.max(cellStart, start));
      covered += overlap;
    }

    return Math.max(0, Math.min(1, covered / 60));
  }

  // Re-bindea eventos touch/pointer en las celdas de disponibilidad.
  // Se llama en renderStudyAvailability() y cada vez que se cambia de ventana horaria.
  function bindStudyGridCells(){
    studyPanelEl.querySelectorAll('.pf-studyCell[data-dow][data-hour]').forEach(cell => {
      if (cell.dataset.studyCellBound) return;
      cell.dataset.studyCellBound = '1';
      cell.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        studyState.paintDown = true;
        const dow  = Number(cell.dataset.dow);
        const hour = Number(cell.dataset.hour);
        const occupied = !!studyState.availability[dow]?.hours?.includes(hour);
        studyState.paintValue = !occupied;
        setStudyCellOccupied(dow, hour, studyState.paintValue);
        syncStudyGridFromState();
      });
      cell.addEventListener('pointerenter', () => {
        if (!studyState.paintDown) return;
        setStudyCellOccupied(Number(cell.dataset.dow), Number(cell.dataset.hour), studyState.paintValue);
        syncStudyGridFromState();
      });
      cell.addEventListener('dragstart', (e) => { e.preventDefault(); });
    });
    studyPanelEl.querySelectorAll('.pf-studyDayFull').forEach(check => {
      if (check.dataset.studyCheckBound) return;
      check.dataset.studyCheckBound = '1';
      check.addEventListener('change', () => {
        const dow = Number(check.dataset.dow);
        studyState.availability[dow] = {
          allDay: check.checked,
          hours: check.checked ? [...STUDY_HOURS] : []
        };
        syncStudyGridFromState();
      });
    });
  }

  function bindStudyHourWindowControls(){
    const prev = studyPanelEl.querySelector('#pfStudyWindowPrev');
    const next = studyPanelEl.querySelector('#pfStudyWindowNext');

    function switchWindow(dir){
      toggleStudyHourWindow(dir);
      const pill = studyPanelEl.querySelector('.pf-studyWindowPill');
      if (pill) pill.textContent = getStudyHourWindowLabel();
      const oldGrid = studyPanelEl.querySelector('.pf-studyGridScroll');
      if (oldGrid){
        const isResult = studyState.phase === 'result';
        const newGrid = document.createElement('div');
        newGrid.innerHTML = renderStudyGrid(isResult ? studyState.result?.schedule || null : null);
        oldGrid.replaceWith(newGrid.firstChild);
      }
      if (studyState.phase === 'availability'){
        syncStudyGridFromState();
        bindStudyGridCells(); // re-bindea las celdas nuevas al cambiar ventana
      }
    }

    if (prev){
      const newPrev = prev.cloneNode(true);
      prev.replaceWith(newPrev);
      newPrev.addEventListener('click', () => switchWindow(-1));
    }
    if (next){
      const newNext = next.cloneNode(true);
      next.replaceWith(newNext);
      newNext.addEventListener('click', () => switchWindow(1));
    }
  }
  function setStudyCellOccupied(dow, hour, occupied){
    const row = studyState.availability[dow] || { allDay:false, hours:[] };
    const set = new Set((row.hours || []).map(Number));
    if (occupied) set.add(Number(hour)); else set.delete(Number(hour));
    row.hours = Array.from(set).sort((a,b) => a-b);
    row.allDay = row.hours.length === STUDY_HOURS.length;
    studyState.availability[dow] = row;
  }
  function pfShowStudyInfoModal(title, bodyHtml){
  let overlay = document.getElementById('pfStudyInfoOverlay');
  if (overlay) overlay.remove();

  overlay = document.createElement('div');
  overlay.id = 'pfStudyInfoOverlay';
  overlay.style.cssText = `
    position:fixed;inset:0;z-index:9999;
    background:rgba(0,0,0,.45);
    backdrop-filter:blur(8px);
    display:flex;align-items:center;justify-content:center;
    padding:24px;box-sizing:border-box;
  `;

  overlay.innerHTML = `
    <div style="
      background:#fff;border-radius:24px;
      padding:24px 22px 20px;
      max-width:360px;width:100%;
      box-shadow:0 24px 60px rgba(15,23,42,.22);
      position:relative;
    ">
      <button id="pfStudyInfoClose" style="
        position:absolute;top:14px;right:14px;
        background:transparent;border:none;
        font-size:18px;cursor:pointer;color:rgba(15,23,42,.5);
        line-height:1;
      ">✕</button>
      <div style="font-size:17px;font-weight:800;color:#0f172a;margin-bottom:14px;">${title}</div>
      <div class="pf-studyInfoBody">${bodyHtml}</div>
    </div>
  `;

  document.body.appendChild(overlay);

  overlay.querySelector('#pfStudyInfoClose').addEventListener('click', () => overlay.remove());
  overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });
}

function syncStudyGridFromState(){
  studyPanelEl.querySelectorAll('.pf-studyCell[data-dow][data-hour]').forEach(cell => {
    const dow = Number(cell.dataset.dow);
    const hour = Number(cell.dataset.hour);
    const occupied = !!studyState.availability[dow]?.hours?.includes(hour);
    const fill = cell.querySelector('.pf-studyCellFill');

    cell.classList.toggle('is-occupied', occupied);
    if (fill){
      fill.style.opacity = occupied ? '1' : '0';
    }
  });

  studyPanelEl.querySelectorAll('.pf-studyDayFull').forEach(check => {
    const dow = Number(check.dataset.dow);
    check.checked = (studyState.availability[dow]?.hours || []).length === STUDY_HOURS.length;
  });
}

  function renderStudyGrid(scheduleMode){
    const visibleHours = getStudyVisibleHours();
    let html = '<div class="pf-studyGridScroll"><div class="pf-studyGrid" style="grid-template-columns: 118px repeat(9, 34px);">';

    html += '<div class="pf-studyGridCorner">Día / Hora</div>';

    for (const hour of visibleHours){
      html += `<div class="pf-studyHourHead">${String(hour).padStart(2,'0')}:00</div>`;
    }

    for (let dow = 0; dow < 7; dow++){
      if (!scheduleMode){
        html += `
          <label class="pf-studyRowHead">
            <input
              type="checkbox"
              class="pf-studyDayFull pf-studyRowCheck"
              data-dow="${dow}"
              aria-label="Ocupado todo el día ${escapeHtml(STUDY_DAYS[dow])}"
            />
            <span class="pf-studyRowName">${escapeHtml(STUDY_DAYS[dow])}</span>
          </label>
        `;
      } else {
        html += `
          <div class="pf-studyRowHead">
            <span class="pf-studyRowName">${escapeHtml(STUDY_DAYS[dow])}</span>
          </div>
        `;
      }

      for (const hour of visibleHours){
        if (!scheduleMode){
          html += `
            <button
              type="button"
              class="pf-studyCell"
              data-dow="${dow}"
              data-hour="${hour}"
              aria-label="${escapeHtml(STUDY_DAYS[dow])} ${String(hour).padStart(2,'0')}:00"
            ><span class="pf-studyCellFill" style="--study-fill-width:0%;--study-fill-opacity:0;"></span></button>
          `;
          continue;
        }

        let frac = getStudyCoverageFraction(scheduleMode, dow, hour);
        frac = Math.max(0, Math.min(1, Number(frac || 0)));
        const pct = getStudyDisplayPct(frac);

        html += `
          <button
            type="button"
            class="pf-studyCell ${pct > 0 ? 'is-recommended' : ''}"
            data-dow="${dow}"
            data-hour="${hour}"
            disabled
            aria-label="${escapeHtml(STUDY_DAYS[dow])} ${String(hour).padStart(2,'0')}:00"
          ><span class="pf-studyCellFill" style="--study-fill-width:${pct}%;--study-fill-opacity:${pct > 0 ? 1 : 0};"></span></button>
        `;
      }
    }

    html += '</div></div>';
    return html;
  }

function renderStudyGrid(scheduleMode){
  const weekly = Array.isArray(scheduleMode?.weekly) ? scheduleMode.weekly : [];
  const visibleHours = getStudyVisibleHours();
  let html = '<div class="pf-studyGridScroll"><div class="pf-studyGrid" style="grid-template-columns: 118px repeat(10, 34px);">';

  html += '<div class="pf-studyGridCorner">Día / Hora</div>';

  for (const hour of visibleHours){
    if (hour === null){
      html += `<div class="pf-studyHourHead is-blank"></div>`;
    } else {
      html += `<div class="pf-studyHourHead">${String(hour).padStart(2,'0')}:00</div>`;
    }
  }

  for (let dow = 0; dow < 7; dow++){
    if (!scheduleMode){
      html += `
        <label class="pf-studyRowHead">
          <input
            type="checkbox"
            class="pf-studyDayFull pf-studyRowCheck"
            data-dow="${dow}"
            aria-label="Ocupado todo el día ${escapeHtml(STUDY_DAYS[dow])}"
          />
          <span class="pf-studyRowName">${escapeHtml(STUDY_DAYS[dow])}</span>
        </label>
      `;
    } else {
      html += `
        <div class="pf-studyRowHead">
          <span class="pf-studyRowName">${escapeHtml(STUDY_DAYS[dow])}</span>
        </div>
      `;
    }

    for (const hour of visibleHours){
      if (hour === null){
        html += `<div class="pf-studySpacer"></div>`;
        continue;
      }

      if (!scheduleMode){
        html += `
          <button
            type="button"
            class="pf-studyCell"
            data-dow="${dow}"
            data-hour="${hour}"
            aria-label="${escapeHtml(STUDY_DAYS[dow])} ${String(hour).padStart(2,'0')}:00"
          ></button>
        `;
        continue;
      }

      let frac = getStudyCoverageFraction(scheduleMode, dow, hour);
      frac = Math.max(0, Math.min(1, Number(frac || 0)));
      const pct = Math.round(frac * 1000) / 10;

      const style = pct > 0
        ? `style="background: linear-gradient(90deg, #F8C160 0%, #F8C160 ${pct}%, #ffffff ${pct}%, #ffffff 100%); box-shadow: 0 6px 14px rgba(15,23,42,.10);"`
        : `style="background:#ffffff; box-shadow: 0 6px 14px rgba(15,23,42,.10);"`;      

      html += `
        <button
          type="button"
          class="pf-studyCell ${pct > 0 ? 'is-recommended' : ''}"
          data-dow="${dow}"
          data-hour="${hour}"
          disabled
          ${style}
          aria-label="${escapeHtml(STUDY_DAYS[dow])} ${String(hour).padStart(2,'0')}:00"
        ></button>
      `;
    }
  }

  html += '</div></div>';
  return html;
}

    function renderStudyQuestion(){
    const total = studyState.questions.length || 1;
    const q = studyState.questions[studyState.step];
    if (!q){
      studyPanelEl.innerHTML = '<div class="pf-studyPanelError">No se pudo cargar el test de estudio.</div>';
      return;
    }

    const progress = Math.round(((studyState.step + 1) / total) * 100);
    const optionsHtml = STUDY_SCALE.map((opt) => `
      <label class="opt">
        <strong>${opt.value}</strong>
        <span>${escapeHtml(opt.label)}</span>
        <input type="radio" name="pf_study_answer" value="${opt.value}" ${Number(studyState.answers[q.id] || 0) === opt.value ? 'checked' : ''}>
      </label>
    `).join('');

    const qnavHtml = Array.from({ length: total }).map((_, idx) => `
      <button type="button" class="qnav-btn ${idx === studyState.step ? 'active' : ''} ${studyState.answers[studyState.questions[idx].id] ? 'answered' : ''}" data-study-step="${idx}">${idx + 1}</button>
    `).join('');

    studyPanelEl.innerHTML = `
      <div class="pf-studyHead">
        <div class="pf-studyHeadLeft">
          <div class="pf-studyTitle">Crea tus propios habitos</div>
        </div>
        <div class="pf-studyTopPill">Paso 1 de 2</div>
      </div>

      <p class="pf-studySub">Respondé el test en esta misma pantalla. Cuando termines, pasás al cuadro de horarios ocupados y después ves el resultado dentro del perfil.</p>

      <div class="pf-studyProgressRow">
        <div class="pf-studyProgressText">Pregunta ${studyState.step + 1} de ${total}</div>
        <div class="pf-studyProgressTrack"><div class="pf-studyProgressFill" style="width:${progress}%"></div></div>
      </div>

      <div class="pf-studyQuestionLayout">
        <div class="pf-studyQuestionMain">
          <div class="pf-studyQuestionCard">
            <div class="pf-studyQuestionMeta">Índice ${escapeHtml(String(q.dimension || 'general'))} · pregunta ${studyState.step + 1}</div>
            <div class="pf-studyQuestionText">${escapeHtml(q.text || '')}</div>
            <div class="pf-studyOptions">${optionsHtml}</div>

            <div class="pf-studyNavRow">
              <div class="pf-studyBtns">
                <button id="pfStudyPrevBtn" class="pf-studyBtn" type="button" ${studyState.step === 0 ? 'disabled' : ''}>Anterior</button>
                <button id="pfStudyNextBtn" class="pf-studyBtn is-primary" type="button">Siguiente</button>
              </div>
            </div>
          </div>
        </div>

        <div class="pf-studyQNav">${qnavHtml}</div>
      </div>
    `;

    studyPanelEl.querySelectorAll('input[name="pf_study_answer"]').forEach(input => {
      input.addEventListener('change', () => {
        studyState.answers[q.id] = Number(input.value);
        renderStudyQuestion();
      });
    });

    studyPanelEl.querySelectorAll('[data-study-step]').forEach(btn => {
      btn.addEventListener('click', () => {
        studyState.step = Math.max(0, Math.min(total - 1, Number(btn.dataset.studyStep || 0)));
        renderStudyQuestion();
      });
    });

    studyPanelEl.querySelector('#pfStudyPrevBtn')?.addEventListener('click', () => {
      if (studyState.step <= 0) return;
      studyState.step -= 1;
      renderStudyQuestion();
    });

    studyPanelEl.querySelector('#pfStudyNextBtn')?.addEventListener('click', () => {
      if (!studyState.answers[q.id]){
        alert('Respondé la pregunta antes de continuar.');
        return;
      }
      if (studyState.step >= total - 1){
        studyState.phase = 'availability';
        renderStudyAvailability();
        return;
      }
      studyState.step += 1;
      renderStudyQuestion();
    });
  }

    function renderStudyAvailability(){
    studyPanelEl.innerHTML = `
      <div class="pf-studyHead">
        <div class="pf-studyHeadLeft">
          <div class="pf-studyTitle">Horarios ocupados</div>
        </div>
        <div class="pf-studyTopPill">Paso 2 de 2</div>
      </div>

      <p class="pf-studySub">Marcá solo los bloques en los que no podés estudiar. Los cuadros se pintan de #F8C160 y quedan guardados en pantalla.</p>

      <div class="pf-studyAvailCard">
        <div class="pf-studyAvailHead">
          <div>
            <h3 class="pf-studyAvailTitle">Tu semana ocupada</h3>
            <p class="pf-studyAvailSub">La grilla se muestra en dos partes: de 6 AM a 2 PM y de 3 PM a 11 PM.</p>
          </div>
        </div>

        <div class="pf-studyWindowRow">
          <button id="pfStudyWindowPrev" class="pf-studyWindowArrow" type="button" aria-label="Ver bloque anterior">‹</button>
          <div class="pf-studyWindowPill">${escapeHtml(getStudyHourWindowLabel())}</div>
          <button id="pfStudyWindowNext" class="pf-studyWindowArrow" type="button" aria-label="Ver bloque siguiente">›</button>
        </div>

        ${renderStudyGrid(null)}

        <div class="pf-studyNavRow">
          <div class="pf-studyBtns">
            <button id="pfStudyBackToQuestions" class="pf-studyBtn" type="button">Anterior</button>
          </div>
          <div class="pf-studyBtns">
            <button id="pfStudyFinishBtn" class="pf-studyBtn is-primary" type="button">Terminar</button>
          </div>
        </div>
      </div>
    `;

    bindStudyHourWindowControls();
    syncStudyGridFromState();
    bindStudyGridCells(); // bindea celdas de la ventana inicial

    studyPanelEl.querySelector('#pfStudyBackToQuestions')?.addEventListener('click', () => {
      studyState.phase = 'questions';
      renderStudyQuestion();
    });

    studyPanelEl.querySelector('#pfStudyFinishBtn')?.addEventListener('click', async () => {
      await saveStudyPanel();
    });
  }

  function renderStudyResult(result){
  studyState.completed = true;
  studyState.phase = 'result';
  const weeklyTitle = result?.nextStudy?.label || 'Todavía no hay próximo bloque';
  const mindhackTitle = result?.mindhack?.profileName || 'Sin perfil MindHack';

  studyPanelEl.innerHTML = `
    <div class="pf-studyHead">
      <div class="pf-studyHeadLeft">
        <div class="pf-studyTitle">Tu cronograma recomendado</div>
      </div>
    </div>

    <p class="pf-studySub"></p>

    <div class="pf-studyResultWrap">
  <div class="pf-studyWeekCard">

    <div class="pf-studyBottomRow pf-studyBottomRow--mini">
      <div class="pf-studyNextCard">
        <button type="button" class="pf-studyModalTrigger" id="pfStudyOpenDates">
          <div class="pf-studyNextLabel">Próximas Fechas</div>
          <div class="pf-studyNextValue">${escapeHtml(weeklyTitle)}</div>
        </button>
      </div>

      <div class="pf-studyResultDividerV" aria-hidden="true"></div>

      <div class="pf-studyMethodCard">
        <button type="button" class="pf-studyModalTrigger" id="pfStudyOpenMindhack">
          <div class="pf-studyNextLabel">MindHack</div>
          <div class="pf-studyNextValue">${escapeHtml(mindhackTitle)}</div>
        </button>
      </div>

      <div class="pf-studyResultDividerV" aria-hidden="true"></div>

      <div class="pf-studyMethodCard">
        <button type="button" class="pf-studyModalTrigger" id="pfStudyOpenResult">
          <div class="pf-studyNextLabel">Resultados</div>
          <div class="pf-studyNextValue">${escapeHtml(result?.method?.profile || '')}</div>
        </button>
      </div>
    </div>

    <div class="pf-studyCardTitle">Semana sugerida</div>

    <div class="pf-studyWindowRow">
      <button id="pfStudyWindowPrev" class="pf-studyWindowArrow" type="button" aria-label="Ver bloque anterior">‹</button>
      <div class="pf-studyWindowPill">${escapeHtml(getStudyHourWindowLabel())}</div>
      <button id="pfStudyWindowNext" class="pf-studyWindowArrow" type="button" aria-label="Ver bloque siguiente">›</button>
    </div>

    ${renderStudyGrid(result?.schedule || null)}

    <div class="pf-studyWeekActions">
      <button id="pfStudyRedoBtn" class="pf-studyBtn" type="button">Rehacer test</button>
      <button id="pfStudyEditAvailabilityBtn" class="pf-studyBtn is-primary" type="button">Editar horarios</button>
    </div>
  </div>
</div>
  `;

  bindStudyHourWindowControls();

  studyPanelEl.querySelector('#pfStudyOpenDates')?.addEventListener('click', () => {
    pfShowStudyInfoModal(
      'Próximas Fechas',
      `<div class="pf-studyInfoRow"><b>Próximo bloque:</b> ${escapeHtml(weeklyTitle)}</div>
       <div class="pf-studyInfoRow">${escapeHtml(result?.recommendationText || 'Todavía no hay una recomendación lista.')}</div>`
    );
  });

  studyPanelEl.querySelector('#pfStudyOpenMindhack')?.addEventListener('click', () => {
    const mindhack = result?.mindhack || {};
    const mindhackStepsHtml = Array.isArray(mindhack.steps)
      ? mindhack.steps.map((step, idx) => `<div class="pf-studyInfoRow"><b>Paso ${idx + 1}:</b> ${escapeHtml(step)}</div>`).join('')
      : '';

    pfShowStudyInfoModal(
      'MindHack',
      `<div class="pf-studyInfoRow"><b>🧠 Tu Perfil MindHack:</b> ${escapeHtml(mindhack.profileName || 'Sin perfil')}</div>
       <div class="pf-studyInfoRow"><b>Dimensión dominante:</b> ${escapeHtml(mindhack.dominantDimension || '')}</div>
       <div class="pf-studyInfoRow"><b>Cómo funciona:</b> ${escapeHtml(mindhack.howItWorks || '')}</div>
       <div class="pf-studyInfoRow"><b>Método Estrella:</b> ${escapeHtml(mindhack.starMethod || '')}</div>
       ${mindhackStepsHtml}
       <div class="pf-studyInfoRow"><b>Nota final:</b> ${escapeHtml(mindhack.finalNote || '')}</div>`
    );
  });

  studyPanelEl.querySelector('#pfStudyOpenResult')?.addEventListener('click', () => {
    pfShowStudyInfoModal(
      'Resultados del test',
      `<div class="pf-studyInfoRow"><b>Perfil:</b> ${escapeHtml(result?.method?.profile || '')}</div>
       <div class="pf-studyInfoRow"><b>Método:</b> ${escapeHtml(result?.method?.title || '')} · ${escapeHtml(result?.method?.workMin || 0)}/${escapeHtml(result?.method?.breakMin || 0)} min</div>
       <div class="pf-studyInfoRow">${escapeHtml(result?.method?.explanation || '')}</div>`
    );
  });

  studyPanelEl.querySelector('#pfStudyRedoBtn')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget;

      // animación de puntos suspensivos
      btn.disabled = true;
      const originalText = btn.textContent;
      let dotCount = 0;
      const dotInterval = setInterval(() => {
        dotCount = (dotCount + 1) % 4;
        btn.textContent = '.'.repeat(dotCount || 1);
      }, 300);

      try{
        const out = await postJSON('/estudio/api/reset', {});
        if (!out || !out.ok) throw new Error((out && out.error) || 'No se pudo reiniciar');
        studyState.loaded = false;
        studyState.completed = false;
        studyState.phase = 'questions';
        studyState.step = 0;
        studyState.result = null;
        studyState.answers = {};
        studyState.availability = blankAvailability();
        studyState.hourWindowStart = 6;
        clearInterval(dotInterval);
        await loadProfileStudyPanel(true);
      }catch(_){
        clearInterval(dotInterval);
        btn.textContent = originalText;
        btn.disabled = false;
        alert('No se pudo reiniciar el test de estudio.');
      }
    });

  studyPanelEl.querySelector('#pfStudyEditAvailabilityBtn')?.addEventListener('click', () => {
    studyState.completed = false;
    studyState.phase = 'availability';
    renderStudyAvailability();
  });
}

  async function saveStudyPanel(){
    const missing = studyState.questions.find(q => !studyState.answers[q.id]);
    if (missing){
      studyState.phase = 'questions';
      studyState.step = Math.max(0, studyState.questions.findIndex(q => q.id === missing.id));
      renderStudyQuestion();
      alert('Respondé todas las preguntas antes de terminar.');
      return;
    }

    const finishBtn = studyPanelEl.querySelector('#pfStudyFinishBtn');
    if (finishBtn){
      finishBtn.disabled = true;
      finishBtn.textContent = 'Guardando…';
    }

    try{
      const out = await postJSON('/estudio/api/panel', {
        answers_json: JSON.stringify(studyState.answers),
        availability_json: JSON.stringify(studyState.availability)
      });

      if (!out || !out.ok || !out.result){
        throw new Error((out && out.error) || 'No se pudo guardar');
      }

      studyState.completed = true;
      studyState.phase = 'result';
      studyState.result = out.result;

      try{ sessionStorage.removeItem('pf_section'); }catch(_){}
      try{
        const cleanUrl = window.location.pathname + window.location.search;
        history.replaceState(null, '', cleanUrl);
      }catch(_){}

      if (typeof window.__reloadStudyWidget === 'function') window.__reloadStudyWidget();
      renderStudyResult(out.result);
      return;
      
    }catch(err){
      alert('No se pudo guardar la configuración del cronómetro.');
      if (finishBtn){
        finishBtn.disabled = false;
        finishBtn.textContent = 'Terminar';
      }
    }
  }

  async function loadProfileStudyPanel(force){
    if (studyState.loading) return;
    if (studyState.loaded && !force) return;

    studyState.loading = true;
    studyPanelEl.innerHTML = '<div class="pf-studyPanelEmpty">Cargando configuración del cronómetro…</div>';

    try{
      const out = await getJSON('/estudio/api/panel');
      if (!out || !out.ok) throw new Error((out && out.error) || 'No se pudo cargar');

      studyState.loaded = true;
      studyState.completed = !!out.completed;
      studyState.questions = Array.isArray(out.questions) ? out.questions : [];
      studyState.answers = (out.answers && typeof out.answers === 'object') ? out.answers : {};
      studyState.availability = normalizeAvailability(out.availability || {});
      studyState.result = out.result || null;
      studyState.step = 0;
      studyState.phase = studyState.completed ? 'result' : 'questions';
      if (studyState.completed && studyState.result) renderStudyResult(studyState.result);
      else renderStudyQuestion();
    }catch(err){
      studyPanelEl.innerHTML = '<div class="pf-studyPanelError">No se pudo cargar el panel de cronómetro.</div>';
    }finally{
      studyState.loading = false;
    }
  }

  document.addEventListener('mouseup', () => { studyState.paintDown = false; });
  document.addEventListener('pointerup', () => { studyState.paintDown = false; });
  document.addEventListener('pointercancel', () => { studyState.paintDown = false; });
  window.loadProfileStudyPanel = loadProfileStudyPanel;

  const studyMenuBtn = document.querySelector('.pf-menuItem[data-key="study"]');
  if (studyMenuBtn && !studyMenuBtn.dataset.studyBound){
    studyMenuBtn.dataset.studyBound = '1';
    studyMenuBtn.addEventListener('click', () => {
      setTimeout(() => {
        if (typeof window.loadProfileStudyPanel === 'function'){
          window.loadProfileStudyPanel(true);
        }
      }, 0);
    });
  }

  const miniOpenBtn = document.getElementById('pfStudyMiniOpen');
  if (miniOpenBtn && !miniOpenBtn.dataset.studyBound){
    miniOpenBtn.dataset.studyBound = '1';
    miniOpenBtn.addEventListener('click', (e) => {
      e.preventDefault();
      if (typeof window.pfOpenStudySection === 'function'){
        window.pfOpenStudySection();
      } else {
        setTimeout(() => {
          if (typeof window.loadProfileStudyPanel === 'function'){
            window.loadProfileStudyPanel(true);
          }
        }, 0);
      }
    });
  }

  setTimeout(() => {
    if (document.body.classList.contains('pf-sec-study') && typeof window.loadProfileStudyPanel === 'function'){
      window.loadProfileStudyPanel(true);
    }
  }, 0);
})();
</script>

<script>
(function(){
  const $ = (id) => document.getElementById(id);
  const isOwn = <%- JSON.stringify(!!isOwn) %>;
  if (!isOwn) return;

  const affinityPanelEl = $('pfAffinityPanel');
  if (!affinityPanelEl) return;

  const affinityState = {
    loading: false,
    loaded: false,
    completed: false,
    editing: false,
    currentStep: 1,
    currentYear: 1,
    questionPage: 0,
    subjects: [],
    questions: [],
    approvedSubjectIds: [],
    currentSubjectIds: [],
    interests: {},
    suggestions: [],
    subjectSearch: '',
    suggestionSearch: '',
    completedAt: ''
  };

  function uniqIds(arr){
    return Array.from(new Set((Array.isArray(arr) ? arr : []).map((v) => Number(v)).filter((n) => Number.isFinite(n) && n > 0)));
  }

  function escapeHtml(s){
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  async function getJSON(url){
    const res = await fetch(url, {
      method: 'GET',
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json' }
    });
    const out = await res.json().catch(() => ({}));
    if (!res.ok || !out || out.ok === false){
      throw new Error((out && out.error) || ('HTTP ' + res.status));
    }
    return out;
  }

  async function postJSON(url, body){
    const res = await fetch(url, {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(body || {})
    });
    const out = await res.json().catch(() => ({}));
    if (!res.ok || !out || out.ok === false){
      throw new Error((out && out.error) || ('HTTP ' + res.status));
    }
    return out;
  }

  function normalizeClientInterests(raw, questions){
    const src = (raw && typeof raw === 'object' && !Array.isArray(raw)) ? raw : {};
    const out = {};
    (Array.isArray(questions) ? questions : []).forEach((q) => {
      const key = String(q.id || '');
      if (!key) return;
      if (q.multiple){
        const list = Array.isArray(src[key]) ? src[key] : [src[key]];
        const values = Array.from(new Set(list.map((v) => String(v || '')).filter((v) => v && Array.isArray(q.options) && q.options.includes(v))));
        if (values.length) out[key] = values;
        return;
      }
      const value = String(src[key] || '');
      if (value && Array.isArray(q.options) && q.options.includes(value)){
        out[key] = value;
      }
    });
    return out;
  }

  function hydrateAffinityState(out){
    affinityState.loaded = true;
    affinityState.completed = !!out.completed;
    affinityState.completedAt = String(out.completedAt || '');
    affinityState.subjects = Array.isArray(out.subjects) ? out.subjects.map((s) => ({
      id: Number(s.id) || 0,
      name: String(s.name || 'Materia'),
      year: Number(s.year || 0) || 0,
      semester: Number(s.semester || 0) || 0,
      canonical_key: String(s.canonical_key || '')
    })).filter((s) => s.id) : [];
    affinityState.questions = Array.isArray(out.questions) ? out.questions.map((q) => ({
      id: String(q.id || ''),
      label: String(q.label || ''),
      section: String(q.section || ''),
      question: String(q.question || ''),
      multiple: !!q.multiple,
      options: Array.isArray(q.options) ? q.options.map((opt) => String(opt || '')) : []
    })).filter((q) => q.id) : [];
    const profile = (out.profile && typeof out.profile === 'object') ? out.profile : {};
    affinityState.approvedSubjectIds = uniqIds(profile.approvedSubjectIds);
    affinityState.currentSubjectIds = uniqIds(profile.currentSubjectIds).filter((id) => !affinityState.approvedSubjectIds.includes(id));
    affinityState.interests = normalizeClientInterests(profile.interests, affinityState.questions);
    affinityState.suggestions = Array.isArray(out.suggestions) ? out.suggestions : [];
    affinityState.editing = !affinityState.completed;
    affinityState.currentStep = 1;
    affinityState.currentYear = 1;
    affinityState.questionPage = 0;
  }

  function questionHasAnswer(question){
    if (!question) return false;
    const value = affinityState.interests[question.id];
    return question.multiple ? (Array.isArray(value) && value.length > 0) : !!String(value || '').trim();
  }

  function totalQuestionPages(){
    return Math.max(1, Math.ceil((affinityState.questions || []).length / 2));
  }

  function visibleQuestionSlice(){
    const start = affinityState.questionPage * 2;
    return (affinityState.questions || []).slice(start, start + 2);
  }

  function currentYearSubjects(mode){
    const approvedSet = new Set(affinityState.approvedSubjectIds);
    const q = String(affinityState.subjectSearch || '').trim().toLowerCase();
    return (affinityState.subjects || [])
      .filter((subject) => Number(subject.year || 0) === Number(affinityState.currentYear || 1))
      .filter((subject) => mode !== 'current' || !approvedSet.has(subject.id))
      .filter((subject) => !q || String(subject.name || '').toLowerCase().includes(q))
      .sort((a, b) => {
        const sem = Number(a.semester || 0) - Number(b.semester || 0);
        if (sem) return sem;
        return String(a.name || '').localeCompare(String(b.name || ''), 'es', { sensitivity:'base' });
      });
  }

  function renderYearTabs(){
    const years = [1,2,3,4,5];
    return `
      <div class="pf-affinityYearTabs">
        ${years.map((year) => `
          <button type="button" class="pf-affinityYearTab ${Number(affinityState.currentYear) === year ? 'is-active' : ''}" data-year="${year}">${year}°</button>
        `).join('')}
      </div>
    `;
  }

  function renderSubjectCards(mode){
    const selected = new Set(mode === 'approved' ? affinityState.approvedSubjectIds : affinityState.currentSubjectIds);
    const list = currentYearSubjects(mode);
    if (!list.length){
      return '<div class="pf-affinityEmptyState">No encontramos materias para ese año con el filtro actual.</div>';
    }

    return `
      <div class="pf-affinitySubjectsDeck">
        ${list.map((subject) => `
          <label class="pf-affinitySubjectCard ${selected.has(subject.id) ? 'is-selected' : ''}">
            <input type="checkbox" class="pf-affinitySubjectCheck" data-mode="${mode}" value="${subject.id}" ${selected.has(subject.id) ? 'checked' : ''} hidden>
            <div class="pf-affinitySubjectMain">
              <div class="pf-affinitySubjectName">${escapeHtml(subject.name)}</div>
              <div class="pf-affinitySubjectMeta">${escapeHtml(String(subject.year || affinityState.currentYear || 1) + '° año')}${subject.semester ? ' · Cuatrimestre ' + escapeHtml(subject.semester) : ''}</div>
            </div>
            <div class="pf-affinitySubjectTick">✓</div>
          </label>
        `).join('')}
      </div>
    `;
  }

  function renderStepper(){
    const steps = [
      { n:1, title:'Materias aprobadas' },
      { n:2, title:'Cursada actual' },
      { n:3, title:'Intereses personales' }
    ];

    return `
      <div class="pf-affinityStepper">
        ${steps.map((step) => {
          const active = affinityState.currentStep === step.n;
          const done = affinityState.currentStep > step.n;
          return `
            <div class="pf-affinityStep ${active ? 'is-active' : ''} ${done ? 'is-done' : ''}">
              <div class="pf-affinityStepBall">${done ? '✓' : step.n}</div>
              <div class="pf-affinityStepText">${escapeHtml(step.title)}</div>
            </div>
          `;
        }).join('')}
      </div>
    `;
  }

  function bindSubjectControls(mode, rerender){
    affinityPanelEl.querySelector('#pfAffinitySubjectSearch')?.addEventListener('input', (e) => {
      affinityState.subjectSearch = String(e.target.value || '');
      rerender();
    });

    affinityPanelEl.querySelectorAll('.pf-affinityYearTab').forEach((btn) => {
      btn.addEventListener('click', () => {
        affinityState.currentYear = Number(btn.getAttribute('data-year') || 1) || 1;
        rerender();
      });
    });

    affinityPanelEl.querySelectorAll('.pf-affinitySubjectCheck').forEach((input) => {
      input.addEventListener('change', () => {
        const checked = uniqIds(Array.from(affinityPanelEl.querySelectorAll('.pf-affinitySubjectCheck:checked')).map((el) => el.value));
        if (mode === 'approved'){
          affinityState.approvedSubjectIds = checked;
          affinityState.currentSubjectIds = affinityState.currentSubjectIds.filter((id) => !affinityState.approvedSubjectIds.includes(id));
        }else{
          affinityState.currentSubjectIds = checked;
        }
        rerender();
      });
    });
  }

  function renderStepOne(){
    const selectedCount = affinityState.approvedSubjectIds.length;
    affinityPanelEl.innerHTML = `
      <div class="pf-affinityPanelCard">
        ${renderStepper()}
        <div class="pf-affinityHead">
          <div>
            <div class="pf-affinityTitle">Paso 1 · Materias aprobadas</div>
            <div class="pf-affinitySub">Elegí el año y marcá las materias que ya aprobaste.</div>
          </div>
          <div class="pf-affinityCounter">${selectedCount} seleccionadas</div>
        </div>

        <div class="pf-affinityToolbar">
          ${renderYearTabs()}
          <div class="pf-affinitySearchWrap">
            <svg viewBox="0 0 24 24" class="pf-affinitySearchIcon" aria-hidden="true"><path d="M10.5 4a6.5 6.5 0 1 1 0 13a6.5 6.5 0 0 1 0-13Zm0 1.8a4.7 4.7 0 1 0 0 9.4a4.7 4.7 0 0 0 0-9.4Zm6.58 10l3.11 3.11a.9.9 0 1 1-1.28 1.28l-3.11-3.11a.9.9 0 1 1 1.28-1.28Z" fill="currentColor"/></svg>
            <input id="pfAffinitySubjectSearch" class="pf-affinitySearchInput" type="text" placeholder="Buscar materia..." value="${escapeHtml(affinityState.subjectSearch)}">
          </div>
        </div>

        ${renderSubjectCards('approved')}

        <div class="pf-affinityFooter">
          <button id="pfAffinityNext1" type="button" class="pf-affinityBtn is-primary">Continuar</button>
        </div>
      </div>
    `;

    bindSubjectControls('approved', renderStepOne);
    affinityPanelEl.querySelector('#pfAffinityNext1')?.addEventListener('click', () => {
      affinityState.currentStep = 2;
      affinityState.subjectSearch = '';
      affinityState.currentYear = 1;
      renderAffinityPanel();
    });
  }

  function renderSubjectListAll(){
    const approvedSet = new Set(affinityState.approvedSubjectIds);
    const q = String(affinityState.subjectSearch || '').trim().toLowerCase();
    const list = (affinityState.subjects || [])
      .filter((s) => !approvedSet.has(s.id))
      .filter((s) => !q || String(s.name || '').toLowerCase().includes(q))
      .sort((a, b) => {
        const yd = Number(a.year || 0) - Number(b.year || 0);
        if (yd) return yd;
        const sd = Number(a.semester || 0) - Number(b.semester || 0);
        if (sd) return sd;
        return String(a.name || '').localeCompare(String(b.name || ''), 'es', { sensitivity:'base' });
      });

    if (!list.length){
      return '<div class="pf-affinityEmptyState">No encontramos materias que coincidan.</div>';
    }

    const selected = new Set(affinityState.currentSubjectIds);

    // Agrupar por año para etiquetas
    const byYear = {};
    list.forEach((s) => {
      const y = String(s.year || '?');
      if (!byYear[y]) byYear[y] = [];
      byYear[y].push(s);
    });
    const years = Object.keys(byYear).sort((a, b) => Number(a) - Number(b));

    return `
      <div class="pf-affinityCurrentList">
        ${years.map((year) => `
          <div class="pf-affinityCurrentYearLabel">${escapeHtml(year)}° año</div>
          ${byYear[year].map((subject) => `
            <label class="pf-affinityCurrentItem ${selected.has(subject.id) ? 'is-selected' : ''}">
              <input type="checkbox" class="pf-affinitySubjectCheck" data-mode="current" value="${subject.id}" ${selected.has(subject.id) ? 'checked' : ''} hidden>
              <div class="pf-affinityCurrentItemLeft">
                <div class="pf-affinityCurrentItemName">${escapeHtml(subject.name)}</div>
                ${subject.semester ? `<div class="pf-affinityCurrentItemMeta">Cuatrimestre ${escapeHtml(String(subject.semester))}</div>` : ''}
              </div>
              <div class="pf-affinityCurrentItemCheck">✓</div>
            </label>
          `).join('')}
        `).join('')}
      </div>
    `;
  }

  function renderStepTwo(){
    const availableCount = (affinityState.subjects || []).filter((s) => !affinityState.approvedSubjectIds.includes(s.id)).length;
    // SVG portralupa para el buscador
    const portralupaSVG = `<svg viewBox="0 0 24 24" class="pf-affinitySearchIcon" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6" stroke="currentColor" stroke-width="1.8"/><line x1="15.2" y1="15.2" x2="21" y2="21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>`;

    affinityPanelEl.innerHTML = `
      <div class="pf-affinityPanelCard">
        ${renderStepper()}
        <div class="pf-affinityHead">
          <div>
            <div class="pf-affinityTitle">Paso 2 · Cursada actual</div>
            <div class="pf-affinitySub">Seleccioná las que estás cursando ahora.</div>
          </div>
          <div class="pf-affinityCounter">${affinityState.currentSubjectIds.length} seleccionadas</div>
        </div>

        <div class="pf-affinityToolbar">
          <div class="pf-affinityToolbarInfo">${availableCount} disponibles</div>
          <div class="pf-affinitySearchWrap" style="margin-left:auto">
            ${portralupaSVG}
            <input id="pfAffinitySubjectSearch" class="pf-affinitySearchInput" type="text" placeholder="Buscar materia..." value="${escapeHtml(affinityState.subjectSearch)}">
          </div>
        </div>

        ${renderSubjectListAll()}

        <div class="pf-affinityFooter">
          <button id="pfAffinityBack2" type="button" class="pf-affinityBtn">Volver</button>
          <button id="pfAffinityNext2" type="button" class="pf-affinityBtn is-primary">Continuar</button>
        </div>
      </div>
    `;

    // Bind search
    affinityPanelEl.querySelector('#pfAffinitySubjectSearch')?.addEventListener('input', (e) => {
      affinityState.subjectSearch = String(e.target.value || '');
      renderStepTwo();
    });

    // Bind checkboxes
    affinityPanelEl.querySelectorAll('.pf-affinitySubjectCheck').forEach((input) => {
      input.addEventListener('change', () => {
        const checked = Array.from(affinityPanelEl.querySelectorAll('.pf-affinitySubjectCheck:checked'))
          .map((el) => Number(el.value))
          .filter((n) => Number.isFinite(n) && n > 0);
        affinityState.currentSubjectIds = Array.from(new Set(checked));
        renderStepTwo();
      });
    });

    affinityPanelEl.querySelector('#pfAffinityBack2')?.addEventListener('click', () => {
      affinityState.currentStep = 1;
      affinityState.subjectSearch = '';
      affinityState.currentYear = 1;
      renderAffinityPanel();
    });
    affinityPanelEl.querySelector('#pfAffinityNext2')?.addEventListener('click', () => {
      affinityState.currentStep = 3;
      affinityState.questionPage = 0;
      renderAffinityPanel();
    });
  }

  function renderQuestionCards(){
    const visible = visibleQuestionSlice();
    return `
      <div class="pf-affinityQuestions">
        ${visible.map((question, offset) => {
          const absoluteIndex = (affinityState.questionPage * 2) + offset + 1;
          const selectedValues = question.multiple
            ? (Array.isArray(affinityState.interests[question.id]) ? affinityState.interests[question.id] : [])
            : [String(affinityState.interests[question.id] || '')];
          return `
            <section class="pf-affinityQuestionCard">
              <div class="pf-affinityQuestionTop">
                <div class="pf-affinityQuestionIndex">Pregunta ${absoluteIndex}</div>
                <div class="pf-affinityQuestionLabel">${escapeHtml(question.label)}</div>
              </div>
              <div class="pf-affinityQuestionMode">${escapeHtml(question.section || '')}</div>
              <div class="pf-affinityQuestionText">${escapeHtml(question.question)}</div>
              <div class="pf-affinityQuestionHint">${question.multiple ? 'Podés elegir más de una opción.' : 'Elegí una sola opción.'}</div>
              <div class="pf-affinityOptions">
                ${question.options.map((option) => {
                  const selected = selectedValues.includes(option);
                  return `
                    <button
                      type="button"
                      class="pf-affinityOption ${selected ? 'is-selected' : ''}"
                      data-question-id="${escapeHtml(question.id)}"
                      data-option="${escapeHtml(option)}"
                    >${escapeHtml(option)}</button>
                  `;
                }).join('')}
              </div>
            </section>
          `;
        }).join('')}
      </div>
    `;
  }

  function toggleQuestionOption(questionId, option){
    const question = (affinityState.questions || []).find((q) => q.id === questionId);
    if (!question || !option) return;

    if (question.multiple){
      const list = Array.isArray(affinityState.interests[questionId]) ? [...affinityState.interests[questionId]] : [];
      const idx = list.indexOf(option);
      if (idx >= 0) list.splice(idx, 1);
      else list.push(option);
      affinityState.interests[questionId] = list;
      return;
    }

    affinityState.interests[questionId] = option;
  }

  function renderStepThree(){
    const answered = affinityState.questions.filter((q) => questionHasAnswer(q)).length;
    const totalPages = totalQuestionPages();
    const isLastPage = affinityState.questionPage >= (totalPages - 1);

    affinityPanelEl.innerHTML = `
      <div class="pf-affinityPanelCard">
        ${renderStepper()}
        <div class="pf-affinityHead">
          <div>
            <div class="pf-affinityTitle">Paso 3 · Intereses personales</div>
            <div class="pf-affinitySub">Las preguntas aparecen de a 3 para que entren cómodas en pantalla. Algunas son múltiples y otras te hacen jugártela por una sola respuesta.</div>
          </div>
          <div class="pf-affinityCounter">${answered}/${affinityState.questions.length} respondidas</div>
        </div>

        ${(() => {
          const answered = affinityState.questions.filter((q) => questionHasAnswer(q)).length;
          const total = affinityState.questions.length || 1;
          const pct = Math.round((answered / total) * 100);
          return `
            <div class="pf-affinityProgressWrap">
              <div class="pf-affinityProgressFill" style="width:${pct}%"></div>
            </div>
          `;
        })()}

        ${renderQuestionCards()}

        <div class="pf-affinityQuestionPager">Bloque ${affinityState.questionPage + 1} de ${totalPages}</div>

        <div class="pf-affinityFooter">
          <button id="pfAffinityBack3" type="button" class="pf-affinityBtn">Volver</button>
          ${affinityState.questionPage > 0 ? '<button id="pfAffinityPrevPage" type="button" class="pf-affinityBtn">Bloque anterior</button>' : ''}
          ${!isLastPage ? '<button id="pfAffinityNextPage" type="button" class="pf-affinityBtn is-primary">Siguiente bloque</button>' : '<button id="pfAffinityFinish" type="button" class="pf-affinityBtn is-primary">Finalizar mi perfil</button>'}
        </div>
      </div>
    `;

    affinityPanelEl.querySelectorAll('.pf-affinityOption').forEach((btn) => {
      btn.addEventListener('click', () => {
        const qid = String(btn.getAttribute('data-question-id') || '');
        const option = String(btn.getAttribute('data-option') || '');
        toggleQuestionOption(qid, option);
        renderStepThree();
      });
    });

    affinityPanelEl.querySelector('#pfAffinityBack3')?.addEventListener('click', () => {
      affinityState.currentStep = 2;
      affinityState.subjectSearch = '';
      affinityState.currentYear = 1;
      renderAffinityPanel();
    });

    affinityPanelEl.querySelector('#pfAffinityPrevPage')?.addEventListener('click', () => {
      affinityState.questionPage = Math.max(0, affinityState.questionPage - 1);
      renderStepThree();
    });

    affinityPanelEl.querySelector('#pfAffinityNextPage')?.addEventListener('click', () => {
      affinityState.questionPage = Math.min(totalPages - 1, affinityState.questionPage + 1);
      renderStepThree();
    });

    affinityPanelEl.querySelector('#pfAffinityFinish')?.addEventListener('click', async () => {
      const missingIdx = affinityState.questions.findIndex((q) => !questionHasAnswer(q));
      if (missingIdx >= 0){
        // Navegar al bloque que contiene la pregunta sin responder
        const targetPage = Math.floor(missingIdx / 2);
        affinityState.questionPage = targetPage;
        renderStepThree();
        // Hacer scroll al panel y resaltar brevemente la pregunta sin responder
        setTimeout(() => {
          const cards = affinityPanelEl.querySelectorAll('.pf-affinityQuestionCard');
          const cardOffset = missingIdx % 2;
          const targetCard = cards[cardOffset];
          if (targetCard){
            targetCard.style.transition = 'box-shadow .2s ease, border-color .2s ease';
            targetCard.style.boxShadow = '0 0 0 2px #F8C160';
            targetCard.style.borderColor = '#F8C160';
            targetCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            setTimeout(() => {
              targetCard.style.boxShadow = '';
              targetCard.style.borderColor = '';
            }, 1800);
          }
        }, 60);
        return;
      }

      const btn = affinityPanelEl.querySelector('#pfAffinityFinish');
      if (btn){
        btn.disabled = true;
        btn.textContent = 'Guardando…';
      }

      try{
        const out = await postJSON('/app/perfil/api/affinity', {
          approvedSubjectIds: affinityState.approvedSubjectIds,
          currentSubjectIds: affinityState.currentSubjectIds,
          interests: affinityState.interests
        });
        hydrateAffinityState(out);
        affinityState.completed = true;
        affinityState.editing = false;
        renderAffinityPanel();
      }catch(err){
        alert(err && err.message ? err.message : 'No se pudo guardar Mis Intereses.');
        if (btn){
          btn.disabled = false;
          btn.textContent = 'Finalizar mi perfil';
        }
      }
    });
  }

  function filteredSuggestions(){
    const q = String(affinityState.suggestionSearch || '').trim().toLowerCase();
    const rows = Array.isArray(affinityState.suggestions) ? affinityState.suggestions : [];
    if (!q) return rows;
    return rows.filter((item) => {
      const name = String(item.name || '').toLowerCase();
      const career = String(item.career || '').toLowerCase();
      return name.includes(q) || career.includes(q);
    });
  }

  function suggestionAvatar(item){
    const src = String(item.avatarUrl || '').trim();
    if (src){
      return `<img class="pf-affinityUserAvatarImg" src="${escapeHtml(src)}" alt="${escapeHtml(item.name || 'Usuario')}" loading="lazy">`;
    }
    const name = String(item.name || 'U').trim();
    const initial = name ? name.charAt(0).toUpperCase() : 'U';
    return `<div class="pf-affinityUserAvatarFallback">${escapeHtml(initial)}</div>`;
  }

  function renderSuggestions(){
    const rows = filteredSuggestions();
    // SVG portralupa — lupa con mango largo
    const portralupaSVG = `<svg viewBox="0 0 24 24" class="pf-affinitySearchIcon" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><circle cx="10.5" cy="10.5" r="6" stroke="currentColor" stroke-width="1.8"/><line x1="15.2" y1="15.2" x2="21" y2="21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>`;

    affinityPanelEl.innerHTML = `
      <div class="pf-affinityPanelCard is-result">

        <div class="pf-affinityResultTop">
          <div style="min-width:0">
            <div class="pf-affinityTitle" style="margin-bottom:3px">Encontrá tu grupo</div>
            <div class="pf-affinitySub">Usuarios con materias e intereses parecidos a los tuyos.</div>
          </div>
          <button id="pfAffinityEdit" type="button" class="pf-affinityRehacerBtn">Rehacer <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:13px;height:13px;display:inline-block;vertical-align:middle;margin-left:4px;margin-top:-1px" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15.5 8A6 6 0 1 0 14 13.2"/><polyline points="15.5,4.5 15.5,8.5 11.5,8.5"/></svg></button>
        </div>

        <div class="pf-affinityResultToolbar">
          <span style="font-size:11px;font-weight:900;color:rgba(15,23,42,.38);white-space:nowrap;flex:0 0 auto">${rows.length} ${rows.length === 1 ? 'coincidencia' : 'coincidencias'}</span>
          <div class="pf-affinitySearchWrap is-result" style="margin-left:auto">
            ${portralupaSVG}
            <input id="pfAffinitySuggestionSearch" class="pf-affinitySearchInput" type="text" placeholder="Buscar..." value="${escapeHtml(affinityState.suggestionSearch)}">
          </div>
        </div>

        ${rows.length ? `
          <div class="pf-affinityUsersGrid">
            ${rows.map((item) => {
              const subjectM = Number(item.subjectMatches || 0);
              const interestM = Number(item.interestMatches || 0);
              const total = subjectM + interestM;
              return `
                <a class="pf-affinityUserCard" href="/app/perfil/${encodeURIComponent(item.id)}">
                  <div class="pf-affinityUserAvatar">${suggestionAvatar(item)}</div>
                  <div class="pf-affinityUserInfo">
                    <div class="pf-affinityUserName">${escapeHtml(item.name || 'Usuario')}</div>
                    <div class="pf-affinityUserCareer">${escapeHtml(item.career || '')}${item.plan ? ' · Plan ' + escapeHtml(item.plan) : ''}</div>
                  </div>
                   <div class="pf-affinityUserMeta">
                    <span>${Number(item.subjectPercent || 0)}% en materias</span>
                    <span>${Number(item.interestPercent || 0)}% en respuestas</span>
                    <span>${Number(item.sharedCurrentCount || 0)} cursada(s) actual(es) en común</span>
                </div>
                </a>
              `;
            }).join('')}
          </div>
        ` : `
          <div class="pf-affinityEmptyState">
            <div style="font-size:26px;margin-bottom:8px">🔍</div>
            <div style="font-weight:950;font-size:13px;color:rgba(15,23,42,.55);margin-bottom:4px">Sin coincidencias por ahora</div>
            <div style="font-size:11px;color:rgba(15,23,42,.36);font-weight:800;max-width:220px;margin:0 auto">Volvé más tarde o tocá "Rehacer" para editar tus respuestas.</div>
          </div>
        `}
      </div>
    `;

    affinityPanelEl.querySelector('#pfAffinityEdit')?.addEventListener('click', () => {
      affinityState.editing = true;
      affinityState.currentStep = 1;
      affinityState.currentYear = 1;
      affinityState.questionPage = 0;
      affinityState.interests = {};
      renderAffinityPanel();
    });

    affinityPanelEl.querySelector('#pfAffinitySuggestionSearch')?.addEventListener('input', (e) => {
      affinityState.suggestionSearch = String(e.target.value || '');
      renderSuggestions();
    });
  }

  function renderAffinityPanel(){
    if (!affinityState.loaded){
      affinityPanelEl.innerHTML = '<div class="pf-affinityEmpty">Cargando Mis Intereses…</div>';
      return;
    }

    if (affinityState.completed && !affinityState.editing){
      renderSuggestions();
      return;
    }

    if (affinityState.currentStep === 1){
      renderStepOne();
      return;
    }

    if (affinityState.currentStep === 2){
      renderStepTwo();
      return;
    }

    renderStepThree();
  }

  async function loadProfileAffinityPanel(force){
    if (affinityState.loading) return;
    if (affinityState.loaded && !force){
      renderAffinityPanel();
      return;
    }

    affinityState.loading = true;
    affinityPanelEl.innerHTML = '<div class="pf-affinityEmpty">Cargando Mis Intereses…</div>';

    try{
      const out = await getJSON('/app/perfil/api/affinity');
      hydrateAffinityState(out);
      renderAffinityPanel();
    }catch(err){
      affinityPanelEl.innerHTML = '<div class="pf-affinityError">No se pudo cargar Mis Intereses.</div>';
    }finally{
      affinityState.loading = false;
    }
  }

  window.loadProfileAffinityPanel = loadProfileAffinityPanel;

  const affinityMenuBtn = document.querySelector('.pf-menuItem[data-key="affinity"]');
  if (affinityMenuBtn && !affinityMenuBtn.dataset.affinityBound){
    affinityMenuBtn.dataset.affinityBound = '1';
    affinityMenuBtn.addEventListener('click', () => {
      setTimeout(() => {
        if (typeof window.loadProfileAffinityPanel === 'function'){
          window.loadProfileAffinityPanel(true);
        }
      }, 0);
    });
  }

  setTimeout(() => {
    if (document.body.classList.contains('pf-sec-affinity') && typeof window.loadProfileAffinityPanel === 'function'){
      window.loadProfileAffinityPanel(true);
    }
  }, 0);
})();

// ── Tooltip global para opciones de intereses personales ──────────────────
(function(){
  let tip = document.getElementById('pf-option-tooltip');
  if (!tip){
    tip = document.createElement('div');
    tip.id = 'pf-option-tooltip';
    document.body.appendChild(tip);
  }
  let hideTimer = null;
  let touchHideTimer = null;
  let lastTouchBtn = null;

  function showTip(btn, forceShow){
    const text = btn.getAttribute('data-option') || btn.textContent || '';
    // En desktop solo mostrar si el texto está recortado; en touch siempre
    if (!forceShow && btn.scrollWidth <= btn.clientWidth + 2) return;
    clearTimeout(hideTimer);
    clearTimeout(touchHideTimer);
    tip.textContent = text;
    tip.style.display = 'block';
    tip.style.opacity = '0';
    const r = btn.getBoundingClientRect();
    const tw = tip.offsetWidth;
    const th = tip.offsetHeight;
    let left = r.left + r.width / 2 - tw / 2;
    left = Math.max(8, Math.min(left, window.innerWidth - tw - 8));
    const topAbove = r.top - th - 6;
    tip.style.left = left + 'px';
    tip.style.top = (topAbove < 8 ? r.bottom + 6 : topAbove) + 'px';
    tip.style.opacity = '1';
  }

  function hideTip(){
    clearTimeout(hideTimer);
    hideTimer = setTimeout(() => { tip.style.opacity = '0'; }, 80);
  }

  function hideTipNow(){
    clearTimeout(hideTimer);
    clearTimeout(touchHideTimer);
    tip.style.opacity = '0';
    lastTouchBtn = null;
  }

  // ── Mouse (desktop) ──
  document.addEventListener('mouseover', (e) => {
    const btn = e.target && e.target.closest('#pfViewAffinity .pf-affinityOption');
    if (btn) showTip(btn, false);
  }, true);

  document.addEventListener('mouseout', (e) => {
    const btn = e.target && e.target.closest('#pfViewAffinity .pf-affinityOption');
    if (btn) hideTip();
  }, true);

  // ── Touch (móvil): siempre mostrar al tocar ──
  document.addEventListener('touchstart', (e) => {
    const btn = e.target && e.target.closest('#pfViewAffinity .pf-affinityOption');
    if (btn){
      if (lastTouchBtn === btn && tip.style.opacity === '1'){
        hideTipNow();
        return;
      }
      lastTouchBtn = btn;
      showTip(btn, true); // forceShow: ignorar scrollWidth en touch
      clearTimeout(touchHideTimer);
      touchHideTimer = setTimeout(hideTipNow, 2000);
    } else {
      hideTipNow();
    }
  }, true);

  document.addEventListener('click', (e) => {
    const btn = e.target && e.target.closest('#pfViewAffinity .pf-affinityOption');
    if (!btn) { tip.style.opacity = '0'; }
  }, true);
})();
</script>
