  }

  document.addEventListener('click', (e) => {
    const t = e.target;
    const inFilter = t && (t.closest('#pfFeedFilterMenu') || t.closest('#pfFeedFilterBtn'));
    const inSort   = t && (t.closest('#pfFeedSortMenu')   || t.closest('#pfFeedSortBtn'));
    if (!inFilter && !inSort) closeFeedMenus();
  }, true);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeFeedMenus();
