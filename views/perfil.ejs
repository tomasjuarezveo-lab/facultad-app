/* =========================
   ✅ Bottom Dock (arriba del menú inferior del layout)
========================= */
/* =========================
   ✅ Left Sidebar Dock (solo perfil.ejs) — CAROUSEL al expandir
   - retraído: muestra 3 perfiles en columna
   - expandido: 1 perfil grande + flechas izq/der
   - iconos: retraído negro / expandido gris (solo LIGHT)
========================= */
:root{
  --pf-leftDock-w: 74px;
  --pf-leftDock-w-open: 210px;
  --pf-leftDock-x: 12px;
  --pf-leftDock-radius: 22px;
}

/* Dock base */
#pfBottomDock.pf-bottomDock{
  position: fixed;

  left: var(--pf-leftDock-x) !important;
  top: 50% !important;
  bottom: auto !important;
  right: auto !important;
  transform: translateY(-50%) !important;

  width: var(--pf-leftDock-w) !important;
  height: auto !important;

  border-radius: var(--pf-leftDock-radius);
  z-index: 9990;
  box-sizing: border-box;

  padding: 10px 8px;
  display:flex;
  align-items:center;
  justify-content:center;

  transition: width .18s ease, background .18s ease, border-color .18s ease, box-shadow .18s ease;
}

/* LIGHT dock */
html:not(.cw-dark) #pfBottomDock.pf-bottomDock{
  background: rgba(255,255,255,.78);
  border: 1px solid rgba(15,23,42,.10);
  box-shadow: 0 22px 60px rgba(15,23,42,.12);
  backdrop-filter: blur(16px) saturate(150%);
  -webkit-backdrop-filter: blur(16px) saturate(150%);
}

/* DARK dock */
html.cw-dark #pfBottomDock.pf-bottomDock{
  background: rgba(17,24,39,.70);
  border: 1px solid rgba(255,255,255,.12);
  box-shadow: 0 22px 60px rgba(0,0,0,.45);
  backdrop-filter: blur(16px) saturate(150%);
  -webkit-backdrop-filter: blur(16px) saturate(150%);
}

/* Expandido */
#pfBottomDock.is-expanded{
  width: var(--pf-leftDock-w-open) !important;
}

/* Contenido interno: vertical */
.pf-bottomDockLeft{
  display:flex;
  flex-direction: column;
  align-items:center;
  justify-content:center;
  gap: 10px;
  min-width: 0;
  width: 100%;
}

/* Avatar arriba */
.pf-bottomDockAva{
  width: 42px;
  height: 42px;
  border-radius: 9999px;
  overflow:hidden;
  flex: 0 0 auto;
  background: rgba(255,255,255,.20);
  border: 1px solid rgba(15,23,42,.08);
}
html.cw-dark .pf-bottomDockAva{
  border-color: rgba(255,255,255,.14);
}
.pf-bottomDockAva img{
  width:100%;
  height:100%;
  object-fit: cover;
  display:block;
}

/* Separadores */
.pf-bottomDockSep{
  width: 44px;
  height: 1px;
  border-radius: 9999px;
  flex: 0 0 auto;
}
html:not(.cw-dark) .pf-bottomDockSep{ background: rgba(15,23,42,.18); }
html.cw-dark .pf-bottomDockSep{ background: rgba(255,255,255,.18); }

/* Botones SVG: columna */
.pf-bottomDockBtns{
  display:flex;
  flex-direction: column;
  align-items:center;
  gap: 10px;
  flex: 0 0 auto;
}

.pf-bottomDockIconBtn{
  width: 40px;
  height: 40px;
  border-radius: 16px;

  border: none;
  background: transparent;
  box-shadow: none;
  padding: 0;

  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  display:grid;
  place-items:center;

  transition: color .18s ease, transform .12s ease;
}
.pf-bottomDockIconBtn svg{
  width: 18px;
  height: 18px;
}
.pf-bottomDockIconBtn:active{
  transform: translateY(1px) scale(.99);
}

/* ✅ ICONOS: retraído negro / expandido gris (LIGHT) */
/* ✅ ICONOS: retraído NEGRO / expandido GRIS (LIGHT) */
html:not(.cw-dark) #pfBottomDock:not(.is-expanded) .pf-bottomDockIconBtn{
  color: rgba(0,0,0,.96) !important;
}
html:not(.cw-dark) #pfBottomDock:not(.is-expanded) .pf-bottomDockIconBtn svg{
  color: rgba(0,0,0,.96) !important;
}
html:not(.cw-dark) #pfBottomDock:not(.is-expanded) .pf-bottomDockIconBtn svg [stroke]{
  stroke: rgba(0,0,0,.96) !important;
}
html:not(.cw-dark) #pfBottomDock:not(.is-expanded) .pf-bottomDockIconBtn svg [fill]:not([fill="none"]){
  fill: rgba(0,0,0,.96) !important;
}

html:not(.cw-dark) #pfBottomDock.is-expanded .pf-bottomDockIconBtn{
  color: rgba(15,23,42,.55) !important;
}
html:not(.cw-dark) #pfBottomDock.is-expanded .pf-bottomDockIconBtn svg{
  color: rgba(15,23,42,.55) !important;
}
html:not(.cw-dark) #pfBottomDock.is-expanded .pf-bottomDockIconBtn svg [stroke]{
  stroke: rgba(15,23,42,.55) !important;
}
html:not(.cw-dark) #pfBottomDock.is-expanded .pf-bottomDockIconBtn svg [fill]:not([fill="none"]){
  fill: rgba(15,23,42,.55) !important;
}

/* ✅ DARK: claros */
html.cw-dark #pfBottomDock .pf-bottomDockIconBtn{ color: rgba(243,244,246,.92); }
html.cw-dark #pfBottomDock.is-expanded .pf-bottomDockIconBtn{ color: rgba(243,244,246,.72); }

/* Usuarios: columna (retraído) */
.pf-bottomDockPeopleBox{
  width: 100%;
  border-radius: 18px;
  padding: 6px 6px;

  display:flex;
  flex-direction: column;
  align-items:center;
  gap: 6px;

  max-height: 156px;
  overflow: hidden;

  box-sizing: border-box;
}
html:not(.cw-dark) .pf-bottomDockPeopleBox{
  background: rgba(15,23,42,.04);
  border: 1px solid rgba(15,23,42,.08);
}
html.cw-dark .pf-bottomDockPeopleBox{
  background: rgba(0,0,0,.22);
  border: 1px solid rgba(255,255,255,.10);
}

/* ✅ Retract: mostrar solo 3 perfiles */
#pfBottomDock:not(.is-expanded) .pf-bottomDockPeopleBox a.pf-bottomDockPerson:nth-of-type(n+4){
  display:none !important;
}

.pf-bottomDockPerson{
  width: 34px;
  height: 34px;
  border-radius: 9999px;
  overflow:hidden;
  display:block;
  flex: 0 0 auto;
}
html:not(.cw-dark) .pf-bottomDockPerson{
  background: rgba(15,23,42,.06);
  border: 1px solid rgba(15,23,42,.08);
}
html.cw-dark .pf-bottomDockPerson{
  background: rgba(255,255,255,.14);
  border: 1px solid rgba(255,255,255,.12);
}
.pf-bottomDockPerson img{
  width:100%;
  height:100%;
  object-fit: cover;
  display:block;
}
.pf-bottomDockPersonEmpty{
  width:100%;
  height:100%;
  display:grid;
  place-items:center;
  background: transparent;
}
.pf-bottomDockPersonEmpty svg{
  width: 72%;
  height: 72%;
  display:block;
}

/* ✅ Expandido: ocultar lista y mostrar carousel */
#pfBottomDock.is-expanded .pf-bottomDockPeopleBox{
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  overflow: visible !important;
  max-height: none !important;
}

/* Carousel UI (inyectado por JS) */
.pfDockCarousel{
  width: 100%;
  display:flex;
  align-items:center;
  justify-content:center;
  gap: 10px;
  padding: 8px 0 0;
  box-sizing: border-box;
}

.pfDockCarouselBtn{
  width: 34px;
  height: 34px;
  border-radius: 12px;
  border: 1px solid rgba(15,23,42,.10);
  background: rgba(255,255,255,.72);
  display:grid;
  place-items:center;
  cursor:pointer;
  padding: 0;
  -webkit-tap-highlight-color: transparent;
}
.pfDockCarouselBtn svg{ width: 18px; height: 18px; color: rgba(15,23,42,.80); }
.pfDockCarouselBtn:active{ transform: translateY(1px) scale(.99); }

html.cw-dark .pfDockCarouselBtn{
  background: rgba(17,24,39,.60);
  border-color: rgba(255,255,255,.10);
}
html.cw-dark .pfDockCarouselBtn svg{
  color: rgba(243,244,246,.90);
}

.pfDockCarouselSlot{
  width: 126px;
  height: 126px;
  display:grid;
  place-items:center;
}

.pfDockCarouselSlot .pf-bottomDockPerson{
  width: 120px !important;
  height: 120px !important;
  border-radius: 9999px !important;
  border-width: 2px !important;
}

/* Mantengo tu lógica de clicks */
#pfBottomDock{ pointer-events: none; }
#pfBottomDock *{ pointer-events: auto; }

