function pfEnsureDockFallbackForImg(img){
  if (!img || img.dataset.pfDockFallbackBound === "1") return;
  img.dataset.pfDockFallbackBound = "1";

  const parent = img.parentElement;
  if (!parent) return;

  // Asegurar overlay correcto
  const pStyle = window.getComputedStyle(parent);
  if (pStyle.position === "static") parent.style.position = "relative";

  const addFallback = () => {
    // si la imagen existe y cargó bien -> sacar fallback
    if (img.getAttribute("src") && img.naturalWidth > 0 && img.naturalHeight > 0) {
      const ex = parent.querySelector(".pf-dockAvaFallback");
      if (ex) ex.remove();
      img.style.visibility = "visible";
      return;
    }

    // si no hay foto -> poner fallback 
    if (!parent.querySelector(".pf-dockAvaFallback")) {
      const span = document.createElement("span");
      span.className = "pf-dockAvaFallback";
      span.innerHTML = PF_DOCK_FALLBACK_SVG;
      parent.appendChild(span);
    }
    img.style.visibility = "hidden";
  };

  img.addEventListener("error", addFallback);
  img.addEventListener("load", addFallback);

  // chequeo inicial
  setTimeout(addFallback, 0);
}

function pfApplyDockAvatarFallback(){
  const dock = document.getElementById("pfBottomDock");
  if (!dock) return;

  // 1) imgs (caso más común)
  dock.querySelectorAll("img").forEach(pfEnsureDockFallbackForImg);

  // 2) placeholders sin img (si existen con clase pf-avaEmpty dentro del dock)
  dock.querySelectorAll(".pf-avaEmpty").forEach(el => {
    const st = window.getComputedStyle(el);
    if (st.position === "static") el.style.position = "relative";
    if (!el.querySelector(".pf-dockAvaFallback")) {
      const span = document.createElement("span");
      span.className = "pf-dockAvaFallback";
      span.innerHTML = PF_DOCK_FALLBACK_SVG;
      el.appendChild(span);
    }
  });
}

// correr al cargar
document.addEventListener("DOMContentLoaded", () => {
  pfApplyDockAvatarFallback();

  // si el dock se re-renderiza por JS, re-aplicar automáticamente
  const dock = document.getElementById("pfBottomDock");
  if (!dock) return;

  const obs = new MutationObserver(() => pfApplyDockAvatarFallback());
  obs.observe(dock, { childList: true, subtree: true, attributes: true });
});
