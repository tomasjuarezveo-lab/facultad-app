  // =========================
  // Modal Editar Foto
  // =========================
  // =========================
  // Modal Editar Foto
  // =========================
  const modal = $('pfIgModal');
  const openPhotoBtn = $('pfPhotoPencilBtn');
  const closePhotoBtn = $('pfIgCancel');

  const avaGrid = $('pfPhotoAvaGrid');
  const avaSave = $('pfPhotoAvatarSave');

  const prevBtn = $('pfAvaPrevBtn');
  const nextBtn = $('pfAvaNextBtn');

  const avatarButtons = avaGrid ? Array.from(avaGrid.querySelectorAll('.pf-photoAva')) : [];

    let selectedAvatarUrl = '';
  let activeCarouselIndex = avatarButtons.length >= 3 ? 2 : 0;
  let isCarouselAnimating = false;
  let queuedCarouselStep = 0;
  let carouselAnimationTimer = null;
  const CAROUSEL_ANIMATION_MS = 360;

  function wrapPhotoIndex(i){
    const total = avatarButtons.length;
    if (!total) return 0;
    return ((i % total) + total) % total;
  }

  function clearAvatarSelection(){
    avatarButtons.forEach((btn) => {
      btn.classList.remove('is-prev2', 'is-prev', 'is-center', 'is-next', 'is-next2', 'is-on');
    });
  }

  function applyPhotoCarousel(){
    if (!avatarButtons.length) return;

    clearAvatarSelection();

    const prev2Index  = wrapPhotoIndex(activeCarouselIndex - 2);
    const prevIndex   = wrapPhotoIndex(activeCarouselIndex - 1);
    const centerIndex = wrapPhotoIndex(activeCarouselIndex);
    const nextIndex   = wrapPhotoIndex(activeCarouselIndex + 1);
    const next2Index  = wrapPhotoIndex(activeCarouselIndex + 2);

    avatarButtons[prev2Index].classList.add('is-prev2');
    avatarButtons[prevIndex].classList.add('is-prev');
    avatarButtons[centerIndex].classList.add('is-center', 'is-on');
    avatarButtons[nextIndex].classList.add('is-next');
    avatarButtons[next2Index].classList.add('is-next2');

    selectedAvatarUrl = avatarButtons[centerIndex].getAttribute('data-url') || '';

    const previewImg = document.getElementById('pfAvaPreviewImg');
    if (previewImg && selectedAvatarUrl){
      previewImg.src = selectedAvatarUrl;
      previewImg.style.display = 'block';
    }

    if (modal){
      const safePhotoBg = selectedAvatarUrl ? String(selectedAvatarUrl).replace(/"/g, '\\"') : '';
      modal.style.setProperty('--pf-photo-bg', safePhotoBg ? `url("${safePhotoBg}")` : 'none');
    }

    if (avaSave) avaSave.disabled = !selectedAvatarUrl;
  }

  function setActivePhotoIndex(index){
    activeCarouselIndex = wrapPhotoIndex(index);
    applyPhotoCarousel();
  }

  function finishQueuedCarouselStep(){
    isCarouselAnimating = false;

    if (!queuedCarouselStep) return;

    const nextStep = queuedCarouselStep;
    queuedCarouselStep = 0;
    stepPhotoCarousel(nextStep);
  }

  function stepPhotoCarousel(step){
    const normalizedStep = step < 0 ? -1 : 1;

    if (isCarouselAnimating){
      queuedCarouselStep = normalizedStep;
      return;
    }

    isCarouselAnimating = true;
    queuedCarouselStep = 0;
    setActivePhotoIndex(activeCarouselIndex + normalizedStep);

    clearTimeout(carouselAnimationTimer);
    carouselAnimationTimer = setTimeout(finishQueuedCarouselStep, CAROUSEL_ANIMATION_MS);
  }

  function openModal(){
    if (!modal) return;

    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.documentElement.classList.add('pf-lock');
    document.body.classList.add('pf-lock');

    activeCarouselIndex = avatarButtons.length >= 3 ? 2 : 0;
    isCarouselAnimating = false;
    queuedCarouselStep = 0;
    clearTimeout(carouselAnimationTimer);
    applyPhotoCarousel();
  }

  function closeModal(){
    if (!modal) return;

    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.documentElement.classList.remove('pf-lock');
    document.body.classList.remove('pf-lock');
    isCarouselAnimating = false;
    queuedCarouselStep = 0;
    clearTimeout(carouselAnimationTimer);
  }

  async function saveAvatar(url){
    if (!url) return;
    await tryUpdateProfile({ avatarUrl: url });
  }

  if (openPhotoBtn) openPhotoBtn.addEventListener('click', () => {
    if (isOwn) openModal();
  });

  if (closePhotoBtn) closePhotoBtn.addEventListener('click', closeModal);

  if (modal){
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (!modal.classList.contains('is-open')) return;

      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowLeft') stepPhotoCarousel(1);
      if (e.key === 'ArrowRight') stepPhotoCarousel(-1);
    });
  }

  if (prevBtn) prevBtn.addEventListener('click', () => {
    stepPhotoCarousel(1);
  });

  if (nextBtn) nextBtn.addEventListener('click', () => {
    stepPhotoCarousel(-1);
  });

  if (avaGrid){
    avaGrid.addEventListener('click', (e) => {
      const btn = e.target && e.target.closest('.pf-photoAva');
      if (!btn || isCarouselAnimating) return;

      const idx = avatarButtons.indexOf(btn);
      if (idx === -1) return;

      setActivePhotoIndex(idx);
    });
  }

  if (avaSave){
    avaSave.addEventListener('click', async () => {
      if (!selectedAvatarUrl) return;
      try{
        await saveAvatar(selectedAvatarUrl);
        location.reload();
      }catch(_){}
    });
  }

  const deleteAvatarBtn = document.getElementById('pfPhotoDeleteAvatarBtn');
  if (deleteAvatarBtn){
    deleteAvatarBtn.addEventListener('click', async () => {
      if (!confirm('¿Eliminar tu foto de perfil y volver al avatar por defecto?')) return;
      try{
        await tryUpdateProfile({ avatarUrl: '' });
        location.reload();
      }catch(_){
        alert('No se pudo eliminar la foto.');
      }
    });
  }

  function initAgendaOnce(){
    if (agendaInited) return;
    agendaInited = true;

    let agendaSelectedColor = '#22c55e';

    function setActiveAgendaColor(color){
      agendaSelectedColor = String(color || '#22c55e');

      const dots = document.querySelectorAll('#pfAgendaColorRow .pf-colorDot');
      dots.forEach(d => {
        const c = d.getAttribute('data-color') || '#22c55e';
        d.style.background = c;                 // ✅ setea color real
        d.classList.toggle('is-on', String(c) === agendaSelectedColor);
      });
    }

    // ✅ elegir color
    const colorRow = $('pfAgendaColorRow');
    if (colorRow){
      colorRow.addEventListener('click', (e) => {
        const dot = e.target && e.target.closest('.pf-colorDot');
        if (!dot) return;
        const c = dot.getAttribute('data-color') || '#22c55e';
        setActiveAgendaColor(c);
      });
    }

    // ✅ botones rápidos (hoy/semana/mes)
    document.querySelectorAll('#pfAgendaModal .pf-qbtn').forEach(btn => {
      btn.addEventListener('click', () => {
        const m = $('pfAgendaModal');
        if (!m || !m.dataset.date) return;

        document.querySelectorAll('#pfAgendaModal .pf-qbtn').forEach(b => b.classList.remove('is-on'));
        btn.classList.add('is-on');

        const q = btn.getAttribute('data-q');
        const fromEl = $('pfAgendaFromDT');
        const toEl   = $('pfAgendaToDT');
        if (!fromEl || !toEl || !fromEl.value) return;

        const from = new Date(fromEl.value);
        if (Number.isNaN(from.getTime())) return;

        let to = new Date(from);

        if (q === 'today'){
          to = new Date(from);
          to.setHours(23,59,0,0);
        }else if (q === 'week'){
          to = new Date(from.getTime() + 7*24*60*60*1000);
        }else if (q === 'month'){
          to = new Date(from);
          to.setMonth(to.getMonth() + 1);
        }

        toEl.value = toDTLocalValue(to);
      });
    });

    agenda.month = new Date();
    agenda.month = new Date(agenda.month.getFullYear(), agenda.month.getMonth(), 1);

    const prev = $('pfAgendaPrev');
    const next = $('pfAgendaNext');
    const close = $('pfAgendaClose');
    const text = $('pfAgendaText');
    const count = $('pfAgendaCountNow');
    const save = $('pfAgendaSave');
    const del = $('pfAgendaDelete');
    const repeatBtn = $('pfAgendaRepeatBtn');
    const repeatBox = $('pfAgendaRepeatBox');

    if (prev){
      prev.addEventListener('click', () => {
        agenda.month = new Date(agenda.month.getFullYear(), agenda.month.getMonth()-1, 1);
        agendaSelectedDate = new Date(agenda.month.getFullYear(), agenda.month.getMonth(), 1);
        setSideDate(agendaSelectedDate);
        renderAgenda();
      });
    }
    if (next){
      next.addEventListener('click', () => {
        agenda.month = new Date(agenda.month.getFullYear(), agenda.month.getMonth()+1, 1);
        agendaSelectedDate = new Date(agenda.month.getFullYear(), agenda.month.getMonth(), 1);
        setSideDate(agendaSelectedDate);
        renderAgenda();
      });
    }
    if (close) close.addEventListener('click', closeAgendaModal);

    const modal = $('pfAgendaModal');
    if (modal){
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeAgendaModal();
      });
    }
    document.addEventListener('keydown', (e) => {
      const m = $('pfAgendaModal');
      if (!m || !m.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeAgendaModal();
    });

    if (text){
      text.addEventListener('input', () => {
        if (count) count.textContent = String(text.value.length);
      });
    }

    if (repeatBtn){
      repeatBtn.addEventListener('click', () => {
        const m = $('pfAgendaModal');
        if (!m) return;
        const date = m.dataset.date;
        if (!date) return;

        const item = agenda.data[date] || { text:'', color:'#0f172a', repeat:null };
        const nowOn = !item.repeat;
        item.repeat = nowOn ? { dows: [], from:'', to:'', exceptHolidays:false } : null;
        agenda.data[date] = item;
        saveAgenda(agenda.data);

        repeatBtn.classList.toggle('is-on', nowOn);
        if (repeatBox) repeatBox.style.display = nowOn ? 'block' : 'none';
      });
    }

    // save
    if (save){
      save.addEventListener('click', () => {
        const m = $('pfAgendaModal');
        if (!m) return;
        const date = m.dataset.date;
        if (!date) return;

        const titleEl = $('pfAgendaTitle');
        const textEl  = $('pfAgendaText');
        const fromEl  = $('pfAgendaFromDT');
        const toEl    = $('pfAgendaToDT');
        const impEl   = $('pfAgendaImportant');

        const item = agenda.data[date] || {};
        item.title = titleEl ? String(titleEl.value || '').trim() : '';
        item.text  = textEl  ? String(textEl.value || '') : '';
        item.color = agendaSelectedColor || '#22c55e';
        item.from  = fromEl ? String(fromEl.value || '') : '';
        item.to    = toEl   ? String(toEl.value || '') : '';
        item.important = !!(impEl && impEl.checked);

        agenda.data[date] = item;
        saveAgenda(agenda.data);

        closeAgendaModal();
        renderAgenda();
      });
    }

    // delete
    if (del){
      del.addEventListener('click', () => {
        const m = $('pfAgendaModal');
        if (!m) return;
        const date = m.dataset.date;
        if (!date) return;
        delete agenda.data[date];
        saveAgenda(agenda.data);
        closeAgendaModal();
        renderAgenda();
      });
    }

    renderAgenda();
  }

  // =========================
  // Init defaults
  // =========================
  setSection(activeSection);
  setTab('perfil');
})();

(function(){
  const IS_OWN = <%- JSON.stringify(!!isOwn) %>;
  if (IS_OWN) return;

  const btn = document.getElementById('pfEditProfileBtn');
  if (!btn) return;

  const followersEl = document.getElementById('pfFollowersCount');
  const targetUid = <%- JSON.stringify(String(uId || '')) %>;

  let busy = false;

  btn.addEventListener('click', async () => {
    if (busy) return;
    busy = true;

    const prevText = btn.textContent;
    btn.disabled = true;
    btn.textContent = '…';

    try{
      const r = await fetch('/app/perfil/follow/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ uid: targetUid })
      });

      const j = await r.json().catch(()=> ({}));
      if (!r.ok || !j || !j.ok) throw new Error(j.error || 'Error');

      const following = !!j.following;
      btn.textContent = following ? 'Seguido' : 'Seguir';

      // actualiza seguidores del perfil visto
      const n = Number(j.targetFollowers ?? j.followersCount);
      if (followersEl && Number.isFinite(n)) followersEl.textContent = String(n);

    }catch(e){
      console.error('follow toggle failed:', e);
      btn.textContent = prevText || 'Seguir';
      alert('No se pudo actualizar el seguimiento.');
    }finally{
      btn.disabled = false;
      busy = false;
    }
  });
})();

/* =========================
   ✅ Left Dock: expand/retract + carousel de 3 perfiles
   - retraído: 3 perfiles en columna (ya lo hace CSS)
   - expandido: 1 perfil grande + flechas izq/der
========================= */
(function(){
  const dock = document.getElementById('pfBottomDock');
  if (!dock) return;

  const peopleBox = dock.querySelector('.pf-bottomDockPeopleBox');
  if (!peopleBox) return;

  const allPeople = Array.from(peopleBox.querySelectorAll('a.pf-bottomDockPerson'));
  const items = allPeople.slice(0, 3); // ✅ solo 3 perfiles
  if (items.length < 2) return;

  let idx = 0;
  let enabled = false;

  const stash = document.createElement('div');
  stash.style.display = 'none';

  const carousel = document.createElement('div');
  carousel.className = 'pfDockCarousel';

  const btnPrev = document.createElement('button');
  btnPrev.type = 'button';
  btnPrev.className = 'pfDockCarouselBtn';
  btnPrev.setAttribute('aria-label','Perfil anterior');
  btnPrev.innerHTML = `
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M14.5 6L8.5 12L14.5 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  `;

  const slot = document.createElement('div');
  slot.className = 'pfDockCarouselSlot';

  const btnNext = document.createElement('button');
  btnNext.type = 'button';
  btnNext.className = 'pfDockCarouselBtn';
  btnNext.setAttribute('aria-label','Siguiente perfil');
  btnNext.innerHTML = `
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M9.5 6L15.5 12L9.5 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  `;

  carousel.appendChild(btnPrev);
  carousel.appendChild(slot);
  carousel.appendChild(btnNext);

  function mountIndex(){
    const cur = slot.firstElementChild;
    if (cur) stash.appendChild(cur);

    const node = items[idx];
    if (node) slot.appendChild(node);
  }

  function enableCarousel(){
    if (enabled) return;
    enabled = true;

    dock.classList.add('is-expanded');

    // insertar UI
    peopleBox.insertBefore(carousel, peopleBox.firstChild);
    peopleBox.appendChild(stash);

    // mover los 3 al stash y montar el primero
    items.forEach(n => stash.appendChild(n));
    idx = 0;
    mountIndex();
  }

  function disableCarousel(){
    if (!enabled) return;
    enabled = false;

    dock.classList.remove('is-expanded');

    // devolver el actual al stash
    const cur = slot.firstElementChild;
    if (cur) stash.appendChild(cur);

    // sacar UI
    if (carousel.parentNode) carousel.parentNode.removeChild(carousel);

    // devolver los 3 en orden al peopleBox (así vuelven “uno arriba del otro”)
    items.forEach(n => peopleBox.appendChild(n));

    // remover stash
    if (stash.parentNode) stash.parentNode.removeChild(stash);
  }

  btnPrev.addEventListener('click', () => {
    idx = (idx - 1 + items.length) % items.length;
    mountIndex();
  });
  btnNext.addEventListener('click', () => {
    idx = (idx + 1) % items.length;
    mountIndex();
  });

  // Expand/retract por hover (desktop)
  let t = null;
  dock.addEventListener('mouseenter', () => {
    clearTimeout(t);
    enableCarousel();
  });
  dock.addEventListener('mouseleave', () => {
    clearTimeout(t);
    t = setTimeout(disableCarousel, 140);
  });

  // Toggle por click en avatar (mobile/touch)
  const ava = dock.querySelector('.pf-bottomDockAva');
  if (ava){
    ava.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      enabled ? disableCarousel() : enableCarousel();
    });
  }

  // Click afuera => retrae
  document.addEventListener('click', (e) => {
    if (!dock.contains(e.target)) disableCarousel();
  });
})();

