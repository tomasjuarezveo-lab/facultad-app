// =========================
// Composer (tags + publicar)
// =========================
const picked = {
  subjects: [],
  people: []
};

function wirePicker(pfx){
  const txt = $(pfx === 'Feed' ? 'pfPostTextFeed' : 'pfPostText');
  const wc  = $(pfx === 'Feed' ? 'pfWordsNowFeed' : 'pfWordsNow');
  const btnSub = $(pfx === 'Feed' ? 'pfTagSubjectBtnFeed' : 'pfTagSubjectBtn');
  const btnPer = $(pfx === 'Feed' ? 'pfTagPersonBtnFeed' : 'pfTagPersonBtn');
  const btnPub = $(pfx === 'Feed' ? 'pfPublishBtnFeed' : 'pfPublishBtn');

  // Search inputs (si existen en tu HTML)
  const subSearch = $('pfSubjectSearch');
  const perSearch = $('pfPeopleSearch');

  const line = $(pfx === 'Feed' ? 'pfPickedLineFeed' : 'pfPickedLine');

  const pickerSub = $(pfx === 'Feed' ? 'pfPickerSubjectsFeed' : 'pfPickerSubjects');
  const pickerPer = $(pfx === 'Feed' ? 'pfPickerPeopleFeed' : 'pfPickerPeople');

  const gridSub = $(pfx === 'Feed' ? 'pfSubjectsGridFeed' : 'pfSubjectsGrid');
  const listPer = $(pfx === 'Feed' ? 'pfPeopleListFeed' : 'pfPeopleList');

  const localPicked = {
    subjects: [],
    people: []
  };

  const ns = (v) => norm(String(v || ''));

  function refreshPicked(){
    renderPickedLine(line);

    // word count + publish enable
    const w = wordCount(txt ? txt.value : '');
    if (wc) wc.textContent = String(w);

    const ok = (w > 0 && w <= 150);
    if (btnPub) btnPub.disabled = !ok;
    if (btnPub) btnPub.style.opacity = ok ? '1' : '.55';
    if (btnPub) btnPub.style.cursor = ok ? 'pointer' : 'not-allowed';
  }

  function renderPickedLine(el){
    if (!el) return;

    const tags = [];
    for (const sid of localPicked.subjects){
      const s = (SUBJECTS || []).find(x => String(x.id) === String(sid));
      if (s) tags.push({ type:'s', id:sid, text:'@' + String(s.name) });
    }
        for (const pid of localPicked.people){
      const raw = String(pid || '');
      if (!raw) continue;

      if (raw.startsWith('prof:')){
        const profId = raw.slice(5);
        const pr = (PROFESSORS || []).find(x => String(x.id) === String(profId));
        if (pr) tags.push({ type:'p', id:raw, text:'@' + String(pr.name || 'Profesor') });
        continue;
      }

      const p = (USERS || []).find(x => String(x.id) === String(raw));
      if (p) tags.push({ type:'p', id:raw, text:'@' + String(p.name) });
    }

    el.innerHTML = tags
      .map(t => `<span class="pf-pickedTag" data-type="${t.type}" data-id="${escapeHtml(String(t.id))}">${escapeHtml(String(t.text))}</span>`)
      .join('');

    // click para quitar
    el.querySelectorAll('.pf-pickedTag').forEach(tag => {
      tag.addEventListener('click', () => {
        const type = tag.getAttribute('data-type');
        const id = tag.getAttribute('data-id');

        if (type === 's'){
          localPicked.subjects = localPicked.subjects.filter(x => String(x) !== String(id));
          renderSubjectsGrid(gridSub, localPicked.subjects);
        }else{
          localPicked.people = localPicked.people.filter(x => String(x) !== String(id));
          renderPeopleList(listPer, localPicked.people);
        }
        refreshPicked();
      });
    });
  }

  function renderSubjectsGrid(gridEl, pickedArr){
    if (!gridEl) return;

    const q = ns(subSearch ? subSearch.value : '');
    const filtered = q
      ? (SUBJECTS || []).filter(s => ns(s.name).includes(q))
      : (SUBJECTS || []);

    const html = filtered.map(s => {
      const on = pickedArr.includes(String(s.id));
      return `<button type="button" class="pf-pickBtn ${on ? 'is-on' : ''}" data-id="${escapeHtml(String(s.id))}">${escapeHtml(String(s.name))}</button>`;
    }).join('');

    gridEl.innerHTML = html;

    gridEl.querySelectorAll('.pf-pickBtn').forEach(b => {
      b.addEventListener('click', () => {
        const id = b.getAttribute('data-id');
        if (!id) return;

        const has = localPicked.subjects.includes(String(id));
        if (has) localPicked.subjects = localPicked.subjects.filter(x => String(x) !== String(id));
        else localPicked.subjects = localPicked.subjects.concat([String(id)]);

        renderSubjectsGrid(gridEl, localPicked.subjects);
        refreshPicked();
      });
    });
  }

    function renderPeopleList(listEl, pickedArr){
    if (!listEl) return;

    const q = ns(perSearch ? perSearch.value : '');

    const usersBase = (USERS || [])
      .filter(x => String(x.id||'') && String(x.id||'') !== String(viewerId||''))
      .map(u => ({
        kind: 'user',
        id: String(u.id),
        name: String(u.name || 'Usuario'),
        sub: buildCareer(u.career, u.plan),
        raw: buildCareer(u.career, u.plan),
        av: String(u.avatarUrl || '')
      }));

    const profBase = (PROFESSORS || [])
      .filter(x => String(x.id||''))
      .map(pr => {
        const st = String(pr.subjects_text || '').trim();
        const first = st.split(',').map(s=>s.trim()).filter(Boolean)[0] || '';
        const sub = first ? ('Profesor · ' + first) : 'Profesor';
        return {
          kind: 'prof',
          id: 'prof:' + String(pr.id),
          name: String(pr.name || 'Profesor'),
          sub,
          raw: st,
          av: String(pr.photo_url || '')
        };
      });

    const base = usersBase.concat(profBase);

    const filtered = q
      ? base.filter(p => ns(p.name).includes(q) || ns(p.sub).includes(q) || ns(p.raw).includes(q))
      : base;

    filtered.sort((a,b) => ns(a.name).localeCompare(ns(b.name)));

    const html = filtered.map(p => {
      const pid = String(p.id);
      const on = pickedArr.includes(pid);
      const av = String(p.av || '');
      const ctext = String(p.sub || '');

      return `
        <div class="pf-pickPerson ${on ? 'is-on' : ''}" role="button" tabindex="0" data-id="${escapeHtml(pid)}">
          <div class="pf-pickPersonAva">
            ${av ? `<img src="${escapeHtml(av)}" alt=""/>` : `<div class="pf-avaEmpty" aria-hidden="true"></div>`}
          </div>
          <div class="pf-pickPersonTxt">
            <div class="pf-pickPersonName">${escapeHtml(p.name || 'Usuario')}</div>
            <div class="pf-pickPersonCareer">${escapeHtml(ctext)}</div>
          </div>
        </div>
      `;
    }).join('');

    listEl.innerHTML = html;

    listEl.querySelectorAll('.pf-pickPerson').forEach(row => {
      const toggle = () => {
        const id = row.getAttribute('data-id');
        if (!id) return;

        const has = localPicked.people.includes(String(id));
        if (has) localPicked.people = localPicked.people.filter(x => String(x) !== String(id));
        else localPicked.people = localPicked.people.concat([String(id)]);

        renderPeopleList(listEl, localPicked.people);
        refreshPicked();
      };

      row.addEventListener('click', toggle);
      row.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
      });
    });
  }

  // Inicial
  if (gridSub) renderSubjectsGrid(gridSub, localPicked.subjects);
  if (listPer) renderPeopleList(listPer, localPicked.people);
  refreshPicked();

  // Buscadores (si están presentes)
  if (subSearch){
    subSearch.addEventListener('input', () => {
      renderSubjectsGrid(gridSub, localPicked.subjects);
    });
  }
  if (perSearch){
    perSearch.addEventListener('input', () => {
      renderPeopleList(listPer, localPicked.people);
    });
  }

    // ✅ Popover del mismo ancho que el botón (@ materia / @ persona)
  const pickerWrap = (pickerSub && pickerSub.parentElement) ? pickerSub.parentElement
                   : ((pickerPer && pickerPer.parentElement) ? pickerPer.parentElement : null);

    function positionPickerWrapToGroup(){
    if (!pickerWrap || !btnSub || !btnPer) return;

    const composer = btnSub.closest('.pf-composer') || btnPer.closest('.pf-composer');
    if (!composer) return;

    const cRect = composer.getBoundingClientRect();
    const sRect = btnSub.getBoundingClientRect();
    const pRect = btnPer.getBoundingClientRect();

    const groupLeft  = Math.min(sRect.left, pRect.left);
    const groupRight = Math.max(sRect.right, pRect.right);

    let left  = Math.round(groupLeft - cRect.left);
    const width = Math.round(groupRight - groupLeft);

    if (left < 10) left = 10;
    if (left + width > cRect.width - 10) left = Math.max(10, Math.round(cRect.width - width - 10));

    pickerWrap.style.left  = left + 'px';
    pickerWrap.style.right = 'auto';
    pickerWrap.style.width = width + 'px';
    pickerWrap.style.maxWidth = 'calc(100% - 20px)';
  }


  // Toggle pickers
  if (btnSub){
  btnSub.addEventListener('click', () => {
    if (!pickerSub) return;

    const open = (getComputedStyle(pickerSub).display !== 'none');

    if (!open) positionPickerWrapToGroup();

    pickerSub.style.display = open ? 'none' : 'block';
    if (pickerPer) pickerPer.style.display = 'none';

    renderSubjectsGrid(gridSub, localPicked.subjects);
      if (!open && subSearch) subSearch.focus();
    });
  }

  if (btnPer){
    btnPer.addEventListener('click', () => {
      if (!pickerPer) return;

      const open = (getComputedStyle(pickerPer).display !== 'none');

      if (!open) positionPickerWrapToGroup();

      pickerPer.style.display = open ? 'none' : 'block';
      if (pickerSub) pickerSub.style.display = 'none';

      renderPeopleList(listPer, localPicked.people);
      if (!open && perSearch) perSearch.focus();
    });
  }

  if (txt){
    txt.addEventListener('input', refreshPicked);
    refreshPicked();
  }

  const pubOrigHtml = btnPub ? String(btnPub.innerHTML || 'Publicar') : 'Publicar';
  function setPubLoading(on){
    if (!btnPub) return;
    if (on){
      btnPub.disabled = true;
      btnPub.setAttribute('aria-busy','true');
      btnPub.innerHTML = `<span class="pf-dotLoad">Publicando<span class="pf-dots" aria-hidden="true"></span></span>`;
    }else{
      btnPub.disabled = false;
      btnPub.removeAttribute('aria-busy');
      btnPub.innerHTML = pubOrigHtml;
    }
  }

  const PF_BLOCKED_WORDS = [
    'puto','puta','putos','putas','pelotudo','pelotuda','pelotudos','pelotudas',
    'boludo','boluda','boludos','boludas','forro','forra','forros','forras',
    'hdp','hijo de puta','hija de puta','concha','conchudo','conchuda',
    'mierda','mierdas','culo','culos','ctm','conchatumadre',
    'cogido','cogida','coger','cagar','cago','cagada','cagado',
    'marica','maricon','maricón','tortillera','trolo','trola',
    'negro de mierda','gil','otario','otaria','estupido','estupida',
    'idiota','idiotas','imbecil','imbécil','tarado','tarada',
    'fuck','shit','bitch','asshole','bastard','cunt','dick','pussy','faggot',
    'pija','verga','chota','chotas','sorete','soretes'
  ];

  function pfContainsBadWord(text){
    const lower = (text||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
    return PF_BLOCKED_WORDS.some(bw => {
      const wn = bw.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
      const re = new RegExp('(^|\\s|[^a-z])' + wn.replace(/[.*+?^${}()|[\]\\]/g,'\\$&') + '($|\\s|[^a-z])', 'i');
      return re.test(lower);
    });
  }

  async function publish(){
  if (!isOwn) return;
  if (btnPub && btnPub.disabled) return;

  const text = String(txt ? txt.value : '').trim();
  const w = wordCount(text);
  if (!text || w > 150) return;

  if (pfContainsBadWord(text)){
    alert('Tu post contiene palabras no permitidas. Por favor revisalo antes de publicar.');
    return;
  }

  setPubLoading(true);

  const tags = {
    subjects: (localPicked.subjects || []).map(id => {
      const s = (SUBJECTS || []).find(x => String(x.id) === String(id));
      return { id: String(id), name: s ? String(s.name || '') : '' };
    }).filter(x => x.id || x.name),
        people: (localPicked.people || []).map(id => {
      const raw = String(id || '');
      if (!raw) return { id:'', name:'' };

      if (raw.startsWith('prof:')){
        const pid = raw.slice(5);
        const pr = (PROFESSORS || []).find(x => String(x.id) === String(pid));
        return { id: raw, name: pr ? String(pr.name || '') : '' };
      }

      const u = (USERS || []).find(x => String(x.id) === String(raw));
      return { id: raw, name: u ? String(u.name || '') : '' };
    }).filter(x => x.id || x.name)
  };

  try{
    const j = await postJSON('/app/perfil/api/posts', { text, tags });
    if (!j || !j.ok) throw new Error((j && j.error) || 'No se pudo publicar');

    profileLoaded = false;
    feedLoaded = false;
    await renderProfilePosts();
    await renderFeedPosts();
  }catch(e){
    console.error('publish failed:', e);
    alert('No se pudo publicar. Probá de nuevo.');
    return;
  }finally{
    setPubLoading(false);
  }

  if (txt) txt.value = '';

  localPicked.subjects = [];
  localPicked.people = [];

  if (subSearch) subSearch.value = '';
  if (perSearch) perSearch.value = '';

  if (gridSub) renderSubjectsGrid(gridSub, localPicked.subjects);
  if (listPer) renderPeopleList(listPer, localPicked.people);

  if (pickerSub) pickerSub.style.display = 'none';
  if (pickerPer) pickerPer.style.display = 'none';

  refreshPicked();
}

  if (btnPub) btnPub.addEventListener('click', publish);
}
