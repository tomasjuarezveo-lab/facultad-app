  // =========================
  // Edit mode + inline edit (Nombre/Bio)
  // =========================
  const editBtn = $('pfEditProfileBtn');
  const nameText = $('pfNameText');
  const bioText  = $('pfBioText');

  const PF_ORIG_NAME = <%- JSON.stringify(String(displayName || 'Usuario')) %>;
  const PF_ORIG_BIO  = <%- JSON.stringify(String(u.bio || 'Agregá una biografía corta sobre vos.')) %>;

  let pfDraftName = PF_ORIG_NAME;
  let pfDraftBio  = PF_ORIG_BIO;

  const namePencil = $('pfNamePencilBtn');
  const bioPencil  = $('pfBioPencilBtn');

  // ✅ Edit button => "Guardar" cuando hay cambios (nombre/bio/banner)
  let pfEditDirty = false;

  function pfSetEditDirty(on){
    pfEditDirty = !!on;
    if (editBtn && isOwn){
      if (document.body.classList.contains('pf-editOn') && pfEditDirty) editBtn.textContent = 'Guardar';
      else editBtn.textContent = 'Editar';
    }
  }

  function pfMarkEditDirty(){
    if (!isOwn) return;
    pfSetEditDirty(true);
  }

  // expone para otros handlers (ej: banner)
  try{ window.__pfMarkDirty = pfMarkEditDirty; }catch(_){}


  function toggleEditMode(on){
    const enabled = (typeof on === 'boolean') ? on : !document.body.classList.contains('pf-editOn');
    document.body.classList.toggle('pf-editOn', enabled);
  }

  async function saveInline(field, value){
    const payload = {};
    payload[field] = value;
    await tryUpdateProfile(payload);
  }

  function startEditing(el){
    if (!el) return;
    el.setAttribute('contenteditable', 'true');
    el.classList.add('is-editing');
    el.focus({ preventScroll:true });
    // cursor al final
    const range = document.createRange();
    range.selectNodeContents(el);
    range.collapse(false);
    const sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
  }

  function stopEditing(el){
    if (!el) return;
    el.setAttribute('contenteditable', 'false');
    el.classList.remove('is-editing');
  }

  async function commitName(){
    if (!nameText) return;
    const val = String(nameText.textContent || '').trim();
    stopEditing(nameText);

    if (!val){
      nameText.textContent = PF_ORIG_NAME;
      pfDraftName = PF_ORIG_NAME;
      return;
    }

    pfDraftName = val;
    pfMarkEditDirty();
  }

  async function commitBio(){
    if (!bioText) return;
    const val = String(bioText.textContent || '').trim();
    stopEditing(bioText);

    pfDraftBio = val;
    pfMarkEditDirty();
  }

  if (editBtn){
    editBtn.addEventListener('click', async () => {
      if (!isOwn){
        try{
          await postJSON('/app/follow/toggle', { userId: uId });
          location.reload();
        }catch(_){}
        return;
      }

      const inEdit = document.body.classList.contains('pf-editOn');

      // entrar a editar
      if (!inEdit){
        pfSetEditDirty(false);
        toggleEditMode(true);
        return;
      }

      // si está en editar pero no hay cambios => salir
      if (!pfEditDirty){
        toggleEditMode(false);
        closeHeroModal();
        if (editBtn) editBtn.textContent = 'Editar';
        return;
      }

      // Guardar => refrescar (y vuelve a "Editar")
      // Guardar => guarda TODO (nombre + bio + banner) y recién ahí recarga
      editBtn.disabled = true;
      const prevTxt = editBtn.textContent;
      editBtn.textContent = 'Guardando…';

      try{
        if (nameText && nameText.getAttribute('contenteditable') === 'true') await commitName();
      }catch(_){}
      try{
        if (bioText && bioText.getAttribute('contenteditable') === 'true') await commitBio();
      }catch(_){}

      // asegura drafts desde DOM (por si el usuario editó y no disparó blur)
      try{
        if (nameText) pfDraftName = String(nameText.textContent || '').trim() || PF_ORIG_NAME;
      }catch(_){}
      try{
        if (bioText) pfDraftBio = String(bioText.textContent || '').trim();
      }catch(_){}

      const heroKey = String((window.__pfHeroDraft || PF_HERO_ORIG || 'sky'));
      const payload = {
        name: pfDraftName,
        bio: pfDraftBio,
        heroTheme: heroKey,
        socialLinks: (window.__pfSocialDraft && typeof window.__pfSocialDraft === 'object') ? window.__pfSocialDraft : PF_SOCIAL_LINKS
      };

      try{
        const out = await tryUpdateProfile(payload);
        if (!out || out.ok === false) throw new Error((out && out.error) || 'No se pudo guardar');

        pfSetEditDirty(false);
        toggleEditMode(false);

        editBtn.textContent = 'Editar';
        editBtn.disabled = false;

        location.reload();
        return;
      }catch(e){
        console.error('save profile failed:', e);
        alert('No se pudo guardar. Probá de nuevo.');
        editBtn.textContent = prevTxt || 'Guardar';
        editBtn.disabled = false;
        return;
      }
    });
  }

if (namePencil){
    namePencil.addEventListener('click', () => {
      if (!isOwn || !nameText) return;
      if (!document.body.classList.contains('pf-editOn')) toggleEditMode(true);
