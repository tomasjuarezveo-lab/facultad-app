function pfPad2(n){ return String(n).padStart(2,'0'); }

function pfYMD(d){
  const dt = (d instanceof Date) ? d : new Date(d);
  return dt.getFullYear() + '-' + pfPad2(dt.getMonth()+1) + '-' + pfPad2(dt.getDate());
}

function pfParseYMD(s){
  const m = String(s||'').match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return null;
  const y = Number(m[1]), mo = Number(m[2]) - 1, da = Number(m[3]);
  const dt = new Date(y, mo, da);
  if (Number.isNaN(dt.getTime())) return null;
  dt.setHours(0,0,0,0);
  return dt;
}

function pfCmpYMD(a, b){ return String(a).localeCompare(String(b)); }

function pfClampRange(a, b){
  const aa = String(a||''); const bb = String(b||'');
  if (!aa || !bb) return { from: aa, to: bb };
  return (aa <= bb) ? { from: aa, to: bb } : { from: bb, to: aa };
}

