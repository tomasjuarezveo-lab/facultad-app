function pfEventAppliesToDay(ev, day){
  const d = String(day||'');
  const from = String(ev.from||'');
  const to   = String(ev.to||'');
  if (!from || !to) return false;
  if (d < from || d > to) return false;

  const rep = (ev.repeat && typeof ev.repeat === 'object') ? ev.repeat : null;
  if (!rep || !rep.mode || rep.mode === 'none') return true;

  const dt = pfParseYMD(d);
  if (!dt) return false;

  if (rep.mode === 'weekly'){
    const arr = Array.isArray(rep.dows) ? rep.dows.map(Number) : [];
    return arr.includes(dt.getDay()); // 0=Dom, 1=Lun ...
  }

  if (rep.mode === 'monthly'){
    const arr = Array.isArray(rep.dom) ? rep.dom.map(Number) : [];
    return arr.includes(dt.getDate()); // 1..31
  }

  return true;
}

function pfGetTopEventForDay(ymd){
  const day = String(ymd||'');
  const list = (pfAgendaEvents || []).filter(e => pfEventAppliesToDay(e, day));
  if (!list.length) return null;

  list.sort((a,b) => {
    const ai = a.important ? 1 : 0;
    const bi = b.important ? 1 : 0;
    if (ai !== bi) return bi - ai;
    const c1 = pfCmpYMD(a.from, b.from);
    if (c1 !== 0) return c1;
    return String(a.title||'').localeCompare(String(b.title||''));
  });

  return list[0];
}

function pfListEventsForDay(ymd){
  const day = String(ymd||'');
  const list = (pfAgendaEvents || []).filter(e => pfEventAppliesToDay(e, day));

  const toMin = (tm) => {
    const s = String(tm||'').trim();
    if (!s) return 99999;
    const m = /^(\d{2}):(\d{2})$/.exec(s);
    if (!m) return 99999;
    const hh = Number(m[1]); const mm = Number(m[2]);
    if (!Number.isFinite(hh) || !Number.isFinite(mm)) return 99999;
    return hh*60 + mm;
  };

  list.sort((a,b) => {
    const ta = toMin(a.time);
    const tb = toMin(b.time);
    if (ta !== tb) return ta - tb;

    const ai = a.important ? 1 : 0;
    const bi = b.important ? 1 : 0;
    if (ai !== bi) return bi - ai;

    const c1 = pfCmpYMD(a.from, b.from);
    if (c1 !== 0) return c1;

    return String(a.title||'').localeCompare(String(b.title||''));
  });

  return list;
}

function pfAgendaRenderYears(){
  if (!pfAgendaYearsEl) return;

  const y = pfAgendaCursor.getFullYear();
  const start = y - 30;
  const end = y + 30;

  let html = '';
  for (let yr=start; yr<=end; yr++){
    html += `<button type="button" class="pf-yearBtn ${yr===y ? 'is-active' : ''}" data-year="${yr}">${yr}</button>`;
  }
  pfAgendaYearsEl.innerHTML = html;

  const active = pfAgendaYearsEl.querySelector('.pf-yearBtn.is-active');
  if (active){
    requestAnimationFrame(() => {
      try{ active.scrollIntoView({ block:'nearest', inline:'center', behavior:'auto' }); }catch(_){}
    });
  }
}

function pfAgendaRenderMonth(){
  if (!pfAgendaMonthLabelEl || !pfAgendaGridEl) return;

  const y = pfAgendaCursor.getFullYear();
  const m = pfAgendaCursor.getMonth();

  try{
    pfAgendaMonthLabelEl.textContent = pfAgendaCursor.toLocaleDateString('es-AR', { month:'long', year:'numeric' });
  }catch(_){
    pfAgendaMonthLabelEl.textContent = `${y}-${pfPad2(m+1)}`;
  }

  const first = new Date(y, m, 1);
  const daysInMonth = new Date(y, m+1, 0).getDate();
  const startIndex = (first.getDay() + 6) % 7; // lun=0 ... dom=6

  let html = '';
  for (let i=0;i<42;i++){
    const dayNum = i - startIndex + 1;
    if (dayNum < 1 || dayNum > daysInMonth){
      html += `<div class="pf-agendaCell is-empty" aria-hidden="true"></div>`;
      continue;
    }

    const dt = new Date(y, m, dayNum);
    const ymd = pfYMD(dt);

    const allEvs = pfListEventsForDay(ymd);
    const ev = allEvs[0] || null;
    const has = !!ev;
    const imp = !!(ev && ev.important);
    const isGlobal = !!(ev && ev.isGlobal);
    const col = (ev && ev.color) ? String(ev.color) : '#22c55e';
    const rangeClass = (ev && isGlobal) ? pfAgendaGetRangeClass(ev, ymd, i) : '';
    const evCount = allEvs.length;

    const ttRaw = ev && String(ev.title || '').trim() ? String(ev.title || '').trim() : '';
    let tt = ttRaw;
    if (tt.length > 16) tt = tt.slice(0, 16).trimEnd() + '…';

    let multiStyle = '';
    let badgeHtml = '';
    let isMulti = false;
    if (evCount >= 2) {
      isMulti = true;
      // recordatorios personales: usar color con 18% de opacidad como has-note
      // recordatorios globales (admin): usar color puro
      const getCol = (e) => {
        const c = (e.color ? String(e.color) : '#22c55e');
        if (e.isGlobal) return c;
        // simular la misma opacidad que has-note: mezcla 18% color + 82% blanco
        return `color-mix(in srgb, ${c} 18%, #fff)`;
      };
      const colors = allEvs.slice(0, 4).map(getCol);
      let grad = '';
      if (evCount === 2) {
        grad = `linear-gradient(135deg, ${colors[0]} 50%, ${colors[1]} 50%)`;
      } else if (evCount === 3) {
        grad = `linear-gradient(135deg, ${colors[0]} 33.3%, ${colors[1]} 33.3% 66.6%, ${colors[2]} 66.6%)`;
      } else {
        grad = `linear-gradient(135deg, ${colors[0]} 25%, ${colors[1]} 25% 50%, ${colors[2]} 50% 75%, ${colors[3]} 75%)`;
      }
      multiStyle = `--pf-multi-bg:${grad};`;
      badgeHtml = `<span class="pf-agendaBadge">${evCount > 9 ? '9+' : evCount}</span>`;
    }

    html += `
      <button
        type="button"
        class="pf-agendaCell ${has ? 'has-note' : ''} ${isMulti ? 'has-multi' : ''} ${imp ? 'is-important' : ''} ${isGlobal ? 'is-global' : ''} ${rangeClass}"
        data-date="${ymd}"
        style="--pf-note:${col};${multiStyle}"
        aria-label="${ymd}"
      >
        ${badgeHtml}
        <div class="pf-agendaDay">${dayNum}</div>
        ${tt ? `<div class="pf-agendaMiniTitle">${escapeHtml(tt)}</div>` : ``}
      </button>
    `;
  }

  pfAgendaGridEl.innerHTML = html;
}

function pfFormatShort(dt){
  try{ return dt.toLocaleDateString('es-AR', { day:'2-digit', month:'short', year:'numeric' }); }
  catch(_){ return ''; }
}

function pfUpdateRangeLabel(){
  if (!pfAgendaRangeLabelEl) return;
  const f = String(pfAgendaFromEl && pfAgendaFromEl.value ? pfAgendaFromEl.value.slice(0,10) : '');
  const t = String(pfAgendaToEl && pfAgendaToEl.value ? pfAgendaToEl.value.slice(0,10) : '');
  if (!f || !t){
    pfAgendaRangeLabelEl.textContent = 'Elegí fechas';
    return;
  }
  const fd = pfParseYMD(f);
  const td = pfParseYMD(t);
  const fmt = (d) => d ? `${d.getDate()}/${d.getMonth()+1}` : '';
  pfAgendaRangeLabelEl.textContent = `${fmt(fd)} → ${fmt(td)}`;
}

function pfSetRange(fromYMD, toYMD){
  const r = pfClampRange(fromYMD, toYMD);
  if (pfAgendaFromEl) pfAgendaFromEl.value = r.from ? (r.from + 'T00:00') : '';
  if (pfAgendaToEl) pfAgendaToEl.value = r.to ? (r.to + 'T00:00') : '';
  pfUpdateRangeLabel();
}

function pfUpdateRepeatSummary(){
  if (!pfAgendaRepeatSummaryEl) return;

  const rep = pfAgendaRepeat || { mode:'none' };
  if (!rep.mode || rep.mode === 'none'){
    pfAgendaRepeatSummaryEl.style.display = 'none';
    pfAgendaRepeatSummaryEl.textContent = '';
    return;
  }

  if (rep.mode === 'weekly'){
    const map = {1:'Lun',2:'Mar',3:'Mié',4:'Jue',5:'Vie',6:'Sáb',0:'Dom'};
    const txt = (rep.dows || []).map(d => map[Number(d)]).filter(Boolean).join(', ');
    pfAgendaRepeatSummaryEl.textContent = txt ? ('Días: ' + txt) : '';
  }else{
    const dom = (rep.dom || []).map(Number).filter(n => n>=1 && n<=31).sort((a,b)=>a-b);
    pfAgendaRepeatSummaryEl.textContent = dom.length ? ('Días del mes: ' + dom.join(', ')) : '';
  }

  pfAgendaRepeatSummaryEl.style.display = pfAgendaRepeatSummaryEl.textContent ? 'block' : 'none';
}

