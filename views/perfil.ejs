    if (feedSortMenu){
    feedSortMenu.querySelectorAll('.pf-feedOpt').forEach(opt => {
      opt.addEventListener('click', () => {
        feedSort = String(opt.getAttribute('data-val') || 'new');
        feedSortTouched = true;

        setSelected(feedSortMenu, feedSort);
        updateSortBtnLabel();
        closeFeedMenus();
        renderFeedPosts();
      });
