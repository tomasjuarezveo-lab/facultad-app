@media (max-width: 1200px){
  #pfViewAffinity .pf-affinitySubjectsDeck{
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  }
}
@media (max-width: 820px){
  #pfViewAffinity .pf-affinityToolbar{ flex-wrap: wrap; gap: 6px; }
  #pfViewAffinity .pf-affinityYearTabs{ flex-wrap: wrap; }
  #pfViewAffinity .pf-affinitySubjectsDeck{ grid-template-columns: 1fr 1fr; }
  #pfViewAffinity .pf-affinityHead,
  #pfViewAffinity .pf-affinityResultTop,
  #pfViewAffinity .pf-affinityFooter{ flex-wrap: wrap; }
  #pfViewAffinity .pf-affinitySearchWrap{ width: 100% !important; margin-left: 0 !important; }
  #pfViewAffinity .pf-affinityPanelCard{ padding: 14px !important; }
  #pfViewAffinity .pf-affinityStepper{ gap: 8px !important; }
  #pfViewAffinity .pf-affinityStepText{ display: none !important; }
}

