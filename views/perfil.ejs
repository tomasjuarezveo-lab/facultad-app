    height: 60%;
    max-width: 74px;
    max-height: 74px;
    min-width: 18px;
    min-height: 18px;
    border-radius: 9999px;
    background: rgba(15,23,42,.08);
    border: 1px solid rgba(15,23,42,.06);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.8);
  }

