    // Mantener centrado al hacer zoom
      function keepCenterAroundCurrentPage(){
        if (!viewerShell) return;

        const el = document.getElementById('page-'+currentPage);
        if (!el) return;

        // ✅ Centro vertical (como ya hacías)
        const targetCenterY = el.offsetTop + el.offsetHeight / 2;
        const viewportCenterY = viewerShell.clientHeight / 2;
        const top = Math.max(0, targetCenterY - viewportCenterY);

        // ✅ Centro horizontal (para que al hacer zoom no “se vaya” a la derecha)
        const targetCenterX = el.offsetLeft + el.offsetWidth / 2;
        const viewportCenterX = viewerShell.clientWidth / 2;
        const left = Math.max(0, targetCenterX - viewportCenterX);

        viewerShell.scrollTo({ top, left, behavior: 'auto' });
      }

    function nextScale(current, dir){
      const idx = steps.reduce((acc, s, i)=> (Math.abs(s-current) < Math.abs(steps[acc]-current)? i:acc), 0);
      let ni = Math.max(0, Math.min(steps.length-1, idx + (dir>0?1:-1)));
      return steps[ni];
    }

      function applyTransform(pm){
        pm.inner.style.transform = `rotate(${rotation}deg) scale(${userScale})`;
      }

      function applyZoom(){
        const rot = ((rotation % 360) + 360) % 360;
        const isQuarterTurn = (rot === 90 || rot === 270);

        pageMeta.forEach(pm=>{
          if (!pm) return;

          // aplicar rotación + escala al inner
          applyTransform(pm);

          // ✅ el wrapper debe crecer con el zoom para que NO se superpongan
          const baseW = pm.widthCSS;
          const baseH = pm.heightCSS;

          const layoutW = (isQuarterTurn ? baseH : baseW) * userScale;
          const layoutH = (isQuarterTurn ? baseW : baseH) * userScale;

          pm.wrapper.style.width  = layoutW + 'px';
          pm.wrapper.style.height = layoutH + 'px';
        });

        if (zoomResetBtn) zoomResetBtn.textContent = Math.round(userScale*100) + '%';
      }

      function setZoom(s){
        userScale = Math.max(0.5, Math.min(2, s));
        applyZoom();
        keepCenterAroundCurrentPage();
      }

      zoomInBtn?.addEventListener('click', ()=> setZoom(nextScale(userScale, +1)));
      zoomOutBtn?.addEventListener('click', ()=> setZoom(nextScale(userScale, -1)));
      zoomResetBtn?.addEventListener('click', ()=> setZoom(1));

      document.addEventListener('keydown', (e)=>{
        if (!(e.ctrlKey||e.metaKey)) return;
        if (e.key==='+'||e.key==='='){ e.preventDefault(); setZoom(nextScale(userScale,+1)); }
        if (e.key==='-'){ e.preventDefault(); setZoom(nextScale(userScale,-1)); }
        if (e.key==='0'){ e.preventDefault(); setZoom(1); }
      });

