  <script>
    async function renameClassSection(subjectId, sectionId, currentName){
      const name = prompt('Nuevo nombre de la subsección:', currentName || '');
      if (name === null) return;
      const trimmed = String(name || '').trim();
      if (!trimmed) { alert('El nombre no puede quedar vacío.'); return; }

      const res = await fetch(`/app/materias/${subjectId}/clases/sections/${sectionId}/rename`, {
        method: 'POST',
        headers: { 'Content-Type':'application/json' },
        body: JSON.stringify({ name: trimmed })
      });

      let data = null;
      try { data = await res.json(); } catch(_) {}
      if (!res.ok || !data || !data.ok) {
        alert((data && data.error) || 'No se pudo renombrar la subsección.');
        return;
      }

      location.href = data.redirect || `/app/materias/${subjectId}?category=clases&subcategory=${encodeURIComponent(trimmed)}`;
    }

    async function deleteClassSection(subjectId, sectionId, currentName){
      if (!confirm(`¿Eliminar la subsección "${currentName}" y todos sus archivos? Esta acción no se puede deshacer.`)) return;

      const res = await fetch(`/app/materias/${subjectId}/clases/sections/${sectionId}/delete`, {
        method: 'POST',
        headers: { 'Content-Type':'application/json' },
        body: JSON.stringify({ ok: true })
      });

      let data = null;
      try { data = await res.json(); } catch(_) {}
      if (!res.ok || !data || !data.ok) {
        alert((data && data.error) || 'No se pudo eliminar la subsección.');
        return;
      }

      location.href = data.redirect || `/app/materias/${subjectId}?category=clases`;
    }
  </script>
