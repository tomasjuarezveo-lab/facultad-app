  /* =========================
   iOS Compact Findbar (matches)
   Pegar al FINAL del <style>
   ========================= */

:root{
  --iosPanel: rgba(255,255,255,.78);
  --iosPanel2: rgba(248,250,252,.86);
  --iosLine: rgba(15,23,42,.10);
  --iosShadow: 0 16px 40px rgba(15,23,42,.14);
  --iosBlur: blur(14px);
  --iosInk: #0F172A;
  --iosMuted: rgba(15,23,42,.55);
}

body.dark, html.dark, [data-theme="dark"]{
  --iosPanel: rgba(17,24,39,.62);
  --iosPanel2: rgba(17,24,39,.72);
  --iosLine: rgba(255,255,255,.12);
  --iosShadow: 0 18px 46px rgba(0,0,0,.38);
  --iosInk: rgba(255,255,255,.92);
  --iosMuted: rgba(255,255,255,.62);
}

/* Soporta varios IDs/clases comunes */
#findbar, #pdfFindbar, #docFindbar, .findbar, .pdf-findbar, .doc-findbar{
  background: var(--iosPanel);
  border: 1px solid var(--iosLine);
  box-shadow: var(--iosShadow);
  -webkit-backdrop-filter: var(--iosBlur);
  backdrop-filter: var(--iosBlur);
  border-radius: 16px;
  padding: 8px 10px;
  color: var(--iosInk);

  /* compacto */
  width: min(260px, 52vw);
  max-width: 260px;
}

/* cuando lo “colgamos” debajo del contador */
.ios-findbar-under-counter{
  margin-top: 8px !important;
}

/* input */
#findbar input, #pdfFindbar input, #docFindbar input,
.findbar input, .pdf-findbar input, .doc-findbar input,
#findbar .findInput, #pdfFindbar .findInput, #docFindbar .findInput{
  width: 100%;
  height: 32px;
  border-radius: 12px;
  border: 1px solid var(--iosLine);
  background: var(--iosPanel2);
  outline: none;
  padding: 0 10px;
  color: var(--iosInk);
}

/* botones prev/next + cerrar si existen */
#findbar button, #pdfFindbar button, #docFindbar button,
.findbar button, .pdf-findbar button, .doc-findbar button{
  border: 1px solid var(--iosLine);
  background: var(--iosPanel2);
  color: var(--iosInk);
  border-radius: 12px;
  height: 32px;
  padding: 0 10px;
}

/* contador de matches (si existe) */
#findbar .findResultsCount, #pdfFindbar .findResultsCount, #docFindbar .findResultsCount,
#findbar .matchesCount, #pdfFindbar .matchesCount, #docFindbar .matchesCount{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 24px;
  padding: 0 8px;
  border-radius: 999px;
  border: 1px solid var(--iosLine);
  background: rgba(245,190,94,.22);
  color: var(--iosInk);
  font-size: 12px;
  margin-left: 8px;
}

/* Layout interno: que no sea largo */
#findbar .findbarInner, #pdfFindbar .findbarInner, #docFindbar .findbarInner{
  display: flex;
  align-items: center;
  gap: 8px;
}

