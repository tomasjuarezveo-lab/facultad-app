    <button id="zoom-reset" class="zoom-btn" title="Tamaño real (Ctrl/Cmd 0)" aria-label="Tamaño real">100%</button>
    <button id="zoom-in"    class="zoom-btn" title="Acercar (Ctrl/Cmd +)" aria-label="Acercar">+</button>
  </div>
</div>

<% } %>

<!-- ====== BARRA DE BÚSQUEDA ====== -->
<div id="findbar" class="findbar" role="search" aria-label="Buscar en PDF">
  <input id="find-input" type="text" placeholder="Buscar en el documento…" />
  <button id="find-prev" title="Anterior">↑</button>
  <button id="find-next" title="Siguiente">↓</button>
  <button id="find-close" title="Cerrar">✕</button>
</div>

  <!-- ====== SLIDER RESÚMENES (sin título; etiquetas a la derecha) ====== -->
  <!-- ====== SELECTOR RESÚMENES (horizontal) ====== -->
  <% if (category === 'resumenes') { %>
      <div id="summaryLevelBar" class="summary-levelbar" aria-label="Nivel del resumen">

        <!-- recuadro blanco: AHORA contiene track + botones -->
        <div class="lvl-pill" role="group" aria-label="Dificultad">

          <!-- línea + círculo deslizable (dentro del recuadro) -->


          <!-- fondo activo naranja detrás de los botones -->
          <div id="lvlActive" class="lvl-active" aria-hidden="true"></div>

          <div class="lvl-btnrow">
            <button type="button" class="lvl-btn" data-level="completo" aria-pressed="false">Dificil</button>
            <button type="button" class="lvl-btn" data-level="mediano" aria-pressed="false">Medio</button>
            <button type="button" class="lvl-btn" data-level="facil"   aria-pressed="false">Facil</button>
          </div>
        </div>

  </div>
  <% } %>

<!-- ====== ADMIN SUBIR ====== -->
<% if (user && user.role==='admin') { %>
<div class="top-right-controls glass card p-2" style="position:fixed; right:16px; top:76px; z-index:75; max-width:100%; height:auto;">
  <details>
    <summary class="btn cursor-pointer select-none">＋ Subir</summary>
    <div class="mt-2 p-3 bg-white rounded shadow space-y-2">
      <% if (category === 'resumenes') { %>
        <form method="POST" action="/upload" enctype="multipart/form-data" class="space-y-2">
          <input type="hidden" name="subject_id" value="<%= subject.id %>" />
          <input type="hidden" name="category"   value="resumenes" />
          <label class="text-sm font-medium block">Completo</label>
          <input type="file" name="file_completo" accept=".pdf" class="block w-72 max-w-full text-sm" />
          <label class="text-sm font-medium block mt-2">Mediano</label>
          <input type="file" name="file_mediano"  accept=".pdf" class="block w-72 max-w-full text-sm" />
          <label class="text-sm font-medium block mt-2">Fácil</label>
          <input type="file" name="file_facil"    accept=".pdf" class="block w-72 max-w-full text-sm" />
          <button class="btn w-full bg-black text-white rounded h-9 mt-2">Subir resúmenes</button>
        </form>
      <% } else { %>
        <form method="POST" action="/upload" enctype="multipart/form-data" class="space-y-2">
          <input type="hidden" name="subject_id" value="<%= subject.id %>" />
          <input type="hidden" name="category"   value="<%= category %>" />
          <% if (category === 'trabajos' || category === 'clases') { %>
            <input type="hidden" name="subcategory" value="<%= subcategory || '' %>" />
          <% } %>
          <label class="text-sm font-medium block">Archivos</label>
          <input type="file" name="files" multiple
            accept="<%= category === 'definiciones' ? '.txt,text/plain' : '.pdf,.doc,.docx,.ppt,.pptx,.png,.jpg,.jpeg' %>"
            class="block w-72 max-w-full text-sm" />
          <button class="btn w-full bg-black text-white rounded h-9">Subir a <%= category %></button>
        </form>
      <% } %>
    </div>
  </details>
</div>
<% } %>

<%
  const __temas = (typeof temas !== 'undefined' && Array.isArray(temas)) ? temas : [];
  const __txtFiles = (typeof txtFiles !== 'undefined' && Array.isArray(txtFiles)) ? txtFiles : [];
%>

<% if (category === 'definiciones') { %>

  <!-- ====== DEFINICIONES (BÚSQUEDA + RESULTADOS + ADMIN) ====== -->
  <section id="definitionsPane" aria-label="Definiciones">

    <% if (typeof isGuest !== 'undefined' && isGuest) { %>
      <!-- GUEST_DEF_OVERLAY -->
      <div class="guest-overlay">
        <div class="guest-lock-card">
          <div class="guest-lock-title">Definiciones bloqueadas</div>
          <div class="guest-lock-sub">
            Para acceder a <b>Definiciones</b> necesitás crear una cuenta gratis.
            <b>Tardás 10 segundos</b> y desbloqueás todo.
          </div>
          <div class="guest-lock-actions">
            <a class="guest-lock-btn guest-lock-btn--primary" href="/logout?next=register">Crear cuenta gratis</a>
            <a class="guest-lock-btn" href="/logout?next=login">Ya tengo cuenta</a>
          </div>
        </div>
      </div>
    <% } %>


    <!-- ✅ RECTÁNGULO 1: SOLO BUSCADOR + SELECTOR -->
    <div class="defCard defTopCard">
      <div class="defHeader">
        <input id="defQuery" class="defInput" type="text" maxlength="80"
              placeholder="Buscar definición… (ej: WIP, cuello de botella, layout)" />
        <!-- ✅ Botón Atrás (aparece cuando navegás desde relacionados) -->
          <button id="defBackBtn" class="defModeBtn" type="button" style="display:none;">
            ← Atrás
          </button>
        <!-- ✅ divisor vertical en medio -->
        <div class="defVdiv" aria-hidden="true"></div>

        <!-- ✅ Barra iOS: Definición / Tema -->
        <div class="defModeWrap">
          <button id="defModeBtn" type="button" class="defModeBtn" aria-haspopup="listbox" aria-expanded="false">
            <span id="defModeLabel">Definición</span>
            <span class="defModeChevron">▾</span>
          </button>

          <div id="defDropdown" class="defDropdown" role="listbox" aria-label="Elegir modo">
            <!-- ✅ MODO DEFINICIÓN -->
            <div class="defDropItem" data-mode="definicion">
              <span>Definición</span>
              <small>buscar términos</small>
            </div>

            <!-- ✅ MODO TEMA (busca temas por nombre) -->
            <div class="defDropItem" data-mode="tema">
              <span>Tema</span>
              <small>buscar temas</small>
            </div>

            <div class="defDropDivider"></div>

            <!-- ✅ Lista de temas (sirve para filtrar directo un tema) -->
            <% __temas.forEach(t => { %>
              <div class="defDropItem" data-mode="temaPick" data-tema="<%= t %>">
                <span><%= t %></span>
                <small>filtrar</small>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- ✅ Botón Buscar (a la derecha de todo) -->
        <button id="defSearchBtn" class="defSearchBtn" type="button">Buscar</button>
      </div>
    </div>

      <!-- ✅ RECTÁNGULO 2: RESULTADOS + ADMIN -->
      <div class="defCard defBottomCard">

        <!-- ✅ Recuadro visible de resultados -->
        <!-- ✅ Recuadro visible de resultados -->
        <div class="defResultsCard">
          <!-- ✅ HERO (estado inicial + loading) -->
          <div id="defHero" class="defHero" aria-hidden="false">
            <div class="defHeroTitle">
              <span class="defHeroTitleText">Busca cualquier tema</span>
              <span class="defDots" aria-label="Cargando">
                <span class="defDot"></span>
                <span class="defDot"></span>
                <span class="defDot"></span>
              </span>
            </div>
            <div class="defHeroSub">Escribí la palabra y buscamos la definición o te explicamos el tema</div>
