  /* ===== TOP MENU: comportamiento hover/active ===== */

/* 1) Sacar por completo la animación de elevar y cualquier hover rectangular */
.top-tabs .tab{
  transform: none !important;
  box-shadow: none !important;
  background: transparent !important;
  transition: color .12s ease, opacity .12s ease, filter .12s ease !important;
  text-decoration: none;
}

.top-tabs .tab:hover,
.top-tabs .tab:focus-visible{
  transform: none !important;
  box-shadow: none !important;
  background: transparent !important;
}

/* 2) Hover: SOLO texto blanco (sin “pill” detrás) */
.top-tabs .tab:hover,
.top-tabs .tab:focus-visible{
  color: #fff !important;
  opacity: 1 !important;
  filter: none !important;
}

/* 3) Cuando hay uno activo, los demás se oscurecen */
.top-tabs:has(.tab.is-active) .tab:not(.is-active){
  opacity: .46;
  filter: brightness(.78) saturate(.75);
}

/* 4) Pero si pasás el mouse por uno NO activo, vuelve a verse normal (texto blanco) */
.top-tabs:has(.tab.is-active) .tab:not(.is-active):hover,
.top-tabs:has(.tab.is-active) .tab:not(.is-active):focus-visible{
  opacity: 1;
  filter: none;
  color: #fff !important;
}
