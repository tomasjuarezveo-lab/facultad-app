  <script>
    (function summaryLevelBar(){
      const bar    = document.getElementById('summaryLevelBar');
      const active = document.getElementById('lvlActive');
      if (!bar || !knob || !active) return;

      const btns   = Array.from(bar.querySelectorAll('.lvl-btn'));
      

      const levels = ['completo','mediano','facil'];   // ✅ Dificil / Medio / Facil
      const current = '<%= (currentLevel || "completo") %>';
      let idx = Math.max(0, Math.min(2, levels.indexOf(current)));
      

      function setUI(){
        // Fondo activo (naranja) detrás del botón
        active.style.transform = `translateX(${idx * 100}%)`;

        // Estado botones
        btns.forEach((b,i)=>{
          const on = i === idx;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });

      }

      function commit(){
        const sel = levels[idx];
        const qs = new URLSearchParams(location.search);
        qs.set('category', 'resumenes');
        qs.set('level', sel);
        location.search = qs.toString();
      }

      function idxFromClientX(clientX){
        const r = line.getBoundingClientRect();
        const pts = [r.left, r.left + r.width/2, r.right];
        let best = 0, bestD = Infinity;
        pts.forEach((p,i)=>{
          const d = Math.abs(clientX - p);
          if (d < bestD){ bestD = d; best = i; }
        });
        return best;
      }

      // Click en botones
      btns.forEach((b,i)=>{
        b.addEventListener('click', ()=>{
          idx = i;
          setUI();
          commit();
        });
      });

      window.addEventListener('resize', setUI);
      setTimeout(setUI, 0);
    })();
  </script>
