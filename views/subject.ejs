    function closeClassSectionModal(){
      const b = document.getElementById('csModalBackdrop');
      if(!b) return;
      b.classList.remove('is-open');
      b.setAttribute('aria-hidden','true');
    }

    document.addEventListener('keydown', (e)=>{
