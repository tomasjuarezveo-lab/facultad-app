<script>
  // ===== TOP TABS: Hover title + subtitle (solo en hover, se oculta al salir o al click) =====
  (function(){
    const info = document.getElementById('topTabHoverInfo');
    if(!info) return;

    const titleEl = info.querySelector('.topTabTitle');
    const subEl   = info.querySelector('.topTabSub');

    const HELP = {
      finales:      { title: 'Finales',      sub: 'Encontrarás ejemplos de finales de otros años y material para practicar.' },
      parciales:    { title: 'Parciales',    sub: 'Encontrarás ejemplos de parciales de otros años, modelos y práctica.' },
      trabajos:     { title: 'Trabajos',     sub: 'Encontrarás consignas, trabajos prácticos y entregas de referencia actuales y de otros años.' },
      bibliografia: { title: 'Bibliografía', sub: 'Encontrarás libros, PDFs, apuntes y material recomendado de la materia.' },
      resumenes:    { title: 'Resúmenes',    sub: 'Encontrarás resúmenes y síntesis para repasar rápido antes de rendir. Podes elegir entre 3 niveles de dificultad para entenderlo' },
      clases:       { title: 'Clases',       sub: 'Encontrarás el contenido ordenado por clase/tema para estudiar paso a paso.' },
      definiciones: { title: 'Definiciones', sub: 'Encontrarás conceptos clave explicados de forma simple y directa, tipo glosario. La solución para no tener que leer todo de nuevo' }
    };

    function showFor(btn){
      const key = (btn.getAttribute('data-key') || '').toLowerCase();
      const d = HELP[key];
      if(!d) return;

      titleEl.textContent = d.title;
      subEl.textContent = d.sub;

      info.classList.add('is-visible');
      info.setAttribute('aria-hidden','false');
    }

    function hide(){
      info.classList.remove('is-visible');
      info.setAttribute('aria-hidden','true');
    }

    // Fallback para CSS (si el navegador no soporta :has)
    const topTabs = document.querySelector('.top-tabs');
    if(topTabs && topTabs.querySelector('.tab.is-active')) topTabs.classList.add('has-active');

    const tabs = document.querySelectorAll('.top-tabs .tab[data-key]');
    tabs.forEach(btn=>{
      btn.addEventListener('pointerenter', ()=> showFor(btn));
      btn.addEventListener('mouseenter',  ()=> showFor(btn)); // fallback
      btn.addEventListener('focus',       ()=> showFor(btn));

      btn.addEventListener('pointerleave', hide);
      btn.addEventListener('mouseleave',  hide);
      btn.addEventListener('blur',        hide);

      btn.addEventListener('click', hide);
    });
  })();
(function(){
  function qsAny(list){
    for(const sel of list){
      const el = document.querySelector(sel);
      if(el) return el;
    }
    return null;
  }

  function positionFindbarUnderCounter(){
    const findbar = qsAny(['#findbar', '.findbar']);
    if(!findbar) return;

    const counter = qsAny(['#page-counter', '.page-counter', '#pageCounter']);
    if(!counter) return;

    const r = counter.getBoundingClientRect();

    findbar.style.position = 'fixed';
    findbar.style.left = '50%';
    findbar.style.right = 'auto';
    findbar.style.transform = 'translateX(-50%)';
    findbar.style.top = Math.round(r.bottom + 8) + 'px';
    findbar.style.zIndex = '10095';
  }

  document.addEventListener('DOMContentLoaded', positionFindbarUnderCounter);
  window.addEventListener('resize', positionFindbarUnderCounter, { passive:true });
})();

</script>
