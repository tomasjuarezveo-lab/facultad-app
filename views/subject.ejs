    // Navegar a página
    function goToPage(p, smooth){
      if (!viewer) return;
      p = Math.max(1, Math.min(totalPages||1, p|0));
      const pageEl = document.getElementById('page-'+p);
      if (!pageEl) return;
      currentPage = p; updateCounter();
