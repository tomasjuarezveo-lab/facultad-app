<%
  const __catLower = String(category || '').toLowerCase();
  const __viewerCats = new Set(['finales','parciales','trabajos','bibliografia','resumenes','clases','definiciones']);
  const __isViewer = __viewerCats.has(__catLower);
%>

<script>
  (function(){
    var isViewer = <%- JSON.stringify(__isViewer) %>;
    if(!isViewer) return;

    // ✅ instantáneo, antes de que el browser pinte (reduce el "flash" blanco)
    document.documentElement.classList.add('viewerMode');
    document.documentElement.style.background = '#282828';
    document.documentElement.style.backgroundColor = '#282828';

    // body puede no existir todavía; lo reforzamos cuando exista
    function applyBody(){
      if(!document.body) return;
      document.body.classList.add('viewerMode');
      document.body.style.background = '#282828';
      document.body.style.backgroundColor = '#282828';
      document.body.setAttribute('data-viewer', '1');
    }
    applyBody();
    document.addEventListener('DOMContentLoaded', applyBody);
  })();
