<script>
(function(){
  const IS_GUEST = <%- JSON.stringify(!!(typeof isGuest !== 'undefined' && isGuest)) %>;
  if (IS_GUEST) return;

  const subjectId = <%- JSON.stringify(subject.id) %>;

  const qEl = document.getElementById('defQuery');
  const out = document.getElementById('defResults');
  const resultsCard = document.querySelector('.defResultsCard');
  const hero = document.getElementById('defHero');

  // Dropdown
  const btn = document.getElementById('defModeBtn');
  const label = document.getElementById('defModeLabel');
  const dd = document.getElementById('defDropdown');
  const searchBtn = document.getElementById('defSearchBtn');

  let mode = 'definicion'; // definicion | tema

  function esc(s){
    return String(s||'').replace(/[&<>"']/g, m => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'
    }[m]));
  }

  function setHero(on){
    if (!hero) return;
    hero.style.display = on ? 'flex' : 'none';
    hero.setAttribute('aria-hidden', on ? 'false' : 'true');
  }

  function setMode(newMode){
    mode = (newMode === 'tema') ? 'tema' : 'definicion';
    if (mode === 'tema'){
      label.textContent = 'Tema';
      if (qEl) qEl.placeholder = 'Buscar tema… (ej: Layout, FMS, WIP)';
    } else {
      label.textContent = 'Definición';
      if (qEl) qEl.placeholder = 'Buscar definición…';
    }
  }

  function openDD(){
    if (!dd || !btn) return;
    dd.classList.add('open');
    btn.setAttribute('aria-expanded','true');
  }
  function closeDD(){
    if (!dd || !btn) return;
    dd.classList.remove('open');
    btn.setAttribute('aria-expanded','false');
  }
  function toggleDD(){
    if (!dd) return;
    dd.classList.contains('open') ? closeDD() : openDD();
  }

  btn && btn.addEventListener('click', toggleDD);

  dd && dd.addEventListener('click', (e)=>{
    const item = e.target.closest('.defDropItem');
    if(!item) return;
    const m = item.getAttribute('data-mode') || 'definicion';

    // temaPick: autocompleta y busca
    if (m === 'temaPick'){
      const t = item.getAttribute('data-tema') || '';
      setMode('tema');
      if (qEl) qEl.value = t;
      closeDD();
      doSearch();
      return;
    }

    setMode(m === 'tema' ? 'tema' : 'definicion');
    closeDD();
  });

  // Cerrar al click afuera / ESC
  document.addEventListener('click', (e)=>{
    if (!dd || !btn) return;
    if (dd.classList.contains('open') && !dd.contains(e.target) && !btn.contains(e.target)) closeDD();
  });
  document.addEventListener('keydown', (e)=>{
    if(e.key === 'Escape') closeDD();
  });

  function setEmpty(msg){
    if (resultsCard) resultsCard.classList.add('is-empty');
    if (out) out.innerHTML = msg ? `<div class="defEmpty">${esc(msg)}</div>` : '';
  }

  function setResultHTML(html){
    if (resultsCard) resultsCard.classList.remove('is-empty');
    if (out) out.innerHTML = html;
  }

  function renderRelatedSection(title, items, pickMode){
    if (!items || !items.length) return '';
    return `
      <div class="defRelatedWrap">
        <div class="defTerm">${esc(title)}</div>
        <div class="defRelatedGrid">
          ${items.map(t => `
            <a href="#"
               class="defRelatedTile defRelatedLink"
               data-pick-mode="${esc(pickMode)}"
               data-pick="${esc(t)}"
               title="${esc(t)}">${esc(t)}</a>
          `).join('')}
        </div>
      </div>
    `;
  }

  async function doSearch(){
    const q = String(qEl?.value || '').trim();
    if (!q){
      setHero(true);
      setEmpty('');
      return;
    }

    try{
      setHero(false);
      setEmpty('Buscando…');

      const url = `/app/materias/${encodeURIComponent(subjectId)}/definiciones/search?mode=${encodeURIComponent(mode)}&q=${encodeURIComponent(q)}`;
      const r = await fetch(url, { headers: { 'Accept': 'application/json' } });
      const j = await r.json();

      if (!j || !j.ok){
        setEmpty('Error buscando.');
        return;
      }

      // ✅ Tu backend devuelve: result: { primary, relatedTopics, relatedDefinitions, mentionedInTopics, mentionedInDefinitions }
      const pack = j.result || null;
      const primary = pack?.primary || null;

      const relatedTopics = Array.isArray(pack?.relatedTopics) ? pack.relatedTopics : [];
      const relatedDefinitions = Array.isArray(pack?.relatedDefinitions) ? pack.relatedDefinitions : [];
      const mentionedInTopics = Array.isArray(pack?.mentionedInTopics) ? pack.mentionedInTopics : [];
      const mentionedInDefinitions = Array.isArray(pack?.mentionedInDefinitions) ? pack.mentionedInDefinitions : [];

      if (!primary){
        setResultHTML(`
          <div class="defEmpty">No encontré resultados.</div>
          ${renderRelatedSection('Mencionado en temas', mentionedInTopics, 'tema')}
          ${renderRelatedSection('Mencionado en definiciones', mentionedInDefinitions, 'definicion')}
          ${renderRelatedSection('Relacionado con temas', relatedTopics, 'tema')}
          ${renderRelatedSection('Relacionado con definiciones', relatedDefinitions, 'definicion')}
        `);
        return;
      }

      const type = String(primary.type || '').toLowerCase() === 'tema' ? 'tema' : 'definicion';
      const kindLabel = (type === 'tema') ? 'TEMA' : 'DEFINICIÓN';

      const html = `
        <div style="font-weight:950; letter-spacing:.08em; text-transform:uppercase; font-size:12px; color: rgba(255,255,255,.75); margin: 2px 0 10px 0;">
          ${kindLabel}
        </div>

        <div class="defResult">
          <div class="defTerm">${esc(primary.title)}</div>
          <div class="defText">${esc(primary.body)}</div>
        </div>

        ${renderRelatedSection('Mencionado en temas', mentionedInTopics, 'tema')}
        ${renderRelatedSection('Mencionado en definiciones', mentionedInDefinitions, 'definicion')}
        ${renderRelatedSection('Relacionado con temas', relatedTopics, 'tema')}
        ${renderRelatedSection('Relacionado con definiciones', relatedDefinitions, 'definicion')}
      `;

      setResultHTML(html);

      // Clicks en links relacionados
      out?.querySelectorAll('.defRelatedLink')?.forEach(a => {
        a.addEventListener('click', (ev)=>{
          ev.preventDefault();
          const pick = a.getAttribute('data-pick') || '';
          const pickMode = a.getAttribute('data-pick-mode') || 'definicion';
          setMode(pickMode === 'tema' ? 'tema' : 'definicion');
          if (qEl) qEl.value = pick;
          doSearch();
        });
      });

    } catch(e){
      console.error(e);
      setEmpty('Error buscando.');
    }
  }

  // Buscar al click, o Enter
  searchBtn && searchBtn.addEventListener('click', doSearch);
  qEl && qEl.addEventListener('keydown', (e)=>{
    if (e.key === 'Enter'){
      e.preventDefault();
      doSearch();
    }
  });

  // Estado inicial
  setMode('definicion');
  setHero(true);
  setEmpty('');
})();
</script>



<% } %>

