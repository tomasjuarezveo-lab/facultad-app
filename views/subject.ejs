  <script>
  (function(){
    const rail = document.querySelector('.sidebar-floating');
    const up   = document.getElementById('docsScrollUp');
    const down = document.getElementById('docsScrollDown');
    if (!rail || !up || !down) return;

    const BTN = 40;
    const GAP = 10;
    const STEP = 180;

    function canScroll(){
      return rail.scrollHeight > rail.clientHeight + 2;
    }

    function positionBtns(){
      const r = rail.getBoundingClientRect();
      const cx = Math.round(r.left + r.width/2 - BTN/2);

      up.style.left = cx + 'px';
      down.style.left = cx + 'px';

      up.style.top = Math.max(10, Math.round(r.top - BTN - GAP)) + 'px';
      down.style.top = Math.min(window.innerHeight - BTN - 10, Math.round(r.bottom + GAP)) + 'px';

      const ok = canScroll();
      up.classList.toggle('is-hidden', !ok);
      down.classList.toggle('is-hidden', !ok);
    }

    up.addEventListener('click', ()=> rail.scrollBy({ top: -STEP, behavior:'smooth' }));
    down.addEventListener('click', ()=> rail.scrollBy({ top: STEP, behavior:'smooth' }));

    window.addEventListener('resize', positionBtns, true);
    window.addEventListener('scroll', positionBtns, true);

    setTimeout(positionBtns, 0);
  })();
  </script>

