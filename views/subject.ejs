  <!-- ====== PDF.js ====== -->
  <!-- ====== PDF.js (lazy, no bloquea el render) ====== -->
<script>
  const IS_GUEST = <%- JSON.stringify(!!(typeof isGuest !== 'undefined' && isGuest)) %>;
  function ensurePdfJs(){
    return new Promise((resolve, reject)=>{
      if (window.pdfjsLib){
        try{
          pdfjsLib.GlobalWorkerOptions.workerSrc =
            "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
        }catch(_){}
        return resolve(window.pdfjsLib);
      }

      const s = document.createElement('script');
      s.src = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js";
      s.async = true;
      s.crossOrigin = "anonymous";
      s.referrerPolicy = "no-referrer";

      s.onload = () => {
        try{
          if (window.pdfjsLib){
            pdfjsLib.GlobalWorkerOptions.workerSrc =
              "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
          }
        }catch(_){}
        return resolve(window.pdfjsLib);
      };

      s.onerror = () => reject(new Error('No se pudo cargar pdf.js'));
      document.head.appendChild(s);
    });
  }
</script>
  <script>
    if (window.pdfjsLib) {
      pdfjsLib.GlobalWorkerOptions.workerSrc = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
    }
  </script>

  <!-- ====== SCRIPTS ====== -->
  <script>
    // Admin helpers
    async function renameDocGroup(group_uid, currentTitle){
      const title = prompt('Nuevo título para el grupo:', currentTitle || '');
      if (title == null) return;
      await fetch('/admin/rename-group', {
        method: 'POST', headers: { 'Content-Type':'application/json' },
        body: JSON.stringify({ group_uid, title })
      });
      location.reload();
    }
    async function renameDoc(id, currentTitle){
      const title = prompt('Nuevo nombre para el documento:', currentTitle || '');
      if (title === null) return;
      const res = await fetch(`/admin/docs/${id}/rename`, {
        method: 'POST', headers: { 'Content-Type':'application/json' },
        body: JSON.stringify({ title })
      });
      if(!res.ok){ alert('No se pudo renombrar.'); return; }
      location.reload();
    }

    // ✅ ADMIN: mover documento arriba/abajo (1 posición)
    const __MOVE_IS_ADMIN = <%- JSON.stringify(!!(user && user.role==='admin')) %>;
    const __MOVE_SUBJECT_ID = <%- JSON.stringify(subject && subject.id) %>;
    const __MOVE_CATEGORY = <%- JSON.stringify(category || '') %>;
    const __MOVE_SUBCATEGORY = <%- JSON.stringify((category==='trabajos' || category==='clases') ? (subcategory || '') : '') %>;

    function closeAllMovePops(exceptId){
      document.querySelectorAll('.doc-move-pop.is-open').forEach(pop=>{
        const id = String(pop.getAttribute('data-move-pop') || '');
        if (exceptId && String(exceptId) === id) return;
        pop.classList.remove('is-open');
        pop.setAttribute('aria-hidden','true');
      });
      document.querySelectorAll('.doc-item.is-move-open').forEach(it=>it.classList.remove('is-move-open'));
    }

    function refreshMoveDisabled(docId){
      const items = Array.from(document.querySelectorAll('.doc-list .doc-item[data-doc-id]'));
      const ids = items.map(el => parseInt(el.getAttribute('data-doc-id'),10)).filter(n=>Number.isFinite(n));
      const idx = ids.indexOf(parseInt(docId,10));
      const pop = document.querySelector(`.doc-move-pop[data-move-pop="${docId}"]`);
      if (!pop) return;
      const btns = pop.querySelectorAll('button.doc-move-arrow');
      const upBtn = btns[0];
      const downBtn = btns[1];
      if (upBtn) upBtn.disabled = (idx <= 0);
      if (downBtn) downBtn.disabled = (idx < 0 || idx >= ids.length - 1);
    }

    function toggleDocMove(ev, docId){
      try { ev.preventDefault(); ev.stopPropagation(); } catch(_){}
      if (!__MOVE_IS_ADMIN) return;

      const item = document.querySelector(`.doc-item[data-doc-id="${docId}"]`);
      const pop = document.querySelector(`.doc-move-pop[data-move-pop="${docId}"]`);
      if (!pop || !item) return;

      const isOpen = pop.classList.contains('is-open');
      closeAllMovePops();

      if (!isOpen){
        item.classList.add('is-move-open');
        pop.classList.add('is-open');
        pop.setAttribute('aria-hidden','false');
        refreshMoveDisabled(docId);
      }
    }

    async function sendReorder(ids){
      const body = { category: __MOVE_CATEGORY, ids: ids };
      if (__MOVE_SUBCATEGORY) body.subcategory = __MOVE_SUBCATEGORY;

      const res = await fetch(`/app/materias/${__MOVE_SUBJECT_ID}/docs/reorder`, {
        method:'POST',
        headers:{ 'Content-Type':'application/json' },
        body: JSON.stringify(body)
      });
      if (!res.ok){
        try{ const j = await res.json(); alert(j && j.error ? j.error : 'No se pudo guardar el orden.'); }catch(_){ alert('No se pudo guardar el orden.'); }
      }
      return res.ok;
    }

    async function moveDocOne(ev, docId, dir){
      try { ev.preventDefault(); ev.stopPropagation(); } catch(_){}
      if (!__MOVE_IS_ADMIN) return;

      const items = Array.from(document.querySelectorAll('.doc-list .doc-item[data-doc-id]'));
      const ids = items.map(el => parseInt(el.getAttribute('data-doc-id'),10)).filter(n=>Number.isFinite(n));
      const idNum = parseInt(docId,10);
      const idx = ids.indexOf(idNum);
      if (idx < 0) return;

      const targetIdx = idx + (dir < 0 ? -1 : 1);
      if (targetIdx < 0 || targetIdx >= ids.length) return;

      // swap ids
      const swapped = ids.slice();
      const tmp = swapped[idx];
      swapped[idx] = swapped[targetIdx];
      swapped[targetIdx] = tmp;

      // mover DOM (feedback inmediato)
      const container = document.querySelector('.doc-list');
      const currentEl = items[idx];
      const otherEl = items[targetIdx];
      if (container && currentEl && otherEl){
        if (dir < 0){
          container.insertBefore(currentEl, otherEl);
        } else {
          container.insertBefore(otherEl, currentEl);
        }
      }

      const ok = await sendReorder(swapped);
      if (!ok){
        location.reload();
        return;
      }

      refreshMoveDisabled(docId);
    }

    if (__MOVE_IS_ADMIN){
      document.addEventListener('click', (e)=>{
        if (e && e.target && e.target.closest && e.target.closest('.doc-move-pop')) return;
        if (e && e.target && e.target.closest && e.target.closest('.doc-move-launch')) return;
        closeAllMovePops();
      }, true);
      document.addEventListener('keydown', (e)=>{ if (e.key === 'Escape') closeAllMovePops(); });
    }
        // ✅ ADMIN: arrastrar y reordenar documentos con mantener presionado
    (function setupHoldAndDragDocs(){
      if (!__MOVE_IS_ADMIN || __MOVE_CATEGORY === 'resumenes') return;

      const container = document.querySelector('.doc-list');
      if (!container) return;

      let holdTimer = null;
      let activeItem = null;
      let placeholder = null;
      let pointerId = null;
      let dragActive = false;
      let startX = 0;
      let startY = 0;
      let offsetX = 0;
      let offsetY = 0;
      let suppressClickUntil = 0;
      let startOrder = [];

      function sortableItems(){
        return Array.from(container.querySelectorAll('.doc-item[data-doc-id][data-sortable="true"]'));
      }

      function currentIds(){
        return sortableItems()
          .map(el => parseInt(el.getAttribute('data-doc-id'), 10))
          .filter(n => Number.isFinite(n));
      }

      function clearHold(){
        if (holdTimer) {
          clearTimeout(holdTimer);
          holdTimer = null;
        }
      }

      function cleanupDrag(){
        clearHold();
        if (activeItem) {
          activeItem.classList.remove('dragging', 'drag-armed');
          activeItem.style.position = '';
          activeItem.style.left = '';
          activeItem.style.top = '';
          activeItem.style.width = '';
          activeItem.style.pointerEvents = '';
          activeItem.style.zIndex = '';
          activeItem.style.margin = '';
          activeItem.style.transform = '';
        }
        if (placeholder && placeholder.parentNode) placeholder.parentNode.removeChild(placeholder);
        activeItem = null;
        placeholder = null;
        pointerId = null;
        dragActive = false;
      }

      function placeFloating(clientX, clientY){
        if (!activeItem) return;
        activeItem.style.left = (clientX - offsetX) + 'px';
        activeItem.style.top = (clientY - offsetY) + 'px';
      }

      function movePlaceholder(clientY){
        if (!placeholder) return;
        const siblings = sortableItems().filter(el => el !== activeItem);
        let placed = false;

        for (const el of siblings){
          const rect = el.getBoundingClientRect();
          const mid = rect.top + (rect.height / 2);
          if (clientY < mid){
            container.insertBefore(placeholder, el);
            placed = true;
            break;
          }
        }

        if (!placed) container.appendChild(placeholder);
      }

      function startDrag(item, ev){
        activeItem = item;
        pointerId = ev.pointerId;
        dragActive = true;
        suppressClickUntil = Date.now() + 500;
        startOrder = currentIds();

        const rect = item.getBoundingClientRect();
        offsetX = ev.clientX - rect.left;
        offsetY = ev.clientY - rect.top;

        placeholder = document.createElement('div');
        placeholder.className = 'doc-drop-slot';
        placeholder.style.height = rect.height + 'px';
        placeholder.style.width = '100%';

        item.classList.add('drag-armed', 'dragging');
        item.style.width = rect.width + 'px';
        item.style.position = 'fixed';
        item.style.left = rect.left + 'px';
        item.style.top = rect.top + 'px';
        item.style.pointerEvents = 'none';
        item.style.zIndex = '95';
        item.style.margin = '0';

        container.insertBefore(placeholder, item.nextSibling);
        placeFloating(ev.clientX, ev.clientY);
      }

      async function finishDrag(){
        if (!dragActive || !activeItem) {
          cleanupDrag();
          return;
        }

        container.insertBefore(activeItem, placeholder);
        const ids = currentIds();
        const changed = JSON.stringify(ids) !== JSON.stringify(startOrder);
        cleanupDrag();

        if (!changed) return;

        const ok = await sendReorder(ids);
        if (!ok) location.reload();
      }

      container.addEventListener('pointerdown', (ev) => {
        const item = ev.target.closest('.doc-item[data-doc-id][data-sortable="true"]');
        if (!item) return;
        if (ev.target.closest('button')) return;
        if (ev.target.closest('a') == null) return;

        clearHold();
        startX = ev.clientX;
        startY = ev.clientY;

        holdTimer = setTimeout(() => {
          startDrag(item, ev);
        }, 260);
      });

      container.addEventListener('pointermove', (ev) => {
        if (!dragActive) {
          if (holdTimer) {
            const dx = Math.abs(ev.clientX - startX);
            const dy = Math.abs(ev.clientY - startY);
            if (dx > 8 || dy > 8) clearHold();
          }
          return;
        }

        if (pointerId !== null && ev.pointerId !== pointerId) return;
        ev.preventDefault();
        placeFloating(ev.clientX, ev.clientY);
        movePlaceholder(ev.clientY);
      }, { passive:false });

      container.addEventListener('pointerup', () => {
        clearHold();
        if (dragActive) finishDrag();
      });

      container.addEventListener('pointercancel', () => {
        clearHold();
        if (dragActive) finishDrag();
      });

      container.addEventListener('pointerleave', () => {
        if (!dragActive) clearHold();
      });

      document.addEventListener('click', (ev) => {
        if (Date.now() < suppressClickUntil && ev.target.closest('.doc-list')) {
          ev.preventDefault();
          ev.stopPropagation();
        }
      }, true);
    })();

    // Tooltip docs
    (function setupDocFlyover(){
      const fly = document.getElementById('doc-flyover');
      const GAP = 10;
      const icons = document.querySelectorAll('.doc-item-icon');
      const sidebar = document.querySelector('.sidebar-floating');
      let hideTO = null;

      function hideFly(){
        if (!fly) return;
        fly.classList.remove('show');
        fly.setAttribute('aria-hidden','true');
        fly.style.transform = 'translate(-9999px, -9999px)';
      }

      function positionFly(el){
        if (!fly || !el) return;
        const rect = el.getBoundingClientRect();
        fly.style.left = '0px'; fly.style.top = '0px'; fly.style.transform = 'none';
        fly.textContent = el.getAttribute('data-title') || '';
        fly.setAttribute('aria-hidden','false');
        const flyW = fly.offsetWidth, flyH = fly.offsetHeight;
        const top = rect.top + (rect.height / 2) - (flyH / 2);
        let left = rect.left - GAP - flyW;
        const minLeft = 8;
        if (left < minLeft) left = minLeft;
        fly.style.left = left + 'px';
        fly.style.top = top + 'px';
        fly.classList.add('show');
      }

      function onEnter(e){
        if (hideTO){ clearTimeout(hideTO); hideTO=null; }
        positionFly(e.currentTarget);
      }
      function onLeave(){ hideTO = setTimeout(hideFly, 80); }

      icons.forEach(icon=>{
        icon.addEventListener('mouseenter', onEnter);
        icon.addEventListener('focus', onEnter);
        icon.addEventListener('mouseleave', onLeave);
        icon.addEventListener('blur', onLeave);
      });

      window.addEventListener('scroll', hideFly, true);
      if (sidebar) sidebar.addEventListener('scroll', hideFly, { passive:true });
      window.addEventListener('resize', hideFly);
      document.addEventListener('keydown', (e)=>{ if(e.key==='Escape') hideFly(); });

            // ✅ Marcar doc/grupo activo en el lateral derecho (borde naranja)
            // ✅ Marcar doc/grupo activo en el lateral derecho (flecha amarilla)
      (function markActiveDoc(){
        const qs = new URLSearchParams(location.search);
        const doc = qs.get('doc');
        const gid = qs.get('gid');

        let found = false;

        icons.forEach(a=>{
          try{
            const href = a.getAttribute('href') || '';
            const u = new URL(href, location.origin);
            const hq = u.searchParams;

            const match =
              (doc && hq.get('doc') === doc) ||
              (gid && hq.get('gid') === gid);

            if (match){
              found = true;
              a.classList.add('is-active');
            } else {
              a.classList.remove('is-active');
            }
          } catch(e){
            a.classList.remove('is-active');
          }
        });

        // ✅ Si no vino doc/gid (o no matcheó), marcamos el primero (default mostrado)
        if (!found && icons.length){
          icons[0].classList.add('is-active');
        }
      })();


    })();
  </script>

  <script>
  (function pdfViewerApp(){
    const leftPanel   = document.getElementById('left-panel');
    const backdrop    = document.getElementById('left-backdrop');
    const btnLeft     = document.getElementById('btn-left');

    const zoomInBtn   = document.getElementById('zoom-in');
    const zoomOutBtn  = document.getElementById('zoom-out');
    const zoomResetBtn= document.getElementById('zoom-reset');

    const fabRotate   = document.getElementById('fab-rotate');
    const fabSearch   = document.getElementById('fab-search');
    const fabDownload = document.getElementById('fab-download');
    const fabFs       = document.getElementById('fab-fullscreen');

    // Findbar
    const findbar     = document.getElementById('findbar');
    const findInput   = document.getElementById('find-input');
    const findPrev    = document.getElementById('find-prev');
    const findNext    = document.getElementById('find-next');
    const findClose   = document.getElementById('find-close');

    const viewerShell = document.getElementById('viewer-shell');
    const viewer      = document.getElementById('viewer');
    const pdfLoadingOverlay = document.getElementById('pdfLoadingOverlay');

        // =========================
        // ✅ MOBILE: tap en PDF para ocultar UI (excepto dock/layout)
        // =========================
        function isMobileUI(){
          return window.matchMedia && window.matchMedia('(max-width: 640px)').matches;
        }

        function shouldIgnoreTap(target){
          if(!target) return false;
          return !!(
            target.closest('.controls-stack') ||
            target.closest('.sidebar-floating') ||
            target.closest('.top-tabs') ||
            target.closest('.sub-tabs') ||
            target.closest('.findbar') ||
            target.closest('.summary-levelbar') ||
            target.closest('#btn-left') ||
            target.closest('.top-right-controls') ||
            target.closest('#left-panel') ||
            target.closest('#left-backdrop')
          );
        }

        function toggleMobileUIHidden(){
          document.documentElement.classList.toggle('ui-hidden-mobile');
        }

        // Tap/click sobre el visor (pero NO sobre botones)
        if(viewerShell){
          viewerShell.addEventListener('click', function(e){
            if(!isMobileUI()) return;
            if(shouldIgnoreTap(e.target)) return;
            toggleMobileUIHidden();
          }, { passive:true });
        }

        // Si rotás / agrandás pantalla, aseguramos que no quede escondido raro
        window.addEventListener('resize', function(){
          if(!isMobileUI()){
            document.documentElement.classList.remove('ui-hidden-mobile');
          }
        });


    const pageCounter = document.getElementById('page-counter');
        let firstPageShown = false;
    let renderCycleId = 0;

    function showPdfLoading(){
      if (!pdfLoadingOverlay) return;
      pdfLoadingOverlay.classList.remove('is-hidden');
      pdfLoadingOverlay.setAttribute('aria-busy', 'true');
    }

    function hidePdfLoading(){
      if (!pdfLoadingOverlay) return;
      pdfLoadingOverlay.classList.add('is-hidden');
      pdfLoadingOverlay.setAttribute('aria-busy', 'false');
    }

    // =========================
    // ✅ CONTADOR: siempre 5px debajo del último recuadro superior
    // (Finales/Parciales/... ó Sub-tabs (TPs/Resoluciones / secciones de Clases) ó Resúmenes (Difícil/Medio/Fácil))
    // =========================
    (function setupPageCounterAutoTop(){
      if(!pageCounter) return;

      const root = document.documentElement;

      function isVisible(el){
        if(!el) return false;
        const st = window.getComputedStyle(el);
        if(st.display === 'none' || st.visibility === 'hidden') return false;
        const r = el.getBoundingClientRect();
        return (r.width > 0 && r.height > 0);
      }

      function computeTop(){
        // En overlay/fullscreen del PDF, el CSS ya fija el contador.
        if(root.classList.contains('pdf-overlay') || document.body.classList.contains('pdf-fullscreen')) return;

        const candidates = [
          document.querySelector('.top-tabs'),
          document.querySelector('.sub-tabs'),
          document.getElementById('summaryLevelBar')
        ];

        let maxBottom = 0;
        candidates.forEach(el=>{
          if(!isVisible(el)) return;
          const r = el.getBoundingClientRect();
          if(r.bottom > maxBottom) maxBottom = r.bottom;
        });

        if(maxBottom > 0){
          root.style.setProperty('--pc-top', `${Math.ceil(maxBottom + 5)}px`);
        }
      }

      // Cambios de tamaño (wrap / responsive)
      window.addEventListener('resize', computeTop, { passive:true });
      window.addEventListener('orientationchange', computeTop, { passive:true });

      // Si cambia el tamaño de los recuadros (por wrap, fonts, etc.)
      if('ResizeObserver' in window){
        const ro = new ResizeObserver(computeTop);
        const t = document.querySelector('.top-tabs');
        const s = document.querySelector('.sub-tabs');
        const r = document.getElementById('summaryLevelBar');
        if(t) ro.observe(t);
        if(s) ro.observe(s);
        if(r) ro.observe(r);
      }

      // Si cambian clases (pdf-overlay / pdf-fullscreen / ui-hidden-mobile)
      if('MutationObserver' in window){
        const mo = new MutationObserver(computeTop);
        mo.observe(document.documentElement, { attributes:true, attributeFilter:['class'] });
